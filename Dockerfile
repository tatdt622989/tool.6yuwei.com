# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /app

# PUBLIC_* values are inlined into the static HTML at build time.
ARG PUBLIC_ADSENSE_CLIENT=""
ARG PUBLIC_ADSENSE_SLOT_AFTER_TOOL=""
ARG PUBLIC_ADSENSE_SLOT_IN_ARTICLE=""
ARG PUBLIC_ADSENSE_SLOT_BOTTOM=""
ARG PUBLIC_ADSENSE_SLOT_SIDEBAR=""
ARG PUBLIC_ADSENSE_SLOT_HOME=""
ARG PUBLIC_AD_PLACEHOLDERS="false"
ARG PUBLIC_GA_ID=""
ARG PUBLIC_GSC_VERIFICATION=""
ARG PUBLIC_CONTACT_EMAIL=""
ENV PUBLIC_ADSENSE_CLIENT=$PUBLIC_ADSENSE_CLIENT \
    PUBLIC_ADSENSE_SLOT_AFTER_TOOL=$PUBLIC_ADSENSE_SLOT_AFTER_TOOL \
    PUBLIC_ADSENSE_SLOT_IN_ARTICLE=$PUBLIC_ADSENSE_SLOT_IN_ARTICLE \
    PUBLIC_ADSENSE_SLOT_BOTTOM=$PUBLIC_ADSENSE_SLOT_BOTTOM \
    PUBLIC_ADSENSE_SLOT_SIDEBAR=$PUBLIC_ADSENSE_SLOT_SIDEBAR \
    PUBLIC_ADSENSE_SLOT_HOME=$PUBLIC_ADSENSE_SLOT_HOME \
    PUBLIC_AD_PLACEHOLDERS=$PUBLIC_AD_PLACEHOLDERS \
    PUBLIC_GA_ID=$PUBLIC_GA_ID \
    PUBLIC_GSC_VERIFICATION=$PUBLIC_GSC_VERIFICATION \
    PUBLIC_CONTACT_EMAIL=$PUBLIC_CONTACT_EMAIL

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm test && npm run build

FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/robots.txt >/dev/null || exit 1
