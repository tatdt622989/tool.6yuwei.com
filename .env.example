# All variables are read at BUILD time (Astro inlines PUBLIC_* into static HTML).
# In Coolify, tick "Build Variable" (Dockerfile deploy) or pass them as compose build args.

# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Enables the loader, Auto Ads and ads.txt.
PUBLIC_ADSENSE_CLIENT=
# Manual ad unit slot ids (Display / In-article units created in AdSense). Empty = slot not rendered.
PUBLIC_ADSENSE_SLOT_AFTER_TOOL=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_BOTTOM=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_HOME=
# Show dashed placeholders where ads will go (handy before approval). Always on in `npm run dev`.
PUBLIC_AD_PLACEHOLDERS=false

# Google Analytics 4 measurement id. Optional: defaults to the site's own G-10LYBK8Q3W
PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (optional, DNS verification also works)
PUBLIC_GSC_VERIFICATION=
# Public contact address shown on /contact/ (AdSense reviewers look for one)
PUBLIC_CONTACT_EMAIL=
