# All variables are read at BUILD time (Astro inlines PUBLIC_* into static HTML).
# In Coolify, tick "Build Variable" (Dockerfile deploy) or pass them as compose build args.

# Google Analytics 4 measurement id. Optional. Forks on their own domain must set their own id;
# the official site's id is used only when site.url in src/config/site.ts is https://tool.6yuwei.com.
PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (optional, DNS verification also works)
PUBLIC_GSC_VERIFICATION=
# Public contact address shown on /contact/
PUBLIC_CONTACT_EMAIL=
