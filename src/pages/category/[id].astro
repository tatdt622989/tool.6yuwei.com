---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { categories, getCategory } from '../../config/categories';
import Icon from '../../components/Icon.astro';
import { toolsInCategory } from '../../tools/registry';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return categories.filter((c) => toolsInCategory(c.id).length > 0).map((c) => ({ params: { id: c.id } }));
}

const category = getCategory(Astro.params.id!);
const list = toolsInCategory(category.id);
const path = `/category/${category.id}/`;
const crumbs = [
  { name: '首頁', path: '/' },
  { name: category.name, path },
];
const others = categories.filter((c) => c.id !== category.id && toolsInCategory(c.id).length > 0);
---

<BaseLayout
  title={`${category.name}線上工具：${category.blurb}`}
  description={category.description}
  path={path}
  activeCategory={category.id}
  jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd(category.name, list)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} />
    <header class="head">
      <Icon name={category.icon} size={40} strokeWidth={1.6} class="head-icon" />
      <div>
        <h1>{category.name}</h1>
        <p>{category.description}</p>
      </div>
    </header>
    <div class="grid">
      {list.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <AdSlot slot="home" />
    <nav class="others" aria-label="其他分類">
      <h2>其他分類</h2>
      <ul>
        {
          others.map((c) => (
            <li>
              <a href={`/category/${c.id}/`}>{c.name}</a>
              <span class="muted">{c.blurb}</span>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
    padding-top: 20px;
  }
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: start;
    padding: 12px 0 8px;
  }
  .head :global(.head-icon) {
    color: var(--accent);
    margin-top: 4px;
  }
  h1 {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .head p {
    color: var(--text-2);
    max-width: 68ch;
    margin: 10px 0 0;
    line-height: 1.8;
  }
  .grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .others h2 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .others ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .others li {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
  }
  .others a {
    font-weight: 600;
  }
  .others span {
    font-size: 14px;
  }
</style>
