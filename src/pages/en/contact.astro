---
import ProseLayout from '../../layouts/ProseLayout.astro';
import { getBrand, site } from '../../config/site';
const brand = getBrand('en');
---

<ProseLayout
  locale="en"
  title="Contact"
  description={`Report a bug in ${brand.name}, suggest a new tool, or get in touch about a partnership.`}
  path="/contact/"
>
  <p>Questions, bug reports, ideas for new tools or partnership enquiries are all welcome. We usually reply within a few business days.</p>
  {
    site.contactEmail ? (
      <p>
        Email: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
    ) : (
      <p>
        You can also leave a comment on the <a href={site.blogUrl} hreflang="zh-TW">6yuwei blog</a> (written in Chinese; English
        comments are fine).
      </p>
    )
  }
  <h2>When reporting a bug, please include</h2>
  <ul>
    <li>The tool name or its URL</li>
    <li>What you entered (if it isn’t private) and the result you expected</li>
    <li>Your browser and device</li>
  </ul>
</ProseLayout>
