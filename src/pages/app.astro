---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import { site } from '../config/site';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';

const path = '/app/';
const crumbs = [
  { name: '首頁', path: '/' },
  { name: '安裝成 App', path },
];

const benefits = [
  { icon: 'LayoutGrid', title: '主畫面一鍵開啟', body: '像一般 App 一樣出現在手機主畫面、電腦 Dock 或開始選單。' },
  { icon: 'Maximize', title: '獨立視窗', body: '沒有網址列和分頁，畫面更大，專心用工具。' },
  { icon: 'Zap', title: '常用工具直達', body: '在圖示上長按（手機）或按右鍵（電腦），可直接開啟薪資計算機、計算機、匯率等常用工具。' },
  { icon: 'RefreshCw', title: '自動更新', body: '不用到商店下載更新，每次連線開啟就是最新版。' },
];

const platforms = [
  {
    icon: 'Smartphone',
    title: 'iPhone、iPad（Safari）',
    steps: ['用 Safari 開啟 tool.6yuwei.com。', '點下方工具列的「分享」按鈕。', '往下滑，點「加入主畫面」。', '確認名稱後點「新增」。'],
  },
  {
    icon: 'TabletSmartphone',
    title: 'Android（Chrome）',
    steps: ['用 Chrome 開啟 tool.6yuwei.com。', '點右上角「⋮」選單。', '點「安裝應用程式」或「加到主畫面」。', '點「安裝」。'],
  },
  {
    icon: 'Monitor',
    title: 'Windows、Mac（Chrome 或 Edge）',
    steps: ['開啟 tool.6yuwei.com。', '點網址列右側的「安裝」圖示，或選單中的「安裝隨手」。', '點「安裝」，之後可從桌面、Dock 或開始選單開啟。'],
  },
  {
    icon: 'Laptop',
    title: 'Mac（Safari）',
    steps: ['用 Safari 開啟 tool.6yuwei.com。', '點選單列「檔案」→「加入 Dock」。', '點「加入」。'],
  },
];

const faq = [
  { q: '安裝要錢嗎？', a: '完全免費，不需要註冊帳號，也不用到 App Store 或 Google Play 下載。' },
  { q: '會佔用很多空間嗎？', a: '幾乎不佔空間。安裝後只是在主畫面放一個捷徑，工具內容每次開啟時從網路載入。' },
  { q: '沒有網路可以用嗎？', a: '需要網路。每次開啟都會載入最新版本的工具與資料，例如最新的勞健保費率與匯率。' },
  { q: '怎麼移除？', a: '和一般 App 一樣：手機長按圖示選擇移除；電腦在 App 視窗的選單中選「解除安裝」。' },
  { q: '我的資料會上傳嗎？', a: '不會。所有工具都在你的裝置上計算，安裝成 App 後也一樣。' },
];
---

<BaseLayout
  title="安裝成 App：把隨手加到手機主畫面或電腦"
  description="隨手可以安裝成 App：加到 iPhone、Android 主畫面或 Windows、Mac 桌面，獨立視窗開啟，長按圖示直達常用工具。免費、免註冊、不用到商店下載。"
  path={path}
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(faq)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} />
    <header class="head">
      <h1>把{site.name}裝成 App</h1>
      <p>不用到商店下載，加到主畫面或桌面就能像 App 一樣使用，下次一鍵就能打開常用工具。</p>
      <div class="cta">
        <InstallButton />
        <p class="already" hidden data-standalone-note>你現在就是用 App 開啟的。</p>
      </div>
    </header>

    <section class="benefits" aria-label="安裝的好處">
      {
        benefits.map((b) => (
          <div class="benefit">
            <Icon name={b.icon} size={22} class="b-icon" />
            <h2>{b.title}</h2>
            <p>{b.body}</p>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="how">
      <h2 id="how" class="section-title">怎麼安裝</h2>
      <div class="platforms">
        {
          platforms.map((p) => (
            <article class="platform">
              <div class="p-head">
                <Icon name={p.icon} size={20} class="p-icon" />
                <h3>{p.title}</h3>
              </div>
              <ol>
                {p.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq" class="section-title">常見問題</h2>
      {
        faq.map((item) => (
          <div class="qa">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { isStandalone } from '../lib/pwa';
  if (isStandalone()) document.querySelector<HTMLElement>('[data-standalone-note]')!.hidden = false;
</script>

<style>
  .page {
    display: grid;
    gap: 32px;
    padding-top: 20px;
  }
  .head h1 {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .head > p {
    max-width: 40em;
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-2);
  }
  .cta {
    margin-top: 18px;
  }
  .already {
    margin: 0;
    color: var(--success);
    font-weight: 600;
  }
  .benefits {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .benefit,
  .platform,
  .qa {
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .benefit :global(.b-icon),
  .p-head :global(.p-icon) {
    color: var(--accent);
  }
  .benefit h2 {
    margin: 10px 0 4px;
    font-size: 17px;
  }
  .benefit p,
  .qa p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .section-title {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .platforms {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .p-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .p-head h3 {
    font-size: 16px;
  }
  .platform ol {
    margin: 12px 0 0;
    padding-left: 1.3em;
    display: grid;
    gap: 6px;
    color: var(--text-2);
    line-height: 1.7;
  }
  .qa {
    margin-bottom: 10px;
  }
  .qa h3 {
    font-size: 16px;
    margin-bottom: 4px;
  }
</style>
