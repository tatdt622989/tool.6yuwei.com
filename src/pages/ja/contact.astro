---
import ProseLayout from '../../layouts/ProseLayout.astro';
import { getBrand, site } from '../../config/site';
const brand = getBrand('ja');
---

<ProseLayout
  locale="ja"
  title="お問い合わせ"
  description={`${brand.name}の不具合の報告、新しいツールのご要望、提携に関するお問い合わせはこちら。`}
  path="/contact/"
>
  <p>ご質問、不具合の報告、新しいツールのご要望、提携のご相談など、お気軽にご連絡ください。通常、数営業日以内にお返事します。</p>
  {
    site.contactEmail ? (
      <p>
        メール：<a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
    ) : (
      <p>
        <a href={site.blogUrl} hreflang="zh-TW">6yuwei ブログ</a>（中国語）の記事にコメントを残していただくこともできます。日本語のコメントでも大丈夫です。
      </p>
    )
  }
  <h2>不具合を報告していただく際は</h2>
  <ul>
    <li>ツール名または URL</li>
    <li>入力した内容（個人情報を含まない範囲で）と、期待していた結果</li>
    <li>お使いのブラウザと端末</li>
  </ul>
</ProseLayout>
