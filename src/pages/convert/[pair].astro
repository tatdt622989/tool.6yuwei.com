---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { convertPath, getPair, pairs } from '../../conversions/pairs';
import { feetInches, formatDisplay, formulaText, pairUnits } from '../../conversions/logic';
import { convert, formatValue, getCategory as getUnitCategory } from '../../tools/unit-converter/logic';
import { getTool, toolPath } from '../../tools/registry';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return pairs.map((p) => ({ params: { pair: p.slug } }));
}

const pair = getPair(Astro.params.pair!);
const u = pairUnits(pair.category, pair.from, pair.to);
const unitCategory = getUnitCategory(pair.category);
const one = convert(1, pair.category, pair.from, pair.to);
const oneBack = convert(1, pair.category, pair.to, pair.from);
const formula = formulaText(pair.category, pair.from, pair.to);
const reverse = pairs.find((p) => p.from === pair.to && p.to === pair.from && p.category === pair.category);
const siblings = pairs.filter((p) => p.slug !== pair.slug && p.category === pair.category && p !== reverse);
const others = pairs.filter((p) => p.category !== pair.category).slice(0, 8);
const converterTool = getTool('unit-converter');
const pingTool = pair.category === 'area' ? getTool('ping-converter') : null;
const feet = pair.display === 'feet-inches';

const show = (v: number) => (feet ? `${formatDisplay(v)} 呎（${feetInches(v)}）` : `${formatDisplay(v)} ${u.toSymbol}`);
const rows = pair.values.map((v) => ({ input: v, output: convert(v, pair.category, pair.from, pair.to) }));
const sample = rows[Math.min(4, rows.length - 1)];

const path = convertPath(pair.slug);
const crumbs = [
  { name: '首頁', path: '/' },
  { name: '單位換算', path: '/convert/' },
  { name: pair.keyword, path },
];
const title = `${pair.keyword}換算：1 ${u.fromName}等於幾${u.toName}？（附對照表）`;
const description = `${pair.keyword}線上換算，1 ${u.fromName} = ${formatValue(one)} ${u.toName}，公式「${formula}」。輸入數字即時換算，並附常用${u.fromName}與${u.toName}對照表。`;
const faq = [
  { q: `1 ${u.fromName}等於幾${u.toName}？`, a: `1 ${u.fromName}（${u.fromSymbol}）等於 ${formatValue(one)} ${u.toName}（${u.toSymbol}）。` },
  { q: `1 ${u.toName}等於幾${u.fromName}？`, a: `1 ${u.toName}等於 ${formatValue(oneBack)} ${u.fromName}。` },
  {
    q: `${formatValue(sample.input)} ${u.fromName}是多少${u.toName}？`,
    a: `${formatValue(sample.input)} ${u.fromName}等於 ${show(sample.output)}。`,
  },
  { q: `${pair.keyword}的公式是什麼？`, a: `${formula}。${pair.category === 'temperature' ? '' : '把要換算的數值代入公式即可。'}` },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  activeCategory="calc"
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(faq)]}
>
  <div class="container layout">
    <div class="primary">
      <Breadcrumbs items={crumbs} />
      <header class="head">
        <h1>{pair.keyword}換算</h1>
        <p class="intro">
          1 {u.fromName} = <strong>{formatValue(one)}</strong> {u.toName}；1 {u.toName} = {formatValue(oneBack)}
          {u.fromName}。輸入任一邊即可雙向換算。
        </p>
      </header>

      <section class="tool-card" aria-label={`${pair.keyword}換算器`}>
        <div
          class="tool"
          data-tool="convert-pair"
          data-category={pair.category}
          data-from={pair.from}
          data-to={pair.to}
          data-feet={feet ? '1' : undefined}
        >
          <div class="pair-grid">
            <div class="field">
              <label for="cp-from">{u.fromName}（{u.fromSymbol}）</label>
              <input id="cp-from" type="text" inputmode="decimal" value={String(sample.input)} />
            </div>
            <button class="btn swap" type="button" id="cp-swap" aria-label="交換方向" title="交換方向">⇄</button>
            <div class="field">
              <label for="cp-to">{u.toName}（{u.toSymbol}）</label>
              <input id="cp-to" type="text" inputmode="decimal" value={formatDisplay(sample.output).replace(/,/g, '')} />
            </div>
          </div>
          <div class="result">
            <div class="result-value" id="cp-result">{formatValue(sample.input)} {u.fromSymbol} = {show(sample.output)}</div>
            <div class="result-label">公式：{formula}</div>
          </div>
        </div>
      </section>

      <AdSlot slot="afterTool" />

      <article class="prose">
        <h2>{u.fromName}與{u.toName}對照表</h2>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th class="num">{u.fromName}（{u.fromSymbol}）</th><th class="num">{u.toName}（{u.toSymbol}）</th></tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr>
                    <td class="num">{formatValue(r.input)}</td>
                    <td class="num">{show(r.output)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h2>換算說明</h2>
        <p>{pair.note}</p>
        <p>
          換算公式：<strong>{formula}</strong>。以 {formatValue(sample.input)} {u.fromName}為例，換算結果是 {show(sample.output)}。
        </p>

        <AdSlot slot="inArticle" />

        <section class="faq">
          <h2>常見問題</h2>
          {
            faq.map((item) => (
              <div class="qa">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))
          }
        </section>

        <p class="aliases">也有人搜尋：{pair.aliases.join('、')}</p>
      </article>

      <AdSlot slot="bottom" />

      <section class="more" aria-labelledby="more-title">
        <h2 id="more-title">更多{unitCategory.name}換算</h2>
        <ul class="pair-links">
          {reverse && <li><a href={convertPath(reverse.slug)}>{reverse.keyword}</a></li>}
          {siblings.map((p) => <li><a href={convertPath(p.slug)}>{p.keyword}</a></li>)}
          {others.map((p) => <li><a href={convertPath(p.slug)}>{p.keyword}</a></li>)}
        </ul>
        <div class="tools">
          <ToolCard tool={converterTool} />
          {pingTool && <ToolCard tool={pingTool} />}
        </div>
        <p class="muted">需要其他單位？使用完整的<a href={toolPath(converterTool.slug)}>單位換算工具</a>，支援{unitCategory.name}所有單位互換。</p>
      </section>
    </div>

    <aside class="secondary">
      <div class="sticky">
        <AdSlot slot="sidebar" />
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { $ } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { feetInches, formatDisplay } from '../../conversions/logic';
  import { convert, formatValue, getCategory, getUnit, type CategoryKey } from '../../tools/unit-converter/logic';

  const root = $('[data-tool="convert-pair"]');
  const category = root.dataset.category as CategoryKey;
  const from = root.dataset.from!;
  const to = root.dataset.to!;
  const feet = root.dataset.feet === '1';
  const fromInput = $<HTMLInputElement>('#cp-from', root);
  const toInput = $<HTMLInputElement>('#cp-to', root);
  const result = $('#cp-result', root);
  const cat = getCategory(category);
  const symbol = (id: string) => getUnit(cat, id)?.symbol ?? '';
  let swapped = false;

  function describe(value: number, out: number, outUnit: string, inUnit: string) {
    const extra = feet && outUnit === 'ft' ? `（${feetInches(out)}）` : '';
    result.textContent = `${formatValue(value)} ${symbol(inUnit)} = ${formatDisplay(out)} ${symbol(outUnit)}${extra}`;
  }

  function update(source: 'from' | 'to') {
    const a = source === 'from' ? fromInput : toInput;
    const b = source === 'from' ? toInput : fromInput;
    const [inUnit, outUnit] = (source === 'from') !== swapped ? [from, to] : [to, from];
    const value = parseNumber(a.value);
    const out = convert(value, category, inUnit, outUnit);
    b.value = Number.isFinite(out) ? formatDisplay(out).replace(/,/g, '') : '';
    if (Number.isFinite(out)) describe(value, out, outUnit, inUnit);
    else result.textContent = '請輸入有效的數字';
  }

  fromInput.addEventListener('input', () => update('from'));
  toInput.addEventListener('input', () => update('to'));
  $('#cp-swap', root).addEventListener('click', () => {
    // Swap which unit each box holds by swapping labels and values.
    swapped = !swapped;
    const labels = root.querySelectorAll('label');
    const t = labels[0].textContent;
    labels[0].textContent = labels[1].textContent;
    labels[1].textContent = t;
    [fromInput.value, toInput.value] = [toInput.value, fromInput.value];
    update('from');
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding-top: 20px;
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
  .primary {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-content: start;
  }
  .head {
    display: grid;
    gap: 8px;
  }
  h1 {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .intro {
    margin: 0;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.8;
  }
  .tool-card {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  .pair-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 10px;
    align-items: end;
  }
  @media (max-width: 520px) {
    .pair-grid {
      grid-template-columns: 1fr;
    }
    .swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
  .pair-grid input {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .swap {
    font-size: 18px;
  }
  .prose {
    max-width: 72ch;
    color: var(--text-2);
  }
  .prose h2,
  .more h2 {
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    margin: 40px 0 14px;
  }
  .prose h3 {
    font-size: 17px;
    color: var(--text);
    margin: 0 0 4px;
  }
  .prose p {
    margin: 0 0 14px;
    line-height: 1.9;
  }
  .qa {
    padding: 16px 18px;
    margin-bottom: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .qa h3 {
    font-size: 16px !important;
  }
  .qa p {
    margin: 0;
  }
  .aliases {
    margin-top: 20px !important;
    font-size: 13px;
    color: var(--muted);
  }
  .pair-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .pair-links a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    color: var(--text-2);
  }
  .pair-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .tools {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-bottom: 12px;
  }
  .secondary {
    display: none;
  }
  @media (min-width: 1100px) {
    .secondary {
      display: block;
    }
  }
  .sticky {
    position: sticky;
    top: 112px;
  }
</style>
