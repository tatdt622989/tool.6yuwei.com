---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { convertPath, pairs } from '../../conversions/pairs';
import { CATEGORIES } from '../../tools/unit-converter/logic';
import { getTool } from '../../tools/registry';
import { breadcrumbJsonLd } from '../../lib/seo';

const crumbs = [
  { name: '首頁', path: '/' },
  { name: '單位換算', path: '/convert/' },
];
const groups = CATEGORIES.map((c) => ({ name: c.name, list: pairs.filter((p) => p.category === c.key) })).filter(
  (g) => g.list.length > 0,
);
---

<BaseLayout
  title="常用單位換算表：公分英吋、公斤磅、攝氏華氏、台斤公斤"
  description="常用單位換算一覽：公分轉英吋、身高公分轉英呎、公斤轉磅、台斤轉公斤、攝氏轉華氏、加侖轉公升等，每個換算都有即時計算器、公式與對照表。"
  path="/convert/"
  activeCategory="calc"
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} />
    <header>
      <h1>常用單位換算</h1>
      <p>挑選你要的換算，每一頁都有雙向即時換算、公式說明與常用數值對照表。找不到的單位，請使用完整的單位換算工具。</p>
    </header>
    <div class="tools"><ToolCard tool={getTool('unit-converter')} /><ToolCard tool={getTool('ping-converter')} /></div>
    {
      groups.map((g) => (
        <section>
          <h2>{g.name}</h2>
          <ul>
            {g.list.map((p) => (
              <li>
                <a href={convertPath(p.slug)}>{p.keyword}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <AdSlot slot="home" />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 20px;
    padding-top: 20px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 36px);
  }
  header p {
    color: var(--text-2);
    max-width: 72ch;
    margin: 10px 0 0;
  }
  h2 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 15px;
  }
  li a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .tools {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
</style>
