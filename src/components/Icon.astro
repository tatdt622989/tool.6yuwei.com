---
// Renders a Lucide icon to inline SVG at build time (no client JavaScript).
import { icons } from 'lucide';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

type IconNode = [string, Record<string, string | number>][];

const { name, size = 20, strokeWidth = 1.75, class: className } = Astro.props;
const node = (icons as Record<string, IconNode>)[name];
if (!node) throw new Error(`Unknown Lucide icon "${name}"`);
const inner = node
  .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`)
  .join('');
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
