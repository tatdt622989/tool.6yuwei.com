---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { getBrand, site } from '../config/site';
import { switcherLinks, type Alternates } from '../i18n/alternates';
import { t } from '../i18n/format';
import { DEFAULT_LOCALE, LOCALE_INFO, localeHome, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { categoryPath, populatedCategories } from '../tools/registry';

interface Props {
  locale?: Locale;
  /** Same page in other locales; missing locales link to their home page. */
  alternates?: Alternates;
  activeCategory?: string;
}
const { locale = DEFAULT_LOCALE, alternates = {}, activeCategory } = Astro.props;
const s = getUi(locale).header;
const brand = getBrand(locale);
const languages = switcherLinks(locale, alternates);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localeHome(locale)} aria-label={t(s.homeAria, { name: brand.name })}>
      <Wordmark locale={locale} />
    </a>
    <nav class="meta" aria-label={s.siteLinksAria}>
      <button class="search" type="button" data-open-search aria-haspopup="dialog">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <span class="search-label">{s.search}</span>
        <kbd>/</kbd>
      </button>
      {s.blog && <a class="blog" href={site.blogUrl} rel="noopener">{s.blog}</a>}
      <details class="lang" data-lang-menu>
        <summary aria-label={s.languageAria}>
          <Icon name="Languages" size={16} strokeWidth={2} />
          <span class="lang-current">{LOCALE_INFO[locale].label}</span>
        </summary>
        <ul class="lang-menu">
          {
            languages.map((l) => (
              <li>
                <a
                  href={l.href}
                  hreflang={l.hreflang}
                  lang={l.htmlLang}
                  aria-current={l.current ? 'true' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
  <nav class="container cats" aria-label={s.categoriesAria}>
    {
      populatedCategories(locale).map((c) => (
        <a href={categoryPath(c.id, locale)} aria-current={c.id === activeCategory ? 'page' : undefined}>
          {c.name}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--surface) 82%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }
  .brand:hover {
    text-decoration: none;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 600;
  }
  .meta a {
    color: var(--text-2);
  }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px 6px 14px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    cursor: pointer;
  }
  .search:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  kbd {
    min-width: 20px;
    padding: 0 6px;
    font-size: 12px;
    line-height: 20px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .cats {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 10px;
  }
  .cats::-webkit-scrollbar {
    display: none;
  }
  .cats a {
    flex: none;
    padding: 6px 13px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .cats a:hover {
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
  }
  .cats a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .lang {
    position: relative;
  }
  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 4px;
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
    border-radius: 8px;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang summary:hover,
  .lang[open] summary {
    color: var(--text);
  }
  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
    min-width: 140px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
  }
  .lang-menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    font-weight: 600;
    color: var(--text-2);
  }
  .lang-menu a:hover {
    text-decoration: none;
    background: var(--surface-2);
    color: var(--text);
  }
  .lang-menu a[aria-current='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
  @media (max-width: 420px) {
    kbd {
      display: none;
    }
    .search {
      padding: 6px 12px;
    }
  }
  /* Phones: the search button and language menu collapse to their icons. */
  @media (max-width: 480px) {
    .meta {
      gap: 12px;
    }
    .search {
      padding: 7px;
    }
    .search-label,
    .lang-current {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
