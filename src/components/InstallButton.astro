---
// Revealed by lib/pwa.ts only when the browser offers installation (Chrome, Edge, Android).
import { splitLocale } from '../i18n/locales';
import { getUi } from '../i18n/ui';

interface Props {
  label?: string;
  class?: string;
}
const { label = getUi(splitLocale(Astro.url.pathname).locale).installButton, class: className } = Astro.props;
---

<button type="button" class:list={['btn', 'primary', className]} data-install hidden>{label}</button>
