---
import Wordmark from './Wordmark.astro';
import { getBrand, site } from '../config/site';
import { DEFAULT_LOCALE, localePath, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { categoryPath, populatedCategories } from '../tools/registry';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const s = getUi(locale).footer;
const brand = getBrand(locale);
const sentenceEnd = locale === 'en' ? '. ' : '。';
const year = new Date().getFullYear();
const link = (path: string) => localePath(locale, path);
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <Wordmark size="lg" locale={locale} />
        <p>{brand.tagline}{sentenceEnd}{s.about}</p>
      </div>
      <nav aria-label={s.categories}>
        <h2>{s.categories}</h2>
        <ul class="two">
          {populatedCategories(locale).map((c) => <li><a href={categoryPath(c.id, locale)}>{c.name}</a></li>)}
          {s.conversions && <li><a href="/convert/">{s.conversions}</a></li>}
        </ul>
      </nav>
      <nav aria-label={s.aboutHeading}>
        <h2>{s.aboutHeading}</h2>
        <ul>
          <li><a href={link('/app/')}>{s.app}</a></li>
          <li><a href={link('/about/')}>{s.aboutSite}</a></li>
          <li><a href={link('/contact/')}>{s.contact}</a></li>
          <li><a href={link('/privacy/')}>{s.privacy}</a></li>
          <li><a href={link('/terms/')}>{s.terms}</a></li>
          <li><a href={site.blogUrl} rel="noopener" hreflang={locale === 'zh-TW' ? undefined : 'zh-TW'}>{s.blog}</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">© {year} {site.author}</div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    padding: 48px 0 32px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  .cols {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 860px) {
    .cols {
      grid-template-columns: 1.4fr 1.4fr 1fr;
    }
  }
  .about p {
    margin: 12px 0 0;
    color: var(--muted);
    max-width: 40ch;
    line-height: 1.7;
  }
  h2 {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  a {
    color: var(--text-2);
  }
  .legal {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }
</style>
