---
import { ads, type AdSlotName } from '../config/site';

interface Props {
  slot: AdSlotName;
  class?: string;
}

const { slot, class: className } = Astro.props;
const slotId = ads.slots[slot];
const live = Boolean(ads.client && slotId);
const placeholder = !live && ads.showPlaceholders;
const inArticle = slot === 'inArticle';
const vertical = slot === 'sidebar';
---

{
  live && (
    <aside class:list={['ad', `ad--${slot}`, className]} aria-label="廣告">
      <span class="ad-label">廣告</span>
      {inArticle ? (
        <ins
          class="adsbygoogle"
          style="display:block;text-align:center"
          data-ad-client={ads.client}
          data-ad-slot={slotId}
          data-ad-layout="in-article"
          data-ad-format="fluid"
        />
      ) : (
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={ads.client}
          data-ad-slot={slotId}
          data-ad-format={vertical ? 'vertical' : 'auto'}
          data-full-width-responsive={vertical ? 'false' : 'true'}
        />
      )}
    </aside>
  )
}
{
  placeholder && (
    <aside class:list={['ad', 'ad--placeholder', `ad--${slot}`, className]} aria-hidden="true">
      <span>廣告版位 · {slot}</span>
    </aside>
  )
}

<style>
  .ad {
    position: relative;
    display: grid;
    min-height: 120px; /* reserve space to limit layout shift */
    margin: 8px 0;
    overflow: hidden;
  }
  .ad--sidebar {
    min-height: 600px;
  }
  .ad--inArticle {
    min-height: 200px;
  }
  .ad-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .ad--placeholder {
    place-items: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 13px;
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 10px,
      color-mix(in oklab, var(--border) 45%, transparent) 10px 11px
    );
  }
</style>
