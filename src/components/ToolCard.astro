---
import Icon from './Icon.astro';
import { getCategory } from '../config/categories';
import { toolPath } from '../tools/registry';
import type { LocalizedTool } from '../tools/types';

interface Props {
  /** Registry entry; its `locale` decides the link and category name. */
  tool: LocalizedTool;
  compact?: boolean;
}

const { tool, compact = false } = Astro.props;
const category = getCategory(tool.category, tool.locale);
const searchText = [tool.name, tool.seoTitle, tool.description, ...tool.keywords, category.name].join(' ').toLowerCase();
---

<a class:list={['card', { compact }]} href={toolPath(tool.slug, tool.locale)} data-search={searchText}>
  <Icon name={tool.icon} size={compact ? 18 : 22} class="icon" />
  <span class="body">
    <span class="name">{tool.name}</span>
    {!compact && <span class="desc">{tool.intro}</span>}
  </span>
</a>

<style>
  .card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    min-width: 0;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }
  .card :global(.icon) {
    flex: none;
    margin-top: 1px;
    color: var(--text-2);
    transition: color 0.15s;
  }
  .card:hover :global(.icon) {
    color: var(--accent);
  }
  .compact {
    padding: 11px 14px;
    align-items: center;
    gap: 12px;
    border-radius: 10px;
  }
  .compact :global(.icon) {
    margin-top: 0;
  }
  .body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .name {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.35;
  }
  .compact .name {
    font-size: 15px;
    font-weight: 600;
  }
  .desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
