---
// Site-wide tool search in a modal dialog. Opened by any [data-open-search] element, "/" or Cmd/Ctrl+K.
// The index covers only the tools of the page's locale.
import { getCategory } from '../config/categories';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { toolPath, toolsFor } from '../tools/registry';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const s = getUi(locale).search;

const index = toolsFor(locale).map((t) => {
  const category = getCategory(t.category, locale).name;
  return {
    n: t.name,
    c: category,
    u: toolPath(t.slug, locale),
    s: [t.name, t.seoTitle, ...t.keywords, category].join(' ').toLowerCase(),
  };
});
---

<dialog class="search-dialog" aria-label={s.aria}>
  <div class="panel">
    <div class="field-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        placeholder={s.placeholder}
        autocomplete="off"
        aria-label={s.aria}
        aria-controls="search-results"
      />
      <button type="button" class="close" aria-label={s.close}>Esc</button>
    </div>
    <ul id="search-results" class="results" role="listbox"></ul>
    <p class="none" hidden>{s.noResults}</p>
  </div>
  <script type="application/json" id="search-index" set:html={JSON.stringify(index)} />
</dialog>

<script>
  interface Entry {
    n: string;
    c: string;
    u: string;
    s: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const list = dialog.querySelector<HTMLUListElement>('.results')!;
  const none = dialog.querySelector<HTMLElement>('.none')!;
  const entries: Entry[] = JSON.parse(document.getElementById('search-index')!.textContent ?? '[]');
  let active = 0;

  function render() {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const matches = entries.filter((e) => terms.every((t) => e.s.includes(t))).slice(0, 12);
    active = 0;
    list.replaceChildren(
      ...matches.map((e, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        const a = document.createElement('a');
        a.href = e.u;
        a.className = i === 0 ? 'is-active' : '';
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = e.n;
        const cat = document.createElement('span');
        cat.className = 'cat';
        cat.textContent = e.c;
        a.append(name, cat);
        li.append(a);
        return li;
      }),
    );
    none.hidden = matches.length > 0;
  }

  function move(delta: number) {
    const links = Array.from(list.querySelectorAll('a'));
    if (links.length === 0) return;
    links[active]?.classList.remove('is-active');
    active = (active + delta + links.length) % links.length;
    links[active].classList.add('is-active');
    links[active].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest('[data-open-search]');
    if (!trigger) return;
    event.preventDefault();
    open();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.closest('input, textarea, select, [contenteditable="true"]');
    if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });

  input.addEventListener('input', render);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      const link = list.querySelectorAll('a')[active];
      if (link) location.href = link.href;
    }
  });

  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  // Clicking the backdrop (the dialog element itself, outside the panel) closes it.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .search-dialog {
    width: min(600px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 80px -20px rgb(20 20 25 / 0.35);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgb(20 20 25 / 0.32);
  }
  .panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    max-height: inherit;
  }
  .field-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px 6px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .field-row input {
    border: 0;
    box-shadow: none;
    padding: 14px 0;
    font-size: 17px;
    background: transparent;
  }
  .field-row input:focus {
    box-shadow: none;
  }
  .close {
    flex: none;
    padding: 3px 8px;
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .results :global(a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--text);
  }
  .results :global(a:hover),
  .results :global(a.is-active) {
    text-decoration: none;
    background: var(--accent-soft);
  }
  .results :global(.name) {
    font-weight: 600;
  }
  .results :global(.cat) {
    font-size: 13px;
    color: var(--muted);
  }
  .none {
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--muted);
  }
</style>
