---
// Share row on tool pages: native share sheet where supported, copy link, and plain
// share links per network. The links work without JavaScript.
import Icon from './Icon.astro';
import { getUi, type ShareNetwork } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  url: string;
  title: string;
}
const { locale, url, title } = Astro.props;
const s = getUi(locale).share;
const u = encodeURIComponent(url);
const tt = encodeURIComponent(title);
const both = encodeURIComponent(`${title} ${url}`);

const networks: Record<ShareNetwork, { label: string; href: string }> = {
  line: { label: 'LINE', href: `https://line.me/R/share?text=${both}` },
  facebook: { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  x: { label: 'X', href: `https://x.com/intent/post?text=${tt}&url=${u}` },
  threads: { label: 'Threads', href: `https://www.threads.net/intent/post?text=${both}` },
  hatena: { label: 'はてブ', href: `https://b.hatena.ne.jp/add?mode=confirm&url=${u}&title=${tt}` },
  whatsapp: { label: 'WhatsApp', href: `https://wa.me/?text=${both}` },
  reddit: { label: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${tt}` },
  email: { label: 'Email', href: `mailto:?subject=${tt}&body=${u}` },
};
---

<div class="share" data-share data-url={url} data-title={title}>
  <span class="share-label">{s.heading}</span>
  <div class="share-actions">
    <button type="button" class="share-btn primary" data-share-native hidden>
      <Icon name="Share2" size={15} />{s.native}
    </button>
    <button type="button" class="share-btn" data-share-copy>
      <Icon name="Link" size={15} />{s.copyLink}
    </button>
    {
      s.networks.map((id) => (
        <a
          class="share-btn"
          href={networks[id].href}
          target={id === 'email' ? undefined : '_blank'}
          rel="noopener nofollow"
        >
          {networks[id].label}
        </a>
      ))
    }
  </div>
</div>

<script>
  import { copyText, flashButton } from '../lib/client';

  for (const root of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const url = root.dataset.url ?? location.href;
    const title = root.dataset.title ?? document.title;
    const native = root.querySelector<HTMLButtonElement>('[data-share-native]');
    if (native && typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
    const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    copy?.addEventListener('click', async () => {
      if (await copyText(url)) flashButton(copy);
    });
  }
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 16px;
  }
  .share-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-2);
  }
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .share-btn:hover {
    text-decoration: none;
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
  }
  .share-btn.primary {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }
  .share-btn.primary:hover {
    color: #fff;
  }
</style>
