---
// Text-only brand: 「隨手」 plus a descriptor so the name explains itself. Text comes from brands in config/site.ts.
import { getBrand } from '../config/site';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';

interface Props {
  size?: 'md' | 'lg';
  locale?: Locale;
}
const { size = 'md', locale = DEFAULT_LOCALE } = Astro.props;
const brand = getBrand(locale);
---

<span class:list={['wordmark', size, `wordmark--${locale}`]}>
  <span class="name">{brand.mark}</span>
  <span class="desc">{brand.markDesc}</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    white-space: nowrap;
  }
  .name {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.04em;
  }
  .name::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 3px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: baseline;
  }
  .desc {
    padding-left: 10px;
    border-left: 1px solid var(--border-strong);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .lg .name {
    font-size: 26px;
  }
  /* Latin wordmark: tighter tracking reads better than the CJK spacing. */
  .wordmark--en .name {
    letter-spacing: -0.01em;
  }
  .wordmark--en .desc {
    letter-spacing: 0.04em;
  }
</style>
