---
import { splitLocale, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';

interface Props {
  items: { name: string; path: string }[];
  locale?: Locale;
}
const { items, locale = splitLocale(Astro.url.pathname).locale } = Astro.props;
---

<nav class="crumbs" aria-label={getUi(locale).breadcrumbsAria}>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--muted);
  }
  li:not(:last-child)::after {
    content: '/';
    margin-left: 6px;
    color: var(--border-strong);
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
  }
</style>
