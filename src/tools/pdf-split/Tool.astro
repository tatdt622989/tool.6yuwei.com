<div class="tool" data-tool="pdf-split">
  <p class="ps-privacy">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    <span><strong>檔案不會上傳。</strong>PDF 分割與擷取全程在你的瀏覽器中完成，檔案不會傳到任何伺服器，機密文件也能安心處理。</span>
  </p>

  <label class="dropzone" id="ps-drop" tabindex="0">
    <input type="file" id="ps-file" accept="application/pdf,.pdf" hidden />
    <strong>點擊選擇 PDF，或拖曳到這裡</strong>
    <span class="hint">選好後會顯示每一頁的縮圖，點選要擷取或刪除的頁面</span>
  </label>

  <div class="row" id="ps-try">
    <span class="hint">手邊沒有 PDF？</span>
    <button class="btn small ghost" type="button" id="ps-sample">用 8 頁範例檔試試</button>
  </div>

  <p class="notice error" id="ps-note" hidden></p>

  <div class="ps-work" id="ps-work" hidden>
    <div class="row between ps-filebar">
      <div class="ps-fileinfo">
        <strong id="ps-filename"></strong>
        <span class="hint" id="ps-fileinfo"></span>
      </div>
      <button class="btn small ghost" type="button" id="ps-replace">換一個檔案</button>
    </div>

    <div class="field">
      <span class="label">分割方式</span>
      <div class="seg" role="radiogroup" aria-label="分割方式">
        <label><input type="radio" name="ps-mode" value="extract" checked /><span>擷取選取頁面</span></label>
        <label><input type="radio" name="ps-mode" value="delete" /><span>刪除選取頁面</span></label>
        <label><input type="radio" name="ps-mode" value="each" /><span>每頁存成一個檔</span></label>
        <label><input type="radio" name="ps-mode" value="every" /><span>每 N 頁分割</span></label>
      </div>
    </div>

    <div class="field" id="ps-range-field">
      <label for="ps-range">頁面範圍</label>
      <input id="ps-range" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="例如 1-3,5,8-10" />
      <span class="hint" id="ps-range-hint">輸入頁碼與範圍，或直接點選下方縮圖；按住 Shift 點選可一次選取連續頁面。</span>
      <div class="row">
        <button class="btn small ghost" type="button" data-select="all">全選</button>
        <button class="btn small ghost" type="button" data-select="odd">奇數頁</button>
        <button class="btn small ghost" type="button" data-select="even">偶數頁</button>
        <button class="btn small ghost" type="button" data-select="invert">反向選取</button>
        <button class="btn small ghost" type="button" data-select="none">清除選取</button>
      </div>
    </div>

    <div class="field" id="ps-every-field" hidden>
      <label for="ps-every">每幾頁分成一個檔案</label>
      <input id="ps-every" type="number" inputmode="numeric" min="1" step="1" value="2" />
    </div>

    <div class="row between">
      <span class="hint">點縮圖右下角的箭頭可旋轉該頁，輸出時套用。</span>
      <button class="btn small ghost" type="button" id="ps-rotate-all">全部向右轉 90°</button>
    </div>

    <ol class="ps-grid" id="ps-grid" aria-label="頁面縮圖"></ol>

    <p class="notice" id="ps-plan" aria-live="polite"></p>

    <div class="row">
      <button class="btn primary" type="button" id="ps-run" disabled>擷取並下載</button>
    </div>

    <div class="ps-results" id="ps-results" hidden>
      <div class="row between">
        <strong id="ps-results-title"></strong>
        <button class="btn small" type="button" id="ps-zip">全部下載（ZIP）</button>
      </div>
      <ul class="ps-files" id="ps-files"></ul>
    </div>
  </div>
</div>

<script>
  import type { PDFDocumentProxy } from 'pdfjs-dist';
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger } from '../../lib/format';
  import { addRotation, baseName, formatPageRanges, isPdf, parsePageRanges, planOutputs, type OutputPlan, type SplitMode } from './logic';
  import { createZip } from './zip';
  import { OpenError, openForRender, renderPage } from './pdfjs';

  type Ops = typeof import('../pdf-merge/pdf-ops');
  interface Prefs {
    mode: SplitMode;
    every: number;
  }
  interface Output {
    plan: OutputPlan;
    bytes: Uint8Array<ArrayBuffer>;
    blob: Blob;
  }

  const ROTATE_ICON =
    '<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M15.5 9.5A5.5 5.5 0 1 1 10 4h4m0 0-2.5-2.5M14 4l-2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const CHECK_ICON =
    '<svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M5 10.5l3.2 3L15 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  const root = $('[data-tool="pdf-split"]');
  const drop = $('#ps-drop', root);
  const fileInput = $<HTMLInputElement>('#ps-file', root);
  const note = $('#ps-note', root);
  const work = $('#ps-work', root);
  const tryRow = $('#ps-try', root);
  const modeRadios = $$<HTMLInputElement>('input[name="ps-mode"]', root);
  const rangeField = $('#ps-range-field', root);
  const rangeInput = $<HTMLInputElement>('#ps-range', root);
  const rangeHint = $('#ps-range-hint', root);
  const everyField = $('#ps-every-field', root);
  const everyInput = $<HTMLInputElement>('#ps-every', root);
  const grid = $('#ps-grid', root);
  const plan = $('#ps-plan', root);
  const runBtn = $<HTMLButtonElement>('#ps-run', root);
  const results = $('#ps-results', root);
  const filesList = $('#ps-files', root);

  const RANGE_HINT = rangeHint.textContent ?? '';

  let opsPromise: Promise<Ops> | null = null;
  const ops = () => (opsPromise ??= import('../pdf-merge/pdf-ops'));

  let fileName = '';
  let bytes: Uint8Array | null = null;
  let pdf: PDFDocumentProxy | null = null;
  let pageCount = 0;
  let editable = true;
  let selected = new Set<number>();
  let rotations: Record<number, number> = {};
  let lastClicked = 0;
  let outputs: Output[] = [];
  let busy = false;
  let loadToken = 0;
  let observer: IntersectionObserver | null = null;
  const renderQueue: number[] = [];
  let rendering = false;

  // ---------- Settings ----------
  function mode(): SplitMode {
    return (modeRadios.find((r) => r.checked)?.value ?? 'extract') as SplitMode;
  }
  function everyN(): number {
    const n = Math.floor(Number(everyInput.value));
    return Number.isFinite(n) && n >= 1 ? n : 1;
  }
  function savePrefs() {
    savePref('pdf-split', { mode: mode(), every: everyN() } satisfies Prefs);
  }

  function showNote(text: string) {
    note.textContent = text;
    note.hidden = !text;
  }

  // ---------- Thumbnails ----------
  function enqueue(page: number) {
    if (!renderQueue.includes(page)) renderQueue.push(page);
    void pump();
  }

  async function pump() {
    if (rendering) return;
    rendering = true;
    const token = loadToken;
    while (renderQueue.length && pdf && token === loadToken) {
      const page = renderQueue.shift()!;
      const tile = grid.querySelector<HTMLElement>(`[data-page="${page}"]`);
      const canvas = tile?.querySelector('canvas');
      if (!canvas || canvas.dataset.done) continue;
      try {
        const size = await pdf.getPage(page).then((p) => p.getViewport({ scale: 1 }));
        const target = 150 * Math.min(2, window.devicePixelRatio || 1);
        await renderPage(pdf, page, target / Math.max(size.width, size.height), 0, canvas);
        canvas.dataset.done = '1';
        tile?.classList.add('is-rendered');
      } catch {
        /* a broken page keeps its placeholder */
      }
    }
    rendering = false;
  }

  function buildGrid() {
    observer?.disconnect();
    renderQueue.length = 0;
    grid.replaceChildren();
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer?.unobserve(entry.target);
          enqueue(Number((entry.target as HTMLElement).dataset.page));
        }
      },
      { root: grid, rootMargin: '300px 0px' },
    );
    const frag = document.createDocumentFragment();
    for (let p = 1; p <= pageCount; p++) {
      const li = document.createElement('li');
      li.className = 'ps-tile';
      li.dataset.page = String(p);
      li.innerHTML = `<button type="button" class="ps-pick" aria-pressed="false" aria-label="第 ${p} 頁"><span class="ps-thumb"><canvas width="1" height="1"></canvas></span><span class="ps-check">${CHECK_ICON}</span><span class="ps-num">${p}</span><span class="ps-group"></span></button><button type="button" class="ps-rot" aria-label="第 ${p} 頁向右旋轉 90 度" title="向右旋轉 90°">${ROTATE_ICON}</button>`;
      frag.append(li);
      observer.observe(li);
    }
    grid.append(frag);
  }

  // ---------- State → UI ----------
  function currentPlans(): OutputPlan[] {
    return planOutputs(mode(), pageCount, [...selected], everyN(), fileName);
  }

  function refresh() {
    const m = mode();
    const selecting = m === 'extract' || m === 'delete';
    rangeField.hidden = !selecting;
    everyField.hidden = m !== 'every';
    grid.dataset.mode = m;
    const n = everyN();
    for (const tile of $$<HTMLElement>('.ps-tile', grid)) {
      const p = Number(tile.dataset.page);
      const on = selecting && selected.has(p);
      tile.classList.toggle('is-selected', on);
      const pick = tile.querySelector<HTMLButtonElement>('.ps-pick')!;
      pick.setAttribute('aria-pressed', String(on));
      pick.disabled = !selecting;
      const group = tile.querySelector('.ps-group')!;
      group.textContent = m === 'every' ? `第 ${Math.ceil(p / n)} 份` : m === 'each' ? `第 ${p} 份` : '';
      const rot = rotations[p] ?? 0;
      tile.style.setProperty('--rot', `${rot}deg`);
      tile.classList.toggle('is-rotated', rot !== 0);
    }

    const plans = currentPlans();
    const pages = plans.reduce((s, x) => s + x.pages.length, 0);
    let text = '';
    if (!pageCount) text = '';
    else if (m === 'extract') text = plans.length ? `將輸出 1 個 PDF，包含第 ${formatPageRanges(plans[0].pages)} 頁，共 ${formatInteger(pages)} 頁。` : '尚未選取頁面：點選縮圖或在上方輸入頁碼。';
    else if (m === 'delete')
      text = selected.size === 0 ? '尚未選取要刪除的頁面：點選縮圖或在上方輸入頁碼。' : plans.length ? `將刪除 ${formatInteger(selected.size)} 頁，輸出剩下的 ${formatInteger(pages)} 頁。` : '不能刪除全部頁面，請至少保留一頁。';
    else text = `將輸出 ${formatInteger(plans.length)} 個 PDF${plans.length > 1 ? '，打包成一個 ZIP 下載' : ''}。`;
    plan.textContent = text;
    plan.hidden = !text;

    runBtn.disabled = busy || !editable || plans.length === 0;
    if (!busy) runBtn.textContent = m === 'extract' ? '擷取並下載' : m === 'delete' ? '刪除頁面並下載' : plans.length > 1 ? '分割並下載 ZIP' : '分割並下載';
  }

  function invalidate() {
    outputs = [];
    results.hidden = true;
    filesList.replaceChildren();
  }

  function syncRangeInput() {
    rangeInput.value = formatPageRanges(selected);
    rangeHint.textContent = RANGE_HINT;
    rangeHint.classList.remove('ps-bad');
  }

  // ---------- Loading ----------
  function reset() {
    loadToken++;
    observer?.disconnect();
    void pdf?.loadingTask.destroy();
    pdf = null;
    bytes = null;
    pageCount = 0;
    selected = new Set();
    rotations = {};
    invalidate();
    grid.replaceChildren();
    work.hidden = true;
    drop.hidden = false;
    tryRow.hidden = false;
  }

  async function load(file: File) {
    reset();
    const token = loadToken;
    showNote('');
    drop.hidden = true;
    tryRow.hidden = true;
    work.hidden = false;
    fileName = file.name;
    $('#ps-filename', root).textContent = file.name;
    $('#ps-fileinfo', root).textContent = `${formatBytes(file.size)}・讀取中…`;
    plan.hidden = true;
    runBtn.disabled = true;
    try {
      const data = new Uint8Array(await file.arrayBuffer());
      const doc = await openForRender(data);
      if (token !== loadToken) return void doc.loadingTask.destroy();
      bytes = data;
      pdf = doc;
      pageCount = doc.numPages;
    } catch (err) {
      if (token !== loadToken) return;
      reset();
      showNote(
        err instanceof OpenError && err.code === 'encrypted'
          ? '這份 PDF 需要密碼才能開啟，無法在瀏覽器中分割。請先用原本的軟體輸入密碼並另存一份沒有密碼的 PDF，再重新選擇。'
          : '無法讀取這個檔案，可能不是 PDF 或檔案已損毀。',
      );
      return;
    }
    $('#ps-fileinfo', root).textContent = `共 ${formatInteger(pageCount)} 頁・${formatBytes(file.size)}`;
    buildGrid();
    syncRangeInput();
    refresh();
    // pdf-lib does the actual writing; check early that it can open this file.
    editable = true;
    try {
      const { loadPdf } = await ops();
      await loadPdf(bytes);
    } catch (err) {
      if (token !== loadToken) return;
      editable = false;
      const { errorText } = await ops();
      showNote(errorText(err));
      refresh();
    }
  }

  // ---------- Selection ----------
  function applySelection(next: Set<number>) {
    selected = next;
    syncRangeInput();
    invalidate();
    refresh();
  }

  grid.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const tile = target?.closest<HTMLElement>('.ps-tile');
    if (!tile) return;
    const page = Number(tile.dataset.page);
    if (target?.closest('.ps-rot')) {
      rotations[page] = addRotation(rotations[page] ?? 0, 90);
      invalidate();
      refresh();
      return;
    }
    if (!target?.closest('.ps-pick')) return;
    const next = new Set(selected);
    if ((event as MouseEvent).shiftKey && lastClicked) {
      const [a, b] = lastClicked < page ? [lastClicked, page] : [page, lastClicked];
      for (let p = a; p <= b; p++) next.add(p);
    } else if (next.has(page)) next.delete(page);
    else next.add(page);
    lastClicked = page;
    applySelection(next);
  });

  $$<HTMLButtonElement>('[data-select]', root).forEach((button) =>
    button.addEventListener('click', () => {
      const next = new Set<number>();
      for (let p = 1; p <= pageCount; p++) {
        const kind = button.dataset.select;
        if (kind === 'all' || (kind === 'odd' && p % 2 === 1) || (kind === 'even' && p % 2 === 0) || (kind === 'invert' && !selected.has(p))) next.add(p);
      }
      applySelection(next);
    }),
  );

  rangeInput.addEventListener(
    'input',
    debounce(() => {
      const { pages, errors } = parsePageRanges(rangeInput.value, pageCount);
      selected = new Set(pages);
      rangeHint.textContent = errors.length ? errors.join('；') : RANGE_HINT;
      rangeHint.classList.toggle('ps-bad', errors.length > 0);
      invalidate();
      refresh();
    }, 250),
  );
  rangeInput.addEventListener('blur', () => {
    if (!rangeHint.classList.contains('ps-bad')) syncRangeInput();
  });

  $('#ps-rotate-all', root).addEventListener('click', () => {
    for (let p = 1; p <= pageCount; p++) rotations[p] = addRotation(rotations[p] ?? 0, 90);
    invalidate();
    refresh();
  });

  modeRadios.forEach((r) =>
    r.addEventListener('change', () => {
      savePrefs();
      invalidate();
      refresh();
    }),
  );
  everyInput.addEventListener('input', () => {
    savePrefs();
    invalidate();
    refresh();
  });

  // ---------- Output ----------
  function drawResults() {
    filesList.replaceChildren();
    for (const out of outputs) {
      const li = document.createElement('li');
      const info = document.createElement('div');
      const name = document.createElement('div');
      name.className = 'ps-out-name';
      name.textContent = out.plan.filename;
      const meta = document.createElement('div');
      meta.className = 'hint';
      meta.textContent = `${formatInteger(out.plan.pages.length)} 頁・${formatBytes(out.blob.size)}`;
      info.append(name, meta);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn small';
      btn.textContent = '下載';
      btn.addEventListener('click', () => downloadBlob(out.blob, out.plan.filename));
      li.append(info, btn);
      filesList.append(li);
    }
    $('#ps-results-title', root).textContent = `已產生 ${formatInteger(outputs.length)} 個 PDF`;
    $<HTMLButtonElement>('#ps-zip', root).hidden = outputs.length < 2;
    results.hidden = outputs.length === 0;
  }

  function downloadZip() {
    const zip = createZip(outputs.map((o) => ({ name: o.plan.filename, data: o.bytes })));
    downloadBlob(new Blob([zip], { type: 'application/zip' }), `${baseName(fileName)}-split.zip`);
  }

  runBtn.addEventListener('click', async () => {
    if (!bytes || busy) return;
    const plans = currentPlans();
    if (!plans.length) return;
    busy = true;
    runBtn.disabled = true;
    runBtn.textContent = '處理中…';
    try {
      const { buildFromPages } = await ops();
      const made = await buildFromPages(
        bytes,
        plans.map((p) => p.pages),
        rotations,
        (n, total) => total > 1 && (runBtn.textContent = `處理中…（${n}/${total}）`),
      );
      outputs = made.map((data, i) => ({
        plan: plans[i],
        bytes: data as Uint8Array<ArrayBuffer>,
        blob: new Blob([data as Uint8Array<ArrayBuffer>], { type: 'application/pdf' }),
      }));
      drawResults();
      if (outputs.length === 1) downloadBlob(outputs[0].blob, outputs[0].plan.filename);
      else downloadZip();
    } catch (err) {
      const { errorText } = await ops();
      showNote(`處理失敗：${errorText(err)}`);
    } finally {
      busy = false;
      refresh();
    }
  });
  $('#ps-zip', root).addEventListener('click', downloadZip);
  $('#ps-replace', root).addEventListener('click', () => {
    reset();
    showNote('');
    fileInput.click();
  });

  $('#ps-sample', root).addEventListener('click', async () => {
    const { makeSamplePdf } = await ops();
    const data = await makeSamplePdf('Report', 8, 0.14);
    await load(new File([data as Uint8Array<ArrayBuffer>], 'sample-report.pdf', { type: 'application/pdf' }));
  });

  // ---------- File input wiring ----------
  function pick(files: File[]) {
    const pdfFile = files.find((f) => isPdf(f.type, f.name));
    if (!pdfFile) {
      showNote('請選擇 PDF 檔案。若要把圖片轉成 PDF，請使用「圖片轉 PDF」工具。');
      return;
    }
    void load(pdfFile).then(() => {
      if (files.length > 1 && pdf) showNote('一次只能分割一個 PDF，已開啟第一個檔案。要把多個 PDF 合成一份，請使用「PDF 合併」。');
    });
  }
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) pick(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) pick(Array.from(e.dataTransfer.files));
  });
  // Dropping a new file onto the page grid replaces the current one.
  work.addEventListener('dragover', (e) => e.preventDefault());
  work.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) pick(Array.from(e.dataTransfer.files));
  });

  const prefs = loadPref<Prefs>('pdf-split', { mode: 'extract', every: 2 });
  for (const r of modeRadios) r.checked = r.value === prefs.mode;
  if (!modeRadios.some((r) => r.checked)) modeRadios[0].checked = true;
  everyInput.value = String(prefs.every >= 1 ? prefs.every : 2);
  refresh();
</script>

<style>
  .ps-privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--success) 30%, transparent);
    border-radius: var(--radius-sm);
  }
  .ps-privacy svg {
    flex: none;
    margin-top: 1px;
    color: var(--success);
  }
  .ps-work {
    display: grid;
    gap: 16px;
  }
  .ps-filebar {
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .ps-fileinfo {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .ps-fileinfo strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.ps-bad) {
    color: var(--danger) !important;
  }
  .ps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .ps-grid :global(.ps-tile) {
    position: relative;
  }
  .ps-grid :global(.ps-pick) {
    position: relative;
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 6px 6px 4px;
    font: inherit;
    color: var(--text-2);
    background: var(--surface-2);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .ps-grid :global(.ps-pick:disabled) {
    cursor: default;
    opacity: 1;
  }
  .ps-grid :global(.ps-thumb) {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface);
    border-radius: 4px;
  }
  .ps-grid :global(.ps-thumb canvas) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.2s ease;
  }
  .ps-grid :global(.ps-tile:not(.is-rendered) .ps-thumb canvas) {
