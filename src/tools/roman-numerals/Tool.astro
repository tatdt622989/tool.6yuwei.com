---
import type { ToolProps } from '../../i18n/tool';
import { COMMON_NUMBERS, toRomanBasic } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
const examples = COMMON_NUMBERS.map((n) => ({ n, roman: toRomanBasic(n) }));
const SYMBOLS = [
  ['I', 1],
  ['V', 5],
  ['X', 10],
  ['L', 50],
  ['C', 100],
  ['D', 500],
  ['M', 1000],
] as const;
---

<div class="tool" data-tool="roman-numerals" data-locale={locale}>
  <div class="grid-2">
    <div class="field">
      <label for="rn-num">Number</label>
      <input id="rn-num" class="rn-input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" value="2026" />
    </div>
    <div class="field">
      <label for="rn-roman">Roman numeral</label>
      <input
        id="rn-roman"
        class="rn-input mono"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        value="MMXXVI"
      />
    </div>
  </div>
  <label class="check"><input type="checkbox" id="rn-big" /> Allow numbers up to 3,999,999 (bar over a letter = × 1,000)</label>

  <div class="result" aria-live="polite">
    <div class="result-value rn-main" id="rn-main">—</div>
    <div class="result-label" id="rn-main-label">&nbsp;</div>
    <div class="row rn-actions">
      <button class="btn small" type="button" data-copy="#rn-main">Copy</button>
    </div>
  </div>

  <div class="notice error" id="rn-error" role="alert" hidden></div>

  <div class="rn-parts" id="rn-parts" aria-label="Breakdown"></div>

  <div class="row" id="rn-quick">
    <span class="hint">Try:</span>
    <button class="btn small" type="button" id="rn-this-year">This year</button>
    <button class="btn small" type="button" data-n="1776">1776</button>
    <button class="btn small" type="button" data-n="2000">2000</button>
    <button class="btn small" type="button" data-n="3999">3999</button>
    <button class="btn small" type="button" data-r="XLIX">XLIX</button>
    <button class="btn small" type="button" data-r="IIII">IIII</button>
  </div>

  <section class="rn-card" aria-labelledby="rn-date-title">
    <h2 class="rn-card-title" id="rn-date-title">Date to Roman numerals</h2>
    <div class="grid-3">
      <div class="field">
        <label for="rn-date">Date</label>
        <input id="rn-date" type="date" value="2026-10-29" />
      </div>
      <div class="field">
        <label for="rn-order">Order</label>
        <select id="rn-order">
          <option value="mdy">Month · Day · Year (US)</option>
          <option value="dmy">Day · Month · Year</option>
          <option value="ymd">Year · Month · Day</option>
        </select>
      </div>
      <div class="field">
        <label for="rn-sep">Separator</label>
        <select id="rn-sep">
          <option value=".">Dot (X.XXIX.MMXXVI)</option>
          <option value=" · ">Middle dot</option>
          <option value="-">Dash</option>
          <option value=" ">Space</option>
        </select>
      </div>
    </div>
    <div class="output rn-date-out" id="rn-date-out">—</div>
    <div class="row"><button class="btn small" type="button" data-copy="#rn-date-out">Copy date</button></div>
  </section>

  <details class="rn-card rn-ref">
    <summary class="rn-card-title">Roman numeral chart</summary>
    <div class="rn-symbols">
      {
        SYMBOLS.map(([s, v]) => (
          <div class="stat">
            <span class="stat-value mono">{s}</span>
            <span class="stat-label">{v.toLocaleString('en-US')}</span>
          </div>
        ))
      }
    </div>
    <div class="rn-examples">
      {
        examples.map((e) => (
          <div class="rn-ex">
            <span class="num">{e.n.toLocaleString('en-US')}</span>
            <span class="mono">{e.roman}</span>
          </div>
        ))
      }
    </div>
  </details>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import {
    breakdown,
    dateToRoman,
    MAX_STANDARD,
    MAX_VINCULUM,
    parseInteger,
    parseRoman,
    toRoman,
    type DateOrder,
  } from './logic';

  const root = $('[data-tool="roman-numerals"]');
  const locale = (root.dataset.locale ?? 'en') as Locale;
  const num = $<HTMLInputElement>('#rn-num', root);
  const roman = $<HTMLInputElement>('#rn-roman', root);
  const big = $<HTMLInputElement>('#rn-big', root);
  const main = $('#rn-main', root);
  const mainLabel = $('#rn-main-label', root);
  const error = $('#rn-error', root);
  const parts = $('#rn-parts', root);
  const date = $<HTMLInputElement>('#rn-date', root);
  const order = $<HTMLSelectElement>('#rn-order', root);
  const sep = $<HTMLSelectElement>('#rn-sep', root);
  const dateOut = $('#rn-date-out', root);

  interface Prefs {
    num: string;
    big: boolean;
    order: DateOrder;
    sep: string;
  }
  const saved = loadPref<Partial<Prefs>>('roman-numerals', {});
  big.checked = saved.big === true;
  if (saved.order) order.value = saved.order;
  if (saved.sep !== undefined) sep.value = saved.sep;
  if (!order.value) order.value = 'mdy';
  if (!sep.value) sep.value = '.';

  const fmt = (n: number) => formatInteger(n, locale);

  function persist() {
    savePref('roman-numerals', { num: num.value, big: big.checked, order: order.value as DateOrder, sep: sep.value } satisfies Prefs);
  }

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    main.textContent = '—';
    mainLabel.textContent = ' ';
    parts.replaceChildren();
  }

  function showParts(n: number) {
    parts.replaceChildren(
      ...breakdown(n).map(([value, text], i) => {
        const chip = document.createElement('span');
        chip.className = 'rn-chip';
        const r = document.createElement('strong');
        r.className = 'mono';
        r.textContent = text;
        const v = document.createElement('span');
        v.textContent = `${i > 0 ? '+ ' : ''}${fmt(value)}`;
        chip.append(r, v);
        return chip;
      }),
    );
  }

  function fromNumber() {
    persist();
    const n = parseInteger(num.value);
    if (num.value.trim() === '') {
      roman.value = '';
      return fail('Type a number from 1 to 3,999, or a Roman numeral on the right.');
    }
    const r = toRoman(n, big.checked);
    if (!r.ok) {
      roman.value = '';
      const messages = {
        'not-integer': 'Roman numerals only exist for whole numbers. Enter an integer such as 42.',
        zero: 'There is no Roman numeral for zero. Romans wrote the word nulla (nothing) instead.',
        negative: 'Roman numerals have no negative numbers. Enter a number of 1 or more.',
        'too-large': big.checked
          ? `The largest number this converter writes is ${fmt(MAX_VINCULUM)} (M̅M̅M̅C̅M̅X̅C̅I̅X̅CMXCIX).`
          : `Standard Roman numerals stop at ${fmt(MAX_STANDARD)} (MMMCMXCIX). Tick "Allow numbers up to 3,999,999" to use the bar notation.`,
      } as const;
      return fail(messages[r.error]);
    }
    error.hidden = true;
    roman.value = r.roman;
    main.textContent = r.roman;
    mainLabel.textContent = `${fmt(n)} in Roman numerals${r.vinculum ? ' (a bar multiplies by 1,000)' : ''}`;
    showParts(n);
  }

  function fromRoman() {
    if (roman.value.trim() === '') {
      num.value = '';
      persist();
      return fail('Type a Roman numeral such as MCMXCIV, or a number on the left.');
    }
    const r = parseRoman(roman.value);
    if (!r.ok) {
      num.value = '';
      persist();
      if (r.error === 'invalid-char') return fail(`"${r.badChar}" is not a Roman numeral letter. Use only I, V, X, L, C, D and M.`);
      if (r.error === 'malformed' && r.suggestion && r.guess !== undefined) {
        const tooBig = r.guess > MAX_STANDARD && !big.checked;
        return fail(
          `${roman.value.trim().toUpperCase()} is not a valid standard Roman numeral. ${fmt(r.guess)} is written ${r.suggestion}.` +
            (tooBig ? ' Numbers above 3,999 need the bar notation (tick the option above).' : ''),
        );
      }
      return fail(`${roman.value.trim().toUpperCase()} is not a valid Roman numeral.`);
    }
    if (r.value > MAX_STANDARD && !big.checked) big.checked = true;
    error.hidden = true;
    num.value = fmt(r.value);
    persist();
    main.textContent = fmt(r.value);
    mainLabel.textContent = `${r.canonical} as a number`;
    showParts(r.value);
  }

  function renderDate() {
    const out = dateToRoman(date.value, order.value as DateOrder, sep.value);
    dateOut.textContent = out ?? 'Pick a date between the years 1 and 3999.';
    persist();
  }

  num.addEventListener('input', fromNumber);
  roman.addEventListener('input', fromRoman);
  big.addEventListener('change', () => (document.activeElement === roman ? fromRoman() : fromNumber()));
  for (const el of [date, order, sep]) el.addEventListener('change', renderDate);
  date.addEventListener('input', renderDate);

  $('#rn-this-year', root).addEventListener('click', () => {
    num.value = String(new Date().getFullYear());
    fromNumber();
  });
  for (const b of $$<HTMLButtonElement>('[data-n]', root)) {
    b.addEventListener('click', () => {
      num.value = b.dataset.n!;
      fromNumber();
    });
  }
  for (const b of $$<HTMLButtonElement>('[data-r]', root)) {
    b.addEventListener('click', () => {
      roman.value = b.dataset.r!;
      fromRoman();
    });
  }

  if (saved.num) num.value = saved.num;
  // Default the date to today (the server-rendered value is only a fallback).
  const today = new Date();
  date.value = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
  fromNumber();
  renderDate();
</script>

<style>
  .rn-input {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  input.rn-input.mono {
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  .rn-main {
    font-family: var(--mono);
    letter-spacing: 0.02em;
    /* Room for the combining overline above the letters. */
    padding-top: 0.15em;
    line-height: 1.35;
  }
  .rn-actions {
    margin-top: 10px;
  }
  .rn-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rn-parts:empty {
    display: none;
  }
  .rn-parts :global(.rn-chip) {
    display: inline-grid;
    justify-items: center;
    gap: 2px;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }
  .rn-parts :global(.rn-chip strong) {
    font-size: 17px;
    color: var(--text);
    line-height: 1.4;
  }
  .rn-card {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .rn-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
  .rn-ref summary {
    cursor: pointer;
  }
  .rn-date-out {
    font-size: 20px;
    letter-spacing: 0.03em;
  }
  .rn-symbols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(72px, 1fr));
    gap: 8px;
  }
  .rn-symbols .stat {
    text-align: center;
  }
  .rn-examples {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 4px 16px;
    font-size: 14px;
  }
  .rn-ex {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
  }
  .rn-ex .num {
    color: var(--muted);
  }
</style>
