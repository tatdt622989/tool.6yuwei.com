---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { scaleSegments, scaleTicks } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const segments = scaleSegments(s.standard);
const ticks = scaleTicks(s.standard);
---

<div class="tool" data-tool="bmi-calculator" data-standard={s.standard} {...i18nAttrs(locale, s.client)}>
  {
    s.units && (
      <div class="seg" role="radiogroup" aria-label={s.units.legend}>
        <label>
          <input type="radio" name="bmi-unit" value="imperial" checked />
          <span>{s.units.imperial}</span>
        </label>
        <label>
          <input type="radio" name="bmi-unit" value="metric" />
          <span>{s.units.metric}</span>
        </label>
      </div>
    )
  }
  <div class="grid-2" data-units="metric" hidden={Boolean(s.units)}>
    <div class="field">
      <label for="bmi-height">{s.heightCm}</label>
      <input id="bmi-height" type="text" inputmode="decimal" autocomplete="off" value="170" />
    </div>
    <div class="field">
      <label for="bmi-weight">{s.weightKg}</label>
      <input id="bmi-weight" type="text" inputmode="decimal" autocomplete="off" value="65" />
    </div>
  </div>
  {
    s.units && (
      <div class="bmi-us" data-units="imperial">
        <div class="field">
          <label for="bmi-ft">{s.units.heightFt}</label>
          <input id="bmi-ft" type="text" inputmode="decimal" autocomplete="off" value="5" />
        </div>
        <div class="field">
          <label for="bmi-in">{s.units.heightIn}</label>
          <input id="bmi-in" type="text" inputmode="decimal" autocomplete="off" value="9" />
        </div>
        <div class="field">
          <label for="bmi-lb">{s.units.weightLb}</label>
          <input id="bmi-lb" type="text" inputmode="decimal" autocomplete="off" value="160" />
        </div>
      </div>
    )
  }

  <div class="result" aria-live="polite">
    <div class="result-value"><span id="bmi-value">—</span> <span class="bmi-level" id="bmi-level"></span></div>
    <div class="result-label">{s.resultLabel}</div>
  </div>

  <div class="bmi-scale" aria-hidden="true">
    <div class="bmi-track">
      <div class="bmi-bands">
        {segments.map((seg) => <span class="bmi-seg" data-level={seg.level} style={`flex-grow:${seg.grow}`} />)}
      </div>
      <span class="bmi-marker" id="bmi-marker"></span>
    </div>
    <div class="bmi-ticks">
      {ticks.map((tick) => <span style={`left:${tick.left}%`}>{tick.value}</span>)}
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="bmi-range">—</span><span class="stat-label">{s.rangeLabel}</span></div>
    <div class="stat"><span class="stat-value" id="bmi-gap">—</span><span class="stat-label" id="bmi-gap-label">{s.client.gapDefault}</span></div>
    {
      s.idealLabel && (
        <div class="stat">
          <span class="stat-value" id="bmi-ideal">—</span>
          <span class="stat-label">{s.idealLabel}</span>
        </div>
      )
    }
  </div>

  <div class="notice" id="bmi-error" hidden></div>

  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import {
    classifyBmi,
    computeBmi,
    feetInchesToCm,
    healthyWeightRange,
    HEIGHT_RANGE,
    IDEAL_BMI,
    kgToLb,
    lbToKg,
    roundBmi,
    scalePercent,
    WEIGHT_RANGE,
    weightAtBmi,
    weightGap,
    type BmiStandard,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="bmi-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const standard = (root.dataset.standard ?? 'tw') as BmiStandard;
  const height = $<HTMLInputElement>('#bmi-height', root);
  const weight = $<HTMLInputElement>('#bmi-weight', root);
  const ft = root.querySelector<HTMLInputElement>('#bmi-ft');
  const inch = root.querySelector<HTMLInputElement>('#bmi-in');
  const lb = root.querySelector<HTMLInputElement>('#bmi-lb');
  const unitRadios = $$<HTMLInputElement>('input[name="bmi-unit"]', root);
  const value = $('#bmi-value', root);
  const level = $('#bmi-level', root);
  const marker = $('#bmi-marker', root);
  const range = $('#bmi-range', root);
  const gap = $('#bmi-gap', root);
  const gapLabel = $('#bmi-gap-label', root);
  const ideal = root.querySelector<HTMLElement>('#bmi-ideal');
  const error = $('#bmi-error', root);

  interface Prefs {
    height: string;
    weight: string;
    unit?: 'metric' | 'imperial';
    ft?: string;
    inch?: string;
    lb?: string;
  }
  const saved = loadPref<Prefs>('bmi-calculator', { height: '170', weight: '65' });
  height.value = saved.height;
  weight.value = saved.weight;
  if (ft && inch && lb) {
    ft.value = saved.ft ?? ft.value;
    inch.value = saved.inch ?? inch.value;
    lb.value = saved.lb ?? lb.value;
  }
  const savedUnit = unitRadios.find((r) => r.value === saved.unit);
  if (savedUnit) savedUnit.checked = true;

  const imperial = () => unitRadios.find((r) => r.checked)?.value === 'imperial';

  function showUnits() {
    const active = imperial() ? 'imperial' : 'metric';
    $$<HTMLElement>('[data-units]', root).forEach((el) => (el.hidden = el.dataset.units !== active));
  }

  /** Weight in the unit the user is typing in. */
  function showWeight(kg: number, digits = 1): string {
    return imperial()
      ? `${formatNumber(kgToLb(kg), digits, locale)} ${s.lb}`
      : `${formatNumber(kg, digits, locale)} ${s.kg}`;
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = false;
    value.textContent = '—';
    level.textContent = '';
    level.removeAttribute('data-level');
    marker.hidden = true;
    range.textContent = '—';
    gap.textContent = '—';
    if (ideal) ideal.textContent = '—';
  }

  function read(): { h: number; w: number } {
    if (imperial() && ft && inch && lb) {
      return { h: feetInchesToCm(parseNumber(ft.value), parseNumber(inch.value)), w: lbToKg(parseNumber(lb.value)) };
    }
    return { h: parseNumber(height.value), w: parseNumber(weight.value) };
  }

  function render() {
    savePref('bmi-calculator', {
      height: height.value,
      weight: weight.value,
      ...(ft && inch && lb ? { unit: imperial() ? 'imperial' : 'metric', ft: ft.value, inch: inch.value, lb: lb.value } : {}),
    });
    const { h, w } = read();
    if (Number.isNaN(h) || Number.isNaN(w)) return showError(s.errorEmpty);
    if (h < HEIGHT_RANGE.min || h > HEIGHT_RANGE.max) return showError(s.errorHeight);
    if (w < WEIGHT_RANGE.min || w > WEIGHT_RANGE.max) return showError(s.errorWeight);

    error.hidden = true;
    const bmi = computeBmi(h, w);
    const band = classifyBmi(bmi, standard)!;
    value.textContent = formatFixed(roundBmi(bmi), 1, locale);
    level.textContent = s.levels[band.level] ?? band.label;
    level.dataset.level = band.level;
    marker.hidden = false;
    marker.style.left = `${scalePercent(bmi)}%`;

    const r = healthyWeightRange(h, standard)!;
    const unit = imperial() ? s.lb : s.kg;
    const toUnit = (kg: number) => (imperial() ? kgToLb(kg) : kg);
    range.textContent = `${formatNumber(toUnit(r.min), 1, locale)}–${formatNumber(toUnit(r.max), 1, locale)} ${unit}`;
    const g = weightGap(h, w, standard);
    if (g === 0) {
      gap.textContent = s.inRange;
      gapLabel.textContent = s.gapDefault;
    } else {
      gap.textContent = showWeight(Math.max(Math.abs(g), 0.1));
      gapLabel.textContent = g < 0 ? s.gapLose : s.gapGain;
    }
    if (ideal) ideal.textContent = showWeight(weightAtBmi(h, IDEAL_BMI));
  }

  for (const input of [height, weight, ft, inch, lb]) input?.addEventListener('input', render);
  unitRadios.forEach((radio) =>
    radio.addEventListener('change', () => {
      showUnits();
      render();
    }),
  );
  showUnits();
  render();
</script>

<style>
  .bmi-level {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 10px;
    font-size: 15px;
    font-weight: 600;
    vertical-align: middle;
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .bmi-level[data-level='normal'] {
    color: var(--success);
  }
  .bmi-level[data-level='under'] {
    color: var(--accent);
  }
  .bmi-level[data-level='over'] {
    color: var(--warning);
  }
  .bmi-level[data-level^='obese'] {
    color: var(--danger);
  }
  .bmi-us {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .bmi-us .field:last-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .bmi-us {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .bmi-us .field:last-child {
      grid-column: auto;
    }
  }

  .bmi-scale {
    padding: 4px 0 0;
  }
  .bmi-track {
    position: relative;
    height: 12px;
  }
  .bmi-bands {
    display: flex;
    height: 100%;
    border-radius: 6px;
    overflow: hidden;
  }
  .bmi-seg {
    flex-basis: 0;
    box-shadow: inset -2px 0 0 var(--surface);
  }
  .bmi-seg:last-child {
    box-shadow: none;
  }
  .bmi-seg[data-level='under'] {
    background: color-mix(in oklab, var(--accent) 55%, var(--surface-2));
  }
  .bmi-seg[data-level='normal'] {
    background: var(--success);
  }
  .bmi-seg[data-level='over'] {
    background: var(--warning);
  }
  .bmi-seg[data-level='obese1'] {
    background: color-mix(in oklab, var(--warning) 45%, var(--danger));
  }
  .bmi-seg[data-level='obese2'] {
    background: var(--danger);
  }
  .bmi-seg[data-level='obese3'] {
    background: color-mix(in oklab, var(--danger) 70%, var(--text));
  }
  .bmi-seg[data-level='obese4'] {
    background: color-mix(in oklab, var(--danger) 50%, var(--text));
  }
  .bmi-marker {
    position: absolute;
    top: -5px;
    width: 4px;
    height: 22px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text);
    box-shadow: 0 0 0 2px var(--surface);
    transition: left 0.2s;
  }
  .bmi-ticks {
    position: relative;
    height: 20px;
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .bmi-ticks span {
    position: absolute;
    transform: translateX(-50%);
  }
</style>
