---
import { BMI_BANDS, SCALE_MAX, SCALE_MIN } from './logic';

const span = SCALE_MAX - SCALE_MIN;
const segments = BMI_BANDS.map((band) => ({
  level: band.level,
  label: band.label,
  grow: Math.min(band.max, SCALE_MAX) - Math.max(band.min, SCALE_MIN),
}));
const ticks = BMI_BANDS.slice(1).map((band) => ({ value: band.min, left: ((band.min - SCALE_MIN) / span) * 100 }));
---

<div class="tool" data-tool="bmi-calculator">
  <div class="grid-2">
    <div class="field">
      <label for="bmi-height">身高（公分）</label>
      <input id="bmi-height" type="text" inputmode="decimal" autocomplete="off" value="170" />
    </div>
    <div class="field">
      <label for="bmi-weight">體重（公斤）</label>
      <input id="bmi-weight" type="text" inputmode="decimal" autocomplete="off" value="65" />
    </div>
  </div>

  <div class="result" aria-live="polite">
    <div class="result-value"><span id="bmi-value">—</span> <span class="bmi-level" id="bmi-level"></span></div>
    <div class="result-label">你的 BMI（身體質量指數）</div>
  </div>

  <div class="bmi-scale" aria-hidden="true">
    <div class="bmi-track">
      <div class="bmi-bands">
        {segments.map((s) => <span class="bmi-seg" data-level={s.level} style={`flex-grow:${s.grow}`} />)}
      </div>
      <span class="bmi-marker" id="bmi-marker"></span>
    </div>
    <div class="bmi-ticks">
      {ticks.map((t) => <span style={`left:${t.left}%`}>{t.value}</span>)}
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="bmi-range">—</span><span class="stat-label">此身高的健康體重</span></div>
    <div class="stat"><span class="stat-value" id="bmi-gap">—</span><span class="stat-label" id="bmi-gap-label">距離健康體位</span></div>
  </div>

  <div class="notice" id="bmi-error" hidden></div>

  <p class="hint">
    標準依衛福部國民健康署成人定義：BMI &lt; 18.5 過輕、18.5–24 正常、24–27 過重、27 以上肥胖。未滿 18 歲、孕婦與肌肉量高的運動員不適用此標準。
  </p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import {
    classifyBmi,
    computeBmi,
    healthyWeightRange,
    HEIGHT_RANGE,
    roundBmi,
    scalePercent,
    WEIGHT_RANGE,
    weightGap,
  } from './logic';

  const root = $('[data-tool="bmi-calculator"]');
  const height = $<HTMLInputElement>('#bmi-height', root);
  const weight = $<HTMLInputElement>('#bmi-weight', root);
  const value = $('#bmi-value', root);
  const level = $('#bmi-level', root);
  const marker = $('#bmi-marker', root);
  const range = $('#bmi-range', root);
  const gap = $('#bmi-gap', root);
  const gapLabel = $('#bmi-gap-label', root);
  const error = $('#bmi-error', root);

  const saved = loadPref('bmi-calculator', { height: '170', weight: '65' });
  height.value = saved.height;
  weight.value = saved.weight;

  function showError(message: string) {
    error.textContent = message;
    error.hidden = false;
    value.textContent = '—';
    level.textContent = '';
    level.removeAttribute('data-level');
    marker.hidden = true;
    range.textContent = '—';
    gap.textContent = '—';
  }

  function render() {
    savePref('bmi-calculator', { height: height.value, weight: weight.value });
    const h = parseNumber(height.value);
    const w = parseNumber(weight.value);
    if (Number.isNaN(h) || Number.isNaN(w)) return showError('請輸入身高與體重。');
    if (h < HEIGHT_RANGE.min || h > HEIGHT_RANGE.max) return showError('身高請以公分輸入，例如 170。');
    if (w < WEIGHT_RANGE.min || w > WEIGHT_RANGE.max) return showError('體重請以公斤輸入，例如 65。');

    error.hidden = true;
    const bmi = computeBmi(h, w);
    const band = classifyBmi(bmi)!;
    value.textContent = roundBmi(bmi).toFixed(1);
    level.textContent = band.label;
    level.dataset.level = band.level;
    marker.hidden = false;
    marker.style.left = `${scalePercent(bmi)}%`;

    const r = healthyWeightRange(h)!;
    range.textContent = `${formatNumber(r.min, 1)}–${formatNumber(r.max, 1)} kg`;
    const g = weightGap(h, w);
    if (g === 0) {
      gap.textContent = '已在範圍內';
      gapLabel.textContent = '距離健康體位';
    } else {
      gap.textContent = `${formatNumber(Math.max(Math.abs(g), 0.1), 1)} kg`;
      gapLabel.textContent = g < 0 ? '減重至健康上限約需' : '增重至健康下限約需';
    }
  }

  height.addEventListener('input', render);
  weight.addEventListener('input', render);
  render();
</script>

<style>
  .bmi-level {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 10px;
    font-size: 15px;
    font-weight: 600;
    vertical-align: middle;
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .bmi-level[data-level='normal'] {
    color: var(--success);
  }
  .bmi-level[data-level='under'] {
    color: var(--accent);
  }
  .bmi-level[data-level='over'] {
    color: var(--warning);
  }
  .bmi-level[data-level^='obese'] {
    color: var(--danger);
  }

  .bmi-scale {
    padding: 4px 0 0;
  }
  .bmi-track {
    position: relative;
    height: 12px;
  }
  .bmi-bands {
    display: flex;
    height: 100%;
    border-radius: 6px;
    overflow: hidden;
  }
  .bmi-seg {
    flex-basis: 0;
    box-shadow: inset -2px 0 0 var(--surface);
  }
  .bmi-seg:last-child {
    box-shadow: none;
  }
  .bmi-seg[data-level='under'] {
    background: color-mix(in oklab, var(--accent) 55%, var(--surface-2));
  }
  .bmi-seg[data-level='normal'] {
    background: var(--success);
  }
  .bmi-seg[data-level='over'] {
    background: var(--warning);
  }
  .bmi-seg[data-level='obese1'] {
    background: color-mix(in oklab, var(--warning) 45%, var(--danger));
  }
  .bmi-seg[data-level='obese2'] {
    background: var(--danger);
  }
  .bmi-seg[data-level='obese3'] {
    background: color-mix(in oklab, var(--danger) 70%, var(--text));
  }
  .bmi-marker {
    position: absolute;
    top: -5px;
    width: 4px;
    height: 22px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text);
    box-shadow: 0 0 0 2px var(--surface);
    transition: left 0.2s;
  }
  .bmi-ticks {
    position: relative;
    height: 20px;
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .bmi-ticks span {
    position: absolute;
    transform: translateX(-50%);
  }
</style>
