---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const TO_DATE_ROWS = s.toDateRows;
const TO_TS_ROWS = s.toTsRows;
---

<div class="tool" data-tool="timestamp-converter" {...i18nAttrs(locale, s.client)}>
  <section class="ts-now" aria-labelledby="ts-now-title">
    <h2 class="ts-title" id="ts-now-title">{s.nowTitle}</h2>
    <div class="big-display ts-big" id="ts-now-s" aria-live="off">0</div>
    <p class="ts-sub mono">{s.msBefore}<span id="ts-now-ms">0</span></p>
    <p class="hint ts-zone" id="ts-zone"></p>
    <div class="row ts-center">
      <button class="btn small" type="button" data-copy="#ts-now-s">{s.copySeconds}</button>
      <button class="btn small" type="button" data-copy="#ts-now-ms">{s.copyMs}</button>
      <button class="btn small ghost" type="button" id="ts-pause" aria-pressed="false">{s.client.pause}</button>
    </div>
  </section>

  <hr class="ts-sep" />

  <h2 class="ts-title">{s.toDateTitle}</h2>
  <div class="field">
    <label for="ts-input">{s.tsLabel}</label>
    <div class="row">
      <input id="ts-input" type="text" class="mono ts-input" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder={s.tsPlaceholder} />
      <button class="btn" type="button" id="ts-input-now">{s.now}</button>
    </div>
  </div>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.unitAria}>
      <label><input type="radio" name="ts-unit" value="auto" checked /><span>{s.unitAuto}</span></label>
      <label><input type="radio" name="ts-unit" value="s" /><span>{s.unitS}</span></label>
      <label><input type="radio" name="ts-unit" value="ms" /><span>{s.unitMs}</span></label>
    </div>
  </div>
  <div id="ts-input-error" class="notice error" role="alert" hidden></div>
  <div class="ts-rows" id="ts-to-date">
    {
      TO_DATE_ROWS.map(([key, label]) => (
        <div class="ts-row">
          <label for={`ts-d-${key}`}>{label}</label>
          <input id={`ts-d-${key}`} type="text" class="mono" readonly />
          <button class="btn small" type="button" data-copy={`#ts-d-${key}`}>{s.copy}</button>
        </div>
      ))
    }
  </div>

  <hr class="ts-sep" />

  <h2 class="ts-title">{s.toTsTitle}</h2>
  <div class="field">
    <label for="ts-date">{s.dateLabel}</label>
    <div class="row">
      <input id="ts-date" type="datetime-local" step="1" class="ts-input" />
      <button class="btn" type="button" id="ts-date-now">{s.now}</button>
    </div>
  </div>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.zoneAria}>
      <label><input type="radio" name="ts-zone" value="local" checked /><span id="ts-zone-local-label">{s.localTime}</span></label>
      <label><input type="radio" name="ts-zone" value="UTC" /><span>UTC</span></label>
    </div>
  </div>
  <div id="ts-date-error" class="notice error" role="alert" hidden></div>
  <div class="ts-rows">
    {
      TO_TS_ROWS.map(([key, label]) => (
        <div class="ts-row">
          <label for={`ts-t-${key}`}>{label}</label>
          <input id={`ts-t-${key}`} type="text" class="mono" readonly />
          <button class="btn small" type="button" data-copy={`#ts-t-${key}`}>{s.copy}</button>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { LOCALE_INFO } from '../../i18n/locales';
  import {
    formatDateTime,
    formatOffset,
    localTimeZone,
    longDateTime,
    offsetMinutes,
    parseTimestamp,
    relativeTime,
    toIsoWithOffset,
    wallTimeToMs,
    wareki,
    weekday,
    type Unit,
  } from './logic';
  import type { DateRowKey, Strings } from './i18n';

  interface Prefs {
    unit: Unit | 'auto';
    zone: 'local' | 'UTC';
  }

  const root = $('[data-tool="timestamp-converter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const intl = LOCALE_INFO[locale].intl;
  const zone = localTimeZone();

  // ---- Live clock ----
  const nowS = $('#ts-now-s', root);
  const nowMs = $('#ts-now-ms', root);
  const pause = $<HTMLButtonElement>('#ts-pause', root);
  let paused = false;

  $('#ts-zone', root).textContent = t(s.yourZone, { zone, offset: formatOffset(offsetMinutes(Date.now(), zone)) });
  $('#ts-zone-local-label', root).textContent = t(s.localZoneLabel, { zone });

  function tick() {
    if (paused || document.hidden) return;
    const now = Date.now();
    nowS.textContent = String(Math.floor(now / 1000));
    nowMs.textContent = String(now);
  }
  pause.addEventListener('click', () => {
    paused = !paused;
    pause.textContent = paused ? s.resume : s.pause;
    pause.setAttribute('aria-pressed', String(paused));
    tick();
  });
  tick();
  window.setInterval(tick, 50);

  // ---- Timestamp → date ----
  const tsInput = $<HTMLInputElement>('#ts-input', root);
  const tsError = $('#ts-input-error', root);
  const unitRadios = $$<HTMLInputElement>('input[name="ts-unit"]', root);
  const out = (key: string) => $<HTMLInputElement>(`#ts-d-${key}`, root);

  // ---- Date → timestamp ----
  const dateInput = $<HTMLInputElement>('#ts-date', root);
  const dateError = $('#ts-date-error', root);
  const zoneRadios = $$<HTMLInputElement>('input[name="ts-zone"]', root);

  const readPrefs = (): Prefs => ({
    unit: (unitRadios.find((r) => r.checked)?.value ?? 'auto') as Prefs['unit'],
    zone: (zoneRadios.find((r) => r.checked)?.value ?? 'local') as Prefs['zone'],
  });

  function renderToDate() {
    savePref('timestamp-converter', readPrefs());
    tsError.hidden = true;
    const keys = $$<HTMLInputElement>('#ts-to-date input', root).map((el) => el.id.slice('ts-d-'.length) as DateRowKey);
    if (tsInput.value.trim() === '') {
      keys.forEach((k) => (out(k).value = ''));
      return;
    }
    const result = parseTimestamp(tsInput.value, readPrefs().unit, s.messages);
    if (!result.ok) {
      keys.forEach((k) => (out(k).value = ''));
      tsError.textContent = result.error;
      tsError.hidden = false;
      return;
    }
    const { ms, unit } = result;
    const value: Record<DateRowKey, () => string> = {
      local: () => formatDateTime(ms, zone) + t(s.offsetSuffix, { offset: formatOffset(offsetMinutes(ms, zone)) }),
      utc: () => formatDateTime(ms, 'UTC'),
      iso: () => new Date(ms).toISOString(),
      isolocal: () => toIsoWithOffset(ms, zone),
      weekday: () => weekday(ms, zone, intl),
      long: () => longDateTime(ms, zone, intl),
      wareki: () => wareki(ms, zone) ?? s.noWareki ?? '—',
      relative: () => relativeTime(ms, Date.now(), intl),
      unit: () => s.unitLabels[unit],
    };
    for (const k of keys) {
      try {
        out(k).value = value[k]();
      } catch {
        out(k).value = '—'; // Intl throws for dates outside its range (e.g. year 275760 with a calendar)
      }
    }
  }

  function toLocalInputValue(ms: number, timeZone: string): string {
    return formatDateTime(Math.floor(ms / 1000) * 1000, timeZone).replace(' ', 'T');
  }

  function renderToTimestamp() {
    savePref('timestamp-converter', readPrefs());
    dateError.hidden = true;
    const keys = ['s', 'ms', 'iso'];
    const set = (k: string, v: string) => ($<HTMLInputElement>(`#ts-t-${k}`, root).value = v);
    if (!dateInput.value) {
      keys.forEach((k) => set(k, ''));
      return;
    }
    const ms = wallTimeToMs(dateInput.value, readPrefs().zone === 'UTC' ? 'UTC' : zone);
    if (ms === null) {
      keys.forEach((k) => set(k, ''));
      dateError.textContent = s.dateError;
      dateError.hidden = false;
      return;
    }
    set('s', String(Math.floor(ms / 1000)));
    set('ms', String(ms));
    set('iso', new Date(ms).toISOString());
  }

  const prefs = loadPref<Prefs>('timestamp-converter', { unit: 'auto', zone: 'local' });
  unitRadios.forEach((r) => (r.checked = r.value === prefs.unit));
  zoneRadios.forEach((r) => (r.checked = r.value === prefs.zone));

  function fillNow() {
    tsInput.value = String(Math.floor(Date.now() / 1000));
    renderToDate();
  }
  function fillDateNow() {
    dateInput.value = toLocalInputValue(Date.now(), readPrefs().zone === 'UTC' ? 'UTC' : zone);
    renderToTimestamp();
  }

  tsInput.addEventListener('input', renderToDate);
  unitRadios.forEach((r) => r.addEventListener('change', renderToDate));
  $('#ts-input-now', root).addEventListener('click', fillNow);
  dateInput.addEventListener('input', renderToTimestamp);
  zoneRadios.forEach((r) => r.addEventListener('change', renderToTimestamp));
  $('#ts-date-now', root).addEventListener('click', fillDateNow);
  fillNow();
  fillDateNow();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ts-now {
    display: grid;
    gap: 6px;
    justify-items: center;
    text-align: center;
  }
  .ts-title {
    font-size: 18px;
  }
  .ts-big {
    font-size: clamp(40px, 11vw, 72px);
  }
  .ts-sub {
    margin: 0;
    color: var(--text-2);
  }
  .ts-zone {
    margin: 0;
  }
  .ts-center {
    justify-content: center;
  }
  .ts-sep {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 8px 0 0;
    width: 100%;
  }
  .ts-input {
    flex: 1;
    min-width: 0;
  }
  .ts-rows {
    display: grid;
    gap: 8px;
  }
  .ts-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }
  .ts-row label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  @media (max-width: 560px) {
    .ts-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .ts-row label {
      grid-column: 1 / -1;
    }
  }
</style>
