---
const TO_DATE_ROWS = [
  ['local', '本地時間'],
  ['utc', 'UTC 時間'],
  ['iso', 'ISO 8601（UTC）'],
  ['isolocal', 'ISO 8601（本地）'],
  ['weekday', '星期'],
  ['relative', '相對時間'],
  ['unit', '判斷單位'],
];
const TO_TS_ROWS = [
  ['s', 'Unix 時間戳（秒）'],
  ['ms', 'Unix 時間戳（毫秒）'],
  ['iso', 'ISO 8601（UTC）'],
];
---

<div class="tool" data-tool="timestamp-converter">
  <section class="ts-now" aria-labelledby="ts-now-title">
    <h2 class="ts-title" id="ts-now-title">目前 Unix 時間戳</h2>
    <div class="big-display ts-big" id="ts-now-s" aria-live="off">0</div>
    <p class="ts-sub mono">毫秒：<span id="ts-now-ms">0</span></p>
    <p class="hint ts-zone" id="ts-zone"></p>
    <div class="row ts-center">
      <button class="btn small" type="button" data-copy="#ts-now-s">複製秒</button>
      <button class="btn small" type="button" data-copy="#ts-now-ms">複製毫秒</button>
      <button class="btn small ghost" type="button" id="ts-pause" aria-pressed="false">暫停</button>
    </div>
  </section>

  <hr class="ts-sep" />

  <h2 class="ts-title">時間戳轉日期</h2>
  <div class="field">
    <label for="ts-input">Unix 時間戳</label>
    <div class="row">
      <input id="ts-input" type="text" class="mono ts-input" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="例如 1761717600" />
      <button class="btn" type="button" id="ts-input-now">現在</button>
    </div>
  </div>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label="時間戳單位">
      <label><input type="radio" name="ts-unit" value="auto" checked /><span>自動判斷</span></label>
      <label><input type="radio" name="ts-unit" value="s" /><span>秒</span></label>
      <label><input type="radio" name="ts-unit" value="ms" /><span>毫秒</span></label>
    </div>
  </div>
  <div id="ts-input-error" class="notice error" role="alert" hidden></div>
  <div class="ts-rows" id="ts-to-date">
    {
      TO_DATE_ROWS.map(([key, label]) => (
        <div class="ts-row">
          <label for={`ts-d-${key}`}>{label}</label>
          <input id={`ts-d-${key}`} type="text" class="mono" readonly />
          <button class="btn small" type="button" data-copy={`#ts-d-${key}`}>複製</button>
        </div>
      ))
    }
  </div>

  <hr class="ts-sep" />

  <h2 class="ts-title">日期轉時間戳</h2>
  <div class="field">
    <label for="ts-date">日期與時間</label>
    <div class="row">
      <input id="ts-date" type="datetime-local" step="1" class="ts-input" />
      <button class="btn" type="button" id="ts-date-now">現在</button>
    </div>
  </div>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label="輸入的時間屬於哪個時區">
      <label><input type="radio" name="ts-zone" value="local" checked /><span id="ts-zone-local-label">本地時間</span></label>
      <label><input type="radio" name="ts-zone" value="UTC" /><span>UTC</span></label>
    </div>
  </div>
  <div id="ts-date-error" class="notice error" role="alert" hidden></div>
  <div class="ts-rows">
    {
      TO_TS_ROWS.map(([key, label]) => (
        <div class="ts-row">
          <label for={`ts-t-${key}`}>{label}</label>
          <input id={`ts-t-${key}`} type="text" class="mono" readonly />
          <button class="btn small" type="button" data-copy={`#ts-t-${key}`}>複製</button>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import {
    UNIT_LABEL,
    formatDateTime,
    formatOffset,
    localTimeZone,
    offsetMinutes,
    parseTimestamp,
    relativeTime,
    toIsoWithOffset,
    wallTimeToMs,
    weekday,
    type Unit,
  } from './logic';

  interface Prefs {
    unit: Unit | 'auto';
    zone: 'local' | 'UTC';
  }

  const root = $('[data-tool="timestamp-converter"]');
  const zone = localTimeZone();

  // ---- Live clock ----
  const nowS = $('#ts-now-s', root);
  const nowMs = $('#ts-now-ms', root);
  const pause = $<HTMLButtonElement>('#ts-pause', root);
  let paused = false;

  $('#ts-zone', root).textContent = `你的時區：${zone}（UTC${formatOffset(offsetMinutes(Date.now(), zone))}）`;
  $('#ts-zone-local-label', root).textContent = `本地時間（${zone}）`;

  function tick() {
    if (paused || document.hidden) return;
    const now = Date.now();
    nowS.textContent = String(Math.floor(now / 1000));
    nowMs.textContent = String(now);
  }
  pause.addEventListener('click', () => {
    paused = !paused;
    pause.textContent = paused ? '繼續' : '暫停';
    pause.setAttribute('aria-pressed', String(paused));
    tick();
  });
  tick();
  window.setInterval(tick, 50);

  // ---- Timestamp → date ----
  const tsInput = $<HTMLInputElement>('#ts-input', root);
  const tsError = $('#ts-input-error', root);
  const unitRadios = $$<HTMLInputElement>('input[name="ts-unit"]', root);
  const out = (key: string) => $<HTMLInputElement>(`#ts-d-${key}`, root);

  // ---- Date → timestamp ----
  const dateInput = $<HTMLInputElement>('#ts-date', root);
  const dateError = $('#ts-date-error', root);
  const zoneRadios = $$<HTMLInputElement>('input[name="ts-zone"]', root);

  const readPrefs = (): Prefs => ({
    unit: (unitRadios.find((r) => r.checked)?.value ?? 'auto') as Prefs['unit'],
    zone: (zoneRadios.find((r) => r.checked)?.value ?? 'local') as Prefs['zone'],
  });

  function renderToDate() {
    savePref('timestamp-converter', readPrefs());
    tsError.hidden = true;
    const keys = ['local', 'utc', 'iso', 'isolocal', 'weekday', 'relative', 'unit'];
    if (tsInput.value.trim() === '') {
      keys.forEach((k) => (out(k).value = ''));
      return;
    }
    const result = parseTimestamp(tsInput.value, readPrefs().unit);
    if (!result.ok) {
      keys.forEach((k) => (out(k).value = ''));
      tsError.textContent = result.error;
      tsError.hidden = false;
      return;
    }
    const { ms, unit } = result;
    out('local').value = `${formatDateTime(ms, zone)}（UTC${formatOffset(offsetMinutes(ms, zone))}）`;
    out('utc').value = formatDateTime(ms, 'UTC');
    out('iso').value = new Date(ms).toISOString();
    out('isolocal').value = toIsoWithOffset(ms, zone);
    out('weekday').value = weekday(ms, zone);
    out('relative').value = relativeTime(ms, Date.now());
    out('unit').value = UNIT_LABEL[unit];
  }

  function toLocalInputValue(ms: number, timeZone: string): string {
    return formatDateTime(Math.floor(ms / 1000) * 1000, timeZone).replace(' ', 'T');
  }

  function renderToTimestamp() {
    savePref('timestamp-converter', readPrefs());
    dateError.hidden = true;
    const keys = ['s', 'ms', 'iso'];
    const set = (k: string, v: string) => ($<HTMLInputElement>(`#ts-t-${k}`, root).value = v);
    if (!dateInput.value) {
      keys.forEach((k) => set(k, ''));
      return;
    }
    const ms = wallTimeToMs(dateInput.value, readPrefs().zone === 'UTC' ? 'UTC' : zone);
    if (ms === null) {
      keys.forEach((k) => set(k, ''));
      dateError.textContent = '日期格式不正確，請使用 YYYY-MM-DD HH:mm:ss。';
      dateError.hidden = false;
      return;
    }
    set('s', String(Math.floor(ms / 1000)));
    set('ms', String(ms));
    set('iso', new Date(ms).toISOString());
  }

  const prefs = loadPref<Prefs>('timestamp-converter', { unit: 'auto', zone: 'local' });
  unitRadios.forEach((r) => (r.checked = r.value === prefs.unit));
  zoneRadios.forEach((r) => (r.checked = r.value === prefs.zone));

  function fillNow() {
    tsInput.value = String(Math.floor(Date.now() / 1000));
    renderToDate();
  }
  function fillDateNow() {
    dateInput.value = toLocalInputValue(Date.now(), readPrefs().zone === 'UTC' ? 'UTC' : zone);
    renderToTimestamp();
  }

  tsInput.addEventListener('input', renderToDate);
  unitRadios.forEach((r) => r.addEventListener('change', renderToDate));
  $('#ts-input-now', root).addEventListener('click', fillNow);
  dateInput.addEventListener('input', renderToTimestamp);
  zoneRadios.forEach((r) => r.addEventListener('change', renderToTimestamp));
  $('#ts-date-now', root).addEventListener('click', fillDateNow);
  fillNow();
  fillDateNow();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ts-now {
    display: grid;
    gap: 6px;
    justify-items: center;
    text-align: center;
  }
  .ts-title {
    font-size: 18px;
  }
  .ts-big {
    font-size: clamp(40px, 11vw, 72px);
  }
  .ts-sub {
    margin: 0;
    color: var(--text-2);
  }
  .ts-zone {
    margin: 0;
  }
  .ts-center {
    justify-content: center;
  }
  .ts-sep {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 8px 0 0;
    width: 100%;
  }
  .ts-input {
    flex: 1;
    min-width: 0;
  }
  .ts-rows {
    display: grid;
    gap: 8px;
  }
  .ts-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }
  .ts-row label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  @media (max-width: 560px) {
    .ts-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .ts-row label {
      grid-column: 1 / -1;
    }
  }
</style>
