---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import Icon from '../../components/Icon.astro';
import CardStage from './CardStage.astro';
import { COVERS, LIMITS, PRESET_IDS, PRESET_STYLE, THEMES, THRESHOLD } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const coverIcons: Partial<Record<(typeof COVERS)[number], string>> = { hearts: 'Heart', stars: 'Sparkles' };
---

<div class="tool" data-tool="scratch-card" data-mode="maker" {...i18nAttrs(locale, s.client)}>
  <script is:inline>
    // Runs before first paint: a received card keeps the maker form from flashing up while the tool loads.
    if (location.hash.indexOf('#card=') === 0) document.currentScript.parentElement.dataset.mode = 'opening';
  </script>
  <section class="sc-recipient" id="sc-recipient" hidden>
    <CardStage id="r" canvasAria={s.canvasAria} />
    <p class="sc-hint" id="sc-r-hint"><Icon name="Hand" size={16} /> {s.scratchHint}</p>
    <div class="sc-actions">
      <button class="btn" type="button" id="sc-r-reveal"><Icon name="Eye" size={18} />{s.revealAll}</button>
      <button class="btn ghost" type="button" id="sc-r-make"><Icon name="PenLine" size={18} />{s.makeOwn}</button>
    </div>
    <p class="hint sc-r-prize" id="sc-r-prize" hidden>{s.prizeRecipientNote}</p>
    <p class="visually-hidden" id="sc-r-live" aria-live="polite"></p>
  </section>

  <div class="sc-maker" id="sc-maker">
    <div class="notice error" id="sc-notice" role="alert" hidden>{s.invalidLink}</div>

    <div class="sc-layout">
      <div class="sc-form">
        <div class="field">
          <span class="label">{s.presetsLabel}</span>
          <div class="sc-presets">
            {
              PRESET_IDS.map((id) => (
                <button class="btn small sc-preset" type="button" data-preset={id}>
                  <Icon name={PRESET_STYLE[id].icon} size={16} />
                  {s.client.presets[id].label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="label" id="sc-mode-label">{s.modeLabel}</span>
          <div class="seg" role="radiogroup" aria-labelledby="sc-mode-label">
            <label><input type="radio" name="sc-mode" value="message" checked /><span>{s.modeMessage}</span></label>
            <label><input type="radio" name="sc-mode" value="prize" /><span>{s.modePrize}</span></label>
          </div>
        </div>

        <div class="field" id="sc-message-field">
          <label for="sc-message">{s.messageLabel}</label>
          <textarea id="sc-message" rows="4" maxlength={LIMITS.message} placeholder={s.messagePlaceholder}></textarea>
          <span class="hint sc-count" id="sc-message-count">0 / {LIMITS.message}</span>
        </div>

        <div class="field" id="sc-prizes-field" hidden>
          <label for="sc-prizes">{s.prizesLabel}</label>
          <textarea id="sc-prizes" rows="5" maxlength={(LIMITS.prize + 1) * (LIMITS.prizes + 4)} placeholder={s.prizesPlaceholder}></textarea>
          <span class="hint sc-count" id="sc-prizes-count"></span>
          <p class="sc-note"><Icon name="Dices" size={18} class="sc-note-icon" /><span>{s.prizeNote}</span></p>
        </div>

        <div class="grid-2">
          <div class="field">
            <label for="sc-title-input">{s.titleLabel}</label>
            <input id="sc-title-input" type="text" maxlength={LIMITS.title} placeholder={s.titlePlaceholder} autocomplete="off" />
          </div>
          <div class="field">
            <label for="sc-from-input">{s.fromLabel}</label>
            <input id="sc-from-input" type="text" maxlength={LIMITS.from} placeholder={s.fromPlaceholder} autocomplete="off" />
          </div>
        </div>

        <div class="field">
          <span class="label" id="sc-cover-label">{s.coverLabel}</span>
          <div class="sc-swatches" role="radiogroup" aria-labelledby="sc-cover-label">
            {
              COVERS.map((c) => (
                <label class="sc-swatch">
                  <input type="radio" name="sc-cover" value={c} />
                  <span class="sc-chip" data-cover={c}>
                    {coverIcons[c] && <Icon name={coverIcons[c]} size={16} />}
                  </span>
                  <span class="sc-swatch-name">{s.covers[c]}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div class="field">
          <span class="label" id="sc-theme-label">{s.themeLabel}</span>
          <div class="sc-swatches" role="radiogroup" aria-labelledby="sc-theme-label">
            {
              THEMES.map((th) => (
                <label class="sc-swatch">
                  <input type="radio" name="sc-theme" value={th} />
                  <span class="sc-chip" data-theme={th}>
                    Aa
                  </span>
                  <span class="sc-swatch-name">{s.themes[th]}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div class="field">
          <label for="sc-threshold">{s.thresholdBefore}<output id="sc-threshold-out">{THRESHOLD.default}</output>{s.thresholdAfter}</label>
          <input id="sc-threshold" type="range" min={THRESHOLD.min} max={THRESHOLD.max} step={THRESHOLD.step} value={THRESHOLD.default} />
          <span class="hint">{s.thresholdHint}</span>
        </div>
      </div>

      <div class="sc-side">
        <div class="sc-preview">
          <div class="sc-preview-bar">
            <span class="label">{s.previewLabel}</span>
            <button class="btn small ghost" type="button" id="sc-p-reset"><Icon name="RotateCcw" size={16} />{s.resetCover}</button>
          </div>
          <CardStage id="p" canvasAria={s.canvasAria} compact />
        </div>

        <section class="sc-share" aria-labelledby="sc-share-heading">
          <h3 class="sc-share-heading" id="sc-share-heading">{s.shareHeading}</h3>
          <p class="notice" id="sc-share-error" hidden></p>
          <div class="field">
            <label for="sc-link">{s.linkLabel}</label>
            <input id="sc-link" class="mono" type="text" readonly spellcheck="false" />
          </div>
          <div class="sc-share-actions">
            <button class="btn primary" type="button" id="sc-copy"><Icon name="Link" size={18} /><span id="sc-copy-label">{s.copyLink}</span></button>
            <button class="btn" type="button" id="sc-native" hidden><Icon name="Share2" size={18} />{s.share}</button>
            <a class="btn ghost" id="sc-open" href="#" target="_blank" rel="noopener"><Icon name="ExternalLink" size={18} />{s.openLink}</a>
          </div>
          <div class="sc-qr" id="sc-qr-box" hidden>
            <canvas id="sc-qr" role="img" aria-label={s.qrAria}></canvas>
            <div class="sc-qr-text">
              <p>{s.qrCaption}</p>
              <button class="btn small" type="button" id="sc-qr-download"><Icon name="Download" size={16} />{s.qrDownload}</button>
            </div>
          </div>
          <p class="hint" id="sc-qr-note" hidden></p>
          <p class="sc-note"><Icon name="ShieldCheck" size={18} class="sc-note-icon" /><span>{s.privacyNote}</span></p>
        </section>
      </div>
    </div>
    <p class="hint sc-draft">{s.draftHint}</p>
  </div>
</div>

<script>
  import { $, $$, copyText, debounce, downloadBlob, flashButton, loadPref, savePref } from '../../lib/client';
  import { track as trackEvent } from '../../lib/analytics';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { exceedsCapacity, type EcLevel } from '../qr-code-generator/logic';
  import type { Strings } from './i18n';
  import {
    cardFromDraft,
    charCount,
    clampThreshold,
    decodeCard,
    fitFontSize,
    hiddenText,
    LIMITS,
    normalizeDraft,
    overflowPrizes,
    parsePrizes,
    PRESET_IDS,
    PRESET_STYLE,
    shareUrl,
    THRESHOLD,
    type Card,
    type CardMode,
    type CoverId,
    type Draft,
    type PresetId,
    type ThemeId,
  } from './logic';
  import { ScratchLayer } from './scratch';

  type QrModule = typeof import('qrcode');

  const root = $('[data-tool="scratch-card"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const PREF_KEY = `scratch-card:${locale}`;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- One card on screen (recipient view or maker preview) ---------- */
  interface CardView {
    card: HTMLElement;
    face: HTMLElement;
    msg: HTMLElement;
    title: HTMLElement;
    from: HTMLElement;
    burst: HTMLElement;
    layer: ScratchLayer;
    text: string;
    burstTimer: number;
  }

  function cardView(id: string, onReveal: (view: CardView) => void): CardView {
    const view = {
      card: $(`#sc-${id}-card`, root),
      face: $(`#sc-${id}-face`, root),
      msg: $(`#sc-${id}-msg`, root),
      title: $(`#sc-${id}-title`, root),
      from: $(`#sc-${id}-from`, root),
      burst: $(`#sc-${id}-burst`, root),
      text: '',
      burstTimer: 0,
    } as CardView;
    view.layer = new ScratchLayer({
      canvas: $<HTMLCanvasElement>(`#sc-${id}-canvas`, root),
      label: s.scratchHere,
      onReveal: () => {
        view.card.classList.add('is-revealed');
        view.face.setAttribute('aria-hidden', 'false');
        celebrate(view);
        onReveal(view);
      },
    });
    new ResizeObserver(() => fitMessage(view)).observe(view.card);
    return view;
  }

  /** Text is only ever written with textContent. */
  function showText(view: CardView, card: Pick<Card, 'title' | 'from' | 'theme'>, text: string, placeholder = false) {
    view.card.dataset.theme = card.theme;
    view.title.textContent = card.title || s.defaultTitle;
    view.from.textContent = card.from ? t(s.fromLine, { name: card.from }) : '';
    view.from.hidden = !card.from;
    view.msg.classList.toggle('is-placeholder', placeholder);
    if (view.text !== text) {
      view.text = text;
      view.msg.textContent = text;
      fitMessage(view);
    }
  }

  /** Largest size that fits: estimate from the text, then shrink if the browser wraps it taller. */
  function fitMessage(view: CardView) {
    let size = fitFontSize(view.text, { width: 84, height: 58 });
    view.msg.style.fontSize = `${size}cqw`;
    const box = view.face.clientHeight;
    if (box === 0) return;
    const pad = parseFloat(getComputedStyle(view.face).paddingTop) * 2;
    for (let i = 0; i < 8 && view.msg.scrollHeight > box - pad && size > 3; i++) {
      size *= 0.9;
      view.msg.style.fontSize = `${size}cqw`;
    }
  }

  function cover(view: CardView, card: Pick<Card, 'cover' | 'threshold'>) {
    view.card.classList.remove('is-revealed');
    view.face.setAttribute('aria-hidden', 'true');
    view.burst.replaceChildren();
    view.layer.reset(card.cover, card.threshold);
  }

  const CONFETTI = ['#f0522e', '#f5c24b', '#12936a', '#2f7de1', '#e84f86', '#7a5cf0', '#ffffff'];

  /** A short burst of paper pieces from the card. CSS only animates; skipped for reduced motion. */
  function celebrate(view: CardView) {
    if (reducedMotion.matches) return;
    const pieces: HTMLElement[] = [];
    const spread = Math.max(140, view.card.clientWidth * 0.62);
    for (let i = 0; i < 42; i++) {
      const piece = document.createElement('span');
      piece.className = i % 3 === 0 ? 'sc-piece is-round' : i % 3 === 1 ? 'sc-piece is-thin' : 'sc-piece';
      const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.5;
      const dist = spread * (0.45 + Math.random() * 0.55);
      piece.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
      piece.style.setProperty('--dy', `${Math.sin(angle) * dist * 0.75 + 40}px`);
      piece.style.setProperty('--rot', `${Math.round((Math.random() - 0.5) * 720)}deg`);
      piece.style.setProperty('--delay', `${Math.random() * 0.12}s`);
      piece.style.setProperty('--dur', `${1.1 + Math.random() * 0.6}s`);
      piece.style.background = CONFETTI[i % CONFETTI.length];
      if (CONFETTI[i % CONFETTI.length] === '#ffffff') piece.style.boxShadow = '0 0 0 1px rgb(0 0 0 / 0.08)';
      pieces.push(piece);
    }
    view.burst.replaceChildren(...pieces);
    window.clearTimeout(view.burstTimer);
    view.burstTimer = window.setTimeout(() => view.burst.replaceChildren(), 2000);
  }

  /* ---------- Recipient ---------- */
  const recipient = $('#sc-recipient', root);
  const maker = $('#sc-maker', root);
  const notice = $('#sc-notice', root);
  const rHint = $('#sc-r-hint', root);
  const rReveal = $<HTMLButtonElement>('#sc-r-reveal', root);
  const rMake = $<HTMLButtonElement>('#sc-r-make', root);
  const rPrize = $('#sc-r-prize', root);
  const rLive = $('#sc-r-live', root);

  const received = cardView('r', (view) => {
    rReveal.hidden = true;
    rHint.hidden = true;
    rMake.classList.replace('ghost', 'primary');
    rLive.textContent = t(s.revealed, { text: view.text });
  });

  function showRecipient(card: Card) {
    root.dataset.mode = 'recipient';
    maker.hidden = true;
    recipient.hidden = false;
    rReveal.hidden = false;
    rHint.hidden = false;
    rMake.classList.replace('primary', 'ghost');
    rPrize.hidden = card.prizes.length === 0;
    rLive.textContent = '';
    // Cover first, then write the text, so the message is never painted uncovered.
    cover(received, card);
    showText(received, card, hiddenText(card));
    const top = recipient.getBoundingClientRect().top;
    const cardBottom = received.card.getBoundingClientRect().bottom;
    if (cardBottom > window.innerHeight && top > 0) {
      recipient.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    }
  }

  function showMaker(invalidLink: boolean) {
    root.dataset.mode = 'maker';
    recipient.hidden = true;
    maker.hidden = false;
    notice.hidden = !invalidLink;
    syncQr();
  }

  rReveal.addEventListener('click', () => received.layer.revealAll());
  rMake.addEventListener('click', () => {
    // Leave the card behind (Back returns to it) and start from the maker's own draft.
    history.pushState(null, '', location.pathname + location.search);
    shownHash = '';
    showMaker(false);
    root.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  let shownHash: string | null = null;
  function route() {
    if (location.hash === shownHash) return;
    const result = decodeCard(location.hash);
    // A plain in-page anchor (the #main skip link) is not a card link: keep the current view.
    if (result.status === 'none' && location.hash !== '' && shownHash !== null) return;
    shownHash = location.hash;
    if (result.status === 'ok') showRecipient(result.card);
    else showMaker(result.status === 'invalid');
  }

  /* ---------- Maker form ---------- */
  const presetButtons = $$<HTMLButtonElement>('[data-preset]', root);
  const modeRadios = $$<HTMLInputElement>('input[name="sc-mode"]', root);
  const coverRadios = $$<HTMLInputElement>('input[name="sc-cover"]', root);
  const themeRadios = $$<HTMLInputElement>('input[name="sc-theme"]', root);
  const messageField = $('#sc-message-field', root);
  const messageInput = $<HTMLTextAreaElement>('#sc-message', root);
  const messageCount = $('#sc-message-count', root);
  const prizesField = $('#sc-prizes-field', root);
  const prizesInput = $<HTMLTextAreaElement>('#sc-prizes', root);
  const prizesCount = $('#sc-prizes-count', root);
  const titleInput = $<HTMLInputElement>('#sc-title-input', root);
  const fromInput = $<HTMLInputElement>('#sc-from-input', root);
  const thresholdInput = $<HTMLInputElement>('#sc-threshold', root);
  const thresholdOut = $('#sc-threshold-out', root);
  const resetBtn = $<HTMLButtonElement>('#sc-p-reset', root);

  function presetDraft(id: PresetId, base?: Draft): Draft {
    const style = PRESET_STYLE[id];
    const text = s.presets[id];
    return {
      mode: style.mode,
      message: style.mode === 'message' ? (text.message ?? '') : (base?.message ?? ''),
      prizesText: style.mode === 'prize' ? (text.prizes ?? []).join('\n') : (base?.prizesText ?? ''),
      title: text.title,
      from: base?.from ?? '',
      cover: style.cover,
      theme: style.theme,
      threshold: base?.threshold ?? THRESHOLD.default,
    };
  }

  const fallback = presetDraft('birthday');
  let draft = normalizeDraft(loadPref<unknown>(PREF_KEY, null), fallback);
  if (!draft.prizesText) draft.prizesText = (s.presets.prize.prizes ?? []).join('\n');

  const checkedValue = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value;

  function writeForm(d: Draft) {
    for (const r of modeRadios) r.checked = r.value === d.mode;
    for (const r of coverRadios) r.checked = r.value === d.cover;
    for (const r of themeRadios) r.checked = r.value === d.theme;
    messageInput.value = d.message;
    prizesInput.value = d.prizesText;
    titleInput.value = d.title;
    fromInput.value = d.from;
    thresholdInput.value = String(d.threshold);
  }

  function readForm(): Draft {
    return normalizeDraft(
      {
        mode: checkedValue(modeRadios) as CardMode,
        message: messageInput.value,
        prizesText: prizesInput.value,
        title: titleInput.value,
        from: fromInput.value,
        cover: checkedValue(coverRadios) as CoverId,
        theme: checkedValue(themeRadios) as ThemeId,
        threshold: clampThreshold(thresholdInput.value),
      },
      draft,
    );
  }

  /* ---------- Live preview ---------- */
  const preview = cardView('p', () => {});
  let previewPrize = '';

  function previewText(d: Draft): { text: string; placeholder: boolean } {
    if (d.mode === 'prize') {
      const prizes = parsePrizes(d.prizesText);
      if (prizes.length < 2) return { text: s.previewNeedPrizes, placeholder: true };
      if (!prizes.includes(previewPrize)) previewPrize = hiddenText({ ...cardFromDraft(d).card, prizes });
      return { text: previewPrize, placeholder: false };
    }
    const { card, error } = cardFromDraft(d);
    return error ? { text: s.previewEmpty, placeholder: true } : { text: card.message, placeholder: false };
  }

  function renderPreview(prev: Draft | null) {
    const { card } = cardFromDraft(draft);
    if (!prev || prev.cover !== draft.cover || prev.mode !== draft.mode) cover(preview, card);
    else preview.layer.setThreshold(draft.threshold);
    const { text, placeholder } = previewText(draft);
    showText(preview, card, text, placeholder);
  }

  function renderForm() {
    messageField.hidden = draft.mode !== 'message';
    prizesField.hidden = draft.mode !== 'prize';
    messageCount.textContent = `${charCount(messageInput.value)} / ${LIMITS.message}`;
    const n = parsePrizes(draft.prizesText).length;
    const extra = overflowPrizes(draft.prizesText);
    prizesCount.textContent = extra
      ? t(s.prizesOverflow, { n: extra, max: LIMITS.prizes })
      : plural(locale, n, s.prizesCount, { max: LIMITS.prizes });
    prizesCount.classList.toggle('is-warn', extra > 0);
    thresholdOut.textContent = String(draft.threshold);
  }

  const saveDraft = debounce(() => savePref(PREF_KEY, draft), 300);

  function onFormChange() {
    const prev = draft;
    draft = readForm();
    renderForm();
    renderPreview(prev);
    saveDraft();
    scheduleLink();
  }

  function applyPreset(id: PresetId) {
    draft = presetDraft(id, draft);
    previewPrize = '';
    writeForm(draft);
    renderForm();
    renderPreview(null);
    savePref(PREF_KEY, draft);
    updateLink();
  }

  /* ---------- Share link + QR ---------- */
  const shareError = $('#sc-share-error', root);
  const linkInput = $<HTMLInputElement>('#sc-link', root);
  const copyBtn = $<HTMLButtonElement>('#sc-copy', root);
  const copyLabel = $('#sc-copy-label', root);
  const nativeBtn = $<HTMLButtonElement>('#sc-native', root);
  const openLink = $<HTMLAnchorElement>('#sc-open', root);
  const qrBox = $('#sc-qr-box', root);
  const qrCanvas = $<HTMLCanvasElement>('#sc-qr', root);
  const qrNote = $('#sc-qr-note', root);
  const qrDownload = $<HTMLButtonElement>('#sc-qr-download', root);

  let currentUrl = '';
  let currentCard: Card | null = null;
  /** The link the QR code was last drawn for. */
  let qrUrl = '';
  let qrToken = 0;
  let qrModule: Promise<QrModule> | null = null;

  function loadQr(): Promise<QrModule> {
    qrModule ??= import('qrcode').then((mod) => (mod as unknown as { default?: QrModule }).default ?? mod);
    return qrModule;
  }

  /** M recovers more damage; fall back to L for long cards; null when even L cannot hold the link. */
  function qrLevel(url: string): EcLevel | null {
    if (!exceedsCapacity(url, 'M')) return 'M';
    if (!exceedsCapacity(url, 'L')) return 'L';
    return null;
  }

  async function renderQr(url: string) {
    const run = ++qrToken;
    const level = qrLevel(url);
    if (!level) {
      qrBox.hidden = true;
      qrNote.textContent = s.qrTooLong;
      qrNote.hidden = false;
      return;
    }
    qrNote.hidden = true;
    try {
      const QRCode = await loadQr();
      if (run !== qrToken) return;
      await QRCode.toCanvas(qrCanvas, url, { errorCorrectionLevel: level, margin: 2, width: 320 });
      qrCanvas.style.removeProperty('width');
      qrCanvas.style.removeProperty('height');
      qrBox.hidden = false;
    } catch {
      if (run === qrToken) qrBox.hidden = true;
    }
  }

  /** Draws the QR code only while the maker is on screen, so a recipient never loads the QR library. */
  function syncQr() {
    if (root.dataset.mode !== 'maker' || !currentUrl || qrUrl === currentUrl) return;
    qrUrl = currentUrl;
    void renderQr(currentUrl);
  }

  function setShareEnabled(on: boolean) {
    copyBtn.disabled = !on;
    nativeBtn.disabled = !on;
    linkInput.disabled = !on;
    openLink.classList.toggle('is-disabled', !on);
    openLink.setAttribute('aria-disabled', String(!on));
    if (!on) openLink.removeAttribute('href');
  }

  function updateLink() {
    const { card, error } = cardFromDraft(draft);
    if (error) {
      currentUrl = '';
      currentCard = null;
      qrUrl = '';
      ++qrToken;
      linkInput.value = '';
      shareError.textContent = error === 'empty' ? s.errorEmpty : s.errorPrizes;
      shareError.hidden = false;
      qrBox.hidden = true;
      qrNote.hidden = true;
      setShareEnabled(false);
      return;
    }
    const url = shareUrl(location.href, card);
    shareError.hidden = true;
    setShareEnabled(true);
    if (url === currentUrl) return;
    currentUrl = url;
    currentCard = card;
    linkInput.value = url;
    openLink.href = url;
    syncQr();
  }

  const scheduleLink = debounce(updateLink, 250);

  copyBtn.addEventListener('click', async () => {
    updateLink();
    if (!currentUrl) return;
    if (await copyText(currentUrl)) {
      flashButton(copyLabel);
      copyBtn.classList.add('is-done');
      window.setTimeout(() => copyBtn.classList.remove('is-done'), 1400);
    }
  });
  linkInput.addEventListener('focus', () => linkInput.select());

  if (typeof navigator.share === 'function') {
    nativeBtn.hidden = false;
    nativeBtn.addEventListener('click', () => {
      updateLink();
      if (!currentUrl || !currentCard) return;
      const title = currentCard.from ? t(s.shareTitle, { name: currentCard.from }) : s.shareTitleAnon;
      navigator.share({ title, text: s.shareText, url: currentUrl }).then(() => trackEvent('share', { method: 'native', content_type: 'tool_result' }), () => {});
    });
  }

  openLink.addEventListener('click', (e) => {
    if (!currentUrl) e.preventDefault();
  });

  qrDownload.addEventListener('click', async () => {
    if (!currentUrl) return;
    const level = qrLevel(currentUrl);
    if (!level) return;
    const QRCode = await loadQr();
    const canvas = document.createElement('canvas');
    await QRCode.toCanvas(canvas, currentUrl, { errorCorrectionLevel: level, margin: 4, width: 1024 });
    canvas.toBlob((blob) => blob && downloadBlob(blob, 'scratch-card-qr.png'), 'image/png');
  });

  /* ---------- Events ---------- */
  maker.addEventListener('input', (e) => {
    if ((e.target as Element).closest('.sc-form')) onFormChange();
  });
  maker.addEventListener('change', (e) => {
    if ((e.target as Element).closest('.sc-form')) onFormChange();
  });
  for (const btn of presetButtons) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.preset as PresetId;
      if ((PRESET_IDS as readonly string[]).includes(id)) applyPreset(id);
    });
  }
  resetBtn.addEventListener('click', () => {
    previewPrize = '';
    cover(preview, cardFromDraft(draft).card);
    const { text, placeholder } = previewText(draft);
    showText(preview, cardFromDraft(draft).card, text, placeholder);
  });

  window.addEventListener('hashchange', route);
  window.addEventListener('popstate', route);

  writeForm(draft);
  renderForm();
  renderPreview(null);
  updateLink();
  route();
</script>

