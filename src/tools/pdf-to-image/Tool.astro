<div class="tool" data-tool="pdf-to-image">
  <p class="pi-privacy">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    <span><strong>檔案不會上傳。</strong>PDF 轉圖片全程在你的瀏覽器中完成，檔案不會傳到任何伺服器，機密文件也能安心轉換。</span>
  </p>

  <label class="dropzone" id="pi-drop" tabindex="0">
    <input type="file" id="pi-file" accept="application/pdf,.pdf" hidden />
    <strong>點擊選擇 PDF，或拖曳到這裡</strong>
    <span class="hint">每一頁會轉成一張 JPG 或 PNG 圖片</span>
  </label>

  <div class="row" id="pi-try">
    <span class="hint">手邊沒有 PDF？</span>
    <button class="btn small ghost" type="button" id="pi-sample">用 3 頁範例檔試試</button>
  </div>

  <div class="row between pi-filebar" id="pi-filebar" hidden>
    <div class="pi-fileinfo">
      <strong id="pi-filename"></strong>
      <span class="hint" id="pi-fileinfo"></span>
    </div>
    <button class="btn small ghost" type="button" id="pi-replace">換一個檔案</button>
  </div>

  <div class="grid-2">
    <div class="field">
      <span class="label">圖片格式</span>
      <div class="seg" role="radiogroup" aria-label="圖片格式">
        <label><input type="radio" name="pi-format" value="jpeg" checked /><span>JPG</span></label>
        <label><input type="radio" name="pi-format" value="png" /><span>PNG</span></label>
      </div>
      <span class="hint" id="pi-format-hint"></span>
    </div>
    <div class="field">
      <span class="label">解析度（DPI）</span>
      <div class="seg" role="radiogroup" aria-label="解析度">
        <label><input type="radio" name="pi-dpi" value="72" /><span>72</span></label>
        <label><input type="radio" name="pi-dpi" value="150" checked /><span>150</span></label>
        <label><input type="radio" name="pi-dpi" value="200" /><span>200</span></label>
        <label><input type="radio" name="pi-dpi" value="300" /><span>300</span></label>
      </div>
      <span class="hint" id="pi-dpi-hint"></span>
    </div>
    <div class="field" id="pi-quality-field">
      <label for="pi-quality">JPG 品質：<output id="pi-quality-out">90</output></label>
      <input id="pi-quality" type="range" min="50" max="100" step="1" value="90" />
    </div>
    <div class="field">
      <label for="pi-range">頁面範圍</label>
      <input id="pi-range" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="留空＝全部頁面，例如 1-3,5" />
      <span class="hint" id="pi-range-hint">可輸入 1-3,5,8-10 這類範圍。</span>
    </div>
  </div>

  <p class="notice error" id="pi-note" hidden></p>

  <div class="stats" id="pi-summary" hidden>
    <div class="stat"><span class="stat-value" id="pi-count">0</span><span class="stat-label">要轉換的頁數</span></div>
    <div class="stat"><span class="stat-value" id="pi-done">0</span><span class="stat-label">已完成</span></div>
    <div class="stat"><span class="stat-value" id="pi-bytes">0 B</span><span class="stat-label">圖片總大小</span></div>
  </div>

  <div class="row" id="pi-actions" hidden>
    <button class="btn primary" type="button" id="pi-zip" disabled>全部下載（ZIP）</button>
    <button class="btn" type="button" id="pi-each" disabled>逐張下載</button>
  </div>

  <ul class="pi-grid" id="pi-grid" aria-live="polite"></ul>
</div>

<script>
  import type { PDFDocumentProxy } from 'pdfjs-dist';
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger } from '../../lib/format';
  import { a4Pixels, imageFilename, mimeFor, pagesToRender, planRender, type ImageFormat } from './logic';
  import { baseName, isPdf } from '../pdf-split/logic';
  import { OpenError, openForRender } from '../pdf-split/pdfjs';
  import { createZip } from '../pdf-split/zip';

  interface Prefs {
    format: ImageFormat;
    dpi: number;
    quality: number;
  }
  interface Card {
    page: number;
    el: HTMLLIElement;
    blob?: Blob;
    url?: string;
    filename?: string;
  }

  const root = $('[data-tool="pdf-to-image"]');
  const drop = $('#pi-drop', root);
  const fileInput = $<HTMLInputElement>('#pi-file', root);
  const tryRow = $('#pi-try', root);
  const fileBar = $('#pi-filebar', root);
  const note = $('#pi-note', root);
  const formatRadios = $$<HTMLInputElement>('input[name="pi-format"]', root);
  const dpiRadios = $$<HTMLInputElement>('input[name="pi-dpi"]', root);
  const quality = $<HTMLInputElement>('#pi-quality', root);
  const qualityOut = $('#pi-quality-out', root);
  const qualityField = $('#pi-quality-field', root);
  const rangeInput = $<HTMLInputElement>('#pi-range', root);
  const rangeHint = $('#pi-range-hint', root);
  const summary = $('#pi-summary', root);
  const actions = $('#pi-actions', root);
  const grid = $('#pi-grid', root);
  const zipBtn = $<HTMLButtonElement>('#pi-zip', root);
  const eachBtn = $<HTMLButtonElement>('#pi-each', root);

  const RANGE_HINT = rangeHint.textContent ?? '';

  let pdf: PDFDocumentProxy | null = null;
  let fileName = '';
  let cards: Card[] = [];
  let generation = 0;
  let loadToken = 0;

  function readPrefs(): Prefs {
    return {
      format: (formatRadios.find((r) => r.checked)?.value ?? 'jpeg') as ImageFormat,
      dpi: Number(dpiRadios.find((r) => r.checked)?.value ?? 150),
      quality: Number(quality.value),
    };
  }

  function applyPrefs(p: Prefs) {
    for (const r of formatRadios) r.checked = r.value === p.format;
    if (!formatRadios.some((r) => r.checked)) formatRadios[0].checked = true;
    for (const r of dpiRadios) r.checked = Number(r.value) === p.dpi;
    if (!dpiRadios.some((r) => r.checked)) dpiRadios[1].checked = true;
    quality.value = String(p.quality);
  }

  function updateHints() {
    const p = readPrefs();
    qualityOut.textContent = quality.value;
    qualityField.hidden = p.format !== 'jpeg';
    $('#pi-format-hint', root).textContent =
      p.format === 'jpeg' ? 'JPG 檔案小，適合照片、掃描檔與傳 LINE。' : 'PNG 無損，文字與線條最銳利，但檔案較大。';
    const a4 = a4Pixels(p.dpi);
    $('#pi-dpi-hint', root).textContent = `A4 頁面約 ${a4.width} × ${a4.height} 像素。${p.dpi >= 300 ? '適合列印。' : p.dpi >= 150 ? '適合螢幕閱讀與分享。' : '檔案最小，適合預覽。'}`;
  }

  function showNote(text: string) {
    note.textContent = text;
    note.hidden = !text;
  }

  function releaseCards() {
    for (const c of cards) if (c.url) URL.revokeObjectURL(c.url);
    cards = [];
    grid.replaceChildren();
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function drawCard(card: Card, status = '等待中…') {
    card.el.replaceChildren();
    const preview = el('div', 'pi-preview');
    if (card.url) {
      const img = el('img');
      img.src = card.url;
      img.alt = `第 ${card.page} 頁`;
      img.loading = 'lazy';
      preview.append(img);
    } else {
      preview.append(el('span', 'hint', status));
    }
    const meta = el('div', 'pi-meta');
    meta.append(el('strong', '', `第 ${card.page} 頁`));
    if (card.blob) meta.append(el('span', 'hint', `${card.el.dataset.size ?? ''}・${formatBytes(card.blob.size)}`));
    const btn = el('button', 'btn small', '下載');
    btn.type = 'button';
    btn.disabled = !card.blob;
    btn.addEventListener('click', () => card.blob && card.filename && downloadBlob(card.blob, card.filename));
    card.el.append(preview, meta, btn);
  }

  function updateSummary() {
    const done = cards.filter((c) => c.blob);
    summary.hidden = !pdf;
    actions.hidden = !pdf || cards.length === 0;
    $('#pi-count', root).textContent = formatInteger(cards.length);
    $('#pi-done', root).textContent = formatInteger(done.length);
    $('#pi-bytes', root).textContent = formatBytes(done.reduce((s, c) => s + c.blob!.size, 0));
    const complete = cards.length > 0 && done.length === cards.length;
    zipBtn.disabled = !complete;
    eachBtn.disabled = done.length === 0;
    zipBtn.textContent = complete ? '全部下載（ZIP）' : `轉換中…（${done.length}/${cards.length}）`;
  }

  function toBlob(canvas: HTMLCanvasElement, type: string, q?: number): Promise<Blob> {
    return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q));
  }

  async function convertAll() {
    const gen = ++generation;
    releaseCards();
    if (!pdf) return updateSummary();
    const doc = pdf;
    const prefs = readPrefs();
    const { pages, errors } = pagesToRender(rangeInput.value, doc.numPages);
    rangeHint.textContent = errors.length ? errors.join('；') : RANGE_HINT;
    rangeHint.classList.toggle('pi-bad', errors.length > 0);
    cards = pages.map((page) => ({ page, el: el('li', 'pi-card') }));
    for (const c of cards) drawCard(c);
    grid.append(...cards.map((c) => c.el));
    updateSummary();
    let limitedNote = false;
    const canvas = document.createElement('canvas');
    for (const card of cards) {
      if (gen !== generation) return;
      drawCard(card, '轉換中…');
      try {
        const page = await doc.getPage(card.page);
        const base = page.getViewport({ scale: 1 });
        const plan = planRender(base.width, base.height, prefs.dpi);
        const viewport = page.getViewport({ scale: plan.scale });
        canvas.width = plan.width;
        canvas.height = plan.height;
        await page.render({ canvas, viewport, background: 'rgb(255,255,255)' }).promise;
        page.cleanup();
        if (gen !== generation) return;
        const blob = await toBlob(canvas, mimeFor(prefs.format), prefs.format === 'jpeg' ? prefs.quality / 100 : undefined);
        if (gen !== generation) return;
        card.blob = blob;
        card.url = URL.createObjectURL(blob);
        card.filename = imageFilename(fileName, card.page, doc.numPages, prefs.format);
        card.el.dataset.size = `${plan.width} × ${plan.height}`;
        if (plan.limited) limitedNote = true;
        drawCard(card);
      } catch {
        if (gen !== generation) return;
        drawCard(card, '這一頁無法轉換');
      }
      updateSummary();
    }
    // Release the canvas backing store (a 300 DPI page is ~35 MB of pixels).
    canvas.width = canvas.height = 1;
    if (limitedNote) showNote('部分頁面尺寸很大，已自動降低解析度以免超過瀏覽器的畫布上限。');
  }

  function reset() {
    loadToken++;
    generation++;
    releaseCards();
    void pdf?.loadingTask.destroy();
    pdf = null;
    fileBar.hidden = true;
    drop.hidden = false;
    tryRow.hidden = false;
    updateSummary();
  }

  async function load(file: File) {
    reset();
    showNote('');
    const token = loadToken;
    fileName = file.name;
    try {
      const doc = await openForRender(new Uint8Array(await file.arrayBuffer()));
      if (token !== loadToken) return void doc.loadingTask.destroy();
      pdf = doc;
    } catch (err) {
      if (token !== loadToken) return;
      showNote(
        err instanceof OpenError && err.code === 'encrypted'
          ? '這份 PDF 需要密碼才能開啟。請先用原本的軟體輸入密碼並另存一份沒有密碼的 PDF，再重新選擇。'
          : '無法讀取這個檔案，可能不是 PDF 或檔案已損毀。',
      );
      return;
    }
    drop.hidden = true;
    tryRow.hidden = true;
    fileBar.hidden = false;
    $('#pi-filename', root).textContent = file.name;
    $('#pi-fileinfo', root).textContent = `共 ${formatInteger(pdf.numPages)} 頁・${formatBytes(file.size)}`;
    void convertAll();
  }

  function pick(files: File[]) {
    const pdfFile = files.find((f) => isPdf(f.type, f.name));
    if (!pdfFile) return showNote('請選擇 PDF 檔案。');
    void load(pdfFile);
  }

  // ---------- Settings ----------
  function onSettings() {
    savePref('pdf-to-image', readPrefs());
    updateHints();
    showNote('');
    if (pdf) void convertAll();
  }
  formatRadios.forEach((r) => r.addEventListener('change', onSettings));
  dpiRadios.forEach((r) => r.addEventListener('change', onSettings));
  const settingsSoon = debounce(onSettings, 400);
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    settingsSoon();
  });
  rangeInput.addEventListener('input', debounce(() => pdf && void convertAll(), 500));

  // ---------- Downloads ----------
  zipBtn.addEventListener('click', async () => {
    const done = cards.filter((c) => c.blob && c.filename);
    if (!done.length) return;
    const entries = await Promise.all(done.map(async (c) => ({ name: c.filename!, data: new Uint8Array(await c.blob!.arrayBuffer()) })));
    downloadBlob(new Blob([createZip(entries)], { type: 'application/zip' }), `${baseName(fileName)}-images.zip`);
  });
  eachBtn.addEventListener('click', async () => {
    for (const c of cards) {
      if (!c.blob || !c.filename) continue;
      downloadBlob(c.blob, c.filename);
      await new Promise((r) => setTimeout(r, 350));
    }
  });

  $('#pi-replace', root).addEventListener('click', () => {
    reset();
    showNote('');
    fileInput.click();
  });
  $('#pi-sample', root).addEventListener('click', async () => {
    const { makeSamplePdf } = await import('../pdf-merge/pdf-ops');
    const data = await makeSamplePdf('Slides', 3, 0.55);
    await load(new File([data as Uint8Array<ArrayBuffer>], 'sample-slides.pdf', { type: 'application/pdf' }));
  });

  // ---------- File input wiring ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) pick(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) pick(Array.from(e.dataTransfer.files));
  });

  applyPrefs(loadPref<Prefs>('pdf-to-image', { format: 'jpeg', dpi: 150, quality: 90 }));
  updateHints();
  updateSummary();
</script>

<style>
  .pi-privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--success) 30%, transparent);
    border-radius: var(--radius-sm);
  }
  .pi-privacy svg {
    flex: none;
    margin-top: 1px;
    color: var(--success);
  }
  .pi-filebar {
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pi-fileinfo {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .pi-fileinfo strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.pi-bad) {
    color: var(--danger) !important;
  }
  .pi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pi-grid:empty {
    display: none;
  }
  .pi-grid :global(.pi-card) {
    display: grid;
    gap: 8px;
    padding: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pi-grid :global(.pi-preview) {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--surface);
    border-radius: 4px;
  }
  .pi-grid :global(.pi-preview img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    box-shadow: 0 0 0 1px var(--border);
  }
  .pi-grid :global(.pi-meta) {
    display: grid;
    gap: 2px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .pi-grid :global(.pi-meta .hint) {
    font-size: 12px;
  }
  @media (max-width: 400px) {
    .pi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
