---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="uuid-generator" {...i18nAttrs(locale, s.client)}>
  <div class="row uu-controls">
    <div class="seg" role="radiogroup" aria-label={s.versionAria}>
      <label><input type="radio" name="uu-version" value="v4" checked /><span>{s.v4}</span></label>
      <label><input type="radio" name="uu-version" value="v7" /><span>{s.v7}</span></label>
    </div>
    <label class="uu-count">
      <span>{s.count}</span>
      <input id="uu-count" type="number" min="1" max="100" step="1" value="5" inputmode="numeric" />
    </label>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="uu-upper" /> {s.uppercase}</label>
    <label class="check"><input type="checkbox" id="uu-nohyphen" /> {s.noHyphens}</label>
  </div>

  <div class="field">
    <label for="uu-output">{s.outputLabel}</label>
    <textarea id="uu-output" class="mono" rows="6" readonly spellcheck="false"></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" id="uu-generate">{s.generate}</button>
    <button class="btn" type="button" data-copy="#uu-output">{s.copyAll}</button>
    <button class="btn ghost" type="button" id="uu-download">{s.download}</button>
  </div>

  <hr class="uu-sep" />

  <div class="field">
    <label for="uu-parse">{s.parseLabel}</label>
    <input id="uu-parse" type="text" class="mono" spellcheck="false" autocomplete="off" placeholder={s.parsePlaceholder} />
  </div>
  <div id="uu-parse-error" class="notice error" hidden></div>
  <div class="stats" id="uu-info" hidden>
    <div class="stat"><span class="stat-value" id="uu-info-version"></span><span class="stat-label">{s.versionStat}</span></div>
    <div class="stat"><span class="stat-value" id="uu-info-variant"></span><span class="stat-label">{s.variantStat}</span></div>
    <div class="stat" id="uu-info-time-wrap"><span class="stat-value" id="uu-info-time"></span><span class="stat-label">{s.timeStat}</span></div>
  </div>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { clampCount, createV7Generator, formatUuid, parseUuid, uuidV4, type UuidVersion } from './logic';
  import type { Strings } from './i18n';

  interface Prefs {
    version: UuidVersion;
    count: number;
    uppercase: boolean;
    noHyphens: boolean;
  }

  const root = $('[data-tool="uuid-generator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const output = $<HTMLTextAreaElement>('#uu-output', root);
  const count = $<HTMLInputElement>('#uu-count', root);
  const upper = $<HTMLInputElement>('#uu-upper', root);
  const noHyphen = $<HTMLInputElement>('#uu-nohyphen', root);
  const versionRadios = $$<HTMLInputElement>('input[name="uu-version"]', root);
  const nextV7 = createV7Generator();

  let raw: string[] = [];

  function readPrefs(): Prefs {
    return {
      version: (versionRadios.find((r) => r.checked)?.value ?? 'v4') as UuidVersion,
      count: clampCount(Number(count.value)),
      uppercase: upper.checked,
      noHyphens: noHyphen.checked,
    };
  }

  /** Re-format without regenerating, so toggling case keeps the same IDs. */
  function show() {
    const prefs = readPrefs();
    savePref('uuid-generator', prefs);
    output.value = raw.map((id) => formatUuid(id, { uppercase: prefs.uppercase, hyphens: !prefs.noHyphens })).join('\n');
    output.rows = Math.min(12, Math.max(3, raw.length));
  }

  function generate() {
    const prefs = readPrefs();
    const make = prefs.version === 'v7' ? nextV7 : () => uuidV4();
    raw = Array.from({ length: prefs.count }, make);
    show();
  }

  const saved = loadPref<Prefs>('uuid-generator', { version: 'v4', count: 5, uppercase: false, noHyphens: false });
  versionRadios.forEach((r) => (r.checked = r.value === saved.version));
  count.value = String(clampCount(saved.count));
  upper.checked = saved.uppercase;
  noHyphen.checked = saved.noHyphens;

  versionRadios.forEach((r) => r.addEventListener('change', generate));
  count.addEventListener('change', () => {
    count.value = String(clampCount(Number(count.value)));
    generate();
  });
  [upper, noHyphen].forEach((el) => el.addEventListener('change', show));
  $('#uu-generate', root).addEventListener('click', generate);
  $('#uu-download', root).addEventListener('click', () => {
    if (output.value) downloadBlob(new Blob([`${output.value}\n`], { type: 'text/plain' }), 'uuids.txt');
  });
  generate();

  // ---- Parser ----
  const parseInput = $<HTMLInputElement>('#uu-parse', root);
  const parseError = $('#uu-parse-error', root);
  const info = $('#uu-info', root);
  const timeWrap = $('#uu-info-time-wrap', root);
  const dateFmt = new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, { dateStyle: 'medium', timeStyle: 'medium' });

  parseInput.addEventListener('input', () => {
    parseError.hidden = true;
    info.hidden = true;
    if (parseInput.value.trim() === '') return;
    const result = parseUuid(parseInput.value);
    if (!result.ok) {
      parseError.textContent = s.invalid;
      parseError.hidden = false;
      return;
    }
    const { version, variantKind, timestamp } = result.info;
    $('#uu-info-version', root).textContent =
      variantKind === 'none'
        ? version === 0
          ? s.nil
          : s.max
        : (s.versions[version] ?? t(s.unknownVersion, { v: version }));
    $('#uu-info-variant', root).textContent = s.variants[variantKind];
    timeWrap.hidden = timestamp === undefined;
    if (timestamp !== undefined) {
      const ms = timestamp % 1000;
      $('#uu-info-time', root).textContent = s.timeOptions
        ? new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, s.timeOptions).format(new Date(timestamp))
        : `${dateFmt.format(new Date(timestamp))}.${String(ms).padStart(3, '0')}`;
    }
    info.hidden = false;
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .uu-count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .uu-count input {
    width: 88px;
  }
  .uu-sep {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 8px 0 0;
    width: 100%;
  }
  .stat-value {
    font-size: 17px;
  }
</style>
