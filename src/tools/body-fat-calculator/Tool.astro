<div class="tool" data-tool="body-fat-calculator">
  <div class="field">
    <span class="label">性別</span>
    <div class="seg" role="radiogroup" aria-label="性別">
      <label><input type="radio" name="bf-sex" value="male" checked /><span>男性</span></label>
      <label><input type="radio" name="bf-sex" value="female" /><span>女性</span></label>
    </div>
  </div>

  <div class="grid-3">
    <div class="field">
      <label for="bf-age">年齡（歲）</label>
      <input id="bf-age" type="text" inputmode="numeric" autocomplete="off" value="30" />
    </div>
    <div class="field">
      <label for="bf-height">身高（公分）</label>
      <input id="bf-height" type="text" inputmode="decimal" autocomplete="off" value="175" />
    </div>
    <div class="field">
      <label for="bf-weight">體重（公斤）</label>
      <input id="bf-weight" type="text" inputmode="decimal" autocomplete="off" value="72" />
    </div>
    <div class="field">
      <label for="bf-neck">頸圍（公分）</label>
      <input id="bf-neck" type="text" inputmode="decimal" autocomplete="off" value="38" />
    </div>
    <div class="field">
      <label for="bf-waist" id="bf-waist-label">腰圍（公分，肚臍高度）</label>
      <input id="bf-waist" type="text" inputmode="decimal" autocomplete="off" value="84" />
    </div>
    <div class="field" id="bf-hip-field">
      <label for="bf-hip">臀圍（公分，最寬處）</label>
      <input id="bf-hip" type="text" inputmode="decimal" autocomplete="off" value="94" />
    </div>
  </div>
  <p class="hint">用軟尺水平量測、不要憋氣或縮小腹。頸圍量喉結下方最細處；男性腰圍量肚臍高度，女性量腰部最細處；臀圍量臀部最寬處。</p>

  <div class="notice error" id="bf-error" hidden></div>

  <div id="bf-output">
    <div class="result" aria-live="polite">
      <div class="result-value"><span id="bf-navy">—</span> <span class="bf-badge" id="bf-cat"></span></div>
      <div class="result-label">體脂率（美國海軍圍度公式）</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="bf-deu">—</span><span class="stat-label">BMI 推估體脂率（Deurenberg）</span></div>
      <div class="stat"><span class="stat-value" id="bf-fat">—</span><span class="stat-label">體脂肪重量</span></div>
      <div class="stat"><span class="stat-value" id="bf-lean">—</span><span class="stat-label">去脂體重（肌肉、骨骼、水分等）</span></div>
      <div class="stat"><span class="stat-value" id="bf-hpa">—</span><span class="stat-label" id="bf-hpa-label">國健署肥胖切點</span></div>
    </div>

    <div class="field">
      <span class="label" id="bf-table-label">體脂率分類（ACE 美國運動委員會）</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>分類</th><th class="num">體脂率範圍</th></tr>
          </thead>
          <tbody id="bf-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">結果僅供參考，請諮詢醫師。圍度與 BMI 公式都是統計推估，誤差約 3%–4% 以上，不能用於診斷；孕婦、未滿 18 歲與高齡者不適用。資料只在瀏覽器中計算，不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import { calcBodyFat, FAT_CATEGORIES, HPA_OBESITY_CUTOFF, validateInput, type BodyFatInput, type Sex } from './logic';

  const root = $('[data-tool="body-fat-calculator"]');
  const sexes = $$<HTMLInputElement>('input[name="bf-sex"]', root);
  const ids = ['age', 'height', 'weight', 'neck', 'waist', 'hip'] as const;
  type Key = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((k) => [k, $<HTMLInputElement>(`#bf-${k}`, root)])) as Record<Key, HTMLInputElement>;
  const hipField = $('#bf-hip-field', root);
  const waistLabel = $('#bf-waist-label', root);
  const error = $('#bf-error', root);
  const output = $('#bf-output', root);
  const table = $('#bf-table', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  type Prefs = { sex: Sex } & Record<Key, string>;
  const saved = loadPref<Prefs>('body-fat-calculator', {
    sex: 'male',
    age: '30',
    height: '175',
    weight: '72',
    neck: '38',
    waist: '84',
    hip: '94',
  });
  for (const s of sexes) s.checked = s.value === saved.sex;
  for (const k of ids) inputs[k].value = saved[k] ?? inputs[k].value;

  const pct = (v: number) => `${formatNumber(v, 1)}%`;

  function renderTable(sex: Sex, currentId: string | null) {
    const list = FAT_CATEGORIES[sex];
    table.innerHTML = list
      .map((c, i) => {
        const next = list[i + 1];
        const range = next ? `${c.min}%–${next.min - 1}%` : `${c.min}% 以上`;
        const mark = c.id === currentId ? ' class="bf-current"' : '';
        return `<tr${mark}><td>${c.label}${c.id === currentId ? '（你的位置）' : ''}</td><td class="num">${range}</td></tr>`;
      })
      .join('');
  }

  function render() {
    const sex: Sex = sexes.find((s) => s.checked)?.value === 'female' ? 'female' : 'male';
    hipField.hidden = sex === 'male';
    waistLabel.textContent = sex === 'male' ? '腰圍（公分，肚臍高度）' : '腰圍（公分，腰部最細處）';
    const values = Object.fromEntries(ids.map((k) => [k, inputs[k].value])) as Record<Key, string>;
    savePref('body-fat-calculator', { sex, ...values } satisfies Prefs);

    const input: BodyFatInput = {
      sex,
      age: parseNumber(values.age),
      heightCm: parseNumber(values.height),
      weightKg: parseNumber(values.weight),
      neckCm: parseNumber(values.neck),
      waistCm: parseNumber(values.waist),
      hipCm: parseNumber(values.hip),
    };
    const problem = validateInput(input);
    const r = problem ? null : calcBodyFat(input);
    if (!r) {
      error.textContent = problem ?? '量測數值無法計算，請確認腰圍、臀圍與頸圍。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    set('#bf-navy', pct(r.navy));
    set('#bf-cat', r.category ? r.category.label : '低於必需脂肪');
    set('#bf-deu', pct(r.deurenberg));
    set('#bf-fat', `${formatNumber(r.composition.fatKg, 1)} kg`);
    set('#bf-lean', `${formatNumber(r.composition.leanKg, 1)} kg`);
    set('#bf-hpa', r.hpaObese ? '已達肥胖' : '未達肥胖');
    set('#bf-hpa-label', `國健署肥胖切點（${sex === 'male' ? '男' : '女'}性 ${HPA_OBESITY_CUTOFF[sex]}%）`);
    set('#bf-table-label', `${sex === 'male' ? '男性' : '女性'}體脂率分類（ACE 美國運動委員會）`);
    renderTable(sex, r.category?.id ?? null);
  }

  ids.forEach((k) => inputs[k].addEventListener('input', render));
  sexes.forEach((s) => s.addEventListener('change', render));
  render();
</script>

<style>
  #bf-output {
    display: grid;
    gap: 16px;
  }
  .bf-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 10px;
    font-size: 15px;
    font-weight: 600;
    vertical-align: middle;
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .bf-badge:empty {
    display: none;
  }
  #bf-table :global(.bf-current td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
