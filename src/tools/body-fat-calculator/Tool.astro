---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
/** Metric fields carry data-units only when a unit toggle exists; zh markup stays unchanged. */
const metric = s.units ? 'metric' : undefined;
const hideMetric = s.units ? true : undefined;
---

<div class="tool" data-tool="body-fat-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <span class="label">{s.sexLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.sexLabel}>
      <label><input type="radio" name="bf-sex" value="male" checked /><span>{s.male}</span></label>
      <label><input type="radio" name="bf-sex" value="female" /><span>{s.female}</span></label>
    </div>
  </div>{
    s.units && (
      <div class="seg" role="radiogroup" aria-label={s.units.legend}>
        <label>
          <input type="radio" name="bf-unit" value="imperial" checked />
          <span>{s.units.imperial}</span>
        </label>
        <label>
          <input type="radio" name="bf-unit" value="metric" />
          <span>{s.units.metric}</span>
        </label>
      </div>
    )
  }

  <div class="grid-3">
    <div class="field">
      <label for="bf-age">{s.age}</label>
      <input id="bf-age" type="text" inputmode="numeric" autocomplete="off" value="30" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="bf-height">{s.heightCm}</label>
      <input id="bf-height" type="text" inputmode="decimal" autocomplete="off" value="175" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="bf-weight">{s.weightKg}</label>
      <input id="bf-weight" type="text" inputmode="decimal" autocomplete="off" value="72" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="bf-neck">{s.neckCm}</label>
      <input id="bf-neck" type="text" inputmode="decimal" autocomplete="off" value="38" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="bf-waist" id="bf-waist-label">{s.waistCm}</label>
      <input id="bf-waist" type="text" inputmode="decimal" autocomplete="off" value="84" />
    </div>
    <div class="field" id="bf-hip-field" data-units={metric} hidden={hideMetric}>
      <label for="bf-hip">{s.hipCm}</label>
      <input id="bf-hip" type="text" inputmode="decimal" autocomplete="off" value="94" />
    </div>{
      s.units && (
        <>
          <div class="bf-pair" data-units="imperial">
            <div class="field">
              <label for="bf-ft">{s.units.heightFt}</label>
              <input id="bf-ft" type="text" inputmode="decimal" autocomplete="off" value="5" />
            </div>
            <div class="field">
              <label for="bf-in">{s.units.heightIn}</label>
              <input id="bf-in" type="text" inputmode="decimal" autocomplete="off" value="9" />
            </div>
          </div>
          <div class="field" data-units="imperial">
            <label for="bf-lb">{s.units.weightLb}</label>
            <input id="bf-lb" type="text" inputmode="decimal" autocomplete="off" value="160" />
          </div>
          <div class="field" data-units="imperial">
            <label for="bf-neck-in">{s.units.neckIn}</label>
            <input id="bf-neck-in" type="text" inputmode="decimal" autocomplete="off" value="15" />
          </div>
          <div class="field" data-units="imperial">
            <label for="bf-waist-in" id="bf-waist-in-label">{s.units.waistIn}</label>
            <input id="bf-waist-in" type="text" inputmode="decimal" autocomplete="off" value="34" />
          </div>
          <div class="field" id="bf-hip-in-field" data-units="imperial">
            <label for="bf-hip-in">{s.units.hipIn}</label>
            <input id="bf-hip-in" type="text" inputmode="decimal" autocomplete="off" value="38" />
          </div>
        </>
      )
    }
  </div>
  <p class="hint">{s.measureHint}</p>

  <div class="notice error" id="bf-error" hidden></div>

  <div id="bf-output">
    <div class="result" aria-live="polite">
      <div class="result-value"><span id="bf-navy">—</span> <span class="bf-badge" id="bf-cat"></span></div>
      <div class="result-label">{s.resultLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="bf-deu">—</span><span class="stat-label">{s.deuLabel}</span></div>
      <div class="stat"><span class="stat-value" id="bf-fat">—</span><span class="stat-label">{s.fatLabel}</span></div>
      <div class="stat"><span class="stat-value" id="bf-lean">—</span><span class="stat-label">{s.leanLabel}</span></div>
      <div class="stat"><span class="stat-value" id="bf-hpa">—</span><span class="stat-label" id="bf-hpa-label">{s.fourthLabel}</span></div>
    </div>

    <div class="field">
      <span class="label" id="bf-table-label">{s.tableLabel}</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>{s.thCategory}</th><th class="num">{s.thRange}</th></tr>
          </thead>
          <tbody id="bf-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">{s.disclaimer}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import {
    calcBodyFat,
    checkInput,
    FAT_CATEGORIES,
    feetInchesToCm,
    HPA_OBESITY_CUTOFF,
    inToCm,
    kgToLb,
    lbToKg,
    type BodyFatInput,
    type Sex,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="body-fat-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const sexes = $$<HTMLInputElement>('input[name="bf-sex"]', root);
  const unitRadios = $$<HTMLInputElement>('input[name="bf-unit"]', root);
  const ids = ['age', 'height', 'weight', 'neck', 'waist', 'hip'] as const;
  type Key = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((k) => [k, $<HTMLInputElement>(`#bf-${k}`, root)])) as Record<Key, HTMLInputElement>;
  /** US customary inputs; only rendered where the locale offers them. */
  const usIds = ['ft', 'in', 'lb', 'neck-in', 'waist-in', 'hip-in'] as const;
  type UsKey = (typeof usIds)[number];
  const usInputs = Object.fromEntries(
    usIds.map((k) => [k, root.querySelector<HTMLInputElement>(`#bf-${k}`)]),
  ) as Record<UsKey, HTMLInputElement | null>;
  const hasUs = usIds.every((k) => usInputs[k]);
  const hipField = $('#bf-hip-field', root);
  const hipInField = root.querySelector<HTMLElement>('#bf-hip-in-field');
  const waistLabel = $('#bf-waist-label', root);
  const waistInLabel = root.querySelector<HTMLElement>('#bf-waist-in-label');
  const error = $('#bf-error', root);
  const output = $('#bf-output', root);
  const table = $('#bf-table', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  type Prefs = { sex: Sex; unit?: 'metric' | 'imperial'; us?: Partial<Record<UsKey, string>> } & Record<Key, string>;
  const saved = loadPref<Prefs>('body-fat-calculator', {
    sex: 'male',
    age: '30',
    height: '175',
    weight: '72',
    neck: '38',
    waist: '84',
    hip: '94',
  });
  for (const s of sexes) s.checked = s.value === saved.sex;
  for (const k of ids) inputs[k].value = saved[k] ?? inputs[k].value;
  if (hasUs) for (const k of usIds) usInputs[k]!.value = saved.us?.[k] ?? usInputs[k]!.value;
  const savedUnit = unitRadios.find((r) => r.value === saved.unit);
  if (savedUnit) savedUnit.checked = true;

  const imperial = () => hasUs && unitRadios.find((r) => r.checked)?.value === 'imperial';
  const pct = (v: number) => `${formatNumber(v, 1, locale)}%`;
  const mass = (kg: number) =>
    imperial() ? `${formatNumber(kgToLb(kg), 1, locale)} ${s.lb}` : `${formatNumber(kg, 1, locale)} ${s.kg}`;

  function renderTable(sex: Sex, currentId: string | null) {
    const list = FAT_CATEGORIES[sex];
    table.innerHTML = list
      .map((c, i) => {
        const next = list[i + 1];
        const range = next ? `${c.min}%–${next.min - 1}%` : t(s.rangeOpen, { min: c.min });
        const mark = c.id === currentId ? ' class="bf-current"' : '';
        return `<tr${mark}><td>${s.categories[c.id] ?? c.label}${c.id === currentId ? s.you : ''}</td><td class="num">${range}</td></tr>`;
      })
      .join('');
  }

  function readInput(sex: Sex): BodyFatInput {
    if (imperial()) {
      const v = (k: UsKey) => parseNumber(usInputs[k]!.value);
      return {
        sex,
        age: parseNumber(inputs.age.value),
        heightCm: feetInchesToCm(v('ft'), v('in')),
        weightKg: lbToKg(v('lb')),
        neckCm: inToCm(v('neck-in')),
        waistCm: inToCm(v('waist-in')),
        hipCm: inToCm(v('hip-in')),
      };
    }
    return {
      sex,
      age: parseNumber(inputs.age.value),
      heightCm: parseNumber(inputs.height.value),
      weightKg: parseNumber(inputs.weight.value),
      neckCm: parseNumber(inputs.neck.value),
      waistCm: parseNumber(inputs.waist.value),
      hipCm: parseNumber(inputs.hip.value),
    };
  }

  function render() {
    const sex: Sex = sexes.find((s) => s.checked)?.value === 'female' ? 'female' : 'male';
    if (hasUs) {
      const active = imperial() ? 'imperial' : 'metric';
      $$<HTMLElement>('[data-units]', root).forEach((el) => (el.hidden = el.dataset.units !== active));
      if (hipInField) hipInField.hidden = hipInField.hidden || sex === 'male';
      hipField.hidden = hipField.hidden || sex === 'male';
    } else {
      hipField.hidden = sex === 'male';
    }
    waistLabel.textContent = sex === 'male' ? s.waistMale : s.waistFemale;
    if (waistInLabel && s.waistMaleIn && s.waistFemaleIn) waistInLabel.textContent = sex === 'male' ? s.waistMaleIn : s.waistFemaleIn;
    const values = Object.fromEntries(ids.map((k) => [k, inputs[k].value])) as Record<Key, string>;
    savePref('body-fat-calculator', {
      sex,
      ...values,
      ...(hasUs
        ? {
            unit: imperial() ? 'imperial' : 'metric',
            us: Object.fromEntries(usIds.map((k) => [k, usInputs[k]!.value])) as Record<UsKey, string>,
          }
        : {}),
    } satisfies Prefs);

    const input = readInput(sex);
    const problem = checkInput(input);
    const r = problem ? null : calcBodyFat(input);
    if (!r) {
      error.textContent =
        problem === 'missing'
          ? sex === 'female'
            ? s.missingFemale
            : s.missingMale
          : problem
            ? s.problems[problem]
            : s.fallback;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    set('#bf-navy', pct(r.navy));
    set('#bf-cat', r.category ? (s.categories[r.category.id] ?? r.category.label) : s.belowEssential);
    set('#bf-deu', pct(r.deurenberg));
    set('#bf-fat', mass(r.composition.fatKg));
    set('#bf-lean', mass(r.composition.leanKg));
    if (s.fourth === 'bmi') {
      set('#bf-hpa', formatFixed(r.bmi, 1, locale));
    } else {
      set('#bf-hpa', r.hpaObese ? s.obese! : s.notObese!);
      set('#bf-hpa-label', t(s.cutoffLabel!, { sex: s.cutoffSex![sex], n: HPA_OBESITY_CUTOFF[sex] }));
    }
    set('#bf-table-label', t(s.tableLabel, { sex: s.tableSex[sex] }));
    renderTable(sex, r.category?.id ?? null);
  }

  ids.forEach((k) => inputs[k].addEventListener('input', render));
  if (hasUs) usIds.forEach((k) => usInputs[k]!.addEventListener('input', render));
  [...sexes, ...unitRadios].forEach((el) => el.addEventListener('change', render));
  render();
</script>
<style>
  #bf-output {
    display: grid;
    gap: 16px;
  }
  .bf-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 10px;
    font-size: 15px;
    font-weight: 600;
    vertical-align: middle;
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .bf-badge:empty {
    display: none;
  }
  .bf-pair {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .bf-pair[hidden] {
    display: none;
  }
  #bf-table :global(.bf-current td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
