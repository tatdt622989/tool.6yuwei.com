<div class="tool" data-tool="markdown-preview">
  <div class="row between">
    <div class="seg md-tabs" role="radiogroup" aria-label="切換編輯或預覽">
      <label><input type="radio" name="md-view" value="edit" checked /><span>編輯</span></label>
      <label><input type="radio" name="md-view" value="preview" /><span>預覽</span></label>
    </div>
    <label class="check"><input type="checkbox" id="md-breaks" /> 單一換行也換行</label>
  </div>

  <div class="md-panes" id="md-panes" data-view="edit">
    <div class="md-pane md-edit">
      <label for="md-input" class="md-pane-label">Markdown</label>
      <textarea id="md-input" class="mono" spellcheck="false" placeholder="在這裡輸入 Markdown…"></textarea>
    </div>
    <div class="md-pane md-view">
      <span class="md-pane-label" id="md-preview-label">預覽</span>
      <div class="md-preview" id="md-preview" role="region" aria-labelledby="md-preview-label" aria-live="off">
        <p class="muted">載入中…</p>
      </div>
    </div>
  </div>

  <p class="hint" id="md-meta"></p>

  <div class="row">
    <button class="btn primary" type="button" id="md-copy-html">複製 HTML</button>
    <button class="btn" type="button" id="md-dl-md">下載 .md</button>
    <button class="btn" type="button" id="md-dl-html">下載 .html</button>
    <button class="btn ghost" type="button" id="md-sample">載入範例</button>
    <button class="btn ghost" type="button" id="md-clear">清除</button>
  </div>
</div>

<script>
  import { $, $$, copyText, debounce, downloadBlob, flashButton, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { SAMPLE_MARKDOWN, buildHtmlDocument, extractTitle, toFilename } from './logic';

  const root = $('[data-tool="markdown-preview"]');
  const input = $<HTMLTextAreaElement>('#md-input', root);
  const preview = $('#md-preview', root);
  const panes = $('#md-panes', root);
  const meta = $('#md-meta', root);
  const breaks = $<HTMLInputElement>('#md-breaks', root);
  const viewRadios = $$<HTMLInputElement>('input[name="md-view"]', root);

  const DRAFT_KEY = 'markdown-preview:draft';
  let toHtml: ((markdown: string) => string) | null = null;
  let html = '';

  // marked and DOMPurify are loaded on demand so they never block first paint.
  async function loadRenderer() {
    try {
      const [{ marked }, { default: DOMPurify }] = await Promise.all([import('marked'), import('dompurify')]);
      toHtml = (markdown) =>
        DOMPurify.sanitize(marked.parse(markdown, { async: false, gfm: true, breaks: breaks.checked }));
      render();
    } catch {
      preview.innerHTML = '<p class="muted">預覽元件載入失敗，請重新整理頁面。</p>';
    }
  }

  function render() {
    const markdown = input.value;
    const chars = [...markdown].length;
    const lines = markdown === '' ? 0 : markdown.split('\n').length;
    meta.textContent = `${formatInteger(chars)} 個字元 · ${formatInteger(lines)} 行`;
    if (!toHtml) return;
    html = toHtml(markdown);
    preview.innerHTML = html || '<p class="muted">預覽會顯示在這裡</p>';
  }

  const saveDraft = debounce(() => savePref(DRAFT_KEY, input.value), 400);

  function setView(view: string) {
    panes.dataset.view = view;
    viewRadios.forEach((r) => (r.checked = r.value === view));
  }

  input.value = loadPref(DRAFT_KEY, SAMPLE_MARKDOWN);
  breaks.checked = loadPref('markdown-preview', { breaks: false }).breaks;

  input.addEventListener(
    'input',
    debounce(() => {
      render();
      saveDraft();
    }, 120),
  );
  breaks.addEventListener('change', () => {
    savePref('markdown-preview', { breaks: breaks.checked });
    render();
  });
  viewRadios.forEach((r) => r.addEventListener('change', () => setView(r.value)));

  const title = () => extractTitle(input.value);
  $('#md-copy-html', root).addEventListener('click', async (e) => {
    if (html && (await copyText(html))) flashButton(e.currentTarget as HTMLElement);
  });
  $('#md-dl-md', root).addEventListener('click', () => {
    downloadBlob(new Blob([input.value], { type: 'text/markdown;charset=utf-8' }), toFilename(title(), 'md'));
  });
  $('#md-dl-html', root).addEventListener('click', () => {
    if (!toHtml) return;
    const doc = buildHtmlDocument(toHtml(input.value), title());
    downloadBlob(new Blob([doc], { type: 'text/html;charset=utf-8' }), toFilename(title(), 'html'));
  });
  $('#md-sample', root).addEventListener('click', () => {
    input.value = SAMPLE_MARKDOWN;
    render();
    saveDraft();
  });
  $('#md-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    saveDraft();
    setView('edit');
    input.focus();
  });

  render();
  void loadRenderer();
</script>

<style>
  .md-panes {
    display: grid;
    gap: 14px;
  }
  .md-pane {
    display: grid;
    gap: 6px;
    min-width: 0;
    grid-template-rows: auto 1fr;
  }
  .md-pane-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .md-pane textarea,
  .md-preview {
    min-height: 420px;
    height: 100%;
  }
  .md-pane textarea {
    resize: vertical;
  }
  .md-panes[data-view='edit'] .md-view,
  .md-panes[data-view='preview'] .md-edit {
    display: none;
  }
  @media (min-width: 760px) {
    .md-tabs {
      display: none;
    }
    .md-panes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .md-panes[data-view] .md-view,
    .md-panes[data-view] .md-edit {
      display: grid;
    }
    .md-pane textarea,
    .md-preview {
      max-height: 640px;
    }
  }

  /* Preview content is injected HTML, so its styles must be global within the preview box. */
  .md-preview {
    padding: 12px 18px;
    overflow: auto;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .md-preview > :global(:first-child) {
    margin-top: 0;
  }
  .md-preview :global(h1),
  .md-preview :global(h2),
  .md-preview :global(h3),
  .md-preview :global(h4) {
    margin: 1.2em 0 0.5em;
    line-height: 1.3;
  }
  .md-preview :global(h1) {
    font-size: 1.7em;
  }
  .md-preview :global(h2) {
    font-size: 1.35em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--border);
  }
  .md-preview :global(h3) {
    font-size: 1.15em;
  }
  .md-preview :global(p),
  .md-preview :global(ul),
  .md-preview :global(ol),
  .md-preview :global(blockquote),
  .md-preview :global(pre),
  .md-preview :global(table) {
    margin: 0 0 1em;
  }
  .md-preview :global(ul),
  .md-preview :global(ol) {
    padding-left: 1.5em;
  }
  .md-preview :global(li > input[type='checkbox']) {
    margin-right: 6px;
    vertical-align: -2px;
  }
  .md-preview :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    padding: 0.15em 0.35em;
    border-radius: 4px;
    background: var(--surface-2);
  }
  .md-preview :global(pre) {
    padding: 12px 14px;
    overflow-x: auto;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .md-preview :global(pre code) {
    padding: 0;
    background: none;
  }
  .md-preview :global(blockquote) {
    padding: 2px 14px;
    color: var(--text-2);
    border-left: 4px solid var(--border-strong);
  }
  .md-preview :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .md-preview :global(th),
  .md-preview :global(td) {
    padding: 6px 12px;
    border: 1px solid var(--border);
  }
  .md-preview :global(th) {
    background: var(--surface-2);
  }
  .md-preview :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 1.5em 0;
  }
  .md-preview :global(img) {
    max-width: 100%;
  }
</style>
