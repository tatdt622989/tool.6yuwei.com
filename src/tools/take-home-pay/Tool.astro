---
import type { ToolProps } from '../../i18n/tool';
import { EMPLOYMENT_RATES, PREFECTURE_HEALTH_RATES } from './rates';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;
const counts = [0, 1, 2, 3, 4, 5];
---

<div class="tool" data-tool="take-home-pay" data-locale={locale}>
  <div class="field">
    <span class="label">計算のもと</span>
    <div class="seg" role="radiogroup" aria-label="計算のもと">
      <label><input type="radio" name="th-mode" value="monthly" checked /><span>月給から</span></label>
      <label><input type="radio" name="th-mode" value="annual" /><span>年収から</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field" id="th-salary-field">
      <label for="th-salary">月給（額面・円）</label>
      <input id="th-salary" type="text" inputmode="numeric" autocomplete="off" value="300,000" />
      <span class="hint">基本給と残業代・各種手当の合計。通勤手当は下の欄に分けて入力します。</span>
    </div>
    <div class="field" id="th-annual-field" hidden>
      <label for="th-annual">年収（額面・賞与込み・円）</label>
      <input id="th-annual" type="text" inputmode="numeric" autocomplete="off" value="5,000,000" />
      <span class="hint">源泉徴収票の「支払金額」にあたる額。賞与を除いた分を 12 か月で割って月給とします。</span>
    </div>
    <div class="field">
      <label for="th-bonus">賞与（年間合計・円）</label>
      <input id="th-bonus" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">夏と冬の年 2 回、同じ額が支給されるものとして計算します。</span>
    </div>
    <div class="field">
      <label for="th-commute">通勤手当（月額・円）</label>
      <input id="th-commute" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">社会保険料の対象ですが、所得税はかかりません（月 15 万円まで）。</span>
    </div>
    <div class="field">
      <label for="th-pref">勤務先の都道府県（協会けんぽ）</label>
      <select id="th-pref">
        {PREFECTURE_HEALTH_RATES.map((p) => <option value={p.name} selected={p.name === '東京都'}>{p.name}（{(p.bp / 100).toFixed(2)}%）</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <span class="label">年齢</span>
    <div class="seg" role="radiogroup" aria-label="年齢">
      <label><input type="radio" name="th-age" value="young" checked /><span>39 歳以下</span></label>
      <label><input type="radio" name="th-age" value="care" /><span>40〜64 歳（介護保険あり）</span></label>
      <label><input type="radio" name="th-age" value="senior" /><span>65〜69 歳</span></label>
    </div>
  </div>

  <div class="grid-3">
    <div class="field">
      <label for="th-dep">扶養親族（16〜18 歳・23 歳以上）</label>
      <select id="th-dep">{counts.map((n) => <option value={n}>{n} 人</option>)}</select>
    </div>
    <div class="field">
      <label for="th-spec">特定扶養親族（19〜22 歳）</label>
      <select id="th-spec">{counts.map((n) => <option value={n}>{n} 人</option>)}</select>
    </div>
    <div class="field th-check-field">
      <label class="check"><input type="checkbox" id="th-spouse" /> 配偶者控除あり</label>
      <span class="hint">配偶者の給与収入が 136 万円以下</span>
    </div>
  </div>

  <div class="field">
    <span class="label">住民税</span>
    <div class="seg" role="radiogroup" aria-label="住民税">
      <label><input type="radio" name="th-res" value="estimate" checked /><span>概算する</span></label>
      <label><input type="radio" name="th-res" value="manual" /><span>金額を入力</span></label>
      <label><input type="radio" name="th-res" value="none" /><span>なし（就職 1 年目）</span></label>
    </div>
    <span class="hint" id="th-res-hint">前年も同じ収入だったとして、令和8年度の税率で概算します。</span>
  </div>
  <div class="field" id="th-res-field" hidden>
    <label for="th-res-amount">住民税（月額・円）</label>
    <input id="th-res-amount" type="text" inputmode="numeric" autocomplete="off" value="15,000" />
    <span class="hint">給与明細の住民税、または「特別徴収税額の決定通知書」の 7 月以降の月額を入力します。</span>
  </div>

  <details class="th-more">
    <summary>詳細設定：雇用保険の事業の種類</summary>
    <div class="field">
      <label for="th-emp">雇用保険（令和8年度 労働者負担）</label>
      <select id="th-emp">
        {Object.entries(EMPLOYMENT_RATES).map(([id, r]) => <option value={id}>{r.label}（{r.permille}/1000）</option>)}
      </select>
    </div>
  </details>

  <div class="notice error" id="th-error" hidden></div>

  <div id="th-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="th-main">—</div>
      <div class="result-label" id="th-main-label">毎月の手取り（概算）</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="th-year">—</span><span class="stat-label">年間の手取り</span></div>
      <div class="stat"><span class="stat-value" id="th-avg">—</span><span class="stat-label">月平均の手取り（年間 ÷ 12）</span></div>
      <div class="stat"><span class="stat-value" id="th-deduct">—</span><span class="stat-label">年間の控除合計</span></div>
      <div class="stat"><span class="stat-value" id="th-rate">—</span><span class="stat-label">手取り率（年間）</span></div>
    </div>

    <div class="field">
      <span class="label">控除の内訳</span>
      <div class="table-wrap">
        <table class="table th-table">
          <thead><tr><th>項目</th><th class="num">毎月（円）</th><th class="num">年間（円）</th></tr></thead>
          <tbody id="th-table"></tbody>
        </table>
      </div>
    </div>

    <p class="notice" id="th-refund" hidden></p>
    <p class="hint" id="th-basis"></p>
  </div>

  <p class="hint">2026 年（令和8年）の協会けんぽ・厚生年金・雇用保険の料率と、令和8年分の所得税（令和8年度税制改正後の基礎控除・給与所得控除）で計算した概算です。毎月の所得税は源泉徴収税額の電算機計算の特例、年間の所得税は年末調整の計算方法によります。健康保険組合や共済に加入している場合、住宅ローン控除・ふるさと納税・生命保険料控除などがある場合は実際の金額と異なります。入力した金額は送信されず、ブラウザ内だけで計算します。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import { calculateTakeHome, monthlyFromAnnual, validate, type ResidentMode, type TakeHomeInput } from './logic';
  import type { EmploymentKind } from './rates';

  interface Prefs {
    mode: string;
    salary: string;
    annual: string;
    bonus: string;
    commute: string;
    pref: string;
    age: string;
    dep: string;
    spec: string;
    spouse: boolean;
    res: string;
    resAmount: string;
    emp: string;
  }

  const root = $('[data-tool="take-home-pay"]');
  const locale = (root.dataset.locale ?? 'ja') as Locale;
  const modes = $$<HTMLInputElement>('input[name="th-mode"]', root);
  const ages = $$<HTMLInputElement>('input[name="th-age"]', root);
  const resModes = $$<HTMLInputElement>('input[name="th-res"]', root);
  const salary = $<HTMLInputElement>('#th-salary', root);
  const annual = $<HTMLInputElement>('#th-annual', root);
  const bonus = $<HTMLInputElement>('#th-bonus', root);
  const commute = $<HTMLInputElement>('#th-commute', root);
  const pref = $<HTMLSelectElement>('#th-pref', root);
  const dep = $<HTMLSelectElement>('#th-dep', root);
  const spec = $<HTMLSelectElement>('#th-spec', root);
  const spouse = $<HTMLInputElement>('#th-spouse', root);
  const resAmount = $<HTMLInputElement>('#th-res-amount', root);
  const emp = $<HTMLSelectElement>('#th-emp', root);
  const error = $('#th-error', root);
  const output = $('#th-output', root);
  const table = $('#th-table', root);
  const refund = $('#th-refund', root);

  const yen = (n: number) => `${formatInteger(n, locale)} 円`;
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const checked = (list: HTMLInputElement[], fallback: string) => list.find((x) => x.checked)?.value ?? fallback;
  const pick = (list: HTMLInputElement[], value: string | undefined) => {
    if (value && list.some((x) => x.value === value)) for (const x of list) x.checked = x.value === value;
  };
  const selectValue = (el: HTMLSelectElement, value: string | undefined) => {
    if (value !== undefined && el.querySelector(`option[value="${value}"]`)) el.value = value;
  };
  const amount = (el: HTMLInputElement) => (el.value.trim() === '' ? 0 : parseNumber(el.value));

  const prefs = loadPref<Partial<Prefs>>('take-home-pay', {});
  pick(modes, prefs.mode);
  pick(ages, prefs.age);
  pick(resModes, prefs.res);
  if (prefs.salary !== undefined) salary.value = prefs.salary;
  if (prefs.annual !== undefined) annual.value = prefs.annual;
  if (prefs.bonus !== undefined) bonus.value = prefs.bonus;
  if (prefs.commute !== undefined) commute.value = prefs.commute;
  if (prefs.resAmount !== undefined) resAmount.value = prefs.resAmount;
  if (prefs.spouse !== undefined) spouse.checked = prefs.spouse;
  selectValue(pref, prefs.pref);
  selectValue(dep, prefs.dep);
  selectValue(spec, prefs.spec);
  selectValue(emp, prefs.emp);

  function row(label: string, monthly: number | null, yearly: number | null, cls = '') {
    const tr = document.createElement('tr');
    if (cls) tr.className = cls;
    [label, monthly === null ? '—' : formatInteger(monthly, locale), yearly === null ? '—' : formatInteger(yearly, locale)].forEach((text, i) => {
      const td = document.createElement('td');
      td.textContent = text;
      if (i > 0) td.className = 'num';
      tr.append(td);
    });
    return tr;
  }

  function render() {
    const mode = checked(modes, 'monthly');
    const res = checked(resModes, 'estimate') as ResidentMode;
    savePref('take-home-pay', {
      mode,
      salary: salary.value,
      annual: annual.value,
      bonus: bonus.value,
      commute: commute.value,
      pref: pref.value,
      age: checked(ages, 'young'),
      dep: dep.value,
      spec: spec.value,
      spouse: spouse.checked,
      res,
      resAmount: resAmount.value,
      emp: emp.value,
    } satisfies Prefs);

    $('#th-salary-field', root).hidden = mode !== 'monthly';
    $('#th-annual-field', root).hidden = mode !== 'annual';
    $('#th-res-field', root).hidden = res !== 'manual';

    const bonusValue = amount(bonus);
    const annualValue = amount(annual);
    let problem: string | null = null;
    if (mode === 'annual') {
      if (!Number.isFinite(annualValue) || annualValue <= 0) problem = '年収（額面）を入力してください。';
      else if (bonusValue >= annualValue) problem = '賞与は年収より少ない額を入力してください。';
    }

    const input: TakeHomeInput = {
      salary: mode === 'annual' ? monthlyFromAnnual(annualValue, bonusValue) : amount(salary),
      commute: amount(commute),
      prefecture: pref.value,
      care: checked(ages, 'young') === 'care',
      employment: emp.value as EmploymentKind,
      bonus: bonusValue,
      bonusTimes: 2,
      spouse: spouse.checked,
      dependents: Number(dep.value),
      specificDependents: Number(spec.value),
      residentMode: res,
      residentMonthly: amount(resAmount),
    };
    problem ??= validate(input);
    if (problem) {
      error.textContent = problem;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    const r = calculateTakeHome(input);
    const m = r.monthly;
    const a = r.annual;
    if (mode === 'monthly') {
      set('#th-main', yen(m.takeHome));
      set('#th-main-label', `月給 ${yen(input.salary)}${input.commute ? `＋通勤手当 ${yen(input.commute)}` : ''} の毎月の手取り（概算）`);
    } else {
      set('#th-main', yen(a.takeHome));
      set('#th-main-label', `年収 ${yen(annualValue)} の年間の手取り（概算）`);
    }
    set('#th-year', yen(a.takeHome));
    set('#th-avg', yen(Math.floor(a.takeHome / 12)));
    const deductAnnual = a.social + a.incomeTax.tax + a.resident;
    set('#th-deduct', yen(deductAnnual));
    set('#th-rate', `${formatNumber((a.takeHome / a.gross) * 100, 1, locale)}%`);

    const careLabel = input.care ? '健康保険料（介護保険料を含む）' : '健康保険料';
    const s = m.social;
    table.replaceChildren(
      row('額面（給与＋通勤手当）', m.gross, a.salaryGross + a.commute),
      ...(a.bonusGross > 0 ? [row('賞与（額面）', null, a.bonusGross)] : []),
      row(careLabel, s.health, a.health),
      row('子ども・子育て支援金', s.childSupport, a.childSupport),
      row('厚生年金保険料', s.pension, a.pension),
      row('雇用保険料', s.employment, a.employment),
      row(`所得税（復興特別所得税を含む）${a.bonusGross > 0 ? '※毎月は給与分のみ' : ''}`, m.incomeTax, a.incomeTax.tax),
      row(input.residentMode === 'estimate' ? '住民税（概算）' : '住民税', m.resident, a.resident),
      row('控除合計', s.total + m.incomeTax + m.resident, deductAnnual, 'th-sum'),
      row('手取り', m.takeHome, a.takeHome, 'th-sum'),
    );

    const diff = m.incomeTax * 12 - a.incomeTax.tax;
    if (a.bonusGross === 0 && diff >= 1000) {
      refund.textContent = `毎月の源泉徴収（12 か月で ${yen(m.incomeTax * 12)}）は、令和8年度税制改正で引き上げられた基礎控除を反映する前の税額表で計算されます。年間の所得税は ${yen(a.incomeTax.tax)} なので、差額の約 ${yen(diff)} が 12 月の年末調整で戻る見込みです（年間の手取りはこの還付を含めた額です）。`;
      refund.hidden = false;
    } else {
      refund.hidden = true;
    }

    set(
      '#th-basis',
      `計算の前提：健康保険の標準報酬月額 ${yen(s.healthStandard)}（料率 ${formatNumber(s.healthRateBp / 100, 2, locale)}%、労使折半）、厚生年金の標準報酬月額 ${yen(s.pensionStandard)}（18.3%）、扶養親族等の数 ${r.dependentsCount} 人。年間の所得税は給与所得 ${yen(a.incomeTax.salaryIncome)} − 基礎控除 ${yen(a.incomeTax.basic)} − 社会保険料控除 ${yen(a.incomeTax.social)}${a.incomeTax.spouse + a.incomeTax.dependents > 0 ? ` − 配偶者・扶養控除 ${yen(a.incomeTax.spouse + a.incomeTax.dependents)}` : ''} ＝ 課税所得 ${yen(a.incomeTax.taxable)} から計算しています。`,
    );
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #th-output {
    display: grid;
    gap: 16px;
  }
  #th-output[hidden] {
    display: none;
  }
  .th-more {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .th-more[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .th-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
  .th-check-field {
    align-content: end;
    padding-bottom: 4px;
  }
  .th-table th,
  .th-table :global(td) {
    padding: 8px 10px;
  }
  .th-table :global(td:first-child) {
    white-space: normal;
    min-width: 6.5em;
  }
  #th-output .stat-value {
    font-size: 19px;
  }
  #th-table :global(.th-sum td) {
    font-weight: 700;
    background: var(--surface-2);
  }
</style>
