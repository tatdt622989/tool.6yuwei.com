---
import type { ToolProps } from '../../i18n/tool';
import { formatInteger } from '../../lib/format';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;

const rows = [
  { id: 'kanji', label: '漢数字（位取り）' },
  { id: 'daiji', label: '大字（祝儀袋・領収書）' },
  { id: 'daiji-full', label: '大字（すべて旧字体）' },
  { id: 'amount', label: '金額の書き方' },
  { id: 'positional', label: '漢数字（一桁ずつ・縦書きの年号など）' },
  { id: 'mixed', label: '数字＋万・億' },
  { id: 'arabic', label: '算用数字' },
];
const presets = ['10000', '30000', '50000', '100000', '2026', '123456789'];
---

<div class="tool" data-tool="kanji-numerals" data-locale={locale}>
  <div class="field">
    <label for="kn-input">数字または漢数字を入力</label>
    <input id="kn-input" type="text" inputmode="text" autocomplete="off" value="30000" placeholder="例：30000、三万、壱萬、二〇二六、3万5千" />
    <span class="hint">数字から漢数字・大字へ、漢数字・大字から数字へ、どちら向きでも自動で判定します。</span>
  </div>

  <div class="row kn-presets" aria-label="よく使う金額">
    {presets.map((p) => <button class="btn small" type="button" data-preset={p}>{formatInteger(Number(p), locale)}</button>)}
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="kn-ichi" /> 「千」の前に「一」を付ける（一千）</label>
    <label class="check"><input type="checkbox" id="kn-nari" /> 金額の末尾に「也」を付ける</label>
    <label class="check"><input type="checkbox" id="kn-en" /> 「円」を旧字体「圓」にする</label>
  </div>

  <div class="notice error" id="kn-error" hidden></div>

  <div id="kn-output">
    <div class="kn-top">
      <div class="result" aria-live="polite">
        <div class="result-value" id="kn-main">—</div>
        <div class="result-label" id="kn-main-label">大字での金額表記</div>
      </div>
      <div class="kn-envelope" aria-hidden="true">
        <span class="kn-vertical" id="kn-vertical">金参萬円</span>
      </div>
    </div>

    <div class="table-wrap">
      <table class="table kn-table">
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>
                  <output id={`kn-${r.id}`}>—</output>
                </td>
                <td class="kn-copy">
                  <button class="btn small" type="button" data-copy={`#kn-${r.id}`}>
                    コピー
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <p class="hint">9999京9999兆9999億9999万9999 まで変換できます。小数・負の数には対応していません。入力した内容は送信されず、ブラウザ内だけで変換します。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import { parseJapaneseNumber, toAmount, toDaiji, toKanji, toMixed, toPositional } from './logic';

  const root = $('[data-tool="kanji-numerals"]');
  const locale = (root.dataset.locale ?? 'ja') as Locale;
  const input = $<HTMLInputElement>('#kn-input', root);
  const ichi = $<HTMLInputElement>('#kn-ichi', root);
  const nari = $<HTMLInputElement>('#kn-nari', root);
  const en = $<HTMLInputElement>('#kn-en', root);
  const error = $('#kn-error', root);
  const output = $('#kn-output', root);
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  const prefs = loadPref<{ text?: string; ichi?: boolean; nari?: boolean; en?: boolean }>('kanji-numerals', {});
  if (prefs.text !== undefined) input.value = prefs.text;
  if (prefs.ichi !== undefined) ichi.checked = prefs.ichi;
  if (prefs.nari !== undefined) nari.checked = prefs.nari;
  if (prefs.en !== undefined) en.checked = prefs.en;

  /** BigInt を 3 桁区切りで表示（Number の精度を超えても正確に）。 */
  const groupDigits = (n: bigint) =>
    n <= BigInt(Number.MAX_SAFE_INTEGER) ? formatInteger(Number(n), locale) : n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');

  function render() {
    savePref('kanji-numerals', { text: input.value, ichi: ichi.checked, nari: nari.checked, en: en.checked });
    if (input.value.trim() === '') {
      error.hidden = true;
      output.hidden = true;
      return;
    }
    const parsed = parseJapaneseNumber(input.value);
    if (!parsed.ok) {
      error.textContent = parsed.error;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;
    const n = parsed.value;
    const yen = en.checked ? '圓' : '円';
    const amount = toAmount(n, 'common', { nari: nari.checked, yen });
    const isArabicInput = /^[\d０-９,，\s]+$/.test(input.value.trim());

    set('#kn-main', isArabicInput ? amount : groupDigits(n));
    set('#kn-main-label', isArabicInput ? '大字での金額表記（祝儀袋・領収書）' : '算用数字に直した値');
    set('#kn-vertical', amount);
    set('#kn-kanji', toKanji(n, { ichiBeforeSen: ichi.checked }));
    set('#kn-daiji', toDaiji(n));
    set('#kn-daiji-full', toDaiji(n, 'full'));
    set('#kn-amount', amount);
    set('#kn-positional', toPositional(n));
    set('#kn-mixed', toMixed(n));
    set('#kn-arabic', groupDigits(n));
  }

  for (const b of $$<HTMLButtonElement>('[data-preset]', root)) {
    b.addEventListener('click', () => {
      input.value = b.dataset.preset ?? '';
      render();
    });
  }
  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #kn-output {
    display: grid;
    gap: 16px;
  }
  #kn-output[hidden] {
    display: none;
  }
  .kn-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: stretch;
  }
  .kn-envelope {
    display: grid;
    place-items: center;
    width: 76px;
    min-height: 150px;
    padding: 12px 0;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .kn-vertical {
    writing-mode: vertical-rl;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', 'YuMincho', serif;
    font-size: 20px;
    letter-spacing: 0.12em;
    max-height: 260px;
    overflow-wrap: anywhere;
  }
  .kn-table th {
    width: 38%;
    white-space: normal;
    font-weight: 600;
  }
  .kn-table td output {
    font-size: 16px;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .kn-table td {
    white-space: normal;
  }
  .kn-copy {
    width: 1%;
    text-align: right;
  }
</style>
