---
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { AGES, COUNTIES, EDUCATIONS, FIRM_SIZES, GENDERS, INDUSTRIES, LATEST } from './data';
import { dotOrder } from './logic';

const pageUrl = new URL('/salary-rank/', site.url);
const dots = Array.from({ length: 100 }, (_, i) => dotOrder(Math.floor(i / 10), i % 10));
const LADDER_MAX = LATEST.d[8] * 1.12;
const rungs = [...LATEST.d]
  .map((wan, i) => ({ wan, pct: (i + 1) * 10 }))
  .reverse();
const simpleFilters = [
  { id: 'gender', label: '性別', groups: GENDERS },
  { id: 'age', label: '年齡', groups: AGES },
  { id: 'education', label: '學歷', groups: EDUCATIONS },
  { id: 'firm', label: '公司規模', groups: FIRM_SIZES },
];
---

<div class="tool sr" data-tool="salary-rank" data-host={`${pageUrl.host}${pageUrl.pathname}`} data-ladder-max={LADDER_MAX}>
  <section class="sr-input" aria-labelledby="sr-input-title">
    <h2 class="sr-title" id="sr-input-title">你的薪水</h2>
    <div class="sr-fields">
      <div class="field">
        <span class="label" id="sr-mode-label">計算方式</span>
        <div class="seg" role="radiogroup" aria-labelledby="sr-mode-label">
          <label><input type="radio" name="sr-mode" value="monthly" checked /><span>月薪</span></label>
          <label><input type="radio" name="sr-mode" value="annual" /><span>年薪</span></label>
        </div>
      </div>
      <div class="field sr-amount">
        <label for="sr-amount" id="sr-amount-label">稅前月薪（元）</label>
        <input id="sr-amount" type="text" inputmode="numeric" autocomplete="off" placeholder="例如 45000" />
      </div>
      <div class="field" id="sr-months-field">
        <label for="sr-months">一年領幾個月</label>
        <input id="sr-months" type="text" inputmode="decimal" autocomplete="off" value="13" />
      </div>
    </div>
    <p class="hint" id="sr-input-hint">含年終和獎金，但不含股利、兼職和租金收入。金額不會上傳，也不會儲存。</p>
    <p class="notice error" id="sr-error" role="alert" hidden></p>
  </section>

  <section class="sr-hero" id="sr-hero" data-state="empty" aria-live="polite">
    <div class="sr-hero-text">
      <p class="sr-badge" id="sr-badge">台灣上班族薪資排名</p>
      <p class="sr-big" id="sr-big" aria-hidden="true">?</p>
      <p class="sr-headline" id="sr-headline">輸入薪水，看你贏過多少人</p>
      <p class="sr-sub" id="sr-sub">每個圓點代表 1% 的上班族，由低到高從左下排到右上。</p>
      <div class="sr-actions" id="sr-actions" hidden>
        <button class="sr-btn sr-btn-main" type="button" id="sr-poster"><Icon name="ImageDown" size={17} />下載結果圖</button>
        <button class="sr-btn" type="button" id="sr-copy"><Icon name="Copy" size={17} /><span id="sr-copy-label">複製分享文字</span></button>
      </div>
    </div>
    <div class="sr-board">
      <div class="sr-dots" id="sr-dots" role="img" aria-label="100 個圓點，尚未輸入薪水">
        {dots.map((order) => <span class="sr-dot" data-order={order} style={`--o:${order}`}></span>)}
      </div>
      <ul class="sr-key" id="sr-key">
        <li><i class="sr-swatch beat"></i>你贏過的人</li>
        <li><i class="sr-swatch you"></i>你的位置</li>
        <li><i class="sr-swatch ahead"></i>排在你前面的人</li>
      </ul>
    </div>
  </section>

  <section class="stats sr-stats" id="sr-stats" hidden>
    <div class="stat"><span class="stat-value" id="sr-stat-pay"></span><span class="stat-label" id="sr-stat-pay-label"></span></div>
    <div class="stat"><span class="stat-value" id="sr-stat-median"></span><span class="stat-label">和中位數 {LATEST.d[4]} 萬相比</span></div>
    <div class="stat sr-next"><span class="stat-value" id="sr-stat-next"></span><span class="stat-label" id="sr-stat-next-label"></span></div>
  </section>

  <div class="sr-two" id="sr-two">
    <section class="sr-card" aria-labelledby="sr-ladder-title">
      <h2 class="sr-title" id="sr-ladder-title">台灣年薪階梯</h2>
      <p class="hint">{LATEST.year} 年（民國 {LATEST.roc} 年）全體受僱員工的全年總薪資。</p>
      <ol class="sr-ladder" id="sr-ladder">
        {
          rungs.map((r) => (
            <li class="sr-rung" data-pay={Math.round(r.wan * 10000)}>
              <span class="sr-rung-label">{r.pct === 50 ? '中位數' : `贏過 ${r.pct}%`}</span>
              <span class="sr-rung-track"><i style={`width:${(r.wan / LADDER_MAX) * 100}%`}></i></span>
              <span class="sr-rung-value">{r.wan} 萬</span>
            </li>
          ))
        }
        <li class="sr-rung sr-rung-you" id="sr-you-rung" hidden>
          <span class="sr-rung-label">你</span>
          <span class="sr-rung-track"><i id="sr-you-bar"></i></span>
          <span class="sr-rung-value" id="sr-you-value"></span>
        </li>
      </ol>
    </section>

    <section class="sr-card" id="sr-history" aria-labelledby="sr-history-title" hidden>
      <h2 class="sr-title" id="sr-history-title">同樣年薪放回過去</h2>
      <p class="hint" id="sr-history-lead"></p>
      <div class="sr-chart" id="sr-chart">
        <svg id="sr-chart-svg" role="img" aria-labelledby="sr-history-lead"></svg>
        <div class="sr-tip" id="sr-tip" hidden></div>
      </div>
      <details class="sr-table-view">
        <summary>看每年的數字</summary>
        <table class="sr-history-table">
          <thead><tr><th scope="col">年度</th><th scope="col" class="num">贏過</th></tr></thead>
          <tbody id="sr-history-rows"></tbody>
        </table>
      </details>
      <p class="hint">金額沒有調整通膨，只看同一個數字在當年的名次。</p>
    </section>
  </div>

  <section class="sr-card" id="sr-compare" aria-labelledby="sr-compare-title" hidden>
    <h2 class="sr-title" id="sr-compare-title">跟誰比</h2>
    <div class="sr-filters">
      {
        simpleFilters.map((f) => (
          <label class="field">
            <span class="label">{f.label}</span>
            <select data-filter={f.id}>
              <option value="">不比較</option>
              {f.groups.map((g, i) => <option value={i}>{g.name}</option>)}
            </select>
          </label>
        ))
      }
      <label class="field">
        <span class="label">行業</span>
        <select data-filter="industry">
          <option value="">不比較</option>
          {
            INDUSTRIES.map((section, s) => (
              <optgroup label={section.label}>
                {section.groups.map((g, i) => <option value={`${s}:${i}`}>{g.name}</option>)}
              </optgroup>
            ))
          }
        </select>
      </label>
      <label class="field">
        <span class="label">工作縣市</span>
        <select data-filter="county">
          <option value="">不比較</option>
          {COUNTIES.map((c, i) => <option value={i}>{c.name}</option>)}
        </select>
      </label>
    </div>
    <ul class="sr-rows" id="sr-rows"></ul>
    <ul class="sr-legend">
      <li><i class="sr-legend-band"></i>中間 50% 的人</li>
      <li><i class="sr-legend-median"></i>中位數</li>
      <li><i class="sr-legend-you"></i>你</li>
    </ul>
    <p class="hint">工作縣市只有本國籍全時員工的中位數，資料沒有金門縣和連江縣。</p>
  </section>

  <p class="hint sr-source">
    資料來源：<a href="https://www.dgbas.gov.tw/News_Content.aspx?n=3602&s=235514" rel="noopener" target="_blank">主計總處 {LATEST.roc} 年全年總薪資中位數及分布統計</a>，範圍是工業及服務業受僱員工，不含農林漁牧業、政府機關和小學以上學校。兩個官方門檻之間的名次用直線內插估算。
  </p>

  <template id="sr-row-template">
    <li class="sr-row">
      <div class="sr-row-head">
        <span class="sr-row-name" data-name></span>
        <span class="sr-row-status" data-status></span>
      </div>
      <div class="sr-track">
        <i class="sr-track-band" data-band></i>
        <i class="sr-track-median" data-median></i>
        <i class="sr-track-you" data-you></i>
        <span class="sr-track-label" data-you-label></span>
      </div>
      <p class="sr-row-foot" data-foot></p>
    </li>
  </template>
</div>

<script>
  import { $, $$, copyText, downloadBlob } from '../../lib/client';
  import { track as trackEvent } from '../../lib/analytics';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    AGES,
    COUNTIES,
    EDUCATIONS,
    FIRM_SIZES,
    FULL_TIME,
    GENDERS,
    INDUSTRIES,
    LATEST,
    type Group,
  } from './data';
  import {
    annualPay,
    checkAmount,
    clampMonths,
    dotOrder,
    dotState,
    groupRank,
    MAX_ANNUAL,
    nextMilestone,
    rankHistory,
    rankOf,
    toYuan,
    trackMax,
    medianRank,
    type PayMode,
    type Rank,
  } from './logic';

  interface Row {
    name: string;
    group?: Group;
    median: number;
  }

  const root = $('[data-tool="salary-rank"]');
  const amountInput = $<HTMLInputElement>('#sr-amount', root);
  const monthsInput = $<HTMLInputElement>('#sr-months', root);
  const hero = $('#sr-hero', root);
  const big = $('#sr-big', root);
  const dotsBox = $('#sr-dots', root);
  const dotEls = $$('.sr-dot', root);
  const youRung = $('#sr-you-rung', root);
  const ladder = $('#sr-ladder', root);
  const rungEls = $$('.sr-rung[data-pay]', root);
  const chart = $('#sr-chart', root);
  const svg = $('#sr-chart-svg', root);
  const tip = $('#sr-tip', root);
  const rowsBox = $('#sr-rows', root);
  const rowTemplate = $<HTMLTemplateElement>('#sr-row-template', root);
  const ladderMax = Number(root.dataset.ladderMax);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const font = getComputedStyle(root).fontFamily;

  let annual: number | null = null;
  let rank: Rank | null = null;
  let shownPct = 0;
  let countFrame = 0;

  function wan(yuan: number): string {
    return `${formatNumber(yuan / 10_000, 1)} 萬`;
  }

  /** Under 10,000 yuan, a rounded 萬 figure would read as 0. */
  function money(yuan: number): string {
    return yuan < 10_000 ? `${formatInteger(yuan)} 元` : wan(yuan);
  }

  function rankWords(r: Rank): string {
    if (r.kind === 'above') return `超過 ${r.pct}%`;
    if (r.kind === 'below') return `不到 ${r.pct}%`;
    return `約 ${r.pct}%`;
  }

  function bigText(r: Rank, pct: number): string {
    if (r.kind === 'above') return '90%+';
    if (r.kind === 'below') return '<10%';
    return `${pct}%`;
  }

  function badgeText(r: Rank): string {
    if (r.kind === 'above') return '前 10% 俱樂部';
    if (r.kind === 'below') return '最低的 10% 內';
    if (r.pct >= 75) return '前四分之一';
    if (r.pct >= 50) return '贏過一半的人';
    return r.pct >= 40 ? '就快到中位數' : '還有往上的空間';
  }

  function headlineText(r: Rank): string {
    if (r.kind === 'above') return `年薪超過 ${LATEST.d[8]} 萬，贏過 90% 以上的上班族`;
    if (r.kind === 'below') return `年薪不到 ${LATEST.d[0]} 萬，在最低的 10% 內`;
    return `你的年薪贏過約 ${r.pct}% 的台灣上班族`;
  }

  function subText(r: Rank): string {
    if (r.kind === 'above') return '官方資料只公布到前 10% 的門檻，再往上就沒有數字了。';
    if (r.kind === 'below') return '這份統計也包含部分工時員工。全時工作的人可以看下方的對照。';
    return `每 100 位上班族，你大約排第 ${100 - r.pct} 名。`;
  }

  function mode(): PayMode {
    return $<HTMLInputElement>('input[name="sr-mode"]:checked', root).value as PayMode;
  }

  function readPay(): void {
    const payMode = mode();
    const amount = parseNumber(amountInput.value);
    const months = parseNumber(monthsInput.value);
    const status = checkAmount(payMode, amount, months);
    const error = $('#sr-error', root);
    error.hidden = status !== 'small' && status !== 'big';
    if (status === 'small') {
      error.textContent = `單位是「元」。例如${payMode === 'annual' ? '年薪 80 萬請填 800000' : '月薪 4 萬 5 千請填 45000'}。`;
    } else if (status === 'big') {
      error.textContent = `金額太大了，請填 ${formatInteger(MAX_ANNUAL / 10_000)} 萬元以內的年薪。`;
    }
    annual = status === 'ok' ? annualPay(payMode, amount, months) : null;
    rank = annual === null ? null : rankOf(annual);
    render();
  }

  function renderDots(): void {
    for (const el of dotEls) {
      el.dataset.state = dotState(Number(el.dataset.order), rank);
    }
    dotsBox.setAttribute('aria-label', rank ? `100 個圓點，你贏過${rankWords(rank)}` : '100 個圓點，尚未輸入薪水');
    const zone = rank && rank.kind !== 'within';
    const [beat, you, ahead] = $$('#sr-key li', root);
    beat.hidden = rank?.kind === 'below';
    you.lastChild!.textContent = zone ? '你在這一區' : '你的位置';
    you.firstElementChild!.classList.toggle('zone', Boolean(zone));
    ahead.hidden = rank?.kind === 'above';
  }

  function countTo(r: Rank): void {
    cancelAnimationFrame(countFrame);
    const from = shownPct;
    const to = r.pct;
    if (r.kind !== 'within' || reduceMotion.matches || from === to) {
      shownPct = to;
      big.textContent = bigText(r, to);
      return;
    }
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 500);
      shownPct = Math.round(from + (to - from) * (1 - (1 - t) ** 3));
      big.textContent = bigText(r, shownPct);
      if (t < 1) countFrame = requestAnimationFrame(step);
    };
    countFrame = requestAnimationFrame(step);
  }

  function renderHero(): void {
    hero.dataset.state = rank ? rank.kind : 'empty';
    $('#sr-actions', root).hidden = !rank;
    if (!rank) {
      cancelAnimationFrame(countFrame);
      shownPct = 0;
      big.textContent = '?';
      $('#sr-badge', root).textContent = '台灣上班族薪資排名';
      $('#sr-headline', root).textContent = '輸入薪水，看你贏過多少人';
      $('#sr-sub', root).textContent = '每個圓點代表 1% 的上班族，由低到高從左下排到右上。';
      return;
    }
    $('#sr-badge', root).textContent = badgeText(rank);
    $('#sr-headline', root).textContent = headlineText(rank);
    $('#sr-sub', root).textContent = subText(rank);
    countTo(rank);
  }

  function renderStats(): void {
    const stats = $('#sr-stats', root);
    stats.hidden = annual === null;
    if (annual === null) return;
    $('#sr-stat-pay', root).textContent = wan(annual);
    $('#sr-stat-pay-label', root).textContent = mode() === 'annual' ? '你的年薪' : '換算年薪（含年終與獎金）';
    const diff = annual - toYuan(LATEST.d[4]);
    $('#sr-stat-median', root).textContent = diff === 0 ? '剛好相同' : `${diff > 0 ? '多' : '少'} ${money(Math.abs(diff))}`;
    const next = nextMilestone(annual);
    const months = mode() === 'annual' ? 12 : clampMonths(parseNumber(monthsInput.value));
    $('#sr-stat-next', root).textContent = next ? `再多 ${money(next.gap)}` : '已經破關';
    $('#sr-stat-next-label', root).textContent = next
      ? `就贏過 ${next.pct}%，平均每月多 ${formatInteger(Math.ceil(next.gap / months))} 元`
      : `比第 9 十分位 ${LATEST.d[8]} 萬還高`;
  }

  function renderLadder(): void {
    youRung.hidden = annual === null;
    for (const rung of rungEls) {
      rung.classList.toggle('passed', annual !== null && annual >= Number(rung.dataset.pay));
    }
    if (annual === null) return;
    const pay = annual;
    const above = rungEls.filter((rung) => Number(rung.dataset.pay) > pay);
    const after = above.length ? above[above.length - 1] : null;
    if (after) after.after(youRung);
    else ladder.prepend(youRung);
    $('#sr-you-bar', root).style.width = `${Math.min(100, (pay / 10_000 / ladderMax) * 100)}%`;
    $('#sr-you-value', root).textContent = wan(pay);
  }

  function drawHistory(): void {
    const section = $('#sr-history', root);
    section.hidden = annual === null;
    $('#sr-two', root).classList.toggle('has-history', annual !== null);
    if (annual === null) return;
    const history = rankHistory(annual);
    const first = history[0];
    const last = history[history.length - 1];
    $('#sr-history-lead', root).textContent =
      `同一筆年薪在 ${first.year} 年可以贏過${rankWords(first.rank)}，放到 ${last.year} 年是${rankWords(last.rank)}。`;
    $('#sr-history-rows', root).innerHTML = history
      .map((h) => `<tr><td>${h.year}（民國 ${h.roc} 年）</td><td class="num">${rankWords(h.rank)}</td></tr>`)
      .join('');

    const width = Math.max(240, chart.clientWidth);
    const height = 200;
    const m = { l: 40, r: 18, t: 22, b: 24 };
    const x = (i: number) => m.l + (i / (history.length - 1)) * (width - m.l - m.r);
    const y = (pct: number) => m.t + (1 - pct / 100) * (height - m.t - m.b);
    const points = history.map((h, i) => [x(i), y(h.rank.pct)] as const);
    const line = points.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join('');
    const area = `${line}L${points[points.length - 1][0].toFixed(1)} ${y(0)}L${points[0][0].toFixed(1)} ${y(0)}Z`;
    const grid = [0, 50, 100]
      .map(
        (v) =>
          `<line class="sr-grid-line" x1="${m.l}" x2="${width - m.r}" y1="${y(v)}" y2="${y(v)}"></line>` +
          `<text class="sr-axis" x="${m.l - 8}" y="${y(v) + 4}" text-anchor="end">${v}%</text>`,
      )
      .join('');
    const years = [0, history.length - 1]
      .map(
        (i) =>
          `<text class="sr-axis" x="${x(i)}" y="${height - 6}" text-anchor="${i ? 'end' : 'start'}">${history[i].year}</text>`,
      )
      .join('');
    const endLabel = (i: number, anchor: string) => {
      const [px, py] = points[i];
      const dy = py < m.t + 16 ? 20 : -12;
      return `<text class="sr-end-label" x="${px}" y="${py + dy}" text-anchor="${anchor}">${rankWords(history[i].rank).replace('約 ', '')}</text>`;
    };
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.setAttribute('width', String(width));
    svg.setAttribute('height', String(height));
    svg.innerHTML =
      grid +
      years +
      `<path class="sr-area" d="${area}"></path><path class="sr-line" d="${line}"></path>` +
      `<line class="sr-cross" id="sr-cross" y1="${m.t}" y2="${y(0)}" visibility="hidden"></line>` +
      `<circle class="sr-point" id="sr-hover-dot" r="5" visibility="hidden"></circle>` +
      `<circle class="sr-point" cx="${points[0][0]}" cy="${points[0][1]}" r="5"></circle>` +
      `<circle class="sr-point" cx="${points[points.length - 1][0]}" cy="${points[points.length - 1][1]}" r="5"></circle>` +
      endLabel(0, 'start') +
      endLabel(points.length - 1, 'end');

    chart.onpointermove = chart.onpointerdown = (event: PointerEvent) => {
      const box = chart.getBoundingClientRect();
      const px = event.clientX - box.left;
      const step = (width - m.l - m.r) / (history.length - 1);
      const i = Math.max(0, Math.min(history.length - 1, Math.round((px - m.l) / step)));
      const [cx, cy] = points[i];
      const cross = svg.querySelector('#sr-cross')!;
      cross.setAttribute('x1', String(cx));
      cross.setAttribute('x2', String(cx));
      cross.setAttribute('visibility', 'visible');
      const dot = svg.querySelector('#sr-hover-dot')!;
      dot.setAttribute('cx', String(cx));
      dot.setAttribute('cy', String(cy));
      dot.setAttribute('visibility', 'visible');
      tip.hidden = false;
      tip.textContent = `${history[i].year}（民國 ${history[i].roc} 年）贏過${rankWords(history[i].rank)}`;
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.max(half, Math.min(width - half, cx))}px`;
      tip.style.top = `${Math.max(0, cy - 44)}px`;
    };
    chart.onpointerleave = () => {
      tip.hidden = true;
      svg.querySelector('#sr-cross')?.setAttribute('visibility', 'hidden');
      svg.querySelector('#sr-hover-dot')?.setAttribute('visibility', 'hidden');
    };
  }

  function chosenRows(): Row[] {
    const sources: Record<string, readonly Group[]> = {
      gender: GENDERS,
      age: AGES,
      education: EDUCATIONS,
      firm: FIRM_SIZES,
    };
    const rows: Row[] = [{ name: FULL_TIME.name, group: FULL_TIME, median: FULL_TIME.median }];
    for (const select of $$<HTMLSelectElement>('select[data-filter]', root)) {
      const id = select.dataset.filter!;
      if (select.value === '') continue;
      if (id === 'county') {
        const county = COUNTIES[Number(select.value)];
        rows.push({ name: `${county.name}（本國籍全時）`, median: county.median });
      } else if (id === 'industry') {
        const [section, index] = select.value.split(':').map(Number);
        const group = INDUSTRIES[section].groups[index];
        rows.push({ name: group.name, group, median: group.median });
      } else {
        const group = sources[id][Number(select.value)];
        rows.push({ name: group.name, group, median: group.median });
      }
    }
    return rows;
  }

  function renderCompare(): void {
    const section = $('#sr-compare', root);
    section.hidden = annual === null;
    if (annual === null) return;
    const pay = annual;
    const rows = chosenRows();
    const max = trackMax(pay, rows.map((r) => r.group?.q3 ?? r.median));
    const at = (yuan: number) => `${Math.min(100, (yuan / max) * 100)}%`;
    const youPct = (pay / max) * 100;
    const labelAlign = youPct < 15 ? 'start' : youPct > 85 ? 'end' : 'center';
    rowsBox.replaceChildren(
      ...rows.map((row) => {
        const li = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        $('[data-name]', li).textContent = row.name;
        const groupStanding = row.group ? groupRank(pay, row.group) : medianRank(pay, row.median);
        $('[data-status]', li).textContent = `贏過${rankWords(groupStanding)}`;
        const band = $('[data-band]', li);
        if (row.group) {
          band.style.left = at(toYuan(row.group.q1));
          band.style.width = `calc(${at(toYuan(row.group.q3))} - ${at(toYuan(row.group.q1))})`;
          $('[data-foot]', li).replaceChildren(
            ...[`贏過 25%：${row.group.q1} 萬`, `中位數：${row.group.median} 萬`, `贏過 75%：${row.group.q3} 萬`].map((text) => {
              const item = document.createElement('span');
              item.textContent = text;
              return item;
            }),
          );
        } else {
          band.hidden = true;
          $('[data-foot]', li).textContent = `中位數 ${row.median} 萬`;
        }
        $('[data-median]', li).style.left = at(toYuan(row.median));
        $('[data-you]', li).style.left = at(pay);
        const label = $('[data-you-label]', li);
        label.textContent = `你 ${wan(pay)}`;
        label.style.left = at(pay);
        label.dataset.align = labelAlign;
        return li;
      }),
    );
  }

  function render(): void {
    renderDots();
    renderHero();
    renderStats();
    renderLadder();
    drawHistory();
    renderCompare();
  }

  function shareText(r: Rank): string {
    const words =
      r.kind === 'within' ? `贏過約 ${r.pct}% 的台灣上班族` : r.kind === 'above' ? '贏過 90% 以上的台灣上班族' : '在台灣上班族最低的 10% 內';
    return `我的年薪${words}，你呢？ https://${root.dataset.host}`;
  }

  function drawPoster(r: Rank): HTMLCanvasElement {
    const canvas = document.createElement('canvas');
    canvas.width = 1080;
    canvas.height = 1350;
    const ctx = canvas.getContext('2d')!;
    const glow = ctx.createRadialGradient(920, 120, 40, 920, 120, 900);
    ctx.fillStyle = '#151826';
    ctx.fillRect(0, 0, 1080, 1350);
    glow.addColorStop(0, 'rgba(240, 82, 46, 0.3)');
    glow.addColorStop(1, 'rgba(240, 82, 46, 0)');
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, 1080, 1350);

    ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
    ctx.font = `500 42px ${font}`;
    ctx.fillText(r.kind === 'below' ? '我的年薪落在' : '我的年薪贏過', 90, 140);
    ctx.fillStyle = '#ffffff';
    ctx.font = `800 210px ${font}`;
    ctx.fillText(r.kind === 'below' ? '最低 10%' : bigText(r, r.pct), 84, 330);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
    ctx.font = `500 42px ${font}`;
    ctx.fillText(r.kind === 'below' ? '的台灣上班族之內' : '的台灣上班族', 90, 410);

    const cell = 66;
    const radius = 22;
    const left = (1080 - cell * 10) / 2 + (cell - radius * 2) / 2;
    const top = 480;
    for (let row = 0; row < 10; row++) {
      for (let column = 0; column < 10; column++) {
        const state = dotState(dotOrder(row, column), r);
        const cx = left + column * cell + radius;
        const cy = top + row * cell + radius;
        ctx.beginPath();
        ctx.arc(cx, cy, state === 'you' ? radius + 3 : radius, 0, Math.PI * 2);
        ctx.fillStyle =
          state === 'beat' ? '#f0522e' : state === 'you' ? '#ffffff' : state === 'zone' ? 'rgba(255, 255, 255, 0.92)' : 'rgba(255, 255, 255, 0.13)';
        ctx.fill();
      }
    }

    ctx.fillStyle = '#ffffff';
    ctx.font = `700 40px ${font}`;
    ctx.fillText('你呢？', 90, 1205);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
    ctx.font = `500 32px ${font}`;
    ctx.fillText(root.dataset.host ?? '', 90, 1255);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
    ctx.font = `400 25px ${font}`;
    ctx.fillText(`資料：主計總處 ${LATEST.roc} 年全年總薪資統計，名次為估算`, 90, 1298);
    return canvas;
  }

  $('#sr-poster', root).addEventListener('click', () => {
    if (!rank) return;
    drawPoster(rank).toBlob(async (blob) => {
      if (!blob) return;
      const file = new File([blob], '我的薪資排名.png', { type: 'image/png' });
      // Phones get the share sheet (it can save to photos); desktops just download.
      if (window.matchMedia('(pointer: coarse)').matches && navigator.canShare?.({ files: [file] })) {
        try {
          await navigator.share({ files: [file] });
          trackEvent('share', { method: 'native', content_type: 'tool_result' });
          return;
        } catch (error) {
          if ((error as DOMException).name === 'AbortError') return;
        }
      }
      downloadBlob(blob, file.name);
    }, 'image/png');
  });

  $('#sr-copy', root).addEventListener('click', async () => {
    if (!rank || !(await copyText(shareText(rank)))) return;
    const label = $('#sr-copy-label', root);
    label.textContent = '已複製';
    window.setTimeout(() => (label.textContent = '複製分享文字'), 1400);
  });

  for (const radio of $$<HTMLInputElement>('input[name="sr-mode"]', root)) {
    radio.addEventListener('change', () => {
      const annualMode = mode() === 'annual';
      $('#sr-months-field', root).hidden = annualMode;
      $('#sr-amount-label', root).textContent = annualMode ? '稅前年薪（元）' : '稅前月薪（元）';
      amountInput.placeholder = annualMode ? '例如 700000' : '例如 45000';
      readPay();
    });
  }
  amountInput.addEventListener('input', readPay);
  monthsInput.addEventListener('input', readPay);
  for (const select of $$('select[data-filter]', root)) select.addEventListener('change', renderCompare);

  let chartWidth = chart.clientWidth;
  new ResizeObserver(() => {
    if (chart.clientWidth === chartWidth) return;
    chartWidth = chart.clientWidth;
    if (annual !== null) drawHistory();
  }).observe(chart);

  readPay();
</script>

