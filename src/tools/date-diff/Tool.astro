---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { plural } from '../../i18n/format';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="date-diff" {...i18nAttrs(locale, s.client)}>
  <div class="seg" role="radiogroup" aria-label={s.modeAria}>
    <label><input type="radio" name="dd-mode" value="diff" checked /><span>{s.modeDiff}</span></label>
    <label><input type="radio" name="dd-mode" value="add" /><span>{s.modeAdd}</span></label>
  </div>

  <div class="dd-pane" data-pane="diff">
    <div class="grid-2">
      <div class="field">
        <label for="dd-start">{s.startLabel}</label>
        <input id="dd-start" type="date" />
      </div>
      <div class="field">
        <label for="dd-end">{s.endLabel}</label>
        <input id="dd-end" type="date" />
      </div>
    </div>

    <div class="row between">
      <label class="check"><input id="dd-include" type="checkbox" /> {s.includeEnd}</label>
      <div class="row">
        <button class="btn small" type="button" id="dd-today">{s.setToday}</button>
        <button class="btn small ghost" type="button" id="dd-swap">{s.swap}</button>
      </div>
    </div>

    <div class="result" aria-live="polite">
      <div class="result-value" id="dd-days">{plural(locale, 0, s.client.days)}</div>
      <div class="result-label" id="dd-range"></div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="dd-span">—</span><span class="stat-label">{s.statSpan}</span></div>
      <div class="stat"><span class="stat-value" id="dd-weeks">—</span><span class="stat-label">{s.statWeeks}</span></div>
      <div class="stat"><span class="stat-value" id="dd-work">—</span><span class="stat-label">{s.statWork}</span></div>
      <div class="stat"><span class="stat-value" id="dd-hours">—</span><span class="stat-label">{s.statHours}</span></div>
    </div>
    <p class="hint">{s.hint}</p>
  </div>

  <div class="dd-pane" data-pane="add" hidden>
    <div class="grid-3">
      <div class="field">
        <label for="dd-base">{s.baseLabel}</label>
        <input id="dd-base" type="date" />
      </div>
      <div class="field">
        <label for="dd-n">{s.nLabel}</label>
        <input id="dd-n" type="text" inputmode="numeric" value="100" autocomplete="off" />
      </div>
      <div class="field">
        <label for="dd-dir">{s.dirLabel}</label>
        <select id="dd-dir">
          <option value="1">{s.dirAfter}</option>
          <option value="-1">{s.dirBefore}</option>
        </select>
      </div>
    </div>

    <div class="row" aria-label={s.quickAria}>
      <span class="hint">{s.quickLabel}</span>
      <button class="btn small" type="button" data-n="7">{plural(locale, 7, s.client.days)}</button>{' '}<button class="btn small" type="button" data-n="30">{plural(locale, 30, s.client.days)}</button>{' '}<button class="btn small" type="button" data-n="90">{plural(locale, 90, s.client.days)}</button>{' '}<button class="btn small" type="button" data-n="100">{plural(locale, 100, s.client.days)}</button>{' '}<button class="btn small" type="button" data-n="180">{plural(locale, 180, s.client.days)}</button>{' '}<button class="btn small" type="button" data-n="365">{plural(locale, 365, s.client.days)}</button>
    </div>

    <div class="result" aria-live="polite">
      <div class="result-value" id="dd-target">—</div>
      <div class="result-label" id="dd-target-label"></div>
    </div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { formatDate, plural, t } from '../../i18n/format';
  import { addDays, dateDiff, formatYMD, parseISODate, spanParts, toISODate, toUTCDate, type YMD, type YMDSpan } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="date-diff"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const days = (n: number) => plural(locale, n, s.days);
  const showDate = (d: YMD) =>
    s.dateStyle === 'intl' ? formatDate(toUTCDate(d), locale, { dateStyle: 'full', timeZone: 'UTC' }) : formatYMD(d);
  const showSpan = (span: YMDSpan) =>
    spanParts(span)
      .map((p) => plural(locale, p.n, s.span[p.unit]))
      .join(' ');
  const modes = $$<HTMLInputElement>('input[name="dd-mode"]', root);
  const panes = $$<HTMLElement>('.dd-pane', root);
  const start = $<HTMLInputElement>('#dd-start', root);
  const end = $<HTMLInputElement>('#dd-end', root);
  const include = $<HTMLInputElement>('#dd-include', root);
  const base = $<HTMLInputElement>('#dd-base', root);
  const nInput = $<HTMLInputElement>('#dd-n', root);
  const dir = $<HTMLSelectElement>('#dd-dir', root);

  interface Prefs {
    mode: string;
    include: boolean;
    n: string;
    dir: string;
  }

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }

  function currentMode(): string {
    return modes.find((m) => m.checked)?.value ?? 'diff';
  }

  function renderDiff() {
    const a = parseISODate(start.value);
    const b = parseISODate(end.value);
    const set = (id: string, text: string) => ($(id, root).textContent = text);
    if (!a || !b) {
      set('#dd-days', '—');
      set('#dd-range', s.pickDates);
      ['#dd-span', '#dd-weeks', '#dd-work', '#dd-hours'].forEach((id) => set(id, '—'));
      return;
    }
    const r = dateDiff(a, b, include.checked);
    set('#dd-days', days(r.days));
    set(
      '#dd-range',
      r.reversed
        ? s.reversed
        : `${t(s.range, { a: showDate(a), b: showDate(b) })}${include.checked ? s.includedSuffix : ''}`,
    );
    set('#dd-span', showSpan(r.span));
    const weeks = plural(locale, r.weeks, s.weeks);
    set('#dd-weeks', r.weekRemainder ? `${weeks} ${days(r.weekRemainder)}` : weeks);
    set('#dd-work', days(r.workdays));
    set('#dd-hours', plural(locale, r.days * 24, s.hours));
  }

  function renderAdd() {
    const from = parseISODate(base.value);
    const n = Math.trunc(parseNumber(nInput.value));
    const target = $('#dd-target', root);
    const label = $('#dd-target-label', root);
    if (!from || !Number.isFinite(n)) {
      target.textContent = '—';
      label.textContent = from ? s.enterDays : s.pickBase;
      return;
    }
    const sign = Number(dir.value) * Math.sign(n || 1);
    const result = addDays(from, Number(dir.value) * n);
    target.textContent = showDate(result);
    label.textContent = t(sign < 0 ? s.before : s.after, { date: showDate(from), days: days(Math.abs(n)) });
  }

  function render() {
    const mode = currentMode();
    for (const pane of panes) pane.hidden = pane.dataset.pane !== mode;
    savePref('date-diff', { mode, include: include.checked, n: nInput.value, dir: dir.value } satisfies Prefs);
    if (mode === 'diff') renderDiff();
    else renderAdd();
  }

  // Prefill: today → end of this year, and today + 100 days.
  const now = today();
  start.value = toISODate(now);
  end.value = toISODate({ y: now.y, m: 12, d: 31 });
  base.value = toISODate(now);
  const prefs = loadPref<Prefs>('date-diff', { mode: 'diff', include: false, n: '100', dir: '1' });
  for (const m of modes) m.checked = m.value === prefs.mode;
  if (!modes.some((m) => m.checked)) modes[0].checked = true;
  include.checked = prefs.include;
  nInput.value = prefs.n || '100';
  dir.value = prefs.dir === '-1' ? '-1' : '1';

  modes.forEach((m) => m.addEventListener('change', render));
  [start, end, base, nInput].forEach((el) => el.addEventListener('input', render));
  [include, dir].forEach((el) => el.addEventListener('change', render));
  $('#dd-today', root).addEventListener('click', () => {
    start.value = toISODate(today());
    render();
  });
  $('#dd-swap', root).addEventListener('click', () => {
    [start.value, end.value] = [end.value, start.value];
    render();
  });
  $$<HTMLButtonElement>('[data-n]', root).forEach((btn) =>
    btn.addEventListener('click', () => {
      nInput.value = btn.dataset.n!;
      render();
    }),
  );
  render();
</script>

<style>
  .dd-pane:not([hidden]) {
    display: grid;
    gap: 16px;
  }
  .dd-pane .result-value {
    font-size: clamp(24px, 6vw, 32px);
  }
</style>
