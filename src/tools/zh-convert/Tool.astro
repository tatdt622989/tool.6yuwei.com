<div class="tool" data-tool="zh-convert">
  <div class="field">
    <span class="label">轉換方向</span>
    <div class="seg" role="radiogroup" aria-label="轉換方向">
      <label><input type="radio" name="zc-mode" value="s2t" checked /><span>簡體 → 繁體</span></label>
      <label><input type="radio" name="zc-mode" value="t2s" /><span>繁體 → 簡體</span></label>
      <label><input type="radio" name="zc-mode" value="normalize" /><span>繁體 → 台灣正體</span></label>
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="zc-phrases" checked /> 轉換地區用語（软件 ↔ 軟體）</label>
    <label class="check"><input type="checkbox" id="zc-common" checked /> 使用常見字形（台灣、濕度，而非臺灣、溼度）</label>
    <label class="check"><input type="checkbox" id="zc-quotes" /> 轉換引號（“” ↔ 「」）</label>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="zc-input" id="zc-input-label">簡體中文</label>
      <textarea id="zc-input" rows="12" placeholder="在這裡貼上要轉換的文字…"></textarea>
      <span class="hint" id="zc-input-count">0 字</span>
    </div>
    <div class="field">
      <label for="zc-output" id="zc-output-label">繁體中文（台灣）</label>
      <textarea id="zc-output" rows="12" readonly placeholder="轉換結果會顯示在這裡"></textarea>
      <span class="hint" id="zc-status" aria-live="polite">0 字</span>
    </div>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#zc-output">複製結果</button>
    <button class="btn" type="button" id="zc-swap">交換方向</button>
    <button class="btn ghost" type="button" id="zc-clear">清除</button>
  </div>

  <p class="notice" id="zc-error" hidden></p>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { MODE_LABELS, applyConversion, isZhMode, loadConverter, swapMode, type ZhOptions } from './logic';

  const root = $('[data-tool="zh-convert"]');
  const input = $<HTMLTextAreaElement>('#zc-input', root);
  const output = $<HTMLTextAreaElement>('#zc-output', root);
  const inputLabel = $('#zc-input-label', root);
  const outputLabel = $('#zc-output-label', root);
  const inputCount = $('#zc-input-count', root);
  const status = $('#zc-status', root);
  const error = $('#zc-error', root);
  const phrases = $<HTMLInputElement>('#zc-phrases', root);
  const quotes = $<HTMLInputElement>('#zc-quotes', root);
  const common = $<HTMLInputElement>('#zc-common', root);
  const radios = $$<HTMLInputElement>('input[name="zc-mode"]', root);

  const defaults: ZhOptions = { mode: 's2t', phrases: true, quotes: false, commonGlyphs: true };
  let request = 0;

  const countChars = (text: string) => `${formatInteger(Array.from(text).length)} 字`;

  function readOptions(): ZhOptions {
    const checked = radios.find((r) => r.checked)?.value;
    return {
      mode: isZhMode(checked) ? checked : 's2t',
      phrases: phrases.checked,
      quotes: quotes.checked,
      commonGlyphs: common.checked,
    };
  }

  function applyOptions(opts: ZhOptions) {
    const mode = isZhMode(opts.mode) ? opts.mode : 's2t';
    for (const r of radios) r.checked = r.value === mode;
    phrases.checked = opts.phrases !== false;
    quotes.checked = Boolean(opts.quotes);
    common.checked = opts.commonGlyphs !== false;
  }

  async function render() {
    const opts = readOptions();
    savePref('zh-convert', opts);
    inputLabel.textContent = MODE_LABELS[opts.mode].from;
    outputLabel.textContent = MODE_LABELS[opts.mode].to;
    inputCount.textContent = countChars(input.value);

    const text = input.value;
    const id = ++request;
    if (text === '') {
      output.value = '';
      status.textContent = countChars('');
      return;
    }
    status.textContent = '正在載入字典…';
    try {
      const convert = await loadConverter(opts.mode, opts.phrases);
      if (id !== request) return;
      output.value = applyConversion(text, convert, opts);
      status.textContent = countChars(output.value);
      error.hidden = true;
    } catch {
      if (id !== request) return;
      status.textContent = '';
      error.textContent = '字典載入失敗，請檢查網路連線後重新整理頁面。';
      error.className = 'notice error';
      error.hidden = false;
    }
  }

  const renderSoon = debounce(render, 120);

  applyOptions(loadPref('zh-convert', defaults));
  input.addEventListener('input', renderSoon);
  for (const r of radios) r.addEventListener('change', render);
  phrases.addEventListener('change', render);
  quotes.addEventListener('change', render);
  common.addEventListener('change', render);

  $('#zc-swap', root).addEventListener('click', () => {
    const next = swapMode(readOptions().mode);
    if (output.value) input.value = output.value;
    for (const r of radios) r.checked = r.value === next;
    render();
  });

  $('#zc-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });

  render();
</script>
