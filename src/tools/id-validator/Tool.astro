<div class="tool" data-tool="id-validator">
  <div class="seg" role="radiogroup" aria-label="驗證類型">
    <label><input type="radio" name="iv-type" value="id" checked /><span>身分證／居留證</span></label>
    <label><input type="radio" name="iv-type" value="ubn" /><span>統一編號</span></label>
    <label><input type="radio" name="iv-type" value="batch" /><span>批次驗證</span></label>
  </div>

  <section class="iv-panel" data-panel="id">
    <div class="field">
      <label for="iv-id">身分證字號或居留證號（統一證號）</label>
      <input id="iv-id" class="mono iv-input" type="text" maxlength="14" autocomplete="off" autocapitalize="characters" spellcheck="false" value="A123456789" />
      <span class="hint">範例 A123456789 為教科書常用的示範號碼。大小寫、全形都可以，空白會自動忽略。</span>
    </div>
    <div class="notice" id="iv-id-summary" aria-live="polite"></div>
    <ul class="iv-checks" id="iv-id-checks"></ul>
    <div class="field" id="iv-id-steps-wrap">
      <span class="label">檢查碼計算過程</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>來源</th><th class="num">數值</th><th class="num">權重</th><th class="num">乘積</th></tr></thead>
          <tbody id="iv-id-steps"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="iv-panel" data-panel="ubn" hidden>
    <div class="field">
      <label for="iv-ubn">統一編號（8 碼）</label>
      <input id="iv-ubn" class="mono iv-input" type="text" inputmode="numeric" maxlength="12" autocomplete="off" spellcheck="false" value="04595252" />
      <span class="hint">範例 04595252 取自財政部說明文件，只符合新制「被 5 整除」。試試 04595257（新舊制皆符合）或 10458575（第 7 碼為 7）。</span>
    </div>
    <div class="notice" id="iv-ubn-summary" aria-live="polite"></div>
    <ul class="iv-checks" id="iv-ubn-checks"></ul>
    <div class="field" id="iv-ubn-steps-wrap">
      <span class="label">邏輯乘數計算過程</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>位數</th><th class="num">數字</th><th class="num">乘數</th><th class="num">乘積</th><th class="num">乘積十位＋個位</th></tr></thead>
          <tbody id="iv-ubn-steps"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="iv-panel" data-panel="batch" hidden>
    <div class="field">
      <label for="iv-batch">一行一個號碼（身分證、居留證、統一編號可混合）</label>
      <textarea id="iv-batch" class="mono" rows="7" spellcheck="false">A123456789
A123456788
04595257
04595252
12345678</textarea>
    </div>
    <div class="stats">
      <div class="stat"><span class="stat-value" id="iv-b-total">0</span><span class="stat-label">筆數</span></div>
      <div class="stat"><span class="stat-value" id="iv-b-ok">0</span><span class="stat-label">有效</span></div>
      <div class="stat"><span class="stat-value" id="iv-b-bad">0</span><span class="stat-label">無效</span></div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>號碼</th><th>類型</th><th>結果</th><th>說明</th></tr></thead>
        <tbody id="iv-b-rows"></tbody>
      </table>
    </div>
  </section>

  <p class="notice">本工具只檢查號碼格式與檢查碼是否符合編碼規則，無法確認號碼是否真的已核發或屬於某人。所有驗證都在你的瀏覽器中完成，輸入的號碼不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { ID_KIND_LABEL, validateBatch, validateNationalId, validateUbn, type Check } from './logic';

  const root = $('[data-tool="id-validator"]');
  const types = $$<HTMLInputElement>('input[name="iv-type"]', root);
  const panels = $$<HTMLElement>('.iv-panel', root);
  const idInput = $<HTMLInputElement>('#iv-id', root);
  const ubnInput = $<HTMLInputElement>('#iv-ubn', root);
  const batch = $<HTMLTextAreaElement>('#iv-batch', root);

  function cell(tag: 'td' | 'th', text: string, cls?: string): HTMLElement {
    const el = document.createElement(tag);
    el.textContent = text;
    if (cls) el.className = cls;
    return el;
  }

  function row(...cells: HTMLElement[]): HTMLTableRowElement {
    const tr = document.createElement('tr');
    tr.append(...cells);
    return tr;
  }

  function renderChecks(list: HTMLElement, checks: Check[]) {
    list.innerHTML = '';
    for (const c of checks) {
      const li = document.createElement('li');
      li.className = c.ok ? 'is-ok' : 'is-bad';
      const badge = document.createElement('span');
      badge.className = 'iv-badge';
      badge.textContent = c.ok ? '通過' : '不符';
      const text = document.createElement('div');
      const strong = document.createElement('strong');
      strong.textContent = c.label;
      const p = document.createElement('span');
      p.textContent = c.detail;
      text.append(strong, p);
      li.append(badge, text);
      list.append(li);
    }
  }

  function summary(el: HTMLElement, state: 'ok' | 'error' | 'idle', text: string) {
    el.className = `notice${state === 'idle' ? '' : ` ${state}`}`;
    el.textContent = text;
  }

  function renderId() {
    const r = validateNationalId(idInput.value);
    const box = $('#iv-id-summary', root);
    if (r.input === '') {
      summary(box, 'idle', '請輸入 10 碼的身分證字號或居留證號。');
    } else if (r.valid) {
      summary(box, 'ok', `${r.input} 是有效的${ID_KIND_LABEL[r.kind!]}（${r.gender}性，初次登記地：${r.region}）。`);
    } else {
      const failed = r.checks.find((c) => !c.ok);
      summary(box, 'error', `${r.input} 無效：${failed ? `${failed.label}未通過。` : ''}`);
    }
    renderChecks($('#iv-id-checks', root), r.input === '' ? [] : r.checks);

    const tbody = $('#iv-id-steps', root);
    tbody.innerHTML = '';
    $('#iv-id-steps-wrap', root).hidden = r.steps.length === 0;
    for (const s of r.steps) {
      tbody.append(row(cell('td', s.source), cell('td', String(s.digit), 'num'), cell('td', `× ${s.weight}`, 'num'), cell('td', String(s.product), 'num')));
    }
    if (r.sum !== null) {
      tbody.append(
        row(
          cell('th', '加權總和'),
          cell('td', ''),
          cell('td', ''),
          cell('td', `${r.sum}（${r.sum % 10 === 0 ? '可' : '不可'}被 10 整除）`, 'num'),
        ),
      );
    }
  }

  function renderUbn() {
    const r = validateUbn(ubnInput.value);
    const box = $('#iv-ubn-summary', root);
    if (r.input === '') summary(box, 'idle', '請輸入 8 碼統一編號。');
    else if (r.validNew)
      summary(box, 'ok', `${r.input} 是有效的統一編號${r.validOld ? '（新、舊檢查邏輯皆符合）' : '（僅符合 2023 年起的新制，屬於新號段）'}。`);
    else summary(box, 'error', `${r.input} 不是有效的統一編號。`);
    renderChecks($('#iv-ubn-checks', root), r.input === '' ? [] : r.checks);

    const tbody = $('#iv-ubn-steps', root);
    tbody.innerHTML = '';
    $('#iv-ubn-steps-wrap', root).hidden = r.steps.length === 0;
    r.steps.forEach((s, i) => {
      const special = i === 6 && r.seventhIsSeven;
      tbody.append(
        row(
          cell('td', `第 ${i + 1} 碼`),
          cell('td', String(s.digit), 'num'),
          cell('td', `× ${s.weight}`, 'num'),
          cell('td', String(s.product), 'num'),
          cell('td', special ? '10 → 取 1 或 0' : String(s.digitSum), 'num'),
        ),
      );
    });
    if (r.totals.length) {
      tbody.append(row(cell('th', '總和'), cell('td', ''), cell('td', ''), cell('td', ''), cell('td', r.totals.join(' 或 '), 'num')));
    }
  }

  function renderBatch() {
    const rows = validateBatch(batch.value);
    const tbody = $('#iv-b-rows', root);
    tbody.innerHTML = '';
    for (const r of rows) {
      const status = cell('td', r.valid ? '有效' : '無效', r.valid ? 'iv-ok' : 'iv-bad');
      tbody.append(row(cell('td', r.input, 'mono'), cell('td', r.type === 'ubn' ? '統一編號' : '身分證／居留證'), status, cell('td', r.note, 'iv-note')));
    }
    const ok = rows.filter((r) => r.valid).length;
    $('#iv-b-total', root).textContent = String(rows.length);
    $('#iv-b-ok', root).textContent = String(ok);
    $('#iv-b-bad', root).textContent = String(rows.length - ok);
  }

  function showPanel(type: string) {
    for (const p of panels) p.hidden = p.dataset.panel !== type;
    for (const t of types) t.checked = t.value === type;
    savePref('id-validator', type);
  }

  types.forEach((t) => t.addEventListener('change', () => showPanel(t.value)));
  idInput.addEventListener('input', renderId);
  ubnInput.addEventListener('input', renderUbn);
  batch.addEventListener('input', renderBatch);

  // Deep link such as /id-validator/#ubn opens the 統一編號 tab.
  const hash = location.hash.slice(1);
  showPanel(['id', 'ubn', 'batch'].includes(hash) ? hash : loadPref('id-validator', 'id'));
  renderId();
  renderUbn();
  renderBatch();
</script>

<style>
  .iv-panel {
    display: grid;
    gap: 14px;
  }
  .iv-input {
    font-size: 20px !important;
    letter-spacing: 0.06em;
  }
  .iv-checks {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .iv-checks:empty {
    display: none;
  }
  .iv-checks :global(li) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 14px;
  }
  .iv-checks :global(li div) {
    display: grid;
    gap: 2px;
  }
  .iv-checks :global(li span:not(.iv-badge)) {
    color: var(--text-2);
  }
  .iv-checks :global(.iv-badge) {
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }
  .iv-checks :global(li.is-ok .iv-badge) {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 12%, transparent);
  }
  .iv-checks :global(li.is-bad) {
    border-color: color-mix(in oklab, var(--danger) 40%, transparent);
  }
  .iv-checks :global(li.is-bad .iv-badge) {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 12%, transparent);
  }
  #iv-b-rows :global(.iv-ok) {
    color: var(--success);
    font-weight: 600;
  }
  #iv-b-rows :global(.iv-bad) {
    color: var(--danger);
    font-weight: 600;
  }
  #iv-b-rows :global(.iv-note) {
    white-space: normal;
    min-width: 220px;
    color: var(--text-2);
  }
</style>
