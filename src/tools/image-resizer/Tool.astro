---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="image-resizer" {...i18nAttrs(locale, s.client)}>
  <label class="dropzone" id="rs-drop" tabindex="0">
    <input type="file" id="rs-file" accept="image/*" multiple hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="field">
    <span class="label">{s.modeLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.modeLabel}>
      <label><input type="radio" name="rs-mode" value="size" checked /><span>{s.modeSize}</span></label>
      <label><input type="radio" name="rs-mode" value="percent" /><span>{s.modePercent}</span></label>
    </div>
  </div>

  <div class="rs-panel" id="rs-size-panel">
    <div class="rs-dims">
      <div class="field">
        <label for="rs-w">{s.widthLabel}</label>
        <input id="rs-w" type="number" inputmode="numeric" min="1" step="1" placeholder={s.client.auto} />
      </div>
      <span class="rs-times" aria-hidden="true">×</span>
      <div class="field">
        <label for="rs-h">{s.heightLabel}</label>
        <input id="rs-h" type="number" inputmode="numeric" min="1" step="1" placeholder={s.client.auto} />
      </div>
    </div>
    <label class="check"><input type="checkbox" id="rs-lock" checked /> {s.lock}</label>

    <div class="field">
      <span class="label">{s.presetsLabel}</span>
      <div class="row">
        {
          s.presets.map((p) => (
            <button class="btn small" type="button" data-w={p.width} data-h={p.height}>
              {p.label} {p.width}×{p.height}
            </button>
          ))
        }
      </div>
    </div>

    <div class="field" id="rs-fit-field" hidden>
      <span class="label">{s.fitLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.fitAria}>
        <label><input type="radio" name="rs-fit" value="cover" checked /><span>{s.fitCover}</span></label>
        <label><input type="radio" name="rs-fit" value="contain" /><span>{s.fitContain}</span></label>
        <label><input type="radio" name="rs-fit" value="stretch" /><span>{s.fitStretch}</span></label>
      </div>
    </div>

    <div class="row" id="rs-pad-field" hidden>
      <label class="check" for="rs-pad">{s.padColor} <input id="rs-pad" type="color" value="#ffffff" /></label>
      <label class="check"><input type="checkbox" id="rs-pad-clear" /> {s.padClear}</label>
    </div>
  </div>

  <div class="rs-panel" id="rs-percent-panel" hidden>
    <div class="field">
      <label for="rs-pct">{s.percentLabel}</label>
      <div class="row">
        <input id="rs-pct" class="rs-pct" type="number" inputmode="decimal" min="1" max="1000" step="1" value="50" />
        <button class="btn small" type="button" data-pct="25">25%</button>
        <button class="btn small" type="button" data-pct="50">50%</button>
        <button class="btn small" type="button" data-pct="75">75%</button>
        <button class="btn small" type="button" data-pct="200">200%</button>
      </div>
    </div>
  </div>

  <p class="notice" id="rs-desc" aria-live="polite"></p>

  <div class="grid-2">
    <div class="field">
      <span class="label">{s.formatLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.formatLabel}>
        <label><input type="radio" name="rs-format" value="keep" checked /><span>{s.keep}</span></label>
        <label><input type="radio" name="rs-format" value="jpeg" /><span>JPG</span></label>
        <label><input type="radio" name="rs-format" value="png" /><span>PNG</span></label>
        <label><input type="radio" name="rs-format" value="webp" /><span>WebP</span></label>
      </div>
    </div>
    <div class="field">
      <label for="rs-quality">{s.qualityBefore}<output id="rs-quality-out">90</output></label>
      <input id="rs-quality" type="range" min="10" max="100" step="1" value="90" />
      <span class="hint">{s.qualityHint}</span>
    </div>
  </div>

  <ul class="rs-list" id="rs-list" aria-live="polite"></ul>

  <div class="row" id="rs-actions" hidden>
    <button class="btn primary" type="button" id="rs-all">{s.downloadAll}</button>
    <button class="btn ghost" type="button" id="rs-clear">{s.clear}</button>
  </div>

  <p class="hint">{s.privacy}</p>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import {
    computeLayout,
    describeSpec,
    exceedsLimit,
    hasPadding,
    outputFilename,
    proportionalHeight,
    proportionalWidth,
    resolveOutputType,
    stepDownSizes,
    type FitMode,
    type Layout,
    type OutputChoice,
    type ResizeSpec,
  } from './logic';

  type AnyCanvas = HTMLCanvasElement | OffscreenCanvas;
  type Ctx = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;

  interface Result {
    blob: Blob;
    url: string;
    width: number;
    height: number;
    filename: string;
  }
  interface Item {
    file: File;
    row: HTMLLIElement;
    srcWidth?: number;
    srcHeight?: number;
    result?: Result;
    error?: string;
    waiting?: boolean;
  }
  interface Prefs {
    mode: 'size' | 'percent';
    width: string;
    height: string;
    lock: boolean;
    fit: FitMode;
    percent: string;
    format: OutputChoice;
    quality: number;
    pad: string;
    padClear: boolean;
  }

  const root = $('[data-tool="image-resizer"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const drop = $('#rs-drop', root);
  const fileInput = $<HTMLInputElement>('#rs-file', root);
  const modeRadios = $$<HTMLInputElement>('input[name="rs-mode"]', root);
  const fitRadios = $$<HTMLInputElement>('input[name="rs-fit"]', root);
  const formatRadios = $$<HTMLInputElement>('input[name="rs-format"]', root);
  const widthIn = $<HTMLInputElement>('#rs-w', root);
  const heightIn = $<HTMLInputElement>('#rs-h', root);
  const lock = $<HTMLInputElement>('#rs-lock', root);
  const pct = $<HTMLInputElement>('#rs-pct', root);
  const pad = $<HTMLInputElement>('#rs-pad', root);
  const padClear = $<HTMLInputElement>('#rs-pad-clear', root);
  const quality = $<HTMLInputElement>('#rs-quality', root);
  const qualityOut = $('#rs-quality-out', root);
  const desc = $('#rs-desc', root);
  const list = $('#rs-list', root);
  const actions = $('#rs-actions', root);

  let items: Item[] = [];
  let generation = 0;

  // ---------- Canvas helpers ----------
  const useOffscreen = typeof OffscreenCanvas !== 'undefined' && 'convertToBlob' in OffscreenCanvas.prototype;

  function makeCanvas(width: number, height: number): AnyCanvas {
    if (useOffscreen) return new OffscreenCanvas(width, height);
    const c = document.createElement('canvas');
    c.width = width;
    c.height = height;
    return c;
  }

  function context(canvas: AnyCanvas): Ctx {
    const ctx = canvas.getContext('2d') as Ctx | null;
    if (!ctx) throw new Error('canvas');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    return ctx;
  }

  function toBlob(canvas: AnyCanvas, type: string, q?: number): Promise<Blob> {
    if ('convertToBlob' in canvas) return canvas.convertToBlob({ type, quality: q });
    return new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q),
    );
  }

  async function canEncode(type: string): Promise<boolean> {
    try {
      const c = makeCanvas(2, 2);
      context(c).fillRect(0, 0, 2, 2);
      return (await toBlob(c, type, 0.8)).type === type;
    } catch {
      return false;
    }
  }

  async function decode(file: Blob): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { source: bmp, width: bmp.width, height: bmp.height, close: () => bmp.close() };
      } catch {
        /* fall back to <img> */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      return { source: img, width: img.naturalWidth, height: img.naturalHeight, close: () => {} };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  /** Draws the cropped source into the layout, halving in steps for large reductions. */
  function render(source: CanvasImageSource, layout: Layout, background: string | null): AnyCanvas {
    let current: CanvasImageSource = source;
    let cx = layout.sx;
    let cy = layout.sy;
    let cw = layout.sw;
    let ch = layout.sh;
    for (const step of stepDownSizes(Math.round(cw), Math.round(ch), layout.dw, layout.dh)) {
      const c = makeCanvas(step.width, step.height);
      context(c).drawImage(current, cx, cy, cw, ch, 0, 0, step.width, step.height);
      current = c;
      cx = 0;
      cy = 0;
      cw = step.width;
      ch = step.height;
    }
    const out = makeCanvas(layout.width, layout.height);
    const ctx = context(out);
    if (background) {
      ctx.fillStyle = background;
      ctx.fillRect(0, 0, layout.width, layout.height);
    }
    ctx.drawImage(current, cx, cy, cw, ch, layout.dx, layout.dy, layout.dw, layout.dh);
    return out;
  }

  // ---------- Settings ----------
  const checked = (radios: HTMLInputElement[], fallback: string) => radios.find((r) => r.checked)?.value ?? fallback;
  const numOrNull = (v: string) => (v.trim() === '' ? null : Number(v));

  function readPrefs(): Prefs {
    return {
      mode: checked(modeRadios, 'size') as Prefs['mode'],
      width: widthIn.value,
      height: heightIn.value,
      lock: lock.checked,
      fit: checked(fitRadios, 'cover') as FitMode,
      percent: pct.value,
      format: checked(formatRadios, 'keep') as OutputChoice,
      quality: Number(quality.value),
      pad: pad.value,
      padClear: padClear.checked,
    };
  }

  function applyPrefs(p: Prefs) {
    for (const r of modeRadios) r.checked = r.value === p.mode;
    for (const r of fitRadios) r.checked = r.value === p.fit;
    for (const r of formatRadios) r.checked = r.value === p.format;
    widthIn.value = p.width;
    heightIn.value = p.height;
    lock.checked = p.lock;
    pct.value = p.percent;
    quality.value = String(p.quality);
    pad.value = p.pad;
    padClear.checked = p.padClear;
  }

  function specOf(p: Prefs): ResizeSpec {
    if (p.mode === 'percent') return { mode: 'percent', percent: Number(p.percent) };
    return { mode: 'size', width: numOrNull(p.width), height: numOrNull(p.height), lockRatio: p.lock, fit: p.fit };
  }

  function syncControls(p: Prefs) {
    const sizeMode = p.mode === 'size';
    $('#rs-size-panel', root).hidden = !sizeMode;
    $('#rs-percent-panel', root).hidden = sizeMode;
    const fixedBox = sizeMode && !p.lock && p.width.trim() !== '' && p.height.trim() !== '';
    $('#rs-fit-field', root).hidden = !fixedBox;
    $('#rs-pad-field', root).hidden = !(fixedBox && p.fit === 'contain');
    qualityOut.textContent = quality.value;
    desc.textContent = describeSpec(specOf(p), s.spec);

    // Show the derived side for the first image as a placeholder hint.
    const first = items.find((i) => i.srcWidth);
    widthIn.placeholder = s.auto;
    heightIn.placeholder = s.auto;
    if (first && sizeMode) {
      const w = numOrNull(p.width);
      const h = numOrNull(p.height);
      if (w && !h) heightIn.placeholder = t(s.autoValue, { n: proportionalHeight(first.srcWidth!, first.srcHeight!, w) });
      if (h && !w) widthIn.placeholder = t(s.autoValue, { n: proportionalWidth(first.srcWidth!, first.srcHeight!, h) });
    }
  }

  // ---------- Resize ----------
  async function resize(item: Item, p: Prefs): Promise<Result | null> {
    const image = await decode(item.file);
    try {
      item.srcWidth = image.width;
      item.srcHeight = image.height;
      const layout = computeLayout(image.width, image.height, specOf(p));
      if (!layout) return null;
      if (exceedsLimit(layout)) throw new RangeError('too-large');
      const type = resolveOutputType(item.file.type, p.format);
      const transparentOk = type !== 'image/jpeg';
      let background: string | null = null;
      if (!transparentOk) background = hasPadding(layout) ? p.pad : '#ffffff';
      else if (hasPadding(layout) && !p.padClear) background = p.pad;
      const canvas = render(image.source, layout, background);
      const blob = await toBlob(canvas, type, type === 'image/png' ? undefined : p.quality / 100);
      return {
        blob,
        url: URL.createObjectURL(blob),
        width: layout.width,
        height: layout.height,
        filename: outputFilename(item.file.name, layout.width, layout.height, blob.type || type),
      };
    } finally {
      image.close();
    }
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    const thumb = el('div', 'rs-thumb');
    if (item.result) {
      const img = el('img');
      img.src = item.result.url;
      img.alt = '';
      img.loading = 'lazy';
      thumb.append(img);
    }
    const info = el('div', 'rs-info');
    const meta = el('div', 'rs-meta');
    info.append(el('div', 'rs-name', item.file.name), meta);
    const src = item.srcWidth ? `${item.srcWidth} × ${item.srcHeight}` : '';
    if (item.error) {
      meta.append(el('span', 'rs-error', item.error));
    } else if (item.waiting) {
      meta.textContent = t(s.waiting, { src });
    } else if (!item.result) {
      meta.textContent = t(s.processing, { size: formatBytes(item.file.size, locale) });
    } else {
      const r = item.result;
      meta.textContent = t(s.done, {
        src,
        width: r.width,
        height: r.height,
        before: formatBytes(item.file.size, locale),
        after: formatBytes(r.blob.size, locale),
      });
    }
    const btn = el('button', 'btn small', s.download);
    btn.type = 'button';
    btn.disabled = !item.result;
    btn.addEventListener('click', () => item.result && downloadBlob(item.result.blob, item.result.filename));
    row.append(thumb, info, btn);
  }

  function updateActions() {
    actions.hidden = items.length === 0;
    $<HTMLButtonElement>('#rs-all', root).disabled = !items.some((i) => i.result);
  }

  function releaseResult(item: Item) {
    if (item.result) URL.revokeObjectURL(item.result.url);
    item.result = undefined;
    item.error = undefined;
    item.waiting = false;
  }

  async function processAll(targets: Item[]) {
    const gen = generation;
    const prefs = readPrefs();
    for (const item of targets) {
      if (gen !== generation) return;
      try {
        const result = await resize(item, prefs);
        if (gen !== generation || !items.includes(item)) {
          if (result) URL.revokeObjectURL(result.url);
          return;
        }
        item.result = result ?? undefined;
        item.waiting = result === null;
      } catch (err) {
        item.error = err instanceof RangeError ? s.tooLarge : s.error;
      }
      drawRow(item);
      updateActions();
      if (item === items[0]) syncControls(readPrefs());
    }
  }

  function reprocess() {
    const prefs = readPrefs();
    savePref('image-resizer', prefs);
    syncControls(prefs);
    if (items.length === 0) return;
    generation++;
    for (const item of items) {
      releaseResult(item);
      drawRow(item);
    }
    updateActions();
    void processAll(items);
  }

  function addFiles(files: Iterable<File>) {
    const accepted: Item[] = [];
    for (const file of files) {
      if (!file.type.startsWith('image/')) continue;
      const item: Item = { file, row: el('li', 'rs-item') };
      drawRow(item);
      list.append(item.row);
      accepted.push(item);
    }
    items.push(...accepted);
    updateActions();
    void processAll(accepted);
  }

  function clearAll() {
    generation++;
    for (const item of items) releaseResult(item);
    items = [];
    list.replaceChildren();
    updateActions();
    syncControls(readPrefs());
  }

  // ---------- Input wiring ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) addFiles(Array.from(e.dataTransfer.files));
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const files = Array.from(e.clipboardData?.files ?? []).filter((f) => f.type.startsWith('image/'));
    if (files.length === 0) return;
    e.preventDefault();
    const stamp = Date.now();
    addFiles(files.map((f, i) => new File([f], f.name && f.name !== 'image.png' ? f.name : `paste-${stamp}-${i + 1}.png`, { type: f.type })));
  });

  const reprocessSoon = debounce(reprocess, 400);
  for (const input of [widthIn, heightIn, pct, pad]) input.addEventListener('input', reprocessSoon);
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    reprocessSoon();
  });
  for (const input of [lock, padClear, ...modeRadios, ...fitRadios, ...formatRadios]) input.addEventListener('change', reprocess);

  $$<HTMLButtonElement>('[data-w]', root).forEach((btn) =>
    btn.addEventListener('click', () => {
      widthIn.value = btn.dataset.w!;
      heightIn.value = btn.dataset.h!;
      lock.checked = false;
      reprocess();
    }),
  );
  $$<HTMLButtonElement>('[data-pct]', root).forEach((btn) =>
    btn.addEventListener('click', () => {
      pct.value = btn.dataset.pct!;
      reprocess();
    }),
  );

  $('#rs-all', root).addEventListener('click', async () => {
    for (const item of items) {
      if (!item.result) continue;
      downloadBlob(item.result.blob, item.result.filename);
      await new Promise((r) => setTimeout(r, 350));
    }
  });
  $('#rs-clear', root).addEventListener('click', clearAll);

  applyPrefs({
    mode: 'size',
    width: '1920',
    height: '',
    lock: true,
    fit: 'cover',
    percent: '50',
    format: 'keep',
    quality: 90,
    pad: '#ffffff',
    padClear: false,
    ...loadPref<Partial<Prefs>>('image-resizer', {}),
  });
  syncControls(readPrefs());
  void canEncode('image/webp').then((ok) => {
    if (ok) return;
    const webp = formatRadios.find((r) => r.value === 'webp')!;
    webp.disabled = true;
    if (webp.checked) formatRadios[0].checked = true;
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .rs-panel {
    display: grid;
    gap: 14px;
  }
  .rs-dims {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 10px;
    max-width: 420px;
  }
  .rs-times {
    padding-bottom: 10px;
    color: var(--muted);
  }
  .rs-pct {
    max-width: 120px;
  }
  .rs-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rs-list:empty {
    display: none;
  }
  .rs-list :global(.rs-item) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .rs-list :global(.rs-thumb) {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .rs-list :global(.rs-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .rs-list :global(.rs-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .rs-list :global(.rs-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rs-list :global(.rs-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .rs-list :global(.rs-error) {
    color: var(--danger);
  }
  @media (max-width: 420px) {
    .rs-list :global(.rs-item) {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .rs-list :global(.rs-thumb) {
      width: 48px;
      height: 48px;
    }
    .rs-list :global(.rs-item .btn) {
      grid-column: 1 / -1;
    }
  }
</style>
