<div class="tool" data-tool="severance-pay">
  <div class="grid-2">
    <div class="field">
      <label for="sp-start">到職日</label>
      <input id="sp-start" type="date" value="2019-03-01" />
    </div>
    <div class="field">
      <label for="sp-end">最後工作日</label>
      <input id="sp-end" type="date" value="2026-10-31" />
      <span class="hint">勞動契約終止前的最後一天，年資計算含當日。</span>
    </div>
  </div>

  <div class="sp-legacy" id="sp-legacy" hidden>
    <div class="field">
      <span class="label">2005 年 7 月前到職：退休金制度</span>
      <div class="seg" role="radiogroup" aria-label="退休金制度">
        <label><input type="radio" name="sp-scheme" value="mixed" checked /><span>改選新制，保留舊制年資</span></label>
        <label><input type="radio" name="sp-scheme" value="old" /><span>一直適用舊制</span></label>
        <label><input type="radio" name="sp-scheme" value="settled" /><span>改選新制，舊制已結清</span></label>
      </div>
    </div>
    <div class="field" id="sp-switch-field">
      <label for="sp-switch">改選新制日期</label>
      <input id="sp-switch" type="date" value="2005-07-01" min="2005-07-01" max="2010-06-30" />
      <span class="hint">多數人在 2005-07-01 新制施行當天改選，可對照勞保局個人專戶資料。</span>
    </div>
  </div>

  <div class="field">
    <span class="label">離職原因</span>
    <div class="seg" role="radiogroup" aria-label="離職原因">
      <label><input type="radio" name="sp-reason" value="employer" checked /><span>公司資遣（歇業、虧損、業務緊縮等）</span></label>
      <label><input type="radio" name="sp-reason" value="worker14" /><span>公司違法，我依第 14 條離職</span></label>
    </div>
  </div>

  <div class="field">
    <span class="label">平均工資</span>
    <div class="seg" role="radiogroup" aria-label="平均工資輸入方式">
      <label><input type="radio" name="sp-avgmode" value="single" checked /><span>直接輸入</span></label>
      <label><input type="radio" name="sp-avgmode" value="six" /><span>輸入最近 6 個月工資</span></label>
    </div>
  </div>

  <div class="field" id="sp-avg-field">
    <label for="sp-avg">月平均工資（元）</label>
    <input id="sp-avg" type="text" inputmode="numeric" autocomplete="off" value="40000" />
    <span class="hint">離職前 6 個月工資總額 ÷ 6，含加班費、津貼、全勤等經常性給與；年終獎金、三節獎金不算。</span>
  </div>

  <div class="field" id="sp-six-field" hidden>
    <span class="label">離職前 6 個月每月工資（元，由近到遠）</span>
    <div class="grid-3 sp-six">
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 1 個月工資" value="40000" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 2 個月工資" value="40000" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 3 個月工資" value="40000" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 4 個月工資" value="40000" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 5 個月工資" value="40000" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 6 個月工資" value="40000" />
    </div>
    <span class="hint" id="sp-six-sum">合計 — 元，平均 — 元</span>
  </div>

  <div class="grid-2" id="sp-notice-fields">
    <div class="field">
      <label for="sp-last">最近一個月正常工時工資（元，留空 = 平均工資）</label>
      <input id="sp-last" type="text" inputmode="numeric" autocomplete="off" placeholder="同平均工資" />
      <span class="hint">用來計算預告工資，不含加班費。</span>
    </div>
    <div class="field">
      <label for="sp-given">公司已提前預告幾天</label>
      <input id="sp-given" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">從通知隔天算到最後工作日的日曆天數。</span>
    </div>
  </div>

  <div class="notice error" id="sp-error" hidden></div>

  <div id="sp-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="sp-total">—</div>
      <div class="result-label" id="sp-total-label">資遣費合計</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sp-sev">—</span><span class="stat-label">資遣費</span></div>
      <div class="stat"><span class="stat-value" id="sp-notice">—</span><span class="stat-label" id="sp-notice-label">預告工資</span></div>
      <div class="stat"><span class="stat-value" id="sp-service">—</span><span class="stat-label">總年資</span></div>
      <div class="stat"><span class="stat-value" id="sp-months">—</span><span class="stat-label">資遣費基數</span></div>
    </div>

    <p class="notice" id="sp-note" hidden></p>

    <div class="field">
      <span class="label">資遣費計算明細</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>制度</th><th>期間</th><th>年資</th><th class="num">基數（月）</th><th class="num">金額</th></tr>
          </thead>
          <tbody id="sp-table"></tbody>
        </table>
      </div>
      <span class="hint" id="sp-formula"></span>
    </div>

    <div class="field" id="sp-notice-box">
      <span class="label">預告期間與謀職假</span>
      <div class="table-wrap">
        <table class="table">
          <tbody id="sp-notice-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">依勞工退休金條例第 12 條（新制：每滿 1 年 0.5 個月，上限 6 個月）、勞動基準法第 17 條（舊制：每滿 1 年 1 個月）與第 16 條（預告期間）計算，畸零年資算法依勞動部公告範例。資遣費應於終止契約後 30 日內發給。結果僅供參考，實際金額以勞資雙方確認或主管機關認定為準。所有計算在你的瀏覽器內完成，資料不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    averageFromSix,
    calculateSeverance,
    formatService,
    NEW_SYSTEM_START,
    parseISODate,
    toISO,
    validateSeverance,
    type Reason,
    type Scheme,
    type SeveranceInput,
  } from './logic';

  interface Prefs {
    start: string;
    end: string;
    scheme: string;
    switch: string;
    reason: string;
    avgmode: string;
    avg: string;
    six: string[];
    last: string;
    given: string;
  }

  const root = $('[data-tool="severance-pay"]');
  const start = $<HTMLInputElement>('#sp-start', root);
  const end = $<HTMLInputElement>('#sp-end', root);
  const schemes = $$<HTMLInputElement>('input[name="sp-scheme"]', root);
  const switchDate = $<HTMLInputElement>('#sp-switch', root);
  const reasons = $$<HTMLInputElement>('input[name="sp-reason"]', root);
  const avgModes = $$<HTMLInputElement>('input[name="sp-avgmode"]', root);
  const avg = $<HTMLInputElement>('#sp-avg', root);
  const six = $$<HTMLInputElement>('.sp-six input', root);
  const last = $<HTMLInputElement>('#sp-last', root);
  const given = $<HTMLInputElement>('#sp-given', root);
  const error = $('#sp-error', root);
  const output = $('#sp-output', root);
  const note = $('#sp-note', root);
  const table = $('#sp-table', root);
  const noticeTable = $('#sp-notice-table', root);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const checked = (list: HTMLInputElement[], fallback: string) => list.find((r) => r.checked)?.value ?? fallback;
  const dateText = (iso: string) => iso.replaceAll('-', '/');

  const prefs = loadPref<Partial<Prefs>>('severance-pay', {});
  if (prefs.start) start.value = prefs.start;
  if (prefs.end) end.value = prefs.end;
  else {
    const now = new Date();
    end.value = toISO({ y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() });
  }
  if (prefs.scheme) for (const s of schemes) s.checked = s.value === prefs.scheme;
  if (prefs.switch) switchDate.value = prefs.switch;
  if (prefs.reason) for (const r of reasons) r.checked = r.value === prefs.reason;
  if (prefs.avgmode) for (const m of avgModes) m.checked = m.value === prefs.avgmode;
  if (prefs.avg !== undefined) avg.value = prefs.avg;
  if (Array.isArray(prefs.six)) prefs.six.forEach((v, i) => six[i] && (six[i].value = v));
  if (prefs.last !== undefined) last.value = prefs.last;
  if (prefs.given !== undefined) given.value = prefs.given;

  function cell(text: string, numeric = false): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    if (numeric) td.className = 'num';
    return td;
  }

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const scheme = checked(schemes, 'mixed') as Scheme;
    const reason = checked(reasons, 'employer') as Reason;
    const avgMode = checked(avgModes, 'single');

    savePref('severance-pay', {
      start: start.value,
      end: end.value,
      scheme,
      switch: switchDate.value,
      reason,
      avgmode: avgMode,
      avg: avg.value,
      six: six.map((i) => i.value),
      last: last.value,
      given: given.value,
    } satisfies Prefs);

    $('#sp-avg-field', root).hidden = avgMode !== 'single';
    $('#sp-six-field', root).hidden = avgMode !== 'six';
    $('#sp-notice-fields', root).hidden = reason !== 'employer';

    const s = parseISODate(start.value);
    const e = parseISODate(end.value);
    const legacy = !!s && (s.y < NEW_SYSTEM_START.y || (s.y === NEW_SYSTEM_START.y && s.m < NEW_SYSTEM_START.m));
    $('#sp-legacy', root).hidden = !legacy;
    $('#sp-switch-field', root).hidden = scheme === 'old';
    if (!s || !e) return fail('請選擇到職日與最後工作日。');

    let averageWage: number;
    if (avgMode === 'six') {
      const wages = six.map((i) => (i.value.trim() === '' ? 0 : parseNumber(i.value)));
      if (!wages.every((w) => Number.isFinite(w) && w >= 0)) return fail('6 個月工資請輸入 0 或正數。');
      averageWage = averageFromSix(wages);
      set('#sp-six-sum', `合計 ${formatInteger(wages.reduce((a, b) => a + b, 0))} 元，月平均工資 ${formatNumber(averageWage, 2)} 元`);
    } else {
      averageWage = parseNumber(avg.value);
    }

    const sw = parseISODate(switchDate.value) ?? NEW_SYSTEM_START;
    const lastWage = last.value.trim() === '' ? averageWage : parseNumber(last.value);
    const input: SeveranceInput = {
      start: s,
      end: e,
      scheme,
      switchDate: sw,
      averageWage,
      lastMonthWage: lastWage,
      reason,
      noticeGivenDays: reason === 'employer' && given.value.trim() !== '' ? parseNumber(given.value) : 0,
    };
    const problem = validateSeverance(input);
    const r = problem ? null : calculateSeverance(input);
    if (!r) return fail(problem ?? '無法計算，請檢查輸入。');
    error.hidden = true;
    output.hidden = false;

    set('#sp-total', money(r.total));
    set('#sp-total-label', reason === 'employer' ? '資遣費＋預告工資合計' : '可請求的資遣費');
    set('#sp-sev', money(r.severance));
    set('#sp-notice', reason === 'employer' ? money(r.noticePay) : '不適用');
    set('#sp-notice-label', reason === 'employer' ? `預告工資（${r.noticeOwed} 日）` : '預告工資');
    set('#sp-service', formatService(r.totalService));
    set('#sp-months', `${formatNumber(r.totalMonths, 3)} 個月`);

    table.replaceChildren(
      ...r.segments.map((seg) => {
        const tr = document.createElement('tr');
        tr.append(
          cell(seg.system === 'old' ? '舊制（勞基法）' : '新制（勞退條例）'),
          cell(`${dateText(toISO(seg.from))} – ${dateText(toISO(seg.to))}`),
          cell(formatService(seg.service)),
          cell(`${formatNumber(seg.baseMonths, 4)}${seg.capped ? '（上限）' : ''}`, true),
          cell(money(seg.amount), true),
        );
        return tr;
      }),
    );

    const formulas = r.segments.map((seg) => {
      const { years, months, days } = seg.service;
      if (seg.system === 'old') {
        const m = months + (days > 0 ? 1 : 0);
        return `舊制：${formatInteger(averageWage)} ×［${years} + ${m} ÷ 12］${days > 0 ? '（未滿 1 個月的天數以 1 個月計）' : ''}`;
      }
      return `新制：${formatInteger(averageWage)} × 1/2 ×［${years} +（${months} + ${Math.min(days, 30)} ÷ 30）÷ 12］${seg.capped ? '，超過 6 個月以 6 個月計' : ''}`;
    });
    set('#sp-formula', formulas.join('；'));

    const notes: string[] = [];
    if (r.segments.some((seg) => seg.capped)) notes.push('新制年資滿 12 年，資遣費已達 6 個月平均工資上限。');
    if (reason === 'worker14') {
      notes.push('依勞基法第 14 條終止契約，勞工可請求資遣費，但不適用預告期間與預告工資；需在知悉違法情形 30 日內終止契約。');
    }
    notes.push('離職時記得請公司開立「非自願離職證明書」，可用來申請失業給付。');
    note.textContent = notes.join(' ');
    note.hidden = false;

    $('#sp-notice-box', root).hidden = reason !== 'employer';
    if (reason === 'employer') {
      const rows: [string, string][] = [
        ['依年資應預告', r.noticeRequired === 0 ? '未滿 3 個月，免預告' : `${r.noticeRequired} 日`],
        ['公司已預告', `${input.noticeGivenDays} 日`],
        ['未預告日數', `${r.noticeOwed} 日`],
        ['一日工資', `${formatNumber(r.dailyWage, 2)} 元`],
        ['預告工資', money(r.noticePay)],
        [
          '謀職假',
          r.noticeRequired === 0 ? '不適用' : '預告期間每週可請最多 2 日工作時間找工作，工資照給',
        ],
      ];
      noticeTable.replaceChildren(
        ...rows.map(([k, v]) => {
          const tr = document.createElement('tr');
          tr.append(cell(k), cell(v, true));
          return tr;
        }),
      );
    }
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #sp-output {
    display: grid;
    gap: 16px;
  }
  #sp-output[hidden] {
    display: none;
  }
  .sp-legacy {
    display: grid;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .sp-legacy[hidden] {
    display: none;
  }
  .sp-six {
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) {
    .sp-six {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  #sp-notice-table :global(td:last-child) {
    white-space: normal;
  }
</style>
