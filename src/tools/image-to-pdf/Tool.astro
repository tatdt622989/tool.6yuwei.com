---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const paper = s.client.defaultSize;
---

<div class="tool" data-tool="image-to-pdf" {...i18nAttrs(locale, s.client)}>
  <p class="ip-privacy">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    <span><strong>{s.privacyStrong}</strong>{s.privacyText}</span>
  </p>

  <label class="dropzone" id="ip-drop" tabindex="0">
    <input type="file" id="ip-file" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif,image/heic,image/heif,.heic,.heif" multiple hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="grid-3">
    <div class="field">
      <span class="label">{s.sizeLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.sizeLabel}>
        <label><input type="radio" name="ip-size" value="a4" checked={paper === 'a4'} /><span>A4</span></label>
        <label><input type="radio" name="ip-size" value="letter" checked={paper === 'letter'} /><span>Letter</span></label>
        <label><input type="radio" name="ip-size" value="fit" /><span>{s.sizeFit}</span></label>
      </div>
    </div>
    <div class="field" id="ip-orient-field">
      <span class="label">{s.orientLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.orientAria}>
        <label><input type="radio" name="ip-orient" value="auto" checked /><span>{s.orientAuto}</span></label>
        <label><input type="radio" name="ip-orient" value="portrait" /><span>{s.orientPortrait}</span></label>
        <label><input type="radio" name="ip-orient" value="landscape" /><span>{s.orientLandscape}</span></label>
      </div>
    </div>
    <div class="field">
      <span class="label">{s.marginLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.marginLabel}>
        <label><input type="radio" name="ip-margin" value="none" /><span>{s.marginNone}</span></label>
        <label><input type="radio" name="ip-margin" value="small" checked /><span>{s.marginSmall}</span></label>
        <label><input type="radio" name="ip-margin" value="large" /><span>{s.marginLarge}</span></label>
      </div>
    </div>
  </div>
  <p class="hint" id="ip-layout-hint"></p>

  <p class="notice error" id="ip-note" hidden></p>

  <ol class="ip-list" id="ip-list" aria-label={s.listAria}></ol>
  <p class="hint" id="ip-order-hint" hidden>{s.orderHint}</p>

  <div class="stats" id="ip-summary" hidden>
    <div class="stat"><span class="stat-value" id="ip-count">0</span><span class="stat-label">{s.statCount}</span></div>
    <div class="stat"><span class="stat-value" id="ip-bytes">0 B</span><span class="stat-label">{s.statBytes}</span></div>
  </div>

  <div class="field" id="ip-name-field" hidden>
    <label for="ip-name">{s.nameLabel}</label>
    <input id="ip-name" type="text" value={s.nameDefault} autocomplete="off" spellcheck="false" />
  </div>

  <div class="row" id="ip-actions" hidden>
    <button class="btn primary" type="button" id="ip-make" disabled>{s.make}</button>
    <button class="btn ghost" type="button" id="ip-clear">{s.clear}</button>
  </div>

  <p class="notice ok" id="ip-done" hidden aria-live="polite"></p>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { isHeic, prepareImage } from '../../lib/heic';
  import { formatBytes, formatInteger, plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import { moveItem, safeFilename } from '../pdf-merge/logic';
  import { ICONS, makeSortable } from '../pdf-merge/sortable';
  import {
    defaultLayout,
    isImageFile,
    isPureRotation,
    jpegOrientation,
    layoutPage,
    sniffImage,
    type LayoutOptions,
    type MarginId,
    type Orientation,
    type PageSizeId,
  } from './logic';

  interface Item {
    id: number;
    file: File;
    url: string;
    width?: number;
    height?: number;
    error?: string;
    row: HTMLLIElement;
  }

  const root = $('[data-tool="image-to-pdf"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const defaults = defaultLayout(s.defaultSize);
  const drop = $('#ip-drop', root);
  const fileInput = $<HTMLInputElement>('#ip-file', root);
  const sizeRadios = $$<HTMLInputElement>('input[name="ip-size"]', root);
  const orientRadios = $$<HTMLInputElement>('input[name="ip-orient"]', root);
  const marginRadios = $$<HTMLInputElement>('input[name="ip-margin"]', root);
  const orientField = $('#ip-orient-field', root);
  const note = $('#ip-note', root);
  const list = $('#ip-list', root);
  const makeBtn = $<HTMLButtonElement>('#ip-make', root);
  const done = $('#ip-done', root);
  const nameInput = $<HTMLInputElement>('#ip-name', root);

  let items: Item[] = [];
  let nextId = 1;
  let busy = false;

  const checked = (radios: HTMLInputElement[], fallback: string) => radios.find((r) => r.checked)?.value ?? fallback;

  function options(): LayoutOptions {
    return {
      size: checked(sizeRadios, defaults.size) as PageSizeId,
      orientation: checked(orientRadios, 'auto') as Orientation,
      margin: checked(marginRadios, 'small') as MarginId,
    };
  }

  function applyOptions(o: LayoutOptions) {
    for (const r of sizeRadios) r.checked = r.value === o.size;
    for (const r of orientRadios) r.checked = r.value === o.orientation;
    for (const r of marginRadios) r.checked = r.value === o.margin;
    for (const group of [sizeRadios, orientRadios, marginRadios]) if (!group.some((r) => r.checked)) group[0].checked = true;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function iconButton(icon: string, label: string, action: string): HTMLButtonElement {
    const b = el('button', 'ip-icon');
    b.type = 'button';
    b.innerHTML = icon;
    b.setAttribute('aria-label', label);
    b.title = label;
    b.dataset.action = action;
    return b;
  }

  /** Miniature of the page with the image where it will really be placed. */
  function pagePreview(item: Item): HTMLElement {
    const frame = el('div', 'ip-thumb');
    if (!item.width || !item.height) return frame;
    const layout = layoutPage(item.width, item.height, options());
    const max = 52;
    const s = max / Math.max(layout.pageWidth, layout.pageHeight);
    const page = el('div', 'ip-page');
    page.style.width = `${layout.pageWidth * s}px`;
    page.style.height = `${layout.pageHeight * s}px`;
    const img = el('img');
    img.src = item.url;
    img.alt = '';
    img.style.left = `${layout.box.x * s}px`;
    // PDF y runs upward; CSS top runs downward.
    img.style.top = `${(layout.pageHeight - layout.box.y - layout.box.height) * s}px`;
    img.style.width = `${layout.box.width * s}px`;
    img.style.height = `${layout.box.height * s}px`;
    page.append(img);
    frame.append(page);
    return frame;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    row.classList.toggle('has-error', Boolean(item.error));
    const grip = el('span', 'ip-grip');
    grip.innerHTML = ICONS.grip;
    grip.title = s.grip;
    const info = el('div', 'ip-info');
    const meta = el('div', 'ip-meta');
    if (item.error) meta.append(el('span', 'ip-error', item.error));
    else if (!item.width) meta.textContent = t(s.reading, { size: formatBytes(item.file.size, locale) });
    else meta.textContent = t(s.meta, { dims: `${item.width} × ${item.height}`, size: formatBytes(item.file.size, locale) });
    info.append(el('div', 'ip-name', item.file.name), meta);
    const controls = el('div', 'ip-controls');
    controls.append(
      iconButton(ICONS.up, t(s.moveUp, { name: item.file.name }), 'up'),
      iconButton(ICONS.down, t(s.moveDown, { name: item.file.name }), 'down'),
      iconButton(ICONS.remove, t(s.remove, { name: item.file.name }), 'remove'),
    );
    row.append(grip, pagePreview(item), info, controls);
  }

  function refresh() {
    list.replaceChildren(...items.map((i) => i.row));
    items.forEach((item, index) => {
      const up = item.row.querySelector<HTMLButtonElement>('[data-action="up"]');
      const down = item.row.querySelector<HTMLButtonElement>('[data-action="down"]');
      if (up) up.disabled = index === 0;
      if (down) down.disabled = index === items.length - 1;
    });
    const usable = items.filter((i) => !i.error);
    const any = items.length > 0;
    $('#ip-summary', root).hidden = !any;
    $('#ip-name-field', root).hidden = !any;
    $('#ip-actions', root).hidden = !any;
    $('#ip-order-hint', root).hidden = items.length < 2;
    $('#ip-count', root).textContent = formatInteger(usable.length, locale);
    $('#ip-bytes', root).textContent = formatBytes(usable.reduce((sum, i) => sum + i.file.size, 0), locale);
    makeBtn.disabled = busy || usable.length === 0 || usable.some((i) => !i.width);
  }

  function updateLayoutHint() {
    const o = options();
    orientField.hidden = o.size === 'fit';
    $('#ip-layout-hint', root).textContent =
      o.size === 'fit'
        ? s.layoutFit
        : t(s.layoutPaper, {
            paper: o.size === 'a4' ? s.paperA4 : s.paperLetter,
            auto: o.orientation === 'auto' ? s.autoNote : '',
          }).trim();
  }

  function onOptions() {
    savePref('image-to-pdf', options());
    updateLayoutHint();
    done.hidden = true;
    for (const item of items) drawRow(item);
    refresh();
  }

  function showNote(text: string) {
    note.textContent = text;
    note.hidden = !text;
  }

  async function measure(item: Item) {
    try {
      const img = new Image();
      img.src = item.url;
      await img.decode();
      // Browsers apply EXIF orientation when displaying, so this is the upright size.
      item.width = img.naturalWidth;
      item.height = img.naturalHeight;
    } catch {
      item.error = s.unreadable;
    }
  }

  async function addFiles(files: File[]) {
    const picked = files.filter((f) => isImageFile(f.type, f.name) || isHeic(f.type, f.name));
    const skipped = files.length - picked.length;
    showNote(skipped ? plural(locale, skipped, s.skippedOther) : '');
    done.hidden = true;
    // A failed HEIC conversion keeps the original file, which then shows as unreadable.
    const images = await Promise.all(picked.map((f) => prepareImage(f).catch(() => f)));
    const added = images.map((file) => ({ id: nextId++, file, url: URL.createObjectURL(file), row: el('li', 'ip-item') }) as Item);
    for (const item of added) drawRow(item);
    items.push(...added);
    refresh();
    for (const item of added) {
      await measure(item);
      if (!items.includes(item)) continue;
      drawRow(item);
      refresh();
    }
  }

  // ---------- Encoding ----------
  function canvasToJpeg(source: CanvasImageSource, width: number, height: number): Promise<Uint8Array> {
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('canvas');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, width, height);
    ctx.drawImage(source, 0, 0, width, height);
    return new Promise((resolve, reject) =>
      canvas.toBlob(
        (b) => (b ? b.arrayBuffer().then((buf) => resolve(new Uint8Array(buf)), reject) : reject(new Error('encode'))),
        'image/jpeg',
        0.92,
      ),
    );
  }

  /**
   * JPEG and PNG go into the PDF untouched. JPEGs with a mirrored EXIF
   * orientation and other formats (WebP, GIF, BMP…) are redrawn upright and
   * encoded as high-quality JPEG first.
   */
  async function prepare(item: Item): Promise<{ bytes: Uint8Array; orientation?: number }> {
    const bytes = new Uint8Array(await item.file.arrayBuffer());
    const kind = sniffImage(bytes);
    if (kind === 'png') return { bytes };
    if (kind === 'jpeg') {
      const orientation = jpegOrientation(bytes);
      if (isPureRotation(orientation)) return { bytes, orientation };
    }
    const img = new Image();
    img.src = item.url;
    await img.decode();
    return { bytes: await canvasToJpeg(img, img.naturalWidth, img.naturalHeight) };
  }

  makeBtn.addEventListener('click', async () => {
    const usable = items.filter((i) => !i.error);
    if (!usable.length || busy) return;
    busy = true;
    makeBtn.disabled = true;
    done.hidden = true;
    makeBtn.textContent = s.making;
    try {
      const prepared = [];
      for (const item of usable) prepared.push(await prepare(item));
      const { imagesToPdf } = await import('./build');
      const filename = safeFilename(nameInput.value, s.nameFallback);
      const bytes = await imagesToPdf(prepared, options(), filename.replace(/\.pdf$/i, ''), (n, total) => {
        makeBtn.textContent = t(s.makingProgress, { n, total });
      });
      const blob = new Blob([bytes as Uint8Array<ArrayBuffer>], { type: 'application/pdf' });
      downloadBlob(blob, filename);
      done.textContent = plural(locale, usable.length, s.done, { size: formatBytes(blob.size, locale), name: filename });
      done.hidden = false;
    } catch {
      showNote(s.failed);
    } finally {
      busy = false;
      makeBtn.textContent = s.make;
      refresh();
    }
  });

  // ---------- List interactions ----------
  function move(from: number, to: number, focusAction?: string) {
    if (to < 0 || to >= items.length || from === to) return;
    items = moveItem(items, from, to);
    done.hidden = true;
    refresh();
    if (focusAction) {
      const target = items[to].row.querySelector<HTMLButtonElement>(`[data-action="${focusAction}"]`);
      (target && !target.disabled ? target : items[to].row.querySelector<HTMLButtonElement>('[data-action="remove"]'))?.focus();
    }
  }

  list.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('button[data-action]');
    if (!button) return;
    const index = items.findIndex((i) => i.row === button.closest('li'));
    if (index < 0) return;
    const action = button.dataset.action;
    if (action === 'up') move(index, index - 1, 'up');
    else if (action === 'down') move(index, index + 1, 'down');
    else if (action === 'remove') {
      URL.revokeObjectURL(items[index].url);
      items.splice(index, 1);
      done.hidden = true;
      refresh();
      items[Math.min(index, items.length - 1)]?.row.querySelector<HTMLButtonElement>('[data-action="remove"]')?.focus();
    }
  });
  makeSortable({ list, handle: '.ip-grip', onMove: (from, to) => move(from, to) });

  $('#ip-clear', root).addEventListener('click', () => {
    for (const item of items) URL.revokeObjectURL(item.url);
    items = [];
    showNote('');
    done.hidden = true;
    refresh();
  });

  [...sizeRadios, ...orientRadios, ...marginRadios].forEach((r) => r.addEventListener('change', onOptions));

  // ---------- File input wiring (same UX as the image tools) ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) void addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) void addFiles(Array.from(e.dataTransfer.files));
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const files = Array.from(e.clipboardData?.files ?? []).filter((f) => f.type.startsWith('image/'));
    if (!files.length) return;
    e.preventDefault();
    const stamp = Date.now();
    void addFiles(files.map((f, i) => new File([f], f.name && f.name !== 'image.png' ? f.name : `paste-${stamp}-${i + 1}.png`, { type: f.type })));
  });

  applyOptions(loadPref<LayoutOptions>('image-to-pdf', defaults));
  updateLayoutHint();
  refresh();
</script>

<style>
  .ip-privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--success) 30%, transparent);
    border-radius: var(--radius-sm);
  }
  .ip-privacy svg {
    flex: none;
    margin-top: 1px;
    color: var(--success);
  }
  #ip-layout-hint {
    margin: -6px 0 0;
  }
  .ip-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ip-list:empty {
    display: none;
  }
  .ip-list :global(.ip-item) {
    position: relative;
    display: grid;
    grid-template-columns: auto 60px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 6px 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .ip-list.is-sorting :global(.ip-item) {
    transition: transform 0.15s ease;
  }
  .ip-list :global(.ip-item.is-dragging) {
    z-index: 2;
    transition: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .ip-list :global(.ip-item.has-error) {
    border-color: color-mix(in oklab, var(--danger) 40%, transparent);
  }
  .ip-list :global(.ip-grip) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 44px;
    color: var(--muted);
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .ip-list :global(.ip-thumb) {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
  }
  .ip-list :global(.ip-page) {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border-strong), var(--shadow-sm);
  }
  .ip-list :global(.ip-page img) {
    position: absolute;
    display: block;
    object-fit: fill;
  }
  .ip-list :global(.ip-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .ip-list :global(.ip-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ip-list :global(.ip-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .ip-list :global(.ip-error) {
    color: var(--danger);
  }
  .ip-list :global(.ip-controls) {
    display: flex;
    gap: 2px;
  }
  .ip-list :global(.ip-icon) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: var(--text-2);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
  }
  .ip-list :global(.ip-icon:hover:not(:disabled)) {
    color: var(--text);
    background: var(--surface);
    border-color: var(--border);
  }
  .ip-list :global(.ip-icon:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  @media (max-width: 420px) {
    .ip-list :global(.ip-item) {
      grid-template-columns: auto 52px minmax(0, 1fr);
      row-gap: 4px;
    }
    .ip-list :global(.ip-thumb) {
      width: 52px;
      height: 52px;
    }
    .ip-list :global(.ip-controls) {
      grid-column: 2 / -1;
      justify-content: flex-end;
    }
  }
</style>
