---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { ACTIVITY_LEVELS } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
/** Metric fields carry data-units only when a unit toggle exists; zh markup stays unchanged. */
const metric = s.units ? 'metric' : undefined;
const hideMetric = s.units ? true : undefined;
---

<div class="tool" data-tool="tdee-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <span class="label">{s.sexLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.sexLabel}>
      <label><input type="radio" name="td-sex" value="male" checked /><span>{s.male}</span></label>
      <label><input type="radio" name="td-sex" value="female" /><span>{s.female}</span></label>
    </div>
  </div>{
    s.units && (
      <div class="seg" role="radiogroup" aria-label={s.units.legend}>
        <label>
          <input type="radio" name="td-unit" value="imperial" checked />
          <span>{s.units.imperial}</span>
        </label>
        <label>
          <input type="radio" name="td-unit" value="metric" />
          <span>{s.units.metric}</span>
        </label>
      </div>
    )
  }

  <div class="grid-3">
    <div class="field">
      <label for="td-age">{s.age}</label>
      <input id="td-age" type="text" inputmode="numeric" autocomplete="off" value="30" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="td-height">{s.heightCm}</label>
      <input id="td-height" type="text" inputmode="decimal" autocomplete="off" value="175" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="td-weight">{s.weightKg}</label>
      <input id="td-weight" type="text" inputmode="decimal" autocomplete="off" value="70" />
    </div>{
      s.units && (
        <>
          <div class="td-pair" data-units="imperial">
            <div class="field">
              <label for="td-ft">{s.units.heightFt}</label>
              <input id="td-ft" type="text" inputmode="decimal" autocomplete="off" value="5" />
            </div>
            <div class="field">
              <label for="td-in">{s.units.heightIn}</label>
              <input id="td-in" type="text" inputmode="decimal" autocomplete="off" value="9" />
            </div>
          </div>
          <div class="field" data-units="imperial">
            <label for="td-lb">{s.units.weightLb}</label>
            <input id="td-lb" type="text" inputmode="decimal" autocomplete="off" value="160" />
          </div>
        </>
      )
    }
  </div>

  <div class="field">
    <label for="td-activity">{s.activityLabel}</label>
    <select id="td-activity">
      {
        ACTIVITY_LEVELS.map((a) => (
          <option value={a.id} selected={a.id === 'moderate'}>
            {t(s.activityOption, { label: s.activities[a.id].label, hint: s.activities[a.id].hint, factor: String(a.factor) })}
          </option>
        ))
      }
    </select>
  </div>

  <div class="notice error" id="td-error" hidden></div>

  <div id="td-output">
    <div class="result" aria-live="polite">
      <div class="result-value"><span id="td-tdee">—</span> <span class="td-unit">{s.unitPerDay}</span></div>
      <div class="result-label">{s.resultLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="td-bmr">—</span><span class="stat-label">{s.bmrLabel}</span></div>
      <div class="stat"><span class="stat-value" id="td-bmr-hb">—</span><span class="stat-label">{s.altLabels[0]}</span></div>
      <div class="stat"><span class="stat-value" id="td-tdee-hb">—</span><span class="stat-label">{s.altLabels[1]}</span></div>
    </div>

    <div class="field">
      <span class="label">{s.goalsLabel}</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>{s.thGoal}</th>
              <th class="num">{s.thKcal}</th>
              <th class="num">{s.thProtein}</th>
              <th class="num">{s.thFat}</th>
              <th class="num">{s.thCarb}</th>
            </tr>
          </thead>
          <tbody id="td-goals"></tbody>
        </table>
      </div>
      <span class="hint" id="td-goal-hint"></span>
    </div>
  </div>

  <p class="notice">{`\n${s.disclaimer}\n`}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import {
    calcTdee,
    checkBody,
    feetInchesToCm,
    ganpule,
    jpReferenceBmr,
    KG_PER_LB,
    lbToKg,
    TDEE_RULES,
    type ActivityId,
    type BodyInput,
    type Sex,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="tdee-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const sexes = $$<HTMLInputElement>('input[name="td-sex"]', root);
  const unitRadios = $$<HTMLInputElement>('input[name="td-unit"]', root);
  const age = $<HTMLInputElement>('#td-age', root);
  const height = $<HTMLInputElement>('#td-height', root);
  const weight = $<HTMLInputElement>('#td-weight', root);
  const ft = root.querySelector<HTMLInputElement>('#td-ft');
  const inch = root.querySelector<HTMLInputElement>('#td-in');
  const lb = root.querySelector<HTMLInputElement>('#td-lb');
  const activity = $<HTMLSelectElement>('#td-activity', root);
  const error = $('#td-error', root);
  const output = $('#td-output', root);
  const goals = $('#td-goals', root);

  interface Prefs {
    sex: Sex;
    age: string;
    height: string;
    weight: string;
    activity: ActivityId;
    unit?: 'metric' | 'imperial';
    ft?: string;
    inch?: string;
    lb?: string;
  }

  const saved = loadPref<Prefs>('tdee-calculator', { sex: 'male', age: '30', height: '175', weight: '70', activity: 'moderate' });
  for (const s of sexes) s.checked = s.value === saved.sex;
  age.value = saved.age;
  height.value = saved.height;
  weight.value = saved.weight;
  activity.value = saved.activity;
  if (!activity.value) activity.value = 'moderate';
  if (ft && inch && lb) {
    ft.value = saved.ft ?? ft.value;
    inch.value = saved.inch ?? inch.value;
    lb.value = saved.lb ?? lb.value;
  }
  const savedUnit = unitRadios.find((r) => r.value === saved.unit);
  if (savedUnit) savedUnit.checked = true;

  const imperial = () => Boolean(ft && inch && lb) && unitRadios.find((r) => r.checked)?.value === 'imperial';
  const kcal = (v: number) => formatInteger(v, locale);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  function showUnits() {
    if (!unitRadios.length) return;
    const active = imperial() ? 'imperial' : 'metric';
    $$<HTMLElement>('[data-units]', root).forEach((el) => (el.hidden = el.dataset.units !== active));
  }

  function render() {
    const sex: Sex = sexes.find((s) => s.checked)?.value === 'female' ? 'female' : 'male';
    const us = imperial();
    const input: BodyInput = {
      sex,
      age: parseNumber(age.value),
      heightCm: us ? feetInchesToCm(parseNumber(ft!.value), parseNumber(inch!.value)) : parseNumber(height.value),
      weightKg: us ? lbToKg(parseNumber(lb!.value)) : parseNumber(weight.value),
    };
    const act = activity.value as ActivityId;
    savePref('tdee-calculator', {
      sex,
      age: age.value,
      height: height.value,
      weight: weight.value,
      activity: act,
      ...(ft && inch && lb ? { unit: us ? 'imperial' : 'metric', ft: ft.value, inch: inch.value, lb: lb.value } : {}),
    } satisfies Prefs);

    const problem = checkBody(input);
    const r = problem ? null : calcTdee(input, act);
    if (!r) {
      error.textContent = problem ? s.problems[problem] : s.fallback;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    set('#td-tdee', kcal(r.tdee));
    set('#td-bmr', t(s.kcal, { n: kcal(r.bmr) }));
    if (s.alt === 'japan') {
      set('#td-bmr-hb', t(s.kcal, { n: kcal(ganpule(input)) }));
      set('#td-tdee-hb', t(s.kcal, { n: kcal(jpReferenceBmr(input)) }));
    } else {
      set('#td-bmr-hb', t(s.kcal, { n: kcal(r.bmrHarris) }));
      set('#td-tdee-hb', t(s.kcal, { n: kcal(r.tdeeHarris) }));
    }

    goals.innerHTML = r.goals
      .map((g) => {
        const delta = Math.round(g.delta);
        const note = delta === 0 ? '' : `<span class="td-delta">${delta > 0 ? '+' : '−'}${formatInteger(Math.abs(delta), locale)}</span>`;
        const perKg = TDEE_RULES.proteinPerKg[g.id];
        const per = us ? `${formatNumber(perKg * KG_PER_LB, 1, locale)} g/lb` : `${formatNumber(perKg, 1, locale)} g/kg`;
        return `<tr><td><strong>${s.goals[g.id] ?? g.label}</strong></td><td class="num">${t(s.kcalCell, { n: kcal(g.kcal) })}${note}</td><td class="num">${formatInteger(g.proteinG, locale)} g<span class="td-sub">${per}</span></td><td class="num">${formatInteger(g.fatG, locale)} g</td><td class="num">${formatInteger(g.carbG, locale)} g</td></tr>`;
      })
      .join('');

    const cut = r.goals[0];
    const floor = t(sex === 'female' ? s.floorFemale : s.floorMale, { n: formatInteger(TDEE_RULES.minIntake[sex], locale) });
    set(
      '#td-goal-hint',
      cut.floored ? t(s.hintFloored, { kcal: kcal(cut.kcal), floor }) : us && s.hintDefaultUs ? s.hintDefaultUs : s.hintDefault,
    );
  }

  [age, height, weight, ft, inch, lb].forEach((el) => el?.addEventListener('input', render));
  activity.addEventListener('change', render);
  sexes.forEach((s) => s.addEventListener('change', render));
  unitRadios.forEach((r) =>
    r.addEventListener('change', () => {
      showUnits();
      render();
    }),
  );
  showUnits();
  render();
</script>
<style>
  #td-output {
    display: grid;
    gap: 16px;
  }
  .td-unit {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
  .td-pair {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .td-pair[hidden] {
    display: none;
  }
  #td-goals :global(.td-delta),
  #td-goals :global(.td-sub) {
    display: block;
    font-size: 12px;
    color: var(--muted);
    font-weight: 400;
  }
</style>
