---
import type { ToolProps } from '../../i18n/tool';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
const OPS = [
  ['+', 'Add'],
  ['-', 'Subtract'],
  ['×', 'Multiply'],
  ['÷', 'Divide'],
] as const;
---

<div class="tool" data-tool="fraction-calculator" data-locale={locale}>
  <div class="fc-line">
    <div class="field">
      <label for="fc-a">First number</label>
      <input id="fc-a" class="fc-input" type="text" autocomplete="off" spellcheck="false" value="1 1/2" />
    </div>
    <div class="seg fc-ops" role="radiogroup" aria-label="Operation">
      {
        OPS.map(([op, label], i) => (
          <label title={label}>
            <input type="radio" name="fc-op" value={op} checked={i === 0} aria-label={label} />
            <span>{op === '-' ? '−' : op}</span>
          </label>
        ))
      }
    </div>
    <div class="field">
      <label for="fc-b">Second number</label>
      <input id="fc-b" class="fc-input" type="text" autocomplete="off" spellcheck="false" value="3/4" />
    </div>
  </div>
  <p class="hint">Fractions (3/4), mixed numbers (1 1/2), whole numbers and decimals (0.75, 0.(3) for repeating) all work.</p>

  <div class="result" aria-live="polite">
    <div class="result-value fc-main" id="fc-main">—</div>
    <div class="result-label" id="fc-main-label">Result</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="fc-frac">—</span><span class="stat-label">Simplified fraction</span></div>
    <div class="stat"><span class="stat-value" id="fc-mixed">—</span><span class="stat-label">Mixed number</span></div>
    <div class="stat"><span class="stat-value" id="fc-dec">—</span><span class="stat-label" id="fc-dec-label">Decimal</span></div>
  </div>

  <div class="notice error" id="fc-error" role="alert" hidden></div>

  <section class="fc-card" aria-labelledby="fc-steps-title">
    <h2 class="fc-card-title" id="fc-steps-title">Step by step</h2>
    <ol class="fc-steps" id="fc-steps"></ol>
  </section>

  <div class="row" id="fc-examples">
    <span class="hint">Examples:</span>
    <button class="btn small" type="button" data-ex="1/2|+|1/3">1/2 + 1/3</button>
    <button class="btn small" type="button" data-ex="3 1/4|-|1 5/8">3 1/4 − 1 5/8</button>
    <button class="btn small" type="button" data-ex="2/3|×|9/10">2/3 × 9/10</button>
    <button class="btn small" type="button" data-ex="2 1/2|÷|1/4">2 1/2 ÷ 1/4</button>
  </div>

  <section class="fc-card" aria-labelledby="fc-conv-title">
    <h2 class="fc-card-title" id="fc-conv-title">Decimal to fraction and fraction to decimal</h2>
    <div class="grid-2">
      <div class="field">
        <label for="fc-d2f">Decimal</label>
        <input id="fc-d2f" class="fc-input" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value="0.375" />
        <p class="fc-conv-out"><strong id="fc-d2f-out">—</strong></p>
        <p class="hint" id="fc-d2f-steps"></p>
      </div>
      <div class="field">
        <label for="fc-f2d">Fraction or mixed number</label>
        <input id="fc-f2d" class="fc-input" type="text" autocomplete="off" spellcheck="false" value="5/6" />
        <p class="fc-conv-out"><strong id="fc-f2d-out">—</strong></p>
        <p class="hint" id="fc-f2d-detail"></p>
      </div>
    </div>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import {
    approxDecimal,
    calculate,
    decimalToFractionSteps,
    formatDecimal,
    formatFraction,
    formatMixed,
    parseFraction,
    toDecimal,
    toMixed,
    type Fraction,
    type Operator,
  } from './logic';

  const root = $('[data-tool="fraction-calculator"]');
  const a = $<HTMLInputElement>('#fc-a', root);
  const b = $<HTMLInputElement>('#fc-b', root);
  const ops = $$<HTMLInputElement>('input[name="fc-op"]', root);
  const main = $('#fc-main', root);
  const mainLabel = $('#fc-main-label', root);
  const fracEl = $('#fc-frac', root);
  const mixedEl = $('#fc-mixed', root);
  const decEl = $('#fc-dec', root);
  const decLabel = $('#fc-dec-label', root);
  const error = $('#fc-error', root);
  const steps = $('#fc-steps', root);
  const d2f = $<HTMLInputElement>('#fc-d2f', root);
  const d2fOut = $('#fc-d2f-out', root);
  const d2fSteps = $('#fc-d2f-steps', root);
  const f2d = $<HTMLInputElement>('#fc-f2d', root);
  const f2dOut = $('#fc-f2d-out', root);
  const f2dDetail = $('#fc-f2d-detail', root);

  interface Prefs {
    a: string;
    b: string;
    op: Operator;
    d2f: string;
    f2d: string;
  }
  const saved = loadPref<Partial<Prefs>>('fraction-calculator', {});
  if (saved.a !== undefined) a.value = saved.a;
  if (saved.b !== undefined) b.value = saved.b;
  if (saved.d2f !== undefined) d2f.value = saved.d2f;
  if (saved.f2d !== undefined) f2d.value = saved.f2d;
  ops.forEach((o) => (o.checked = o.value === (saved.op ?? '+')));
  if (!ops.some((o) => o.checked)) ops[0].checked = true;

  const op = () => (ops.find((o) => o.checked)?.value ?? '+') as Operator;
  const minus = (s: string) => s.replace(/-/g, '−');

  /** Stacked fraction markup for the big result: whole + numerator over denominator. */
  function renderStacked(target: HTMLElement, f: Fraction) {
    const m = toMixed(f);
    const nodes: Node[] = [];
    const text = (t: string, cls?: string) => {
      const span = document.createElement('span');
      if (cls) span.className = cls;
      span.textContent = t;
      return span;
    };
    if (m.negative) nodes.push(text('−', 'fc-sign'));
    if (m.whole !== 0n || m.n === 0n) nodes.push(text(String(m.whole), 'fc-whole'));
    if (m.n !== 0n) {
      const stack = document.createElement('span');
      stack.className = 'fc-stack';
      stack.append(text(String(m.n), 'fc-num'), text(String(m.d), 'fc-den'));
      nodes.push(stack);
    }
    target.replaceChildren(...nodes);
    target.setAttribute('aria-label', formatMixed(f));
  }

  function decimalText(f: Fraction): { text: string; label: string } {
    const e = toDecimal(f, 40);
    if (e.repeat) return { text: `≈ ${approxDecimal(f, 6)}`, label: `Decimal (exactly ${formatDecimal(e)}, digits in parentheses repeat)` };
    if (e.truncated) return { text: `≈ ${approxDecimal(f, 6)}`, label: 'Decimal (rounded)' };
    return { text: formatDecimal(e), label: 'Decimal (exact)' };
  }

  const PARSE_ERRORS = {
    empty: 'is empty.',
    'zero-denominator': 'has a zero denominator, which is undefined.',
    invalid: 'isn’t a number this calculator understands. Try 3/4, 1 1/2, 5 or 0.75.',
    'too-long': 'has too many digits (30 at most).',
  } as const;

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    main.textContent = '—';
    main.removeAttribute('aria-label');
    for (const el of [fracEl, mixedEl, decEl]) el.textContent = '—';
    steps.replaceChildren();
  }

  function render() {
    savePref('fraction-calculator', { a: a.value, b: b.value, op: op(), d2f: d2f.value, f2d: f2d.value } satisfies Prefs);
    const pa = parseFraction(a.value);
    const pb = parseFraction(b.value);
    if (!pa.ok) return fail(`The first number ${PARSE_ERRORS[pa.error]}`);
    if (!pb.ok) return fail(`The second number ${PARSE_ERRORS[pb.error]}`);
    const r = calculate(pa.value, op(), pb.value, [a.value, b.value]);
    if (!r.ok) return fail('You can’t divide by zero. Change the second number.');
    error.hidden = true;
    renderStacked(main, r.value);
    mainLabel.textContent = minus(`${a.value.trim()} ${op()} ${b.value.trim()} =`);
    fracEl.textContent = minus(formatFraction(r.value));
    mixedEl.textContent = minus(formatMixed(r.value));
    const d = decimalText(r.value);
    decEl.textContent = minus(d.text);
    decLabel.textContent = d.label;
    steps.replaceChildren(
      ...r.steps.map((s) => {
        const li = document.createElement('li');
        li.textContent = s;
        return li;
      }),
    );
  }

  function renderD2f() {
    savePref('fraction-calculator', { a: a.value, b: b.value, op: op(), d2f: d2f.value, f2d: f2d.value } satisfies Prefs);
    const r = decimalToFractionSteps(d2f.value);
    if (!r) {
      d2fOut.textContent = '—';
      d2fSteps.textContent = d2f.value.trim() ? 'Enter a decimal such as 0.625, 2.75 or 0.(3).' : '';
      return;
    }
    const mixed = formatMixed(r.value);
    d2fOut.textContent = minus(formatFraction(r.value) + (mixed !== formatFraction(r.value) ? ` = ${mixed}` : ''));
    d2fSteps.textContent = minus(r.steps.join(' '));
  }

  function renderF2d() {
    savePref('fraction-calculator', { a: a.value, b: b.value, op: op(), d2f: d2f.value, f2d: f2d.value } satisfies Prefs);
    const p = parseFraction(f2d.value);
    if (!p.ok) {
      f2dOut.textContent = '—';
      f2dDetail.textContent = f2d.value.trim() ? 'Enter a fraction such as 5/6 or 2 3/8.' : '';
      return;
    }
    const e = toDecimal(p.value, 40);
    f2dOut.textContent = minus(formatDecimal(e));
    const pct = approxDecimal({ n: p.value.n * 100n, d: p.value.d }, 4);
    f2dDetail.textContent = minus(
      `${p.value.n} ÷ ${p.value.d} = ${formatDecimal(e)}${e.repeat ? ` (the digits in parentheses repeat forever, ≈ ${approxDecimal(p.value, 6)})` : ''}. As a percentage: ${e.repeat || e.truncated ? '≈ ' : ''}${pct}%.`,
    );
  }

  a.addEventListener('input', render);
  b.addEventListener('input', render);
  ops.forEach((o) => o.addEventListener('change', render));
  d2f.addEventListener('input', renderD2f);
  f2d.addEventListener('input', renderF2d);
  for (const button of $$<HTMLButtonElement>('[data-ex]', root)) {
    button.addEventListener('click', () => {
      const [x, o, y] = button.dataset.ex!.split('|');
      a.value = x;
      b.value = y;
      ops.forEach((r) => (r.checked = r.value === o));
      render();
    });
  }
  render();
  renderD2f();
  renderF2d();
</script>

<style>
  .fc-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    align-items: end;
  }
  @media (min-width: 640px) {
    .fc-line {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
  }
  .fc-ops {
    justify-self: start;
  }
  .fc-ops span {
    min-width: 44px;
    padding: 8px 12px;
    font-size: 18px;
    text-align: center;
  }
  .fc-input {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .fc-main {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 1.6em;
  }
  .fc-main :global(.fc-stack) {
    display: inline-grid;
    justify-items: center;
    font-size: 0.72em;
    line-height: 1.1;
  }
  .fc-main :global(.fc-num) {
    padding: 0 4px 2px;
    border-bottom: 2px solid currentColor;
  }
  .fc-main :global(.fc-den) {
    padding: 2px 4px 0;
  }
  .stats .stat-value {
    font-size: 19px;
  }
  .fc-card {
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .fc-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
  .fc-steps {
    margin: 0;
    padding-left: 22px;
    display: grid;
    gap: 6px;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .fc-steps:empty::before {
    content: '—';
    color: var(--muted);
  }
  .fc-conv-out {
    margin: 4px 0 0;
    padding: 8px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-size: 18px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .fc-card .hint {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
