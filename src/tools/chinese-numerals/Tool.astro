<div class="tool" data-tool="chinese-numerals">
  <div class="field">
    <span class="label">轉換方向</span>
    <div class="seg" role="radiogroup" aria-label="轉換方向">
      <label><input type="radio" name="cn-dir" value="toChinese" checked /><span>數字轉國字</span></label>
      <label><input type="radio" name="cn-dir" value="toNumber" /><span>國字轉數字</span></label>
    </div>
  </div>

  <div class="field">
    <label for="cn-input" id="cn-input-label">輸入金額或數字</label>
    <input id="cn-input" type="text" inputmode="decimal" autocomplete="off" value="1005" class="cn-input" />
    <span class="hint" id="cn-input-hint">可含逗號與小數，例如 36,000 或 1234.56；最多到 9,999 兆。</span>
  </div>

  <div class="row cn-opts" id="cn-opts">
    <label class="check"><input type="checkbox" id="cn-prefix" /> 加上「新臺幣」</label>
  </div>

  <div class="notice error" id="cn-error" hidden></div>

  <div id="cn-output">
    <div class="field">
      <div class="row between"><span class="label">金額大寫（支票、收據用）</span><button type="button" class="btn small ghost" data-copy="#cn-upper">複製</button></div>
      <div class="output cn-big" id="cn-upper">—</div>
    </div>
    <div class="field">
      <div class="row between"><span class="label">金額小寫</span><button type="button" class="btn small ghost" data-copy="#cn-lower">複製</button></div>
      <div class="output cn-big" id="cn-lower">—</div>
    </div>
    <div class="field">
      <div class="row between"><span class="label">數字大寫（不加元）</span><button type="button" class="btn small ghost" data-copy="#cn-plain">複製</button></div>
      <div class="output" id="cn-plain">—</div>
    </div>
  </div>

  <div id="cn-reverse" hidden>
    <div class="result" aria-live="polite">
      <div class="result-value" id="cn-number">—</div>
      <div class="result-label" id="cn-number-label">阿拉伯數字</div>
    </div>
    <button type="button" class="btn small ghost" data-copy="#cn-number">複製數字</button>
  </div>

  <div class="field">
    <span class="label">大寫數字對照</span>
    <div class="table-wrap">
      <table class="table cn-ref">
        <tbody>
          <tr><th>數字</th><td>0</td><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td></tr>
          <tr><th>大寫</th><td>零</td><td>壹</td><td>貳</td><td>參</td><td>肆</td><td>伍</td><td>陸</td><td>柒</td><td>捌</td><td>玖</td></tr>
          <tr><th>小寫</th><td>零</td><td>一</td><td>二</td><td>三</td><td>四</td><td>五</td><td>六</td><td>七</td><td>八</td><td>九</td></tr>
        </tbody>
      </table>
    </div>
    <p class="hint">單位：拾（十）、佰（百）、仟（千）、萬、億、兆；金額單位：元、角（0.1 元）、分（0.01 元）。</p>
  </div>

  <p class="hint">轉換在你的瀏覽器內完成，金額不會上傳。開立支票與正式文件前，請再次核對國字與阿拉伯數字是否一致。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { amountToChinese, chineseToNumber, numberToChinese } from './logic';

  const KEY = 'chinese-numerals';
  const root = $('[data-tool="chinese-numerals"]');
  const dirs = $$<HTMLInputElement>('input[name="cn-dir"]', root);
  const input = $<HTMLInputElement>('#cn-input', root);
  const prefix = $<HTMLInputElement>('#cn-prefix', root);
  const error = $('#cn-error', root);
  const output = $('#cn-output', root);
  const reverse = $('#cn-reverse', root);

  const prefs = loadPref<Partial<{ dir: string; prefix: boolean; toChinese: string; toNumber: string }>>(KEY, {});
  const values = { toChinese: prefs.toChinese ?? '1005', toNumber: prefs.toNumber ?? '壹拾萬元整' };
  if (prefs.dir) for (const d of dirs) d.checked = d.value === prefs.dir;
  if (prefs.prefix !== undefined) prefix.checked = prefs.prefix;
  let dir = dirs.find((d) => d.checked)?.value === 'toNumber' ? 'toNumber' : 'toChinese';
  input.value = values[dir as keyof typeof values];

  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
    reverse.hidden = true;
  }

  function render() {
    values[dir as keyof typeof values] = input.value;
    savePref(KEY, { dir, prefix: prefix.checked, ...values });
    const toChinese = dir === 'toChinese';
    $('#cn-opts', root).hidden = !toChinese;
    input.inputMode = toChinese ? 'decimal' : 'text';
    set('#cn-input-label', toChinese ? '輸入金額或數字' : '輸入國字金額');
    set('#cn-input-hint', toChinese ? '可含逗號與小數，例如 36,000 或 1234.56；最多到 9,999 兆。' : '大寫或小寫皆可，例如「壹拾萬元整」「三萬六千」「伍佰元伍角」。');

    const raw = input.value.trim();
    if (raw === '') return fail(toChinese ? '請輸入數字。' : '請輸入國字金額。');

    if (toChinese) {
      const upper = amountToChinese(raw, { style: 'upper', prefix: prefix.checked });
      if (!upper) return fail('請輸入有效的正數，例如 1005 或 36,000.50，整數最多 16 位。');
      error.hidden = true;
      output.hidden = false;
      reverse.hidden = true;
      set('#cn-upper', upper);
      set('#cn-lower', amountToChinese(raw, { style: 'lower', prefix: prefix.checked }) ?? '—');
      set('#cn-plain', numberToChinese(raw, 'upper') ?? '—');
    } else {
      const n = chineseToNumber(raw);
      if (n === null) return fail('無法辨識，請確認只包含國字數字與拾佰仟萬億、元角分等單位。');
      error.hidden = true;
      output.hidden = true;
      reverse.hidden = false;
      const [i, f] = n.split('.');
      const grouped = i.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (f ? `.${f}` : '');
      set('#cn-number', grouped);
      set('#cn-number-label', `${raw} 的阿拉伯數字`);
    }
  }

  dirs.forEach((d) =>
    d.addEventListener('change', () => {
      dir = d.value === 'toNumber' ? 'toNumber' : 'toChinese';
      input.value = values[dir as keyof typeof values];
      render();
    }),
  );
  input.addEventListener('input', render);
  prefix.addEventListener('change', render);
  render();
</script>

<style>
  #cn-output,
  #cn-reverse {
    display: grid;
    gap: 14px;
  }
  #cn-output[hidden],
  #cn-reverse[hidden],
  .cn-opts[hidden] {
    display: none;
  }
  .cn-input {
    font-size: 20px;
  }
  .cn-big {
    font-family: var(--font);
    font-size: 22px;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  #cn-reverse .btn {
    justify-self: start;
  }
  .cn-ref th,
  .cn-ref td {
    text-align: center;
    padding: 8px 6px;
  }
</style>
