---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { formatReadingTime } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const initial = (key: string) =>
  key === 'reading' || key === 'speaking'
    ? formatReadingTime(0, s.client.reading)
    : key === 'genko'
      ? t(s.client.genko, { sheets: 0, rows: 0 })
      : '0';
---

<div class="tool" data-tool="word-counter" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="wc-input">{s.inputLabel}</label>
    <textarea id="wc-input" rows="10" placeholder={s.placeholder}></textarea>
  </div>

  <div class="result">
    <div class="result-value" id="wc-main" data-main={s.main}>0</div>
    <div class="result-label">{s.mainLabel}</div>
  </div>

  <div class="stats">
    {
      s.stats.map((stat) => (
        <div class="stat">
          <span class="stat-value" data-k={stat.key}>
            {initial(stat.key)}
          </span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </div>

  <div class="row">
    <button class="btn" type="button" data-copy="#wc-input">{s.copy}</button>
    <button class="btn ghost" type="button" id="wc-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$ } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { analyzeText, formatReadingTime, genkoLayout, readingMinutesFor, type TextStats } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="word-counter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#wc-input', root);
  const main = $('#wc-main', root);
  const mainKey = main.dataset.main as keyof TextStats;
  const cells = $$<HTMLElement>('[data-k]', root);

  /** Average speaking pace for presentations and speeches (English). */
  const SPEAKING_WPM = 130;

  function cellText(key: string, stats: TextStats): string {
    if (key === 'reading') return formatReadingTime(readingMinutesFor(stats, locale), s.reading);
    if (key === 'speaking') return formatReadingTime(stats.words / SPEAKING_WPM, s.reading);
    if (key === 'genko') return t(s.genko, genkoLayout(input.value));
    return formatInteger(stats[key as keyof TextStats], locale);
  }

  function render() {
    const stats = analyzeText(input.value);
    main.textContent = formatInteger(stats[mainKey], locale);
    for (const cell of cells) cell.textContent = cellText(cell.dataset.k!, stats);
  }

  input.addEventListener('input', render);
  $('#wc-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>
