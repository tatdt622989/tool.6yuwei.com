<div class="tool" data-tool="unemployment-benefit">
  <div class="field">
    <span class="label">離職前 6 個月的月投保薪資</span>
    <div class="seg" role="radiogroup" aria-label="投保薪資輸入方式">
      <label><input type="radio" name="ub-mode" value="single" checked /><span>直接輸入平均</span></label>
      <label><input type="radio" name="ub-mode" value="six" /><span>逐月輸入 6 個月</span></label>
    </div>
  </div>

  <div class="field" id="ub-avg-field">
    <label for="ub-avg">平均月投保薪資（元）</label>
    <input id="ub-avg" type="text" inputmode="numeric" autocomplete="off" value="36300" />
    <span class="hint">就業保險投保薪資最高 45,800 元，可在勞保局 App 或 e 化服務查詢；不知道的話可先填月薪，超過上限會以 45,800 元計。</span>
  </div>

  <div class="field" id="ub-six-field" hidden>
    <span class="label">離職退保當月起往前 6 個月的月投保薪資（元）</span>
    <div class="ub-six">
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="退保當月投保薪資" value="36300" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 1 個月投保薪資" value="36300" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 2 個月投保薪資" value="36300" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 3 個月投保薪資" value="36300" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 4 個月投保薪資" value="36300" />
      <input type="text" inputmode="numeric" autocomplete="off" aria-label="前 5 個月投保薪資" value="36300" />
    </div>
    <span class="hint" id="ub-six-avg">平均 — 元</span>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="ub-age">離職退保時年齡</label>
      <input id="ub-age" type="text" inputmode="numeric" autocomplete="off" value="38" />
      <span class="hint">退保當天已滿 45 歲可領 9 個月。</span>
    </div>
    <div class="field">
      <span class="label">受扶養、無工作收入的眷屬</span>
      <div class="seg" role="radiogroup" aria-label="受扶養眷屬人數">
        <label><input type="radio" name="ub-dep" value="0" checked /><span>0 人</span></label>
        <label><input type="radio" name="ub-dep" value="1" /><span>1 人</span></label>
        <label><input type="radio" name="ub-dep" value="2" /><span>2 人以上</span></label>
      </div>
      <span class="hint">父母、配偶、未成年子女或身心障礙子女，每人加給 10%，最多 20%。</span>
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="ub-dis" /> 領有身心障礙證明</label>
  </div>

  <div class="field">
    <span class="label">請領紀錄</span>
    <div class="seg" role="radiogroup" aria-label="請領紀錄">
      <label><input type="radio" name="ub-hist" value="first" checked /><span>第一次申請</span></label>
      <label><input type="radio" name="ub-hist" value="partial" /><span>上次沒領滿就再就業</span></label>
      <label><input type="radio" name="ub-hist" value="reapply" /><span>上次領滿，2 年內再申請</span></label>
    </div>
  </div>
  <div class="field" id="ub-used-field" hidden>
    <label for="ub-used">上次已領幾個月</label>
    <input id="ub-used" type="text" inputmode="decimal" autocomplete="off" value="2" />
    <span class="hint">含已用提早就業獎助津貼折抵的月數；兩次合計以 6 或 9 個月為限。</span>
  </div>

  <div class="notice error" id="ub-error" hidden></div>

  <div id="ub-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="ub-monthly">—</div>
      <div class="result-label" id="ub-monthly-label">每月可領失業給付</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ub-rate">—</span><span class="stat-label">給付比例</span></div>
      <div class="stat"><span class="stat-value" id="ub-months">—</span><span class="stat-label">可領期間</span></div>
      <div class="stat"><span class="stat-value" id="ub-total">—</span><span class="stat-label">最多可領總額</span></div>
      <div class="stat"><span class="stat-value" id="ub-avgout">—</span><span class="stat-label">平均月投保薪資</span></div>
    </div>

    <p class="notice" id="ub-note" hidden></p>

    <div class="field">
      <span class="label">請領資格自我檢查</span>
      <div class="ub-checks" id="ub-checks"></div>
      <p class="notice" id="ub-elig"></p>
    </div>

    <div class="ub-box">
      <span class="label">提早就業獎助津貼：領到一半找到工作</span>
      <div class="field">
        <label for="ub-found">領了幾個月失業給付後找到新工作</label>
        <input id="ub-found" type="text" inputmode="decimal" autocomplete="off" value="2" />
        <span class="hint">新工作參加就業保險滿 3 個月後，可一次領剩餘失業給付的 50%。</span>
      </div>
      <div class="stats">
        <div class="stat"><span class="stat-value" id="ub-remain">—</span><span class="stat-label">尚未請領月數</span></div>
        <div class="stat"><span class="stat-value" id="ub-early">—</span><span class="stat-label">提早就業獎助津貼</span></div>
      </div>
    </div>

    <div class="ub-box">
      <span class="label">失業期間打工收入：當月給付會不會被扣</span>
      <div class="grid-2">
        <div class="field">
          <label for="ub-income">當月工作收入（元）</label>
          <input id="ub-income" type="text" inputmode="numeric" autocomplete="off" value="0" />
        </div>
        <div class="field">
          <label for="ub-year">領取年度（最低工資）</label>
          <select id="ub-year">
            <option value="2026">2026 年（29,500 元）</option>
            <option value="2027" selected>2027 年（30,900 元）</option>
          </select>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><span class="stat-value" id="ub-adj">—</span><span class="stat-label">當月實領失業給付</span></div>
        <div class="stat"><span class="stat-value" id="ub-ded">—</span><span class="stat-label">被扣除金額</span></div>
      </div>
      <p class="hint" id="ub-income-note"></p>
    </div>
  </div>

  <p class="hint">依就業保險法第 11、16 至 18 條、第 19 條之 1 與勞保局公告計算：失業給付為離職前 6 個月平均月投保薪資 60%，每位受扶養眷屬加 10%（最多 20%），最長 6 個月，45 歲以上或身障者 9 個月，自求職登記第 15 日起算。結果僅供參考，實際金額以勞保局核定為準。所有計算在你的瀏覽器內完成，資料不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    adjustForWorkIncome,
    calculateUnemployment,
    earlyEmploymentAllowance,
    ELIGIBILITY_LABELS,
    ELIGIBILITY_SHORT,
    missingEligibility,
    UNEMPLOYMENT_RULES,
    validateUnemployment,
    type EligibilityAnswers,
    type History,
    type UnemploymentInput,
    type WageYear,
  } from './logic';

  interface Prefs {
    mode: string;
    avg: string;
    six: string[];
    age: string;
    dep: string;
    dis: boolean;
    hist: string;
    used: string;
    found: string;
    income: string;
    year: string;
    elig: Partial<EligibilityAnswers>;
  }

  const root = $('[data-tool="unemployment-benefit"]');
  const modes = $$<HTMLInputElement>('input[name="ub-mode"]', root);
  const avg = $<HTMLInputElement>('#ub-avg', root);
  const six = $$<HTMLInputElement>('.ub-six input', root);
  const age = $<HTMLInputElement>('#ub-age', root);
  const deps = $$<HTMLInputElement>('input[name="ub-dep"]', root);
  const dis = $<HTMLInputElement>('#ub-dis', root);
  const hists = $$<HTMLInputElement>('input[name="ub-hist"]', root);
  const used = $<HTMLInputElement>('#ub-used', root);
  const found = $<HTMLInputElement>('#ub-found', root);
  const income = $<HTMLInputElement>('#ub-income', root);
  const year = $<HTMLSelectElement>('#ub-year', root);
  const checks = $('#ub-checks', root);
  const error = $('#ub-error', root);
  const output = $('#ub-output', root);
  const note = $('#ub-note', root);
  const elig = $('#ub-elig', root);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const checked = (list: HTMLInputElement[], fallback: string) => list.find((r) => r.checked)?.value ?? fallback;
  const months = (n: number) => `${formatNumber(n, 1)} 個月`;

  const prefs = loadPref<Partial<Prefs>>('unemployment-benefit', {});

  const eligKeys = Object.keys(ELIGIBILITY_LABELS) as (keyof EligibilityAnswers)[];
  const eligBoxes = eligKeys.map((key) => {
    const label = document.createElement('label');
    label.className = 'check';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.dataset.key = key;
    box.checked = prefs.elig?.[key] ?? false;
    label.append(box, document.createTextNode(` ${ELIGIBILITY_LABELS[key]}`));
    checks.append(label);
    return box;
  });

  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.avg !== undefined) avg.value = prefs.avg;
  if (Array.isArray(prefs.six)) prefs.six.forEach((v, i) => six[i] && (six[i].value = v));
  if (prefs.age !== undefined) age.value = prefs.age;
  if (prefs.dep) for (const d of deps) d.checked = d.value === prefs.dep;
  if (prefs.dis !== undefined) dis.checked = prefs.dis;
  if (prefs.hist) for (const h of hists) h.checked = h.value === prefs.hist;
  if (prefs.used !== undefined) used.value = prefs.used;
  if (prefs.found !== undefined) found.value = prefs.found;
  if (prefs.income !== undefined) income.value = prefs.income;
  if (prefs.year && year.querySelector(`option[value="${prefs.year}"]`)) year.value = prefs.year;

  function render() {
    const mode = checked(modes, 'single');
    const history = checked(hists, 'first') as History;
    const answers = Object.fromEntries(eligBoxes.map((b) => [b.dataset.key, b.checked])) as unknown as EligibilityAnswers;

    savePref('unemployment-benefit', {
      mode,
      avg: avg.value,
      six: six.map((i) => i.value),
      age: age.value,
      dep: checked(deps, '0'),
      dis: dis.checked,
      hist: history,
      used: used.value,
      found: found.value,
      income: income.value,
      year: year.value,
      elig: answers,
    } satisfies Prefs);

    $('#ub-avg-field', root).hidden = mode !== 'single';
    $('#ub-six-field', root).hidden = mode !== 'six';
    $('#ub-used-field', root).hidden = history !== 'partial';

    const salaries =
      mode === 'six' ? six.map((i) => (i.value.trim() === '' ? 0 : parseNumber(i.value))) : [parseNumber(avg.value)];
    const input: UnemploymentInput = {
      insuredSalaries: salaries,
      age: parseNumber(age.value),
      disability: dis.checked,
      dependents: Number(checked(deps, '0')),
      history,
      usedMonths: history === 'partial' ? parseNumber(used.value) : 0,
    };
    const problem = validateUnemployment(input);
    const r = problem ? null : calculateUnemployment(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    if (mode === 'six') set('#ub-six-avg', `平均 ${formatNumber(r.averageInsured, 2)} 元`);
    set('#ub-monthly', money(r.monthly));
    set('#ub-monthly-label', `每月可領失業給付（平均月投保薪資 × ${r.ratePct}%）`);
    set('#ub-rate', `${r.ratePct}%`);
    set('#ub-months', months(r.availableMonths));
    set('#ub-total', money(r.total));
    set('#ub-avgout', money(r.averageInsured));

    const notes: string[] = [];
    if (r.cappedSalaries) notes.push(`就業保險月投保薪資最高 ${formatInteger(UNEMPLOYMENT_RULES.maxInsuredSalary)} 元，超過的月份以上限計算。`);
    if (history === 'reapply') notes.push(`上次領滿給付期間，2 年內再次請領只能領原期間的一半（${months(r.entitlementMonths)} 的 1/2）。`);
    if (history === 'partial' && r.availableMonths === 0) notes.push('上次已領滿給付期間，本次無剩餘月數可領。');
    if (r.entitlementMonths === 9 && history === 'first') notes.push('離職退保時已滿 45 歲或領有身心障礙證明，最長可領 9 個月。');
    notes.push('失業給付自求職登記第 15 日起算，每月須回就業服務站辦理失業再認定；請領期間本人與隨同投保眷屬的健保自付保費，由就業保險基金全額補助。');
    note.textContent = notes.join(' ');
    note.hidden = false;

    const missing = missingEligibility(answers);
    if (missing.length === 0) {
      elig.textContent = '四項條件都符合，可以帶著非自願離職證明、身分證與存摺，到就業服務站辦理求職登記。';
      elig.className = 'notice ok';
    } else {
      elig.textContent = `還有 ${missing.length} 項尚未確認：${missing.map((k) => ELIGIBILITY_SHORT[k]).join('、')}。全部符合才能請領。`;
      elig.className = 'notice';
    }

    const received = found.value.trim() === '' ? 0 : parseNumber(found.value);
    if (Number.isFinite(received) && received >= 0) {
      const e = earlyEmploymentAllowance(r.monthly, r.availableMonths, received);
      set('#ub-remain', months(e.remainingMonths));
      set('#ub-early', money(e.allowance));
    } else {
      set('#ub-remain', '—');
      set('#ub-early', '—');
    }

    const workIncome = income.value.trim() === '' ? 0 : parseNumber(income.value);
    if (Number.isFinite(workIncome) && workIncome >= 0) {
      const w = adjustForWorkIncome(r.monthly, r.averageInsured, workIncome, Number(year.value) as WageYear);
      set('#ub-adj', money(w.benefit));
      set('#ub-ded', money(w.deduction));
      let text: string;
      if (workIncome === 0) text = '沒有工作收入，失業給付全額發給。';
      else if (w.disqualified) text = `當月工作收入超過最低工資 ${formatInteger(w.minWage)} 元，該月不得請領失業給付。`;
      else if (w.deduction === 0)
        text = `工作收入加失業給付 ${formatInteger(workIncome + r.monthly)} 元${workIncome + r.monthly < w.minWage ? `低於最低工資 ${formatInteger(w.minWage)} 元` : `未超過平均月投保薪資 80%（${formatInteger(w.cap)} 元）`}，不扣除。`;
      else text = `工作收入加失業給付 ${formatInteger(workIncome + r.monthly)} 元，超過平均月投保薪資 80%（${formatInteger(w.cap)} 元）的部分自失業給付扣除。`;
      set('#ub-income-note', `${text} 領取期間有工作收入，須在辦理失業再認定時主動申報。`);
    } else {
      set('#ub-adj', '—');
      set('#ub-ded', '—');
      set('#ub-income-note', '請輸入 0 或正數。');
    }
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #ub-output {
    display: grid;
    gap: 16px;
  }
  #ub-output[hidden] {
    display: none;
  }
  .ub-six {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) {
    .ub-six {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ub-checks {
    display: grid;
    gap: 8px;
  }
  .ub-checks :global(.check) {
    align-items: flex-start;
    line-height: 1.5;
  }
  .ub-checks :global(.check input) {
    margin-top: 3px;
    flex-shrink: 0;
  }
  .ub-box {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .ub-box > .label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
</style>
