---
// ja-only tool: strings are written in Japanese here (see docs/i18n.md §3).
import type { ToolProps } from '../../i18n/tool';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;

// Initial receipt rows (a typical supermarket receipt with both rates).
const SAMPLE = [
  { name: '牛肉', price: 1280, qty: 1, rate: 8 },
  { name: '食パン', price: 198, qty: 3, rate: 8 },
  { name: 'ビール', price: 218, qty: 6, rate: 10 },
  { name: '洗剤', price: 398, qty: 1, rate: 10 },
];
---

<div class="tool" data-tool="consumption-tax" data-locale={locale}>
  <section class="ct-block" aria-labelledby="ct-single-title">
    <h2 class="ct-title" id="ct-single-title">税込・税抜を計算する</h2>
    <div class="field">
      <label for="ct-amount">金額（円）</label>
      <input id="ct-amount" type="text" inputmode="numeric" autocomplete="off" value="1,000" />
    </div>
    <div class="ct-options">
      <div class="field">
        <span class="label">入力した金額は</span>
        <div class="seg" role="radiogroup" aria-label="入力した金額の種類">
          <label><input type="radio" name="ct-dir" value="net" checked /><span>税抜（本体価格）</span></label>
          <label><input type="radio" name="ct-dir" value="gross" /><span>税込（総額）</span></label>
        </div>
      </div>
      <div class="field">
        <span class="label">税率</span>
        <div class="seg" role="radiogroup" aria-label="税率">
          <label><input type="radio" name="ct-rate" value="10" checked /><span>10%</span></label>
          <label><input type="radio" name="ct-rate" value="8" /><span>8%（軽減税率）</span></label>
        </div>
      </div>
      <div class="field">
        <span class="label">1円未満の端数</span>
        <div class="seg" role="radiogroup" aria-label="1円未満の端数">
          <label><input type="radio" name="ct-round" value="floor" checked /><span>切り捨て</span></label>
          <label><input type="radio" name="ct-round" value="round" /><span>四捨五入</span></label>
          <label><input type="radio" name="ct-round" value="ceil" /><span>切り上げ</span></label>
        </div>
      </div>
    </div>

    <p class="notice error" id="ct-error" hidden></p>

    <div class="result" aria-live="polite">
      <div class="result-value" id="ct-main">—</div>
      <div class="result-label" id="ct-sub"></div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ct-net">—</span><span class="stat-label">税抜（本体価格）</span></div>
      <div class="stat"><span class="stat-value" id="ct-tax">—</span><span class="stat-label" id="ct-tax-label">消費税</span></div>
      <div class="stat"><span class="stat-value" id="ct-gross">—</span><span class="stat-label">税込（総額）</span></div>
      <div class="stat"><span class="stat-value" id="ct-other">—</span><span class="stat-label" id="ct-other-label">8%の場合の税込</span></div>
    </div>
    <div class="output" id="ct-formula" aria-label="計算式"></div>
  </section>

  <section class="ct-block" aria-labelledby="ct-receipt-title">
    <h2 class="ct-title" id="ct-receipt-title">複数税率のレシート・請求書（インボイス）</h2>
    <p class="hint ct-lead">
      10%と8%の商品が混ざった請求書の消費税を、インボイス制度のルール（1枚の請求書につき税率ごとに1回だけ端数処理）で計算します。
    </p>
    <div class="field">
      <span class="label">単価の入力方法</span>
      <div class="seg" role="radiogroup" aria-label="単価の入力方法">
        <label><input type="radio" name="ct-mode" value="exclusive" checked /><span>外税（税抜単価）</span></label>
        <label><input type="radio" name="ct-mode" value="inclusive" /><span>内税（税込単価）</span></label>
      </div>
    </div>

    <div class="ct-lines" id="ct-lines">
      <div class="ct-line ct-line-head" aria-hidden="true">
        <span>品名</span><span>単価（円）</span><span>数量</span><span>税率</span><span></span>
      </div>
      {
        SAMPLE.map((l) => (
          <div class="ct-line" data-line>
            <input class="ct-name" type="text" aria-label="品名" value={l.name} />
            <input class="ct-price" type="text" inputmode="numeric" aria-label="単価（円）" value={String(l.price)} />
            <input class="ct-qty" type="text" inputmode="numeric" aria-label="数量" value={String(l.qty)} />
            <select class="ct-rate" aria-label="税率">
              <option value="10" selected={l.rate === 10}>10%</option>
              <option value="8" selected={l.rate === 8}>8%</option>
            </select>
            <button class="btn small ghost ct-remove" type="button" aria-label="この行を削除">削除</button>
          </div>
        ))
      }
    </div>
    <div class="row">
      <button class="btn" type="button" id="ct-add">行を追加</button>
      <button class="btn ghost" type="button" id="ct-clear">すべて消去</button>
    </div>
    <span class="hint">各行は品名、単価（円）、数量、税率の順です。値引きはマイナスの単価で入力できます。端数処理は上の「1円未満の端数」の設定を使います。</span>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>税率</th><th class="num">税抜</th><th class="num">消費税</th><th class="num">税込</th></tr>
        </thead>
        <tbody id="ct-rates"></tbody>
        <tfoot>
          <tr class="ct-total">
            <td>合計</td><td class="num" id="ct-t-net">—</td><td class="num" id="ct-t-tax">—</td><td class="num" id="ct-t-gross">—</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="notice" id="ct-invoice-note"></p>
  </section>
</div>

<template id="ct-line-template">
  <div class="ct-line" data-line>
    <input class="ct-name" type="text" aria-label="品名" placeholder="品名" />
    <input class="ct-price" type="text" inputmode="numeric" aria-label="単価（円）" placeholder="0" />
    <input class="ct-qty" type="text" inputmode="numeric" aria-label="数量" value="1" />
    <select class="ct-rate" aria-label="税率">
      <option value="10">10%</option>
      <option value="8">8%</option>
    </select>
    <button class="btn small ghost ct-remove" type="button" aria-label="この行を削除">削除</button>
  </div>
</template>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { isLocale } from '../../i18n/locales';
  import { calcInvoice, grossToNet, netToGross, type Line, type PriceMode, type Rounding, type TaxRate } from './logic';

  interface SavedLine {
    name: string;
    price: string;
    qty: string;
    rate: string;
  }
  interface Prefs {
    amount: string;
    dir: string;
    rate: string;
    round: string;
    mode: string;
    lines: SavedLine[];
  }

  const root = $('[data-tool="consumption-tax"]');
  const locale = isLocale(root.dataset.locale) ? root.dataset.locale : 'ja';
  const yen = (n: number) => `${formatInteger(n, locale)}円`;
  const int = (n: number) => formatInteger(n, locale);
  const radios = (name: string) => $$<HTMLInputElement>(`input[name="${name}"]`, root);
  const val = (name: string) => radios(name).find((r) => r.checked)?.value ?? '';
  const setRadio = (name: string, v: string) => {
    const list = radios(name);
    for (const r of list) r.checked = r.value === v;
    if (!list.some((r) => r.checked)) list[0].checked = true;
  };
  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const amountInput = $<HTMLInputElement>('#ct-amount', root);
  const linesBox = $('#ct-lines', root);
  const template = $<HTMLTemplateElement>('#ct-line-template');
  const ROUND_LABEL: Record<Rounding, string> = { floor: '切り捨て', round: '四捨五入', ceil: '切り上げ' };

  const readInt = (s: string) => {
    const n = parseNumber(s.replace(/円$/, ''));
    return Number.isInteger(n) ? n : Number.NaN;
  };

  /* ---------- 単品の計算 ---------- */
  function renderSingle() {
    const amount = readInt(amountInput.value);
    const rate = Number(val('ct-rate')) as TaxRate;
    const rounding = val('ct-round') as Rounding;
    const dir = val('ct-dir');
    const err = $('#ct-error', root);
    if (!Number.isFinite(amount) || amount < 0) {
      err.textContent = '金額は0以上の整数（円）で入力してください。';
      err.hidden = false;
      ['#ct-main', '#ct-net', '#ct-tax', '#ct-gross', '#ct-other'].forEach((id) => set(id, '—'));
      set('#ct-sub', '');
      set('#ct-formula', '');
      return;
    }
    err.hidden = true;
    const other: TaxRate = rate === 10 ? 8 : 10;
    const calc = dir === 'net' ? netToGross : grossToNet;
    const r = calc(amount, rate, rounding);
    const o = calc(amount, other, rounding);
    set('#ct-main', dir === 'net' ? `税込 ${yen(r.gross)}` : `税抜 ${yen(r.net)}`);
    set('#ct-sub', `${dir === 'net' ? '税抜' : '税込'} ${yen(amount)}・税率${rate}%・消費税 ${yen(r.tax)}（${ROUND_LABEL[rounding]}）`);
    set('#ct-net', yen(r.net));
    set('#ct-tax', yen(r.tax));
    set('#ct-tax-label', `消費税（${rate}%）`);
    set('#ct-gross', yen(r.gross));
    set('#ct-other', dir === 'net' ? yen(o.gross) : yen(o.net));
    set('#ct-other-label', `${other}%の場合の${dir === 'net' ? '税込' : '税抜'}`);
    set(
      '#ct-formula',
      dir === 'net'
        ? `消費税 = ${int(amount)} × ${rate}/100 = ${formatNumber((amount * rate) / 100, 2, locale)} → ${yen(r.tax)}\n税込 = ${int(amount)} + ${int(r.tax)} = ${yen(r.gross)}`
        : `消費税 = ${int(amount)} × ${rate}/${100 + rate} = ${formatNumber((amount * rate) / (100 + rate), 2, locale)} → ${yen(r.tax)}\n税抜 = ${int(amount)} − ${int(r.tax)} = ${yen(r.net)}`,
    );
  }

  /* ---------- レシート ---------- */
  function lineRows(): HTMLElement[] {
    return $$<HTMLElement>('[data-line]', linesBox);
  }

  function readLines(): { lines: Line[]; bad: number } {
    let bad = 0;
    const lines: Line[] = [];
    for (const row of lineRows()) {
      const priceRaw = $<HTMLInputElement>('.ct-price', row).value.trim();
      const qtyRaw = $<HTMLInputElement>('.ct-qty', row).value.trim();
      const price = readInt(priceRaw);
      const qty = qtyRaw === '' ? 1 : readInt(qtyRaw);
      const ok = priceRaw !== '' && Number.isFinite(price) && Number.isFinite(qty) && qty >= 0;
      row.classList.toggle('is-invalid', priceRaw !== '' && !ok);
      if (priceRaw === '') continue;
      if (!ok) {
        bad++;
        continue;
      }
      lines.push({ price, qty, rate: Number($<HTMLSelectElement>('.ct-rate', row).value) as TaxRate });
    }
    return { lines, bad };
  }

  function renderReceipt() {
    const mode = val('ct-mode') as PriceMode;
    const rounding = val('ct-round') as Rounding;
    const { lines, bad } = readLines();
    const r = calcInvoice(lines, mode, rounding);
    $('#ct-rates', root).replaceChildren(
      ...r.byRate.map((x) => {
        const tr = document.createElement('tr');
        [`${x.rate}%対象${x.rate === 8 ? '（軽減税率）' : ''}`, yen(x.net), yen(x.tax), yen(x.gross)].forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i > 0) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );
    set('#ct-t-net', lines.length ? yen(r.net) : '—');
    set('#ct-t-tax', lines.length ? yen(r.tax) : '—');
    set('#ct-t-gross', lines.length ? yen(r.gross) : '—');
    const notes: string[] = [];
    if (lines.length) {
      notes.push(
        `税率ごとに合計してから消費税を1回だけ計算しています（${mode === 'exclusive' ? '税抜合計 × 税率' : '税込合計 × 10/110・8/108'}、${ROUND_LABEL[rounding]}）。`,
      );
      const diff = r.perLineTax - r.tax;
      notes.push(
        diff === 0
          ? '商品ごとに端数処理して合計しても、この請求書では同じ金額になります。'
          : `商品ごとに端数処理して合計すると消費税は ${yen(r.perLineTax)}（${diff > 0 ? '+' : '−'}${yen(Math.abs(diff))}）になりますが、インボイスではこの方法は認められていません。`,
      );
    } else {
      notes.push('単価を入力すると税率ごとの合計と消費税を表示します。');
    }
    if (bad) notes.push(`${bad}行は単価・数量が整数でないため計算から除いています。`);
    set('#ct-invoice-note', notes.join(''));
  }

  function savedLines(): SavedLine[] {
    return lineRows().map((row) => ({
      name: $<HTMLInputElement>('.ct-name', row).value,
      price: $<HTMLInputElement>('.ct-price', row).value,
      qty: $<HTMLInputElement>('.ct-qty', row).value,
      rate: $<HTMLSelectElement>('.ct-rate', row).value,
    }));
  }

  function addLine(data?: Partial<SavedLine>): HTMLElement {
    const frag = template.content.cloneNode(true) as DocumentFragment;
    const row = frag.querySelector<HTMLElement>('[data-line]')!;
    if (data) {
      $<HTMLInputElement>('.ct-name', row).value = data.name ?? '';
      $<HTMLInputElement>('.ct-price', row).value = data.price ?? '';
      $<HTMLInputElement>('.ct-qty', row).value = data.qty ?? '1';
      $<HTMLSelectElement>('.ct-rate', row).value = data.rate === '8' ? '8' : '10';
    }
    linesBox.append(row);
    return row;
  }

  function render() {
    renderSingle();
    renderReceipt();
    savePref('consumption-tax', {
      amount: amountInput.value,
      dir: val('ct-dir'),
      rate: val('ct-rate'),
      round: val('ct-round'),
      mode: val('ct-mode'),
      lines: savedLines(),
    } satisfies Prefs);
  }

  $('#ct-add', root).addEventListener('click', () => {
    $<HTMLInputElement>('.ct-name', addLine()).focus();
    render();
  });
  $('#ct-clear', root).addEventListener('click', () => {
    for (const row of lineRows()) row.remove();
    addLine();
    render();
  });
  linesBox.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.ct-remove');
    if (!btn) return;
    btn.closest('[data-line]')?.remove();
    if (lineRows().length === 0) addLine();
    render();
  });
  root.addEventListener('input', render);
  root.addEventListener('change', render);

  const saved = loadPref<Partial<Prefs> | null>('consumption-tax', null);
  if (saved) {
    if (saved.amount) amountInput.value = saved.amount;
    setRadio('ct-dir', saved.dir ?? 'net');
    setRadio('ct-rate', saved.rate ?? '10');
    setRadio('ct-round', saved.round ?? 'floor');
    setRadio('ct-mode', saved.mode ?? 'exclusive');
    if (Array.isArray(saved.lines) && saved.lines.length > 0) {
      for (const row of lineRows()) row.remove();
      for (const l of saved.lines.slice(0, 100)) addLine(l);
    }
  }
  render();
</script>

<style>
  .ct-block {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .ct-title {
    font-size: 18px;
    margin: 0;
  }
  .ct-lead {
    margin: -6px 0 0;
  }
  .ct-block .stats {
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  }
  .ct-options {
    display: grid;
    gap: 12px;
  }
  .ct-lines {
    display: grid;
    gap: 8px;
  }
  /* Phone: name + delete on the first row, price / qty / rate below. */
  .ct-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.6em 5.6em;
    grid-template-areas:
      'name name remove'
      'price qty rate';
    gap: 6px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .ct-line-head {
    display: none;
  }
  .ct-line input,
  .ct-line select {
    min-width: 0;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }
  .ct-name {
    grid-area: name;
  }
  .ct-price {
    grid-area: price;
    text-align: right;
  }
  .ct-qty {
    grid-area: qty;
    text-align: right;
  }
  .ct-rate {
    grid-area: rate;
  }
  .ct-remove {
    grid-area: remove;
    justify-self: end;
  }
  .ct-line.is-invalid {
    border-color: var(--danger);
  }
  @media (min-width: 640px) {
    .ct-line {
      grid-template-columns: minmax(0, 1fr) 8.5em 5em 6.5em auto;
      grid-template-areas: 'name price qty rate remove';
      padding: 0;
      border: 0;
      background: none;
      align-items: center;
    }
    .ct-line-head {
      display: grid;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
    }
    .ct-line-head span:nth-child(1) {
      grid-area: name;
    }
    .ct-line-head span:nth-child(2) {
      grid-area: price;
      text-align: right;
    }
    .ct-line-head span:nth-child(3) {
      grid-area: qty;
      text-align: right;
    }
    .ct-line-head span:nth-child(4) {
      grid-area: rate;
    }
    .ct-line-head span:nth-child(5) {
      grid-area: remove;
      min-width: 3.5em;
    }
  }
  .ct-total td {
    font-weight: 700;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
</style>
