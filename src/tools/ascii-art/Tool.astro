---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import Icon from '../../components/Icon.astro';
import { CHARSET_IDS, DEFAULT_SETTINGS, MAX_COLUMNS, MIN_COLUMNS, WIDTH_PRESETS } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const d = DEFAULT_SETTINGS;
---

<div class="tool" data-tool="ascii-art" {...i18nAttrs(locale, s.client)}>
  <label class="dropzone aa-drop" id="aa-drop" tabindex="0">
    <input type="file" id="aa-file" accept="image/*,.heic,.heif" hidden />
    <Icon name="ImageUp" size={26} class="aa-drop-icon" />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="aa-bar">
    <p class="aa-source" id="aa-source" aria-live="polite">{s.client.sampleName}</p>
    <div class="aa-toggles">
      <div class="seg" role="radiogroup" aria-label={s.outputLabel}>
        <label><input type="radio" name="aa-mode" value="plain" checked /><span>{s.plain}</span></label>
        <label><input type="radio" name="aa-mode" value="color" /><span>{s.color}</span></label>
      </div>
      <div class="seg" role="radiogroup" aria-label={s.backgroundLabel}>
        <label><input type="radio" name="aa-bg" value="light" checked /><span>{s.light}</span></label>
        <label><input type="radio" name="aa-bg" value="dark" /><span>{s.dark}</span></label>
      </div>
    </div>
  </div>

  <div class="aa-stage" id="aa-stage" data-bg="light">
    <pre class="aa-art" id="aa-art" role="img" aria-label={s.previewAria}></pre>
  </div>
  <p class="aa-stats" id="aa-stats" aria-live="polite"></p>

  <div class="aa-actions">
    <button class="btn primary" type="button" id="aa-copy"><Icon name="Copy" size={16} /><span>{s.copyText}</span></button>
    <button class="btn" type="button" id="aa-txt"><Icon name="FileText" size={16} /><span>{s.downloadTxt}</span></button>
    <button class="btn" type="button" id="aa-png"><Icon name="ImageDown" size={16} /><span>{s.downloadPng}</span></button>
    <button class="btn" type="button" id="aa-html"><Icon name="Code" size={16} /><span>{s.copyHtml}</span></button>
  </div>
  <p class="hint aa-note" id="aa-html-hint">{s.htmlHint}</p>

  <section class="aa-settings" aria-label={s.settings}>
    <div class="field">
      <label for="aa-width">{s.widthBefore}<output id="aa-width-out">{d.columns}</output></label>
      <input id="aa-width" type="range" min={MIN_COLUMNS} max={MAX_COLUMNS} step="1" value={d.columns} />
      <div class="row aa-presets">
        {
          WIDTH_PRESETS.map((p) => (
            <button class="btn small" type="button" data-columns={p.columns}>
              {s.presets[p.id]} {p.columns}
            </button>
          ))
        }
      </div>
      <span class="hint">{s.widthHint}</span>
    </div>

    <div class="field">
      <span class="label">{s.charsetLabel}</span>
      <div class="seg aa-charsets" role="radiogroup" aria-label={s.charsetLabel}>
        {
          CHARSET_IDS.map((id) => (
            <label>
              <input type="radio" name="aa-charset" value={id} checked={id === d.charset} />
              <span>{s.charsets[id]}</span>
            </label>
          ))
        }
      </div>
      <p class="aa-ramp hint" id="aa-ramp"></p>
    </div>

    <div class="field" id="aa-custom-field" hidden>
      <label for="aa-custom">{s.customLabel}</label>
      <input
        id="aa-custom"
        type="text"
        class="mono"
        maxlength="64"
        placeholder={s.customPlaceholder}
        value={d.custom}
        spellcheck="false"
        autocomplete="off"
      />
      <label class="check"><input type="checkbox" id="aa-autosort" checked /> {s.autoSort}</label>
      <p class="notice error" id="aa-mixed" hidden>{s.mixedWidth}</p>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="aa-brightness">{s.brightness} <output id="aa-brightness-out">0</output></label>
        <input id="aa-brightness" type="range" min="-100" max="100" step="1" value="0" />
      </div>
      <div class="field">
        <label for="aa-contrast">{s.contrast} <output id="aa-contrast-out">0</output></label>
        <input id="aa-contrast" type="range" min="-100" max="100" step="1" value="0" />
      </div>
    </div>

    <div class="aa-checks">
      <label class="check"><input type="checkbox" id="aa-levels" checked /> {s.autoLevels}</label>
      <label class="check"><input type="checkbox" id="aa-invert" /> {s.invert}</label>
      <label class="check"><input type="checkbox" id="aa-dither" checked={d.dither[d.charset]} /> {s.dither}</label>
      <label class="check"><input type="checkbox" id="aa-edges" /> {s.edges}</label>
    </div>
    <p class="hint aa-note">{s.backgroundHint}</p>
    <div class="aa-foot">
      <span class="hint">{s.privacy}</span>
      <button class="btn small" type="button" id="aa-reset">{s.reset}</button>
    </div>
  </section>
</div>

<script>
  import { $, $$, copyText, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { track as trackEvent } from '../../lib/analytics';
  import { isHeic } from '../../lib/heic';
  import { readI18n } from '../../i18n/client';
  import { formatInteger, t } from '../../i18n/format';
  import type { Strings } from './i18n';
  import {
    DEFAULT_SETTINGS,
    artText,
    artToHtml,
    buildRamp,
    charsetSpec,
    convert,
    layoutGrid,
    normalizeSettings,
    outputName,
    type Art,
    type Background,
    type Ramp,
    type Settings,
  } from './logic';
  import {
    blockGlyphEm,
    canvasBlob,
    fillPreview,
    fitPreview,
    loadFile,
    measureCoverage,
    paintArt,
    samplePixels,
    sampleSource,
    type Fit,
    type Source,
  } from './browser';

  const PAPER: Record<Background, { background: string; color: string }> = {
    light: { background: '#ffffff', color: '#18191c' },
    dark: { background: '#111318', color: '#e8e9ed' },
  };

  const root = $('[data-tool="ascii-art"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const prefKey = `ascii-art:${locale}`;

  const drop = $('#aa-drop', root);
  const fileInput = $<HTMLInputElement>('#aa-file', root);
  const sourceEl = $('#aa-source', root);
  const stage = $('#aa-stage', root);
  const pre = $('#aa-art', root);
  const statsEl = $('#aa-stats', root);
  const rampEl = $('#aa-ramp', root);
  const modeRadios = $$<HTMLInputElement>('input[name="aa-mode"]', root);
  const bgRadios = $$<HTMLInputElement>('input[name="aa-bg"]', root);
  const charsetRadios = $$<HTMLInputElement>('input[name="aa-charset"]', root);
  const widthIn = $<HTMLInputElement>('#aa-width', root);
  const widthOut = $('#aa-width-out', root);
  const customField = $('#aa-custom-field', root);
  const customIn = $<HTMLInputElement>('#aa-custom', root);
  const autoSortBox = $<HTMLInputElement>('#aa-autosort', root);
  const mixedEl = $('#aa-mixed', root);
  const brightIn = $<HTMLInputElement>('#aa-brightness', root);
  const brightOut = $('#aa-brightness-out', root);
  const contrastIn = $<HTMLInputElement>('#aa-contrast', root);
  const contrastOut = $('#aa-contrast-out', root);
  const levelsBox = $<HTMLInputElement>('#aa-levels', root);
  const invertBox = $<HTMLInputElement>('#aa-invert', root);
  const ditherBox = $<HTMLInputElement>('#aa-dither', root);
  const edgesBox = $<HTMLInputElement>('#aa-edges', root);
  const copyBtn = $<HTMLButtonElement>('#aa-copy', root);
  const txtBtn = $<HTMLButtonElement>('#aa-txt', root);
  const pngBtn = $<HTMLButtonElement>('#aa-png', root);
  const htmlBtn = $<HTMLButtonElement>('#aa-html', root);

  pre.style.fontFamily = s.font;

  let settings: Settings = normalizeSettings(loadPref<unknown>(prefKey, null));
  let source: Source = sampleSource(s.sampleName);
  let sourceId = 0;
  let isSample = true;
  let loadToken = 0;
  let pixelKey = '';
  let pixels: ArrayLike<number> = new Uint8ClampedArray(4);
  let art: Art | null = null;
  let fit: Fit | null = null;
  const NO_RAMP: Ramp = buildRamp([]);
  const blockEm = blockGlyphEm(s.font);
  const ramps = new Map<string, Ramp>();

  /* ---------- Settings <-> form ---------- */
  const checked = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value;

  function writeForm() {
    for (const r of modeRadios) r.checked = r.value === settings.mode;
    for (const r of bgRadios) r.checked = r.value === settings.background;
    for (const r of charsetRadios) r.checked = r.value === settings.charset;
    widthIn.value = String(settings.columns);
    customIn.value = settings.custom;
    autoSortBox.checked = settings.autoSort;
    brightIn.value = String(settings.brightness);
    contrastIn.value = String(settings.contrast);
    levelsBox.checked = settings.autoLevels;
    invertBox.checked = settings.invert;
    ditherBox.checked = settings.dither[settings.charset];
    edgesBox.checked = settings.edges;
  }

  function readForm(): Settings {
    // The dither box belongs to the character set that was showing; each set keeps its own.
    const next = normalizeSettings(
      {
        columns: widthIn.value,
        charset: checked(charsetRadios),
        custom: customIn.value,
        autoSort: autoSortBox.checked,
        brightness: brightIn.value,
        contrast: contrastIn.value,
        autoLevels: levelsBox.checked,
        invert: invertBox.checked,
        dither: { ...settings.dither, [settings.charset]: ditherBox.checked },
        edges: edgesBox.checked,
        mode: checked(modeRadios),
        background: checked(bgRadios),
      },
      settings,
    );
    ditherBox.checked = next.dither[next.charset];
    return next;
  }

  /* ---------- Rendering ---------- */
  function rampFor(chars: string[], measure: boolean): Ramp {
    const key = `${measure ? 'm' : 'o'}|${chars.join('')}`;
    let ramp = ramps.get(key);
    if (!ramp) {
      ramp = buildRamp(chars, measure ? measureCoverage(chars, s.font) : undefined);
      ramps.set(key, ramp);
    }
    return ramp;
  }

  /** Block characters are previewed slightly overlapped so solid areas have no seams; see fitPreview. */
  const blockFit = () => (settings.charset === 'blocks' ? blockEm : undefined);
  const maxPreviewHeight = () => Math.max(300, Math.round(window.innerHeight * 0.8));

  function render() {
    const spec = charsetSpec(settings.charset, settings.custom);
    const geometry = spec.geometry;
    const braille = geometry.dotsX > 1;
    const ramp = braille ? NO_RAMP : rampFor(spec.chars, settings.charset !== 'custom' || settings.autoSort);
    const layout = layoutGrid(source.width, source.height, settings.columns, geometry);
    const key = `${sourceId}|${layout.pxW}x${layout.pxH}`;
    if (key !== pixelKey) {
      pixels = samplePixels(source, layout.pxW, layout.pxH);
      pixelKey = key;
    }
    art = convert(pixels, layout, geometry, ramp, { ...settings, dither: settings.dither[settings.charset] });

    stage.dataset.bg = settings.background;
    fillPreview(pre, art, settings.mode);
    fit = fitPreview(stage, pre, art, maxPreviewHeight(), blockFit());

    widthOut.textContent = String(settings.columns);
    brightOut.textContent = String(settings.brightness);
    contrastOut.textContent = String(settings.contrast);
    customField.hidden = settings.charset !== 'custom';
    mixedEl.hidden = !spec.mixed;
    statsEl.textContent = t(s.stats, {
      cols: formatInteger(art.cols, locale),
      rows: formatInteger(art.rows, locale),
      n: formatInteger(art.cols * art.rows, locale),
    });
    if (braille) {
      rampEl.textContent = s.brailleNote;
    } else {
      const code = document.createElement('code');
      code.className = 'aa-ramp-chars';
      code.style.fontFamily = s.font;
      code.textContent = ramp.chars.join('');
      rampEl.replaceChildren(s.rampLabel, code);
    }
  }

  let queued = false;
  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      render();
    });
  }

  function onChange() {
    settings = readForm();
    savePref(prefKey, settings);
    schedule();
  }

  /* ---------- Picture input ---------- */
  function showSource() {
    sourceEl.classList.remove('is-error');
    sourceEl.textContent = t(s.source, {
      name: isSample ? s.sampleName : source.name || s.sampleName,
      w: formatInteger(source.width, locale),
      h: formatInteger(source.height, locale),
    });
  }

  async function useFile(file: File) {
    if (!file.type.startsWith('image/') && !isHeic(file.type, file.name)) return;
    const token = ++loadToken;
    sourceEl.classList.remove('is-error');
    sourceEl.textContent = s.loading;
    try {
      const next = await loadFile(file);
      if (token !== loadToken) return;
      source = next;
      sourceId++;
      isSample = false;
      showSource();
      render();
    } catch {
      if (token !== loadToken) return;
      sourceEl.classList.add('is-error');
      sourceEl.textContent = s.error;
    }
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) void useFile(file);
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    const file = e.dataTransfer?.files[0];
    if (file) void useFile(file);
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const file = Array.from(e.clipboardData?.files ?? []).find((f) => f.type.startsWith('image/'));
    if (!file) return;
    e.preventDefault();
    void useFile(file);
  });

  /* ---------- Actions ---------- */
  const timers = new WeakMap<HTMLElement, number>();
  function flash(button: HTMLButtonElement, label: string) {
    const span = button.querySelector('span')!;
    span.dataset.label ??= span.textContent ?? '';
    span.textContent = label;
    button.classList.add('is-done');
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        span.textContent = span.dataset.label ?? '';
        button.classList.remove('is-done');
      }, 1400),
    );
  }

  const fileName = (ext: 'txt' | 'png') => outputName(isSample ? '' : source.name, ext);

  copyBtn.addEventListener('click', async () => {
    if (art && (await copyText(artText(art)))) flash(copyBtn, s.copied);
  });
  txtBtn.addEventListener('click', () => {
    if (!art) return;
    downloadBlob(new Blob([artText(art)], { type: 'text/plain;charset=utf-8' }), fileName('txt'));
    flash(txtBtn, s.saved);
  });
  pngBtn.addEventListener('click', async () => {
    if (!art) return;
    pngBtn.disabled = true;
    try {
      const canvas = paintArt(art, { font: s.font, mode: settings.mode, ...PAPER[settings.background] });
      downloadBlob(await canvasBlob(canvas), fileName('png'));
      flash(pngBtn, s.saved);
    } finally {
      pngBtn.disabled = false;
    }
  });

  const richClipboard = typeof ClipboardItem !== 'undefined' && typeof navigator.clipboard?.write === 'function';
  if (!richClipboard) {
    htmlBtn.hidden = true;
    $('#aa-html-hint', root).hidden = true;
  }
  htmlBtn.addEventListener('click', async () => {
    if (!art || !fit) return;
    const fontSize = 10;
    const advEm = fit.advanceEm;
    const html = artToHtml(art, settings.mode, {
      font: s.font,
      fontSize,
      lineHeight: advEm * art.geometry.cellRatio,
      ...PAPER[settings.background],
    });
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          'text/html': new Blob([html], { type: 'text/html' }),
          'text/plain': new Blob([artText(art)], { type: 'text/plain' }),
        }),
      ]);
      trackEvent('tool_copy');
      flash(htmlBtn, s.copied);
    } catch {
      if (await copyText(artText(art))) flash(htmlBtn, s.copied);
    }
  });

  /* ---------- Settings events ---------- */
  for (const input of [widthIn, brightIn, contrastIn, customIn]) input.addEventListener('input', onChange);
  for (const input of [...modeRadios, ...bgRadios, ...charsetRadios, autoSortBox, levelsBox, invertBox, ditherBox, edgesBox]) {
    input.addEventListener('change', onChange);
  }
  $$<HTMLButtonElement>('[data-columns]', root).forEach((btn) =>
    btn.addEventListener('click', () => {
      widthIn.value = btn.dataset.columns!;
      onChange();
    }),
  );
  $('#aa-reset', root).addEventListener('click', () => {
    settings = { ...DEFAULT_SETTINGS, custom: settings.custom };
    savePref(prefKey, settings);
    writeForm();
    schedule();
  });

  // Refit when the stage width changes (rotation, window resize).
  let lastWidth = 0;
  new ResizeObserver(() => {
    const w = stage.clientWidth;
    if (w === lastWidth || !art) return;
    lastWidth = w;
    fit = fitPreview(stage, pre, art, maxPreviewHeight(), blockFit());
  }).observe(stage);

  writeForm();
  showSource();
  render();
  lastWidth = stage.clientWidth;
</script>

<style>
  .aa-drop {
    min-height: 128px;
    padding: 18px;
  }
  .aa-drop :global(.aa-drop-icon) {
    color: var(--accent);
  }
  .aa-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .aa-source {
    margin: 0;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .aa-source.is-error {
    color: var(--danger);
  }
  .aa-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aa-stage {
    position: relative;
    overflow: hidden;
    min-height: 120px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    color: #18191c;
  }
  .aa-stage[data-bg='dark'] {
    background: #111318;
    border-color: #111318;
    color: #e8e9ed;
  }
  .aa-art {
    position: absolute;
    top: 12px;
    left: 12px;
    width: max-content;
    margin: 0;
    padding: 0;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    font-kerning: none;
    font-variant-ligatures: none;
    transform-origin: 0 0;
  }
  .aa-stats {
    margin: -6px 0 0;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .aa-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 640px) {
    .aa-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
  .aa-actions .btn {
    min-width: 0;
  }
  .aa-actions :global(svg) {
    flex: none;
  }
  .aa-note {
    margin: -6px 0 0;
  }
  .aa-settings {
    display: grid;
    gap: 18px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .aa-settings .seg {
    background: var(--surface);
  }
  .aa-presets {
    gap: 8px;
  }
  .aa-ramp {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .aa-ramp :global(.aa-ramp-chars) {
    padding: 1px 6px;
    font-size: 14px;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .aa-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
  }
  .aa-settings .notice {
    margin: 0;
  }
  .aa-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
</style>
