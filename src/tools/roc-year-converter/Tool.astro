---
import { JAPANESE_ERAS, rocTable } from './logic';

// The full 民國 1–130 table is rendered at build time so it is in the HTML; the script only
// re-highlights the current year and refreshes the age column if the year has changed since the build.
const buildYear = new Date().getFullYear();
const rows = rocTable(130, buildYear);
const eras = [...JAPANESE_ERAS].reverse().map((e) => e.name);
---

<div class="tool" data-tool="roc-year-converter" data-build-year={buildYear}>
  <div class="field">
    <span class="label">我要輸入</span>
    <div class="seg" role="radiogroup" aria-label="輸入的年份種類">
      <label><input type="radio" name="ry-from" value="roc" checked /><span>民國年</span></label>
      <label><input type="radio" name="ry-from" value="ad" /><span>西元年</span></label>
      <label><input type="radio" name="ry-from" value="jp" /><span>日本年號</span></label>
    </div>
  </div>

  <div class="row ry-inputs">
    <div class="field ry-era" id="ry-era-field" hidden>
      <label for="ry-era">年號</label>
      <select id="ry-era">
        {eras.map((e) => <option value={e}>{e}</option>)}
      </select>
    </div>
    <div class="field ry-year">
      <label for="ry-year" id="ry-year-label">民國年</label>
      <input id="ry-year" type="text" inputmode="numeric" autocomplete="off" value="115" />
    </div>
  </div>

  <div class="notice error" id="ry-error" hidden></div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="ry-main">—</div>
    <div class="result-label" id="ry-sub"></div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="ry-ad">—</span><span class="stat-label">西元</span></div>
    <div class="stat"><span class="stat-value" id="ry-roc">—</span><span class="stat-label">民國</span></div>
    <div class="stat"><span class="stat-value" id="ry-jp">—</span><span class="stat-label">日本年號（和暦）</span></div>
    <div class="stat"><span class="stat-value" id="ry-gz">—</span><span class="stat-label">干支・生肖</span></div>
    <div class="stat"><span class="stat-value" id="ry-age">—</span><span class="stat-label" id="ry-age-label">這年出生，今年幾歲</span></div>
  </div>

  <div class="field">
    <label for="ry-date">民國日期 ↔ 西元日期</label>
    <input id="ry-date" type="text" autocomplete="off" value="115/10/29" placeholder="例如 115/10/29、1151029 或 2026-10-29" />
    <span class="hint">1 到 3 位數的年份視為民國年，4 位數視為西元年；7 碼數字（如 1151029）視為民國，8 碼（如 20261029）視為西元。</span>
  </div>
  <div class="ry-date-out" id="ry-date-out">
    <div class="row between ry-line"><span><span class="muted">西元</span> <strong id="ry-d-ad">—</strong></span><button type="button" class="btn small" data-copy="#ry-d-ad">複製</button></div>
    <div class="row between ry-line"><span><span class="muted">民國</span> <strong id="ry-d-roc">—</strong></span><button type="button" class="btn small" data-copy="#ry-d-roc">複製</button></div>
    <div class="row between ry-line"><span><span class="muted">中文</span> <strong id="ry-d-text">—</strong></span><button type="button" class="btn small" data-copy="#ry-d-text">複製</button></div>
    <p class="hint" id="ry-d-note"></p>
  </div>

  <div class="field">
    <span class="label" id="ry-table-title">民國西元對照表（民國 1–130 年，{buildYear} 年歲數）</span>
    <div class="table-wrap ry-table-wrap" id="ry-table-wrap">
      <table class="table ry-table">
        <thead>
          <tr>
            <th>民國</th>
            <th>西元</th>
            <th>干支</th>
            <th>生肖</th>
            <th>日本年號</th>
            <th class="num">今年歲數</th>
          </tr>
        </thead>
        <tbody id="ry-table">
          {
            rows.map((r) => (
              <tr data-ad={r.ad} class={r.ad === buildYear ? 'is-current' : undefined}>
                <td>{r.rocNumber === 1 ? '元年' : `${r.rocNumber} 年`}</td>
                <td>{r.ad}</td>
                <td>{r.ganzhi}</td>
                <td>{r.animal}</td>
                <td>{r.japanese.join('／')}</td>
                <td class="num ry-age-cell">{r.ageThisYear >= 0 ? `${r.ageThisYear} 歲` : '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">「今年歲數」為今年生日過後的實歲；生日還沒到要減 1。干支與生肖以農曆新年換年，國曆 1–2 月出生者請以農曆日期為準。</span>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { toDayNumber } from '../date-diff/logic';
  import {
    adToRoc,
    eraLastYear,
    formatAdSlash,
    formatRocDate,
    formatRocSlash,
    japaneseDateLabel,
    japaneseToAD,
    parseDateText,
    rocToAD,
    yearInfo,
  } from './logic';

  type From = 'roc' | 'ad' | 'jp';
  interface Prefs {
    from: From;
    year: string;
    era: string;
    date: string;
  }

  const root = $('[data-tool="roc-year-converter"]');
  const froms = $$<HTMLInputElement>('input[name="ry-from"]', root);
  const yearInput = $<HTMLInputElement>('#ry-year', root);
  const eraSel = $<HTMLSelectElement>('#ry-era', root);
  const dateInput = $<HTMLInputElement>('#ry-date', root);
  const error = $('#ry-error', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const currentYear = new Date().getFullYear();

  function from(): From {
    return (froms.find((f) => f.checked)?.value ?? 'roc') as From;
  }

  /** Gregorian year from the current input, or NaN. */
  function readYear(): number {
    const n = Math.trunc(parseNumber(yearInput.value));
    if (!Number.isFinite(n)) return Number.NaN;
    if (from() === 'roc') return n >= 1 ? rocToAD(n) : Number.NaN;
    if (from() === 'jp') return japaneseToAD(eraSel.value, n);
    return n >= 1 ? n : Number.NaN;
  }

  function prefs(): Prefs {
    return { from: from(), year: yearInput.value, era: eraSel.value, date: dateInput.value };
  }

  function renderYear() {
    const f = from();
    $('#ry-era-field', root).hidden = f !== 'jp';
    set('#ry-year-label', f === 'roc' ? '民國年' : f === 'ad' ? '西元年' : '年號第幾年');
    const ad = readYear();
    if (!Number.isFinite(ad) || ad > 9999) {
      const last = f === 'jp' ? eraLastYear(eraSel.value) : null;
      error.textContent =
        f === 'jp' && last ? `${eraSel.value}只到 ${last} 年，請輸入 1 到 ${last}。` : f === 'roc' ? '請輸入民國年，例如 115。' : '請輸入年份，例如 2026。';
      error.hidden = false;
      ['#ry-main', '#ry-ad', '#ry-roc', '#ry-jp', '#ry-gz', '#ry-age'].forEach((id) => set(id, '—'));
      set('#ry-sub', '');
      return;
    }
    error.hidden = true;
    const info = yearInfo(ad, currentYear);
    const jp = info.japanese.join('／') || '—';
    if (f === 'roc') set('#ry-main', `${info.roc} ＝ 西元 ${ad} 年`);
    else if (f === 'ad') set('#ry-main', `西元 ${ad} 年 ＝ ${info.roc}`);
    else set('#ry-main', `${eraSel.value} ${yearInput.value.trim()} 年 ＝ 西元 ${ad} 年`);
    set('#ry-sub', `${info.roc}・${info.ganzhi}年（${info.animal}年）${info.japanese.length ? `・日本${jp}` : ''}`);
    set('#ry-ad', `${ad} 年`);
    set('#ry-roc', info.rocNumber >= 1 ? `${info.rocNumber === 1 ? '元' : info.rocNumber} 年` : info.roc);
    set('#ry-jp', jp);
    set('#ry-gz', `${info.ganzhi}・${info.animal}`);
    if (info.ageThisYear >= 0) {
      set('#ry-age', `${info.ageThisYear} 歲`);
      set('#ry-age-label', `${ad} 年出生，${currentYear} 年生日過後的實歲（虛歲 ${info.ageThisYear + 1} 歲）`);
    } else {
      set('#ry-age', `${-info.ageThisYear} 年後`);
      set('#ry-age-label', `距離 ${currentYear} 年`);
    }
  }

  function renderDate() {
    const parsed = parseDateText(dateInput.value);
    const out = ['#ry-d-ad', '#ry-d-roc', '#ry-d-text'];
    if (!parsed) {
      out.forEach((id) => set(id, '—'));
      set('#ry-d-note', dateInput.value.trim() ? '看不懂這個日期，請用「115/10/29」或「2026-10-29」的格式。' : '');
      return;
    }
    const { date } = parsed;
    set('#ry-d-ad', formatAdSlash(date));
    set('#ry-d-roc', date.y > 1911 ? formatRocSlash(date) : '民國以前');
    set('#ry-d-text', parsed.from === 'roc' ? `西元 ${date.y} 年 ${date.m} 月 ${date.d} 日` : formatRocDate(date));
    const jp = japaneseDateLabel(date);
    const now = new Date();
    const days = toDayNumber(date) - toDayNumber({ y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() });
    const rel = days === 0 ? '就是今天' : days > 0 ? `距今還有 ${days} 天` : `距今已過 ${-days} 天`;
    set('#ry-d-note', `判讀為${parsed.from === 'roc' ? '民國' : '西元'}日期${jp ? `；日本和暦為${jp}` : ''}；${rel}。`);
  }

  function render() {
    renderYear();
    renderDate();
    savePref('roc-year-converter', prefs());
  }

  // Keep the same year when switching what is typed.
  let lastFrom = from();
  froms.forEach((f) =>
    f.addEventListener('change', () => {
      const prev = lastFrom;
      lastFrom = from();
      const n = Math.trunc(parseNumber(yearInput.value));
      const ad = prev === 'roc' ? rocToAD(n) : prev === 'jp' ? japaneseToAD(eraSel.value, n) : n;
      if (Number.isFinite(ad)) {
        if (lastFrom === 'roc') yearInput.value = String(adToRoc(ad));
        else if (lastFrom === 'ad') yearInput.value = String(ad);
        else {
          const label = yearInfo(ad, currentYear).japanese.at(-1);
          const match = label ? /^(.+?)(元| ?(\d+) ?)年$/.exec(label) : null;
          if (match) {
            eraSel.value = match[1];
            yearInput.value = match[3] ?? '1';
          }
        }
      }
      render();
    }),
  );
  yearInput.addEventListener('input', render);
  eraSel.addEventListener('change', render);
  dateInput.addEventListener('input', render);

  // Table: highlight this year and keep ages current even if the page was built last year.
  const buildYear = Number(root.dataset.buildYear);
  const tableBody = $('#ry-table', root);
  if (buildYear !== currentYear) {
    for (const tr of $$<HTMLTableRowElement>('tr', tableBody)) {
      const age = currentYear - Number(tr.dataset.ad);
      tr.classList.toggle('is-current', age === 0);
      $('.ry-age-cell', tr).textContent = age >= 0 ? `${age} 歲` : '—';
    }
    set('#ry-table-title', `民國西元對照表（民國 1–130 年，${currentYear} 年歲數）`);
  }
  const currentRow = tableBody.querySelector<HTMLElement>('tr.is-current');
  const wrap = $('#ry-table-wrap', root);
  if (currentRow) wrap.scrollTop = Math.max(0, currentRow.offsetTop - wrap.clientHeight / 2);

  const saved = loadPref<Prefs>('roc-year-converter', { from: 'roc', year: String(adToRoc(currentYear)), era: '令和', date: '' });
  for (const f of froms) f.checked = f.value === saved.from;
  if (!froms.some((f) => f.checked)) froms[0].checked = true;
  lastFrom = from();
  yearInput.value = saved.year;
  if ([...eraSel.options].some((o) => o.value === saved.era)) eraSel.value = saved.era;
  dateInput.value = saved.date || formatRocSlash({ y: currentYear, m: new Date().getMonth() + 1, d: new Date().getDate() });
  render();
</script>

<style>
  .ry-inputs {
    align-items: flex-end;
  }
  .ry-year {
    flex: 1 1 180px;
    max-width: 260px;
  }
  .ry-era {
    flex: 0 1 140px;
  }
  .ry-date-out {
    display: grid;
    gap: 8px;
  }
  .ry-line {
    padding: 8px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }
  .ry-table-wrap {
    max-height: 460px;
    overflow-y: auto;
  }
  .ry-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .ry-table tr.is-current td {
    background: var(--accent-soft);
    font-weight: 700;
  }
</style>
