---
import type { ToolProps } from '../../i18n/tool';
import { weekDays } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
const days = weekDays('mon');
---

<div class="tool" data-tool="time-card-calculator" data-locale={locale}>
  <div class="tc-settings">
    <div class="seg" role="radiogroup" aria-label="Clock format">
      <label><input type="radio" name="tc-format" value="12h" checked /><span>AM/PM</span></label>
      <label><input type="radio" name="tc-format" value="24h" /><span>24-hour</span></label>
    </div>
    <div class="field">
      <label for="tc-week">Week starts</label>
      <select id="tc-week">
        <option value="mon">Monday</option>
        <option value="sun">Sunday</option>
      </select>
    </div>
    <div class="field">
      <label for="tc-round">Round punches</label>
      <select id="tc-round">
        <option value="0">No rounding</option>
        <option value="5">Nearest 5 minutes</option>
        <option value="6">Nearest 6 minutes (0.1 h)</option>
        <option value="15">Nearest 15 minutes (7-minute rule)</option>
      </select>
    </div>
  </div>

  <div class="tc-head" aria-hidden="true">
    <span class="tc-h-day">Day</span><span class="tc-h-in">Time in</span><span class="tc-h-out">Time out</span><span class="tc-h-brk">Break</span><span class="tc-h-hours num">Hours</span>
  </div>
  <div class="tc-days" id="tc-days">
    {
      days.map((day, i) => (
        <div class="tc-day" role="group" aria-labelledby={`tc-name-${i}`} data-i={i}>
          <span class="tc-name" id={`tc-name-${i}`}>{day}</span>
          <input class="tc-in" type="text" autocomplete="off" inputmode="text" spellcheck="false" aria-label={`${day} time in`} />
          <input class="tc-out" type="text" autocomplete="off" inputmode="text" spellcheck="false" aria-label={`${day} time out`} />
          <input class="tc-break" type="text" autocomplete="off" inputmode="text" spellcheck="false" aria-label={`${day} unpaid break in minutes`} placeholder="min" />
          <output class="tc-hours num">—</output>
          <span class="tc-msg" role="status"></span>
        </div>
      ))
    }
  </div>
  <p class="hint" id="tc-format-hint">
    Type times like 9, 9:30, 930, 5:45pm or 17:45. Without AM/PM, an end time is read as the shorter shift (9 to 5 = 8 hours).
    Breaks in minutes (30) or hours:minutes (0:30).
  </p>
  <div class="row">
    <button class="btn small" type="button" id="tc-fill">Fill weekdays 9–5:30, 30 min break</button>
    <button class="btn small ghost" type="button" id="tc-clear">Clear all</button>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="tc-rule">Overtime rule</label>
      <select id="tc-rule">
        <option value="federal">Federal: over 40 hours a week</option>
        <option value="california">California: daily over 8 / 12 hours + weekly 40</option>
        <option value="none">No overtime</option>
      </select>
    </div>
    <div class="field">
      <label for="tc-rate">Hourly pay rate ($, optional)</label>
      <input id="tc-rate" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 18.50" />
    </div>
  </div>

  <div class="result" aria-live="polite">
    <div class="result-value"><span id="tc-total">0:00</span> <span class="tc-dec" id="tc-dec">(0.00 hours)</span></div>
    <div class="result-label">Total hours worked this week</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="tc-reg">—</span><span class="stat-label" id="tc-reg-label">Regular hours</span></div>
    <div class="stat"><span class="stat-value" id="tc-ot">—</span><span class="stat-label" id="tc-ot-label">Overtime (1.5×)</span></div>
    <div class="stat" id="tc-dt-stat" hidden><span class="stat-value" id="tc-dt">—</span><span class="stat-label" id="tc-dt-label">Double time (2×)</span></div>
    <div class="stat"><span class="stat-value" id="tc-pay">—</span><span class="stat-label">Gross pay</span></div>
  </div>
  <p class="output" id="tc-pay-detail" hidden></p>
  <p class="notice" id="tc-note" hidden></p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import {
    computeDay,
    formatDecimalHours,
    formatHM,
    formatUsd,
    grossPay,
    splitOvertime,
    weekDays,
    type ClockFormat,
    type DayEntry,
    type OvertimeRule,
    type RoundingStep,
  } from './logic';

  const root = $('[data-tool="time-card-calculator"]');
  const rows = $$<HTMLElement>('.tc-day', root);
  const formats = $$<HTMLInputElement>('input[name="tc-format"]', root);
  const week = $<HTMLSelectElement>('#tc-week', root);
  const rounding = $<HTMLSelectElement>('#tc-round', root);
  const rule = $<HTMLSelectElement>('#tc-rule', root);
  const rate = $<HTMLInputElement>('#tc-rate', root);
  const totalEl = $('#tc-total', root);
  const decEl = $('#tc-dec', root);
  const regEl = $('#tc-reg', root);
  const otEl = $('#tc-ot', root);
  const dtEl = $('#tc-dt', root);
  const dtStat = $('#tc-dt-stat', root);
  const payEl = $('#tc-pay', root);
  const payDetail = $('#tc-pay-detail', root);
  const note = $('#tc-note', root);

  interface Prefs {
    format: ClockFormat;
    week: 'mon' | 'sun';
    rounding: string;
    rule: OvertimeRule;
    rate: string;
    /** Entries in calendar order Sunday..Saturday, so switching the week start keeps them on the right day. */
    days: DayEntry[];
  }

  const field = (row: HTMLElement, cls: string) => $<HTMLInputElement>(cls, row);
  const format = (): ClockFormat => (formats.find((f) => f.checked)?.value === '24h' ? '24h' : '12h');
  // Calendar index (0 = Sunday) of the i-th row.
  const calendarIndex = (i: number) => (week.value === 'sun' ? i : (i + 1) % 7);

  function readEntries(): DayEntry[] {
    return rows.map((row) => ({
      start: field(row, '.tc-in').value,
      end: field(row, '.tc-out').value,
      breakText: field(row, '.tc-break').value,
    }));
  }

  function calendarEntries(): DayEntry[] {
    const entries = readEntries();
    const out: DayEntry[] = Array.from({ length: 7 });
    entries.forEach((e, i) => (out[calendarIndex(i)] = e));
    return out;
  }

  function writeCalendar(entries: DayEntry[]) {
    rows.forEach((row, i) => {
      const e = entries[calendarIndex(i)] ?? { start: '', end: '', breakText: '' };
      field(row, '.tc-in').value = e.start;
      field(row, '.tc-out').value = e.end;
      field(row, '.tc-break').value = e.breakText;
    });
  }

  function labelDays() {
    const names = weekDays(week.value === 'sun' ? 'sun' : 'mon');
    rows.forEach((row, i) => {
      $('.tc-name', row).textContent = names[i];
      field(row, '.tc-in').setAttribute('aria-label', `${names[i]} time in`);
      field(row, '.tc-out').setAttribute('aria-label', `${names[i]} time out`);
      field(row, '.tc-break').setAttribute('aria-label', `${names[i]} unpaid break in minutes`);
    });
  }

  function setPlaceholders() {
    const twelve = format() === '12h';
    rows.forEach((row) => {
      field(row, '.tc-in').placeholder = twelve ? '9:00 AM' : '09:00';
      field(row, '.tc-out').placeholder = twelve ? '5:30 PM' : '17:30';
    });
  }

  const ERRORS = {
    start: 'Check the time in.',
    end: 'Check the time out.',
    missing: 'Enter both times.',
    break: 'Break must be minutes or h:mm.',
    'break-too-long': 'Break is longer than the shift.',
  } as const;

  function render(normalize = false) {
    const fmt = format();
    const step = Number(rounding.value) as RoundingStep;
    const minutes: number[] = [];
    let errors = 0;
    let overnight = false;
    const entries = readEntries();
    rows.forEach((row, i) => {
      const entry = entries[i];
      const r = computeDay(entry, fmt, step);
      minutes.push(r.minutes);
      const msg = $('.tc-msg', row);
      const out = $('.tc-hours', row);
      row.classList.toggle('has-error', r.error !== null);
      msg.textContent = r.error ? ERRORS[r.error] : r.overnight ? 'Ends the next day.' : '';
      out.textContent = r.error || (!entry.start.trim() && !entry.end.trim()) ? '—' : formatHM(r.minutes);
      if (r.error) errors++;
      if (r.overnight) overnight = true;
      if (normalize && !r.error && r.start && r.end) {
        field(row, '.tc-in').value = r.start;
        field(row, '.tc-out').value = r.end;
      }
    });

    const total = minutes.reduce((a, b) => a + b, 0);
    totalEl.textContent = formatHM(total);
    decEl.textContent = `(${formatDecimalHours(total)} hours)`;
    const otRule = rule.value as OvertimeRule;
    const split = splitOvertime(minutes, otRule);
    regEl.textContent = formatHM(split.regular);
    otEl.textContent = formatHM(split.overtime);
    dtEl.textContent = formatHM(split.doubleTime);
    $('#tc-reg-label', root).textContent = `Regular hours (${formatDecimalHours(split.regular)})`;
    $('#tc-ot-label', root).textContent = `Overtime 1.5× (${formatDecimalHours(split.overtime)})`;
    $('#tc-dt-label', root).textContent = `Double time 2× (${formatDecimalHours(split.doubleTime)})`;
    dtStat.hidden = otRule !== 'california';

    const rateValue = parseNumber(rate.value);
    const pay = rate.value.trim() === '' ? null : grossPay(split, Math.round(rateValue * 100));
    if (pay) {
      payEl.textContent = formatUsd(pay.totalCents);
      const r = Math.round(rateValue * 100);
      const lines = [`Regular ${formatDecimalHours(split.regular)} h × ${formatUsd(r)} = ${formatUsd(pay.regularCents)}`];
      if (split.overtime) lines.push(`Overtime ${formatDecimalHours(split.overtime)} h × ${formatUsd(r * 1.5)} = ${formatUsd(pay.overtimeCents)}`);
      if (split.doubleTime) lines.push(`Double time ${formatDecimalHours(split.doubleTime)} h × ${formatUsd(r * 2)} = ${formatUsd(pay.doubleTimeCents)}`);
      payDetail.textContent = lines.join('\n');
      payDetail.hidden = false;
    } else {
      payEl.textContent = rate.value.trim() === '' ? '—' : 'Check rate';
      payDetail.hidden = true;
    }

    const notes: string[] = [];
    if (errors) notes.push(`${errors} ${errors === 1 ? 'day has' : 'days have'} an entry to fix; ${errors === 1 ? 'it is' : 'they are'} not counted.`);
    if (overnight) notes.push('Overnight shifts count toward the day they start.');
    if (otRule === 'california' && minutes.every((m) => m > 0)) notes.push('All seven days worked: California 7th-day overtime applies to the last day of the workweek.');
    note.textContent = notes.join(' ');
    note.hidden = notes.length === 0;

    savePref('time-card-calculator', {
      format: fmt,
      week: week.value === 'sun' ? 'sun' : 'mon',
      rounding: rounding.value,
      rule: otRule,
      rate: rate.value,
      days: calendarEntries(),
    } satisfies Prefs);
  }

  // Restore
  const saved = loadPref<Partial<Prefs>>('time-card-calculator', {});
  formats.forEach((f) => (f.checked = f.value === (saved.format ?? '12h')));
  if (saved.week === 'sun') week.value = 'sun';
  if (saved.rounding && ['0', '5', '6', '15'].includes(saved.rounding)) rounding.value = saved.rounding;
  if (saved.rule && ['federal', 'california', 'none'].includes(saved.rule)) rule.value = saved.rule;
  rate.value = saved.rate ?? '';
  labelDays();
  setPlaceholders();
  if (Array.isArray(saved.days) && saved.days.length === 7) writeCalendar(saved.days);
  else fill();

  function fill() {
    const twelve = format() === '12h';
    const empty = { start: '', end: '', breakText: '' };
    const work = { start: twelve ? '9:00 AM' : '09:00', end: twelve ? '5:30 PM' : '17:30', breakText: '30' };
    writeCalendar([empty, work, work, work, work, work, empty]);
  }

  root.addEventListener('input', (event) => {
    if ((event.target as Element).matches('.tc-day input, #tc-rate')) render();
  });
  root.addEventListener('focusout', (event) => {
    if ((event.target as Element).matches('.tc-in, .tc-out')) render(true);
  });
  formats.forEach((f) =>
    f.addEventListener('change', () => {
      setPlaceholders();
      render(true);
    }),
  );
  week.addEventListener('change', () => {
    // Keep each entry on its calendar day when the week start changes.
    const prev = week.value === 'sun' ? 'mon' : 'sun';
    const entries = readEntries();
    const byCalendar: DayEntry[] = Array.from({ length: 7 });
    entries.forEach((e, i) => (byCalendar[prev === 'sun' ? i : (i + 1) % 7] = e));
    labelDays();
    writeCalendar(byCalendar);
    render();
  });
  rounding.addEventListener('change', () => render());
  rule.addEventListener('change', () => render());
  $('#tc-fill', root).addEventListener('click', () => {
    fill();
    render();
  });
  $('#tc-clear', root).addEventListener('click', () => {
    writeCalendar(Array.from({ length: 7 }, () => ({ start: '', end: '', breakText: '' })));
    render();
  });
  render(true);
</script>

<style>
  .tc-settings {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 16px;
  }
  .tc-settings .field {
    flex: 1 1 160px;
  }
  .tc-settings .seg {
    align-self: end;
  }
  .tc-days {
    display: grid;
    gap: 8px;
  }
  .tc-head,
  .tc-day {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.7fr);
    grid-template-areas:
      'name name hours'
      'in out brk'
      'msg msg msg';
    gap: 6px 8px;
    align-items: center;
  }
  .tc-day {
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .tc-head {
    padding: 0 11px;
    margin-bottom: -6px;
    grid-template-areas: 'in out brk';
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .tc-h-day,
  .tc-h-hours {
    display: none;
  }
  .tc-h-in {
    grid-area: in;
  }
  .tc-h-out {
    grid-area: out;
  }
  .tc-h-brk {
    grid-area: brk;
  }
  .tc-name {
    grid-area: name;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tc-in {
    grid-area: in;
  }
  .tc-out {
    grid-area: out;
  }
  .tc-break {
    grid-area: brk;
  }
  .tc-hours {
    grid-area: hours;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .tc-msg {
    grid-area: msg;
    font-size: 13px;
    color: var(--muted);
  }
  .tc-msg:empty {
    display: none;
  }
  .tc-day.has-error .tc-msg {
    color: var(--danger);
  }
  .tc-day.has-error input {
    border-color: color-mix(in oklab, var(--danger) 60%, var(--border-strong));
  }
  .tc-day input {
    font-variant-numeric: tabular-nums;
    padding-left: 10px;
    padding-right: 10px;
  }
  @media (min-width: 720px) {
    .tc-head,
    .tc-day {
      grid-template-columns: 110px minmax(0, 1fr) minmax(0, 1fr) 110px 70px;
      grid-template-areas:
        'name in out brk hours'
        '. msg msg msg msg';
    }
    .tc-day {
      padding: 0;
      border: 0;
    }
    .tc-head {
      padding: 0;
      grid-template-areas: 'name in out brk hours';
      margin-bottom: -8px;
    }
    .tc-h-day,
    .tc-h-hours {
      display: block;
    }
    .tc-h-day {
      grid-area: name;
    }
    .tc-h-hours {
      grid-area: hours;
    }
  }
  .tc-dec {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0;
  }
  .stats .stat-value {
    font-size: 19px;
  }
</style>
