---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const FORMATS = [
  ['hex', 'HEX'],
  ['rgb', 'RGB'],
  ['hsl', 'HSL'],
  ['oklch', 'OKLCH'],
];
const CARDS = s.cards;
---

<div class="tool" data-tool="color-converter" {...i18nAttrs(locale, s.client)}>
  <div class="cc-top">
    <input type="color" id="cc-picker" value="#2456e3" aria-label={s.pickerAria} />
    <div class="field">
      <label for="cc-input">{s.inputLabel}</label>
      <input
        id="cc-input"
        type="text"
        class="mono"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        placeholder={s.placeholder} />
    </div>
  </div>
  <div id="cc-error" class="notice error" role="alert" hidden>{`\n${s.parseError}\n`}</div>

  <div class="cc-swatch" aria-hidden="true"><div id="cc-swatch"></div></div>

  <div class="cc-rows">
    {
      FORMATS.map(([key, label]) => (
        <div class="cc-row">
          <label for={`cc-${key}`}>{label}</label>
          <input id={`cc-${key}`} type="text" class="mono" readonly />
          <button class="btn small" type="button" data-copy={`#cc-${key}`}>{s.copy}</button>
        </div>
      ))
    }
  </div>
  <p class="hint cc-note" id="cc-gamut"></p>

  <h2 class="cc-title">{s.contrastTitle}</h2>
  <div class="grid-2">
    {
      CARDS.map(([key, label]) => (
        <div class="cc-card">
          <div class="cc-preview" id={`cc-preview-${key}`}>
            <span class="cc-big">{label} Aa</span>
            <span>{s.sampleBody}</span>
          </div>
          <div class="cc-ratio">
            <span class="cc-ratio-value" id={`cc-ratio-${key}`}>—</span>
            <span class="hint">{s.contrastLabel}</span>
          </div>
          <div class="cc-badges" id={`cc-badges-${key}`}></div>
        </div>
      ))
    }
  </div>
  <p class="hint cc-note">{s.contrastNote}</p>
</div>

<script>
  import { $, debounce, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import {
    BLACK,
    WHITE,
    composite,
    contrastRatio,
    parseColor,
    toHex,
    toHslString,
    toOklchString,
    toRgbString,
    wcag,
    type Rgba,
  } from './logic';

  const root = $('[data-tool="color-converter"]');
  const { s } = readI18n<Strings['client']>(root);
  const input = $<HTMLInputElement>('#cc-input', root);
  const picker = $<HTMLInputElement>('#cc-picker', root);
  const error = $('#cc-error', root);
  const swatch = $('#cc-swatch', root);
  const gamut = $('#cc-gamut', root);
  const field = (key: string) => $<HTMLInputElement>(`#cc-${key}`, root);

  function badges(container: HTMLElement, ratio: number) {
    const r = wcag(ratio);
    const items: [string, boolean][] = [
      ['AA', r.aaNormal],
      ['AAA', r.aaaNormal],
      [`AA${s.largeSuffix}`, r.aaLarge],
      [`AAA${s.largeSuffix}`, r.aaaLarge],
    ];
    container.replaceChildren(
      ...items.map(([label, pass]) => {
        const span = document.createElement('span');
        span.className = `cc-badge ${pass ? 'pass' : 'fail'}`;
        span.textContent = `${label} ${pass ? s.pass : s.fail}`;
        return span;
      }),
    );
  }

  function render(color: Rgba, fromPicker = false) {
    error.hidden = true;
    const hex = toHex(color);
    field('hex').value = hex;
    field('rgb').value = toRgbString(color);
    field('hsl').value = toHslString(color);
    field('oklch').value = toOklchString(color);
    swatch.style.background = toRgbString(color);
    if (!fromPicker) picker.value = hex.slice(0, 7);

    gamut.textContent = color.clipped ? s.gamut : '';

    const opaque = composite(color, WHITE);
    for (const [key, text] of [
      ['white', WHITE],
      ['black', BLACK],
    ] as const) {
      const ratio = contrastRatio(opaque, text);
      const preview = $(`#cc-preview-${key}`, root);
      preview.style.background = toHex(opaque);
      preview.style.color = toHex(text);
      $(`#cc-ratio-${key}`, root).textContent = `${ratio.toFixed(2)} : 1`;
      badges($(`#cc-badges-${key}`, root), ratio);
    }
    savePref('color-converter', input.value.trim() || hex);
  }

  function fromInput() {
    const color = parseColor(input.value);
    if (color) render(color);
    else if (input.value.trim() !== '') error.hidden = false;
  }

  input.addEventListener('input', debounce(fromInput, 100));
  picker.addEventListener('input', () => {
    input.value = picker.value;
    const color = parseColor(picker.value);
    if (color) render(color, true);
  });

  input.value = loadPref('color-converter', '#2456e3');
  fromInput();
  if (!parseColor(input.value)) {
    input.value = '#2456e3';
    fromInput();
  }
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .cc-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: 12px;
  }
  .cc-top input[type='color'] {
    width: 56px;
    height: 42px;
    cursor: pointer;
  }
  .cc-swatch {
    height: 96px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    background-color: var(--surface);
    background-image: repeating-conic-gradient(var(--surface-2) 0% 25%, transparent 0% 50%);
    background-size: 16px 16px;
  }
  .cc-swatch > div {
    height: 100%;
  }
  .cc-rows {
    display: grid;
    gap: 8px;
  }
  .cc-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }
  .cc-row label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .cc-note {
    margin: 0;
  }
  .cc-note:empty {
    display: none;
  }
  .cc-title {
    font-size: 18px;
    margin-top: 8px;
  }
  .cc-card {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cc-preview {
    display: grid;
    gap: 2px;
    padding: 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 14px;
  }
  .cc-big {
    font-size: 22px;
    font-weight: 700;
  }
  .cc-ratio {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .cc-ratio-value {
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .cc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cc-badges :global(.cc-badge) {
    font-size: 13px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .cc-badges :global(.pass) {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 12%, transparent);
  }
  .cc-badges :global(.fail) {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 12%, transparent);
  }
</style>
