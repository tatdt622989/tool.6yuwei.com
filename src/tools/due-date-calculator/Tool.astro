<div class="tool" data-tool="due-date-calculator">
  <div class="field">
    <span class="label">推算依據</span>
    <div class="seg" role="radiogroup" aria-label="推算依據">
      <label><input type="radio" name="dd-method" value="lmp" checked /><span>最後一次月經</span></label>
      <label><input type="radio" name="dd-method" value="conception" /><span>受孕日</span></label>
      <label><input type="radio" name="dd-method" value="ivf3" /><span>試管植入（第 3 天胚胎）</span></label>
      <label><input type="radio" name="dd-method" value="ivf5" /><span>試管植入（第 5 天囊胚）</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="dd-date" id="dd-date-label">最後一次月經第一天</label>
      <input id="dd-date" type="date" />
    </div>
    <div class="field" id="dd-cycle-field">
      <label for="dd-cycle">月經週期（天）</label>
      <input id="dd-cycle" type="text" inputmode="numeric" autocomplete="off" value="28" />
      <span class="hint">從這次月經第一天到下次月經第一天的天數，一般為 28 天。</span>
    </div>
  </div>

  <div class="notice error" id="dd-error" hidden></div>

  <div id="dd-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="dd-due">—</div>
      <div class="result-label">預產期（懷孕滿 40 週）</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="dd-age">—</span><span class="stat-label">目前懷孕週數</span></div>
      <div class="stat"><span class="stat-value" id="dd-tri">—</span><span class="stat-label">孕期（國健署分期）</span></div>
      <div class="stat"><span class="stat-value" id="dd-left">—</span><span class="stat-label">距離預產期</span></div>
      <div class="stat"><span class="stat-value" id="dd-conc">—</span><span class="stat-label">推估受孕日</span></div>
    </div>

    <div class="dd-progress" aria-hidden="true"><span id="dd-bar"></span></div>

    <div class="field">
      <span class="label">國健署公費產檢與篩檢時程</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>項目</th><th class="num">懷孕週數</th><th>建議日期</th><th>狀態</th></tr>
          </thead>
          <tbody id="dd-table"></tbody>
        </table>
      </div>
      <span class="hint">實際產檢日期請依產檢醫院安排；公費項目以國健署最新公告為準。</span>
    </div>
  </div>

  <p class="notice">結果僅供參考，請諮詢醫師。只有約 4%–5% 的寶寶剛好在預產期當天出生，37 到 42 週之間出生都屬足月；醫師會依早期超音波量測的胎兒大小校正預產期。日期只在你的瀏覽器中計算，不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, parseNumber } from '../../lib/format';
  import { addDays, parseISODate, toISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import { calcDue, TRIMESTER_LABEL, validateDueInput, type DueInput, type DueMethod, type MilestoneStatus } from './logic';

  const root = $('[data-tool="due-date-calculator"]');
  const methods = $$<HTMLInputElement>('input[name="dd-method"]', root);
  const dateInput = $<HTMLInputElement>('#dd-date', root);
  const dateLabel = $('#dd-date-label', root);
  const cycleField = $('#dd-cycle-field', root);
  const cycleInput = $<HTMLInputElement>('#dd-cycle', root);
  const error = $('#dd-error', root);
  const output = $('#dd-output', root);
  const table = $('#dd-table', root);
  const bar = $('#dd-bar', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  const DATE_LABEL: Record<DueMethod, string> = {
    lmp: '最後一次月經第一天',
    conception: '受孕日（排卵或同房日）',
    ivf3: '胚胎植入日（第 3 天胚胎）',
    ivf5: '囊胚植入日（第 5 天囊胚）',
  };
  const STATUS_LABEL: Record<MilestoneStatus, string> = { done: '已過', current: '進行中', upcoming: '未到' };

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }
  const fmt = (d: YMD) => `${d.y}/${d.m}/${d.d}（${WEEKDAY_LABEL[weekdayOf(d)]}）`;
  const method = (): DueMethod => (methods.find((m) => m.checked)?.value ?? 'lmp') as DueMethod;

  const saved = loadPref<{ method: DueMethod; date: string; cycle: string }>('due-date-calculator', {
    method: 'lmp',
    date: toISODate(addDays(today(), -84)),
    cycle: '28',
  });
  for (const m of methods) m.checked = m.value === saved.method;
  if (!methods.some((m) => m.checked)) methods[0].checked = true;
  dateInput.value = saved.date;
  cycleInput.value = saved.cycle;
  dateInput.max = toISODate(today());

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const m = method();
    dateLabel.textContent = DATE_LABEL[m];
    cycleField.hidden = m !== 'lmp';
    savePref('due-date-calculator', { method: m, date: dateInput.value, cycle: cycleInput.value });

    const date = parseISODate(dateInput.value);
    if (!date) return fail('請選擇日期。');
    const input: DueInput = { method: m, date, cycle: m === 'lmp' ? parseNumber(cycleInput.value) : 28 };
    const now = today();
    const problem = validateDueInput(input, now);
    const r = problem ? null : calcDue(input, now);
    if (!r) return fail(problem ?? '無法計算，請檢查輸入。');
    error.hidden = true;
    output.hidden = false;

    set('#dd-due', `${r.due.y} 年 ${r.due.m} 月 ${r.due.d} 日（${WEEKDAY_LABEL[weekdayOf(r.due)]}）`);
    const age = r.age.totalDays < 0 ? { weeks: 0, days: 0 } : r.age;
    set('#dd-age', `${age.weeks} 週 ${age.days} 天`);
    set('#dd-tri', TRIMESTER_LABEL[Math.max(1, r.trimester)]);
    set('#dd-left', r.daysToDue >= 0 ? `${formatInteger(r.daysToDue)} 天` : `已過 ${formatInteger(-r.daysToDue)} 天`);
    set('#dd-conc', `${r.conception.m}/${r.conception.d}`);
    bar.style.width = `${r.progress}%`;

    table.innerHTML = r.milestones
      .map((x) => {
        const weeks = x.week === x.toWeek ? `${x.week} 週` : `${x.week}–${x.toWeek} 週`;
        const dates = x.week === x.toWeek ? `${fmt(x.from)} 起` : `${fmt(x.from)} – ${fmt(x.to)}`;
        return `<tr class="dd-${x.status}"><td>${x.label}</td><td class="num">${weeks}</td><td>${dates}</td><td>${STATUS_LABEL[x.status]}</td></tr>`;
      })
      .join('');
  }

  methods.forEach((m) => m.addEventListener('change', render));
  dateInput.addEventListener('input', render);
  cycleInput.addEventListener('input', render);
  render();
</script>

<style>
  #dd-output {
    display: grid;
    gap: 16px;
  }
  .dd-progress {
    height: 8px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .dd-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: inherit;
    transition: width 0.2s;
  }
  #dd-table :global(.dd-done td) {
    color: var(--muted);
  }
  #dd-table :global(.dd-current td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
