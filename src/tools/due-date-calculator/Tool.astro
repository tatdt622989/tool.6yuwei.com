---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="due-date-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <span class="label">{s.methodLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.methodLabel}>
      <label><input type="radio" name="dd-method" value="lmp" checked /><span>{s.methods.lmp}</span></label>
      <label><input type="radio" name="dd-method" value="conception" /><span>{s.methods.conception}</span></label>
      <label><input type="radio" name="dd-method" value="ivf3" /><span>{s.methods.ivf3}</span></label>
      <label><input type="radio" name="dd-method" value="ivf5" /><span>{s.methods.ivf5}</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="dd-date" id="dd-date-label">{s.client.dateLabels.lmp}</label>
      <input id="dd-date" type="date" />
    </div>
    <div class="field" id="dd-cycle-field">
      <label for="dd-cycle">{s.cycleLabel}</label>
      <input id="dd-cycle" type="text" inputmode="numeric" autocomplete="off" value="28" />
      <span class="hint">{s.cycleHint}</span>
    </div>
  </div>

  <div class="notice error" id="dd-error" hidden></div>

  <div id="dd-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="dd-due">—</div>
      <div class="result-label">{s.dueLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="dd-age">—</span><span class="stat-label">{s.ageLabel}</span></div>{
        s.monthLabel && (
          <div class="stat">
            <span class="stat-value" id="dd-month">—</span>
            <span class="stat-label">{s.monthLabel}</span>
          </div>
        )
      }
      <div class="stat"><span class="stat-value" id="dd-tri">—</span><span class="stat-label">{s.triLabel}</span></div>
      <div class="stat"><span class="stat-value" id="dd-left">—</span><span class="stat-label">{s.leftLabel}</span></div>
      <div class="stat"><span class="stat-value" id="dd-conc">—</span><span class="stat-label">{s.concLabel}</span></div>
    </div>

    <div class="dd-progress" aria-hidden="true"><span id="dd-bar"></span></div>

    <div class="field">
      <span class="label">{s.tableLabel}</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>{s.thItem}</th><th class="num">{s.thWeeks}</th><th>{s.thDate}</th><th>{s.thStatus}</th></tr>
          </thead>
          <tbody id="dd-table"></tbody>
        </table>
      </div>
      <span class="hint">{s.tableHint}</span>
    </div>
  </div>

  <p class="notice">{s.notice}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { formatDate, plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { addDays, parseISODate, toISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import { calcDue, dueInputError, pregnancyMonthJp, type DueInput, type DueMethod, type Milestone, type ScheduleId } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="due-date-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const schedule: ScheduleId = s.schedule ?? 'tw';
  const methods = $$<HTMLInputElement>('input[name="dd-method"]', root);
  const dateInput = $<HTMLInputElement>('#dd-date', root);
  const dateLabel = $('#dd-date-label', root);
  const cycleField = $('#dd-cycle-field', root);
  const cycleInput = $<HTMLInputElement>('#dd-cycle', root);
  const error = $('#dd-error', root);
  const output = $('#dd-output', root);
  const table = $('#dd-table', root);
  const bar = $('#dd-bar', root);
  const monthEl = root.querySelector<HTMLElement>('#dd-month');
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }
  const toDate = (d: YMD) => new Date(d.y, d.m - 1, d.d);
  const fmt = (d: YMD) => `${d.y}/${d.m}/${d.d}（${WEEKDAY_LABEL[weekdayOf(d)]}）`;
  const method = (): DueMethod => (methods.find((m) => m.checked)?.value ?? 'lmp') as DueMethod;

  /** Due date headline: Intl for en / ja, the original hand-built format for zh-TW. */
  function dueText(d: YMD): string {
    if (s.intl) return formatDate(toDate(d), locale, s.intl.due);
    return `${d.y} 年 ${d.m} 月 ${d.d} 日（${WEEKDAY_LABEL[weekdayOf(d)]}）`;
  }

  function milestoneLabel(x: Milestone): string {
    if (x.kind === 'visit' && s.visit) return t(s.visit, { n: x.n ?? 0 });
    return s.windows?.[x.id] ?? x.label;
  }

  function milestoneDates(x: Milestone): string {
    if (!s.intl) return x.week === x.toWeek ? `${fmt(x.from)} 起` : `${fmt(x.from)} – ${fmt(x.to)}`;
    const df = new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, s.intl.table);
    if (x.point) return df.format(toDate(x.from));
    if (s.intl.rangeSep) return `${df.format(toDate(x.from))}${s.intl.rangeSep}${df.format(toDate(x.to))}`;
    return df.formatRange(toDate(x.from), toDate(x.to));
  }

  const saved = loadPref<{ method: DueMethod; date: string; cycle: string }>('due-date-calculator', {
    method: 'lmp',
    date: toISODate(addDays(today(), -84)),
    cycle: '28',
  });
  for (const m of methods) m.checked = m.value === saved.method;
  if (!methods.some((m) => m.checked)) methods[0].checked = true;
  dateInput.value = saved.date;
  cycleInput.value = saved.cycle;
  dateInput.max = toISODate(today());

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const m = method();
    dateLabel.textContent = s.dateLabels[m];
    cycleField.hidden = m !== 'lmp';
    savePref('due-date-calculator', { method: m, date: dateInput.value, cycle: cycleInput.value });

    const date = parseISODate(dateInput.value);
    if (!date) return fail(s.errorDate);
    const input: DueInput = { method: m, date, cycle: m === 'lmp' ? parseNumber(cycleInput.value) : 28 };
    const now = today();
    const problem = dueInputError(input, now);
    const r = problem ? null : calcDue(input, now, schedule);
    if (!r) return fail(problem ? s.errors[problem] : s.errorGeneric);
    error.hidden = true;
    output.hidden = false;

    set('#dd-due', dueText(r.due));
    const age = r.age.totalDays < 0 ? { weeks: 0, days: 0 } : r.age;
    set('#dd-age', t(s.age, { weeks: plural(locale, age.weeks, s.weeks), days: plural(locale, age.days, s.days) }));
    if (monthEl && s.month) monthEl.textContent = t(s.month, { n: pregnancyMonthJp(age.weeks) });
    set('#dd-tri', s.trimesters[Math.max(1, r.trimester)]);
    set('#dd-left', r.daysToDue >= 0 ? plural(locale, r.daysToDue, s.left) : plural(locale, -r.daysToDue, s.overdue));
    set('#dd-conc', s.intl ? formatDate(toDate(r.conception), locale, s.intl.short) : `${r.conception.m}/${r.conception.d}`);
    bar.style.width = `${r.progress}%`;

    table.innerHTML = r.milestones
      .map((x) => {
        const weeks = x.week === x.toWeek ? t(s.weekOne, { w: x.week }) : t(s.weekRange, { a: x.week, b: x.toWeek });
        return `<tr class="dd-${x.status}"><td>${milestoneLabel(x)}</td><td class="num">${weeks}</td><td>${milestoneDates(x)}</td><td>${s.status[x.status]}</td></tr>`;
      })
      .join('');
  }

  methods.forEach((m) => m.addEventListener('change', render));
  dateInput.addEventListener('input', render);
  cycleInput.addEventListener('input', render);
  render();
</script>

<style>
  #dd-output {
    display: grid;
    gap: 16px;
  }
  .dd-progress {
    height: 8px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .dd-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: inherit;
    transition: width 0.2s;
  }
  #dd-table :global(.dd-done td) {
    color: var(--muted);
  }
  #dd-table :global(.dd-current td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
