---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { ROUNDS } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const c = s.client;
---

<div class="tool" data-tool="reaction-test" {...i18nAttrs(locale, c)}>
  <div class="rt-stage" id="rt-stage" role="button" tabindex="0" data-phase="idle" aria-describedby="rt-text">
    <svg class="rt-ico rt-ico-idle" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
    </svg>
    <svg class="rt-ico rt-ico-waiting" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2M9.5 2.5h5" />
    </svg>
    <svg class="rt-ico rt-ico-go" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.2" />
    </svg>
    <svg class="rt-ico rt-ico-early" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3.5l9.5 16.5h-19z" /><path d="M12 10v4.5M12 17.2v.1" />
    </svg>
    <svg class="rt-ico rt-ico-result" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.8 2.8L16.5 9.5" />
    </svg>
    <span class="rt-title" id="rt-title">{c.titleIdle}</span>
    <span class="rt-text" id="rt-text">{c.textIdle}</span>
    <span class="rt-round" id="rt-round">{t(s.roundTotal, { n: ROUNDS })}</span>
  </div>
  <p class="visually-hidden" aria-live="assertive" id="rt-live"></p>

  <ol class="rt-rounds" id="rt-rounds" aria-label={s.roundsAria}></ol>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="rt-avg">—</span><span class="stat-label">{s.statAvg}</span></div>
    <div class="stat"><span class="stat-value" id="rt-best">—</span><span class="stat-label">{s.statBest}</span></div>
    <div class="stat"><span class="stat-value" id="rt-early">0</span><span class="stat-label">{s.statEarly}</span></div>
    <div class="stat"><span class="stat-value" id="rt-record">—</span><span class="stat-label">{s.statRecord}</span></div>
  </div>

  <section class="result rt-result" id="rt-result" hidden aria-live="polite">
    <div class="rt-result-head">
      <div>
        <span class="result-label">{t(s.resultLabel, { n: ROUNDS })}</span>
        <div class="result-value"><span id="rt-final">0</span> <small>{s.unit}</small></div>
      </div>
      <div class="rt-rating">
        <span class="rt-badge" id="rt-rating">{c.ratings.average.label}</span>
        <span class="rt-rating-note" id="rt-rating-note"></span>
      </div>
    </div>
    <div class="rt-scale" aria-hidden="true">
      <div class="rt-scale-track">
        <span class="rt-scale-band" title={s.scaleBand}></span>
        <span class="rt-scale-marker" id="rt-marker"></span>
      </div>
      <div class="rt-scale-labels"><span>100</span><span>200</span><span>300</span><span>400</span><span>500 ms</span></div>
    </div>
    <p class="rt-summary" id="rt-summary"></p>
  </section>

  <div class="row">
    <button class="btn" type="button" id="rt-restart">{s.restart}</button>
    <button class="btn ghost small" type="button" id="rt-clear">{s.clear}</button>
  </div>
  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { RatingId, Strings } from './i18n';
  import {
    ROUNDS,
    SUSPECT_MS,
    abort,
    createState,
    currentRound,
    mergeBest,
    press,
    rateMs,
    sanitizeBest,
    showGo,
    summarize,
    type BestRecord,
    type ReactionState,
  } from './logic';

  const root = $('[data-tool="reaction-test"]');
  const { locale, s: str } = readI18n<Strings['client']>(root);
  const ratingText = (id: string) => str.ratings[id as RatingId];
  const stage = $('#rt-stage', root);
  const title = $('#rt-title', root);
  const text = $('#rt-text', root);
  const roundEl = $('#rt-round', root);
  const live = $('#rt-live', root);
  const rounds = $('#rt-rounds', root);
  const avgEl = $('#rt-avg', root);
  const bestEl = $('#rt-best', root);
  const earlyEl = $('#rt-early', root);
  const recordEl = $('#rt-record', root);
  const result = $('#rt-result', root);
  const finalEl = $('#rt-final', root);
  const ratingEl = $('#rt-rating', root);
  const ratingNote = $('#rt-rating-note', root);
  const marker = $('#rt-marker', root);
  const summary = $('#rt-summary', root);

  let state: ReactionState = createState();
  let record: BestRecord = sanitizeBest(loadPref<unknown>('reaction-test', null));
  let timer = 0;
  let raf = 0;

  const ms = (n: number) => formatInteger(n, locale);

  /** Prefer the event's own high-resolution timestamp (same clock as performance.now()). */
  function eventTime(event: Event): number {
    const now = performance.now();
    const t = event.timeStamp;
    return t > 0 && t <= now && now - t < 1000 ? t : now;
  }

  function announce(message: string) {
    live.textContent = message;
  }

  function renderRounds() {
    rounds.replaceChildren(
      ...Array.from({ length: ROUNDS }, (_, i) => {
        const li = document.createElement('li');
        const label = document.createElement('span');
        label.className = 'rt-slot-label';
        label.textContent = t(str.roundLabel, { i: i + 1 });
        const value = document.createElement('span');
        value.className = 'rt-slot-value';
        const r = state.results[i];
        if (r === undefined) {
          value.textContent = '—';
        } else {
          value.textContent = t(str.msShort, { ms: ms(r) });
          li.classList.add('is-done');
          if (r < SUSPECT_MS) {
            li.classList.add('is-suspect');
            li.title = str.suspect;
          }
        }
        if (i === state.results.length && state.phase !== 'done') li.classList.add('is-current');
        li.append(label, value);
        return li;
      }),
    );
  }

  function renderStats() {
    const s = summarize(state.results);
    avgEl.textContent = s ? ms(s.average) : '—';
    bestEl.textContent = s ? ms(s.best) : '—';
    earlyEl.textContent = String(state.earlyCount);
    recordEl.textContent = record.bestAverage === null ? '—' : t(str.msShort, { ms: ms(record.bestAverage) });
  }

  function render() {
    stage.dataset.phase = state.phase;
    const round = currentRound(state);
    const last = state.results[state.results.length - 1];
    switch (state.phase) {
      case 'idle':
        title.textContent = state.results.length ? str.titlePaused : str.titleIdle;
        text.textContent = state.results.length ? t(str.textContinue, { round }) : str.textIdle;
        break;
      case 'waiting':
        title.textContent = str.titleWaiting;
        text.textContent = str.textWaiting;
        break;
      case 'go':
        title.textContent = str.titleGo;
        text.textContent = str.textGo;
        break;
      case 'early':
        title.textContent = str.titleEarly;
        text.textContent = str.textEarly;
        break;
      case 'result':
        title.textContent = t(str.titleResult, { ms: ms(last) });
        text.textContent = t(str.textResult, { next: round + 1 });
        break;
      case 'done': {
        const s = summarize(state.results);
        title.textContent = t(str.titleDone, { avg: s ? ms(s.average) : '—' });
        text.textContent = t(str.textDone, { rating: s ? ratingText(rateMs(s.average).id).label : '' });
        break;
      }
    }
    roundEl.textContent = state.phase === 'done' ? t(str.roundDone, { n: ROUNDS }) : t(str.roundOf, { round, n: ROUNDS });
    renderRounds();
    renderStats();
  }

  function renderResult(newAverage: boolean) {
    const s = summarize(state.results);
    if (!s) return;
    const rating = rateMs(s.average);
    finalEl.textContent = ms(s.average);
    ratingEl.textContent = ratingText(rating.id).label;
    ratingEl.dataset.rating = rating.id;
    ratingNote.textContent = ratingText(rating.id).note;
    const pct = Math.min(100, Math.max(0, ((s.average - 100) / 400) * 100));
    marker.style.left = `${pct}%`;
    summary.textContent =
      t(str.summary, { best: ms(s.best), worst: ms(s.worst), median: ms(s.median) }) +
      (newAverage ? str.summaryNew : record.bestAverage !== null ? t(str.summaryRecord, { record: ms(record.bestAverage) }) : '') +
      (state.earlyCount ? t(str.summaryEarly, { times: plural(locale, state.earlyCount, str.times) }) : '');
    result.hidden = false;
  }

  function cancelTimers() {
    window.clearTimeout(timer);
    cancelAnimationFrame(raf);
    timer = 0;
    raf = 0;
  }

  function turnGreen() {
    raf = requestAnimationFrame((frameTime) => {
      if (state.phase !== 'waiting') return;
      // The DOM change below is painted in this frame; time the reaction from its start.
      state = showGo(state, frameTime);
      render();
      announce(str.announceGo);
    });
  }

  function handlePress(now: number) {
    const before = state;
    state = press(state, now);
    if (state === before) return;
    cancelTimers();
    if (state.phase === 'waiting') {
      result.hidden = true;
      timer = window.setTimeout(turnGreen, Math.max(0, (state.goDueAt ?? now) - performance.now()));
      announce(str.announceWaiting);
    } else if (state.phase === 'early') {
      announce(str.announceEarly);
    } else if (state.phase === 'result') {
      announce(t(str.announceResult, { ms: ms(state.results[state.results.length - 1]) }));
    } else if (state.phase === 'done') {
      const merged = mergeBest(record, state.results);
      record = merged.best;
      savePref('reaction-test', record);
      renderResult(merged.newAverage);
      const s = summarize(state.results);
      if (s) announce(t(str.announceDone, { avg: ms(s.average) }));
    }
    render();
  }

  stage.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    const t = eventTime(event);
    stage.focus({ preventScroll: true });
    handlePress(t);
  });
  stage.addEventListener('keydown', (event) => {
    if (event.code !== 'Space' && event.key !== ' ' && event.key !== 'Enter') return;
    event.preventDefault();
    if (event.repeat) return;
    handlePress(eventTime(event));
  });
  stage.addEventListener('contextmenu', (event) => event.preventDefault());

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) return;
    const next = abort(state);
    if (next !== state) {
      cancelTimers();
      state = next;
      render();
    }
  });

  $('#rt-restart', root).addEventListener('click', () => {
    cancelTimers();
    state = createState();
    result.hidden = true;
    render();
    stage.focus({ preventScroll: true });
  });
  $('#rt-clear', root).addEventListener('click', () => {
    record = { bestAverage: null, bestSingle: null };
    savePref('reaction-test', record);
    renderStats();
  });

  render();
</script>

<style>
  .rt-stage {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    min-height: clamp(240px, 46vh, 380px);
    padding: 28px 16px;
    text-align: center;
    border-radius: var(--radius);
    border: 2px solid transparent;
    background: var(--accent-soft);
    color: var(--text);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    /* No background transition: the colour change must be instant for accurate timing. */
  }
  .rt-stage[data-phase='idle'] {
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border));
  }
  .rt-stage[data-phase='waiting'] {
    background: var(--danger);
    color: var(--on-accent);
  }
  .rt-stage[data-phase='go'] {
    background: var(--success);
    color: var(--on-accent);
  }
  .rt-stage[data-phase='early'] {
    background: color-mix(in oklab, var(--warning) 18%, var(--surface));
    border-color: var(--warning);
  }
  .rt-stage[data-phase='result'],
  .rt-stage[data-phase='done'] {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  .rt-ico {
    display: none;
  }
  .rt-stage[data-phase='idle'] .rt-ico-idle,
  .rt-stage[data-phase='waiting'] .rt-ico-waiting,
  .rt-stage[data-phase='go'] .rt-ico-go,
  .rt-stage[data-phase='early'] .rt-ico-early,
  .rt-stage[data-phase='result'] .rt-ico-result,
  .rt-stage[data-phase='done'] .rt-ico-result {
    display: block;
  }
  .rt-stage[data-phase='idle'] .rt-ico,
  .rt-stage[data-phase='result'] .rt-ico,
  .rt-stage[data-phase='done'] .rt-ico {
    color: var(--accent);
  }
  .rt-stage[data-phase='early'] .rt-ico {
    color: var(--warning);
  }
  .rt-title {
    font-size: clamp(30px, 8vw, 52px);
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .rt-text {
    max-width: 32em;
    font-size: 15px;
  }
  .rt-round {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0.8;
  }
  .rt-stage[data-phase='idle'] .rt-text,
  .rt-stage[data-phase='early'] .rt-text,
  .rt-stage[data-phase='result'] .rt-text,
  .rt-stage[data-phase='done'] .rt-text {
    color: var(--text-2);
  }

  .rt-rounds {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rt-rounds :global(li) {
    display: grid;
    gap: 2px;
    padding: 8px 6px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .rt-rounds :global(li.is-current) {
    border-color: var(--accent);
  }
  .rt-rounds :global(li.is-done) {
    background: var(--surface-2);
  }
  .rt-rounds :global(li.is-suspect .rt-slot-value) {
    color: var(--warning);
  }
  .rt-rounds :global(.rt-slot-label) {
    font-size: 12px;
    color: var(--muted);
  }
  .rt-rounds :global(.rt-slot-value) {
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .rt-rounds :global(.rt-slot-value) {
      font-size: 13px;
    }
  }

  .rt-result {
    display: grid;
    gap: 14px;
  }
  .rt-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .rt-result small {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-2);
  }
  .rt-rating {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }
  @media (max-width: 480px) {
    .rt-rating {
      justify-items: start;
      text-align: left;
    }
  }
  .rt-badge {
    padding: 4px 12px;
    font-size: 18px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 999px;
  }
  .rt-rating-note {
    font-size: 13px;
    color: var(--text-2);
  }
  .rt-scale {
    display: grid;
    gap: 4px;
  }
  .rt-scale-track {
    position: relative;
    height: 10px;
    border-radius: 5px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .rt-scale-band {
    position: absolute;
    top: 0;
    bottom: 0;
    /* 200–270 ms on a 100–500 ms scale */
    left: 25%;
    width: 17.5%;
    background: color-mix(in oklab, var(--success) 35%, transparent);
  }
  .rt-scale-marker {
    position: absolute;
    top: -5px;
    width: 4px;
    height: 18px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .rt-scale-labels {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .rt-summary {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }
</style>
