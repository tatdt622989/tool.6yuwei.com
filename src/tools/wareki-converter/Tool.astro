---
// ja-only tool: strings are written in Japanese here (see docs/i18n.md §3).
import type { ToolProps } from '../../i18n/tool';
import { ageTable, eraLastYear, eraOffset, ERAS } from './logic';

type Props = ToolProps;

// The 年齢早見表 is rendered at build time so every row is in the HTML; the script only refreshes ages
// and the highlighted row if the calendar year has changed since the build.
const buildYear = new Date().getFullYear();
const rows = ageTable(buildYear, 1926);
const erasNewestFirst = [...ERAS].reverse();
const fmtStart = (e: (typeof ERAS)[number]) => `${e.start.y}年${e.start.m}月${e.start.d}日`;
---

<div class="tool" data-tool="wareki-converter" data-build-year={buildYear}>
  <section class="wk-block" aria-labelledby="wk-year-title">
    <h2 class="wk-title" id="wk-year-title">年を変換する</h2>
    <div class="seg" role="radiogroup" aria-label="変換の向き">
      <label><input type="radio" name="wk-dir" value="ad" checked /><span>西暦 → 和暦</span></label>
      <label><input type="radio" name="wk-dir" value="wareki" /><span>和暦 → 西暦</span></label>
    </div>

    <div class="row wk-inputs">
      <div class="field wk-era" id="wk-era-field" hidden>
        <label for="wk-era">元号</label>
        <select id="wk-era">
          {erasNewestFirst.map((e) => <option value={e.name}>{e.name}</option>)}
        </select>
      </div>
      <div class="field wk-year">
        <label for="wk-year" id="wk-year-label">西暦（年）</label>
        <input id="wk-year" type="text" inputmode="numeric" autocomplete="off" value={String(buildYear)} />
      </div>
    </div>

    <p class="notice error" id="wk-error" hidden></p>

    <div class="result" aria-live="polite">
      <div class="result-value" id="wk-main">—</div>
      <div class="result-label" id="wk-sub"></div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="wk-ad">—</span><span class="stat-label">西暦</span></div>
      <div class="stat"><span class="stat-value" id="wk-wareki">—</span><span class="stat-label">和暦</span></div>
      <div class="stat"><span class="stat-value" id="wk-eto">—</span><span class="stat-label" id="wk-eto-label">干支</span></div>
      <div class="stat"><span class="stat-value" id="wk-age">—</span><span class="stat-label" id="wk-age-label">今年の満年齢</span></div>
    </div>
  </section>

  <section class="wk-block" aria-labelledby="wk-date-title">
    <h2 class="wk-title" id="wk-date-title">日付を変換する</h2>
    <div class="field">
      <label for="wk-date">西暦または和暦の日付</label>
      <div class="row wk-date-row">
        <input id="wk-date" type="text" autocomplete="off" placeholder="例：2019/5/1、平成31年4月30日、R8.10.29" />
        <button class="btn" type="button" id="wk-today">今日</button>
      </div>
      <span class="hint">「2026/10/29」「2026年10月29日」「20261029」のほか、「令和8年10月29日」「令和元年5月1日」「R8.10.29」「H31/4/30」のような和暦も読み取ります。</span>
    </div>
    <div class="wk-date-out">
      <div class="row between wk-line">
        <span><span class="muted">西暦</span> <strong id="wk-d-ad">—</strong></span>
        <button type="button" class="btn small" data-copy="#wk-d-ad">コピー</button>
      </div>
      <div class="row between wk-line">
        <span><span class="muted">和暦</span> <strong id="wk-d-wareki">—</strong></span>
        <button type="button" class="btn small" data-copy="#wk-d-wareki">コピー</button>
      </div>
      <div class="row between wk-line">
        <span><span class="muted">略記</span> <strong id="wk-d-short">—</strong></span>
        <button type="button" class="btn small" data-copy="#wk-d-short">コピー</button>
      </div>
      <p class="hint" id="wk-d-note"></p>
    </div>
  </section>

  <div class="field">
    <span class="label">元号一覧（明治以降）</span>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>元号</th><th>略号</th><th>始まり（西暦）</th><th>年数</th><th>西暦への換算</th></tr>
        </thead>
        <tbody>
          {
            erasNewestFirst.map((e) => (
              <tr>
                <td>
                  {e.name}
                  <span class="muted">（{e.reading}）</span>
                </td>
                <td>{e.letter}</td>
                <td>{fmtStart(e)}</td>
                <td>{eraLastYear(e) === null ? '継続中' : `${eraLastYear(e)}年まで`}</td>
                <td>
                  {e.name}の年 ＋ {eraOffset(e)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">明治の始まりは改元の際に慶応4年1月1日（旧暦、西暦1868年1月25日）にさかのぼって適用されたものです。日本がグレゴリオ暦を使い始めたのは明治6年（1873年）1月1日からです。</span>
  </div>

  <div class="field">
    <span class="label" id="wk-table-title">年齢早見表（{buildYear}年版・1926〜{buildYear}年生まれ）</span>
    <div class="table-wrap wk-table-wrap" id="wk-table-wrap">
      <table class="table wk-table">
        <thead>
          <tr>
            <th>生まれ年</th>
            <th>和暦</th>
            <th>干支</th>
            <th class="num">満年齢</th>
            <th class="num">誕生日前</th>
            <th>小学校入学</th>
            <th>中学卒業</th>
            <th>高校卒業</th>
            <th>大学卒業</th>
          </tr>
        </thead>
        <tbody id="wk-table">
          {
            rows.map((r) => (
              <tr data-ad={r.ad} class={r.ad === buildYear ? 'is-current' : undefined}>
                <td>{r.ad}年</td>
                <td>{r.wareki}</td>
                <td>
                  {r.eto.kanshi}
                  <span class="muted">（{r.eto.branchReading}）</span>
                </td>
                <td class="num wk-age">{r.age}歳</td>
                <td class="num wk-age-before">{r.age >= 1 ? `${r.age - 1}歳` : '—'}</td>
                {r.ad >= 1940 ? (
                  <>
                    <td>{r.school.elementary}年4月</td>
                    <td>{r.school.juniorHighGrad}年3月</td>
                    <td>{r.school.highGrad}年3月</td>
                    <td>{r.school.univGrad}年3月</td>
                  </>
                ) : (
                  <>
                    <td class="muted">—</td>
                    <td class="muted">—</td>
                    <td class="muted">—</td>
                    <td class="muted">—</td>
                  </>
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">満年齢は「その年の誕生日を迎えた後」の年齢です。入学・卒業年は4月2日〜12月31日生まれの場合で、1月1日〜4月1日生まれ（早生まれ）はそれぞれ1年早くなります。浪人・留年・飛び級は考慮していません。1939年以前生まれは旧学制のため省略しています。</span>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { toDayNumber, type YMD } from '../date-diff/logic';
  import {
    adToWarekiYears,
    eraLastYear,
    etoOf,
    findEra,
    formatAdJa,
    formatAdSlash,
    fromWareki,
    isYearInEra,
    parseDateInput,
    schoolYears,
    toWareki,
    warekiYearsText,
    warekiYearToAD,
  } from './logic';

  type Dir = 'ad' | 'wareki';
  interface Prefs {
    dir: Dir;
    year: string;
    era: string;
    date: string;
  }

  const root = $('[data-tool="wareki-converter"]');
  const dirs = $$<HTMLInputElement>('input[name="wk-dir"]', root);
  const yearInput = $<HTMLInputElement>('#wk-year', root);
  const eraSel = $<HTMLSelectElement>('#wk-era', root);
  const dateInput = $<HTMLInputElement>('#wk-date', root);
  const error = $('#wk-error', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const now = new Date();
  const today: YMD = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  const currentYear = today.y;

  const dir = (): Dir => (dirs.find((d) => d.checked)?.value === 'wareki' ? 'wareki' : 'ad');

  /** 「元」 or digits → year number. */
  function readWarekiYear(): number {
    const v = yearInput.value.trim();
    if (v === '元' || v === '元年') return 1;
    return Math.trunc(parseNumber(v.replace(/年$/, '')));
  }

  function clearYear(message: string) {
    error.textContent = message;
    error.hidden = message === '';
    ['#wk-main', '#wk-ad', '#wk-wareki', '#wk-eto', '#wk-age'].forEach((id) => set(id, '—'));
    set('#wk-sub', '');
  }

  function renderYear() {
    const d = dir();
    $('#wk-era-field', root).hidden = d !== 'wareki';
    set('#wk-year-label', d === 'ad' ? '西暦（年）' : '年（元年は 1）');
    let ad: number;
    let note = '';
    if (d === 'ad') {
      ad = Math.trunc(parseNumber(yearInput.value.replace(/年$/, '')));
      if (!Number.isFinite(ad) || ad < 1868 || ad > 2200) {
        clearYear('1868〜2200 の西暦年を入力してください（例：2026）。');
        return;
      }
    } else {
      const era = findEra(eraSel.value);
      const n = readWarekiYear();
      if (!era || !Number.isFinite(n) || n < 1 || n > 200) {
        clearYear('年を数字で入力してください（例：8、元年は 1）。');
        return;
      }
      ad = warekiYearToAD(era, n);
      if (!isYearInEra(era, n)) {
        const actual = adToWarekiYears(ad).at(-1);
        note = `${era.name}は${eraLastYear(era)}年までです。西暦${ad}年は${actual ? actual.label : '—'}にあたります。`;
      }
    }
    error.textContent = note;
    error.hidden = note === '';
    const wareki = warekiYearsText(ad);
    const eto = etoOf(ad);
    if (d === 'ad') set('#wk-main', `${ad}年は${wareki.replace('／', '・')}`);
    else set('#wk-main', `${eraSel.value}${readWarekiYear() === 1 ? '元' : readWarekiYear()}年は${ad}年`);
    const s = schoolYears(ad);
    const age = currentYear - ad;
    set(
      '#wk-sub',
      `干支は${eto.kanshi}（${eto.reading}）。` +
        (age >= 0
          ? `この年の4月2日〜12月31日生まれは${s.elementary}年4月に小学校入学、${s.highGrad}年3月に高校卒業の学年です。`
          : ''),
    );
    set('#wk-ad', `${ad}年`);
    set('#wk-wareki', wareki);
    set('#wk-eto', eto.kanshi);
    set('#wk-eto-label', `干支（${eto.branch}年・${eto.branchReading}どし）`);
    if (age >= 0) {
      set('#wk-age', `${age}歳`);
      set('#wk-age-label', `${currentYear}年の誕生日後の満年齢（誕生日前は${Math.max(0, age - 1)}歳）`);
    } else {
      set('#wk-age', `${-age}年後`);
      set('#wk-age-label', `${currentYear}年から`);
    }
  }

  function renderDate() {
    const ids = ['#wk-d-ad', '#wk-d-wareki', '#wk-d-short'];
    const parsed = parseDateInput(dateInput.value);
    if (!parsed) {
      ids.forEach((id) => set(id, '—'));
      set(
        '#wk-d-note',
        dateInput.value.trim() ? '日付として読み取れませんでした。「2026/10/29」や「令和8年10月29日」の形で入力してください。' : '',
      );
      return;
    }
    let date: YMD;
    const notes: string[] = [];
    if (parsed.kind === 'ad') {
      date = parsed.date;
      notes.push('西暦として読み取りました。');
    } else {
      const r = fromWareki(parsed.era, parsed.year, parsed.m, parsed.d);
      if (!r) {
        ids.forEach((id) => set(id, '—'));
        set('#wk-d-note', 'その日付は存在しません。');
        return;
      }
      date = r.date;
      const typed = `${parsed.era.name}${parsed.year === 1 ? '元' : parsed.year}年${parsed.m}月${parsed.d}日`;
      notes.push(
        r.inEra
          ? `和暦（${typed}）として読み取りました。`
          : `${typed}は実在しない日付です（${parsed.era.name}の期間外）。正しい和暦は${r.actual?.label ?? '—'}です。`,
      );
    }
    const w = toWareki(date);
    set('#wk-d-ad', formatAdJa(date));
    set('#wk-d-wareki', w ? w.label : '—');
    set('#wk-d-short', w ? w.short : formatAdSlash(date));
    if (!w) notes.push('1872年以前は旧暦（太陰太陽暦）が使われていたため、日付単位の和暦変換は1873年1月1日以降に対応しています。');
    if (w?.alt) notes.push(`この日は改元当日のため「${w.alt}」と表記されることもあります。`);
    const days = toDayNumber(date) - toDayNumber(today);
    notes.push(days === 0 ? '今日の日付です。' : days > 0 ? `今日から${days}日後です。` : `今日から${-days}日前です。`);
    set('#wk-d-note', notes.join(''));
  }

  function render() {
    renderYear();
    renderDate();
    savePref('wareki-converter', { dir: dir(), year: yearInput.value, era: eraSel.value, date: dateInput.value } satisfies Prefs);
  }

  // Keep the same year when switching direction.
  let lastDir = dir();
  for (const r of dirs) {
    r.addEventListener('change', () => {
      const prev = lastDir;
      lastDir = dir();
      const era = findEra(eraSel.value);
      const ad =
        prev === 'ad' ? Math.trunc(parseNumber(yearInput.value)) : era ? warekiYearToAD(era, readWarekiYear()) : Number.NaN;
      if (Number.isFinite(ad)) {
        if (lastDir === 'ad') yearInput.value = String(ad);
        else {
          const w = adToWarekiYears(ad).at(-1);
          if (w) {
            eraSel.value = w.era.name;
            yearInput.value = String(w.year);
          }
        }
      }
      render();
    });
  }
  yearInput.addEventListener('input', render);
  eraSel.addEventListener('change', render);
  dateInput.addEventListener('input', render);
  $('#wk-today', root).addEventListener('click', () => {
    dateInput.value = formatAdSlash(today);
    render();
  });

  // 年齢早見表: keep ages current even if the page was built in an earlier year.
  const buildYear = Number(root.dataset.buildYear);
  const tableBody = $('#wk-table', root);
  if (buildYear !== currentYear) {
    for (const tr of $$<HTMLTableRowElement>('tr', tableBody)) {
      const age = currentYear - Number(tr.dataset.ad);
      tr.classList.toggle('is-current', age === 0);
      $('.wk-age', tr).textContent = `${age}歳`;
      $('.wk-age-before', tr).textContent = age >= 1 ? `${age - 1}歳` : '—';
    }
    set('#wk-table-title', `年齢早見表（${currentYear}年の年齢・1926〜${buildYear}年生まれ）`);
  }

  const saved = loadPref<Prefs>('wareki-converter', { dir: 'ad', year: String(currentYear), era: '令和', date: '' });
  for (const r of dirs) r.checked = r.value === saved.dir;
  if (!dirs.some((r) => r.checked)) dirs[0].checked = true;
  lastDir = dir();
  yearInput.value = saved.year || String(currentYear);
  if ([...eraSel.options].some((o) => o.value === saved.era)) eraSel.value = saved.era;
  dateInput.value = saved.date || formatAdSlash(today);
  render();
</script>

<style>
  .wk-block {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .wk-block .stats {
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  }
  .wk-title {
    font-size: 18px;
    margin: 0;
  }
  .wk-inputs {
    align-items: flex-end;
  }
  .wk-year {
    flex: 1 1 160px;
    max-width: 260px;
  }
  .wk-era {
    flex: 0 1 140px;
  }
  .wk-date-row {
    flex-wrap: nowrap;
  }
  .wk-date-row input {
    flex: 1 1 auto;
    min-width: 0;
  }
  .wk-date-out {
    display: grid;
    gap: 8px;
  }
  .wk-line {
    padding: 8px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
    flex-wrap: nowrap;
  }
  .wk-line > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .wk-table-wrap {
    max-height: 560px;
    overflow-y: auto;
  }
  .wk-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .wk-table tr.is-current td {
    background: var(--accent-soft);
    font-weight: 700;
  }
</style>
