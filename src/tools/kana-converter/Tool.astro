---
import type { ToolProps } from '../../i18n/tool';
import { KANA_MODES } from './logic';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;
---

<div class="tool" data-tool="kana-converter" data-locale={locale}>
  <div class="field">
    <span class="label">変換の種類</span>
    <div class="seg" role="radiogroup" aria-label="変換の種類">
      {
        KANA_MODES.map((m, i) => (
          <label>
            <input type="radio" name="kc-mode" value={m.id} checked={i === 0} />
            <span>{m.label}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div class="field">
    <label for="kc-input">変換したい文章</label>
    <textarea id="kc-input" rows="6" placeholder="ここに文章を入力または貼り付けます（例：やまだ たろう）">やまだ たろう</textarea>
  </div>

  <div class="row" id="kc-half-opts" hidden>
    <label class="check"><input type="checkbox" id="kc-hira" checked /> ひらがなも半角カナにする</label>
    <label class="check"><input type="checkbox" id="kc-ascii" /> 英数字・記号・スペースも半角にする</label>
  </div>

  <div class="field">
    <label for="kc-output">変換結果</label>
    <textarea id="kc-output" rows="6" readonly></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#kc-output">結果をコピー</button>
    <button class="btn" type="button" id="kc-swap">結果を入力欄に戻す</button>
    <button class="btn ghost" type="button" id="kc-clear">クリア</button>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" data-k="hiragana">0</span><span class="stat-label">ひらがな</span></div>
    <div class="stat"><span class="stat-value" data-k="katakana">0</span><span class="stat-label">全角カタカナ</span></div>
    <div class="stat"><span class="stat-value" data-k="halfKana">0</span><span class="stat-label">半角カナ（濁点含む）</span></div>
    <div class="stat"><span class="stat-value" data-k="kanji">0</span><span class="stat-label">漢字（変換対象外）</span></div>
  </div>
  <p class="hint">数は変換結果の文字数です。漢字は読みがわからないため変換しません。入力した文章は送信されず、ブラウザ内だけで変換します。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import { convertKana, countKana, type KanaMode, type KanaStats } from './logic';

  const root = $('[data-tool="kana-converter"]');
  const locale = (root.dataset.locale ?? 'ja') as Locale;
  const input = $<HTMLTextAreaElement>('#kc-input', root);
  const output = $<HTMLTextAreaElement>('#kc-output', root);
  const modes = $$<HTMLInputElement>('input[name="kc-mode"]', root);
  const halfOpts = $('#kc-half-opts', root);
  const hira = $<HTMLInputElement>('#kc-hira', root);
  const ascii = $<HTMLInputElement>('#kc-ascii', root);
  const cells = $$<HTMLElement>('[data-k]', root);

  const prefs = loadPref<{ mode?: string; hira?: boolean; ascii?: boolean }>('kana-converter', {});
  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.hira !== undefined) hira.checked = prefs.hira;
  if (prefs.ascii !== undefined) ascii.checked = prefs.ascii;

  const mode = (): KanaMode => (modes.find((m) => m.checked)?.value ?? 'hira-to-kata') as KanaMode;

  function render() {
    const m = mode();
    halfOpts.hidden = m !== 'to-half';
    output.value = convertKana(input.value, m, { hiragana: hira.checked, ascii: ascii.checked });
    const stats = countKana(output.value);
    for (const cell of cells) cell.textContent = formatInteger(stats[cell.dataset.k as keyof KanaStats], locale);
    savePref('kana-converter', { mode: m, hira: hira.checked, ascii: ascii.checked });
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  $('#kc-swap', root).addEventListener('click', () => {
    input.value = output.value;
    render();
    input.focus();
  });
  $('#kc-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>
