<div class="tool" data-tool="qr-code-generator">
  <div class="seg" role="radiogroup" aria-label="QR Code 類型">
    <label><input type="radio" name="qr-mode" value="url" checked /><span>網址</span></label>
    <label><input type="radio" name="qr-mode" value="text" /><span>文字</span></label>
    <label><input type="radio" name="qr-mode" value="wifi" /><span>Wi-Fi</span></label>
    <label><input type="radio" name="qr-mode" value="email" /><span>Email</span></label>
    <label><input type="radio" name="qr-mode" value="phone" /><span>電話</span></label>
    <label><input type="radio" name="qr-mode" value="vcard" /><span>名片</span></label>
  </div>

  <div class="qr-layout">
    <div class="qr-form">
      <div class="qr-panel" data-panel="url">
        <div class="field">
          <label for="qr-url">網址</label>
          <input id="qr-url" type="url" inputmode="url" placeholder="https://example.com" autocomplete="off" />
          <span class="hint">沒有輸入 https:// 時會自動補上。</span>
        </div>
      </div>

      <div class="qr-panel" data-panel="text" hidden>
        <div class="field">
          <label for="qr-text">文字內容</label>
          <textarea id="qr-text" rows="4" placeholder="輸入任何文字，掃描後會直接顯示"></textarea>
        </div>
      </div>

      <div class="qr-panel" data-panel="wifi" hidden>
        <div class="field">
          <label for="qr-ssid">網路名稱（SSID）</label>
          <input id="qr-ssid" type="text" autocomplete="off" placeholder="例如 MyHome-5G" />
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="qr-security">加密方式</label>
            <select id="qr-security">
              <option value="WPA">WPA / WPA2 / WPA3</option>
              <option value="WEP">WEP</option>
              <option value="nopass">無密碼</option>
            </select>
          </div>
          <div class="field">
            <label for="qr-wifi-pass">密碼</label>
            <input id="qr-wifi-pass" type="text" autocomplete="off" spellcheck="false" />
          </div>
        </div>
        <label class="check"><input id="qr-hidden" type="checkbox" /> 隱藏網路（不廣播 SSID）</label>
      </div>

      <div class="qr-panel" data-panel="email" hidden>
        <div class="field">
          <label for="qr-mail-to">收件者</label>
          <input id="qr-mail-to" type="email" placeholder="name@example.com" autocomplete="off" />
        </div>
        <div class="field">
          <label for="qr-mail-subject">主旨</label>
          <input id="qr-mail-subject" type="text" />
        </div>
        <div class="field">
          <label for="qr-mail-body">內文</label>
          <textarea id="qr-mail-body" class="qr-short" rows="3"></textarea>
        </div>
      </div>

      <div class="qr-panel" data-panel="phone" hidden>
        <div class="field">
          <label for="qr-phone">電話號碼</label>
          <input id="qr-phone" type="text" inputmode="tel" placeholder="例如 0912-345-678 或 +886 2 2345 6789" autocomplete="off" />
          <span class="hint">掃描後會開啟撥號畫面，空白與連字號會自動移除。</span>
        </div>
      </div>

      <div class="qr-panel" data-panel="vcard" hidden>
        <div class="grid-2">
          <div class="field"><label for="qr-vc-last">姓</label><input id="qr-vc-last" type="text" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-first">名</label><input id="qr-vc-first" type="text" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-org">公司</label><input id="qr-vc-org" type="text" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-title">職稱</label><input id="qr-vc-title" type="text" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-phone">手機</label><input id="qr-vc-phone" type="text" inputmode="tel" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-email">Email</label><input id="qr-vc-email" type="email" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-url">網站</label><input id="qr-vc-url" type="url" inputmode="url" autocomplete="off" /></div>
          <div class="field"><label for="qr-vc-address">地址</label><input id="qr-vc-address" type="text" autocomplete="off" /></div>
        </div>
        <div class="field">
          <label for="qr-vc-note">備註</label>
          <input id="qr-vc-note" type="text" autocomplete="off" />
        </div>
      </div>

      <div class="field">
        <span class="label">容錯等級</span>
        <div class="seg" role="radiogroup" aria-label="容錯等級">
          <label><input type="radio" name="qr-level" value="L" /><span>L 7%</span></label>
          <label><input type="radio" name="qr-level" value="M" checked /><span>M 15%</span></label>
          <label><input type="radio" name="qr-level" value="Q" /><span>Q 25%</span></label>
          <label><input type="radio" name="qr-level" value="H" /><span>H 30%</span></label>
        </div>
      </div>

      <div class="field">
        <label for="qr-margin">邊界：<output id="qr-margin-out">4</output> 格</label>
        <input id="qr-margin" type="range" min="0" max="10" step="1" value="4" />
      </div>

      <div class="qr-colors">
        <label class="qr-color" for="qr-fg"><input id="qr-fg" type="color" value="#000000" /> 前景色</label>
        <label class="qr-color" for="qr-bg"><input id="qr-bg" type="color" value="#ffffff" /> 背景色</label>
        <label class="check"><input id="qr-transparent" type="checkbox" /> 透明背景</label>
        <button class="btn small ghost" type="button" id="qr-reset-colors">還原黑白</button>
      </div>
    </div>

    <div class="qr-side">
      <div class="qr-preview" id="qr-preview" aria-live="polite">
        <p class="muted">輸入內容後會在這裡顯示 QR Code</p>
      </div>
      <p class="hint qr-info" id="qr-info"></p>
      <div class="notice" id="qr-notice" hidden></div>
      <div class="field">
        <label for="qr-size">PNG 尺寸</label>
        <select id="qr-size">
          <option value="256">256 × 256 px</option>
          <option value="512" selected>512 × 512 px</option>
          <option value="1024">1024 × 1024 px</option>
          <option value="2048">2048 × 2048 px（印刷）</option>
        </select>
      </div>
      <div class="row qr-actions">
        <button class="btn primary" type="button" id="qr-png" disabled>下載 PNG</button>
        <button class="btn" type="button" id="qr-svg" disabled>下載 SVG</button>
      </div>
    </div>
  </div>

  <details class="qr-payload">
    <summary>查看編碼內容</summary>
    <div class="qr-payload-body">
      <div class="output" id="qr-payload"></div>
      <button class="btn small" type="button" data-copy="#qr-payload">複製編碼內容</button>
    </div>
  </details>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import {
    BYTE_CAPACITY,
    EC_RECOVERY,
    buildEmail,
    buildPhone,
    buildVCard,
    buildWifi,
    colorWarning,
    exceedsCapacity,
    normalizeUrl,
    utf8Length,
    type EcLevel,
    type QrMode,
    type WifiData,
  } from './logic';

  type QrModule = typeof import('qrcode');

  interface Prefs {
    mode: QrMode;
    level: EcLevel;
    margin: number;
    size: number;
    fg: string;
    bg: string;
    transparent: boolean;
  }

  const defaults: Prefs = { mode: 'url', level: 'M', margin: 4, size: 512, fg: '#000000', bg: '#ffffff', transparent: false };

  const root = $('[data-tool="qr-code-generator"]');
  const val = (id: string) => $<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`#${id}`, root).value;
  const preview = $('#qr-preview', root);
  const info = $('#qr-info', root);
  const notice = $('#qr-notice', root);
  const payloadOut = $('#qr-payload', root);
  const pngBtn = $<HTMLButtonElement>('#qr-png', root);
  const svgBtn = $<HTMLButtonElement>('#qr-svg', root);
  const margin = $<HTMLInputElement>('#qr-margin', root);
  const marginOut = $('#qr-margin-out', root);
  const fg = $<HTMLInputElement>('#qr-fg', root);
  const bg = $<HTMLInputElement>('#qr-bg', root);
  const transparent = $<HTMLInputElement>('#qr-transparent', root);
  const size = $<HTMLSelectElement>('#qr-size', root);
  const security = $<HTMLSelectElement>('#qr-security', root);
  const wifiPass = $<HTMLInputElement>('#qr-wifi-pass', root);
  const panels = $$<HTMLElement>('[data-panel]', root);

  let qrModule: Promise<QrModule> | null = null;
  function loadQr(): Promise<QrModule> {
    qrModule ??= import('qrcode').then((mod) => (mod as unknown as { default?: QrModule }).default ?? mod);
    return qrModule;
  }

  const checked = (name: string) => $<HTMLInputElement>(`input[name="${name}"]:checked`, root).value;
  const setChecked = (name: string, value: string) => {
    const input = root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
    if (input) input.checked = true;
  };

  function readPrefs(): Prefs {
    return {
      mode: checked('qr-mode') as QrMode,
      level: checked('qr-level') as EcLevel,
      margin: Number(margin.value),
      size: Number(size.value),
      fg: fg.value,
      bg: bg.value,
      transparent: transparent.checked,
    };
  }

  function applyPrefs(p: Prefs) {
    setChecked('qr-mode', p.mode);
    setChecked('qr-level', p.level);
    margin.value = String(p.margin);
    if (size.querySelector(`option[value="${p.size}"]`)) size.value = String(p.size);
    fg.value = p.fg;
    bg.value = p.bg;
    transparent.checked = p.transparent;
  }

  function buildPayload(mode: QrMode): string {
    switch (mode) {
      case 'url':
        return normalizeUrl(val('qr-url'));
      case 'text':
        return val('qr-text');
      case 'wifi':
        return buildWifi({
          ssid: val('qr-ssid'),
          password: val('qr-wifi-pass'),
          security: val('qr-security') as WifiData['security'],
          hidden: $<HTMLInputElement>('#qr-hidden', root).checked,
        });
      case 'email':
        return buildEmail({ to: val('qr-mail-to'), subject: val('qr-mail-subject'), body: val('qr-mail-body') });
      case 'phone':
        return buildPhone(val('qr-phone'));
      case 'vcard':
        return buildVCard({
          firstName: val('qr-vc-first'),
          lastName: val('qr-vc-last'),
          org: val('qr-vc-org'),
          title: val('qr-vc-title'),
          phone: val('qr-vc-phone'),
          email: val('qr-vc-email'),
          url: val('qr-vc-url'),
          address: val('qr-vc-address'),
          note: val('qr-vc-note'),
        });
    }
  }

  function renderOptions(p: Prefs) {
    return {
      errorCorrectionLevel: p.level,
      margin: p.margin,
      color: { dark: p.fg, light: p.transparent ? '#00000000' : p.bg },
    };
  }

  function showNotice(message: string, kind: 'error' | 'warn' | null) {
    notice.hidden = kind === null;
    notice.className = kind === 'error' ? 'notice error' : 'notice';
    notice.textContent = message;
  }

  let current = '';
  let token = 0;

  async function render() {
    const p = readPrefs();
    savePref('qr-code-generator', p);
    marginOut.textContent = String(p.margin);
    for (const panel of panels) panel.hidden = panel.dataset.panel !== p.mode;
    bg.disabled = p.transparent;
    wifiPass.disabled = security.value === 'nopass';

    const payload = buildPayload(p.mode);
    payloadOut.textContent = payload;
    current = '';
    pngBtn.disabled = svgBtn.disabled = true;
    const run = ++token;

    if (payload === '') {
      preview.innerHTML = '<p class="muted">輸入內容後會在這裡顯示 QR Code</p>';
      info.textContent = '';
      showNotice('', null);
      return;
    }
    if (exceedsCapacity(payload, p.level)) {
      preview.innerHTML = '<p class="muted">內容太長，無法產生</p>';
      info.textContent = '';
      showNotice(
        `內容有 ${formatInteger(utf8Length(payload))} 位元組，超過容錯等級 ${p.level} 的上限 ${formatInteger(BYTE_CAPACITY[p.level])} 位元組。請縮短內容或改用較低的容錯等級。`,
        'error',
      );
      return;
    }

    try {
      const QRCode = await loadQr();
      const opts = renderOptions(p);
      const svg = await QRCode.toString(payload, { ...opts, type: 'svg' });
      if (run !== token) return;
      const meta = QRCode.create(payload, { errorCorrectionLevel: p.level });
      preview.innerHTML = svg;
      const n = meta.modules.size;
      info.textContent = `版本 ${meta.version}・${n} × ${n} 模組・容錯 ${p.level}（${EC_RECOVERY[p.level]}）`;
      current = payload;
      pngBtn.disabled = svgBtn.disabled = false;

      const warning = colorWarning(p.fg, p.transparent ? '#ffffff' : p.bg);
      if (warning === 'inverted') showNotice('前景色比背景色淺，許多掃描器無法辨識反白的 QR Code，建議使用深色前景。', 'warn');
      else if (warning === 'low-contrast') showNotice('前景與背景的對比偏低，可能不易掃描，建議加深前景色。', 'warn');
      else if (p.transparent) showNotice('透明背景請放在淺色底上使用，放在深色底上會無法掃描。', 'warn');
      else showNotice('', null);
    } catch {
      if (run !== token) return;
      preview.innerHTML = '<p class="muted">無法產生 QR Code</p>';
      showNotice('產生失敗，請縮短內容或改用較低的容錯等級。', 'error');
    }
  }

  const scheduleRender = debounce(render, 120);

  async function downloadPng() {
    if (!current) return;
    const p = readPrefs();
    const QRCode = await loadQr();
    const canvas = document.createElement('canvas');
    await QRCode.toCanvas(canvas, current, { ...renderOptions(p), width: p.size });
    canvas.toBlob((blob) => blob && downloadBlob(blob, `qrcode-${p.size}.png`), 'image/png');
  }

  async function downloadSvg() {
    if (!current) return;
    const p = readPrefs();
    const QRCode = await loadQr();
    const svg = await QRCode.toString(current, { ...renderOptions(p), type: 'svg', width: p.size });
    downloadBlob(new Blob([svg], { type: 'image/svg+xml' }), 'qrcode.svg');
  }

  applyPrefs(loadPref('qr-code-generator', defaults));
  root.addEventListener('input', scheduleRender);
  root.addEventListener('change', scheduleRender);
  $('#qr-reset-colors', root).addEventListener('click', () => {
    fg.value = defaults.fg;
    bg.value = defaults.bg;
    transparent.checked = false;
    render();
  });
  pngBtn.addEventListener('click', downloadPng);
  svgBtn.addEventListener('click', downloadSvg);
  render();
</script>

<style>
  .qr-layout {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .qr-layout {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: start;
    }
  }
  .qr-form,
  .qr-panel,
  .qr-side {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .qr-panel[hidden],
  .notice[hidden] {
    display: none !important;
  }
  .qr-short {
    min-height: 88px;
  }
  .qr-colors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  .qr-color {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    cursor: pointer;
  }
  .qr-color input:disabled {
    opacity: 0.4;
  }
  .qr-preview {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    padding: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    font-size: 14px;
  }
  .qr-preview :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .qr-info {
    margin: 0;
    text-align: center;
    min-height: 1.4em;
  }
  .qr-actions .btn {
    flex: 1;
  }
  .qr-payload summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .qr-payload-body {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin-top: 10px;
  }
  .qr-payload-body .output {
    width: 100%;
  }
</style>
