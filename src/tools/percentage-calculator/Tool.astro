<div class="tool" data-tool="percentage-calculator">
  <section class="pc-card" aria-labelledby="pc-t1">
    <h2 class="pc-title" id="pc-t1">X 的 Y% 是多少</h2>
    <div class="pc-line">
      <input type="text" inputmode="decimal" autocomplete="off" data-k="a1" value="2000" aria-label="數值 X" />
      <span>的</span>
      <input type="text" inputmode="decimal" autocomplete="off" data-k="a2" value="15" aria-label="百分比 Y" />
      <span>% 是</span>
    </div>
    <div class="pc-out"><strong id="pc-r1">—</strong><span class="hint" id="pc-f1"></span></div>
  </section>

  <section class="pc-card" aria-labelledby="pc-t2">
    <h2 class="pc-title" id="pc-t2">X 是 Y 的幾 %</h2>
    <div class="pc-line">
      <input type="text" inputmode="decimal" autocomplete="off" data-k="b1" value="45" aria-label="部分 X" />
      <span>是</span>
      <input type="text" inputmode="decimal" autocomplete="off" data-k="b2" value="60" aria-label="全體 Y" />
      <span>的</span>
    </div>
    <div class="pc-out"><strong id="pc-r2">—</strong><span class="hint" id="pc-f2"></span></div>
  </section>

  <section class="pc-card" aria-labelledby="pc-t3">
    <h2 class="pc-title" id="pc-t3">從 X 變成 Y，增減幾 %</h2>
    <div class="pc-line">
      <span>從</span>
      <input type="text" inputmode="decimal" autocomplete="off" data-k="c1" value="32000" aria-label="原本的數值 X" />
      <span>變成</span>
      <input type="text" inputmode="decimal" autocomplete="off" data-k="c2" value="35000" aria-label="新的數值 Y" />
    </div>
    <div class="pc-out"><strong id="pc-r3">—</strong><span class="hint" id="pc-f3"></span></div>
  </section>

  <section class="pc-card" aria-labelledby="pc-t4">
    <h2 class="pc-title" id="pc-t4">X 增加或減少 Y% 後是多少</h2>
    <div class="pc-line">
      <input type="text" inputmode="decimal" autocomplete="off" data-k="d1" value="1200" aria-label="數值 X" />
      <div class="seg" role="radiogroup" aria-label="增加或減少">
        <label><input type="radio" name="pc-dir" value="increase" checked /><span>增加</span></label>
        <label><input type="radio" name="pc-dir" value="decrease" /><span>減少</span></label>
      </div>
      <input type="text" inputmode="decimal" autocomplete="off" data-k="d2" value="5" aria-label="百分比 Y" />
      <span>% 後是</span>
    </div>
    <div class="pc-out"><strong id="pc-r4">—</strong><span class="hint" id="pc-f4"></span></div>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import { applyPercent, clean, percentChange, percentOf, percentRatio, type Direction } from './logic';

  const root = $('[data-tool="percentage-calculator"]');
  const inputs = $$<HTMLInputElement>('input[data-k]', root);
  const dirs = $$<HTMLInputElement>('input[name="pc-dir"]', root);
  const field = (k: string) => inputs.find((i) => i.dataset.k === k)!;
  const num = (k: string) => parseNumber(field(k).value);
  const fmt = (v: number) => formatNumber(clean(v), 6);

  type Prefs = Record<string, string>;
  const saved = loadPref<Prefs>('percentage-calculator', {});
  for (const input of inputs) if (typeof saved[input.dataset.k!] === 'string') input.value = saved[input.dataset.k!];
  if (saved.dir === 'decrease') dirs[1].checked = true;

  function put(n: number, value: string, formula: string) {
    $(`#pc-r${n}`, root).textContent = value;
    $(`#pc-f${n}`, root).textContent = formula;
  }

  function render() {
    const direction = (dirs.find((d) => d.checked)?.value ?? 'increase') as Direction;
    const prefs: Prefs = { dir: direction };
    for (const input of inputs) prefs[input.dataset.k!] = input.value;
    savePref('percentage-calculator', prefs);

    const [a1, a2] = [num('a1'), num('a2')];
    const r1 = percentOf(a1, a2);
    if (Number.isNaN(r1)) put(1, '—', '請輸入數字');
    else put(1, fmt(r1), `${fmt(a1)} × ${fmt(a2)} ÷ 100 = ${fmt(r1)}`);

    const [b1, b2] = [num('b1'), num('b2')];
    const r2 = percentRatio(b1, b2);
    if (Number.isNaN(r2)) put(2, '—', b2 === 0 ? '全體不能是 0' : '請輸入數字');
    else put(2, `${fmt(r2)}%`, `${fmt(b1)} ÷ ${fmt(b2)} × 100 = ${fmt(r2)}%`);

    const [c1, c2] = [num('c1'), num('c2')];
    const r3 = percentChange(c1, c2);
    if (Number.isNaN(r3)) put(3, '—', c1 === 0 ? '原本的數值為 0 時無法計算變化百分比' : '請輸入數字');
    else {
      const word = r3 > 0 ? '增加' : r3 < 0 ? '減少' : '沒有變化';
      put(3, r3 === 0 ? word : `${word} ${fmt(Math.abs(r3))}%`, `(${fmt(c2)} − ${fmt(c1)}) ÷ ${fmt(Math.abs(c1))} × 100 = ${fmt(r3)}%`);
    }

    const [d1, d2] = [num('d1'), num('d2')];
    const r4 = applyPercent(d1, d2, direction);
    const sign = direction === 'increase' ? '+' : '−';
    if (Number.isNaN(r4)) put(4, '—', '請輸入數字');
    else put(4, fmt(r4), `${fmt(d1)} × (1 ${sign} ${fmt(d2)}%) = ${fmt(r4)}，差額 ${fmt(Math.abs(r4 - d1))}`);
  }

  inputs.forEach((input) => input.addEventListener('input', render));
  dirs.forEach((d) => d.addEventListener('change', render));
  render();
</script>

<style>
  .pc-card {
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pc-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
  }
  .pc-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }
  .pc-line input[type='text'] {
    width: 8.5em;
    flex: 0 1 8.5em;
  }
  .pc-out {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .pc-out strong {
    font-size: 24px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .pc-out .hint {
    font-variant-numeric: tabular-nums;
  }
</style>
