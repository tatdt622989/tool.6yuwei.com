---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="percentage-calculator" {...i18nAttrs(locale, s.client)}>
  {
    s.cards.map((card, index) => (
      <section class="pc-card" aria-labelledby={`pc-t${index + 1}`}>
        <h2 class="pc-title" id={`pc-t${index + 1}`}>{card.title}</h2>
        <div class="pc-line">
          {card.parts.map((part) =>
            typeof part === 'string' ? (
              <span>{part}</span>
            ) : 'field' in part ? (
              <input
                type="text"
                inputmode="decimal"
                autocomplete="off"
                data-k={part.field}
                value={s.defaults[part.field]}
                aria-label={s.fieldAria[part.field]}
              />
            ) : (
              <div class="seg" role="radiogroup" aria-label={s.directionAria}>
                <label><input type="radio" name="pc-dir" value="increase" checked /><span>{s.increase}</span></label>
                <label><input type="radio" name="pc-dir" value="decrease" /><span>{s.decrease}</span></label>
              </div>
            ),
          )}
        </div>
        <div class="pc-out"><strong id={`pc-r${index + 1}`}>—</strong><span class="hint" id={`pc-f${index + 1}`}></span></div>
      </section>
    ))
  }
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import { applyPercent, clean, percentChange, percentOf, percentRatio, type Direction } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="percentage-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const inputs = $$<HTMLInputElement>('input[data-k]', root);
  const dirs = $$<HTMLInputElement>('input[name="pc-dir"]', root);
  const field = (k: string) => inputs.find((i) => i.dataset.k === k)!;
  const num = (k: string) => parseNumber(field(k).value);
  const fmt = (v: number) => formatNumber(clean(v), 6, locale);

  type Prefs = Record<string, string>;
  const saved = loadPref<Prefs>('percentage-calculator', {});
  for (const input of inputs) if (typeof saved[input.dataset.k!] === 'string') input.value = saved[input.dataset.k!];
  if (saved.dir === 'decrease') dirs.find((d) => d.value === 'decrease')!.checked = true;

  function put(n: number, value: string, formula: string) {
    $(`#pc-r${n}`, root).textContent = value;
    $(`#pc-f${n}`, root).textContent = formula;
  }

  function render() {
    const direction = (dirs.find((d) => d.checked)?.value ?? 'increase') as Direction;
    const prefs: Prefs = { dir: direction };
    for (const input of inputs) prefs[input.dataset.k!] = input.value;
    savePref('percentage-calculator', prefs);

    const [a1, a2] = [num('a1'), num('a2')];
    const r1 = percentOf(a1, a2);
    if (Number.isNaN(r1)) put(1, '—', s.enterNumber);
    else put(1, fmt(r1), `${fmt(a1)} × ${fmt(a2)} ÷ 100 = ${fmt(r1)}`);

    const [b1, b2] = [num('b1'), num('b2')];
    const r2 = percentRatio(b1, b2);
    if (Number.isNaN(r2)) put(2, '—', b2 === 0 ? s.wholeZero : s.enterNumber);
    else put(2, `${fmt(r2)}%`, `${fmt(b1)} ÷ ${fmt(b2)} × 100 = ${fmt(r2)}%`);

    const [c1, c2] = [num('c1'), num('c2')];
    const r3 = percentChange(c1, c2);
    if (Number.isNaN(r3)) put(3, '—', c1 === 0 ? s.fromZero : s.enterNumber);
    else {
      const text = t(r3 > 0 ? s.up : r3 < 0 ? s.down : s.same, { n: fmt(Math.abs(r3)) });
      put(3, text, `(${fmt(c2)} − ${fmt(c1)}) ÷ ${fmt(Math.abs(c1))} × 100 = ${fmt(r3)}%`);
    }

    const [d1, d2] = [num('d1'), num('d2')];
    const r4 = applyPercent(d1, d2, direction);
    const sign = direction === 'increase' ? '+' : '−';
    if (Number.isNaN(r4)) put(4, '—', s.enterNumber);
    else put(4, fmt(r4), t(s.applyFormula, { x: fmt(d1), sign, p: fmt(d2), r: fmt(r4), d: fmt(Math.abs(r4 - d1)) }));
  }

  inputs.forEach((input) => input.addEventListener('input', render));
  dirs.forEach((d) => d.addEventListener('change', render));
  render();
</script>

<style>
  .pc-card {
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pc-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
  }
  .pc-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }
  .pc-line input[type='text'] {
    width: 8.5em;
    flex: 0 1 8.5em;
  }
  .pc-out {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .pc-out strong {
    font-size: 24px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .pc-out .hint {
    font-variant-numeric: tabular-nums;
  }
</style>
