---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';
import { COMMON_ENTITIES } from './logic';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const invisible = new Set([' ', ' ', ' ', ' ', '­']);
---

<div class="tool" data-tool="html-entities" {...i18nAttrs(locale, s.client)}>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="he-mode" value="encode" checked /><span>{s.encode}</span></label>
      <label><input type="radio" name="he-mode" value="decode" /><span>{s.decode}</span></label>
    </div>
  </div>

  <div class="he-opts" id="he-opts">
    <div class="field">
      <span class="label">{s.scopeLabel}</span>
      <div class="row">
        <div class="seg" role="radiogroup" aria-label={s.scopeLabel}>
          <label><input type="radio" name="he-scope" value="minimal" checked /><span>{s.scopeMinimal}</span></label>
          <label><input type="radio" name="he-scope" value="nonascii" /><span>{s.scopeNonAscii}</span></label>
        </div>
      </div>
    </div>
    <div class="field">
      <span class="label">{s.styleLabel}</span>
      <div class="row">
        <div class="seg" role="radiogroup" aria-label={s.styleLabel}>
          <label><input type="radio" name="he-style" value="named" checked /><span>{s.styleNamed}</span></label>
          <label><input type="radio" name="he-style" value="decimal" /><span>{s.styleDecimal}</span></label>
          <label><input type="radio" name="he-style" value="hex" /><span>{s.styleHex}</span></label>
        </div>
      </div>
    </div>
  </div>

  <div class="field">
    <label for="he-input" id="he-input-label">{s.client.encodeInputLabel}</label>
    <textarea id="he-input" class="mono" rows="7" spellcheck="false" autocomplete="off"></textarea>
  </div>
  <div class="field">
    <label for="he-output">{s.outputLabel}</label>
    <textarea id="he-output" class="mono" rows="7" readonly spellcheck="false"></textarea>
    <span class="hint" id="he-meta"></span>
  </div>
  <div class="row">
    <button class="btn primary" type="button" data-copy="#he-output">{s.copy}</button>
    <button class="btn" type="button" id="he-swap">{s.swap}</button>
    <button class="btn ghost" type="button" id="he-clear">{s.clear}</button>
  </div>

  <details class="he-ref">
    <summary>{t(s.refSummary, { n: COMMON_ENTITIES.length })}</summary>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>{s.colChar}</th><th>{s.colNamed}</th><th>{s.colDecimal}</th><th>{s.colDescription}</th></tr>
        </thead>
        <tbody>
          {
            COMMON_ENTITIES.map((e) => (
              <tr>
                <td class="he-char">{invisible.has(e.char) ? s.blank : e.char}</td>
                <td><code>{`&${e.name};`}</code></td>
                <td><code>{`&#${e.char.codePointAt(0)};`}</code></td>
                <td>{s.descriptions?.[e.name] ?? e.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { decodeEntities, encodeEntities, type EncodeScope, type EncodeStyle } from './logic';
  import type { Strings } from './i18n';

  type Mode = 'encode' | 'decode';
  interface Prefs {
    mode: Mode;
    scope: EncodeScope;
    style: EncodeStyle;
  }

  const root = $('[data-tool="html-entities"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#he-input', root);
  const output = $<HTMLTextAreaElement>('#he-output', root);
  const inputLabel = $('#he-input-label', root);
  const meta = $('#he-meta', root);
  const opts = $('#he-opts', root);
  const radios = (name: string) => $$<HTMLInputElement>(`input[name="${name}"]`, root);
  const groups = { mode: radios('he-mode'), scope: radios('he-scope'), style: radios('he-style') };

  // The browser knows every HTML5 named entity; parsing inside a <textarea> never creates elements.
  const scratch = document.createElement('textarea');
  const resolveName = (name: string) => {
    scratch.innerHTML = `&${name};`;
    const value = scratch.value;
    return value === `&${name};` ? undefined : value;
  };

  const pick = (list: HTMLInputElement[]) => list.find((r) => r.checked)?.value;
  const readPrefs = (): Prefs => ({
    mode: (pick(groups.mode) ?? 'encode') as Mode,
    scope: (pick(groups.scope) ?? 'minimal') as EncodeScope,
    style: (pick(groups.style) ?? 'named') as EncodeStyle,
  });
  const setRadio = (list: HTMLInputElement[], value: string) => list.forEach((r) => (r.checked = r.value === value));

  function render() {
    const prefs = readPrefs();
    savePref('html-entities', prefs);
    const encode = prefs.mode === 'encode';
    opts.hidden = !encode;
    inputLabel.textContent = encode ? s.encodeInputLabel : s.decodeInputLabel;
    input.placeholder = encode ? s.encodePlaceholder : s.decodePlaceholder;
    if (input.value === '') {
      output.value = '';
      meta.textContent = '';
      return;
    }
    if (encode) {
      output.value = encodeEntities(input.value, prefs.scope, prefs.style);
    } else {
      const { text, count } = decodeEntities(input.value, resolveName);
      output.value = text;
      meta.textContent = plural(locale, count, s.decoded);
      return;
    }
    meta.textContent = t(s.lengths, {
      in: formatInteger([...input.value].length, locale),
      out: formatInteger([...output.value].length, locale),
    });
  }

  const saved = loadPref<Prefs>('html-entities', { mode: 'encode', scope: 'minimal', style: 'named' });
  setRadio(groups.mode, saved.mode);
  setRadio(groups.scope, saved.scope);
  setRadio(groups.style, saved.style);

  input.addEventListener('input', render);
  [...groups.mode, ...groups.scope, ...groups.style].forEach((r) => r.addEventListener('change', render));
  $('#he-swap', root).addEventListener('click', () => {
    if (!output.value) return;
    input.value = output.value;
    setRadio(groups.mode, readPrefs().mode === 'encode' ? 'decode' : 'encode');
    render();
  });
  $('#he-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .he-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .he-ref {
    display: grid;
    gap: 12px;
  }
  .he-ref summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }
  .he-char {
    font-size: 18px;
    text-align: center !important;
  }
  .he-ref td:last-child {
    white-space: normal;
  }
</style>
