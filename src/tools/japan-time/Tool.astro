---
// ja-only tool: strings are written in Japanese here (see docs/i18n.md §3).
// Clock sync is shared with taiwan-time (../taiwan-time/sync.ts and logic.ts).
import type { ToolProps } from '../../i18n/tool';

type Props = ToolProps;
const QUICK_TIMES = ['10:00', '11:00', '12:00', '18:00', '19:00', '20:00', '21:00'];
---

<div class="tool" data-tool="japan-time" data-sync="pending" data-mode="clock">
  <div class="jt-face">
    <p class="jt-zone">日本標準時（JST） <span class="muted">UTC+9</span></p>
    <div class="big-display jt-clock" id="jt-clock" role="timer" aria-label="日本の現在時刻">--:--:--</div>
    <p class="jt-date"><span id="jt-date">&nbsp;</span><span id="jt-wareki"></span></p>
    <p class="jt-jiho" id="jt-jiho">&nbsp;</p>

    <div class="jt-cd" id="jt-cd" hidden>
      <span class="jt-cd-label" id="jt-cd-label">12:00:00 の発売まで</span>
      <span class="jt-cd-value" id="jt-cd-value" role="timer">00:00:00.0</span>
    </div>
  </div>

  <div class="jt-status" id="jt-status" aria-live="polite">
    <span class="jt-dot" aria-hidden="true"></span>
    <span id="jt-status-text">サーバーと時刻を合わせています…</span>
  </div>

  <div class="jt-controls">
    <button class="btn" type="button" id="jt-resync">もう一度時刻合わせ</button>
    <label class="check"><input type="checkbox" id="jt-ms" /> ミリ秒を表示</label>
    <label class="check"><input type="checkbox" id="jt-signal" /> 時報音（10秒ごと）</label>
    <button class="btn" type="button" id="jt-fullscreen">全画面</button>
  </div>

  <div class="stats jt-stats">
    <div class="stat"><span class="stat-value" id="jt-offset">—</span><span class="stat-label">端末の時計のずれ</span></div>
    <div class="stat"><span class="stat-value" id="jt-acc">—</span><span class="stat-label">時刻合わせの精度（±）</span></div>
    <div class="stat"><span class="stat-value" id="jt-rtt">—</span><span class="stat-label">最小の通信遅延</span></div>
    <div class="stat"><span class="stat-value" id="jt-utc">—</span><span class="stat-label">協定世界時（UTC）</span></div>
  </div>

  <section class="jt-ticket" aria-labelledby="jt-ticket-title">
    <h2 class="jt-ticket-title" id="jt-ticket-title">チケット発売カウントダウン</h2>
    <p class="hint">発売時刻（日本時間）を入れると、時刻合わせ後の正確な時刻で 0.1 秒単位のカウントダウンを表示します。</p>
    <div class="jt-ticket-row">
      <div class="field">
        <label for="jt-target">発売時刻</label>
        <input id="jt-target" type="time" step="1" value="10:00:00" />
      </div>
      <button class="btn primary" type="button" id="jt-cd-toggle">カウントダウン開始</button>
    </div>
    <div class="row" id="jt-quick">
      {
        QUICK_TIMES.map((t) => (
          <button class="btn small" type="button" data-time={`${t}:00`}>
            {t}
          </button>
        ))
      }
    </div>
    <label class="check"><input type="checkbox" id="jt-sound" checked /> 残り5秒で音を鳴らす</label>
    <p class="notice" id="jt-notice" hidden></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { syncClock } from '../taiwan-time/sync';
  import { formatElapsed, formatTenths, formatTimeOfDay, parseTimeOfDay, type OffsetEstimate } from '../taiwan-time/logic';
  import {
    describeOffsetJa,
    formatAccuracyJa,
    formatClock,
    formatDateJa,
    formatUtc,
    formatWarekiJa,
    jihoReading,
    jihoTone,
    jstParts,
    nextJstOccurrence,
    nextTenSecondMark,
  } from './logic';

  interface Prefs {
    showMs: boolean;
    target: string;
    sound: boolean;
  }

  const AFTER_TARGET_MS = 60_000; // keep showing 「発売開始」 this long before moving to tomorrow

  const root = $('[data-tool="japan-time"]');
  const clockEl = $('#jt-clock', root);
  const dateEl = $('#jt-date', root);
  const warekiEl = $('#jt-wareki', root);
  const jihoEl = $('#jt-jiho', root);
  const statusText = $('#jt-status-text', root);
  const resyncBtn = $<HTMLButtonElement>('#jt-resync', root);
  const msBox = $<HTMLInputElement>('#jt-ms', root);
  const signalBox = $<HTMLInputElement>('#jt-signal', root);
  const fsBtn = $<HTMLButtonElement>('#jt-fullscreen', root);
  const offsetEl = $('#jt-offset', root);
  const accEl = $('#jt-acc', root);
  const rttEl = $('#jt-rtt', root);
  const utcEl = $('#jt-utc', root);
  const cdBox = $('#jt-cd', root);
  const cdLabel = $('#jt-cd-label', root);
  const cdValue = $('#jt-cd-value', root);
  const targetInput = $<HTMLInputElement>('#jt-target', root);
  const cdToggle = $<HTMLButtonElement>('#jt-cd-toggle', root);
  const soundBox = $<HTMLInputElement>('#jt-sound', root);
  const notice = $('#jt-notice', root);
  const quickButtons = $$<HTMLButtonElement>('#jt-quick button', root);
  const baseTitle = document.title;

  const prefs = loadPref<Prefs>('japan-time', { showMs: false, target: '10:00:00', sound: true });
  msBox.checked = prefs.showMs === true;
  soundBox.checked = prefs.sound !== false;
  const savedTarget = parseTimeOfDay(prefs.target);
  if (savedTarget !== null) targetInput.value = formatTimeOfDay(savedTarget);

  /** server − device, ms. 0 until synced (or when sync fails: the device clock is shown). */
  let offset = 0;
  let syncRun = 0;
  let countdownTarget: number | null = null;
  let lastClock = '';
  let lastSecond = -1;
  let lastCd = '';
  let lastDate = '';
  let lastJiho = '';
  let lastTitle = '';
  let lastBeepAt = Number.NaN;

  const now = () => Date.now() + offset;

  function persist() {
    savePref('japan-time', { showMs: msBox.checked, target: targetInput.value, sound: soundBox.checked } satisfies Prefs);
  }

  function showNotice(text: string, kind: '' | 'error' | 'ok' = '') {
    notice.textContent = text;
    notice.className = kind ? `notice ${kind}` : 'notice';
    notice.hidden = text === '';
  }

  /* ---------- Sound (WebAudio, unlocked by a click) ---------- */
  let audio: AudioContext | null = null;
  function unlockAudio(): AudioContext | null {
    const Ctor =
      window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return null;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
    return audio;
  }
  function beep(frequency: number, duration: number) {
    const ctx = audio;
    if (!ctx || ctx.state !== 'running') return;
    const at = ctx.currentTime + 0.005;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(0.3, at + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);
    osc.connect(gain).connect(ctx.destination);
    osc.start(at);
    osc.stop(at + duration + 0.02);
  }

  /* ---------- Rendering ---------- */
  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function renderCountdown(t: number) {
    if (countdownTarget === null) return;
    const target = nextJstOccurrence(t, countdownTarget, AFTER_TARGET_MS);
    const remaining = target - t;
    const label = formatTimeOfDay(countdownTarget);
    let text: string;
    if (remaining > 0) {
      text = formatTenths(remaining);
      cdLabel.textContent = `${label} の発売まで`;
      root.dataset.mode = remaining <= 10_000 ? 'final' : 'countdown';
      const whole = Math.ceil(remaining / 1000);
      if (soundBox.checked && whole <= 5 && whole !== lastBeepAt) {
        lastBeepAt = whole;
        beep(880, 0.12);
      }
      setTitle(`${text.slice(0, 8)} 発売カウントダウン`);
    } else {
      text = formatElapsed(-remaining);
      cdLabel.textContent = `${label} 発売開始`;
      root.dataset.mode = 'go';
      if (soundBox.checked && lastBeepAt !== 0) {
        lastBeepAt = 0;
        beep(1320, 0.5);
      }
      setTitle(`発売開始 ${label}`);
    }
    if (text !== lastCd) cdValue.textContent = lastCd = text;
  }

  function frame() {
    const t = now();
    const parts = jstParts(t);
    const clock = formatClock(parts, msBox.checked);
    if (clock !== lastClock) {
      clockEl.textContent = lastClock = clock;
    }
    if (parts.second !== lastSecond) {
      lastSecond = parts.second;
      const dateText = formatDateJa(parts);
      if (dateText !== lastDate) {
        dateEl.textContent = lastDate = dateText;
        warekiEl.textContent = formatWarekiJa(parts);
      }
      utcEl.textContent = formatUtc(t);
      const next = jstParts(nextTenSecondMark(t));
      const jiho = `次の時報 ${jihoReading(next.hour, next.minute, next.second)}`;
      if (jiho !== lastJiho) jihoEl.textContent = lastJiho = jiho;
      if (signalBox.checked) {
        const tone = jihoTone(parts.second);
        if (tone === 'pi') beep(440, 0.1);
        else if (tone === 'pon') beep(880, 1.0);
      }
      if (countdownTarget === null) setTitle(`${formatClock(parts)} 日本時間`);
    }
    renderCountdown(t);
    requestAnimationFrame(frame);
  }

  function renderSync(est: OffsetEstimate | null, state: 'pending' | 'ok' | 'fail', progress = '') {
    root.dataset.sync = state;
    resyncBtn.disabled = state === 'pending';
    if (state === 'pending') {
      statusText.textContent = `サーバーと時刻を合わせています…${progress}`;
      return;
    }
    if (state === 'fail' || !est) {
      statusText.textContent =
        'サーバーの時刻を取得できませんでした。現在はお使いの端末の時計を日本時間に換算して表示しています。通信を確認して「もう一度時刻合わせ」を押してください。';
      offsetEl.textContent = '未同期';
      accEl.textContent = '—';
      rttEl.textContent = '—';
      return;
    }
    const d = describeOffsetJa(est.offset, est.accuracy);
    statusText.textContent = `時刻合わせ完了：${d.text}。精度は±${formatAccuracyJa(est.accuracy)}です。`;
    offsetEl.textContent = d.short;
    accEl.textContent = formatAccuracyJa(est.accuracy);
    rttEl.textContent = `${Math.round(est.minRtt)}ミリ秒`;
    if (est.accuracy > 250) statusText.textContent += ' 通信の遅延が大きいため、安定した回線でもう一度合わせるとより正確になります。';
  }

  /* ---------- Sync ---------- */
  async function sync() {
    const run = ++syncRun;
    renderSync(null, 'pending');
    const est = await syncClock({
      cancelled: () => run !== syncRun,
      onProgress: (e, round, rounds) => {
        offset = e.offset;
        renderSync(e, 'pending', round > 0 ? `（${round}/${rounds}）` : '');
      },
    });
    if (run !== syncRun) return;
    offset = est ? est.offset : 0;
    renderSync(est, est ? 'ok' : 'fail');
  }

  /* ---------- Countdown ---------- */
  function startCountdown() {
    const secs = parseTimeOfDay(targetInput.value);
    if (secs === null) {
      showNotice('正しい時刻を入力してください（例：10:00:00）。', 'error');
      return;
    }
    showNotice('');
    if (soundBox.checked) unlockAudio();
    countdownTarget = secs;
    lastBeepAt = Number.NaN;
    lastCd = '';
    cdBox.hidden = false;
    cdToggle.textContent = 'カウントダウン停止';
    persist();
  }

  function stopCountdown() {
    countdownTarget = null;
    cdBox.hidden = true;
    root.dataset.mode = 'clock';
    cdToggle.textContent = 'カウントダウン開始';
    setTitle(baseTitle);
  }

  cdToggle.addEventListener('click', () => (countdownTarget === null ? startCountdown() : stopCountdown()));
  targetInput.addEventListener('change', () => {
    persist();
    if (countdownTarget !== null) startCountdown();
  });
  for (const button of quickButtons) {
    button.addEventListener('click', () => {
      targetInput.value = button.dataset.time ?? '10:00:00';
      startCountdown();
    });
  }
  soundBox.addEventListener('change', () => {
    persist();
    if (soundBox.checked) unlockAudio();
  });
  signalBox.addEventListener('change', () => {
    if (signalBox.checked) unlockAudio();
  });

  /* ---------- Controls ---------- */
  resyncBtn.addEventListener('click', () => void sync());
  msBox.addEventListener('change', () => {
    root.classList.toggle('with-ms', msBox.checked);
    lastClock = '';
    persist();
  });
  root.classList.toggle('with-ms', msBox.checked);

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else root.requestFullscreen().catch(() => showNotice('全画面表示にできませんでした。', 'error'));
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? '全画面を終了' : '全画面';
  });

  // Re-sync after the page was in the background for a while (the device clock may have been adjusted).
  let hiddenAt = 0;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) hiddenAt = Date.now();
    else if (hiddenAt && Date.now() - hiddenAt > 10 * 60_000) void sync();
  });

  requestAnimationFrame(frame);
  void sync();
</script>

<style>
  .jt-face {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px 0 4px;
    text-align: center;
  }
  .jt-zone {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .jt-clock {
    font-size: clamp(40px, 15vw, 120px);
    white-space: nowrap;
  }
  .with-ms .jt-clock {
    font-size: clamp(28px, 10.5vw, 104px);
  }
  .jt-date {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1em;
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .jt-jiho {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .jt-cd {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin-top: 12px;
    padding: 12px 20px;
    width: 100%;
    max-width: 560px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .jt-cd-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .jt-cd-value {
    font-family: var(--mono);
    font-size: clamp(30px, 10vw, 64px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    white-space: nowrap;
  }
  [data-mode='final'] .jt-cd {
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  [data-mode='final'] .jt-cd-value,
  [data-mode='go'] .jt-cd-label,
  [data-mode='go'] .jt-cd-value {
    color: var(--accent);
  }
  [data-mode='go'] .jt-cd {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .jt-status {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    font-size: 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-2);
  }
  .jt-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--muted);
  }
  [data-sync='ok'] .jt-dot {
    background: var(--success);
  }
  [data-sync='fail'] .jt-status {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 10%, transparent);
  }
  [data-sync='fail'] .jt-dot {
    background: var(--danger);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-sync='pending'] .jt-dot {
      animation: jt-pulse 1s ease-in-out infinite;
    }
  }
  @keyframes jt-pulse {
    50% {
      opacity: 0.25;
    }
  }

  .jt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
  }
  .jt-stats .stat-value {
    font-size: 18px;
  }

  .jt-ticket {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .jt-ticket-title {
    font-size: 18px;
  }
  .jt-ticket .hint {
    margin: -6px 0 0;
  }
  .jt-ticket-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    align-items: end;
    gap: 10px;
  }
  .jt-ticket-row input {
    font-variant-numeric: tabular-nums;
  }
  .jt-ticket-row .btn {
    min-height: 44px;
  }

  /* Fullscreen: clock and countdown only. */
  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
  }
  .tool:fullscreen .jt-stats,
  .tool:fullscreen .jt-ticket,
  .tool:fullscreen .jt-status {
    display: none;
  }
  .tool:fullscreen .jt-clock {
    font-size: min(18vw, 34vh);
  }
  .tool.with-ms:fullscreen .jt-clock {
    font-size: min(12vw, 30vh);
  }
  .tool:fullscreen .jt-date {
    font-size: min(3.2vw, 28px);
  }
  .tool:fullscreen .jt-cd {
    max-width: 80vw;
  }
  .tool:fullscreen .jt-cd-value {
    font-size: min(9vw, 18vh);
  }
</style>
