---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { categoriesFor, unitLabel } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const categories = categoriesFor(s.client.unitSet);
const first = categories[0];
---

<div class="tool" data-tool="unit-converter" {...i18nAttrs(locale, s.client)}>
  <div class="seg" role="radiogroup" aria-label={s.categoryAria}>
    {
      categories.map((c, i) => (
        <label>
          <input type="radio" name="uc-cat" value={c.key} checked={i === 0} />
          <span>{s.categories[c.key]}</span>
        </label>
      ))
    }
  </div>

  <div class="uc-pair">
    <div class="field">
      <label for="uc-value">{s.valueLabel}</label>
      <input id="uc-value" type="text" inputmode="decimal" autocomplete="off" value={String(first.defaults.value)} />
      <select id="uc-from" aria-label={s.fromAria}>
        {first.units.map((u) => <option value={u.id} selected={u.id === first.defaults.from}>{unitLabel(u, s.client)}</option>)}
      </select>
    </div>
    <button class="btn uc-swap" type="button" id="uc-swap" aria-label={s.swap} title={s.swap}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"></path></svg>
    </button>
    <div class="field">
      <label for="uc-result">{s.resultLabel}</label>
      <input id="uc-result" type="text" readonly />
      <select id="uc-to" aria-label={s.toAria}>
        {first.units.map((u) => <option value={u.id} selected={u.id === first.defaults.to}>{unitLabel(u, s.client)}</option>)}
      </select>
    </div>
  </div>

  <div class="row between">
    <p class="uc-line" id="uc-line" aria-live="polite"></p>
    <button class="btn small" type="button" data-copy="#uc-result">{s.copyResult}</button>
  </div>
  <p class="notice error" id="uc-error" hidden></p>

  <div class="field">
    <span class="label" id="uc-table-title">{s.tableTitle}</span>
    <div class="table-wrap">
      <table class="table" aria-labelledby="uc-table-title">
        <thead>
          <tr><th>{s.thUnit}</th><th class="num">{s.thValue}</th></tr>
        </thead>
        <tbody id="uc-table"></tbody>
      </table>
    </div>
    <p class="hint" id="uc-hint"></p>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import {
    categoriesFor,
    convert,
    convertAll,
    formatValue,
    getCategory as getCategoryIn,
    getUnit,
    unitLabel,
    unitSymbol,
    type CategoryKey,
    type UnitSet,
  } from './logic';
  import type { Strings } from './i18n';

  interface CategoryState {
    from: string;
    to: string;
    value: string;
  }
  interface Prefs {
    cat: CategoryKey;
    state: Partial<Record<CategoryKey, CategoryState>>;
  }

  const root = $('[data-tool="unit-converter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const unitSet: UnitSet = s.unitSet ?? 'tw';
  const CATEGORIES = categoriesFor(unitSet);
  const getCategory = (key: string) => getCategoryIn(key, unitSet);
  const fmt = (v: number) => formatValue(v, locale);
  const radios = $$<HTMLInputElement>('input[name="uc-cat"]', root);
  const valueInput = $<HTMLInputElement>('#uc-value', root);
  const fromSelect = $<HTMLSelectElement>('#uc-from', root);
  const toSelect = $<HTMLSelectElement>('#uc-to', root);
  const result = $<HTMLInputElement>('#uc-result', root);
  const line = $('#uc-line', root);
  const error = $('#uc-error', root);
  const table = $('#uc-table', root);
  const hint = $('#uc-hint', root);

  // Unit sets differ per locale, so each set keeps its own remembered state (zh keeps the original key).
  const prefKey = unitSet === 'tw' ? 'unit-converter' : `unit-converter:${unitSet}`;
  const prefs = loadPref<Prefs>(prefKey, { cat: 'length', state: {} });
  let current: CategoryKey = getCategory(prefs.cat).key;

  function stateFor(key: CategoryKey): CategoryState {
    const cat = getCategory(key);
    const saved = prefs.state[key];
    const valid = saved && getUnit(cat, saved.from) && getUnit(cat, saved.to);
    return valid ? saved : { from: cat.defaults.from, to: cat.defaults.to, value: String(cat.defaults.value) };
  }

  function fillSelect(select: HTMLSelectElement, key: CategoryKey, selected: string) {
    select.replaceChildren(
      ...getCategory(key).units.map((u) => {
        const opt = document.createElement('option');
        opt.value = u.id;
        opt.textContent = unitLabel(u, s);
        opt.selected = u.id === selected;
        return opt;
      }),
    );
  }

  function loadCategory(key: CategoryKey) {
    current = key;
    const st = stateFor(key);
    for (const r of radios) r.checked = r.value === key;
    fillSelect(fromSelect, key, st.from);
    fillSelect(toSelect, key, st.to);
    valueInput.value = st.value;
    hint.textContent = s.hints[key];
    render();
  }

  function render() {
    const cat = getCategory(current);
    prefs.cat = current;
    prefs.state[current] = { from: fromSelect.value, to: toSelect.value, value: valueInput.value };
    savePref(prefKey, prefs);

    const value = parseNumber(valueInput.value);
    const from = getUnit(cat, fromSelect.value)!;
    const to = getUnit(cat, toSelect.value)!;
    const converted = convert(value, cat.key, from.id, to.id, unitSet);

    if (valueInput.value.trim() === '') {
      error.hidden = true;
      result.value = '';
      line.textContent = s.enterValue;
      table.replaceChildren();
      return;
    }
    if (Number.isNaN(converted)) {
      error.hidden = false;
      error.textContent =
        cat.key === 'temperature' && Number.isFinite(value) ? s.errorTemperature : s.errorPositive;
      result.value = '';
      line.textContent = '';
      table.replaceChildren();
      return;
    }

    error.hidden = true;
    result.value = fmt(converted);
    line.textContent = `${fmt(value)} ${unitSymbol(from, s)} = ${fmt(converted)} ${unitSymbol(to, s)}`;
    table.replaceChildren(
      ...convertAll(value, cat.key, from.id, unitSet).map(({ unit, value: v }) => {
        const tr = document.createElement('tr');
        if (unit.id === to.id) tr.className = 'is-target';
        const name = document.createElement('td');
        name.textContent = unitLabel(unit, s);
        const num = document.createElement('td');
        num.className = 'num';
        num.textContent = fmt(v);
        tr.append(name, num);
        return tr;
      }),
    );
  }

  radios.forEach((r) => r.addEventListener('change', () => loadCategory(r.value as CategoryKey)));
  valueInput.addEventListener('input', render);
  fromSelect.addEventListener('change', render);
  toSelect.addEventListener('change', render);
  $('#uc-swap', root).addEventListener('click', () => {
    const from = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = from;
    render();
  });

  loadCategory(CATEGORIES.some((c) => c.key === current) ? current : 'length');
</script>

<style>
  .uc-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 12px;
  }
  .uc-swap {
    margin-bottom: 26px;
    padding: 8px 10px;
  }
  #uc-result {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .uc-line {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  #uc-table :global(.is-target td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .uc-pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .uc-swap {
      justify-self: center;
      margin: 0;
      transform: rotate(90deg);
    }
  }
</style>
