<div class="tool" data-tool="year-end-bonus">
  <div class="field">
    <span class="label">年終計算方式</span>
    <div class="seg" role="radiogroup" aria-label="年終計算方式">
      <label><input type="radio" name="yb-mode" value="months" checked /><span>月薪 × 月數</span></label>
      <label><input type="radio" name="yb-mode" value="fixed" /><span>固定金額</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="yb-salary">月薪（元）</label>
      <input id="yb-salary" type="text" inputmode="numeric" autocomplete="off" value="45000" />
      <span class="hint">用來換算年終金額與預設健保投保金額。</span>
    </div>
    <div class="field" id="yb-months-field">
      <label for="yb-months">年終月數</label>
      <input id="yb-months" type="text" inputmode="decimal" autocomplete="off" value="2" />
      <span class="hint">例如 1.5 代表 1.5 個月。</span>
    </div>
    <div class="field" id="yb-fixed-field" hidden>
      <label for="yb-fixed">年終獎金金額（元）</label>
      <input id="yb-fixed" type="text" inputmode="numeric" autocomplete="off" value="100000" />
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="yb-prorate" /> 今年未做滿一年，依在職月數比例發放</label>
  </div>
  <div class="field" id="yb-employed-field" hidden>
    <label for="yb-employed">今年在職月數</label>
    <input id="yb-employed" type="text" inputmode="decimal" autocomplete="off" value="6" />
    <span class="hint">例如 7 月 1 日到職、年底發放，填 6。公司規定的比例算法不同時，請改用固定金額。</span>
  </div>

  <details class="yb-more">
    <summary>進階設定：健保投保金額、已領獎金、發放年度</summary>
    <div class="grid-2">
      <div class="field">
        <label for="yb-insured">健保投保金額（留空 = 依月薪）</label>
        <input id="yb-insured" type="text" inputmode="numeric" autocomplete="off" placeholder="自動" />
        <span class="hint">以發放當月投保金額計算；離職後才領的，以離職當月投保金額計算。</span>
      </div>
      <div class="field">
        <label for="yb-prior">今年已領的其他獎金（元）</label>
        <input id="yb-prior" type="text" inputmode="numeric" autocomplete="off" value="0" />
        <span class="hint">同一公司今年已發的三節、績效、分紅等獎金，會累計進 4 倍門檻。</span>
      </div>
      <div class="field">
        <label for="yb-year">發放年度</label>
        <select id="yb-year">
          <option value="2026">2026 年發放（115 年度）</option>
          <option value="2027" selected>2027 年發放（116 年度）</option>
        </select>
        <span class="hint">2026 年的年終多在 2027 年 1、2 月發放，適用 116 年度扣繳標準。</span>
      </div>
    </div>
  </details>

  <div class="notice error" id="yb-error" hidden></div>

  <div id="yb-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="yb-net">—</div>
      <div class="result-label" id="yb-net-label">年終實際入帳金額</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="yb-gross">—</span><span class="stat-label">年終獎金總額</span></div>
      <div class="stat"><span class="stat-value" id="yb-tax">—</span><span class="stat-label">所得稅預扣（5%）</span></div>
      <div class="stat"><span class="stat-value" id="yb-nhi">—</span><span class="stat-label">二代健保補充保費</span></div>
      <div class="stat"><span class="stat-value" id="yb-room">—</span><span class="stat-label">今年還能領多少免扣補充保費</span></div>
    </div>

    <p class="notice" id="yb-note" hidden></p>

    <div class="field">
      <span class="label">計算明細</span>
      <div class="table-wrap">
        <table class="table">
          <tbody id="yb-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">所得稅依財政部非每月給付薪資扣繳規定：單次給付達起扣標準（115 年度 90,501 元）按全額扣 5%；二代健保補充保費依健保署規定，同一雇主全年累計獎金超過當月投保金額 4 倍的部分扣 2.11%。預扣的稅只是預繳，隔年 5 月報稅時多退少補。結果僅供參考，實際以公司薪資單為準。所有計算在你的瀏覽器內完成，資料不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, parseNumber } from '../../lib/format';
  import {
    BONUS_RULES,
    calculateYearEndBonus,
    healthInsuredFor,
    validateYearEndBonus,
    type PayYear,
    type YearEndBonusInput,
  } from './logic';

  interface Prefs {
    mode: string;
    salary: string;
    months: string;
    fixed: string;
    prorate: boolean;
    employed: string;
    insured: string;
    prior: string;
    year: string;
  }

  const root = $('[data-tool="year-end-bonus"]');
  const modes = $$<HTMLInputElement>('input[name="yb-mode"]', root);
  const salary = $<HTMLInputElement>('#yb-salary', root);
  const months = $<HTMLInputElement>('#yb-months', root);
  const fixed = $<HTMLInputElement>('#yb-fixed', root);
  const prorate = $<HTMLInputElement>('#yb-prorate', root);
  const employed = $<HTMLInputElement>('#yb-employed', root);
  const insured = $<HTMLInputElement>('#yb-insured', root);
  const prior = $<HTMLInputElement>('#yb-prior', root);
  const year = $<HTMLSelectElement>('#yb-year', root);
  const error = $('#yb-error', root);
  const output = $('#yb-output', root);
  const note = $('#yb-note', root);
  const table = $('#yb-table', root);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const mode = () => (modes.find((m) => m.checked)?.value === 'fixed' ? 'fixed' : 'months');

  const prefs = loadPref<Partial<Prefs>>('year-end-bonus', {});
  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.salary !== undefined) salary.value = prefs.salary;
  if (prefs.months !== undefined) months.value = prefs.months;
  if (prefs.fixed !== undefined) fixed.value = prefs.fixed;
  if (prefs.prorate !== undefined) prorate.checked = prefs.prorate;
  if (prefs.employed !== undefined) employed.value = prefs.employed;
  if (prefs.insured !== undefined) insured.value = prefs.insured;
  if (prefs.prior !== undefined) prior.value = prefs.prior;
  if (prefs.year && year.querySelector(`option[value="${prefs.year}"]`)) year.value = prefs.year;

  function readInput(): YearEndBonusInput {
    const m = mode();
    const salaryText = salary.value.trim();
    return {
      salary: salaryText === '' && m === 'fixed' ? 0 : parseNumber(salary.value),
      mode: m,
      months: m === 'months' ? parseNumber(months.value) : 0,
      fixedAmount: m === 'fixed' ? parseNumber(fixed.value) : 0,
      prorate: prorate.checked,
      employedMonths: prorate.checked ? parseNumber(employed.value) : 12,
      insuredOverride: insured.value.trim() === '' ? undefined : parseNumber(insured.value),
      priorBonus: prior.value.trim() === '' ? 0 : parseNumber(prior.value),
      payYear: Number(year.value) as PayYear,
    };
  }

  function row(label: string, value: string): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const th = document.createElement('td');
    th.textContent = label;
    const td = document.createElement('td');
    td.className = 'num';
    td.textContent = value;
    tr.append(th, td);
    return tr;
  }

  function render() {
    const m = mode();
    $('#yb-months-field', root).hidden = m !== 'months';
    $('#yb-fixed-field', root).hidden = m !== 'fixed';
    $('#yb-employed-field', root).hidden = !prorate.checked;

    savePref('year-end-bonus', {
      mode: m,
      salary: salary.value,
      months: months.value,
      fixed: fixed.value,
      prorate: prorate.checked,
      employed: employed.value,
      insured: insured.value,
      prior: prior.value,
      year: year.value,
    } satisfies Prefs);

    const input = readInput();
    const problem = validateYearEndBonus(input);
    const r = problem ? null : calculateYearEndBonus(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    insured.placeholder = input.salary > 0 ? `自動：${formatInteger(healthInsuredFor(input.salary))}` : '自動';

    set('#yb-net', money(r.net));
    set('#yb-net-label', `年終實際入帳金額（約為總額的 ${(r.netRatio * 100).toFixed(1)}%）`);
    set('#yb-gross', money(r.gross));
    set('#yb-tax', money(r.tax));
    set('#yb-nhi', money(r.nhi.premium));
    set('#yb-room', money(r.nhi.remainingRoom));

    const rule = BONUS_RULES.withholdingThreshold[input.payYear];
    const notes: string[] = [];
    if (!r.taxApplies && r.gross > 0) {
      notes.push(`年終未達起扣標準 ${formatInteger(r.taxThreshold)} 元，發放時不預扣所得稅，但仍要併入全年薪資所得申報。`);
    }
    if (!rule.official) {
      notes.push('116 年度薪資扣繳起扣標準預計 2026 年 12 月公告，目前暫以 115 年度 90,501 元計算，公告後會更新。');
    }
    if (r.nhi.capped) notes.push('單次給付超過 1,000 萬元，補充保費以 1,000 萬元計算。');
    note.textContent = notes.join(' ');
    note.hidden = notes.length === 0;

    const prorated = input.prorate ? `× ${input.employedMonths}/12` : '';
    const grossLabel =
      input.mode === 'months'
        ? `年終總額（${formatInteger(input.salary)} × ${input.months} 個月${prorated ? ` ${prorated}` : ''}）`
        : `年終總額${prorated ? `（固定金額 ${prorated}）` : ''}`;
    table.replaceChildren(
      row(grossLabel, money(r.gross)),
      row(`所得稅起扣標準（${rule.label}）`, money(r.taxThreshold)),
      row(r.taxApplies ? '所得稅預扣：總額 × 5%' : '所得稅預扣：未達起扣標準', money(r.tax)),
      row('健保投保金額', money(r.insured)),
      row('補充保費門檻（投保金額 × 4）', money(r.nhi.threshold)),
      row('今年已領其他獎金', money(input.priorBonus)),
      row('本次計費金額（累計超過門檻部分）', money(r.nhi.base)),
      row('二代健保補充保費：計費金額 × 2.11%', money(r.nhi.premium)),
      row('實際入帳', money(r.net)),
    );
    table.lastElementChild?.classList.add('yb-total');
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #yb-output {
    display: grid;
    gap: 16px;
  }
  #yb-output[hidden] {
    display: none;
  }
  .yb-more {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .yb-more[open] {
    display: grid;
    gap: 14px;
  }
  .yb-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
  #yb-table :global(td:first-child) {
    white-space: normal;
  }
  #yb-table :global(.yb-total td) {
    font-weight: 700;
    background: var(--surface-2);
  }
</style>
