---
const QUICK_TIMES = ['10:00', '11:00', '12:00', '13:00', '14:00', '18:00', '20:00'];
---

<div class="tool" data-tool="taiwan-time" data-sync="pending" data-mode="clock">
  <div class="tt-face">
    <p class="tt-zone">台灣標準時間 <span class="muted">UTC+8</span></p>
    <div class="big-display tt-clock" id="tt-clock" role="timer" aria-label="台灣目前時間">--:--:--</div>
    <p class="tt-date" id="tt-date">&nbsp;</p>

    <div class="tt-cd" id="tt-cd" hidden>
      <span class="tt-cd-label" id="tt-cd-label">距離 12:00:00 開賣</span>
      <span class="tt-cd-value" id="tt-cd-value" role="timer">00:00:00.0</span>
    </div>
  </div>

  <div class="tt-status" id="tt-status" aria-live="polite">
    <span class="tt-dot" aria-hidden="true"></span>
    <span id="tt-status-text">正在與伺服器校時…</span>
  </div>

  <div class="tt-controls">
    <button class="btn" type="button" id="tt-resync">重新校時</button>
    <label class="check"><input type="checkbox" id="tt-ms" /> 顯示毫秒</label>
    <button class="btn" type="button" id="tt-fullscreen">全螢幕</button>
  </div>

  <div class="stats tt-stats">
    <div class="stat"><span class="stat-value" id="tt-offset">—</span><span class="stat-label">裝置時間誤差</span></div>
    <div class="stat"><span class="stat-value" id="tt-acc">—</span><span class="stat-label">校時精度（±）</span></div>
    <div class="stat"><span class="stat-value" id="tt-rtt">—</span><span class="stat-label">最低網路延遲</span></div>
    <div class="stat"><span class="stat-value" id="tt-device">—</span><span class="stat-label">你的裝置時鐘</span></div>
  </div>

  <section class="tt-ticket" aria-labelledby="tt-ticket-title">
    <h2 class="tt-ticket-title" id="tt-ticket-title">搶票倒數</h2>
    <p class="hint">輸入開賣時間（台灣時間），倒數會依校時後的標準時間計算，精確到 0.1 秒。</p>
    <div class="tt-ticket-row">
      <div class="field">
        <label for="tt-target">開賣時間</label>
        <input id="tt-target" type="time" step="1" value="12:00:00" />
      </div>
      <button class="btn primary" type="button" id="tt-cd-toggle">開始倒數</button>
    </div>
    <div class="row" id="tt-quick">
      {
        QUICK_TIMES.map((t) => (
          <button class="btn small" type="button" data-time={`${t}:00`}>
            {t}
          </button>
        ))
      }
    </div>
    <label class="check"><input type="checkbox" id="tt-sound" checked /> 最後 5 秒提示音</label>
    <p class="notice" id="tt-notice" hidden></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { syncClock } from './sync';
  import {
    describeOffset,
    formatAccuracy,
    formatClock,
    formatDateLine,
    formatElapsed,
    formatOffsetAmount,
    formatRocLine,
    formatTenths,
    formatTimeOfDay,
    nextTaipeiOccurrence,
    parseTimeOfDay,
    taipeiParts,
    type OffsetEstimate,
  } from './logic';

  interface Prefs {
    showMs: boolean;
    target: string;
    sound: boolean;
  }

  const AFTER_TARGET_MS = 60_000; // keep showing 「已開賣」 this long before moving to tomorrow

  const root = $('[data-tool="taiwan-time"]');
  const clockEl = $('#tt-clock', root);
  const dateEl = $('#tt-date', root);
  const statusText = $('#tt-status-text', root);
  const resyncBtn = $<HTMLButtonElement>('#tt-resync', root);
  const msBox = $<HTMLInputElement>('#tt-ms', root);
  const fsBtn = $<HTMLButtonElement>('#tt-fullscreen', root);
  const offsetEl = $('#tt-offset', root);
  const accEl = $('#tt-acc', root);
  const rttEl = $('#tt-rtt', root);
  const deviceEl = $('#tt-device', root);
  const cdBox = $('#tt-cd', root);
  const cdLabel = $('#tt-cd-label', root);
  const cdValue = $('#tt-cd-value', root);
  const targetInput = $<HTMLInputElement>('#tt-target', root);
  const cdToggle = $<HTMLButtonElement>('#tt-cd-toggle', root);
  const soundBox = $<HTMLInputElement>('#tt-sound', root);
  const notice = $('#tt-notice', root);
  const quickButtons = $$<HTMLButtonElement>('#tt-quick button', root);
  const baseTitle = document.title;

  const prefs = loadPref<Prefs>('taiwan-time', { showMs: false, target: '12:00:00', sound: true });
  msBox.checked = prefs.showMs === true;
  soundBox.checked = prefs.sound !== false;
  if (parseTimeOfDay(prefs.target) !== null) targetInput.value = formatTimeOfDay(parseTimeOfDay(prefs.target)!);

  /** server − device, ms. 0 until synced (or when sync fails: device time is shown). */
  let offset = 0;
  let syncRun = 0;
  let countdownTarget: number | null = null; // seconds of day while the countdown is on
  let lastClock = '';
  let lastCd = '';
  let lastDate = '';
  let lastTitle = '';
  let lastBeepAt = Number.NaN;

  const now = () => Date.now() + offset;

  function persist() {
    savePref('taiwan-time', { showMs: msBox.checked, target: targetInput.value, sound: soundBox.checked });
  }

  function showNotice(text: string, kind: '' | 'error' | 'ok' = '') {
    notice.textContent = text;
    notice.className = kind ? `notice ${kind}` : 'notice';
    notice.hidden = text === '';
  }

  /* ---------- Sound (WebAudio, unlocked by a click) ---------- */
  let audio: AudioContext | null = null;
  function unlockAudio(): AudioContext | null {
    const Ctor =
      window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return null;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
    return audio;
  }
  function beep(frequency: number, duration: number) {
    const ctx = audio;
    if (!ctx || ctx.state !== 'running') return;
    const at = ctx.currentTime + 0.01;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(0.3, at + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);
    osc.connect(gain).connect(ctx.destination);
    osc.start(at);
    osc.stop(at + duration + 0.02);
  }

  /* ---------- Rendering ---------- */
  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function renderCountdown(t: number) {
    if (countdownTarget === null) return;
    const target = nextTaipeiOccurrence(t, countdownTarget, AFTER_TARGET_MS);
    const remaining = target - t;
    const label = formatTimeOfDay(countdownTarget);
    let text: string;
    if (remaining > 0) {
      text = formatTenths(remaining);
      cdLabel.textContent = `距離 ${label} 開賣`;
      root.dataset.mode = remaining <= 10_000 ? 'final' : 'countdown';
      // Beep on each of the last five whole seconds, a longer tone at zero.
      const whole = Math.ceil(remaining / 1000);
      if (soundBox.checked && whole <= 5 && whole !== lastBeepAt) {
        lastBeepAt = whole;
        beep(880, 0.12);
      }
      setTitle(`${text.slice(0, 8)} 搶票倒數`);
    } else {
      text = formatElapsed(-remaining);
      cdLabel.textContent = `${label} 已開賣`;
      root.dataset.mode = 'go';
      if (soundBox.checked && lastBeepAt !== 0) {
        lastBeepAt = 0;
        beep(1320, 0.5);
      }
      setTitle(`已開賣 ${label}`);
    }
    if (text !== lastCd) cdValue.textContent = lastCd = text;
  }

  function frame() {
    const t = now();
    const parts = taipeiParts(t);
    const clock = formatClock(parts, msBox.checked);
    if (clock !== lastClock) {
      clockEl.textContent = lastClock = clock;
      const dateText = `${formatDateLine(parts)}（${formatRocLine(parts)}）`;
      if (dateText !== lastDate) dateEl.textContent = lastDate = dateText;
      deviceEl.textContent = formatClock(taipeiParts(Date.now()));
      if (countdownTarget === null) setTitle(`${formatClock(parts)} 台灣時間`);
    }
    renderCountdown(t);
    requestAnimationFrame(frame);
  }

  function renderSync(est: OffsetEstimate | null, state: 'pending' | 'ok' | 'fail', progress = '') {
    root.dataset.sync = state;
    resyncBtn.disabled = state === 'pending';
    if (state === 'pending') {
      statusText.textContent = `正在與伺服器校時…${progress}`;
      return;
    }
    if (state === 'fail' || !est) {
      statusText.textContent = '無法取得伺服器時間，目前顯示的是你裝置的時鐘（已換算成台灣時間）。請確認網路後按「重新校時」。';
      offsetEl.textContent = '未校時';
      accEl.textContent = '—';
      rttEl.textContent = '—';
      return;
    }
    const d = describeOffset(est.offset, est.accuracy);
    statusText.textContent = `已校時：${d.text}，估計精度 ±${formatAccuracy(est.accuracy)}。`;
    offsetEl.textContent = d.direction === 'exact' ? '準確' : `${d.direction === 'slow' ? '慢' : '快'} ${formatOffsetAmount(est.offset)}`;
    accEl.textContent = formatAccuracy(est.accuracy);
    rttEl.textContent = `${Math.round(est.minRtt)} 毫秒`;
    if (est.accuracy > 250) {
      statusText.textContent += ' 網路延遲偏高，換到穩定的網路後再校時會更準。';
    }
  }

  /* ---------- Sync ---------- */
  async function sync() {
    const run = ++syncRun;
    renderSync(null, 'pending');
    const est = await syncClock({
      cancelled: () => run !== syncRun,
      onProgress: (e, round, rounds) => {
        offset = e.offset;
        renderSync(e, 'pending', round > 0 ? `（${round}/${rounds}）` : '');
      },
    });
    if (run !== syncRun) return;
    offset = est ? est.offset : 0;
    renderSync(est, est ? 'ok' : 'fail');
  }

  /* ---------- Countdown ---------- */
  function startCountdown() {
    const secs = parseTimeOfDay(targetInput.value);
    if (secs === null) {
      showNotice('請輸入正確的時間，例如 12:00:00。', 'error');
      return;
    }
    showNotice('');
    if (soundBox.checked) unlockAudio();
    countdownTarget = secs;
    lastBeepAt = Number.NaN;
    lastCd = '';
    cdBox.hidden = false;
    cdToggle.textContent = '停止倒數';
    persist();
  }

  function stopCountdown() {
    countdownTarget = null;
    cdBox.hidden = true;
    root.dataset.mode = 'clock';
    cdToggle.textContent = '開始倒數';
    setTitle(baseTitle);
  }

  cdToggle.addEventListener('click', () => (countdownTarget === null ? startCountdown() : stopCountdown()));
  targetInput.addEventListener('change', () => {
    persist();
    if (countdownTarget !== null) startCountdown();
  });
  for (const button of quickButtons) {
    button.addEventListener('click', () => {
      targetInput.value = button.dataset.time ?? '12:00:00';
      startCountdown();
    });
  }
  soundBox.addEventListener('change', () => {
    persist();
    if (soundBox.checked) unlockAudio();
  });

  /* ---------- Controls ---------- */
  resyncBtn.addEventListener('click', () => void sync());
  msBox.addEventListener('change', () => {
    root.classList.toggle('with-ms', msBox.checked);
    lastClock = '';
    persist();
  });
  root.classList.toggle('with-ms', msBox.checked);

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else root.requestFullscreen().catch(() => showNotice('無法進入全螢幕模式。', 'error'));
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? '離開全螢幕' : '全螢幕';
  });

  // Re-sync after the page was in the background for a while (the device clock may have been adjusted).
  let hiddenAt = 0;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) hiddenAt = Date.now();
    else if (hiddenAt && Date.now() - hiddenAt > 10 * 60_000) void sync();
  });

  requestAnimationFrame(frame);
  void sync();
</script>

<style>
  .tt-face {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px 0 4px;
    text-align: center;
  }
  .tt-zone {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .tt-clock {
    font-size: clamp(40px, 15vw, 120px);
    white-space: nowrap;
  }
  .with-ms .tt-clock {
    font-size: clamp(28px, 10.5vw, 104px);
  }
  .tt-date {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .tt-cd {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin-top: 12px;
    padding: 12px 20px;
    width: 100%;
    max-width: 560px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .tt-cd-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tt-cd-value {
    font-family: var(--mono);
    font-size: clamp(30px, 10vw, 64px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    white-space: nowrap;
  }
  [data-mode='final'] .tt-cd {
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  [data-mode='final'] .tt-cd-value,
  [data-mode='go'] .tt-cd-label,
  [data-mode='go'] .tt-cd-value {
    color: var(--accent);
  }
  [data-mode='go'] .tt-cd {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .tt-status {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    font-size: 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-2);
  }
  .tt-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--muted);
  }
  [data-sync='ok'] .tt-dot {
    background: var(--success);
  }
  [data-sync='fail'] .tt-status {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 10%, transparent);
  }
  [data-sync='fail'] .tt-dot {
    background: var(--danger);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-sync='pending'] .tt-dot {
      animation: tt-pulse 1s ease-in-out infinite;
    }
  }
  @keyframes tt-pulse {
    50% {
      opacity: 0.25;
    }
  }

  .tt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
  }
  .tt-stats .stat-value {
    font-size: 18px;
  }

  .tt-ticket {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .tt-ticket-title {
    font-size: 18px;
  }
  .tt-ticket .hint {
    margin: -6px 0 0;
  }
  .tt-ticket-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    align-items: end;
    gap: 10px;
  }
  .tt-ticket-row input {
    font-variant-numeric: tabular-nums;
  }
  .tt-ticket-row .btn {
    min-height: 44px;
  }

  /* Fullscreen: clock and countdown only. */
  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
  }
  .tool:fullscreen .tt-stats,
  .tool:fullscreen .tt-ticket,
  .tool:fullscreen .tt-status {
    display: none;
  }
  .tool:fullscreen .tt-clock {
    font-size: min(18vw, 34vh);
  }
  .tool.with-ms:fullscreen .tt-clock {
    font-size: min(12vw, 30vh);
  }
  .tool:fullscreen .tt-date {
    font-size: min(3.2vw, 28px);
  }
  .tool:fullscreen .tt-cd {
    max-width: 80vw;
  }
  .tool:fullscreen .tt-cd-value {
    font-size: min(9vw, 18vh);
  }
</style>
