---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="lorem-ipsum" {...i18nAttrs(locale, s.client)}>
  <div class="li-controls">
    {
      s.langs.length > 1 ? (
        <div class="field">
          <span class="label">{s.langLabel}</span>
          <div class="seg" role="radiogroup" aria-label={s.langLabel}>
            {s.langs.map((l, i) => (
              <Fragment>{' '}<label><input type="radio" name="li-lang" value={l.value} checked={i === 0} /><span>{l.label}</span></label></Fragment>
            ))}
          </div>
        </div>
      ) : (
        <input type="radio" name="li-lang" value={s.langs[0].value} checked hidden />
      )
    }
    <div class="field">
      <span class="label">{s.unitLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.unitLabel}>
        <label><input type="radio" name="li-unit" value="paragraphs" checked /><span>{s.units.paragraphs}</span></label>
        <label><input type="radio" name="li-unit" value="sentences" /><span>{s.units.sentences}</span></label>
        <label data-la-only><input type="radio" name="li-unit" value="words" /><span>{s.units.words}</span></label>
        <label><input type="radio" name="li-unit" value="chars" /><span>{s.units.chars}</span></label>
      </div>
    </div>
    <div class="field li-count">
      <label for="li-count" id="li-count-label">{s.client.countLabels.paragraphs}</label>
      <input type="number" id="li-count" min="1" max="50" step="1" value="3" inputmode="numeric" />
    </div>
  </div>

  <div class="row">
    <label class="check" data-la-only><input type="checkbox" id="li-classic" checked /> {s.classicStart}</label>
    <label class="check"><input type="checkbox" id="li-html" /> {s.htmlTags}</label>
  </div>

  <div class="field">
    <label for="li-output">{s.outputLabel}</label>
    <textarea id="li-output" rows="12" readonly></textarea>
    <span class="hint" id="li-info" aria-live="polite"></span>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#li-output">{s.copy}</button>
    <button class="btn" type="button" id="li-regen">{s.regenerate}</button>
  </div>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { plural } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import { LIMITS, UNITS, clampCount, generateLorem, visibleLength, type LoremLang, type LoremUnit } from './logic';

  const root = $('[data-tool="lorem-ipsum"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const langRadios = $$<HTMLInputElement>('input[name="li-lang"]', root);
  const unitRadios = $$<HTMLInputElement>('input[name="li-unit"]', root);
  const count = $<HTMLInputElement>('#li-count', root);
  const countLabel = $('#li-count-label', root);
  const classic = $<HTMLInputElement>('#li-classic', root);
  const html = $<HTMLInputElement>('#li-html', root);
  const output = $<HTMLTextAreaElement>('#li-output', root);
  const info = $('#li-info', root);
  const laOnly = $$<HTMLElement>('[data-la-only]', root);

  const DEFAULT_COUNTS: Record<LoremUnit, number> = { paragraphs: 3, sentences: 5, words: 50, chars: 200 };

  interface Prefs {
    lang: LoremLang;
    unit: LoremUnit;
    counts: Record<LoremUnit, number>;
    classicStart: boolean;
    html: boolean;
  }

  const saved = loadPref<Partial<Prefs>>('lorem-ipsum', {});
  const counts: Record<LoremUnit, number> = { ...DEFAULT_COUNTS, ...saved.counts };
  const pick = <T extends string>(radios: HTMLInputElement[], fallback: T) => (radios.find((r) => r.checked)?.value ?? fallback) as T;

  // The first language rendered is the page's default; keep a saved choice only if this page offers it.
  const initialLang = langRadios.some((r) => r.value === saved.lang) ? saved.lang : langRadios[0]?.value;
  for (const r of langRadios) r.checked = r.value === initialLang;
  if (saved.unit && saved.unit in DEFAULT_COUNTS) for (const r of unitRadios) r.checked = r.value === saved.unit;
  classic.checked = saved.classicStart !== false;
  html.checked = Boolean(saved.html);

  function syncControls(): { lang: LoremLang; unit: LoremUnit } {
    const lang = pick<LoremLang>(langRadios, (langRadios[0]?.value as LoremLang) ?? 'zh');
    for (const el of laOnly) el.hidden = lang !== 'la';
    let unit = pick<LoremUnit>(unitRadios, 'paragraphs');
    if (!UNITS[lang].includes(unit)) {
      unit = 'paragraphs';
      for (const r of unitRadios) r.checked = r.value === unit;
    }
    countLabel.textContent = lang === 'la' && unit === 'chars' ? s.latinChars : s.countLabels[unit];
    count.max = String(LIMITS[unit]);
    return { lang, unit };
  }

  function render() {
    const { lang, unit } = syncControls();
    const n = clampCount(unit, Number(count.value));
    counts[unit] = n;
    savePref('lorem-ipsum', { lang, unit, counts, classicStart: classic.checked, html: html.checked } satisfies Prefs);
    output.value = generateLorem({ lang, unit, count: n, classicStart: classic.checked, html: html.checked });
    const plain = html.checked ? output.value.replace(/<\/?p>/g, '') : output.value;
    const words = lang === 'la' ? plural(locale, plain.split(/\s+/).filter(Boolean).length, s.words) : '';
    info.textContent = plural(locale, visibleLength(plain), s.chars) + words;
  }

  function onUnitOrLangChange() {
    const { unit } = syncControls();
    count.value = String(counts[unit]);
    render();
  }

  count.value = String(counts[syncControls().unit]);
  for (const r of [...langRadios, ...unitRadios]) r.addEventListener('change', onUnitOrLangChange);
  count.addEventListener('input', debounce(render, 200));
  count.addEventListener('change', () => {
    count.value = String(clampCount(syncControls().unit, Number(count.value)));
    render();
  });
  classic.addEventListener('change', render);
  html.addEventListener('change', render);
  $('#li-regen', root).addEventListener('click', render);
  render();
</script>

<style>
  .li-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
    align-items: flex-end;
  }
  .li-count input {
    width: 140px;
  }
  label[hidden] {
    display: none;
  }
</style>
