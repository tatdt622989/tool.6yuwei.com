---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="compound-interest" {...i18nAttrs(locale, s.client)}>
  <div class="grid-2">
    <div class="field">
      <label for="ci-principal">{s.principal}</label>
      <input id="ci-principal" type="text" inputmode="decimal" autocomplete="off" value={s.defaults.principal} />
    </div>
    <div class="field">
      <label for="ci-monthly">{s.monthly}</label>
      <input id="ci-monthly" type="text" inputmode="decimal" autocomplete="off" value={s.defaults.monthly} />
      <span class="hint">{s.monthlyHint}</span>
    </div>
    <div class="field">
      <label for="ci-rate">{s.rate}</label>
      <input id="ci-rate" type="text" inputmode="decimal" autocomplete="off" value={s.defaults.rate} />
    </div>
    <div class="field">
      <label for="ci-years">{s.years}</label>
      <input id="ci-years" type="text" inputmode="numeric" autocomplete="off" value={s.defaults.years} />
    </div>
    <div class="field">
      <label for="ci-freq">{s.freq}</label>
      <select id="ci-freq">
        <option value="1">{s.freqOptions[1]}</option>
        <option value="2">{s.freqOptions[2]}</option>
        <option value="4">{s.freqOptions[4]}</option>
        <option value="12" selected>{s.freqOptions[12]}</option>
        <option value="365">{s.freqOptions[365]}</option>
      </select>
    </div>
  </div>

  <p class="notice error" id="ci-error" hidden></p>

  <div id="ci-results">
    <div class="result">
      <div class="result-value" id="ci-final">—</div>
      <div class="result-label" id="ci-final-label">{s.finalLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ci-contributed">—</span><span class="stat-label">{s.contributed}</span></div>
      <div class="stat"><span class="stat-value" id="ci-interest">—</span><span class="stat-label">{s.interest}</span></div>
      <div class="stat"><span class="stat-value" id="ci-effective">—</span><span class="stat-label">{s.effective}</span></div>
      <div class="stat"><span class="stat-value" id="ci-double">—</span><span class="stat-label">{s.double}</span></div>
    </div>

    <div class="ci-bar" aria-hidden="true">
      <div class="ci-bar-principal" id="ci-bar-principal"></div>
      <div class="ci-bar-interest" id="ci-bar-interest"></div>
    </div>
    <div class="ci-legend">
      <span><i class="ci-dot ci-dot-principal"></i>{s.legendPrincipal} <b id="ci-pct-principal">—</b></span>
      <span><i class="ci-dot ci-dot-interest"></i>{s.legendInterest} <b id="ci-pct-interest">—</b></span>
    </div>

    <div class="field">
      <span class="label" id="ci-table-title">{s.tableTitle}</span>
      <div class="table-wrap">
        <table class="table" aria-labelledby="ci-table-title">
          <thead>
            <tr><th>{s.thYear}</th><th class="num">{s.thContributed}</th><th class="num">{s.thInterest}</th><th class="num">{s.thTotalInterest}</th><th class="num">{s.thBalance}</th></tr>
          </thead>
          <tbody id="ci-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { calculateCompound, ruleOf72, type Frequency } from './logic';
  import type { Strings } from './i18n';

  interface Prefs {
    principal: string;
    monthly: string;
    rate: string;
    years: string;
    freq: string;
  }

  const root = $('[data-tool="compound-interest"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  // Amounts are in the locale's currency, so each locale remembers its own inputs.
  const KEY = locale === 'zh-TW' ? 'compound-interest' : `compound-interest:${locale}`;
  const principal = $<HTMLInputElement>('#ci-principal', root);
  const monthly = $<HTMLInputElement>('#ci-monthly', root);
  const rate = $<HTMLInputElement>('#ci-rate', root);
  const years = $<HTMLInputElement>('#ci-years', root);
  const freq = $<HTMLSelectElement>('#ci-freq', root);
  const error = $('#ci-error', root);
  const results = $('#ci-results', root);
  const table = $('#ci-table', root);

  const yuan = (n: number) => t(s.money, { n: formatInteger(n, locale) });
  const optional = (input: HTMLInputElement) => (input.value.trim() === '' ? 0 : parseNumber(input.value));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  function render() {
    savePref(KEY, {
      principal: principal.value,
      monthly: monthly.value,
      rate: rate.value,
      years: years.value,
      freq: freq.value,
    } satisfies Prefs);

    const ratePct = parseNumber(rate.value);
    const frequency = Number(freq.value) as Frequency;
    const r = calculateCompound({
      principal: optional(principal),
      monthly: optional(monthly),
      ratePct,
      years: parseNumber(years.value),
      frequency,
    });

    if (!r) {
      error.textContent = s.error;
      error.hidden = false;
      results.hidden = true;
      return;
    }
    error.hidden = true;
    results.hidden = false;

    set('#ci-final', yuan(r.finalValue));
    set('#ci-final-label', plural(locale, r.rows.length, s.finalLabel, { freq: s.freqInline[frequency] }));
    set('#ci-contributed', yuan(r.totalContributed));
    set('#ci-interest', yuan(r.totalInterest));
    set('#ci-effective', `${formatNumber(r.effectiveRatePct, 3, locale)}%`);
    const doubling = ruleOf72(ratePct);
    set('#ci-double', Number.isFinite(doubling) ? plural(locale, Math.round(doubling * 10) / 10, s.doubling) : '—');

    const principalShare = r.finalValue > 0 ? (r.totalContributed / r.finalValue) * 100 : 100;
    $('#ci-bar-principal', root).style.width = `${principalShare}%`;
    $('#ci-bar-interest', root).style.width = `${100 - principalShare}%`;
    set('#ci-pct-principal', `${formatNumber(principalShare, 1, locale)}%`);
    set('#ci-pct-interest', `${formatNumber(100 - principalShare, 1, locale)}%`);

    table.replaceChildren(
      ...r.rows.map((row) => {
        const tr = document.createElement('tr');
        [t(s.year, { n: row.year }), yuan(row.contributed), yuan(row.interest), yuan(row.totalInterest), yuan(row.balance)].forEach(
          (text, i) => {
            const td = document.createElement('td');
            td.textContent = text;
            if (i > 0) td.className = 'num';
            tr.append(td);
          },
        );
        return tr;
      }),
    );
  }

  const prefs = loadPref<Partial<Prefs>>(KEY, {});
  if (prefs.principal !== undefined) principal.value = prefs.principal;
  if (prefs.monthly !== undefined) monthly.value = prefs.monthly;
  if (prefs.rate !== undefined) rate.value = prefs.rate;
  if (prefs.years !== undefined) years.value = prefs.years;
  if (prefs.freq && freq.querySelector(`option[value="${prefs.freq}"]`)) freq.value = prefs.freq;

  root.addEventListener('input', render);
  freq.addEventListener('change', render);
  render();
</script>

<style>
  #ci-results {
    display: grid;
    gap: 16px;
  }
  #ci-results[hidden] {
    display: none;
  }
  .ci-bar {
    display: flex;
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .ci-bar-principal {
    background: var(--accent);
    transition: width 0.2s;
  }
  .ci-bar-interest {
    background: var(--success);
    transition: width 0.2s;
  }
  .ci-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: -6px;
    font-size: 14px;
    color: var(--text-2);
  }
  .ci-legend b {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .ci-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 50%;
    vertical-align: baseline;
  }
  .ci-dot-principal {
    background: var(--accent);
  }
  .ci-dot-interest {
    background: var(--success);
  }
</style>
