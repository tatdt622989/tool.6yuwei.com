---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="exchange-rate" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="fx-amount">{s.amountLabel}</label>
    <input id="fx-amount" type="text" inputmode="decimal" autocomplete="off" value="1000" class="fx-amount" />
  </div>

  <div class="fx-pair">
    <div class="field">
      <label for="fx-from">{s.fromLabel}</label>
      <select id="fx-from">
        {s.currencies.map((c) => <option value={c.code} selected={c.code === s.defaultFrom}>{c.code} {c.name}</option>)}
      </select>
    </div>
    <button type="button" class="btn ghost fx-swap" id="fx-swap" aria-label={s.swapAria}>⇄</button>
    <div class="field">
      <label for="fx-to">{s.toLabel}</label>
      <select id="fx-to">
        {s.currencies.map((c) => <option value={c.code} selected={c.code === s.defaultTo}>{c.code} {c.name}</option>)}
      </select>
    </div>
  </div>

  <p class="notice" id="fx-status">{s.loading}</p>

  <div id="fx-output" hidden>
    <div class="result" aria-live="polite">
      <div class="result-value" id="fx-result">—</div>
      <div class="result-label" id="fx-rate">—</div>
    </div>
    <div class="row between fx-meta">
      <span class="hint" id="fx-updated"></span>
      <button type="button" class="btn small ghost" data-copy="#fx-result">{s.copyResult}</button>
    </div>

    <div class="field">
      <span class="label" id="fx-quick-title">{s.quickTitle}</span>
      <div class="table-wrap">
        <table class="table" aria-labelledby="fx-quick-title">
          <thead><tr><th class="num" id="fx-quick-from">—</th><th class="num" id="fx-quick-to">—</th></tr></thead>
          <tbody id="fx-quick"></tbody>
        </table>
      </div>
    </div>

    <div class="field">
      <span class="label" id="fx-common-title">{s.commonTitle}</span>
      <div class="table-wrap">
        <table class="table" aria-labelledby="fx-common-title">
          <thead><tr><th>{s.commonHead[0]}</th><th class="num">{s.commonHead[1]}</th><th class="num">{s.commonHead[2]}</th></tr></thead>
          <tbody id="fx-common"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">
    {s.hintBefore}<a href="https://www.exchangerate-api.com" target="_blank" rel="noopener">Rates By Exchange Rate API</a>{s.hintAfter}
  </p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import type { Strings } from './i18n';
  import {
    convert,
    decimalsFor,
    isFresh,
    parseRateResponse,
    quickAmounts,
    RATE_API_URL,
    unitRate,
    type CachedRates,
  } from './logic';

  const CACHE_KEY = 'exchange-rate:cache';

  const root = $('[data-tool="exchange-rate"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const KEY = s.prefKey;
  const HOME = s.home;
  const currencyName = (code: string) => s.names[code] ?? code;
  const amount = $<HTMLInputElement>('#fx-amount', root);
  const from = $<HTMLSelectElement>('#fx-from', root);
  const to = $<HTMLSelectElement>('#fx-to', root);
  const status = $('#fx-status', root);
  const output = $('#fx-output', root);

  const prefs = loadPref<Partial<{ amount: string; from: string; to: string }>>(KEY, {});
  if (prefs.amount !== undefined) amount.value = prefs.amount;
  if (prefs.from && from.querySelector(`option[value="${prefs.from}"]`)) from.value = prefs.from;
  if (prefs.to && to.querySelector(`option[value="${prefs.to}"]`)) to.value = prefs.to;

  let cache: CachedRates | null = loadPref<CachedRates | null>(CACHE_KEY, null);
  if (cache && !parseRateResponse({ result: 'success', base_code: 'TWD', rates: cache.data?.rates })) cache = null;

  const fmt = (v: number) => formatNumber(v, decimalsFor(v), locale);
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const timeText = (unix: number) =>
    unix > 0
      ? new Date(unix * 1000).toLocaleString(LOCALE_INFO[locale].intl, {
          ...(s.timeZone ? { timeZone: s.timeZone } : {}),
          year: 'numeric',
          month: 'numeric',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          ...(s.timeZoneName ? { timeZoneName: 'short' as const } : {}),
        })
      : s.unknown;

  function showStatus(text: string, kind: '' | 'error' | 'ok' = '') {
    status.textContent = text;
    status.className = `notice${kind ? ` ${kind}` : ''}`;
    status.hidden = text === '';
  }

  function cell(text: string, num = true) {
    const td = document.createElement('td');
    td.textContent = text;
    if (num) td.className = 'num';
    return td;
  }

  function render() {
    savePref(KEY, { amount: amount.value, from: from.value, to: to.value });
    if (!cache) return;
    const rates = cache.data.rates;
    output.hidden = false;
    const a = amount.value.trim() === '' ? 1 : parseNumber(amount.value);
    const f = from.value;
    const to_ = to.value;

    if (!rates[f] || !rates[to_]) {
      set('#fx-result', '—');
      set('#fx-rate', s.noRate);
      return;
    }
    const value = convert(a, f, to_, rates);
    set('#fx-result', Number.isFinite(value) ? `${fmt(value)} ${to_}` : s.enterNumber);
    set(
      '#fx-rate',
      t(s.rateLine, {
        a: formatNumber(a, 4, locale),
        fromName: currencyName(f),
        value: Number.isFinite(value) ? fmt(value) : '—',
        toName: currencyName(to_),
        from: f,
        to: to_,
        r1: fmt(unitRate(f, to_, rates)),
        r2: fmt(unitRate(to_, f, rates)),
      }),
    );
    set('#fx-updated', t(s.updated, { time: timeText(cache.data.updatedUnix) }));

    set('#fx-quick-from', t(s.quickHead, { name: currencyName(f), code: f }));
    set('#fx-quick-to', t(s.quickHead, { name: currencyName(to_), code: to_ }));
    $('#fx-quick', root).replaceChildren(
      ...quickAmounts(f).map((n) => {
        const tr = document.createElement('tr');
        const v = convert(n, f, to_, rates);
        tr.append(cell(formatNumber(n, 0, locale)), cell(fmt(v)));
        return tr;
      }),
    );

    $('#fx-common', root).replaceChildren(
      ...s.common.filter((c) => rates[c] && rates[HOME]).map((c) => {
        const tr = document.createElement('tr');
        tr.append(
          cell(t(s.commonCell, { name: currencyName(c), code: c }), false),
          cell(fmt(unitRate(c, HOME, rates))),
          cell(`${fmt(unitRate(HOME, c, rates))} ${c}`),
        );
        return tr;
      }),
    );
  }

  async function load() {
    const now = Date.now();
    if (cache && isFresh(cache, now)) {
      showStatus('');
      render();
      return;
    }
    if (cache) render();
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 8000);
    try {
      const res = await fetch(RATE_API_URL, { signal: controller.signal });
      const data = parseRateResponse(await res.json());
      if (!data) throw new Error('bad data');
      cache = { fetchedAt: Date.now(), data };
      savePref(CACHE_KEY, cache);
      showStatus('');
      render();
    } catch {
      if (cache) {
        showStatus(t(s.cached, { time: timeText(cache.data.updatedUnix) }));
        render();
      } else {
        output.hidden = true;
        showStatus(s.offline, 'error');
      }
    } finally {
      window.clearTimeout(timer);
    }
  }

  $('#fx-swap', root).addEventListener('click', () => {
    const f = from.value;
    from.value = to.value;
    to.value = f;
    render();
  });
  amount.addEventListener('input', render);
  from.addEventListener('change', render);
  to.addEventListener('change', render);
  window.addEventListener('online', () => {
    if (!cache || !isFresh(cache, Date.now())) void load();
  });
  void load();
</script>

<style>
  #fx-output {
    display: grid;
    gap: 16px;
  }
  #fx-output[hidden] {
    display: none;
  }
  .fx-amount {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .fx-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 10px;
  }
  .fx-swap {
    min-width: 44px;
    font-size: 18px;
  }
  .fx-meta {
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 420px) {
    .fx-pair {
      grid-template-columns: 1fr;
    }
    .fx-swap {
      justify-self: center;
    }
  }
</style>
