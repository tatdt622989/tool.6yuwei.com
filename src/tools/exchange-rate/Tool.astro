---
import { CURRENCIES } from './logic';
---

<div class="tool" data-tool="exchange-rate">
  <div class="field">
    <label for="fx-amount">金額</label>
    <input id="fx-amount" type="text" inputmode="decimal" autocomplete="off" value="1000" class="fx-amount" />
  </div>

  <div class="fx-pair">
    <div class="field">
      <label for="fx-from">從</label>
      <select id="fx-from">
        {CURRENCIES.map((c) => <option value={c.code} selected={c.code === 'USD'}>{c.code} {c.name}</option>)}
      </select>
    </div>
    <button type="button" class="btn ghost fx-swap" id="fx-swap" aria-label="交換幣別">⇄</button>
    <div class="field">
      <label for="fx-to">換成</label>
      <select id="fx-to">
        {CURRENCIES.map((c) => <option value={c.code} selected={c.code === 'TWD'}>{c.code} {c.name}</option>)}
      </select>
    </div>
  </div>

  <p class="notice" id="fx-status">正在取得最新匯率…</p>

  <div id="fx-output" hidden>
    <div class="result" aria-live="polite">
      <div class="result-value" id="fx-result">—</div>
      <div class="result-label" id="fx-rate">—</div>
    </div>
    <div class="row between fx-meta">
      <span class="hint" id="fx-updated"></span>
      <button type="button" class="btn small ghost" data-copy="#fx-result">複製結果</button>
    </div>

    <div class="field">
      <span class="label" id="fx-quick-title">快速對照</span>
      <div class="table-wrap">
        <table class="table" aria-labelledby="fx-quick-title">
          <thead><tr><th class="num" id="fx-quick-from">—</th><th class="num" id="fx-quick-to">—</th></tr></thead>
          <tbody id="fx-quick"></tbody>
        </table>
      </div>
    </div>

    <div class="field">
      <span class="label" id="fx-common-title">常用貨幣兌新台幣（中價參考）</span>
      <div class="table-wrap">
        <table class="table" aria-labelledby="fx-common-title">
          <thead><tr><th>幣別</th><th class="num">1 單位 = 新台幣</th><th class="num">1 新台幣 =</th></tr></thead>
          <tbody id="fx-common"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">
    匯率為國際市場中價參考匯率，每日更新，資料來源：<a href="https://www.exchangerate-api.com" target="_blank" rel="noopener">Rates By Exchange Rate API</a>。銀行實際買賣的即期與現金匯率會加上價差，換匯前請以銀行牌告為準。輸入的金額只在你的瀏覽器內計算。
  </p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import {
    convert,
    currencyName,
    decimalsFor,
    isFresh,
    parseRateResponse,
    quickAmounts,
    RATE_API_URL,
    unitRate,
    type CachedRates,
  } from './logic';

  const KEY = 'exchange-rate';
  const CACHE_KEY = 'exchange-rate:cache';
  const COMMON = ['USD', 'JPY', 'EUR', 'CNY', 'HKD', 'KRW', 'GBP', 'AUD', 'SGD', 'THB', 'VND', 'MYR', 'PHP', 'CAD'];

  const root = $('[data-tool="exchange-rate"]');
  const amount = $<HTMLInputElement>('#fx-amount', root);
  const from = $<HTMLSelectElement>('#fx-from', root);
  const to = $<HTMLSelectElement>('#fx-to', root);
  const status = $('#fx-status', root);
  const output = $('#fx-output', root);

  const prefs = loadPref<Partial<{ amount: string; from: string; to: string }>>(KEY, {});
  if (prefs.amount !== undefined) amount.value = prefs.amount;
  if (prefs.from && from.querySelector(`option[value="${prefs.from}"]`)) from.value = prefs.from;
  if (prefs.to && to.querySelector(`option[value="${prefs.to}"]`)) to.value = prefs.to;

  let cache: CachedRates | null = loadPref<CachedRates | null>(CACHE_KEY, null);
  if (cache && !parseRateResponse({ result: 'success', base_code: 'TWD', rates: cache.data?.rates })) cache = null;

  const fmt = (v: number) => formatNumber(v, decimalsFor(v));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const timeText = (unix: number) =>
    unix > 0
      ? new Date(unix * 1000).toLocaleString('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' })
      : '未知';

  function showStatus(text: string, kind: '' | 'error' | 'ok' = '') {
    status.textContent = text;
    status.className = `notice${kind ? ` ${kind}` : ''}`;
    status.hidden = text === '';
  }

  function cell(text: string, num = true) {
    const td = document.createElement('td');
    td.textContent = text;
    if (num) td.className = 'num';
    return td;
  }

  function render() {
    savePref(KEY, { amount: amount.value, from: from.value, to: to.value });
    if (!cache) return;
    const rates = cache.data.rates;
    output.hidden = false;
    const a = amount.value.trim() === '' ? 1 : parseNumber(amount.value);
    const f = from.value;
    const t = to.value;

    if (!rates[f] || !rates[t]) {
      set('#fx-result', '—');
      set('#fx-rate', '暫無此幣別的匯率資料。');
      return;
    }
    const value = convert(a, f, t, rates);
    set('#fx-result', Number.isFinite(value) ? `${fmt(value)} ${t}` : '請輸入數字');
    set('#fx-rate', `${formatNumber(a, 4)} ${currencyName(f)} ＝ ${Number.isFinite(value) ? fmt(value) : '—'} ${currencyName(t)}｜1 ${f} = ${fmt(unitRate(f, t, rates))} ${t}，1 ${t} = ${fmt(unitRate(t, f, rates))} ${f}`);
    set('#fx-updated', `匯率更新時間：${timeText(cache.data.updatedUnix)}（台灣時間）`);

    set('#fx-quick-from', `${currencyName(f)}（${f}）`);
    set('#fx-quick-to', `${currencyName(t)}（${t}）`);
    $('#fx-quick', root).replaceChildren(
      ...quickAmounts(f).map((n) => {
        const tr = document.createElement('tr');
        const v = convert(n, f, t, rates);
        tr.append(cell(formatNumber(n, 0)), cell(fmt(v)));
        return tr;
      }),
    );

    $('#fx-common', root).replaceChildren(
      ...COMMON.filter((c) => rates[c]).map((c) => {
        const tr = document.createElement('tr');
        tr.append(cell(`${currencyName(c)} ${c}`, false), cell(fmt(unitRate(c, 'TWD', rates))), cell(`${fmt(rates[c])} ${c}`));
        return tr;
      }),
    );
  }

  async function load() {
    const now = Date.now();
    if (cache && isFresh(cache, now)) {
      showStatus('');
      render();
      return;
    }
    if (cache) render();
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 8000);
    try {
      const res = await fetch(RATE_API_URL, { signal: controller.signal });
      const data = parseRateResponse(await res.json());
      if (!data) throw new Error('bad data');
      cache = { fetchedAt: Date.now(), data };
      savePref(CACHE_KEY, cache);
      showStatus('');
      render();
    } catch {
      if (cache) {
        showStatus(`目前無法連線取得最新匯率，以下使用 ${timeText(cache.data.updatedUnix)} 的快取資料。`);
        render();
      } else {
        output.hidden = true;
        showStatus('目前無法取得匯率資料，可能是網路離線。請確認連線後重新整理頁面。', 'error');
      }
    } finally {
      window.clearTimeout(timer);
    }
  }

  $('#fx-swap', root).addEventListener('click', () => {
    const f = from.value;
    from.value = to.value;
    to.value = f;
    render();
  });
  amount.addEventListener('input', render);
  from.addEventListener('change', render);
  to.addEventListener('change', render);
  window.addEventListener('online', () => {
    if (!cache || !isFresh(cache, Date.now())) void load();
  });
  void load();
</script>

<style>
  #fx-output {
    display: grid;
    gap: 16px;
  }
  #fx-output[hidden] {
    display: none;
  }
  .fx-amount {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .fx-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 10px;
  }
  .fx-swap {
    min-width: 44px;
    font-size: 18px;
  }
  .fx-meta {
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 420px) {
    .fx-pair {
      grid-template-columns: 1fr;
    }
    .fx-swap {
      justify-self: center;
    }
  }
</style>
