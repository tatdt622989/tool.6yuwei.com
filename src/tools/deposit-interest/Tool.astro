---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const d = s.client.defaults;
const us = s.client.variant === 'us';
---

<div class="tool" data-tool="deposit-interest" {...i18nAttrs(locale, s.client)}>
  {
    s.modes && (
      <div class="field">
        <span class="label">{s.modes.legend}</span>
        <div class="seg" role="radiogroup" aria-label={s.modes.legend}>
          {s.modes.options.map((o) => (
            <label><input type="radio" name="di-mode" value={o.value} checked={o.value === d.mode} /><span>{o.label}</span></label>
          ))}
        </div>
      </div>
    )
  }

  {
    s.initialLabel && (
      <div class="field" id="di-initial-field" hidden={d.mode !== 'recurring'}>
        <label for="di-initial">{s.initialLabel}</label>
        <input id="di-initial" type="text" inputmode="decimal" autocomplete="off" value={d.initial} />
      </div>
    )
  }

  <div class="grid-3">
    <div class="field">
      <label for="di-amount" id="di-amount-label">{s.amountLabel}</label>
      <input id="di-amount" type="text" inputmode={s.client.digits === 2 ? 'decimal' : 'numeric'} autocomplete="off" value={d.amount} />
    </div>
    <div class="field">
      <label for="di-rate" id={us ? 'di-rate-label' : undefined}>{s.rateLabel}</label>
      <input id="di-rate" type="text" inputmode="decimal" autocomplete="off" value={d.rate} />
      <span class="hint">{s.rateHint}</span>
    </div>
    <div class="field">
      <label for="di-months">{s.monthsLabel}</label>
      <input id="di-months" type="text" inputmode="numeric" autocomplete="off" value={d.months} />
      <span class="hint">{s.monthsHint}</span>
    </div>
  </div>

  <div class="field" id="di-compound-field">
    <span class="label">{s.compLegend}</span>
    <div class="seg" role="radiogroup" aria-label={s.compLegend}>
      {
        s.compOptions.map((o) => (
          <label><input type="radio" name="di-comp" value={o.value} checked={o.value === d.comp} /><span>{o.label}</span></label>
        ))
      }
    </div>
    {
      s.frequency && (
        <div class="di-freq" id="di-freq-field">
          <label for="di-freq">{s.frequency.label}</label>
          <select id="di-freq">
            {s.frequency.options.map((o) => (
              <option value={String(o.value)} selected={String(o.value) === d.freq}>
                {o.label}
              </option>
            ))}
          </select>
        </div>
      )
    }
  </div>

  <div class="notice error" id="di-error" hidden></div>

  <div id="di-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="di-interest">—</div>
      <div class="result-label" id="di-interest-label">{s.mainLabel}</div>
    </div>

    <div class="stats">
      {s.stats.map((st) => <div class="stat"><span class="stat-value" id={st.id}>—</span><span class="stat-label" id={st.labelId}>{st.label}</span></div>)}
    </div>

    <p class="notice" id="di-note"></p>

    {
      s.table && (
        <div class="field">
          <span class="label">{s.table.label}</span>
          <div class="table-wrap di-table">
            <table class="table">
              <thead><tr><th>{s.table.head[0]}</th><th class="num">{s.table.head[1]}</th><th class="num">{s.table.head[2]}</th><th class="num">{s.table.head[3]}</th></tr></thead>
              <tbody id="di-table"></tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>

  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import {
    calculateDeposit,
    calculateJpTimeDeposit,
    DEPOSIT_TAX_2026,
    depositProblem,
    effectiveApyPct,
    monthlyRate,
    type DepositInput,
    type DepositMode,
    type DepositResult,
    type JpDepositType,
  } from './logic';
  import type { Strings, Variant } from './i18n';

  const root = $('[data-tool="deposit-interest"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const variant: Variant = s.variant ?? 'tw';
  const KEY = s.prefKey;
  const modes = $$<HTMLInputElement>('input[name="di-mode"]', root);
  const comps = $$<HTMLInputElement>('input[name="di-comp"]', root);
  const amount = $<HTMLInputElement>('#di-amount', root);
  const rate = $<HTMLInputElement>('#di-rate', root);
  const months = $<HTMLInputElement>('#di-months', root);
  const initial = root.querySelector<HTMLInputElement>('#di-initial');
  const freq = root.querySelector<HTMLSelectElement>('#di-freq');
  const error = $('#di-error', root);
  const output = $('#di-output', root);
  const table = root.querySelector<HTMLElement>('#di-table');

  interface Prefs {
    mode: string;
    comp: string;
    amount: string;
    rate: string;
    months: string;
    freq?: string;
    initial?: string;
  }
  const prefs = loadPref<Partial<Prefs>>(KEY, {});
  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.comp && comps.some((c) => c.value === prefs.comp)) for (const c of comps) c.checked = c.value === prefs.comp;
  if (prefs.amount !== undefined) amount.value = prefs.amount;
  if (prefs.rate !== undefined) rate.value = prefs.rate;
  if (prefs.months !== undefined) months.value = prefs.months;
  if (freq && prefs.freq && freq.querySelector(`option[value="${prefs.freq}"]`)) freq.value = prefs.freq;
  if (initial && prefs.initial !== undefined) initial.value = prefs.initial;

  const money = (n: number) =>
    t(s.money, { n: s.digits === 2 ? formatFixed(n, 2, locale) : formatInteger(n, locale) });
  const num = (n: number, digits = 0) => (s.digits === 2 ? formatFixed(n, 2, locale) : formatNumber(n, digits, locale));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function fillTable(r: DepositResult) {
    if (!table) return;
    table.replaceChildren(
      ...r.rows.map((row) => {
        const tr = document.createElement('tr');
        [t(s.month ?? '{n}', { n: row.month }), num(row.deposited), num(row.interest, 0), num(row.balance)].forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i > 0) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );
  }

  function renderTw(mode: DepositMode, comp: string) {
    const tw = s.tw!;
    $('#di-compound-field', root).hidden = mode === 'income';
    set('#di-amount-label', mode === 'recurring' ? tw.amountRecurring : tw.amountLump);

    const input: DepositInput = {
      mode,
      amount: parseNumber(amount.value),
      ratePct: parseNumber(rate.value),
      months: parseNumber(months.value),
      compound: mode !== 'income' && comp === '1',
    };
    const problem = depositProblem(input);
    const r = problem ? null : calculateDeposit(input);
    if (!r) return fail(problem ? s.errors[problem] : tw.fallback);
    error.hidden = true;
    output.hidden = false;

    set('#di-interest', money(r.totalInterest));
    set(
      '#di-interest-label',
      t(tw.mainLabel, {
        mode: tw.modeLabels[mode],
        comp: mode === 'income' ? '' : input.compound ? tw.compSuffix.compound : tw.compSuffix.simple,
        months: input.months,
      }),
    );
    set('#di-maturity', money(r.maturity));
    set('#di-single', money(r.singlePayment));
    set('#di-single-label', mode === 'income' ? t(tw.singleIncome, { n: r.payments }) : tw.singleLump);
    set('#di-nhi', money(r.supplementary));
    set('#di-net', money(r.totalInterest - r.supplementary));

    const tax = DEPOSIT_TAX_2026;
    const threshold = formatInteger(tax.supplementaryThreshold, locale);
    const notes: string[] = [];
    if (r.supplementary > 0) {
      notes.push(
        t(tw.nhiCharged, {
          single: money(r.singlePayment),
          threshold,
          pct: String(tax.supplementaryRatePct),
          premium: money(r.supplementary),
        }),
      );
    } else {
      notes.push(t(tw.nhiFree, { threshold }));
    }
    if (r.withholding > 0) notes.push(t(tw.withholding, { pct: String(tax.withholdingRatePct), amount: money(r.withholding) }));
    notes.push(
      t(tw.deduction, {
        annual: money(r.annualInterest),
        deduction: formatInteger(tax.savingsDeduction, locale),
        over: r.annualInterest > tax.savingsDeduction ? tw.over : '',
      }),
    );
    set('#di-note', notes.join(' '));
    fillTable(r);
  }

  function renderUs(mode: DepositMode, comp: string) {
    const us = s.us!;
    const apy = comp !== 'apr';
    const freqField = root.querySelector<HTMLElement>('#di-freq-field');
    if (freqField) freqField.hidden = apy;
    const initialField = root.querySelector<HTMLElement>('#di-initial-field');
    if (initialField) initialField.hidden = mode !== 'recurring';
    set('#di-amount-label', mode === 'recurring' ? us.amountRecurring : us.amountLump);
    set('#di-rate-label', apy ? us.rateApy : us.rateApr);

    const input: DepositInput = {
      mode,
      amount: parseNumber(amount.value),
      ratePct: parseNumber(rate.value),
      months: parseNumber(months.value),
      compound: true,
      rateKind: apy ? 'apy' : 'apr',
      periodsPerYear: Number(freq?.value ?? 12) || 12,
      ...(mode === 'recurring' && initial ? { initial: initial.value.trim() === '' ? 0 : parseNumber(initial.value) } : {}),
    };
    const problem = depositProblem(input);
    const r = problem ? null : calculateDeposit(input);
    if (!r) return fail(problem ? s.errors[problem] : s.errors.incomplete);
    error.hidden = true;
    output.hidden = false;

    const i = monthlyRate(input.ratePct, input.rateKind, input.periodsPerYear);
    set('#di-interest', money(r.totalInterest));
    set('#di-interest-label', plural(locale, input.months, us.mainLabel));
    set('#di-maturity', money(r.maturity));
    set('#di-deposited', money(r.totalDeposited));
    set('#di-apy', `${formatNumber(apy ? i * 12 * 100 : effectiveApyPct(i), 3, locale)}%`);
    set('#di-apy-label', apy ? us.aprLabel : us.apyLabel);
    set(
      '#di-note',
      [t(us.note, { interest: money(r.totalInterest), deposits: money(r.totalDeposited) }), mode === 'lump' ? us.noteCd : us.noteSavings].join(' '),
    );
    fillTable(r);
  }

  function renderJp(comp: string) {
    const jp = s.jp!;
    const type: JpDepositType = comp === 'semiannual' ? 'semiannual' : 'simple';
    const input = {
      principal: parseNumber(amount.value),
      ratePct: parseNumber(rate.value),
      months: parseNumber(months.value),
      type,
    };
    const problem = depositProblem({ amount: input.principal, ratePct: input.ratePct, months: input.months });
    const r = problem ? null : calculateJpTimeDeposit(input);
    if (!r) return fail(problem ? s.errors[problem] : s.errors.incomplete);
    error.hidden = true;
    output.hidden = false;

    set('#di-interest', money(r.net));
    set('#di-interest-label', t(jp.mainLabel, { type: jp.typeLabels[type], months: input.months }));
    set('#di-gross', money(r.gross));
    set('#di-tax-national', money(r.tax.national));
    set('#di-tax-local', money(r.tax.local));
    set('#di-maturity', money(r.maturity));
    const note = t(jp.note, {
      gross: money(r.gross),
      national: money(r.tax.national),
      local: money(r.tax.local),
      tax: money(r.tax.total),
      yield: formatNumber(r.netYieldPct, 4, locale),
    });
    set('#di-note', type === 'semiannual' ? `${note}${jp.noteSemiannual}` : note);
  }

  function render() {
    const mode = (modes.find((m) => m.checked)?.value ?? 'lump') as DepositMode;
    const comp = comps.find((c) => c.checked)?.value ?? s.defaults.comp;
    savePref(KEY, {
      mode,
      comp,
      amount: amount.value,
      rate: rate.value,
      months: months.value,
      ...(freq ? { freq: freq.value } : {}),
      ...(initial ? { initial: initial.value } : {}),
    });
    if (variant === 'us') renderUs(mode, comp);
    else if (variant === 'jp') renderJp(comp);
    else renderTw(mode, comp);
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #di-output {
    display: grid;
    gap: 16px;
  }
  #di-output[hidden],
  .field[hidden],
  .di-freq[hidden] {
    display: none;
  }
  .di-freq {
    display: grid;
    gap: 6px;
    max-width: 240px;
    margin-top: 10px;
  }
  .di-table {
    max-height: 360px;
    overflow-y: auto;
  }
</style>
