<div class="tool" data-tool="webcam-test">
  <div class="row">
    <button class="btn primary" type="button" id="wc-start">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2"></rect><path d="M16 10l5-3v10l-5-3z"></path></svg>
      <span id="wc-start-label">開啟鏡頭</span>
    </button>
    <button class="btn" type="button" id="wc-snap" disabled>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
      拍照
    </button>
    <button class="btn ghost" type="button" id="wc-full" hidden>全螢幕</button>
    <button class="btn ghost" type="button" id="wc-stop" hidden>關閉鏡頭</button>
  </div>

  <div class="notice error wc-error" id="wc-error" role="alert" hidden>
    <strong id="wc-err-title"></strong>
    <span id="wc-err-detail"></span>
    <ol id="wc-err-help" hidden></ol>
  </div>
  <p class="notice" id="wc-note" hidden></p>

  <div class="wc-stage" id="wc-stage">
    <video id="wc-video" autoplay muted playsinline aria-label="鏡頭即時畫面"></video>
    <div class="wc-placeholder" id="wc-placeholder">
      <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2"></rect><path d="M16 10l5-3v10l-5-3z"></path></svg>
      <span id="wc-placeholder-text">按「開啟鏡頭」並允許瀏覽器使用相機</span>
    </div>
    <span class="wc-live" id="wc-live" hidden><span class="wc-dot" aria-hidden="true"></span>LIVE</span>
  </div>

  <div class="grid-3">
    <div class="field" id="wc-device-field" hidden>
      <label for="wc-device">鏡頭</label>
      <select id="wc-device"></select>
    </div>
    <div class="field">
      <span class="label">要求解析度</span>
      <div class="seg" role="radiogroup" aria-label="要求解析度">
        <label><input type="radio" name="wc-preset" value="480p" /><span>480p</span></label>
        <label><input type="radio" name="wc-preset" value="720p" /><span>720p</span></label>
        <label><input type="radio" name="wc-preset" value="1080p" checked /><span>1080p</span></label>
        <label><input type="radio" name="wc-preset" value="4k" /><span>4K</span></label>
      </div>
    </div>
    <div class="field">
      <span class="label">畫面</span>
      <label class="check"><input type="checkbox" id="wc-mirror" checked /> 鏡像顯示（像照鏡子）</label>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="wc-res">—</span><span class="stat-label">實際解析度</span></div>
    <div class="stat"><span class="stat-value" id="wc-grade">—</span><span class="stat-label">畫質等級</span></div>
    <div class="stat"><span class="stat-value" id="wc-ratio">—</span><span class="stat-label">長寬比</span></div>
    <div class="stat"><span class="stat-value" id="wc-fps-set">—</span><span class="stat-label">設定幀率（fps）</span></div>
    <div class="stat"><span class="stat-value" id="wc-fps">—</span><span class="stat-label">實測幀率（fps）</span></div>
    <div class="stat"><span class="stat-value" id="wc-max">—</span><span class="stat-label">鏡頭最高支援</span></div>
  </div>

  <div class="wc-shot" id="wc-shot" hidden>
    <img id="wc-shot-img" alt="鏡頭快照" />
    <div class="wc-shot-side">
      <strong>快照</strong>
      <span class="hint" id="wc-shot-info"></span>
      <div class="row">
        <button class="btn primary small" type="button" id="wc-download">下載 PNG</button>
        <button class="btn ghost small" type="button" id="wc-discard">刪除</button>
      </div>
    </div>
  </div>

  <p class="hint">畫面只在你的瀏覽器中顯示與處理，不會錄影或上傳；按「關閉鏡頭」、切換分頁或離開頁面時，鏡頭會自動關閉。</p>
</div>

<script>
  import { $, $$, downloadBlob, flashButton, loadPref, savePref } from '../../lib/client';
  import {
    aspectRatio,
    buildVideoConstraints,
    describeMediaError,
    detectEnv,
    deviceLabel,
    fpsFromCounts,
    fpsFromTimestamps,
    isPreset,
    maxResolution,
    megapixels,
    permissionHelp,
    pushTimestamp,
    resolutionLabel,
    snapshotFilename,
    type Preset,
  } from './logic';

  interface Prefs {
    deviceId: string;
    preset: Preset;
    mirror: boolean;
  }

  const root = $('[data-tool="webcam-test"]');
  const startBtn = $<HTMLButtonElement>('#wc-start', root);
  const startLabel = $('#wc-start-label', root);
  const stopBtn = $<HTMLButtonElement>('#wc-stop', root);
  const snapBtn = $<HTMLButtonElement>('#wc-snap', root);
  const fullBtn = $<HTMLButtonElement>('#wc-full', root);
  const errorBox = $('#wc-error', root);
  const errTitle = $('#wc-err-title', root);
  const errDetail = $('#wc-err-detail', root);
  const errHelp = $('#wc-err-help', root);
  const note = $('#wc-note', root);
  const stage = $('#wc-stage', root);
  const video = $<HTMLVideoElement>('#wc-video', root);
  const placeholder = $('#wc-placeholder', root);
  const placeholderText = $('#wc-placeholder-text', root);
  const live = $('#wc-live', root);
  const deviceField = $('#wc-device-field', root);
  const deviceSelect = $<HTMLSelectElement>('#wc-device', root);
  const presetRadios = $$<HTMLInputElement>('input[name="wc-preset"]', root);
  const mirrorBox = $<HTMLInputElement>('#wc-mirror', root);
  const resOut = $('#wc-res', root);
  const gradeOut = $('#wc-grade', root);
  const ratioOut = $('#wc-ratio', root);
  const fpsSetOut = $('#wc-fps-set', root);
  const fpsOut = $('#wc-fps', root);
  const maxOut = $('#wc-max', root);
  const shot = $('#wc-shot', root);
  const shotImg = $<HTMLImageElement>('#wc-shot-img', root);
  const shotInfo = $('#wc-shot-info', root);
  const downloadBtn = $<HTMLButtonElement>('#wc-download', root);

  const saved = loadPref<Partial<Prefs>>('webcam-test', {});
  const prefs: Prefs = {
    deviceId: typeof saved.deviceId === 'string' ? saved.deviceId : '',
    preset: isPreset(saved.preset) ? saved.preset : '1080p',
    mirror: saved.mirror !== false,
  };
  const env = detectEnv(navigator.userAgent, navigator.maxTouchPoints || 0);

  let stream: MediaStream | null = null;
  let starting = false;
  let fpsTimer = 0;
  let frameTimes: number[] = [];
  let shotBlob: Blob | null = null;
  let shotUrl = '';

  // ---------- Prefs ----------
  function applyPrefs() {
    for (const r of presetRadios) r.checked = r.value === prefs.preset;
    mirrorBox.checked = prefs.mirror;
    stage.classList.toggle('is-mirror', prefs.mirror);
  }
  const persist = () => savePref('webcam-test', prefs);

  // ---------- UI helpers ----------
  function showError(name: string) {
    const problem = describeMediaError(name, 'camera');
    errTitle.textContent = problem.title;
    errDetail.textContent = problem.detail;
    errHelp.replaceChildren(
      ...(problem.showPermissionHelp ? permissionHelp(env, 'camera') : []).map((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        return li;
      }),
    );
    errHelp.hidden = !problem.showPermissionHelp;
    errorBox.hidden = false;
  }

  function resetStats() {
    for (const el of [resOut, gradeOut, ratioOut, fpsSetOut, fpsOut, maxOut]) el.textContent = '—';
  }

  function updateStats() {
    const track = stream?.getVideoTracks()[0];
    if (!track) return;
    const s = track.getSettings();
    const w = video.videoWidth || s.width || 0;
    const h = video.videoHeight || s.height || 0;
    if (w && h) {
      resOut.textContent = `${w} × ${h}`;
      gradeOut.textContent = resolutionLabel(w, h);
      ratioOut.textContent = `${aspectRatio(w, h)}（${megapixels(w, h)} MP）`;
      stage.style.aspectRatio = `${w} / ${h}`;
    }
    fpsSetOut.textContent = s.frameRate ? String(Math.round(s.frameRate * 10) / 10) : '—';
    const caps = typeof track.getCapabilities === 'function' ? track.getCapabilities() : null;
    maxOut.textContent = maxResolution(caps) ?? '瀏覽器未提供';
  }

  // ---------- Frame-rate measurement ----------
  type FrameVideo = HTMLVideoElement & {
    requestVideoFrameCallback?: (cb: (now: number) => void) => number;
    cancelVideoFrameCallback?: (handle: number) => void;
  };
  const fv = video as FrameVideo;
  let vfcHandle = 0;

  function onVideoFrame(now: number) {
    pushTimestamp(frameTimes, now);
    if (stream && fv.requestVideoFrameCallback) vfcHandle = fv.requestVideoFrameCallback(onVideoFrame);
  }

  function startFps() {
    stopFps();
    frameTimes = [];
    if (fv.requestVideoFrameCallback) {
      vfcHandle = fv.requestVideoFrameCallback(onVideoFrame);
      fpsTimer = window.setInterval(() => {
        const fps = fpsFromTimestamps(frameTimes, performance.now(), 1000);
        fpsOut.textContent = fps ? fps.toFixed(1) : '—';
      }, 500);
      return;
    }
    let lastCount = video.getVideoPlaybackQuality?.().totalVideoFrames ?? 0;
    let lastTime = performance.now();
    fpsTimer = window.setInterval(() => {
      const count = video.getVideoPlaybackQuality?.().totalVideoFrames;
      if (count === undefined) return;
      const t = performance.now();
      const fps = fpsFromCounts(lastCount, count, t - lastTime);
      lastCount = count;
      lastTime = t;
      fpsOut.textContent = fps ? fps.toFixed(1) : '—';
    }, 1000);
  }

  function stopFps() {
    window.clearInterval(fpsTimer);
    fpsTimer = 0;
    if (vfcHandle && fv.cancelVideoFrameCallback) fv.cancelVideoFrameCallback(vfcHandle);
    vfcHandle = 0;
  }

  // ---------- Devices ----------
  async function refreshDevices() {
    if (!navigator.mediaDevices?.enumerateDevices) return;
    const devices = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === 'videoinput');
    const activeId = stream?.getVideoTracks()[0]?.getSettings().deviceId ?? prefs.deviceId;
    deviceSelect.replaceChildren(
      ...devices.map((d, i) => {
        const opt = document.createElement('option');
        opt.value = d.deviceId;
        opt.textContent = deviceLabel(d.label, i, 'camera');
        return opt;
      }),
    );
    if (devices.some((d) => d.deviceId === activeId)) deviceSelect.value = activeId;
    deviceField.hidden = devices.length === 0 || !devices.some((d) => d.label);
  }

  // ---------- Start / stop ----------
  function releaseStream() {
    stream?.getTracks().forEach((t) => t.stop());
    stream = null;
  }

  function stop(message = '') {
    stopFps();
    releaseStream();
    video.srcObject = null;
    placeholder.hidden = false;
    placeholderText.textContent = '鏡頭已關閉，按「開啟鏡頭」可再次測試';
    live.hidden = true;
    stopBtn.hidden = true;
    fullBtn.hidden = true;
    snapBtn.disabled = true;
    startLabel.textContent = '開啟鏡頭';
    stage.style.aspectRatio = '';
    resetStats();
    note.textContent = message;
    note.hidden = !message;
  }

  async function start(deviceId = prefs.deviceId, exact = false) {
    if (starting) return;
    errorBox.hidden = true;
    note.hidden = true;
    if (!window.isSecureContext) return showError('insecure');
    if (!navigator.mediaDevices?.getUserMedia) return showError('unsupported');
    starting = true;
    startBtn.disabled = true;
    placeholderText.textContent = '正在開啟鏡頭…';
    // Release the current camera first: many webcams cannot be opened twice.
    stopFps();
    releaseStream();
    try {
      const next = await navigator.mediaDevices.getUserMedia({
        video: buildVideoConstraints(prefs.preset, deviceId, exact),
        audio: false,
      });
      stream = next;
      const track = next.getVideoTracks()[0];
      track?.addEventListener('ended', () => {
        if (stream === next) {
          stop();
          showError('NotReadableError');
        }
      });
      const id = track?.getSettings().deviceId;
      if (id) {
        prefs.deviceId = id;
        persist();
      }
      video.srcObject = next;
      await video.play().catch(() => undefined);
      placeholder.hidden = true;
      live.hidden = false;
      stopBtn.hidden = false;
      fullBtn.hidden = !document.fullscreenEnabled;
      snapBtn.disabled = false;
      startLabel.textContent = '重新開啟';
      updateStats();
      startFps();
      await refreshDevices();
    } catch (err) {
      stop();
      placeholderText.textContent = '無法開啟鏡頭';
      showError(err instanceof Error || err instanceof DOMException ? err.name : '');
    } finally {
      starting = false;
      startBtn.disabled = false;
    }
  }

  // ---------- Snapshot ----------
  async function snapshot() {
    const w = video.videoWidth;
    const h = video.videoHeight;
    if (!stream || !w || !h) return;
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const g = canvas.getContext('2d');
    if (!g) return;
    if (prefs.mirror) {
      g.translate(w, 0);
      g.scale(-1, 1);
    }
    g.drawImage(video, 0, 0, w, h);
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
    if (!blob) return;
    shotBlob = blob;
    if (shotUrl) URL.revokeObjectURL(shotUrl);
    shotUrl = URL.createObjectURL(blob);
    shotImg.src = shotUrl;
    shotInfo.textContent = `${w} × ${h}${prefs.mirror ? '，已依鏡像方向儲存' : ''}`;
    shot.hidden = false;
    flashButton(snapBtn, '已拍照', 900);
  }

  // ---------- Events ----------
  applyPrefs();
  startBtn.addEventListener('click', () => void start());
  stopBtn.addEventListener('click', () => stop());
  snapBtn.addEventListener('click', () => void snapshot());
  downloadBtn.addEventListener('click', () => {
    if (shotBlob) downloadBlob(shotBlob, snapshotFilename(new Date()));
  });
  $('#wc-discard', root).addEventListener('click', () => {
    shot.hidden = true;
    shotBlob = null;
    if (shotUrl) URL.revokeObjectURL(shotUrl);
    shotUrl = '';
    shotImg.removeAttribute('src');
  });
  fullBtn.addEventListener('click', () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else void stage.requestFullscreen?.().catch(() => undefined);
  });
  deviceSelect.addEventListener('change', () => {
    prefs.deviceId = deviceSelect.value;
    persist();
    if (stream) void start(deviceSelect.value, true);
  });
  for (const radio of presetRadios) {
    radio.addEventListener('change', () => {
      if (!radio.checked || !isPreset(radio.value)) return;
      prefs.preset = radio.value;
      persist();
      if (stream) void start(prefs.deviceId, true);
    });
  }
  mirrorBox.addEventListener('change', () => {
    prefs.mirror = mirrorBox.checked;
    persist();
    stage.classList.toggle('is-mirror', prefs.mirror);
  });
  video.addEventListener('resize', updateStats);
  video.addEventListener('loadedmetadata', updateStats);
  navigator.mediaDevices?.addEventListener?.('devicechange', () => {
    if (stream) void refreshDevices();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden' && stream) stop('切換分頁時已自動關閉鏡頭，按「開啟鏡頭」可再次測試。');
  });
  window.addEventListener('pagehide', () => {
    if (stream) stop();
  });
</script>

<style>
  .wc-error {
    display: grid;
    gap: 4px;
  }
  .wc-error ol {
    margin: 4px 0 0;
    padding-left: 20px;
    color: var(--text-2);
  }

  .wc-stage {
    position: relative;
    width: 100%;
    max-height: 70vh;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .wc-stage:fullscreen {
    max-height: none;
    border-radius: 0;
    border: 0;
    background: var(--bg);
  }
  .wc-stage video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .wc-stage.is-mirror video {
    transform: scaleX(-1);
  }
  .wc-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
    background: var(--surface-2);
  }
  .wc-live {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text);
    background: color-mix(in oklab, var(--surface) 80%, transparent);
  }
  .wc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--danger);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wc-dot {
      animation: wc-pulse 1.4s ease-in-out infinite;
    }
  }
  @keyframes wc-pulse {
    50% {
      opacity: 0.3;
    }
  }

  .wc-shot {
    display: grid;
    grid-template-columns: minmax(0, 220px) 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .wc-shot img {
    width: 100%;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .wc-shot-side {
    display: grid;
    gap: 6px;
  }
  @media (max-width: 520px) {
    .wc-shot {
      grid-template-columns: 1fr;
    }
  }
</style>
