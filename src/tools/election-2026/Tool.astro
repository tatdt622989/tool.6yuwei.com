---
import { AGE_OPTIONS, BRING, INDIGENOUS_OPTIONS, REFERENDUM, RESIDENCE_OPTIONS, RULES } from './logic';
---

<div class="tool" data-tool="election-2026" data-phase="before">
  <section class="el-hero" aria-live="polite">
    <p class="el-eyebrow" id="el-eyebrow">距離投票開始還有</p>
    <div class="el-count" id="el-count" role="timer">-- 天 --:--:--</div>
    <p class="el-when">2026 年 11 月 28 日（星期六）上午 8 點至下午 4 點</p>
    <div class="stats el-stats">
      <div class="stat"><span class="stat-value" id="el-open">—</span><span class="stat-label">距離 08:00 開始投票</span></div>
      <div class="stat"><span class="stat-value" id="el-close">—</span><span class="stat-label">距離 16:00 投票截止</span></div>
    </div>
    <p class="notice el-closed" id="el-closed" hidden>
      本次投票已結束。2026 年 11 月 28 日的地方選舉與第 22 案公投已於下午 4 點截止，正式結果以中央選舉委員會公告為準。下方的投票須知保留供參考。
    </p>
  </section>

  <section class="el-section" aria-labelledby="el-calc-title">
    <h2 class="el-h2" id="el-calc-title">我可以領幾張票？</h2>
    <div class="grid-2">
      <div class="field">
        <label for="el-residence">戶籍所在地</label>
        <select id="el-residence">
          {RESIDENCE_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
        <span class="hint" id="el-residence-hint">{RESIDENCE_OPTIONS[0].hint}</span>
      </div>
      <div class="field">
        <span class="label" id="el-age-label">年齡（算到 11 月 27 日）</span>
        <div class="seg" role="radiogroup" aria-labelledby="el-age-label">
          {
            AGE_OPTIONS.map((o, i) => (
              <label>
                <input type="radio" name="el-age" value={o.value} checked={i === 0} />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
        <span class="hint" id="el-age-hint">{AGE_OPTIONS[0].hint}</span>
      </div>
      <div class="field">
        <span class="label" id="el-ind-label">原住民身分</span>
        <div class="seg" role="radiogroup" aria-labelledby="el-ind-label">
          {
            INDIGENOUS_OPTIONS.map((o, i) => (
              <label>
                <input type="radio" name="el-ind" value={o.value} checked={i === 0} />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
      </div>
      <div class="field">
        <span class="label">設籍時間</span>
        <label class="check"><input type="checkbox" id="el-resided" checked /> 戶籍在目前的縣市已滿 4 個月</label>
        <span class="hint">2026 年 7 月 28 日（含）以前完成遷入登記</span>
      </div>
    </div>

    <div class="result el-result">
      <span class="result-label">你會領到</span>
      <span class="result-value" id="el-summary">—</span>
    </div>
    <ol class="el-ballots" id="el-ballots"></ol>
    <ul class="el-notes" id="el-notes"></ul>
  </section>

  <section class="el-section" aria-labelledby="el-bring-title">
    <h2 class="el-h2" id="el-bring-title">投票要帶什麼</h2>
    <div class="el-bring">
      {
        BRING.map((b) => (
          <div class="el-bring-item" data-required={b.required ? 'true' : 'false'}>
            <span class="el-bring-name">
              {b.item}
              <span class="el-tag">{b.required ? '必帶' : '可不帶'}</span>
            </span>
            <span class="hint">{b.note}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="el-section" aria-labelledby="el-rules-title">
    <h2 class="el-h2" id="el-rules-title">投票所規定</h2>
    <ul class="el-rules">
      {RULES.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <section class="el-section" aria-labelledby="el-ref-title">
    <h2 class="el-h2" id="el-ref-title">第 {REFERENDUM.number} 案公投主文</h2>
    <blockquote class="el-quote">{REFERENDUM.question}</blockquote>
    <p class="hint">
      主文依中央選舉委員會 115 年 8 月 28 日公告原文。年滿 18 歲即可投票，在選票上圈選「同意」或「不同意」其一。依公民投票法，有效同意票多於不同意票，且有效同意票達投票權人總額四分之一以上，才算通過。本站不提供任何立場建議。
    </p>
  </section>

  <p class="hint el-sources">
    資料來源：
    <a href="https://web.cec.gov.tw/" rel="noopener" target="_blank">中央選舉委員會</a>、
    <a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0020010" rel="noopener" target="_blank">公職人員選舉罷免法</a>、
    <a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0020050" rel="noopener" target="_blank">公民投票法</a>。整理於 2026 年 10 月 29 日，實際以選舉人名冊、投票通知單與各地選委會公告為準。
  </p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import {
    AGE_OPTIONS,
    ballotsFor,
    electionPhase,
    ELECTION,
    formatRemaining,
    RESIDENCE_OPTIONS,
    type AgeGroup,
    type Indigenous,
    type Residence,
    type VoterInput,
  } from './logic';

  const root = $('[data-tool="election-2026"]');
  const eyebrow = $('#el-eyebrow', root);
  const countEl = $('#el-count', root);
  const openEl = $('#el-open', root);
  const closeEl = $('#el-close', root);
  const closedNotice = $('#el-closed', root);
  const residenceSel = $<HTMLSelectElement>('#el-residence', root);
  const residenceHint = $('#el-residence-hint', root);
  const ageHint = $('#el-age-hint', root);
  const residedBox = $<HTMLInputElement>('#el-resided', root);
  const summaryEl = $('#el-summary', root);
  const ballotsEl = $('#el-ballots', root);
  const notesEl = $('#el-notes', root);
  const ageRadios = $$<HTMLInputElement>('input[name="el-age"]', root);
  const indRadios = $$<HTMLInputElement>('input[name="el-ind"]', root);

  const set = (el: HTMLElement, text: string) => {
    if (el.textContent !== text) el.textContent = text;
  };

  /* ---------- Countdown ---------- */
  function tick() {
    const now = Date.now();
    const p = electionPhase(now);
    root.dataset.phase = p.phase;
    closedNotice.hidden = p.phase !== 'closed';
    if (p.phase === 'before') {
      set(eyebrow, p.daysUntil === 0 ? '今天投票，距離開始還有' : '距離投票開始還有');
      set(countEl, formatRemaining(p.remaining));
    } else if (p.phase === 'voting') {
      set(eyebrow, '投票進行中，距離截止還有');
      set(countEl, formatRemaining(p.remaining));
    } else {
      set(eyebrow, '2026 九合一');
      set(countEl, '本次投票已結束');
    }
    set(openEl, now < ELECTION.opens ? formatRemaining(ELECTION.opens - now) : '已開始');
    set(closeEl, now < ELECTION.closes ? formatRemaining(ELECTION.closes - now) : '已截止');
    return p.phase;
  }

  /* ---------- Ballot calculator ---------- */
  const checked = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value ?? radios[0].value;

  function readInput(): VoterInput {
    return {
      residence: residenceSel.value as Residence,
      age: checked(ageRadios) as AgeGroup,
      indigenous: checked(indRadios) as Indigenous,
      residedFourMonths: residedBox.checked,
    };
  }

  function renderBallots() {
    const input = readInput();
    const result = ballotsFor(input);
    residenceHint.textContent = RESIDENCE_OPTIONS.find((o) => o.value === input.residence)?.hint ?? '';
    ageHint.textContent = AGE_OPTIONS.find((o) => o.value === input.age)?.hint ?? '';
    residedBox.disabled = input.age !== '20plus';
    summaryEl.textContent = result.summary;

    ballotsEl.replaceChildren(
      ...result.ballots.map((b) => {
        const li = document.createElement('li');
        li.className = `el-ballot ${b.kind}`;
        const title = document.createElement('span');
        title.className = 'el-ballot-title';
        title.textContent = b.title;
        const tag = document.createElement('span');
        tag.className = 'el-tag';
        tag.textContent = b.kind === 'referendum' ? '公投票' : '選舉票';
        title.append(tag);
        const detail = document.createElement('span');
        detail.className = 'hint';
        detail.textContent = b.detail;
        li.append(title, detail);
        return li;
      }),
    );
    ballotsEl.hidden = result.ballots.length === 0;
    notesEl.replaceChildren(
      ...result.notes.map((n) => {
        const li = document.createElement('li');
        li.textContent = n;
        return li;
      }),
    );
    savePref('election-2026', input);
  }

  const saved = loadPref<Partial<VoterInput>>('election-2026', {});
  if (saved.residence && RESIDENCE_OPTIONS.some((o) => o.value === saved.residence)) residenceSel.value = saved.residence;
  for (const r of ageRadios) r.checked = r.value === (saved.age ?? '20plus');
  for (const r of indRadios) r.checked = r.value === (saved.indigenous ?? 'none');
  residedBox.checked = saved.residedFourMonths !== false;

  root.addEventListener('change', (event) => {
    if ((event.target as Element).closest('.el-section')) renderBallots();
  });

  renderBallots();
  if (tick() !== 'closed') {
    const timer = window.setInterval(() => {
      if (tick() === 'closed') window.clearInterval(timer);
    }, 250);
  }
</script>

<style>
  .el-hero {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 16px 0 4px;
    text-align: center;
  }
  .el-eyebrow {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
  }
  .el-count {
    font-family: var(--mono);
    font-size: clamp(26px, 8.5vw, 72px);
    white-space: nowrap;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  [data-phase='voting'] .el-count {
    color: var(--accent);
  }
  [data-phase='closed'] .el-count {
    font-family: var(--display);
    font-size: clamp(28px, 8vw, 48px);
    color: var(--text-2);
  }
  .el-when {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .el-stats {
    width: 100%;
    max-width: 520px;
    margin-top: 6px;
  }
  .el-stats .stat-value {
    font-size: 16px;
  }
  [data-phase='closed'] .el-stats {
    display: none;
  }
  .el-closed {
    max-width: 640px;
    text-align: left;
  }

  .el-section {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .el-h2 {
    font-size: 18px;
  }
  .el-result {
    display: grid;
    gap: 2px;
  }
  .el-result .result-value {
    font-size: clamp(22px, 6vw, 30px);
  }

  .el-ballots {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: ballot;
  }
  .el-ballots :global(.el-ballot) {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 10px 12px 10px 44px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    counter-increment: ballot;
  }
  .el-ballots :global(.el-ballot)::before {
    content: counter(ballot);
    position: absolute;
    left: 12px;
    top: 11px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-2);
  }
  .el-ballots :global(.el-ballot-title) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }
  .tool :global(.el-tag) {
    display: inline-block;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    line-height: 20px;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .el-ballots :global(.referendum .el-tag),
  [data-required='true'] .el-tag {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 35%, transparent);
    background: var(--accent-soft);
  }
  .el-notes,
  .el-rules {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
    color: var(--text-2);
  }
  .el-notes:empty {
    display: none;
  }
  .el-rules {
    font-size: 15px;
    color: var(--text);
  }

  .el-bring {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .el-bring-item {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .el-bring-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }

  .el-quote {
    margin: 0;
    padding: 12px 16px;
    border-left: 3px solid var(--border-strong);
    background: var(--surface-2);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
  }
  .el-sources {
    margin: 0;
  }
</style>
