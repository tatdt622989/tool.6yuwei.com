---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="heic-to-jpg" {...i18nAttrs(locale, s.client)}>
  <p class="notice ok hj-privacy">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    <span><strong>{s.privacyStrong}</strong>{s.privacyText}</span>
  </p>

  <label class="dropzone" id="hj-drop" tabindex="0">
    <input type="file" id="hj-file" accept=".heic,.heif,.hif,image/heic,image/heif" multiple hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="grid-2">
    <div class="field">
      <span class="label">{s.formatLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.formatLabel}>
        <label><input type="radio" name="hj-format" value="jpeg" checked /><span>JPG</span></label>
        <label><input type="radio" name="hj-format" value="png" /><span>PNG</span></label>
      </div>
    </div>
    <div class="field" id="hj-quality-field">
      <label for="hj-quality">{s.qualityBefore}<output id="hj-quality-out">90</output></label>
      <input id="hj-quality" type="range" min="10" max="100" step="1" value="90" />
      <span class="hint">{s.qualityHint}</span>
    </div>
  </div>

  <p class="notice" id="hj-note" hidden></p>

  <div class="stats" id="hj-summary" hidden>
    <div class="stat"><span class="stat-value" id="hj-count">0</span><span class="stat-label">{s.statCount}</span></div>
    <div class="stat"><span class="stat-value" id="hj-done">0</span><span class="stat-label">{s.statDone}</span></div>
    <div class="stat"><span class="stat-value" id="hj-before">0 B</span><span class="stat-label">{s.statBefore}</span></div>
    <div class="stat"><span class="stat-value" id="hj-after">0 B</span><span class="stat-label">{s.statAfter}</span></div>
  </div>

  <ul class="hj-list" id="hj-list" aria-live="polite"></ul>

  <div class="row" id="hj-actions" hidden>
    <button class="btn primary" type="button" id="hj-zip">{s.zip}</button>
    <button class="btn" type="button" id="hj-all">{s.all}</button>
    <button class="btn ghost" type="button" id="hj-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import { createZip } from '../pdf-split/zip';
  import { loadHeicDecoder } from '../../lib/heic';
  import { encoderQuality, isHeic, outputFilename, outputMime, type HeicOutput } from './logic';

  interface Result {
    blob: Blob;
    url: string;
    width: number;
    height: number;
    filename: string;
  }
  interface Item {
    file: File;
    row: HTMLLIElement;
    result?: Result;
    error?: string;
    status?: string;
  }
  interface Prefs {
    format: HeicOutput;
    quality: number;
  }

  const root = $('[data-tool="heic-to-jpg"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const drop = $('#hj-drop', root);
  const fileInput = $<HTMLInputElement>('#hj-file', root);
  const formatRadios = $$<HTMLInputElement>('input[name="hj-format"]', root);
  const quality = $<HTMLInputElement>('#hj-quality', root);
  const qualityOut = $('#hj-quality-out', root);
  const qualityField = $('#hj-quality-field', root);
  const note = $('#hj-note', root);
  const list = $('#hj-list', root);
  const summary = $('#hj-summary', root);
  const actions = $('#hj-actions', root);
  const zipBtn = $<HTMLButtonElement>('#hj-zip', root);
  const allBtn = $<HTMLButtonElement>('#hj-all', root);

  let items: Item[] = [];
  let generation = 0;
  /** null = not tried yet; false once the browser has failed to decode HEIC natively. */
  let nativeWorks: boolean | null = null;

  function readPrefs(): Prefs {
    const format = (formatRadios.find((r) => r.checked)?.value ?? 'jpeg') as HeicOutput;
    return { format, quality: Number(quality.value) };
  }

  function applyPrefs(p: Prefs) {
    for (const r of formatRadios) r.checked = r.value === p.format;
    quality.value = String(p.quality);
    qualityOut.textContent = quality.value;
    qualityField.hidden = p.format === 'png';
  }

  // ---------- Decoding ----------
  function canvasToBlob(canvas: HTMLCanvasElement, type: string, q?: number): Promise<Blob> {
    return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q));
  }

  async function nativeDecode(file: Blob): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { source: bmp, width: bmp.width, height: bmp.height, close: () => bmp.close() };
      } catch {
        /* try <img> */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      if (!img.naturalWidth) throw new Error('decode');
      return { source: img, width: img.naturalWidth, height: img.naturalHeight, close: () => {} };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  async function encodeNative(file: File, prefs: Prefs): Promise<{ blob: Blob; width: number; height: number }> {
    const image = await nativeDecode(file);
    try {
      const canvas = document.createElement('canvas');
      canvas.width = image.width;
      canvas.height = image.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('canvas');
      if (prefs.format === 'jpeg') {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
      ctx.drawImage(image.source, 0, 0);
      const type = outputMime(prefs.format);
      const blob = await canvasToBlob(canvas, type, encoderQuality(prefs.format, prefs.quality));
      canvas.width = canvas.height = 0;
      return { blob, width: image.width, height: image.height };
    } finally {
      image.close();
    }
  }

  async function blobSize(blob: Blob): Promise<{ width: number; height: number }> {
    try {
      const bmp = await createImageBitmap(blob);
      const size = { width: bmp.width, height: bmp.height };
      bmp.close();
      return size;
    } catch {
      return { width: 0, height: 0 };
    }
  }

  async function convert(item: Item, prefs: Prefs): Promise<Result> {
    let out: { blob: Blob; width: number; height: number } | null = null;
    if (nativeWorks !== false) {
      try {
        out = await encodeNative(item.file, prefs);
        nativeWorks = true;
      } catch {
        if (nativeWorks === null) nativeWorks = false;
      }
    }
    if (!out) {
      item.status = s.loadingDecoder;
      drawRow(item);
      const heicTo = await loadHeicDecoder();
      const blob = await heicTo({ blob: item.file, type: outputMime(prefs.format), quality: encoderQuality(prefs.format, prefs.quality) });
      out = { blob, ...(await blobSize(blob)) };
    }
    return {
      blob: out.blob,
      url: URL.createObjectURL(out.blob),
      width: out.width,
      height: out.height,
      filename: outputFilename(item.file.name, prefs.format),
    };
  }

  // ---------- Rendering ----------
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    const thumb = el('div', 'hj-thumb');
    if (item.result) {
      const img = el('img');
      img.src = item.result.url;
      img.alt = '';
      img.loading = 'lazy';
      thumb.append(img);
    }
    const info = el('div', 'hj-info');
    const meta = el('div', 'hj-meta');
    info.append(el('div', 'hj-name', item.file.name), meta);
    if (item.error) {
      meta.append(el('span', 'hj-error', item.error));
    } else if (!item.result) {
      meta.textContent = t(s.pending, { size: formatBytes(item.file.size, locale), status: item.status ?? s.waiting });
    } else {
      const r = item.result;
      const dims = r.width ? t(s.dims, { width: r.width, height: r.height }) : '';
      meta.textContent = t(s.done, { before: formatBytes(item.file.size, locale), after: formatBytes(r.blob.size, locale) }) + dims;
    }
    const btn = el('button', 'btn small', s.download);
    btn.type = 'button';
    btn.disabled = !item.result;
    btn.addEventListener('click', () => item.result && downloadBlob(item.result.blob, item.result.filename));
    row.append(thumb, info, btn);
  }

  function updateSummary() {
    const done = items.filter((i) => i.result);
    summary.hidden = items.length === 0;
    actions.hidden = items.length === 0;
    $('#hj-count', root).textContent = formatInteger(items.length, locale);
    $('#hj-done', root).textContent = formatInteger(done.length, locale);
    $('#hj-before', root).textContent = formatBytes(done.reduce((sum, i) => sum + i.file.size, 0), locale);
    $('#hj-after', root).textContent = formatBytes(done.reduce((sum, i) => sum + i.result!.blob.size, 0), locale);
    zipBtn.disabled = done.length === 0;
    allBtn.disabled = done.length === 0;
  }

  function releaseResult(item: Item) {
    if (item.result) URL.revokeObjectURL(item.result.url);
    item.result = undefined;
    item.error = undefined;
    item.status = undefined;
  }

  let running = false;
  async function processQueue() {
    if (running) return;
    running = true;
    try {
      for (;;) {
        const gen = generation;
        const prefs = readPrefs();
        const item = items.find((i) => !i.result && !i.error);
        if (!item) break;
        item.status = s.converting;
        drawRow(item);
        try {
          const result = await convert(item, prefs);
          if (gen !== generation || !items.includes(item)) {
            URL.revokeObjectURL(result.url);
            continue;
          }
          item.result = result;
        } catch {
          if (gen !== generation || !items.includes(item)) continue;
          item.error = navigator.onLine ? s.error : s.offline;
        }
        drawRow(item);
        updateSummary();
      }
    } finally {
      running = false;
    }
  }

  function reprocess() {
    const prefs = readPrefs();
    savePref('heic-to-jpg', prefs);
    qualityOut.textContent = quality.value;
    qualityField.hidden = prefs.format === 'png';
    if (items.length === 0) return;
    generation++;
    for (const item of items) {
      releaseResult(item);
      drawRow(item);
    }
    updateSummary();
    void processQueue();
  }

  function addFiles(files: Iterable<File>) {
    let skipped = 0;
    for (const file of files) {
      if (!isHeic(file.type, file.name)) {
        skipped++;
        continue;
      }
      const item: Item = { file, row: el('li', 'hj-item') };
      drawRow(item);
      list.append(item.row);
      items.push(item);
    }
    note.hidden = skipped === 0;
    note.textContent = skipped ? (skipped === 1 && s.skippedOne ? s.skippedOne : t(s.skipped, { n: skipped })) : '';
    updateSummary();
    void processQueue();
  }

  function clearAll() {
    generation++;
    for (const item of items) releaseResult(item);
    items = [];
    list.replaceChildren();
    fileInput.value = '';
    note.hidden = true;
    updateSummary();
  }

  // ---------- Wiring ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) addFiles(Array.from(e.dataTransfer.files));
  });

  const reprocessSoon = debounce(reprocess, 500);
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    reprocessSoon();
  });
  formatRadios.forEach((r) => r.addEventListener('change', reprocess));

  zipBtn.addEventListener('click', async () => {
    const done = items.filter((i) => i.result);
    if (done.length === 0) return;
    const label = zipBtn.textContent;
    zipBtn.disabled = true;
    zipBtn.textContent = s.zipping;
    try {
      const entries = await Promise.all(
        done.map(async (i) => ({ name: i.result!.filename, data: new Uint8Array(await i.result!.blob.arrayBuffer()) })),
      );
      const ext = readPrefs().format === 'png' ? 'png' : 'jpg';
      downloadBlob(new Blob([createZip(entries)], { type: 'application/zip' }), `heic-to-${ext}.zip`);
    } finally {
      zipBtn.textContent = label;
      zipBtn.disabled = false;
    }
  });
  allBtn.addEventListener('click', async () => {
    for (const item of items) {
      if (!item.result) continue;
      downloadBlob(item.result.blob, item.result.filename);
      await new Promise((r) => setTimeout(r, 350));
    }
  });
  $('#hj-clear', root).addEventListener('click', clearAll);

  applyPrefs(loadPref<Prefs>('heic-to-jpg', { format: 'jpeg', quality: 90 }));
</script>

<style>
  .hj-privacy {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .hj-privacy svg {
    flex: none;
    margin-top: 2px;
  }
  .hj-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hj-list:empty {
    display: none;
  }
  .hj-list :global(.hj-item) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .hj-list :global(.hj-thumb) {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .hj-list :global(.hj-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hj-list :global(.hj-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .hj-list :global(.hj-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hj-list :global(.hj-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .hj-list :global(.hj-error) {
    color: var(--danger);
  }
  @media (max-width: 420px) {
    .hj-list :global(.hj-item) {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .hj-list :global(.hj-thumb) {
      width: 48px;
      height: 48px;
    }
    .hj-list :global(.hj-item .btn) {
      grid-column: 1 / -1;
    }
  }
</style>
