---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n, { type KeyAriaId } from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);

// Keypad definitions: [label, action, value, extra class, aria id]
type Key = { label: string; ins?: string; act?: 'clear' | 'del' | 'eval' | 'recip'; cls?: string; id?: KeyAriaId; key?: string };

const sciKeys: Key[] = [
  { label: 'sin', ins: 'sin(', id: 'sin' },
  { label: 'cos', ins: 'cos(', id: 'cos' },
  { label: 'tan', ins: 'tan(', id: 'tan' },
  { label: 'ln', ins: 'ln(', id: 'ln' },
  { label: 'log', ins: 'log(', id: 'log' },
  { label: 'sin⁻¹', ins: 'sin⁻¹(', id: 'asin' },
  { label: 'cos⁻¹', ins: 'cos⁻¹(', id: 'acos' },
  { label: 'tan⁻¹', ins: 'tan⁻¹(', id: 'atan' },
  { label: 'eˣ', ins: 'e^(', id: 'exp' },
  { label: '10ˣ', ins: '10^(', id: 'pow10' },
  { label: 'x²', ins: '²', id: 'square' },
  { label: 'xʸ', ins: '^', id: 'power', key: '^' },
  { label: '√', ins: '√(', id: 'sqrt' },
  { label: '∛', ins: '∛(', id: 'cbrt' },
  { label: 'x!', ins: '!', id: 'factorial', key: '!' },
  { label: 'π', ins: 'π', id: 'pi' },
  { label: 'e', ins: 'e', id: 'e' },
  { label: '1/x', act: 'recip', id: 'recip' },
  { label: '|x|', ins: 'abs(', id: 'abs' },
  { label: 'Ans', ins: 'Ans', id: 'ans' },
];

const mainKeys: Key[] = [
  { label: 'AC', act: 'clear', cls: 'fn', id: 'clear', key: 'Escape' },
  { label: '(', ins: '(', cls: 'fn', key: '(' },
  { label: ')', ins: ')', cls: 'fn', key: ')' },
  { label: '÷', ins: '÷', cls: 'op', id: 'divide', key: '/' },
  { label: '7', ins: '7', key: '7' },
  { label: '8', ins: '8', key: '8' },
  { label: '9', ins: '9', key: '9' },
  { label: '×', ins: '×', cls: 'op', id: 'multiply', key: '*' },
  { label: '4', ins: '4', key: '4' },
  { label: '5', ins: '5', key: '5' },
  { label: '6', ins: '6', key: '6' },
  { label: '−', ins: '−', cls: 'op', id: 'minus', key: '-' },
  { label: '1', ins: '1', key: '1' },
  { label: '2', ins: '2', key: '2' },
  { label: '3', ins: '3', key: '3' },
  { label: '+', ins: '+', cls: 'op', id: 'plus', key: '+' },
  { label: '%', ins: '%', cls: 'fn', id: 'percent', key: '%' },
  { label: '0', ins: '0', key: '0' },
  { label: '.', ins: '.', id: 'dot', key: '.' },
  { label: '=', act: 'eval', cls: 'eq', id: 'equals', key: 'Enter' },
];
const aria = (k: Key) => (k.id ? s.keyAria[k.id] : undefined);
---

<div class="tool" data-tool="calculator" {...i18nAttrs(locale, s.client)}>
  <div class="ca-body" id="ca-body" data-mode="basic">
    <div class="row between">
      <div class="seg" role="radiogroup" aria-label={s.modeAria}>
        <label><input type="radio" name="ca-mode" value="basic" checked /><span>{s.modeBasic}</span></label>
        <label><input type="radio" name="ca-mode" value="sci" /><span>{s.modeSci}</span></label>
      </div>
      <div class="seg ca-angle" role="radiogroup" aria-label={s.angleAria}>
        <label><input type="radio" name="ca-angle" value="deg" checked /><span>{s.angleDeg}</span></label>
        <label><input type="radio" name="ca-angle" value="rad" /><span>{s.angleRad}</span></label>
      </div>
    </div>

    <div class="ca-display">
      <div class="ca-prev" id="ca-prev"></div>
      <div class="ca-line">
        <input
          id="ca-expr"
          class="ca-expr"
          type="text"
          inputmode="none"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label={s.exprAria}
          value="12×(3+4)÷2"
        />
        <button class="ca-del" type="button" data-act="del" data-key="Backspace" aria-label={s.delAria}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
            ><path d="M9 5h11v14H9l-6-7z M12.5 9.5l5 5 M17.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path></svg
          >
        </button>
      </div>
      <div class="ca-out" aria-live="polite">
        <output id="ca-result" class="ca-result" for="ca-expr"></output>
      </div>
    </div>

    <div class="ca-pad">
      <div class="ca-sci" id="ca-sci" aria-label={s.sciAria}>
        {
          sciKeys.map((k) => (
            <button type="button" class="ca-key sci" data-ins={k.ins} data-act={k.act} data-key={k.key} aria-label={aria(k)}>
              {k.label}
            </button>
          ))
        }
      </div>
      <div class="ca-main">
        {
          mainKeys.map((k) => (
            <button type="button" class:list={['ca-key', k.cls]} data-ins={k.ins} data-act={k.act} data-key={k.key} aria-label={aria(k)}>
              {k.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="row">
      <button class="btn small" type="button" id="ca-copy">{s.copy}</button>
      <span class="hint">{s.keyboardHint}</span>
    </div>
  </div>

  <div class="field">
    <div class="row between">
      <span class="label">{s.historyLabel}</span>
      <button class="btn small ghost" type="button" id="ca-clear-history">{s.clearHistory}</button>
    </div>
    <ol class="ca-history" id="ca-history"></ol>
    <p class="hint" id="ca-history-empty">{s.historyEmpty}</p>
  </div>
</div>

<script>
  import { $, $$, copyText, flashButton, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import { evaluate, formatResult, groupDigits, pushHistory, type AngleMode, type EvalResult, type HistoryEntry } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="calculator"]');
  const { s } = readI18n<Strings['client']>(root);
  const errorText = (r: Extract<EvalResult, { ok: false }>) => {
    const template = s.errors?.[r.code];
    return template ? t(template, r.vars) : r.error;
  };
  const body = $('#ca-body', root);
  const expr = $<HTMLInputElement>('#ca-expr', root);
  const prev = $('#ca-prev', root);
  const result = $('#ca-result', root);
  const historyList = $('#ca-history', root);
  const historyEmpty = $('#ca-history-empty', root);
  const modeInputs = $$<HTMLInputElement>('input[name="ca-mode"]', root);
  const angleInputs = $$<HTMLInputElement>('input[name="ca-angle"]', root);

  type Mode = 'basic' | 'sci';
  const prefs = loadPref<{ mode: Mode; angle: AngleMode }>('calculator', { mode: 'basic', angle: 'deg' });
  let history = loadPref<HistoryEntry[]>('calculator:history', []);
  let ans = 0;
  /** After "=", typing a number starts over while typing an operator continues from the answer. */
  let justEvaluated = false;

  const angle = (): AngleMode => (angleInputs.find((i) => i.checked)?.value === 'rad' ? 'rad' : 'deg');

  function setMode(mode: Mode) {
    body.dataset.mode = mode;
    for (const i of modeInputs) i.checked = i.value === mode;
  }

  function persist() {
    savePref('calculator', { mode: body.dataset.mode as Mode, angle: angle() });
  }

  function preview() {
    result.classList.remove('is-error');
    const text = expr.value.trim();
    if (!text) {
      result.textContent = '0';
      return;
    }
    const r = evaluate(text, { angle: angle(), ans });
    // While typing, stay quiet about incomplete input; errors are shown on "=".
    result.textContent = r.ok ? `= ${groupDigits(formatResult(r.value))}` : '';
  }

  function setExpression(value: string, caret = value.length) {
    expr.value = value;
    expr.setSelectionRange(caret, caret);
    preview();
  }

  function insert(text: string) {
    const isOperator = /^[+−×÷^%!²)]/.test(text);
    if (justEvaluated) {
      prev.textContent = '';
      if (!isOperator) setExpression('');
      else expr.setSelectionRange(expr.value.length, expr.value.length);
    }
    justEvaluated = false;
    const start = expr.selectionStart ?? expr.value.length;
    const end = expr.selectionEnd ?? start;
    setExpression(expr.value.slice(0, start) + text + expr.value.slice(end), start + text.length);
  }

  function backspace() {
    justEvaluated = false;
    const start = expr.selectionStart ?? expr.value.length;
    const end = expr.selectionEnd ?? start;
    if (start !== end) {
      setExpression(expr.value.slice(0, start) + expr.value.slice(end), start);
      return;
    }
    if (start === 0) return;
    // Delete whole function names such as "sin⁻¹(" in one step.
    const before = expr.value.slice(0, start);
    const m = /(sin⁻¹\(|cos⁻¹\(|tan⁻¹\(|sin\(|cos\(|tan\(|log\(|ln\(|abs\(|Ans|√\(|∛\(|e\^\(|10\^\()$/.exec(before);
    const cut = m ? m[0].length : 1;
    setExpression(before.slice(0, -cut) + expr.value.slice(start), start - cut);
  }

  function clearAll() {
    justEvaluated = false;
    prev.textContent = '';
    setExpression('');
  }

  function renderHistory() {
    historyList.innerHTML = '';
    for (const [i, h] of history.entries()) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ca-hist';
      btn.dataset.index = String(i);
      const e = document.createElement('span');
      e.className = 'ca-hist-expr';
      e.textContent = `${h.expr} =`;
      const r = document.createElement('span');
      r.className = 'ca-hist-result';
      r.textContent = groupDigits(h.result);
      btn.append(e, r);
      li.append(btn);
      historyList.append(li);
    }
    historyEmpty.hidden = history.length > 0;
  }

  function calculate() {
    const text = expr.value.trim();
    if (!text) return;
    const r = evaluate(text, { angle: angle(), ans });
    if (!r.ok) {
      result.textContent = errorText(r);
      result.classList.add('is-error');
      return;
    }
    const out = formatResult(r.value);
    ans = r.value;
    history = pushHistory(history, { expr: text, result: out });
    savePref('calculator:history', history);
    renderHistory();
    prev.textContent = `${text} =`;
    setExpression(out);
    result.textContent = `= ${groupDigits(out)}`;
    justEvaluated = true;
  }

  function reciprocal() {
    const text = expr.value.trim();
    justEvaluated = false;
    prev.textContent = '';
    setExpression(text ? `1÷(${text})` : '1÷(');
  }

  function press(button: HTMLElement) {
    const act = button.dataset.act;
    if (act === 'clear') clearAll();
    else if (act === 'del') backspace();
    else if (act === 'eval') calculate();
    else if (act === 'recip') reciprocal();
    else if (button.dataset.ins) insert(button.dataset.ins);
  }

  root.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('.ca-key, .ca-del');
    if (button) press(button);
  });
  // Mouse clicks on the keypad must not steal focus, so a following Enter still means "=".
  root.addEventListener('mousedown', (event) => {
    if ((event.target as Element).closest('.ca-key, .ca-del')) event.preventDefault();
  });

  expr.addEventListener('input', () => {
    justEvaluated = false;
    preview();
  });

  const KEY_MAP: Record<string, string> = { '*': '×', '/': '÷', '-': '−' };

  function flash(key: string) {
    const button = root.querySelector<HTMLElement>(`[data-key="${CSS.escape(key)}"]`);
    if (!button) return;
    button.classList.add('is-pressed');
    window.setTimeout(() => button.classList.remove('is-pressed'), 120);
  }

  document.addEventListener('keydown', (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
    const target = event.target as HTMLElement | null;
    const inOurInput = target === expr;
    const typingElsewhere =
      !inOurInput &&
      !!target &&
      (target.isContentEditable ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        (target instanceof HTMLInputElement && !['radio', 'checkbox', 'button', 'range'].includes(target.type)));
    if (typingElsewhere) return;
    const { key } = event;

    if (key === 'Enter' || key === '=') {
      // Enter on a focused button or link keeps its normal meaning (keyboard navigation).
      if (key === 'Enter' && target instanceof HTMLElement && target.closest('button, a, summary')) return;
      event.preventDefault();
      flash('Enter');
      calculate();
      return;
    }
    if (key === 'Escape') {
      event.preventDefault();
      flash('Escape');
      clearAll();
      return;
    }
    if (inOurInput) return; // native editing handles everything else inside the field
    if (key === 'Backspace') {
      event.preventDefault();
      flash('Backspace');
      backspace();
      return;
    }
    if (/^[0-9.+\-*/^()%!]$/.test(key)) {
      event.preventDefault();
      flash(key);
      insert(KEY_MAP[key] ?? key);
    }
  });

  historyList.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('.ca-hist');
    if (!button) return;
    const h = history[Number(button.dataset.index)];
    if (!h) return;
    justEvaluated = false;
    prev.textContent = '';
    setExpression(h.expr);
  });

  $('#ca-clear-history', root).addEventListener('click', () => {
    history = [];
    savePref('calculator:history', history);
    renderHistory();
  });

  $('#ca-copy', root).addEventListener('click', async (event) => {
    const r = evaluate(expr.value, { angle: angle(), ans });
    const text = r.ok ? formatResult(r.value) : expr.value;
    if (text && (await copyText(text))) flashButton(event.currentTarget as HTMLElement);
  });

  modeInputs.forEach((i) =>
    i.addEventListener('change', () => {
      setMode(i.value === 'sci' ? 'sci' : 'basic');
      persist();
    }),
  );
  angleInputs.forEach((i) =>
    i.addEventListener('change', () => {
      persist();
      preview();
    }),
  );

  setMode(prefs.mode === 'sci' ? 'sci' : 'basic');
  for (const i of angleInputs) i.checked = i.value === prefs.angle;
  renderHistory();
  setExpression(expr.value);
</script>

<style>
  .ca-body {
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }
  .ca-body[data-mode='sci'] {
    max-width: 820px;
  }
  .ca-body[data-mode='basic'] .ca-angle,
  .ca-body[data-mode='basic'] .ca-sci {
    display: none;
  }

  .ca-display {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ca-display:focus-within {
    border-color: var(--accent);
    box-shadow: var(--focus);
  }
  .ca-prev {
    min-height: 22px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .ca-line {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ca-expr.ca-expr {
    flex: 1;
    padding: 4px 0;
    font-family: var(--mono);
    font-size: clamp(24px, 7vw, 34px);
    font-variant-numeric: tabular-nums;
    text-align: right;
    background: transparent;
    border: 0;
    box-shadow: none;
    caret-color: var(--accent);
  }
  .ca-del {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    color: var(--text-2);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .ca-del:hover {
    background: var(--surface);
  }
  .ca-out {
    min-height: 28px;
    text-align: right;
  }
  .ca-result {
    font-size: 20px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .ca-result.is-error {
    font-size: 15px;
    color: var(--danger);
  }

  .ca-pad {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 720px) {
    .ca-body[data-mode='sci'] .ca-pad {
      grid-template-columns: 5fr 4fr;
      align-items: start;
    }
  }
  .ca-sci,
  .ca-main {
    display: grid;
    gap: 8px;
  }
  .ca-sci {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .ca-main {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ca-key {
    min-height: 58px;
    padding: 0;
    font: inherit;
    font-size: 22px;
    font-weight: 500;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transition: background 0.1s, transform 0.05s;
  }
  .ca-key:hover {
    background: var(--surface-2);
  }
  .ca-key:active,
  .ca-key.is-pressed {
    transform: scale(0.97);
    background: var(--surface-2);
  }
  .ca-key.fn {
    background: var(--surface-2);
    font-size: 19px;
  }
  .ca-key.op {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 25%, transparent);
    font-size: 24px;
  }
  .ca-key.eq {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
    font-size: 26px;
  }
  .ca-key.eq:hover,
  .ca-key.eq.is-pressed {
    background: var(--accent-hover);
  }
  .ca-key.sci {
    min-height: 46px;
    font-size: 16px;
    background: var(--surface-2);
    color: var(--text-2);
  }
  @media (min-width: 720px) {
    .ca-key.sci {
      min-height: 58px;
    }
  }

  .ca-history {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 280px;
    overflow-y: auto;
  }
  .ca-history :global(.ca-hist) {
    display: grid;
    width: 100%;
    gap: 2px;
    padding: 8px 12px;
    text-align: right;
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .ca-history :global(.ca-hist:hover) {
    border-color: var(--border-strong);
  }
  .ca-history :global(.ca-hist-expr) {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .ca-history :global(.ca-hist-result) {
    font-family: var(--mono);
    font-size: 17px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
