---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="line-tools" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="lt-input">{s.inputLabel}</label>
    <textarea id="lt-input" class="mono" rows="12" spellcheck="false" placeholder={s.placeholder}></textarea>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="lt-total">0</span><span class="stat-label">{s.statTotal}</span></div>
    <div class="stat"><span class="stat-value" id="lt-nonempty">0</span><span class="stat-label">{s.statNonEmpty}</span></div>
    <div class="stat"><span class="stat-value" id="lt-dupes">0</span><span class="stat-label">{s.statDupes}</span></div>
  </div>

  <p class="notice" id="lt-msg" aria-live="polite" hidden></p>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#lt-input">{s.copy}</button>
    <button class="btn" type="button" id="lt-undo" disabled>{s.undo}</button>
    <button class="btn ghost" type="button" id="lt-clear">{s.clear}</button>
  </div>

  <section class="lt-group" aria-labelledby="lt-h-sort">
    <span id="lt-h-sort" class="lt-title">{s.sortTitle}</span>
    <div class="row">
      <button class="btn small" type="button" data-op="asc">{s.asc}</button>
      <button class="btn small" type="button" data-op="desc">{s.desc}</button>
      <button class="btn small" type="button" data-op="natural">{s.natural}</button>
      <button class="btn small" type="button" data-op="length">{s.byLength}</button>
      <button class="btn small" type="button" data-op="reverse">{s.reverse}</button>
      <button class="btn small" type="button" data-op="shuffle">{s.shuffle}</button>
    </div>
    <div class="row">
      <label class="check"><input type="checkbox" id="lt-case" /> {s.caseSensitive}</label>
      {
        s.zhCollation && (
          <label class="lt-inline" for="lt-collation">
            {s.zhCollation.label}
            <select id="lt-collation">
              {s.zhCollation.options.map((o) => (
                <Fragment>{' '}<option value={o.value}>{o.label}</option></Fragment>
              ))}
            </select>
          </label>
        )
      }
    </div>
  </section>

  <section class="lt-group" aria-labelledby="lt-h-clean">
    <span id="lt-h-clean" class="lt-title">{s.cleanTitle}</span>
    <div class="row">
      <button class="btn small" type="button" data-op="dedupe">{s.dedupe}</button>
      <button class="btn small" type="button" data-op="empty">{s.removeEmpty}</button>
      <button class="btn small" type="button" data-op="trim">{s.trim}</button>
    </div>
  </section>

  <section class="lt-group" aria-labelledby="lt-h-affix">
    <span id="lt-h-affix" class="lt-title">{s.affixTitle}</span>
    <div class="lt-affix">
      <input type="text" id="lt-prefix" class="mono" placeholder={s.prefixPlaceholder} aria-label={s.prefixAria} />
      <input type="text" id="lt-suffix" class="mono" placeholder={s.suffixPlaceholder} aria-label={s.suffixAria} />
      <button class="btn small" type="button" data-op="affix">{s.addAffix}</button>
    </div>
  </section>

  <section class="lt-group" aria-labelledby="lt-h-number">
    <span id="lt-h-number" class="lt-title">{s.numberTitle}</span>
    <div class="row">
      <select id="lt-format" aria-label={s.numberFormatAria} class="lt-narrow">
        {s.numberFormats.map((f) => (
          <Fragment>{' '}<option value={f.value}>{f.label}</option></Fragment>
        ))}
      </select>
      <label class="lt-inline" for="lt-start">
        {s.start}
        <input type="number" id="lt-start" value="1" min="0" step="1" class="lt-num" />
      </label>
      <label class="check"><input type="checkbox" id="lt-pad" /> {s.pad}</label>
      <button class="btn small" type="button" data-op="number">{s.addNumbers}</button>
    </div>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { LineOp, Strings } from './i18n';
  import {
    addAffixes,
    dedupeLines,
    isNumberFormat,
    joinLines,
    lineStats,
    numberLines,
    removeEmptyLines,
    reverseLines,
    shuffleLines,
    sortLines,
    splitLines,
    trimLines,
    type Collation,
    type CompareOptions,
  } from './logic';

  const root = $('[data-tool="line-tools"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#lt-input', root);
  const msg = $('#lt-msg', root);
  const undoBtn = $<HTMLButtonElement>('#lt-undo', root);
  const caseBox = $<HTMLInputElement>('#lt-case', root);
  // Only the zh page has a Chinese collation picker; other locales use their own fixed collation.
  const collation = root.querySelector<HTMLSelectElement>('#lt-collation');
  const prefix = $<HTMLInputElement>('#lt-prefix', root);
  const suffix = $<HTMLInputElement>('#lt-suffix', root);
  const format = $<HTMLSelectElement>('#lt-format', root);
  const start = $<HTMLInputElement>('#lt-start', root);
  const pad = $<HTMLInputElement>('#lt-pad', root);

  interface Prefs {
    caseSensitive: boolean;
    collation: string;
    format: string;
    pad: boolean;
  }

  const prefs = loadPref<Prefs>('line-tools', { caseSensitive: false, collation: 'stroke', format: 'dot', pad: false });
  caseBox.checked = Boolean(prefs.caseSensitive);
  if (collation) collation.value = prefs.collation === 'zhuyin' ? 'zhuyin' : 'stroke';
  format.value = isNumberFormat(prefs.format) && format.querySelector(`option[value="${prefs.format}"]`) ? prefs.format : 'dot';
  pad.checked = Boolean(prefs.pad);

  function persist() {
    savePref('line-tools', {
      caseSensitive: caseBox.checked,
      collation: collation ? collation.value : prefs.collation,
      format: format.value,
      pad: pad.checked,
    } satisfies Prefs);
  }

  function compareOptions(): CompareOptions {
    const order: Collation = collation
      ? collation.value === 'zhuyin'
        ? 'zhuyin'
        : 'stroke'
      : (s.collation ?? 'stroke');
    return { caseSensitive: caseBox.checked, collation: order };
  }

  const lines = (n: number) => plural(locale, n, s.lines);

  function apply(op: string, lines: string[]): string[] {
    const cmp = compareOptions();
    switch (op) {
      case 'asc':
      case 'desc':
      case 'natural':
      case 'length':
        return sortLines(lines, op, cmp);
      case 'reverse':
        return reverseLines(lines);
      case 'shuffle':
        return shuffleLines(lines);
      case 'dedupe':
        return dedupeLines(lines, cmp.caseSensitive);
      case 'empty':
        return removeEmptyLines(lines);
      case 'trim':
        return trimLines(lines);
      case 'affix':
        return addAffixes(lines, prefix.value, suffix.value);
      case 'number': {
        const first = Number.parseInt(start.value, 10);
        const fmt = isNumberFormat(format.value) ? format.value : 'dot';
        return numberLines(lines, fmt, Number.isFinite(first) ? first : 1, pad.checked);
      }
      default:
        return lines;
    }
  }

  const history: string[] = [];

  function renderStats() {
    const stats = lineStats(splitLines(input.value), caseBox.checked);
    $('#lt-total', root).textContent = formatInteger(stats.total, locale);
    $('#lt-nonempty', root).textContent = formatInteger(stats.nonEmpty, locale);
    $('#lt-dupes', root).textContent = formatInteger(stats.duplicates, locale);
    undoBtn.disabled = history.length === 0;
  }

  function showMessage(text: string, kind: '' | 'ok' = '') {
    msg.textContent = text;
    msg.className = kind ? `notice ${kind}` : 'notice';
    msg.hidden = text === '';
  }

  for (const button of $$<HTMLButtonElement>('[data-op]', root)) {
    button.addEventListener('click', () => {
      const op = button.dataset.op! as LineOp;
      const before = splitLines(input.value);
      if (before.length === 0) {
        showMessage(s.empty);
        input.focus();
        return;
      }
      if (op === 'affix' && prefix.value === '' && suffix.value === '') {
        showMessage(s.noAffix);
        prefix.focus();
        return;
      }
      const after = apply(op, before);
      history.push(input.value);
      if (history.length > 50) history.shift();
      input.value = joinLines(after);
      showMessage(t(s.result, { label: s.done[op], before: lines(before.length), after: lines(after.length) }), 'ok');
      renderStats();
    });
  }

  undoBtn.addEventListener('click', () => {
    const previous = history.pop();
    if (previous === undefined) return;
    input.value = previous;
    showMessage(s.undone);
    renderStats();
  });

  $('#lt-clear', root).addEventListener('click', () => {
    if (input.value) history.push(input.value);
    input.value = '';
    showMessage('');
    renderStats();
    input.focus();
  });

  input.addEventListener('input', renderStats);
  caseBox.addEventListener('change', () => {
    persist();
    renderStats();
  });
  for (const el of [collation, format, pad]) el?.addEventListener('change', persist);
  renderStats();
</script>

<style>
  .lt-group {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .lt-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
  }
  .lt-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    white-space: nowrap;
  }
  .lt-inline select {
    width: auto;
  }
  .lt-narrow {
    width: auto;
  }
  .lt-num {
    width: 84px;
  }
  .lt-affix {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
  }
  @media (max-width: 480px) {
    .lt-affix {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .lt-affix .btn {
      grid-column: 1 / -1;
    }
  }
</style>
