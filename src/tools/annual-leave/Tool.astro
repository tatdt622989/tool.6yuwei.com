<div class="tool" data-tool="annual-leave">
  <div class="grid-2">
    <div class="field">
      <label for="al-hire">到職日</label>
      <input id="al-hire" type="date" value="2023-07-01" />
    </div>
    <div class="field">
      <span class="label">特休計算制度</span>
      <div class="seg" role="radiogroup" aria-label="特休計算制度">
        <label><input type="radio" name="al-mode" value="anniversary" checked /><span>週年制</span></label>
        <label><input type="radio" name="al-mode" value="calendar" /><span>曆年制</span></label>
      </div>
    </div>
    <div class="field" id="al-on-field">
      <label for="al-on">計算基準日</label>
      <input id="al-on" type="date" />
      <span class="hint">預設為今天，可改成離職日或任何日期。</span>
    </div>
    <div class="field" id="al-year-field" hidden>
      <label for="al-year">計算年度（西元）</label>
      <input id="al-year" type="text" inputmode="numeric" autocomplete="off" value="2026" />
      <span class="hint">曆年制以每年 1 月 1 日至 12 月 31 日為一個年度。</span>
    </div>
  </div>

  <div class="notice error" id="al-error" hidden></div>

  <div id="al-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="al-days">—</div>
      <div class="result-label" id="al-days-label">特休天數</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="al-hours">—</span><span class="stat-label">換算時數（每日 8 小時）</span></div>
      <div class="stat"><span class="stat-value" id="al-service">—</span><span class="stat-label">目前年資</span></div>
      <div class="stat"><span class="stat-value" id="al-next">—</span><span class="stat-label" id="al-next-label">下次增加</span></div>
    </div>

    <div class="field" id="al-share-field" hidden>
      <span class="label">曆年制比例計算明細</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>年資期間</th><th class="num">該期日數</th><th class="num">落在本年度比例</th><th class="num">本年度可休</th></tr></thead>
          <tbody id="al-shares"></tbody>
        </table>
      </div>
    </div>

    <div class="field">
      <span class="label">年資與特休日數對照（依你的到職日）</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>年資</th><th>取得日期</th><th class="num">特休日數</th></tr></thead>
          <tbody id="al-schedule"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="al-pay">
    <span class="label">未休特休折算工資</span>
    <div class="grid-2">
      <div class="field">
        <label for="al-salary">月薪（元）</label>
        <input id="al-salary" type="text" inputmode="numeric" autocomplete="off" value="36000" />
      </div>
      <div class="field">
        <label for="al-unused">未休天數</label>
        <input id="al-unused" type="text" inputmode="decimal" autocomplete="off" value="5" />
      </div>
    </div>
    <div class="result">
      <div class="result-value" id="al-pay">—</div>
      <div class="result-label" id="al-pay-label">應發給的未休特休工資</div>
    </div>
  </div>

  <p class="hint">依勞動基準法第 38 條與施行細則第 24 條、第 24 條之 1 計算；曆年制依勞動部示例按年資期間比例計算。結果僅供參考，公司若約定更優惠的給假方式從其約定。資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    anniversaryLeave,
    calendarYearLeave,
    compare,
    leavePeriods,
    monthsBetween,
    parseISODate,
    toISO,
    todayYMD,
    unusedLeavePay,
  } from './logic';

  const KEY = 'annual-leave';
  const root = $('[data-tool="annual-leave"]');
  const hire = $<HTMLInputElement>('#al-hire', root);
  const modes = $$<HTMLInputElement>('input[name="al-mode"]', root);
  const on = $<HTMLInputElement>('#al-on', root);
  const year = $<HTMLInputElement>('#al-year', root);
  const salary = $<HTMLInputElement>('#al-salary', root);
  const unused = $<HTMLInputElement>('#al-unused', root);
  const error = $('#al-error', root);
  const output = $('#al-output', root);

  const today = todayYMD();
  on.value = toISO(today);
  year.value = String(today.y);

  const prefs = loadPref<Partial<{ hire: string; mode: string; salary: string; unused: string }>>(KEY, {});
  if (prefs.hire) hire.value = prefs.hire;
  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.salary !== undefined) salary.value = prefs.salary;
  if (prefs.unused !== undefined) unused.value = prefs.unused;

  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const dayText = (n: number) => `${formatNumber(n, 2)} 天`;
  const zhDate = (iso: string) => {
    const [y, m, d] = iso.split('-');
    return `${y} 年 ${Number(m)} 月 ${Number(d)} 日`;
  };
  function serviceText(months: number): string {
    const y = Math.floor(months / 12);
    const m = Math.floor(months % 12);
    return y > 0 ? `${y} 年 ${m} 個月` : `${m} 個月`;
  }
  function cell(text: string, num = false): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    if (num) td.className = 'num';
    return td;
  }

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function renderPay() {
    const pay = unusedLeavePay(parseNumber(unused.value), parseNumber(salary.value));
    const daily = parseNumber(salary.value) / 30;
    set('#al-pay', Number.isFinite(pay) ? `${formatInteger(pay)} 元` : '—');
    set(
      '#al-pay-label',
      Number.isFinite(pay) ? `一日工資 ${formatNumber(daily, 2)} 元（月薪 ÷ 30）× 未休 ${formatNumber(parseNumber(unused.value), 2)} 天` : '請輸入月薪與未休天數',
    );
  }

  function render() {
    const mode = modes.find((m) => m.checked)?.value ?? 'anniversary';
    savePref(KEY, { hire: hire.value, mode, salary: salary.value, unused: unused.value });
    $('#al-on-field', root).hidden = mode !== 'anniversary';
    $('#al-year-field', root).hidden = mode !== 'calendar';
    $('#al-share-field', root).hidden = mode !== 'calendar';
    renderPay();

    const h = parseISODate(hire.value);
    if (!h) return fail('請選擇到職日。');
    const ref = mode === 'anniversary' ? parseISODate(on.value) : { y: parseNumber(year.value), m: 12, d: 31 };
    if (!ref || !Number.isInteger(ref.y)) return fail(mode === 'anniversary' ? '請選擇計算基準日。' : '請輸入西元年度，例如 2026。');
    if (compare(ref, h) < 0) return fail(mode === 'anniversary' ? '基準日不可早於到職日。' : '年度不可早於到職年度。');
    error.hidden = true;
    output.hidden = false;

    const refForService = mode === 'anniversary' ? ref : (compare(today, ref) < 0 ? today : ref);
    const service = compare(refForService, h) >= 0 ? monthsBetween(h, refForService) : 0;
    set('#al-service', serviceText(service));

    if (mode === 'anniversary') {
      const r = anniversaryLeave(h, ref)!;
      const days = r.current?.days ?? 0;
      set('#al-days', dayText(days));
      set(
        '#al-days-label',
        r.current
          ? `週年制：${zhDate(toISO(r.current.start))}至${zhDate(toISO(addDay(r.current.end, -1)))}可休（${r.current.label}）`
          : '週年制：到職未滿 6 個月，尚無特休',
      );
      set('#al-hours', `${formatNumber(days * 8, 1)} 小時`);
      set('#al-next', `${r.next.days} 天`);
      set('#al-next-label', `${zhDate(toISO(r.next.start))}（${r.next.label}）起`);
    } else {
      const r = calendarYearLeave(h, ref.y);
      if (!r) return fail('年度超出可計算範圍。');
      set('#al-days', dayText(r.total));
      set('#al-days-label', `曆年制：${ref.y} 年 1 月 1 日至 12 月 31 日可休`);
      set('#al-hours', `${formatNumber(r.total * 8, 1)} 小時`);
      const next = calendarYearLeave(h, ref.y + 1);
      set('#al-next', next ? dayText(next.total) : '—');
      set('#al-next-label', `${ref.y + 1} 年可休`);
      $('#al-shares', root).replaceChildren(
        ...r.shares.map((s) => {
          const tr = document.createElement('tr');
          tr.append(
            cell(`${s.period.label}（${toISO(s.period.start)} 起）`),
            cell(`${s.period.days} 天`, true),
            cell(`${formatNumber(s.fraction * 100, 2)}%`, true),
            cell(dayText(s.days), true),
          );
          return tr;
        }),
      );
    }

    const periods = leavePeriods(h, 26);
    $('#al-schedule', root).replaceChildren(
      ...periods
        .filter((p, i) => i < 6 || p.days !== periods[i - 1].days)
        .map((p) => {
          const tr = document.createElement('tr');
          if (compare(p.start, refForService) <= 0 && compare(refForService, p.end) < 0) tr.className = 'al-now';
          tr.append(cell(p.label), cell(toISO(p.start)), cell(`${p.days} 天`, true));
          return tr;
        }),
    );
  }

  function addDay(v: { y: number; m: number; d: number }, n: number) {
    const t = new Date(Date.UTC(v.y, v.m - 1, v.d + n));
    return { y: t.getUTCFullYear(), m: t.getUTCMonth() + 1, d: t.getUTCDate() };
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #al-output,
  .al-pay {
    display: grid;
    gap: 16px;
  }
  #al-output[hidden],
  .field[hidden] {
    display: none;
  }
  .al-pay {
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .al-pay > .label {
    font-weight: 600;
  }
  #al-schedule :global(.al-now td) {
    font-weight: 700;
    background: var(--accent-soft);
  }
</style>
