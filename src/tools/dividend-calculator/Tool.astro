<div class="tool" data-tool="dividend-calculator">
  <div class="grid-2">
    <div class="field">
      <div class="row between">
        <label for="dv-qty">持有數量</label>
        <div class="seg" role="radiogroup" aria-label="數量單位">
          <label><input type="radio" name="dv-unit" value="lot" checked /><span>張</span></label>
          <label><input type="radio" name="dv-unit" value="share" /><span>股</span></label>
        </div>
      </div>
      <input id="dv-qty" type="text" inputmode="decimal" autocomplete="off" value="10" />
    </div>
    <div class="field">
      <label for="dv-price">除權息前股價（元）</label>
      <input id="dv-price" type="text" inputmode="decimal" autocomplete="off" value="40" />
      <span class="hint">除權息交易日前一天的收盤價，或你的買進價。</span>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="dv-cash">每次每股現金股利（元）</label>
      <input id="dv-cash" type="text" inputmode="decimal" autocomplete="off" value="0.5" />
    </div>
    <div class="field">
      <label for="dv-stock">每次每股股票股利（元）</label>
      <input id="dv-stock" type="text" inputmode="decimal" autocomplete="off" value="0" />
      <span class="hint">配 1 元＝每 1,000 股配 100 股；ETF 填 0。</span>
    </div>
  </div>

  <div class="field">
    <span class="label">配息頻率</span>
    <div class="seg" role="radiogroup" aria-label="配息頻率">
      <label><input type="radio" name="dv-freq" value="1" /><span>年配</span></label>
      <label><input type="radio" name="dv-freq" value="2" /><span>半年配</span></label>
      <label><input type="radio" name="dv-freq" value="4" checked /><span>季配</span></label>
      <label><input type="radio" name="dv-freq" value="12" /><span>月配</span></label>
    </div>
  </div>

  <div class="field">
    <span class="label">綜所稅邊際稅率</span>
    <div class="seg" role="radiogroup" aria-label="綜所稅邊際稅率">
      <label><input type="radio" name="dv-bracket" value="5" /><span>5%</span></label>
      <label><input type="radio" name="dv-bracket" value="12" checked /><span>12%</span></label>
      <label><input type="radio" name="dv-bracket" value="20" /><span>20%</span></label>
      <label><input type="radio" name="dv-bracket" value="30" /><span>30%</span></label>
      <label><input type="radio" name="dv-bracket" value="40" /><span>40%</span></label>
    </div>
  </div>

  <div class="grid-3">
    <div class="field">
      <label for="dv-other">全戶其他股利（元／年）</label>
      <input id="dv-other" type="text" inputmode="numeric" autocomplete="off" value="0" />
    </div>
    <div class="field">
      <label for="dv-fee">每次匯費（元）</label>
      <input id="dv-fee" type="text" inputmode="numeric" autocomplete="off" value="10" />
    </div>
    <div class="field">
      <label for="dv-par">每股面額（元）</label>
      <input id="dv-par" type="text" inputmode="decimal" autocomplete="off" value="10" />
    </div>
  </div>

  <div class="notice error" id="dv-error" hidden></div>

  <div id="dv-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="dv-net">—</div>
      <div class="result-label" id="dv-net-label">單次實際入帳現金</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="dv-cashamt">—</span><span class="stat-label">單次現金股利</span></div>
      <div class="stat"><span class="stat-value" id="dv-nhi">—</span><span class="stat-label">二代健保補充保費</span></div>
      <div class="stat"><span class="stat-value" id="dv-newshares">—</span><span class="stat-label">配股股數</span></div>
      <div class="stat"><span class="stat-value" id="dv-ref">—</span><span class="stat-label">除權息參考價</span></div>
      <div class="stat"><span class="stat-value" id="dv-yield">—</span><span class="stat-label">單次現金殖利率</span></div>
      <div class="stat"><span class="stat-value" id="dv-fill">—</span><span class="stat-label">填權息需上漲</span></div>
    </div>

    <div class="field">
      <span class="label" id="dv-annual-title">全年合計</span>
      <div class="stats">
        <div class="stat"><span class="stat-value" id="dv-ayield">—</span><span class="stat-label">年化現金殖利率</span></div>
        <div class="stat"><span class="stat-value" id="dv-acash">—</span><span class="stat-label">全年現金股利</span></div>
        <div class="stat"><span class="stat-value" id="dv-anhi">—</span><span class="stat-label">全年補充保費</span></div>
        <div class="stat"><span class="stat-value" id="dv-anet">—</span><span class="stat-label">全年實際入帳</span></div>
      </div>
    </div>

    <p class="notice" id="dv-nhi-note" hidden></p>

    <div class="field">
      <span class="label">股利所得稅：合併計稅 vs 分開計稅</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>申報方式</th><th class="num">股利應負擔稅額</th></tr>
          </thead>
          <tbody>
            <tr id="dv-row-combined"><td>合併計稅（扣 8.5% 抵減 <span id="dv-credit">—</span>）</td><td class="num" id="dv-combined">—</td></tr>
            <tr id="dv-row-separate"><td>分開計稅（28%）</td><td class="num" id="dv-separate">—</td></tr>
          </tbody>
        </table>
      </div>
      <p class="hint" id="dv-tax-verdict"></p>
    </div>
  </div>

  <p class="hint">補充保費：單次股利（現金＋股票股利面額）達 20,000 元扣 2.11%，單次上限以 1,000 萬元計。稅額比較以全年股利（本筆年化＋全戶其他股利）乘以所選邊際稅率簡化估算，負數代表可抵減其他所得稅或退稅。結果僅供參考，不構成投資建議，報稅請以財政部報稅軟體為準；資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { FREQUENCY_LABELS, calculateDividend, validateDividend, type DividendInput, type Frequency } from './logic';

  const KEY = 'dividend-calculator';
  const root = $('[data-tool="dividend-calculator"]');
  const ids = ['qty', 'price', 'cash', 'stock', 'other', 'fee', 'par'] as const;
  type Id = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((id) => [id, $<HTMLInputElement>(`#dv-${id}`, root)])) as Record<Id, HTMLInputElement>;
  const units = $$<HTMLInputElement>('input[name="dv-unit"]', root);
  const freqs = $$<HTMLInputElement>('input[name="dv-freq"]', root);
  const brackets = $$<HTMLInputElement>('input[name="dv-bracket"]', root);
  const error = $('#dv-error', root);
  const output = $('#dv-output', root);
  const nhiNote = $('#dv-nhi-note', root);

  const prefs = loadPref<Partial<Record<Id | 'unit' | 'freq' | 'bracket', string>>>(KEY, {});
  for (const id of ids) if (prefs[id] !== undefined) inputs[id].value = prefs[id]!;
  const restore = (list: HTMLInputElement[], value?: string) => {
    if (value && list.some((x) => x.value === value)) for (const x of list) x.checked = x.value === value;
  };
  restore(units, prefs.unit);
  restore(freqs, prefs.freq);
  restore(brackets, prefs.bracket);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const pct = (n: number) => `${formatNumber(n, 2)}%`;
  const num = (id: Id, fallback = 0) => (inputs[id].value.trim() === '' ? fallback : parseNumber(inputs[id].value));
  const checked = (list: HTMLInputElement[], fallback: string) => list.find((x) => x.checked)?.value ?? fallback;
  const set = (sel: string, text: string) => {
    $(sel, root).textContent = text;
  };

  function render() {
    const unit = checked(units, 'lot');
    const freq = Number(checked(freqs, '4')) as Frequency;
    const bracket = Number(checked(brackets, '12'));
    savePref(KEY, { ...Object.fromEntries(ids.map((id) => [id, inputs[id].value])), unit, freq: String(freq), bracket: String(bracket) });

    const qty = parseNumber(inputs.qty.value);
    const input: DividendInput = {
      shares: unit === 'lot' ? Math.round(qty * 1000 * 1000) / 1000 : qty,
      cashPerShare: num('cash'),
      stockPerShare: num('stock'),
      price: parseNumber(inputs.price.value),
      parValue: num('par', 10),
      frequency: freq,
      bracketPct: bracket,
      remittanceFee: num('fee'),
      otherAnnualDividend: num('other'),
    };
    const problem = validateDividend(input);
    if (problem) {
      error.textContent = problem;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    const r = calculateDividend(input);
    set('#dv-net', money(r.netCash));
    set('#dv-net-label', `單次實際入帳現金（已扣補充保費與匯費，${FREQUENCY_LABELS[freq]}）`);
    set('#dv-cashamt', money(r.cashAmount));
    set('#dv-nhi', money(r.nhiPremium));
    set('#dv-newshares', r.newShares > 0 || r.fractionCash > 0 ? `${formatInteger(r.newShares)} 股` : '—');
    set('#dv-ref', `${formatNumber(r.referencePrice, 2)} 元`);
    set('#dv-yield', pct(r.cashYieldPct));
    set('#dv-fill', pct(r.fillRisePct));
    set('#dv-annual-title', `全年合計（${FREQUENCY_LABELS[freq]}，一年 ${freq} 次）`);
    set('#dv-ayield', pct(r.annualCashYieldPct));
    set('#dv-acash', money(r.annualCash));
    set('#dv-anhi', money(r.annualNhi));
    set('#dv-anet', money(r.annualNetCash));

    const notes: string[] = [];
    if (r.dividendIncome < 20_000)
      notes.push(`單次股利 ${money(r.dividendIncome)}，未達 20,000 元門檻，不扣補充保費。`);
    if (r.stockDividendValue > 0)
      notes.push(`股票股利以面額計 ${money(r.stockDividendValue)} 併入股利所得與補充保費計算${r.fractionCash > 0 ? `；不足一股的部分約折發現金 ${money(r.fractionCash)}` : ''}，除權後共持有 ${formatInteger(r.sharesAfter)} 股。`);
    if (r.nhiBilledSeparately) notes.push('現金股利不足以扣繳補充保費，差額由健保署另行開單收取。');
    nhiNote.textContent = notes.join('');
    nhiNote.hidden = notes.length === 0;

    const t = r.tax;
    set('#dv-credit', money(t.credit));
    set('#dv-combined', t.combinedTax < 0 ? `可退稅 ${money(-t.combinedTax)}` : money(t.combinedTax));
    set('#dv-separate', money(t.separateTax));
    $('#dv-row-combined', root).classList.toggle('dv-best', t.better === 'combined');
    $('#dv-row-separate', root).classList.toggle('dv-best', t.better === 'separate');
    set(
      '#dv-tax-verdict',
      t.better === 'equal'
        ? `全年股利 ${money(t.dividendIncome)}，兩種方式稅額相同。`
        : `全年股利 ${money(t.dividendIncome)}，選擇${t.better === 'combined' ? '合併計稅' : '分開計稅'}約可少繳 ${money(t.saving)}。`,
    );
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #dv-output {
    display: grid;
    gap: 16px;
  }
  #dv-output[hidden] {
    display: none;
  }
  .row > label[for] {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .dv-best td {
    background: var(--accent-soft);
    font-weight: 600;
  }
  #dv-output .table td:first-child {
    white-space: normal;
  }
</style>
