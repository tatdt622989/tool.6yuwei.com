<div class="tool" data-tool="json-formatter">
  <div class="field">
    <label for="jf-input">輸入 JSON</label>
    <textarea
      id="jf-input"
      class="mono"
      rows="12"
      spellcheck="false"
      autocomplete="off"
      placeholder='貼上 JSON，例如 {"name": "王小明", "tags": ["a", "b"]}'></textarea>
  </div>

  <div class="row">
    <div class="seg" role="radiogroup" aria-label="輸出模式">
      <label><input type="radio" name="jf-mode" value="format" checked /><span>格式化</span></label>
      <label><input type="radio" name="jf-mode" value="minify" /><span>壓縮</span></label>
    </div>
    <div class="seg" role="radiogroup" aria-label="縮排" id="jf-indent">
      <label><input type="radio" name="jf-indent" value="2" checked /><span>2 空格</span></label>
      <label><input type="radio" name="jf-indent" value="4" /><span>4 空格</span></label>
      <label><input type="radio" name="jf-indent" value="tab" /><span>Tab</span></label>
    </div>
    <label class="check"><input type="checkbox" id="jf-sort" /> 依鍵名排序</label>
  </div>

  <div id="jf-status" class="notice" aria-live="polite">貼上 JSON 後會即時驗證並輸出結果。</div>
  <pre id="jf-excerpt" class="output jf-excerpt" hidden></pre>

  <div class="field">
    <label for="jf-output">結果</label>
    <textarea id="jf-output" class="mono" rows="12" readonly spellcheck="false"></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#jf-output">複製結果</button>
    <button class="btn" type="button" id="jf-download">下載 .json</button>
    <button class="btn ghost" type="button" id="jf-sample">載入範例</button>
    <button class="btn ghost" type="button" id="jf-clear">清除</button>
  </div>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger } from '../../lib/format';
  import { errorExcerpt, formatValue, minifyValue, parseJson, summarize, type Indent } from './logic';

  interface Prefs {
    mode: 'format' | 'minify';
    indent: Indent;
    sortKeys: boolean;
  }

  const root = $('[data-tool="json-formatter"]');
  const input = $<HTMLTextAreaElement>('#jf-input', root);
  const output = $<HTMLTextAreaElement>('#jf-output', root);
  const status = $('#jf-status', root);
  const excerpt = $('#jf-excerpt', root);
  const indentSeg = $('#jf-indent', root);
  const sort = $<HTMLInputElement>('#jf-sort', root);
  const modeRadios = $$<HTMLInputElement>('input[name="jf-mode"]', root);
  const indentRadios = $$<HTMLInputElement>('input[name="jf-indent"]', root);

  const SAMPLE = '{"name":"王小明","age":30,"email":"ming@example.com","active":true,"tags":["admin","editor"],"address":{"city":"台北市","zip":"100"},"lastLogin":null}';
  const encoder = new TextEncoder();

  function readPrefs(): Prefs {
    return {
      mode: (modeRadios.find((r) => r.checked)?.value ?? 'format') as Prefs['mode'],
      indent: (indentRadios.find((r) => r.checked)?.value ?? '2') as Indent,
      sortKeys: sort.checked,
    };
  }

  function applyPrefs(p: Prefs) {
    modeRadios.forEach((r) => (r.checked = r.value === p.mode));
    indentRadios.forEach((r) => (r.checked = r.value === p.indent));
    sort.checked = p.sortKeys;
  }

  function setStatus(kind: '' | 'ok' | 'error', text: string) {
    status.className = kind ? `notice ${kind}` : 'notice';
    status.textContent = text;
  }

  function render() {
    const prefs = readPrefs();
    savePref('json-formatter', prefs);
    indentSeg.style.display = prefs.mode === 'minify' ? 'none' : '';
    excerpt.hidden = true;

    if (input.value.trim() === '') {
      output.value = '';
      setStatus('', '貼上 JSON 後會即時驗證並輸出結果。');
      return;
    }

    const parsed = parseJson(input.value);
    if (!parsed.ok) {
      const { line, column, message } = parsed.error;
      output.value = '';
      setStatus('error', `第 ${line} 行第 ${column} 欄：${message}`);
      excerpt.textContent = errorExcerpt(input.value, line, column);
      excerpt.hidden = false;
      return;
    }

    output.value =
      prefs.mode === 'minify' ? minifyValue(parsed.value, prefs.sortKeys) : formatValue(parsed.value, prefs);
    const info = summarize(parsed.value);
    const shape = info.depth > 0 ? `${info.type}，${formatInteger(info.size)} 個成員，深度 ${info.depth}` : info.type;
    const sizes = `${formatBytes(encoder.encode(input.value).length)} → ${formatBytes(encoder.encode(output.value).length)}`;
    setStatus('ok', `有效的 JSON：${shape}。大小 ${sizes}`);
  }

  applyPrefs(loadPref<Prefs>('json-formatter', { mode: 'format', indent: '2', sortKeys: false }));
  input.addEventListener('input', debounce(render, 120));
  [...modeRadios, ...indentRadios, sort].forEach((el) => el.addEventListener('change', render));

  $('#jf-download', root).addEventListener('click', () => {
    if (!output.value) return;
    const name = readPrefs().mode === 'minify' ? 'minified.json' : 'formatted.json';
    downloadBlob(new Blob([output.value], { type: 'application/json' }), name);
  });
  $('#jf-sample', root).addEventListener('click', () => {
    input.value = SAMPLE;
    render();
  });
  $('#jf-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  .jf-excerpt {
    margin: 0;
    overflow-x: auto;
    white-space: pre;
    color: var(--danger);
  }
</style>
