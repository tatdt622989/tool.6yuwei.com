---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="json-formatter" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="jf-input">{s.inputLabel}</label>
    <textarea
      id="jf-input"
      class="mono"
      rows="12"
      spellcheck="false"
      autocomplete="off"
      placeholder={s.placeholder}></textarea>
  </div>

  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="jf-mode" value="format" checked /><span>{s.format}</span></label>
      <label><input type="radio" name="jf-mode" value="minify" /><span>{s.minify}</span></label>
    </div>
    <div class="seg" role="radiogroup" aria-label={s.indentAria} id="jf-indent">
      <label><input type="radio" name="jf-indent" value="2" checked /><span>{s.spaces2}</span></label>
      <label><input type="radio" name="jf-indent" value="4" /><span>{s.spaces4}</span></label>
      <label><input type="radio" name="jf-indent" value="tab" /><span>{s.tab}</span></label>
    </div>
    <label class="check"><input type="checkbox" id="jf-sort" /> {s.sortKeys}</label>
  </div>

  <div id="jf-status" class="notice" aria-live="polite">{s.client.idle}</div>
  <pre id="jf-excerpt" class="output jf-excerpt" hidden></pre>

  <div class="field">
    <label for="jf-output">{s.outputLabel}</label>
    <textarea id="jf-output" class="mono" rows="12" readonly spellcheck="false"></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#jf-output">{s.copy}</button>
    <button class="btn" type="button" id="jf-download">{s.download}</button>
    <button class="btn ghost" type="button" id="jf-sample">{s.sample}</button>
    <button class="btn ghost" type="button" id="jf-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes } from '../../lib/format';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import {
    describeJsonError,
    errorExcerpt,
    formatValue,
    jsonKind,
    minifyValue,
    parseJson,
    summarize,
    type Indent,
  } from './logic';
  import type { Strings } from './i18n';

  interface Prefs {
    mode: 'format' | 'minify';
    indent: Indent;
    sortKeys: boolean;
  }

  const root = $('[data-tool="json-formatter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#jf-input', root);
  const output = $<HTMLTextAreaElement>('#jf-output', root);
  const status = $('#jf-status', root);
  const excerpt = $('#jf-excerpt', root);
  const indentSeg = $('#jf-indent', root);
  const sort = $<HTMLInputElement>('#jf-sort', root);
  const modeRadios = $$<HTMLInputElement>('input[name="jf-mode"]', root);
  const indentRadios = $$<HTMLInputElement>('input[name="jf-indent"]', root);

  const encoder = new TextEncoder();

  function readPrefs(): Prefs {
    return {
      mode: (modeRadios.find((r) => r.checked)?.value ?? 'format') as Prefs['mode'],
      indent: (indentRadios.find((r) => r.checked)?.value ?? '2') as Indent,
      sortKeys: sort.checked,
    };
  }

  function applyPrefs(p: Prefs) {
    modeRadios.forEach((r) => (r.checked = r.value === p.mode));
    indentRadios.forEach((r) => (r.checked = r.value === p.indent));
    sort.checked = p.sortKeys;
  }

  function setStatus(kind: '' | 'ok' | 'error', text: string) {
    status.className = kind ? `notice ${kind}` : 'notice';
    status.textContent = text;
  }

  function render() {
    const prefs = readPrefs();
    savePref('json-formatter', prefs);
    indentSeg.style.display = prefs.mode === 'minify' ? 'none' : '';
    excerpt.hidden = true;

    if (input.value.trim() === '') {
      output.value = '';
      setStatus('', s.idle);
      return;
    }

    const parsed = parseJson(input.value);
    if (!parsed.ok) {
      const { line, column } = parsed.error;
      output.value = '';
      setStatus('error', t(s.errorAt, { line, column, message: describeJsonError(parsed.error, s.errors) }));
      excerpt.textContent = errorExcerpt(input.value, line, column);
      excerpt.hidden = false;
      return;
    }

    output.value =
      prefs.mode === 'minify' ? minifyValue(parsed.value, prefs.sortKeys) : formatValue(parsed.value, prefs);
    const info = summarize(parsed.value);
    const type = s.kinds[jsonKind(parsed.value)];
    const shape =
      info.depth > 0
        ? t(s.shapeNested, { type, members: plural(locale, info.size, s.members), depth: info.depth })
        : type;
    const sizes = `${formatBytes(encoder.encode(input.value).length, locale)} → ${formatBytes(encoder.encode(output.value).length, locale)}`;
    setStatus('ok', t(s.valid, { shape, sizes }));
  }

  applyPrefs(loadPref<Prefs>('json-formatter', { mode: 'format', indent: '2', sortKeys: false }));
  input.addEventListener('input', debounce(render, 120));
  [...modeRadios, ...indentRadios, sort].forEach((el) => el.addEventListener('change', render));

  $('#jf-download', root).addEventListener('click', () => {
    if (!output.value) return;
    const name = readPrefs().mode === 'minify' ? 'minified.json' : 'formatted.json';
    downloadBlob(new Blob([output.value], { type: 'application/json' }), name);
  });
  $('#jf-sample', root).addEventListener('click', () => {
    input.value = s.sample;
    render();
  });
  $('#jf-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  .jf-excerpt {
    margin: 0;
    overflow-x: auto;
    white-space: pre;
    color: var(--danger);
  }
</style>
