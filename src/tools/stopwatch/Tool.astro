---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="stopwatch" {...i18nAttrs(locale, s.client)}>
  <div class="sw-face">
    <div class="big-display" id="sw-display" role="timer" aria-label={s.displayAria}>
      <span id="sw-main">00:00</span><span class="sw-frac" id="sw-frac">.00</span>
    </div>
    <div class="sw-current mono" id="sw-current" hidden></div>
  </div>

  <div class="sw-controls">
    <button class="btn primary" type="button" id="sw-toggle">{s.client.start}</button>
    <button class="btn" type="button" id="sw-lap" disabled>{s.lap}</button>
    <button class="btn" type="button" id="sw-reset" disabled>{s.reset}</button>
  </div>

  <p class="hint sw-keys">{`\n${s.keysLabel}`}<kbd>{s.spaceKey}</kbd>{s.keyToggle}<kbd>L</kbd>{s.keyLap}<kbd>R</kbd>{`${s.keyReset}\n`}</p>

  <div class="field" id="sw-laps-field" hidden>
    <span class="label">{s.lapsLabel}</span>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>{s.client.columns[0]}</th>
            <th class="num">{s.client.columns[1]}</th>
            <th class="num">{s.client.columns[2]}</th>
          </tr>
        </thead>
        <tbody id="sw-laps"></tbody>
      </table>
    </div>
    <div class="row">
      <button class="btn small" type="button" id="sw-copy">{s.copy}</button>
    </div>
  </div>
</div>

<script>
  import { $, copyText, flashButton, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import type { Strings } from './i18n';
  import {
    currentLap,
    elapsed,
    formatStopwatch,
    formatStopwatchParts,
    isRunning,
    lap,
    lapRows,
    lapsToText,
    reset,
    restoreState,
    toggle,
    type StopwatchState,
  } from './logic';

  const PREF_KEY = 'stopwatch-state';
  const root = $('[data-tool="stopwatch"]');
  const { s } = readI18n<Strings['client']>(root);
  const mainEl = $('#sw-main', root);
  const fracEl = $('#sw-frac', root);
  const currentEl = $('#sw-current', root);
  const toggleBtn = $<HTMLButtonElement>('#sw-toggle', root);
  const lapBtn = $<HTMLButtonElement>('#sw-lap', root);
  const resetBtn = $<HTMLButtonElement>('#sw-reset', root);
  const lapsField = $('#sw-laps-field', root);
  const lapsBody = $('#sw-laps', root);
  const baseTitle = document.title;

  // Date.now() (not performance.now()) so a saved running state survives a reload.
  let state: StopwatchState = restoreState(loadPref<unknown>(PREF_KEY, null), Date.now());
  let raf = 0;
  let titleTimer: number | undefined;
  let lastTitle = '';

  function renderTime() {
    const now = Date.now();
    const total = elapsed(state, now);
    const parts = formatStopwatchParts(total);
    mainEl.textContent = parts.main;
    fracEl.textContent = parts.fraction;
    if (state.splits.length > 0) {
      currentEl.textContent = t(s.current, { n: state.splits.length + 1, t: formatStopwatch(currentLap(state, now)) });
    }
    const title = isRunning(state) ? t(s.title, { t: parts.main }) : baseTitle;
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function renderLaps() {
    const rows = lapRows(state.splits);
    lapsField.hidden = rows.length === 0;
    currentEl.hidden = rows.length === 0;
    lapsBody.replaceChildren(
      ...rows.reverse().map((row) => {
        const tr = document.createElement('tr');
        if (row.tag) tr.dataset.tag = row.tag;
        const index = document.createElement('td');
        index.textContent = String(row.index);
        if (row.tag) {
          const tag = document.createElement('span');
          tag.className = 'sw-tag';
          tag.textContent = row.tag === 'fastest' ? s.fastest : s.slowest;
          index.append(' ', tag);
        }
        const lapCell = document.createElement('td');
        lapCell.className = 'num mono';
        lapCell.textContent = formatStopwatch(row.lap);
        const splitCell = document.createElement('td');
        splitCell.className = 'num mono';
        splitCell.textContent = formatStopwatch(row.split);
        tr.append(index, lapCell, splitCell);
        return tr;
      }),
    );
  }

  function renderControls() {
    const running = isRunning(state);
    const hasTime = elapsed(state, Date.now()) > 0;
    toggleBtn.textContent = running ? s.pause : hasTime ? s.resume : s.start;
    lapBtn.disabled = !running;
    resetBtn.disabled = !running && !hasTime;
  }

  function frame() {
    renderTime();
    raf = isRunning(state) && !document.hidden ? requestAnimationFrame(frame) : 0;
  }

  function sync() {
    cancelAnimationFrame(raf);
    window.clearInterval(titleTimer);
    titleTimer = undefined;
    if (isRunning(state)) {
      frame();
      // rAF pauses in background tabs; this keeps the tab title ticking.
      titleTimer = window.setInterval(renderTime, 1000);
    } else {
      renderTime();
    }
    renderControls();
  }

  function update(next: StopwatchState) {
    if (next === state) return;
    const lapsChanged = next.splits !== state.splits;
    state = next;
    savePref(PREF_KEY, state);
    if (lapsChanged) renderLaps();
    sync();
  }

  const actions = {
    toggle: () => update(toggle(state, Date.now())),
    lap: () => update(lap(state, Date.now())),
    reset: () => update(reset()),
  };

  toggleBtn.addEventListener('click', actions.toggle);
  lapBtn.addEventListener('click', actions.lap);
  resetBtn.addEventListener('click', actions.reset);

  $('#sw-copy', root).addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLElement;
    if (await copyText(lapsToText(state.splits, s.columns))) flashButton(button);
  });

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    const key = event.key.toLowerCase();
    if (key === ' ') {
      // Space on a focused button or link already activates it; don't double-trigger.
      if (target?.closest('button, a, summary, [role="button"]')) return;
      event.preventDefault();
      actions.toggle();
    } else if (key === 'l') {
      actions.lap();
    } else if (key === 'r') {
      actions.reset();
    }
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) sync();
  });

  renderLaps();
  sync();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .sw-face {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 12px 0 4px;
  }
  .sw-frac {
    font-size: 0.55em;
    color: var(--text-2);
  }
  .sw-current {
    color: var(--muted);
  }
  .sw-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
  }
  .sw-controls .btn {
    min-height: 48px;
    font-size: 16px;
  }
  .sw-keys {
    margin: 0;
    text-align: center;
  }
  kbd {
    display: inline-block;
    padding: 1px 6px;
    font-size: 12px;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
  }
  #sw-laps :global(.sw-tag) {
    display: inline-block;
    margin-left: 4px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    background: var(--surface-2);
  }
  #sw-laps :global(tr[data-tag='fastest'] .sw-tag),
  #sw-laps :global(tr[data-tag='fastest'] td:nth-child(2)) {
    color: var(--success);
  }
  #sw-laps :global(tr[data-tag='slowest'] .sw-tag),
  #sw-laps :global(tr[data-tag='slowest'] td:nth-child(2)) {
    color: var(--danger);
  }
</style>
