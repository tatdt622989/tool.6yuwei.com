---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const FLAGS = s.flags;
const CHEATSHEET = s.cheatsheet;
const REPLACEMENTS = s.replacements;
---

<div class="tool" data-tool="regex-tester" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="rx-pattern">{s.patternLabel}</label>
    <div class="rx-pattern">
      <span class="rx-slash" aria-hidden="true">/</span>
      <input id="rx-pattern" type="text" class="mono" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={s.patternPlaceholder} />
      <span class="rx-slash mono" aria-hidden="true">/<span id="rx-flag-text"></span></span>
    </div>
  </div>

  <fieldset class="rx-flags">
    <legend class="visually-hidden">{s.flagsLegend}</legend>
    {
      FLAGS.map(({ flag, label, title }) => (
        <label class="check" title={title}>
          <input type="checkbox" name="rx-flag" value={flag} checked={flag === 'g'} />
          <span>
            <code>{flag}</code> {label}
          </span>
        </label>
      ))
    }
  </fieldset>

  <div id="rx-error" class="notice error" role="alert" hidden></div>

  <div class="field">
    <label for="rx-text">{s.textLabel}</label>
    <textarea id="rx-text" rows="7" spellcheck="false" placeholder={s.textPlaceholder}></textarea>
  </div>

  <div class="field">
    <span class="label" id="rx-count">{s.client.resultLabel}</span>
    <div class="output rx-highlight" id="rx-highlight" aria-live="polite"></div>
  </div>

  <div class="field" id="rx-list-wrap" hidden>
    <span class="label">{s.listLabel}</span>
    <div class="table-wrap rx-list">
      <table class="table">
        <thead><tr><th class="num">#</th><th class="num">{s.colPosition}</th><th>{s.colMatch}</th><th>{s.colGroups}</th></tr></thead>
        <tbody id="rx-list"></tbody>
      </table>
    </div>
    <span class="hint" id="rx-list-note"></span>
  </div>

  <div class="field">
    <label for="rx-replace">{s.replaceLabel}</label>
    <input id="rx-replace" type="text" class="mono" spellcheck="false" autocomplete="off" placeholder={s.replacePlaceholder} />
  </div>
  <div class="field" id="rx-replaced-wrap" hidden>
    <div class="rx-head">
      <span class="label">{s.replacedLabel}</span>
      <button class="btn small" type="button" data-copy="#rx-replaced">{s.copy}</button>
    </div>
    <div class="output" id="rx-replaced"></div>
  </div>

  <div class="row">
    <button class="btn ghost" type="button" id="rx-sample">{s.sample}</button>
    <button class="btn ghost" type="button" id="rx-clear">{s.clear}</button>
  </div>

  <details class="rx-cheat" open>
    <summary>{s.cheatSummary}</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>{s.colSyntax}</th><th>{s.colMeaning}</th><th>{s.colExample}</th></tr></thead>
        <tbody>
          {
            CHEATSHEET.map(([syntax, meaning, example]) => (
              <tr>
                <td><code>{syntax}</code></td>
                <td>{meaning}</td>
                <td><code>{example}</code></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>{s.colReplaceSyntax}</th><th>{s.colReplaceMeaning}</th></tr></thead>
        <tbody>
          {
            REPLACEMENTS.map(([syntax, meaning]) => (
              <tr>
                <td><code>{syntax}</code></td>
                <td>{meaning}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { describeGroups, escapeHtml, formatMessage, highlight, MAX_MATCHES, run, type RunRequest, type RunResponse } from './logic';
  import type { Strings } from './i18n';

  const TIMEOUT_MS = 1500;
  const MAX_ROWS = 200;

  const root = $('[data-tool="regex-tester"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const pattern = $<HTMLInputElement>('#rx-pattern', root);
  const text = $<HTMLTextAreaElement>('#rx-text', root);
  const replace = $<HTMLInputElement>('#rx-replace', root);
  const flagBoxes = $$<HTMLInputElement>('input[name="rx-flag"]', root);
  const flagText = $('#rx-flag-text', root);
  const error = $('#rx-error', root);
  const count = $('#rx-count', root);
  const highlighted = $('#rx-highlight', root);
  const listWrap = $('#rx-list-wrap', root);
  const list = $('#rx-list', root);
  const listNote = $('#rx-list-note', root);
  const replacedWrap = $('#rx-replaced-wrap', root);
  const replaced = $('#rx-replaced', root);

  interface Prefs {
    pattern: string;
    flags: string;
    text: string;
    replacement: string;
  }

  const SAMPLE: Prefs = {
    pattern: '(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})',
    flags: 'g',
    text: s.sampleText,
    replacement: s.sampleReplacement,
  };

  const readRequest = (): RunRequest => ({
    pattern: pattern.value,
    flags: flagBoxes.filter((b) => b.checked).map((b) => b.value).join(''),
    text: text.value,
    replacement: replace.value,
    messages: s.messages,
  });

  function apply(p: Prefs) {
    pattern.value = p.pattern;
    text.value = p.text;
    replace.value = p.replacement;
    flagBoxes.forEach((b) => (b.checked = p.flags.includes(b.value)));
  }

  function resetOutput(message: string) {
    count.textContent = s.resultLabel;
    highlighted.innerHTML = message ? `<span class="muted">${escapeHtml(message)}</span>` : escapeHtml(text.value);
    listWrap.hidden = true;
    replacedWrap.hidden = true;
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = false;
    resetOutput('');
  }

  function show(req: RunRequest, res: RunResponse) {
    if (!res.ok) return showError(res.error);
    error.hidden = true;
    const n = res.matches.length;
    count.textContent =
      n === 0 ? s.noMatch : t(s.matches, { n: formatInteger(n, locale), truncated: res.truncated ? s.truncated : '' });
    highlighted.innerHTML = req.text
      ? highlight(req.text, res.matches)
      : `<span class="muted">${escapeHtml(s.emptyHint)}</span>`;

    const rows = res.matches.slice(0, MAX_ROWS).map((m, i) => {
      const tr = document.createElement('tr');
      const cells = [String(i + 1), `${m.index}–${m.end}`, m.text === '' ? s.emptyString : m.text, describeGroups(m, s.messages.unset) || '—'];
      cells.forEach((value, c) => {
        const td = document.createElement('td');
        td.textContent = value;
        if (c < 2) td.className = 'num';
        if (c >= 2) td.className = 'mono';
        tr.append(td);
      });
      return tr;
    });
    list.replaceChildren(...rows);
    listWrap.hidden = n === 0;
    listNote.textContent = res.truncated
      ? t(s.noteTruncated, { max: formatInteger(MAX_MATCHES, locale), rows: MAX_ROWS })
      : n > MAX_ROWS
        ? t(s.noteRows, { rows: MAX_ROWS })
        : s.noteIndex;

    replacedWrap.hidden = req.replacement === '' || req.text === '';
    replaced.textContent = res.replaced;
  }

  // ---- Worker with timeout: a catastrophic pattern freezes only the worker, which we terminate. ----
  let worker: Worker | null = null;
  let workerUnavailable = typeof Worker === 'undefined';
  let pending = false;
  let seq = 0;
  let timer: number | undefined;
  let lastRequest: RunRequest | null = null;

  function spawn(): Worker | null {
    if (workerUnavailable) return null;
    try {
      const w = new Worker(new URL('./worker.ts', import.meta.url), { type: 'module' });
      w.addEventListener('message', (e: MessageEvent<{ id: number; result: RunResponse }>) => {
        if (e.data.id !== seq || !lastRequest) return;
        pending = false;
        window.clearTimeout(timer);
        show(lastRequest, e.data.result);
      });
      w.addEventListener('error', () => {
        workerUnavailable = true;
        w.terminate();
        worker = null;
        pending = false;
        execute();
      });
      return w;
    } catch {
      workerUnavailable = true;
      return null;
    }
  }

  function execute() {
    const req = readRequest();
    savePref('regex-tester', { ...req, text: req.text.slice(0, 5000) });
    flagText.textContent = req.flags;
    window.clearTimeout(timer);
    const id = ++seq;
    lastRequest = req;
    if (req.pattern === '') {
      error.hidden = true;
      resetOutput('');
      return;
    }
    if (pending && worker) {
      worker.terminate();
      worker = null;
    }
    worker ??= spawn();
    if (!worker) {
      // Fallback without a worker: still capped by MAX_MATCHES, but cannot be interrupted.
      try {
        show(req, run(req));
      } catch (err) {
        showError(formatMessage(s.messages.failed, { message: (err as Error).message }));
      }
      return;
    }
    pending = true;
    worker.postMessage({ id, ...req });
    timer = window.setTimeout(() => {
      worker?.terminate();
      worker = null;
      pending = false;
      showError(t(s.timeout, { s: TIMEOUT_MS / 1000 }));
    }, TIMEOUT_MS);
  }

  apply(loadPref<Prefs>('regex-tester', SAMPLE));
  const onInput = debounce(execute, 150);
  [pattern, text, replace].forEach((el) => el.addEventListener('input', onInput));
  flagBoxes.forEach((b) => b.addEventListener('change', execute));
  $('#rx-sample', root).addEventListener('click', () => {
    apply(SAMPLE);
    execute();
  });
  $('#rx-clear', root).addEventListener('click', () => {
    apply({ pattern: '', flags: 'g', text: '', replacement: '' });
    execute();
    pattern.focus();
  });
  execute();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .rx-pattern {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rx-pattern input {
    flex: 1;
    font-size: 16px;
  }
  .rx-slash {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--muted);
  }
  .rx-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .rx-flags code {
    font-weight: 700;
  }
  .rx-highlight {
    max-height: 320px;
    overflow: auto;
  }
  .rx-highlight :global(mark) {
    color: inherit;
    background: color-mix(in oklab, var(--accent) 28%, transparent);
    border-radius: 3px;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .rx-highlight :global(mark.alt) {
    background: color-mix(in oklab, var(--warning) 30%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--warning) 50%, transparent);
  }
  .rx-list {
    max-height: 360px;
    overflow: auto;
  }
  .rx-list :global(td.mono) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    min-width: 120px;
  }
  .rx-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .rx-cheat {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    min-width: 0;
  }
  .rx-cheat summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }
  .rx-cheat .table-wrap + .table-wrap {
    margin-top: 12px;
  }
  .rx-cheat td {
    white-space: normal;
  }
  .rx-cheat td:first-child {
    white-space: nowrap;
  }
</style>
