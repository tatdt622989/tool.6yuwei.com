---
const FLAGS = [
  { flag: 'g', label: '全域', title: '找出所有符合，而不只第一個' },
  { flag: 'i', label: '忽略大小寫', title: '不區分大小寫' },
  { flag: 'm', label: '多行', title: '^ 與 $ 比對每一行的開頭與結尾' },
  { flag: 's', label: 'dotAll', title: '讓 . 也能比對換行' },
  { flag: 'u', label: 'Unicode', title: '以 Unicode 碼位處理，可用 \\p{…}' },
  { flag: 'y', label: '黏著', title: '只從 lastIndex 位置開始比對' },
];

const CHEATSHEET: [string, string, string][] = [
  ['.', '任意一個字元（不含換行，加 s 旗標才包含）', 'a.c 符合 abc、a1c'],
  ['\\d　\\D', '數字 0–9／非數字', '\\d{3} 符合 123'],
  ['\\w　\\W', '英數字與底線／其他字元', '\\w+ 符合 user_01'],
  ['\\s　\\S', '空白字元（空格、Tab、換行）／非空白', 'a\\sb 符合 a b'],
  ['\\b', '單字邊界（只對英數字有效）', '\\bcat\\b 不符合 category'],
  ['^　$', '開頭／結尾（加 m 旗標時為每一行）', '^\\d+$ 整行都是數字'],
  ['[abc]　[^abc]', '其中一個字元／以外的字元', '[aeiou] 母音'],
  ['[a-z0-9]', '字元範圍', '[A-F0-9] 十六進位'],
  ['*　+　?', '0 次以上／1 次以上／0 或 1 次', 'colou?r 符合 color、colour'],
  ['{n}　{n,}　{n,m}', '剛好 n 次／至少 n 次／n 到 m 次', '\\d{2,4}'],
  ['*?　+?', '非貪婪：盡可能少比對', '<.+?> 只比對一個標籤'],
  ['(abc)', '擷取群組，可用 $1 參照', '(\\d+)-(\\d+)'],
  ['(?:abc)', '只分組不擷取', '(?:ab)+'],
  ['(?<name>abc)', '具名群組，可用 $<name> 參照', '(?<year>\\d{4})'],
  ['a|b', '或', 'cat|dog'],
  ['(?=abc)　(?!abc)', '正向／負向先行斷言', '\\d+(?=元) 只取金額數字'],
  ['(?<=abc)　(?<!abc)', '正向／負向後行斷言', '(?<=\\$)\\d+'],
  ['\\1', '反向參照第 1 個群組', '(\\w)\\1 符合 aa、ll'],
  ['\\p{Script=Han}', '中文字（需要 u 旗標）', '\\p{Script=Han}+'],
  ['\\u4e00　\\x41', 'Unicode／十六進位字元', '[\\u4e00-\\u9fff]'],
];

const REPLACEMENTS: [string, string][] = [
  ['$1、$2…', '第 n 個擷取群組'],
  ['$<name>', '具名群組'],
  ['$&', '整個符合的文字'],
  ['$`　$\'', '符合位置之前／之後的文字'],
  ['$$', '一個 $ 符號'],
];
---

<div class="tool" data-tool="regex-tester">
  <div class="field">
    <label for="rx-pattern">正規表達式</label>
    <div class="rx-pattern">
      <span class="rx-slash" aria-hidden="true">/</span>
      <input id="rx-pattern" type="text" class="mono" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="例如 \d{4}-\d{2}-\d{2}" />
      <span class="rx-slash mono" aria-hidden="true">/<span id="rx-flag-text"></span></span>
    </div>
  </div>

  <fieldset class="rx-flags">
    <legend class="visually-hidden">旗標</legend>
    {
      FLAGS.map(({ flag, label, title }) => (
        <label class="check" title={title}>
          <input type="checkbox" name="rx-flag" value={flag} checked={flag === 'g'} />
          <span>
            <code>{flag}</code> {label}
          </span>
        </label>
      ))
    }
  </fieldset>

  <div id="rx-error" class="notice error" role="alert" hidden></div>

  <div class="field">
    <label for="rx-text">測試文字</label>
    <textarea id="rx-text" rows="7" spellcheck="false" placeholder="貼上要比對的文字"></textarea>
  </div>

  <div class="field">
    <span class="label" id="rx-count">比對結果</span>
    <div class="output rx-highlight" id="rx-highlight" aria-live="polite"></div>
  </div>

  <div class="field" id="rx-list-wrap" hidden>
    <span class="label">符合清單</span>
    <div class="table-wrap rx-list">
      <table class="table">
        <thead><tr><th class="num">#</th><th class="num">位置</th><th>符合內容</th><th>群組</th></tr></thead>
        <tbody id="rx-list"></tbody>
      </table>
    </div>
    <span class="hint" id="rx-list-note"></span>
  </div>

  <div class="field">
    <label for="rx-replace">取代為（選填）</label>
    <input id="rx-replace" type="text" class="mono" spellcheck="false" autocomplete="off" placeholder="例如 $3/$2/$1 或 $<year>" />
  </div>
  <div class="field" id="rx-replaced-wrap" hidden>
    <div class="rx-head">
      <span class="label">取代結果預覽</span>
      <button class="btn small" type="button" data-copy="#rx-replaced">複製</button>
    </div>
    <div class="output" id="rx-replaced"></div>
  </div>

  <div class="row">
    <button class="btn ghost" type="button" id="rx-sample">載入範例</button>
    <button class="btn ghost" type="button" id="rx-clear">清除</button>
  </div>

  <details class="rx-cheat" open>
    <summary>常用語法速查</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>語法</th><th>意義</th><th>範例</th></tr></thead>
        <tbody>
          {
            CHEATSHEET.map(([syntax, meaning, example]) => (
              <tr>
                <td><code>{syntax}</code></td>
                <td>{meaning}</td>
                <td><code>{example}</code></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>取代語法</th><th>代表</th></tr></thead>
        <tbody>
          {
            REPLACEMENTS.map(([syntax, meaning]) => (
              <tr>
                <td><code>{syntax}</code></td>
                <td>{meaning}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { describeGroups, escapeHtml, highlight, MAX_MATCHES, run, type RunRequest, type RunResponse } from './logic';

  const TIMEOUT_MS = 1500;
  const MAX_ROWS = 200;

  const root = $('[data-tool="regex-tester"]');
  const pattern = $<HTMLInputElement>('#rx-pattern', root);
  const text = $<HTMLTextAreaElement>('#rx-text', root);
  const replace = $<HTMLInputElement>('#rx-replace', root);
  const flagBoxes = $$<HTMLInputElement>('input[name="rx-flag"]', root);
  const flagText = $('#rx-flag-text', root);
  const error = $('#rx-error', root);
  const count = $('#rx-count', root);
  const highlighted = $('#rx-highlight', root);
  const listWrap = $('#rx-list-wrap', root);
  const list = $('#rx-list', root);
  const listNote = $('#rx-list-note', root);
  const replacedWrap = $('#rx-replaced-wrap', root);
  const replaced = $('#rx-replaced', root);

  interface Prefs {
    pattern: string;
    flags: string;
    text: string;
    replacement: string;
  }

  const SAMPLE: Prefs = {
    pattern: '(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})',
    flags: 'g',
    text: '訂單 A102 於 2026-10-29 成立，預計 2026-11-03 出貨。\n客服信箱：service@example.com，電話 02-2345-6789。',
    replacement: '$<day>/$<month>/$<year>',
  };

  const readRequest = (): RunRequest => ({
    pattern: pattern.value,
    flags: flagBoxes.filter((b) => b.checked).map((b) => b.value).join(''),
    text: text.value,
    replacement: replace.value,
  });

  function apply(p: Prefs) {
    pattern.value = p.pattern;
    text.value = p.text;
    replace.value = p.replacement;
    flagBoxes.forEach((b) => (b.checked = p.flags.includes(b.value)));
  }

  function resetOutput(message: string) {
    count.textContent = '比對結果';
    highlighted.innerHTML = message ? `<span class="muted">${escapeHtml(message)}</span>` : escapeHtml(text.value);
    listWrap.hidden = true;
    replacedWrap.hidden = true;
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = false;
    resetOutput('');
  }

  function show(req: RunRequest, res: RunResponse) {
    if (!res.ok) return showError(res.error);
    error.hidden = true;
    const n = res.matches.length;
    count.textContent = n === 0 ? '比對結果：沒有符合' : `比對結果：${formatInteger(n)} 個符合${res.truncated ? '（已達上限）' : ''}`;
    highlighted.innerHTML = req.text ? highlight(req.text, res.matches) : '<span class="muted">輸入測試文字後會在這裡標示符合的部分</span>';

    const rows = res.matches.slice(0, MAX_ROWS).map((m, i) => {
      const tr = document.createElement('tr');
      const cells = [String(i + 1), `${m.index}–${m.end}`, m.text === '' ? '（空字串）' : m.text, describeGroups(m) || '—'];
      cells.forEach((value, c) => {
        const td = document.createElement('td');
        td.textContent = value;
        if (c < 2) td.className = 'num';
        if (c >= 2) td.className = 'mono';
        tr.append(td);
      });
      return tr;
    });
    list.replaceChildren(...rows);
    listWrap.hidden = n === 0;
    listNote.textContent = res.truncated
      ? `為避免瀏覽器當機，最多找出 ${formatInteger(MAX_MATCHES)} 個符合，表格列出前 ${MAX_ROWS} 個。`
      : n > MAX_ROWS
        ? `表格只列出前 ${MAX_ROWS} 個符合。`
        : '位置以 UTF-16 字元索引表示，從 0 開始。';

    replacedWrap.hidden = req.replacement === '' || req.text === '';
    replaced.textContent = res.replaced;
  }

  // ---- Worker with timeout: a catastrophic pattern freezes only the worker, which we terminate. ----
  let worker: Worker | null = null;
  let workerUnavailable = typeof Worker === 'undefined';
  let pending = false;
  let seq = 0;
  let timer: number | undefined;
  let lastRequest: RunRequest | null = null;

  function spawn(): Worker | null {
    if (workerUnavailable) return null;
    try {
      const w = new Worker(new URL('./worker.ts', import.meta.url), { type: 'module' });
      w.addEventListener('message', (e: MessageEvent<{ id: number; result: RunResponse }>) => {
        if (e.data.id !== seq || !lastRequest) return;
        pending = false;
        window.clearTimeout(timer);
        show(lastRequest, e.data.result);
      });
      w.addEventListener('error', () => {
        workerUnavailable = true;
        w.terminate();
        worker = null;
        pending = false;
        execute();
      });
      return w;
    } catch {
      workerUnavailable = true;
      return null;
    }
  }

  function execute() {
    const req = readRequest();
    savePref('regex-tester', { ...req, text: req.text.slice(0, 5000) });
    flagText.textContent = req.flags;
    window.clearTimeout(timer);
    const id = ++seq;
    lastRequest = req;
    if (req.pattern === '') {
      error.hidden = true;
      resetOutput('');
      return;
    }
    if (pending && worker) {
      worker.terminate();
      worker = null;
    }
    worker ??= spawn();
    if (!worker) {
      // Fallback without a worker: still capped by MAX_MATCHES, but cannot be interrupted.
      try {
        show(req, run(req));
      } catch (err) {
        showError(`執行失敗：${(err as Error).message}`);
      }
      return;
    }
    pending = true;
    worker.postMessage({ id, ...req });
    timer = window.setTimeout(() => {
      worker?.terminate();
      worker = null;
      pending = false;
      showError(`運算超過 ${TIMEOUT_MS / 1000} 秒已中止。這個樣式可能造成「災難性回溯」，例如 (a+)+$ 這類巢狀重複，請改寫樣式後再試。`);
    }, TIMEOUT_MS);
  }

  apply(loadPref<Prefs>('regex-tester', SAMPLE));
  const onInput = debounce(execute, 150);
  [pattern, text, replace].forEach((el) => el.addEventListener('input', onInput));
  flagBoxes.forEach((b) => b.addEventListener('change', execute));
  $('#rx-sample', root).addEventListener('click', () => {
    apply(SAMPLE);
    execute();
  });
  $('#rx-clear', root).addEventListener('click', () => {
    apply({ pattern: '', flags: 'g', text: '', replacement: '' });
    execute();
    pattern.focus();
  });
  execute();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .rx-pattern {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rx-pattern input {
    flex: 1;
    font-size: 16px;
  }
  .rx-slash {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--muted);
  }
  .rx-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .rx-flags code {
    font-weight: 700;
  }
  .rx-highlight {
    max-height: 320px;
    overflow: auto;
  }
  .rx-highlight :global(mark) {
    color: inherit;
    background: color-mix(in oklab, var(--accent) 28%, transparent);
    border-radius: 3px;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .rx-highlight :global(mark.alt) {
    background: color-mix(in oklab, var(--warning) 30%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--warning) 50%, transparent);
  }
  .rx-list {
    max-height: 360px;
    overflow: auto;
  }
  .rx-list :global(td.mono) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    min-width: 120px;
  }
  .rx-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .rx-cheat {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    min-width: 0;
  }
  .rx-cheat summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }
  .rx-cheat .table-wrap + .table-wrap {
    margin-top: 12px;
  }
  .rx-cheat td {
    white-space: normal;
  }
  .rx-cheat td:first-child {
    white-space: nowrap;
  }
</style>
