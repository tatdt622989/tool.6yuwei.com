---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const d = s.client.defaults;
---

<div class="tool" data-tool="split-bill" {...i18nAttrs(locale, s.client)}>
  <div class="seg" role="radiogroup" aria-label={s.modeAria}>
    <label><input type="radio" name="sb-mode" value="equal" checked /><span>{s.modeEqual}</span></label>
    <label><input type="radio" name="sb-mode" value="items" /><span>{s.modeItems}</span></label>
  </div>

  <div class="grid-2" id="sb-equal">
    <div class="field">
      <label for="sb-total">{s.totalLabel}</label>
      <input id="sb-total" type="text" inputmode="decimal" autocomplete="off" value={d.total} />
    </div>
    <div class="field">
      <label for="sb-people">{s.peopleLabel}</label>
      <input id="sb-people" type="text" inputmode="numeric" autocomplete="off" value={d.people} />
    </div>
  </div>

  <div class="field" id="sb-items" hidden>
    <span class="label">{s.itemsLabel}</span>
    <div class="sb-list" id="sb-list"></div>
    <div class="row">
      <button class="btn small" type="button" id="sb-add">{s.addPerson}</button>
    </div>
    <label class="label" for="sb-shared">{s.sharedLabel}</label>
    <input id="sb-shared" type="text" inputmode="decimal" autocomplete="off" value={d.shared} />
  </div>

  {
    s.tip ? (
      <div class="grid-2">
        <div class="field">
          <label for="sb-service">{s.serviceLabel}</label>
          <input id="sb-service" type="text" inputmode="decimal" autocomplete="off" value={d.service} />
          <span class="hint">{s.serviceHint}</span>
        </div>
        <div class="field">
          <label for="sb-tip">{s.tip.label}</label>
          <input id="sb-tip" type="text" inputmode="decimal" autocomplete="off" value={d.tip} />
          {s.tip.presets && (
            <div class="row sb-tips" role="group" aria-label={s.tip.presetsAria}>
              {s.tip.presets.map((pct) => (
                <button class="btn small" type="button" data-tip={pct} aria-pressed="false">
                  {pct}%
                </button>
              ))}
            </div>
          )}
          <span class="hint">{s.tip.hint}</span>
        </div>
      </div>
    ) : (
      <div class="field">
        <label for="sb-service">{s.serviceLabel}</label>
        <input id="sb-service" type="text" inputmode="decimal" autocomplete="off" value={d.service} />
        <span class="hint">{s.serviceHint}</span>
      </div>
    )
  }

  <div class="field" id="sb-round-wrap">
    <span class="label">{s.roundLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.roundLabel}>
      {
        s.roundOptions.map((o, i) => (
          <label><input type="radio" name="sb-round" value={String(o.value)} checked={i === 0} /><span>{o.label}</span></label>
        ))
      }
    </div>
    {
      s.roundMode && (
        <div class="sb-round-mode" id="sb-round-mode">
          <span class="label">{s.roundMode.label}</span>
          <div class="seg" role="radiogroup" aria-label={s.roundMode.label}>
            <label><input type="radio" name="sb-round-mode" value="up" checked /><span>{s.roundMode.up}</span></label>
            <label><input type="radio" name="sb-round-mode" value="down" /><span>{s.roundMode.down}</span></label>
          </div>
        </div>
      )
    }
  </div>

  <p class="notice error" id="sb-error" hidden></p>

  <div id="sb-results">
    <div class="result">
      <div class="result-value" id="sb-main">—</div>
      <div class="result-label" id="sb-main-label">{s.client.mainLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sb-subtotal">—</span><span class="stat-label">{s.statSubtotal}</span></div>
      <div class="stat"><span class="stat-value" id="sb-service-out">—</span><span class="stat-label">{s.statService}</span></div>
      {s.statTip && <div class="stat"><span class="stat-value" id="sb-tip-out">—</span><span class="stat-label">{s.statTip}</span></div>}
      <div class="stat"><span class="stat-value" id="sb-grand">—</span><span class="stat-label">{s.statGrand}</span></div>
    </div>

    <p class="notice" id="sb-note"></p>

    <div class="table-wrap" id="sb-table-wrap" hidden>
      <table class="table">
        <thead>
          <tr><th>{s.tableHead[0]}</th><th class="num">{s.tableHead[1]}</th><th class="num">{s.tableHead[2]}</th><th class="num">{s.tableHead[3]}</th><th class="num">{s.tableHead[4]}</th></tr>
        </thead>
        <tbody id="sb-table"></tbody>
      </table>
    </div>

    <div class="row">
      <button class="btn small" type="button" data-copy="#sb-summary">{s.copyResult}</button>
    </div>
    <textarea id="sb-summary" hidden readonly aria-hidden="true"></textarea>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { splitEqually, splitItemized, type RoundMode } from './logic';
  import type { Strings } from './i18n';

  type Mode = 'equal' | 'items';
  interface Prefs {
    mode: Mode;
    total: string;
    people: string;
    service: string;
    tip: string;
    roundTo: string;
    roundMode?: RoundMode;
    shared: string;
    persons: { name: string; amount: string }[];
  }

  const root = $('[data-tool="split-bill"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const defaults: Prefs = s.defaults;
  const scale = s.digits === 2 ? 100 : 1;

  const modeRadios = $$<HTMLInputElement>('input[name="sb-mode"]', root);
  const roundRadios = $$<HTMLInputElement>('input[name="sb-round"]', root);
  const roundModeRadios = $$<HTMLInputElement>('input[name="sb-round-mode"]', root);
  const tipButtons = $$<HTMLButtonElement>('[data-tip]', root);
  const total = $<HTMLInputElement>('#sb-total', root);
  const people = $<HTMLInputElement>('#sb-people', root);
  const service = $<HTMLInputElement>('#sb-service', root);
  const tip = root.querySelector<HTMLInputElement>('#sb-tip');
  const shared = $<HTMLInputElement>('#sb-shared', root);
  const list = $('#sb-list', root);
  const equalPanel = $('#sb-equal', root);
  const itemsPanel = $('#sb-items', root);
  const roundWrap = $('#sb-round-wrap', root);
  const roundModeWrap = root.querySelector<HTMLElement>('#sb-round-mode');
  const error = $('#sb-error', root);
  const results = $('#sb-results', root);
  const main = $('#sb-main', root);
  const mainLabel = $('#sb-main-label', root);
  const note = $('#sb-note', root);
  const tableWrap = $('#sb-table-wrap', root);
  const table = $('#sb-table', root);
  const summary = $<HTMLTextAreaElement>('#sb-summary', root);

  /** Amount without currency, in the currency's minor-unit precision. */
  const amountText = (n: number) => (s.digits === 2 ? formatFixed(n, 2, locale) : formatInteger(n, locale));
  const money = (n: number) => t(s.money, { n: amountText(n) });
  /** Plain number for table cells (and zh stats). */
  const num = (n: number) => (s.digits === 2 ? formatFixed(n, 2, locale) : formatNumber(n, s.numDigits, locale));
  const stat = (n: number) => (s.statMoney ? money(n) : num(n));
  const mode = (): Mode => (modeRadios.find((r) => r.checked)?.value as Mode) ?? 'equal';
  const roundTo = (): number => Number(roundRadios.find((r) => r.checked)?.value ?? '1') || 1;
  const roundMode = (): RoundMode => (roundModeRadios.find((r) => r.checked)?.value === 'down' ? 'down' : 'up');

  function addPersonRow(name = '', amount = '') {
    const row = document.createElement('div');
    row.className = 'sb-person';
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.placeholder = t(s.nthPerson, { n: list.children.length + 1 });
    nameInput.value = name;
    nameInput.setAttribute('aria-label', s.nameAria);
    nameInput.dataset.role = 'name';
    const amountInput = document.createElement('input');
    amountInput.type = 'text';
    amountInput.inputMode = 'decimal';
    amountInput.placeholder = s.amountPlaceholder;
    amountInput.value = amount;
    amountInput.setAttribute('aria-label', s.amountAria);
    amountInput.dataset.role = 'amount';
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'btn small ghost';
    remove.textContent = s.remove;
    remove.addEventListener('click', () => {
      if (list.children.length <= 1) return;
      row.remove();
      render();
    });
    row.append(nameInput, amountInput, remove);
    list.append(row);
  }

  function readPersons() {
    return $$<HTMLElement>('.sb-person', list).map((row, i) => {
      const name = $<HTMLInputElement>('[data-role="name"]', row).value.trim();
      const amount = $<HTMLInputElement>('[data-role="amount"]', row).value;
      return { name: name || t(s.nthPerson, { n: i + 1 }), rawName: name, amount };
    });
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = false;
    results.hidden = true;
  }

  function render() {
    const m = mode();
    const persons = readPersons();
    savePref(s.prefKey, {
      mode: m,
      total: total.value,
      people: people.value,
      service: service.value,
      tip: tip?.value ?? '0',
      roundTo: String(roundTo()),
      ...(roundModeWrap ? { roundMode: roundMode() } : {}),
      shared: shared.value,
      persons: persons.map((p) => ({ name: p.rawName, amount: p.amount })),
    } satisfies Prefs);

    equalPanel.hidden = m !== 'equal';
    itemsPanel.hidden = m !== 'items';
    roundWrap.hidden = m !== 'equal';
    tableWrap.hidden = m !== 'items';
    if (roundModeWrap) roundModeWrap.hidden = roundTo() === 1;

    const servicePct = service.value.trim() === '' ? 0 : parseNumber(service.value);
    const tipPct = !tip || tip.value.trim() === '' ? 0 : parseNumber(tip.value);
    for (const b of tipButtons) b.setAttribute('aria-pressed', String(Number(b.dataset.tip) === tipPct));

    if (m === 'equal') {
      const step = roundTo();
      const r = splitEqually({
        subtotal: parseNumber(total.value),
        people: parseNumber(people.value),
        servicePct,
        tipPct,
        roundTo: step,
        roundMode: roundMode(),
        scale,
      });
      if (!r) return showError(s.errorEqual);
      error.hidden = true;
      results.hidden = false;
      fillStats(r.subtotal, r.service, r.tip, r.grandTotal);
      const n = parseNumber(people.value);
      if (step > 1) {
        const unit = t(s.money, { n: formatNumber(step / scale, 2, locale) });
        const down = r.surplus < 0;
        main.textContent = money(r.roundedPerPerson);
        mainLabel.textContent = t(roundMode() === 'down' && s.labelRoundedDown ? s.labelRoundedDown : s.labelRounded, { unit });
        const vars = { per: money(r.roundedPerPerson), n, collected: money(r.collected) };
        note.textContent =
          r.surplus > 0
            ? t(s.noteSurplus, { ...vars, surplus: money(r.surplus) })
            : down && s.noteShortfall
              ? t(s.noteShortfall, { ...vars, shortfall: money(-r.surplus) })
              : t(s.noteRoundedExact, vars);
      } else if (r.extraCount > 0) {
        const high = r.basePerPerson + 1 / scale;
        main.textContent = t(s.mainRange, { low: amountText(r.basePerPerson), high: amountText(high) });
        mainLabel.textContent = t(s.labelExact, { exact: formatNumber(r.exactPerPerson, s.exactDigits, locale) });
        note.textContent = t(s.noteUneven, {
          total: money(r.grandTotal),
          n,
          extra: r.extraCount,
          rest: n - r.extraCount,
          high: money(high),
          low: money(r.basePerPerson),
        });
      } else {
        main.textContent = money(r.basePerPerson);
        mainLabel.textContent = s.mainLabel;
        note.textContent = t(s.noteEven, { total: money(r.grandTotal), n, per: money(r.basePerPerson) });
      }
      summary.value = t(s.summaryEqual, { main: main.textContent, label: mainLabel.textContent, note: note.textContent });
      return;
    }

    const r = splitItemized({
      people: persons.map((p) => ({ name: p.name, amount: p.amount.trim() === '' ? 0 : parseNumber(p.amount) })),
      shared: shared.value.trim() === '' ? 0 : parseNumber(shared.value),
      servicePct,
      tipPct,
      scale,
    });
    if (!r) return showError(s.errorItems);
    error.hidden = true;
    results.hidden = false;
    fillStats(r.subtotal, r.service, r.tip, r.grandTotal);
    main.textContent = money(r.grandTotal);
    mainLabel.textContent = plural(locale, r.shares.length, s.itemsMainLabel);
    note.textContent = s.itemsNote;
    table.replaceChildren(
      ...r.shares.map((share) => {
        const tr = document.createElement('tr');
        const cells = [share.name, num(share.own), num(share.sharedPart), num(share.charges), money(share.pay)];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i > 0) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );
    summary.value = [
      t(s.summaryTotal, { total: money(r.grandTotal) }),
      ...r.shares.map((share) => t(s.summaryLine, { name: share.name, pay: money(share.pay) })),
    ].join('\n');
  }

  function fillStats(subtotal: number, serviceAmount: number, tipAmount: number, grand: number) {
    $('#sb-subtotal', root).textContent = stat(subtotal);
    $('#sb-service-out', root).textContent = stat(serviceAmount);
    const tipOut = root.querySelector('#sb-tip-out');
    if (tipOut) tipOut.textContent = stat(tipAmount);
    $('#sb-grand', root).textContent = money(grand);
  }

  const prefs = { ...defaults, ...loadPref<Partial<Prefs>>(s.prefKey, {}) };
  total.value = prefs.total;
  people.value = prefs.people;
  service.value = prefs.service;
  if (tip) tip.value = prefs.tip;
  shared.value = prefs.shared;
  for (const r of modeRadios) r.checked = r.value === prefs.mode;
  if (roundRadios.some((r) => r.value === prefs.roundTo)) for (const r of roundRadios) r.checked = r.value === prefs.roundTo;
  for (const r of roundModeRadios) r.checked = r.value === (prefs.roundMode ?? 'up');
  const persons = Array.isArray(prefs.persons) && prefs.persons.length > 0 ? prefs.persons : defaults.persons;
  persons.forEach((p) => addPersonRow(p.name, p.amount));

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  for (const b of tipButtons) {
    b.addEventListener('click', () => {
      if (tip) tip.value = b.dataset.tip ?? '';
      render();
    });
  }
  $('#sb-add', root).addEventListener('click', () => {
    addPersonRow();
    render();
    $$<HTMLInputElement>('[data-role="name"]', list).at(-1)?.focus();
  });
  render();
</script>

<style>
  #sb-results {
    display: grid;
    gap: 16px;
  }
  #sb-results[hidden] {
    display: none;
  }
  .sb-list {
    display: grid;
    gap: 8px;
  }
  .sb-list :global(.sb-person) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
  }
  #sb-items .label + input,
  #sb-items .row + .label {
    margin-top: 4px;
  }
  .field[hidden],
  .grid-2[hidden],
  .sb-round-mode[hidden] {
    display: none;
  }
  .sb-round-mode {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  .sb-tips {
    gap: 6px;
  }
  .sb-tips .btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
