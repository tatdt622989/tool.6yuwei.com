<div class="tool" data-tool="labor-pension">
  <div class="grid-2">
    <div class="field">
      <label for="lp-salary">目前月薪（元）</label>
      <input id="lp-salary" type="text" inputmode="numeric" autocomplete="off" value="40000" />
    </div>
    <div class="field">
      <label for="lp-self">勞退自提比例</label>
      <select id="lp-self">
        <option value="0" selected>不自提（0%）</option>
        <option value="1">1%</option>
        <option value="2">2%</option>
        <option value="3">3%</option>
        <option value="4">4%</option>
        <option value="5">5%</option>
        <option value="6">6%</option>
      </select>
    </div>
    <div class="field">
      <label for="lp-age">目前年齡</label>
      <input id="lp-age" type="text" inputmode="numeric" autocomplete="off" value="30" />
    </div>
    <div class="field">
      <label for="lp-retire">預計退休請領年齡</label>
      <input id="lp-retire" type="text" inputmode="numeric" autocomplete="off" value="65" />
      <span class="hint">年滿 60 歲才能請領。</span>
    </div>
    <div class="field">
      <label for="lp-balance">目前個人專戶累積金額（元）</label>
      <input id="lp-balance" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">可在勞保局 e 化服務系統或「勞動保障卡」App 查詢。</span>
    </div>
    <div class="field">
      <label for="lp-past">已提繳年資（年）</label>
      <input id="lp-past" type="text" inputmode="decimal" autocomplete="off" value="0" />
    </div>
    <div class="field">
      <label for="lp-return">假設年化報酬率（%）</label>
      <input id="lp-return" type="text" inputmode="decimal" autocomplete="off" value="3" />
    </div>
    <div class="field">
      <label for="lp-growth">假設每年調薪（%）</label>
      <input id="lp-growth" type="text" inputmode="decimal" autocomplete="off" value="1.5" />
    </div>
  </div>

  <details class="lp-more">
    <summary>進階設定：雇主提繳率、月退休金計算基礎</summary>
    <div class="grid-3">
      <div class="field">
        <label for="lp-employer">雇主提繳率（%）</label>
        <input id="lp-employer" type="text" inputmode="decimal" autocomplete="off" value="6" />
      </div>
      <div class="field">
        <label for="lp-life">平均餘命（年）</label>
        <input id="lp-life" type="text" inputmode="decimal" autocomplete="off" value="23" />
      </div>
      <div class="field">
        <label for="lp-rate">月退休金計算利率（%）</label>
        <input id="lp-rate" type="text" inputmode="decimal" autocomplete="off" value="1.1473" />
      </div>
    </div>
    <p class="hint">平均餘命 23 年、利率 1.1473% 為勞保局月退休金試算範例採用的數值，實際以請領時勞保局公告為準。</p>
  </details>

  <div class="notice error" id="lp-error" hidden></div>

  <div id="lp-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="lp-final">—</div>
      <div class="result-label" id="lp-final-label">退休時個人專戶預估累積金額</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="lp-monthly">—</span><span class="stat-label">預估月退休金（每月）</span></div>
      <div class="stat"><span class="stat-value" id="lp-contrib">—</span><span class="stat-label">未來累計提繳</span></div>
      <div class="stat"><span class="stat-value" id="lp-earn">—</span><span class="stat-label">未來投資收益</span></div>
      <div class="stat"><span class="stat-value" id="lp-selfsum">—</span><span class="stat-label">其中自提金額</span></div>
    </div>

    <p class="notice" id="lp-note"></p>

    <div class="field">
      <span class="label">逐年累積明細</span>
      <div class="table-wrap lp-table">
        <table class="table">
          <thead>
            <tr><th>年齡</th><th class="num">月提繳工資</th><th class="num">當年提繳</th><th class="num">當年收益</th><th class="num">年底累積</th></tr>
          </thead>
          <tbody id="lp-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">依勞工退休金條例與 2026 年勞退月提繳分級表（最高 150,000 元）估算，假設報酬率與調薪固定，未來分級表調整、離職空窗與實際收益波動都會影響結果。本試算為估計值，僅供參考，實際金額以勞保局個人專戶與核定為準；資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger, parseNumber } from '../../lib/format';
  import { PENSION_DEFAULTS, projectPension, validatePension, type PensionInput } from './logic';

  const KEY = 'labor-pension';
  const root = $('[data-tool="labor-pension"]');
  const ids = ['salary', 'age', 'retire', 'balance', 'past', 'return', 'growth', 'employer', 'life', 'rate'] as const;
  type Id = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((id) => [id, $<HTMLInputElement>(`#lp-${id}`, root)])) as Record<Id, HTMLInputElement>;
  const self = $<HTMLSelectElement>('#lp-self', root);
  const error = $('#lp-error', root);
  const output = $('#lp-output', root);
  const table = $('#lp-table', root);

  const prefs = loadPref<Partial<Record<Id | 'self', string>>>(KEY, {});
  for (const id of ids) if (prefs[id] !== undefined) inputs[id].value = prefs[id]!;
  if (prefs.self && self.querySelector(`option[value="${prefs.self}"]`)) self.value = prefs.self;

  const money = (n: number) => `${formatInteger(n)} 元`;
  const num = (id: Id) => (inputs[id].value.trim() === '' ? 0 : parseNumber(inputs[id].value));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  function render() {
    savePref(KEY, { ...Object.fromEntries(ids.map((id) => [id, inputs[id].value])), self: self.value });
    const input: PensionInput = {
      currentAge: num('age'),
      retireAge: num('retire'),
      salary: num('salary'),
      balance: num('balance'),
      pastYears: num('past'),
      employerPct: inputs.employer.value.trim() === '' ? PENSION_DEFAULTS.employerPct : num('employer'),
      selfPct: Number(self.value),
      returnPct: num('return'),
      salaryGrowthPct: num('growth'),
      lifeExpectancyYears: num('life'),
      annuityRatePct: num('rate'),
    };
    const problem = validatePension(input);
    const r = problem ? null : projectPension(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    set('#lp-final', money(r.finalBalance));
    set('#lp-final-label', `${input.retireAge} 歲退休時個人專戶預估累積金額（再工作 ${formatInteger(r.years)} 年）`);
    set('#lp-monthly', money(r.monthlyPension));
    set('#lp-contrib', money(r.totalContribution));
    set('#lp-earn', money(r.totalEarnings));
    set('#lp-selfsum', money(r.selfContribution));
    set(
      '#lp-note',
      r.monthlyEligible
        ? `提繳年資約 ${formatInteger(r.totalServiceYears)} 年，已滿 15 年，可選擇月領或一次領。月領以平均餘命 ${input.lifeExpectancyYears} 年、利率 ${input.annuityRatePct}% 換算，按季發給，每季約 ${money(r.quarterlyPension)}；也可一次領回全部 ${money(r.finalBalance)}。`
        : `提繳年資約 ${formatInteger(r.totalServiceYears)} 年，未滿 15 年，年滿 60 歲時只能一次領取全部 ${money(r.finalBalance)}（上方月退休金僅供比較）。`,
    );

    table.replaceChildren(
      ...r.rows.map((row) => {
        const tr = document.createElement('tr');
        [`${row.age} 歲`, formatInteger(row.wage), formatInteger(row.contribution), formatInteger(row.earnings), formatInteger(row.balance)].forEach(
          (text, i) => {
            const td = document.createElement('td');
            td.textContent = text;
            if (i > 0) td.className = 'num';
            tr.append(td);
          },
        );
        return tr;
      }),
    );
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #lp-output {
    display: grid;
    gap: 16px;
  }
  #lp-output[hidden] {
    display: none;
  }
  .lp-more {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .lp-more[open] {
    display: grid;
    gap: 14px;
  }
  .lp-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
  .lp-table {
    max-height: 420px;
    overflow-y: auto;
  }
</style>
