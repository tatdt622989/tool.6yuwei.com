---
import { formatDate as formatIntlDate, t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { localClock, lunarNewYearInfo, newYearState, shogatsuInfo, TAIPEI_CLOCK, TOKYO_CLOCK, type DayClock } from './logic';
import i18n from './i18n';
import type { YMD } from '../date-diff/logic';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const clocks: Record<typeof s.clock, () => DayClock> = { taipei: () => TAIPEI_CLOCK, tokyo: () => TOKYO_CLOCK, local: localClock };
const clock = clocks[s.clock]();

// Server-rendered starting values so the page is meaningful before the script runs (and for crawlers).
const now = Date.now();
const initial = newYearState(now, clock);
const lunar = lunarNewYearInfo(now, s.cards === 'eve-lunar' ? clock : TAIPEI_CLOCK);
const shogatsu = s.cards === 'lunar-tw' ? null : shogatsuInfo(now, clock);
const RAYS = Array.from({ length: 16 }, (_, i) => i);
const intlDate = (d: YMD) =>
  formatIntlDate(new Date(Date.UTC(d.y, d.m - 1, d.d)), locale, { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const card1Date =
  s.cards === 'lunar-tw' ? (lunar ? `${lunar.chuxi.date.m} 月 ${lunar.chuxi.date.d} 日` : '') : intlDate(shogatsu!.omisoka.date);
const card2Date =
  s.cards === 'lunar-tw'
    ? lunar
      ? `${lunar.chunjie.date.m} 月 ${lunar.chunjie.date.d} 日`
      : ''
    : s.cards === 'eve-lunar'
      ? lunar
        ? intlDate(lunar.chunjie.date)
        : ''
      : intlDate(shogatsu!.ganjitsu.date);
const targetText = t(s.client.target, {
  year: initial.targetYear,
  date: intlDate({ y: initial.targetYear, m: 1, d: 1 }),
  zone: '',
});
---

<div class="tool" data-tool="new-year-countdown" data-phase="countdown" data-clock={s.clock === 'taipei' ? undefined : s.clock} data-cards={s.cards === 'lunar-tw' ? undefined : s.cards} {...i18nAttrs(locale, s.client)}>
  <div class="ny-hero">
    <p class="ny-eyebrow" id="ny-eyebrow">{t(s.client.eyebrow, { year: initial.targetYear })}</p>

    <div class="ny-units" id="ny-units" role="timer" aria-label={s.timerAria}>
      <div class="ny-unit"><span class="ny-num" id="ny-d">--</span><span class="ny-lbl">{s.units[0]}</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-h">--</span><span class="ny-lbl">{s.units[1]}</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-m">--</span><span class="ny-lbl">{s.units[2]}</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-s">--</span><span class="ny-lbl">{s.units[3]}</span></div>
    </div>

    <div class="ny-final" id="ny-final" aria-live="off" hidden>60</div>

    <div class="ny-celebrate" id="ny-celebrate" hidden>
      <div class="ny-burst" aria-hidden="true">
        {RAYS.map((i) => <span style={`--i:${i}`} />)}
      </div>
      <p class="ny-happy">{s.happy}</p>
      <p class="ny-year" id="ny-year">{initial.targetYear}</p>
    </div>

    <p class="ny-target" id="ny-target">{targetText}</p>

    <div class="ny-progress">
      <div class="ny-track" aria-hidden="true"><div class="ny-fill" id="ny-fill"></div></div>
      <span class="hint" id="ny-progress-label">&nbsp;</span>
    </div>
  </div>

  <div class="ny-controls">
    <button class="btn" type="button" id="ny-fullscreen">{s.fullscreen}</button>
    <label class="check"><input type="checkbox" id="ny-sound" /> {s.sound}</label>
  </div>

  <p class="ny-sync hint" id="ny-sync" aria-live="polite">{s.syncing}</p>

  <div class="grid-2 ny-lunar">
    <div class="ny-card" id="ny-chuxi">
      <span class="ny-card-title">{s.card1Title}</span>
      <span class="ny-card-date" id="ny-chuxi-date">{card1Date}</span>
      <span class="ny-card-value" id="ny-chuxi-value">&nbsp;</span>
    </div>
    <div class="ny-card" id="ny-chunjie">
      <span class="ny-card-title" id="ny-chunjie-title">{s.card2Title}</span>
      <span class="ny-card-date" id="ny-chunjie-date">{card2Date}</span>
      <span class="ny-card-value" id="ny-chunjie-value">&nbsp;</span>
    </div>
  </div>
  <p class="notice" id="ny-holiday" hidden></p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { formatDate as formatIntlDate, plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import type { YMD } from '../date-diff/logic';
  import { formatAccuracy, formatOffsetAmount } from '../taiwan-time/logic';
  import { syncClock } from '../taiwan-time/sync';
  import {
    finalSeconds,
    formatDate,
    formatParts,
    localClock,
    lunarNewYearInfo,
    newYearState,
    pad2,
    shogatsuInfo,
    splitRemaining,
    TAIPEI_CLOCK,
    TOKYO_CLOCK,
    yearGanzhiOf,
    yearProgress,
    type DayClock,
    type DayEvent,
  } from './logic';
  import type { CardsKind, ClockKind, Strings } from './i18n';

  const root = $('[data-tool="new-year-countdown"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const clockKind = (root.dataset.clock ?? 'taipei') as ClockKind;
  const cards = (root.dataset.cards ?? 'lunar-tw') as CardsKind;
  const clock: DayClock = clockKind === 'local' ? localClock() : clockKind === 'tokyo' ? TOKYO_CLOCK : TAIPEI_CLOCK;
  const eyebrow = $('#ny-eyebrow', root);
  const dEl = $('#ny-d', root);
  const hEl = $('#ny-h', root);
  const mEl = $('#ny-m', root);
  const sEl = $('#ny-s', root);
  const finalEl = $('#ny-final', root);
  const unitsEl = $('#ny-units', root);
  const celebrateEl = $('#ny-celebrate', root);
  const yearEl = $('#ny-year', root);
  const targetEl = $('#ny-target', root);
  const fill = $('#ny-fill', root);
  const progressLabel = $('#ny-progress-label', root);
  const fsBtn = $<HTMLButtonElement>('#ny-fullscreen', root);
  const soundBox = $<HTMLInputElement>('#ny-sound', root);
  const syncEl = $('#ny-sync', root);
  const chuxiDate = $('#ny-chuxi-date', root);
  const chuxiValue = $('#ny-chuxi-value', root);
  const chunjieTitle = $('#ny-chunjie-title', root);
  const chunjieDate = $('#ny-chunjie-date', root);
  const chunjieValue = $('#ny-chunjie-value', root);
  const chuxiCard = $('#ny-chuxi', root);
  const chunjieCard = $('#ny-chunjie', root);
  const holidayEl = $('#ny-holiday', root);
  const baseTitle = document.title;

  let offset = 0; // server − device, ms
  let lastTitle = '';
  let lastBeep = Number.NaN;
  soundBox.checked = loadPref<boolean>('new-year-countdown-sound', false);

  const now = () => Date.now() + offset;
  const set = (el: HTMLElement, text: string) => {
    if (el.textContent !== text) el.textContent = text;
  };
  const dayWord = (n: number) => plural(locale, n, s.days);

  /** Calendar date in the page's language, e.g. "Thursday, December 31, 2026" / 「2026年12月31日(木)」. */
  function localDate(date: YMD): string {
    return formatIntlDate(new Date(Date.UTC(date.y, date.m - 1, date.d)), locale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      weekday: locale === 'ja' ? 'short' : 'long',
      timeZone: 'UTC',
    });
  }

  /** Name of the viewer's zone at the target instant, e.g. "Eastern Standard Time". */
  function zoneName(at: number): string {
    try {
      const part = new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, { timeZoneName: 'long' })
        .formatToParts(at)
        .find((p) => p.type === 'timeZoneName');
      return part ? ` (${part.value})` : '';
    } catch {
      return '';
    }
  }

  function accuracyText(ms: number): string {
    const d = s.durations;
    if (!d) return formatAccuracy(ms);
    return ms < 1000 ? t(d.ms, { n: Math.max(1, Math.round(ms)) }) : t(d.sec, { n: (ms / 1000).toFixed(1) });
  }

  function offsetText(ms: number): string {
    const d = s.durations;
    if (!d) return formatOffsetAmount(ms);
    const abs = Math.abs(ms);
    if (abs < 60_000) return t(d.sec, { n: (abs / 1000).toFixed(2) });
    const p = splitRemaining(abs);
    if (p.days > 0) return t(d.dayHour, { d: p.days, h: p.hours });
    if (p.hours > 0) return t(d.hourMin, { h: p.hours, m: p.minutes });
    return t(d.minSec, { m: p.minutes, s: p.seconds });
  }

  /* ---------- Sound ---------- */
  let audio: AudioContext | null = null;
  function unlockAudio() {
    const Ctor =
      window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
  }
  function beep(frequency: number, duration: number) {
    if (!audio || audio.state !== 'running') return;
    const at = audio.currentTime + 0.01;
    const osc = audio.createOscillator();
    const gain = audio.createGain();
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(0.3, at + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);
    osc.connect(gain).connect(audio.destination);
    osc.start(at);
    osc.stop(at + duration + 0.02);
  }

  /* ---------- Rendering ---------- */
  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function describeDay(e: DayEvent, todayText: string): string {
    if (e.status === 'today') return todayText;
    if (e.status === 'past') return s.past;
    return e.daysUntil >= 2
      ? plural(locale, e.daysUntil, s.daysLeft)
      : t(s.hmsLeft, { hms: formatParts(splitRemaining(e.remaining), dayWord) });
  }

  /** zh-TW: 除夕 + 春節 (Taiwan time) and the official 春節連假. */
  function renderLunarTw(at: number) {
    const lt = s.lunarTw!;
    const info = lunarNewYearInfo(at);
    if (!info) return;
    set(chuxiDate, formatDate(info.chuxi.date));
    set(chuxiValue, describeDay(info.chuxi, lt.chuxiToday));
    set(chunjieTitle, t(lt.chunjieTitle, { ganzhi: info.ganzhi, animal: info.animal }));
    set(chunjieDate, formatDate(info.chunjie.date));
    set(chunjieValue, describeDay(info.chunjie, lt.chunjieToday));
    chuxiCard.dataset.status = info.chuxi.status;
    chunjieCard.dataset.status = info.chunjie.status;
    if (info.holiday) {
      const { start, end, days } = info.holiday;
      set(
        holidayEl,
        t(lt.holiday, {
          year: info.year,
          start: formatDate(start).replace(/^\d+ 年 /, ''),
          end: formatDate(end).replace(/^\d+ 年 /, ''),
          days,
        }),
      );
      holidayEl.hidden = false;
    } else {
      holidayEl.hidden = true;
    }
  }

  /** en / ja: New Year's Eve (大晦日) card, then Lunar New Year (en) or 元日・三が日 (ja). */
  function renderEveCards(at: number) {
    const sh = shogatsuInfo(at, clock);
    set(chuxiDate, localDate(sh.omisoka.date));
    set(chuxiValue, describeDay(sh.omisoka, s.eve!.today));
    chuxiCard.dataset.status = sh.omisoka.status;

    if (cards === 'eve-lunar') {
      const info = lunarNewYearInfo(at, clock);
      chunjieCard.hidden = !info;
      if (!info) return;
      const l = s.lunar!;
      set(chunjieTitle, t(l.title, { animal: l.animals[info.animal] ?? info.animal }));
      set(chunjieDate, localDate(info.chunjie.date));
      set(chunjieValue, describeDay(info.chunjie, l.today));
      chunjieCard.dataset.status = info.chunjie.status;
    } else {
      const sg = s.shogatsu!;
      const ganjitsu = sh.ganjitsu;
      set(chunjieTitle, t(sg.title, { year: ganjitsu.date.y, ganzhi: yearGanzhiOf(ganjitsu.date.y) }));
      set(chunjieDate, localDate(ganjitsu.date));
      const status = sh.sanganichiDay === null ? ganjitsu.status : 'today';
      set(chunjieValue, sh.sanganichiDay === null ? describeDay(ganjitsu, sg.today[0]) : sg.today[sh.sanganichiDay - 1]);
      chunjieCard.dataset.status = status;
    }
  }

  function tick() {
    const at = now();
    const st = newYearState(at, clock);
    root.dataset.phase = st.phase;
    unitsEl.hidden = st.phase !== 'countdown';
    finalEl.hidden = st.phase !== 'final';
    celebrateEl.hidden = st.phase !== 'celebrate';

    if (st.phase === 'celebrate') {
      set(eyebrow, t(s.celebrateEyebrow, { year: st.celebrating! }));
      set(yearEl, String(st.celebrating));
      const p = splitRemaining(st.remaining);
      set(targetEl, plural(locale, p.days, s.celebrateTarget, { year: st.targetYear }));
      setTitle(t(s.celebrateTitle, { year: st.celebrating! }));
    } else {
      set(eyebrow, t(s.eyebrow, { year: st.targetYear }));
      set(
        targetEl,
        t(s.target, {
          year: st.targetYear,
          date: localDate({ y: st.targetYear, m: 1, d: 1 }),
          zone: clockKind === 'local' ? zoneName(st.target) : '',
        }),
      );
      const p = splitRemaining(st.remaining);
      if (st.phase === 'final') {
        const sec = finalSeconds(st.remaining);
        set(finalEl, String(sec));
        if (soundBox.checked && sec <= 10 && sec !== lastBeep) {
          lastBeep = sec;
          beep(sec === 0 ? 1320 : 880, sec === 0 ? 0.6 : 0.12);
        }
        setTitle(t(s.finalTitle, { n: sec, year: st.targetYear }));
      } else {
        set(dEl, String(p.days));
        set(hEl, pad2(p.hours));
        set(mEl, pad2(p.minutes));
        set(sEl, pad2(p.seconds));
        setTitle(t(s.title, { left: formatParts(p, dayWord), year: st.targetYear }));
      }
    }

    const progress = yearProgress(at, clock);
    fill.style.width = `${(progress * 100).toFixed(3)}%`;
    set(progressLabel, t(s.progress, { year: st.targetYear - 1, p: (progress * 100).toFixed(2) }));
    if (cards === 'lunar-tw') renderLunarTw(at);
    else renderEveCards(at);
  }

  /* ---------- Controls ---------- */
  soundBox.addEventListener('change', () => {
    savePref('new-year-countdown-sound', soundBox.checked);
    if (soundBox.checked) unlockAudio();
  });

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (soundBox.checked) unlockAudio();
    if (document.fullscreenElement) void document.exitFullscreen();
    else void root.requestFullscreen().catch(() => undefined);
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? s.exitFullscreen : s.fullscreen;
  });
  // Audio needs a user gesture; any click on the tool unlocks it once sound is on.
  root.addEventListener('pointerdown', () => soundBox.checked && unlockAudio(), { passive: true });

  window.addEventListener('pagehide', () => setTitle(baseTitle));
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) tick();
  });

  tick();
  window.setInterval(tick, 100);

  void syncClock().then((est) => {
    if (est) {
      offset = est.offset;
      const diff = Math.abs(est.offset) / 1000;
      const acc = accuracyText(est.accuracy);
      syncEl.textContent =
        diff < 0.05
          ? t(s.syncOk, { acc })
          : t(est.offset > 0 ? s.syncSlow : s.syncFast, { acc, amount: offsetText(est.offset) });
    } else {
      syncEl.textContent = s.syncFail;
    }
    tick();
  });
</script>

<style>
  .ny-hero {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 20px 0 6px;
    text-align: center;
  }
  .ny-eyebrow {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(18px, 4.5vw, 24px);
    font-weight: 700;
    color: var(--text-2);
  }
  .ny-units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(6px, 2vw, 14px);
    width: 100%;
    max-width: 640px;
  }
  .ny-unit {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: clamp(10px, 3vw, 18px) 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 0;
  }
  .ny-num {
    font-family: var(--mono);
    font-size: clamp(26px, 8.6vw, 72px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .ny-lbl {
    font-size: 13px;
    color: var(--muted);
  }
  .ny-final {
    font-family: var(--mono);
    font-size: clamp(96px, 34vw, 240px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--accent);
  }
  .ny-target {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .ny-progress {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 100%;
    max-width: 640px;
  }
  .ny-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .ny-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .ny-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 18px;
  }
  .ny-sync {
    margin: -4px 0 0;
    text-align: center;
  }

  .ny-card {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .ny-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .ny-card-date {
    font-size: 15px;
    color: var(--text);
  }
  .ny-card-value {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .ny-card[data-status='today'] {
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .ny-card[data-status='today'] .ny-card-value {
    color: var(--accent);
    font-size: 20px;
  }

  /* ---------- Celebration (CSS only) ---------- */
  .ny-celebrate {
    display: grid;
    justify-items: center;
    padding: 4px 0 8px;
  }
  .ny-happy {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(28px, 8vw, 52px);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .ny-year {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(72px, 24vw, 180px);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  /* A small firework above the greeting: 16 rays from one point, never over the text. */
  .ny-burst {
    position: relative;
    width: 128px;
    height: 128px;
    pointer-events: none;
  }
  .ny-burst span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3px;
    height: 22px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: 50% 0;
    transform: rotate(calc(var(--i) * 22.5deg)) translateY(30px);
    opacity: 0.85;
  }
  .ny-burst span:nth-child(even) {
    background: var(--ink);
    height: 12px;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ny-burst span {
      animation: ny-ray 1.8s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
    }
    .ny-burst span:nth-child(even) {
      animation-delay: -0.9s;
    }
    .ny-year {
      animation: ny-pop 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
    }
  }
  @keyframes ny-ray {
    0% {
      opacity: 0;
      transform: rotate(calc(var(--i) * 22.5deg)) translateY(6px) scaleY(0.3);
    }
    35% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: rotate(calc(var(--i) * 22.5deg)) translateY(40px) scaleY(1);
    }
  }
  @keyframes ny-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-phase='final'] .ny-final {
      animation: ny-tick 1s ease-out infinite;
    }
  }
  @keyframes ny-tick {
    from {
      transform: scale(1.06);
    }
  }

  /* ---------- Fullscreen ---------- */
  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .tool:fullscreen .ny-lunar,
  .tool:fullscreen .ny-sync,
  .tool:fullscreen #ny-holiday,
  .tool:fullscreen .ny-controls label {
    display: none;
  }
  .tool:fullscreen .ny-units {
    max-width: 90vw;
  }
  .tool:fullscreen .ny-num {
    font-size: min(11vw, 22vh);
  }
  .tool:fullscreen .ny-eyebrow {
    font-size: min(4vw, 40px);
  }
  .tool:fullscreen .ny-final {
    font-size: min(40vw, 60vh);
  }
  .tool:fullscreen .ny-year {
    font-size: min(28vw, 45vh);
  }
  .tool:fullscreen .ny-progress {
    max-width: 90vw;
  }
</style>
