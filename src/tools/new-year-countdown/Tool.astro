---
import { lunarNewYearInfo, newYearState } from './logic';

// Server-rendered starting values so the page is meaningful before the script runs (and for crawlers).
const now = Date.now();
const initial = newYearState(now);
const lunar = lunarNewYearInfo(now);
const RAYS = Array.from({ length: 16 }, (_, i) => i);
---

<div class="tool" data-tool="new-year-countdown" data-phase="countdown">
  <div class="ny-hero">
    <p class="ny-eyebrow" id="ny-eyebrow">距離 {initial.targetYear} 年還有</p>

    <div class="ny-units" id="ny-units" role="timer" aria-label="跨年倒數">
      <div class="ny-unit"><span class="ny-num" id="ny-d">--</span><span class="ny-lbl">天</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-h">--</span><span class="ny-lbl">時</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-m">--</span><span class="ny-lbl">分</span></div>
      <div class="ny-unit"><span class="ny-num" id="ny-s">--</span><span class="ny-lbl">秒</span></div>
    </div>

    <div class="ny-final" id="ny-final" aria-live="off" hidden>60</div>

    <div class="ny-celebrate" id="ny-celebrate" hidden>
      <div class="ny-burst" aria-hidden="true">
        {RAYS.map((i) => <span style={`--i:${i}`} />)}
      </div>
      <p class="ny-happy">新年快樂</p>
      <p class="ny-year" id="ny-year">{initial.targetYear}</p>
    </div>

    <p class="ny-target" id="ny-target">{initial.targetYear} 年 1 月 1 日 00:00（台灣時間）</p>

    <div class="ny-progress">
      <div class="ny-track" aria-hidden="true"><div class="ny-fill" id="ny-fill"></div></div>
      <span class="hint" id="ny-progress-label">&nbsp;</span>
    </div>
  </div>

  <div class="ny-controls">
    <button class="btn" type="button" id="ny-fullscreen">全螢幕</button>
    <label class="check"><input type="checkbox" id="ny-sound" /> 最後 10 秒提示音</label>
  </div>

  <p class="ny-sync hint" id="ny-sync" aria-live="polite">正在與標準時間校時…</p>

  <div class="grid-2 ny-lunar">
    <div class="ny-card" id="ny-chuxi">
      <span class="ny-card-title">除夕</span>
      <span class="ny-card-date" id="ny-chuxi-date">{lunar ? `${lunar.chuxi.date.m} 月 ${lunar.chuxi.date.d} 日` : ''}</span>
      <span class="ny-card-value" id="ny-chuxi-value">&nbsp;</span>
    </div>
    <div class="ny-card" id="ny-chunjie">
      <span class="ny-card-title" id="ny-chunjie-title">春節（大年初一）</span>
      <span class="ny-card-date" id="ny-chunjie-date">{lunar ? `${lunar.chunjie.date.m} 月 ${lunar.chunjie.date.d} 日` : ''}</span>
      <span class="ny-card-value" id="ny-chunjie-value">&nbsp;</span>
    </div>
  </div>
  <p class="notice" id="ny-holiday" hidden></p>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatAccuracy, formatOffsetAmount } from '../taiwan-time/logic';
  import { syncClock } from '../taiwan-time/sync';
  import {
    finalSeconds,
    formatDate,
    formatParts,
    lunarNewYearInfo,
    newYearState,
    pad2,
    splitRemaining,
    yearProgress,
    type DayEvent,
  } from './logic';

  const root = $('[data-tool="new-year-countdown"]');
  const eyebrow = $('#ny-eyebrow', root);
  const dEl = $('#ny-d', root);
  const hEl = $('#ny-h', root);
  const mEl = $('#ny-m', root);
  const sEl = $('#ny-s', root);
  const finalEl = $('#ny-final', root);
  const unitsEl = $('#ny-units', root);
  const celebrateEl = $('#ny-celebrate', root);
  const yearEl = $('#ny-year', root);
  const targetEl = $('#ny-target', root);
  const fill = $('#ny-fill', root);
  const progressLabel = $('#ny-progress-label', root);
  const fsBtn = $<HTMLButtonElement>('#ny-fullscreen', root);
  const soundBox = $<HTMLInputElement>('#ny-sound', root);
  const syncEl = $('#ny-sync', root);
  const chuxiDate = $('#ny-chuxi-date', root);
  const chuxiValue = $('#ny-chuxi-value', root);
  const chunjieTitle = $('#ny-chunjie-title', root);
  const chunjieDate = $('#ny-chunjie-date', root);
  const chunjieValue = $('#ny-chunjie-value', root);
  const chuxiCard = $('#ny-chuxi', root);
  const chunjieCard = $('#ny-chunjie', root);
  const holidayEl = $('#ny-holiday', root);
  const baseTitle = document.title;

  let offset = 0; // server − device, ms
  let lastTitle = '';
  let lastBeep = Number.NaN;
  soundBox.checked = loadPref<boolean>('new-year-countdown-sound', false);

  const now = () => Date.now() + offset;
  const set = (el: HTMLElement, text: string) => {
    if (el.textContent !== text) el.textContent = text;
  };

  /* ---------- Sound ---------- */
  let audio: AudioContext | null = null;
  function unlockAudio() {
    const Ctor =
      window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
  }
  function beep(frequency: number, duration: number) {
    if (!audio || audio.state !== 'running') return;
    const at = audio.currentTime + 0.01;
    const osc = audio.createOscillator();
    const gain = audio.createGain();
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(0.3, at + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);
    osc.connect(gain).connect(audio.destination);
    osc.start(at);
    osc.stop(at + duration + 0.02);
  }

  /* ---------- Rendering ---------- */
  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function describeDay(e: DayEvent, todayText: string): string {
    if (e.status === 'today') return todayText;
    if (e.status === 'past') return '已經過了';
    return e.daysUntil >= 2 ? `還有 ${e.daysUntil} 天` : `還有 ${formatParts(splitRemaining(e.remaining))}`;
  }

  function renderLunar(t: number) {
    const info = lunarNewYearInfo(t);
    if (!info) return;
    set(chuxiDate, formatDate(info.chuxi.date));
    set(chuxiValue, describeDay(info.chuxi, '今天就是除夕'));
    set(chunjieTitle, `春節（大年初一，${info.ganzhi}${info.animal}年）`);
    set(chunjieDate, formatDate(info.chunjie.date));
    set(chunjieValue, describeDay(info.chunjie, '今天是大年初一'));
    chuxiCard.dataset.status = info.chuxi.status;
    chunjieCard.dataset.status = info.chunjie.status;
    if (info.holiday) {
      const { start, end, days } = info.holiday;
      set(
        holidayEl,
        `${info.year} 春節連假：${formatDate(start).replace(/^\d+ 年 /, '')} 至 ${formatDate(end).replace(/^\d+ 年 /, '')}，共 ${days} 天（依行政院人事行政總處公布的辦公日曆表）。`,
      );
      holidayEl.hidden = false;
    } else {
      holidayEl.hidden = true;
    }
  }

  function tick() {
    const t = now();
    const s = newYearState(t);
    root.dataset.phase = s.phase;
    unitsEl.hidden = s.phase !== 'countdown';
    finalEl.hidden = s.phase !== 'final';
    celebrateEl.hidden = s.phase !== 'celebrate';

    if (s.phase === 'celebrate') {
      set(eyebrow, `${s.celebrating} 年到了`);
      set(yearEl, String(s.celebrating));
      const p = splitRemaining(s.remaining);
      set(targetEl, `距離 ${s.targetYear} 年還有 ${p.days} 天`);
      setTitle(`新年快樂 ${s.celebrating}`);
    } else {
      set(eyebrow, `距離 ${s.targetYear} 年還有`);
      set(targetEl, `${s.targetYear} 年 1 月 1 日 00:00（台灣時間）`);
      const p = splitRemaining(s.remaining);
      if (s.phase === 'final') {
        const sec = finalSeconds(s.remaining);
        set(finalEl, String(sec));
        if (soundBox.checked && sec <= 10 && sec !== lastBeep) {
          lastBeep = sec;
          beep(sec === 0 ? 1320 : 880, sec === 0 ? 0.6 : 0.12);
        }
        setTitle(`${sec} 秒 跨年倒數`);
      } else {
        set(dEl, String(p.days));
        set(hEl, pad2(p.hours));
        set(mEl, pad2(p.minutes));
        set(sEl, pad2(p.seconds));
        setTitle(p.days > 0 ? `${p.days} 天 ${pad2(p.hours)}:${pad2(p.minutes)}:${pad2(p.seconds)} 跨年倒數` : `${formatParts(p)} 跨年倒數`);
      }
    }

    const progress = yearProgress(t);
    fill.style.width = `${(progress * 100).toFixed(3)}%`;
    set(progressLabel, `${s.targetYear - 1} 年已經過了 ${(progress * 100).toFixed(2)}%`);
    renderLunar(t);
  }

  /* ---------- Controls ---------- */
  soundBox.addEventListener('change', () => {
    savePref('new-year-countdown-sound', soundBox.checked);
    if (soundBox.checked) unlockAudio();
  });

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (soundBox.checked) unlockAudio();
    if (document.fullscreenElement) void document.exitFullscreen();
    else void root.requestFullscreen().catch(() => undefined);
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? '離開全螢幕' : '全螢幕';
  });
  // Audio needs a user gesture; any click on the tool unlocks it once sound is on.
  root.addEventListener('pointerdown', () => soundBox.checked && unlockAudio(), { passive: true });

  window.addEventListener('pagehide', () => setTitle(baseTitle));
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) tick();
  });

  tick();
  window.setInterval(tick, 100);

  void syncClock().then((est) => {
    if (est) {
      offset = est.offset;
      const diff = Math.abs(est.offset) / 1000;
      syncEl.textContent =
        diff < 0.05
          ? `已與標準時間校時（精度 ±${formatAccuracy(est.accuracy)}），你的裝置時間很準。`
          : `已與標準時間校時（精度 ±${formatAccuracy(est.accuracy)}），你的裝置時間${est.offset > 0 ? '慢' : '快'} ${formatOffsetAmount(est.offset)}，倒數已自動修正。`;
    } else {
      syncEl.textContent = '無法連線校時，目前依你裝置的時鐘倒數（已換算成台灣時間）。';
    }
    tick();
  });
</script>

<style>
  .ny-hero {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 20px 0 6px;
    text-align: center;
  }
  .ny-eyebrow {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(18px, 4.5vw, 24px);
    font-weight: 700;
    color: var(--text-2);
  }
  .ny-units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(6px, 2vw, 14px);
    width: 100%;
    max-width: 640px;
  }
  .ny-unit {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: clamp(10px, 3vw, 18px) 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 0;
  }
  .ny-num {
    font-family: var(--mono);
    font-size: clamp(26px, 8.6vw, 72px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .ny-lbl {
    font-size: 13px;
    color: var(--muted);
  }
  .ny-final {
    font-family: var(--mono);
    font-size: clamp(96px, 34vw, 240px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--accent);
  }
  .ny-target {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .ny-progress {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 100%;
    max-width: 640px;
  }
  .ny-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .ny-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .ny-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 18px;
  }
  .ny-sync {
    margin: -4px 0 0;
    text-align: center;
  }

  .ny-card {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .ny-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .ny-card-date {
    font-size: 15px;
    color: var(--text);
  }
  .ny-card-value {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .ny-card[data-status='today'] {
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .ny-card[data-status='today'] .ny-card-value {
    color: var(--accent);
    font-size: 20px;
  }

  /* ---------- Celebration (CSS only) ---------- */
  .ny-celebrate {
    display: grid;
    justify-items: center;
    padding: 4px 0 8px;
  }
  .ny-happy {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(28px, 8vw, 52px);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .ny-year {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(72px, 24vw, 180px);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  /* A small firework above the greeting: 16 rays from one point, never over the text. */
  .ny-burst {
    position: relative;
    width: 128px;
    height: 128px;
    pointer-events: none;
  }
  .ny-burst span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3px;
    height: 22px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: 50% 0;
    transform: rotate(calc(var(--i) * 22.5deg)) translateY(30px);
    opacity: 0.85;
  }
  .ny-burst span:nth-child(even) {
    background: var(--ink);
    height: 12px;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ny-burst span {
      animation: ny-ray 1.8s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
    }
    .ny-burst span:nth-child(even) {
      animation-delay: -0.9s;
    }
    .ny-year {
      animation: ny-pop 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
    }
  }
  @keyframes ny-ray {
    0% {
      opacity: 0;
      transform: rotate(calc(var(--i) * 22.5deg)) translateY(6px) scaleY(0.3);
    }
    35% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: rotate(calc(var(--i) * 22.5deg)) translateY(40px) scaleY(1);
    }
  }
  @keyframes ny-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-phase='final'] .ny-final {
      animation: ny-tick 1s ease-out infinite;
    }
  }
  @keyframes ny-tick {
    from {
      transform: scale(1.06);
    }
  }

  /* ---------- Fullscreen ---------- */
  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .tool:fullscreen .ny-lunar,
  .tool:fullscreen .ny-sync,
  .tool:fullscreen #ny-holiday,
  .tool:fullscreen .ny-controls label {
    display: none;
  }
  .tool:fullscreen .ny-units {
    max-width: 90vw;
  }
  .tool:fullscreen .ny-num {
    font-size: min(11vw, 22vh);
  }
  .tool:fullscreen .ny-eyebrow {
    font-size: min(4vw, 40px);
  }
  .tool:fullscreen .ny-final {
    font-size: min(40vw, 60vh);
  }
  .tool:fullscreen .ny-year {
    font-size: min(28vw, 45vh);
  }
  .tool:fullscreen .ny-progress {
    max-width: 90vw;
  }
</style>
