---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';
import { ALGORITHMS } from './logic';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const idOf = (alg: string) => `hg-${alg.toLowerCase().replace('-', '')}`;
---

<div class="tool" data-tool="hash-generator" {...i18nAttrs(locale, s.client)}>
  <div class="row between">
    <div class="seg" role="radiogroup" aria-label={s.sourceAria}>
      <label><input type="radio" name="hg-source" value="text" checked /><span>{s.text}</span></label>
      <label><input type="radio" name="hg-source" value="file" /><span>{s.file}</span></label>
    </div>
    <label class="check"><input type="checkbox" id="hg-upper" /> {s.uppercase}</label>
  </div>

  <div class="field" id="hg-text-panel">
    <label for="hg-text">{s.textLabel}</label>
    <textarea id="hg-text" rows="6" spellcheck="false" placeholder={s.textPlaceholder}></textarea>
  </div>

  <div id="hg-file-panel" hidden>
    <label class="dropzone" id="hg-drop">
      <input type="file" id="hg-file" hidden />
      <strong>{s.dropTitle}</strong>
      <span class="hint" id="hg-file-info">{s.dropHint}</span>
    </label>
  </div>

  <div id="hg-status" class="notice" aria-live="polite" hidden></div>

  <div class="hg-results">
    {
      ALGORITHMS.map((alg) => (
        <div class="hg-row">
          <label for={idOf(alg)} class="hg-alg">{alg}</label>
          <input id={idOf(alg)} data-alg={alg} type="text" class="mono" readonly spellcheck="false" />
          <button class="btn small" type="button" data-copy={`#${idOf(alg)}`}>{s.copy}</button>
        </div>
      ))
    }
  </div>

  <div class="field">
    <label for="hg-compare">{s.compareLabel}</label>
    <input id="hg-compare" type="text" class="mono" spellcheck="false" autocomplete="off" placeholder={s.comparePlaceholder} />
  </div>
  <div id="hg-compare-result" class="notice" aria-live="polite" hidden></div>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatBytes } from '../../lib/format';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { findMatch, hashAll, toHex, type Algorithm } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="hash-generator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const text = $<HTMLTextAreaElement>('#hg-text', root);
  const textPanel = $('#hg-text-panel', root);
  const filePanel = $('#hg-file-panel', root);
  const fileInput = $<HTMLInputElement>('#hg-file', root);
  const drop = $('#hg-drop', root);
  const fileInfo = $('#hg-file-info', root);
  const status = $('#hg-status', root);
  const upper = $<HTMLInputElement>('#hg-upper', root);
  const compare = $<HTMLInputElement>('#hg-compare', root);
  const compareResult = $('#hg-compare-result', root);
  const outputs = $$<HTMLInputElement>('input[data-alg]', root);
  const sourceRadios = $$<HTMLInputElement>('input[name="hg-source"]', root);
  const encoder = new TextEncoder();

  let digests: Record<Algorithm, Uint8Array> | null = null;
  let fileDigests: Record<Algorithm, Uint8Array> | null = null;
  let textDigests: Record<Algorithm, Uint8Array> | null = null;
  let run = 0;

  const source = () => (sourceRadios.find((r) => r.checked)?.value ?? 'text') as 'text' | 'file';

  function setStatus(kind: '' | 'error', message: string) {
    status.className = kind ? `notice ${kind}` : 'notice';
    status.textContent = message;
    status.hidden = message === '';
  }

  function show() {
    const hex: Partial<Record<Algorithm, string>> = {};
    for (const out of outputs) {
      const alg = out.dataset.alg as Algorithm;
      out.value = digests ? toHex(digests[alg], upper.checked) : '';
      hex[alg] = out.value;
    }
    compareResult.hidden = true;
    if (!digests || compare.value.trim() === '') return;
    const match = findMatch(compare.value, hex);
    compareResult.className = match ? 'notice ok' : 'notice error';
    compareResult.textContent = match ? t(s.match, { alg: match }) : s.noMatch;
    compareResult.hidden = false;
  }

  async function hashText() {
    const id = ++run;
    if (text.value === '') {
      textDigests = null;
    } else {
      const result = await hashAll(encoder.encode(text.value));
      if (id !== run) return;
      textDigests = result;
    }
    digests = textDigests;
    show();
  }

  async function hashFile(file: File) {
    const id = ++run;
    fileInfo.textContent = t(s.fileInfo, { name: file.name, size: formatBytes(file.size, locale) });
    setStatus('', s.working);
    digests = fileDigests = null;
    show();
    try {
      const data = new Uint8Array(await file.arrayBuffer());
      const result = await hashAll(data);
      if (id !== run) return;
      digests = fileDigests = result;
      setStatus('', '');
    } catch {
      if (id !== run) return;
      setStatus('error', s.readError);
    }
    show();
  }

  function switchSource() {
    const src = source();
    savePref('hash-generator', { source: src, upper: upper.checked });
    textPanel.hidden = src !== 'text';
    filePanel.hidden = src !== 'file';
    run++;
    setStatus('', '');
    digests = src === 'text' ? textDigests : fileDigests;
    show();
    if (src === 'text') void hashText();
  }

  const prefs = loadPref('hash-generator', { source: 'text', upper: false });
  sourceRadios.forEach((r) => (r.checked = r.value === prefs.source));
  upper.checked = prefs.upper;

  sourceRadios.forEach((r) => r.addEventListener('change', switchSource));
  upper.addEventListener('change', () => {
    savePref('hash-generator', { source: source(), upper: upper.checked });
    show();
  });
  text.addEventListener('input', debounce(hashText, 120));
  compare.addEventListener('input', show);
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) void hashFile(file);
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    const file = e.dataTransfer?.files[0];
    if (file) void hashFile(file);
  });
  switchSource();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .hg-results {
    display: grid;
    gap: 10px;
  }
  .hg-row {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }
  .hg-alg {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  @media (max-width: 520px) {
    .hg-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .hg-alg {
      grid-column: 1 / -1;
    }
  }
</style>
