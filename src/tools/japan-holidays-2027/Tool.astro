---
import type { ToolProps } from '../../i18n/tool';
import HolidayCalendarJa from '../japan-holidays-2026/HolidayCalendarJa.astro';
import { DATA_2027 } from './logic';

type Props = ToolProps;
---

<HolidayCalendarJa
  slug="japan-holidays-2027"
  data={DATA_2027}
  summary="国民の祝日16日と、春分の日（3月21日・日曜日）の振替休日3月22日の計17日が休みです。ゴールデンウィークは5月1日〜5日の5連休で、2027年はシルバーウィークがありません。"
  notice="祝日・休日は内閣府「国民の祝日について」に掲載された令和9年（2027年）の一覧に基づいています。春分の日（3月21日）と秋分の日（9月23日）は、国立天文台が2026年2月2日に発表した「令和9年（2027）暦要項」で確定しています。年末年始（12月29日〜1月3日）は「行政機関の休日に関する法律」による官公庁の休みで、国民の祝日ではありません。"
/>
