---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';
import JaPrompt from './JaPrompt.astro';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const c = s.client;
const def = c.lang[c.langs[0]]!;
const opts = c.langs.map((l) => ({ value: l, label: c.lang[l]!.option }));
---

<div class="tool" data-tool="typing-test" {...i18nAttrs(locale, c)}>
  <div class="tt-controls">
    {opts.length > 1 && (
    <div class="seg" role="radiogroup" aria-label={s.langAria}>
      <label><input type="radio" name="tt-lang" value={opts[0].value} checked /><span>{opts[0].label}</span></label>
      <label><input type="radio" name="tt-lang" value={opts[1].value} /><span>{opts[1].label}</span></label>
    </div>
    )}
    <div class="seg" role="radiogroup" aria-label={s.durAria}>
      <label><input type="radio" name="tt-dur" value="30" /><span>{s.durLabels['30']}</span></label>
      <label><input type="radio" name="tt-dur" value="60" checked /><span>{s.durLabels['60']}</span></label>
      <label><input type="radio" name="tt-dur" value="120" /><span>{s.durLabels['120']}</span></label>
    </div>
    <label class="check" id="tt-punct-wrap" hidden={!c.langs.includes('zh')}><input id="tt-punct" type="checkbox" checked /> {s.punct}</label>
  </div>

  <div class="tt-live" aria-live="off">
    <div class="tt-clock">
      <span class="tt-clock-value" id="tt-clock">1:00</span>
      <span class="stat-label">{s.clockLabel}</span>
    </div>
    <div class="stat"><span class="stat-value" id="tt-speed">0</span><span class="stat-label" id="tt-speed-label">{def.unit}</span></div>
    <div class="stat"><span class="stat-value" id="tt-acc">—</span><span class="stat-label">{s.accLabel}</span></div>
    <div class="stat"><span class="stat-value" id="tt-err">0</span><span class="stat-label">{s.errLabel}</span></div>
  </div>
  <div class="tt-progress" aria-hidden="true"><div class="tt-progress-bar" id="tt-bar"></div></div>

  <div class="tt-passage" id="tt-passage" lang={def.tag} aria-label={s.passageAria}></div>{s.ja && <JaPrompt label={s.ja.boxAria} />}

  <div class="field">
    <label for="tt-input" id="tt-input-label">{def.inputLabel}</label>
    <textarea
      id="tt-input"
      rows="3"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder={def.placeholder}></textarea>
    <span class="hint" id="tt-hint">{def.hint}</span>
  </div>

  <div class="row">
    <button class="btn" type="button" id="tt-restart">{s.restart}</button>
    <button class="btn ghost" type="button" id="tt-new">{s.newText}</button>
  </div>

  <section class="tt-result" id="tt-result" aria-live="polite" hidden>
    <div class="tt-result-head">
      <div>
        <span class="result-label" id="tt-r-title">{s.resultTitle}</span>
        <div class="tt-result-speed"><span id="tt-r-speed">0</span><small id="tt-r-unit">{def.unit}</small></div>
      </div>
      <div class="tt-badges">
        <span class="tt-rank" id="tt-r-rank"></span>
        <span class="tt-record" id="tt-r-record" hidden>{s.record}</span>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><span class="stat-value" id="tt-r-acc">—</span><span class="stat-label">{s.accLabel}</span></div>
      <div class="stat"><span class="stat-value" id="tt-r-correct">0</span><span class="stat-label" id="tt-r-correct-label">{def.correctLabel}</span></div>
      <div class="stat"><span class="stat-value" id="tt-r-errors">0</span><span class="stat-label">{s.errorsLabel}</span></div>
      <div class="stat" id="tt-r-extra-wrap"><span class="stat-value" id="tt-r-extra">0</span><span class="stat-label" id="tt-r-extra-label">{t(def.extraLabel, { cpm: 0 })}</span></div>
    </div>
    <p class="hint" id="tt-r-best"></p>
    <div class="row">
      <button class="btn primary" type="button" id="tt-again">{s.again}</button>
      <button class="btn" type="button" data-copy="#tt-r-summary">{s.copyResult}</button>
      <span class="visually-hidden" id="tt-r-summary"></span>
    </div>
  </section>

  <div class="tt-bests">
    <span class="label">{s.bestsLabel}</span>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>{s.thMode}</th><th class="num">{s.durLabels['30']}</th><th class="num">{s.durLabels['60']}</th><th class="num">{s.durLabels['120']}</th></tr></thead>
        <tbody id="tt-bests"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber } from '../../lib/format';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import {
    bestKey,
    buildPassage,
    compareTyped,
    DURATIONS,
    formatClock,
    JA_SENTENCES,
    mergeBest,
    rankOf,
    RomajiSession,
    sentenceFeed,
    targetLength,
    TypingSession,
    type BestMap,
    type CharState,
    type JaSentence,
    type Lang,
    type TypingResult,
  } from './logic';
  import type { DurationKey, LangStrings, Strings } from './i18n';

  interface Prefs {
    lang: Lang;
    duration: number;
    punctuation: boolean;
  }

  const root = $('[data-tool="typing-test"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  /** Strings for a test language, in this page's locale. */
  const L = (lang: Lang) => s.lang[lang] as LangStrings;
  const defaults: Prefs = { lang: s.langs[0], duration: 60, punctuation: true };
  const nextJaSentence = sentenceFeed(JA_SENTENCES);

  const passageEl = $('#tt-passage', root);
  const input = $<HTMLTextAreaElement>('#tt-input', root);
  const inputLabel = $('#tt-input-label', root);
  const hint = $('#tt-hint', root);
  const clock = $('#tt-clock', root);
  const bar = $('#tt-bar', root);
  const liveSpeed = $('#tt-speed', root);
  const liveSpeedLabel = $('#tt-speed-label', root);
  const liveAcc = $('#tt-acc', root);
  const liveErr = $('#tt-err', root);
  const punct = $<HTMLInputElement>('#tt-punct', root);
  const punctWrap = $('#tt-punct-wrap', root);
  const resultBox = $('#tt-result', root);
  const bestsBody = $('#tt-bests', root);
  // Japanese romaji mode (ja locale only).
  const jaBox = root.querySelector<HTMLElement>('#tt-ja');
  const jaText = jaBox?.querySelector<HTMLElement>('#tt-ja-text');
  const [jaKanaDone, jaKanaRest] = jaBox ? Array.from(jaBox.querySelectorAll<HTMLElement>('#tt-ja-kana span')) : [];
  const [jaRomaDone, jaRomaCur, jaRomaRest] = jaBox ? Array.from(jaBox.querySelectorAll<HTMLElement>('#tt-ja-roma span')) : [];

  let prefs: Prefs = { ...defaults, ...loadPref<Partial<Prefs>>('typing-test', {}) };
  if (!DURATIONS.includes(prefs.duration as (typeof DURATIONS)[number])) prefs.duration = 60;
  if (!s.langs.includes(prefs.lang)) prefs.lang = s.langs[0];
  let bests = loadPref<BestMap>('typing-test:best', {});

  let session: TypingSession;
  let ja: RomajiSession | null = null;
  /** The running attempt: `session` (zh / en) or `ja`. */
  let active: TypingSession | RomajiSession;
  /** Japanese mode: input value already fed to the matcher (kept while an IME / keyboard composes). */
  let jaFed = '';
  let missTimer: number | undefined;
  let spans: HTMLSpanElement[] = [];
  let states: CharState[] = [];
  let composing = false;
  let timer: number | undefined;
  let lastCurrent = -1;

  // ---------- Prefs ----------
  function readPrefs(): Prefs {
    const picked = root.querySelector<HTMLInputElement>('input[name="tt-lang"]:checked')?.value as Lang | undefined;
    const lang = picked && s.langs.includes(picked) ? picked : s.langs[0];
    const duration = Number($<HTMLInputElement>('input[name="tt-dur"]:checked', root).value);
    return { lang, duration, punctuation: punct.checked };
  }

  function applyPrefs(p: Prefs) {
    const set = (name: string, value: string) => {
      const el = root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (el) el.checked = true;
    };
    set('tt-lang', p.lang);
    set('tt-dur', String(p.duration));
    punct.checked = p.punctuation;
  }

  // ---------- Passage rendering ----------
  function appendSpans(text: string) {
    const frag = document.createDocumentFragment();
    for (const ch of text) {
      const span = document.createElement('span');
      span.textContent = ch;
      if (ch === ' ') span.className = 'sp';
      frag.append(span);
      spans.push(span);
      states.push('pending');
    }
    passageEl.append(frag);
  }

  function paint(typed: string) {
    const next = compareTyped(typed, session.passage, session.lang);
    for (let i = 0; i < next.length; i++) {
      if (next[i] !== states[i]) {
        spans[i].classList.toggle('ok', next[i] === 'correct');
        spans[i].classList.toggle('bad', next[i] === 'wrong');
        states[i] = next[i];
      }
    }
    const current = Math.min(typed.length, spans.length - 1);
    if (current !== lastCurrent) {
      spans[lastCurrent]?.classList.remove('cur');
      spans[current]?.classList.add('cur');
      lastCurrent = current;
      keepInView(spans[current]);
    }
  }

  /** Scrolls the passage box so the current line stays on the second visible line. */
  function keepInView(span: HTMLSpanElement | undefined) {
    if (!span) return;
    const style = getComputedStyle(passageEl);
    const line = parseFloat(style.lineHeight) || 36;
    const pad = parseFloat(style.paddingTop) || 0;
    // The passage box is position: relative, so offsetTop is already measured from it.
    const row = Math.floor((span.offsetTop - pad + 1) / line);
    // Keep four whole lines visible with the current one on the second row. Stopping a little
    // short (inside the previous line's empty leading) keeps a visual gap at the top edge.
    const leading = Math.max(0, (line - (parseFloat(style.fontSize) || 20) * 1.3) / 2);
    const target = row <= 1 ? 0 : (row - 1) * line + pad - Math.min(pad, leading);
    if (Math.abs(passageEl.scrollTop - target) > 2) passageEl.scrollTop = target;
  }

  /** Adds more passage text when the typist gets close to the end. */
  function ensureRunway(typedLength: number) {
    const runway = session.lang === 'zh' ? 40 : 120;
    if (session.passage.length - typedLength > runway) return;
    const more = buildPassage({ lang: session.lang, punctuation: prefs.punctuation }, runway * 2, undefined, session.passage);
    session.extend(more);
    appendSpans(more);
  }

  // ---------- Session lifecycle ----------
  function reset(newPassage: boolean) {
    window.clearInterval(timer);
    prefs = readPrefs();
    savePref('typing-test', prefs);
    if (prefs.lang === 'ja') {
      resetJa(newPassage);
      return;
    }
    if (jaBox) jaBox.hidden = true;
    passageEl.hidden = false;
    const keep = !newPassage && session && session.lang === prefs.lang ? session.passage : null;
    const passage =
      keep && keep.length >= targetLength(prefs.lang, prefs.duration) && hasPunctuationSetting(keep)
        ? keep
        : buildPassage({ lang: prefs.lang, punctuation: prefs.punctuation }, targetLength(prefs.lang, prefs.duration));
    session = new TypingSession(passage, prefs.lang, prefs.duration * 1000);
    active = session;

    passageEl.replaceChildren();
    passageEl.lang = L(prefs.lang).tag;
    passageEl.classList.toggle('is-en', prefs.lang === 'en');
    passageEl.scrollTop = 0;
    spans = [];
    states = [];
    lastCurrent = -1;
    appendSpans(passage);
    paint('');

    resetInput();
    updateLive();
  }

  /** Input box, labels and live stats for the current test language. */
  function resetInput() {
    const strings = L(prefs.lang);
    composing = false;
    jaFed = '';
    input.value = '';
    input.readOnly = false;
    input.lang = strings.tag;
    input.placeholder = strings.placeholder;
    inputLabel.textContent = strings.inputLabel;
    hint.textContent = strings.hint;
    punctWrap.hidden = prefs.lang !== 'zh';
    resultBox.hidden = true;
    root.classList.remove('is-running', 'is-finished');
    liveSpeedLabel.textContent = strings.unit;
  }

  // ---------- Japanese romaji mode ----------
  function resetJa(newSentence: boolean) {
    const keep: JaSentence | null = !newSentence && ja ? ja.sentence : null;
    let first = true;
    ja = new RomajiSession(() => {
      const next = first && keep ? keep : nextJaSentence();
      first = false;
      return next;
    }, prefs.duration * 1000);
    active = ja;
    passageEl.hidden = true;
    if (jaBox) jaBox.hidden = false;
    resetInput();
    paintJa();
    updateLive();
  }

  function paintJa() {
    if (!ja || !jaText) return;
    const m = ja.matcher;
    const kana = ja.sentence.kana;
    jaText.textContent = ja.sentence.text;
    jaKanaDone.textContent = kana.slice(0, m.kanaDone);
    jaKanaRest.textContent = kana.slice(m.kanaDone);
    const rest = m.rest();
    jaRomaDone.textContent = m.typed;
    jaRomaCur.textContent = rest.slice(0, 1);
    jaRomaRest.textContent = rest.slice(1);
  }

  function flashMiss() {
    if (!jaBox) return;
    jaBox.classList.remove('is-miss');
    void jaBox.offsetWidth; // restart the animation
    jaBox.classList.add('is-miss');
    window.clearTimeout(missTimer);
    missTimer = window.setTimeout(() => jaBox.classList.remove('is-miss'), 300);
  }

  /** Feeds newly typed characters to the romaji matcher. Kana (IME on) are not counted; a hint explains. */
  function jaInput(stillComposing: boolean) {
    if (!ja) return;
    const value = input.value;
    const fresh = value.startsWith(jaFed) ? value.slice(jaFed.length) : '';
    jaFed = value;
    let sawKana = false;
    for (const ch of fresh) {
      if (/^[\x21-\x7e ]$/.test(ch)) jaKey(ch);
      else if (!/\s/.test(ch)) sawKana = true;
    }
    if (sawKana && s.imeWarning) hint.textContent = s.imeWarning;
    if (!stillComposing || ja.phase === 'finished') {
      input.value = '';
      jaFed = '';
    }
  }

  function jaKey(ch: string) {
    if (!ja || ja.phase === 'finished') return;
    const now = performance.now();
    if (ja.phase === 'idle') begin();
    if (ja.key(ch, now) === 'miss') flashMiss();
    paintJa();
    if (ja.isOver(now)) end();
    else updateLive();
  }

  /** Reuse the current text only if it matches the punctuation setting. */
  function hasPunctuationSetting(text: string): boolean {
    if (prefs.lang !== 'zh') return true;
    return /[，。]/.test(text) === prefs.punctuation;
  }

  function begin() {
    if (active.phase !== 'idle') return;
    active.start(performance.now());
    root.classList.add('is-running');
    timer = window.setInterval(onTick, 100);
  }

  function onTick() {
    const now = performance.now();
    if (active.isOver(now)) end();
    else updateLive();
  }

  function commit() {
    if (session.phase === 'finished') return;
    const now = performance.now();
    if (session.phase === 'idle') begin();
    ensureRunway(input.value.length);
    session.commit(input.value, now);
    paint(session.committed);
    if (session.isOver(now)) end();
    else updateLive();
  }

  function updateLive() {
    const now = performance.now();
    const remaining = active.remaining(now);
    clock.textContent = formatClock(remaining);
    bar.style.transform = `scaleX(${1 - remaining / active.durationMs})`;
    const r = active.result(now);
    // The first two seconds are too short for a stable rate.
    liveSpeed.textContent = active.elapsed(now) >= 2000 ? formatInteger(r.speed, locale) : '0';
    const entries = active instanceof RomajiSession ? r.typedChars : active.entries;
    liveAcc.textContent = entries > 0 ? `${formatNumber(r.accuracy, 1, locale)}%` : '—';
    liveErr.textContent = formatInteger(r.errors, locale);
  }

  function end() {
    window.clearInterval(timer);
    const now = performance.now();
    // Whatever is still being composed by the IME at the bell is not counted.
    const result = active.finish(now);
    input.readOnly = true;
    root.classList.remove('is-running');
    root.classList.add('is-finished');
    updateLive();
    showResult(result);
  }

  function showResult(r: TypingResult) {
    const lang = r.lang;
    const seconds = active.durationMs / 1000;
    const dur = s.durPhrase[String(seconds) as DurationKey];
    const st = L(lang);
    const key = bestKey(lang, seconds);
    const merged = mergeBest(bests, key, r, new Date().toISOString().slice(0, 10));
    if (merged.isNew) {
      bests = merged.best;
      savePref('typing-test:best', bests);
    }
    const rank = rankOf(lang, r.speed);

    $('#tt-r-title', root).textContent = t(s.resultTitle, { lang: st.name, s: seconds, dur });
    $('#tt-r-speed', root).textContent = formatInteger(r.speed, locale);
    $('#tt-r-unit', root).textContent = st.unit;
    $('#tt-r-rank', root).textContent = s.ranks[rank.level] ?? rank.label;
    $('#tt-r-rank', root).dataset.level = String(rank.level);
    $('#tt-r-record', root).hidden = !merged.isNew;
    $('#tt-r-acc', root).textContent = `${formatNumber(r.accuracy, 1, locale)}%`;
    $('#tt-r-correct', root).textContent = formatInteger(r.correctChars, locale);
    $('#tt-r-correct-label', root).textContent = st.correctLabel;
    $('#tt-r-errors', root).textContent = formatInteger(r.errors, locale);
    if (lang === 'en') {
      $('#tt-r-extra', root).textContent = formatInteger(r.rawWpm, locale);
      $('#tt-r-extra-label', root).textContent = t(st.extraLabel, { cpm: formatInteger(r.cpm, locale) });
    } else if (lang === 'ja') {
      $('#tt-r-extra', root).textContent = formatInteger(ja?.completed ?? 0, locale);
      $('#tt-r-extra-label', root).textContent = st.extraLabel;
    } else {
      $('#tt-r-extra', root).textContent = formatInteger(r.uncorrected, locale);
      $('#tt-r-extra-label', root).textContent = st.extraLabel;
    }
    const best = bests[key];
    const vars = { lang: st.name, s: seconds, dur, unit: st.unit };
    $('#tt-r-best', root).textContent = best
      ? t(s.best, { ...vars, speed: best.speed, acc: best.accuracy, date: best.date })
      : '';
    $('#tt-r-summary', root).textContent = t(s.summary, {
      ...vars,
      speed: formatInteger(r.speed, locale),
      acc: formatNumber(r.accuracy, 1, locale),
    });

    resultBox.hidden = false;
    renderBests();
    resultBox.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    $<HTMLButtonElement>('#tt-again', root).focus({ preventScroll: true });
  }

  function renderBests() {
    bestsBody.replaceChildren(
      ...s.langs.map((lang) => {
        const tr = document.createElement('tr');
        const th = document.createElement('td');
        th.textContent = t(s.bestRow, { lang: L(lang).name, unit: L(lang).unit });
        tr.append(th);
        for (const d of DURATIONS) {
          const td = document.createElement('td');
          td.className = 'num';
          const b = bests[bestKey(lang, d)];
          td.textContent = b ? String(b.speed) : '—';
          if (b) td.title = t(s.bestTitle, { acc: b.accuracy, date: b.date });
          tr.append(td);
        }
        return tr;
      }),
    );
  }

  // ---------- Input events ----------
  input.addEventListener('compositionstart', () => {
    composing = true;
    if (active === ja) return; // romaji mode: only typed letters start the clock
    if (session.phase === 'idle') begin();
  });
  input.addEventListener('compositionend', () => {
    composing = false;
    if (active === ja) jaInput(false);
    else commit();
  });
  input.addEventListener('input', (event) => {
    if (active === ja) {
      jaInput(composing || (event as InputEvent).isComposing);
      return;
    }
    if (composing || (event as InputEvent).isComposing) {
      if (session.phase === 'idle') begin();
      // Latin keyboards on Android also compose; their text is final, so show it (not counted yet).
      if (session.lang === 'en') paint(input.value.slice(0, session.passage.length));
      return;
    }
    commit();
  });
  input.addEventListener('paste', (e) => e.preventDefault());
  input.addEventListener('drop', (e) => e.preventDefault());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !composing && !e.isComposing) e.preventDefault(); // passages have no line breaks
  });

  root.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !composing) {
      e.preventDefault();
      reset(false);
      input.focus();
    }
  });
  passageEl.addEventListener('click', () => input.focus());
  jaBox?.addEventListener('click', () => input.focus());

  root.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('input[name="tt-lang"], input[name="tt-dur"], #tt-punct')) reset(true);
  });

  $('#tt-restart', root).addEventListener('click', () => {
    reset(false);
    input.focus();
  });
  $('#tt-new', root).addEventListener('click', () => {
    reset(true);
    input.focus();
  });
  $('#tt-again', root).addEventListener('click', () => {
    reset(true);
    input.focus({ preventScroll: true });
    input.scrollIntoView({ block: 'center', behavior: 'auto' });
  });

  // Leaving the page mid-test simply stops the clock display; nothing is sent anywhere.
  window.addEventListener('pagehide', () => window.clearInterval(timer));

  applyPrefs(prefs);
  reset(true);
  renderBests();
</script>

<style>
  .tt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .tt-live {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 10px;
  }
  @media (max-width: 520px) {
    .tt-live {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .tt-clock {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .tt-clock-value {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .tt-progress {
    height: 4px;
    margin-top: -8px;
    border-radius: 2px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .tt-progress-bar {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .tt-passage {
    --line: 2.1em;
    position: relative;
    height: calc(var(--line) * 4 + 14px);
    overflow: hidden;
    padding: 14px 16px 0;
    font-size: 22px;
    line-height: var(--line);
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--muted);
    cursor: text;
    user-select: none;
