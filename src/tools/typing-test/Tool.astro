<div class="tool" data-tool="typing-test">
  <div class="tt-controls">
    <div class="seg" role="radiogroup" aria-label="測驗語言">
      <label><input type="radio" name="tt-lang" value="zh" checked /><span>中文</span></label>
      <label><input type="radio" name="tt-lang" value="en" /><span>English</span></label>
    </div>
    <div class="seg" role="radiogroup" aria-label="測驗時間">
      <label><input type="radio" name="tt-dur" value="30" /><span>30 秒</span></label>
      <label><input type="radio" name="tt-dur" value="60" checked /><span>60 秒</span></label>
      <label><input type="radio" name="tt-dur" value="120" /><span>120 秒</span></label>
    </div>
    <label class="check" id="tt-punct-wrap"><input id="tt-punct" type="checkbox" checked /> 含標點符號</label>
  </div>

  <div class="tt-live" aria-live="off">
    <div class="tt-clock">
      <span class="tt-clock-value" id="tt-clock">1:00</span>
      <span class="stat-label">剩餘時間</span>
    </div>
    <div class="stat"><span class="stat-value" id="tt-speed">0</span><span class="stat-label" id="tt-speed-label">字/分</span></div>
    <div class="stat"><span class="stat-value" id="tt-acc">—</span><span class="stat-label">正確率</span></div>
    <div class="stat"><span class="stat-value" id="tt-err">0</span><span class="stat-label">錯誤</span></div>
  </div>
  <div class="tt-progress" aria-hidden="true"><div class="tt-progress-bar" id="tt-bar"></div></div>

  <div class="tt-passage" id="tt-passage" lang="zh-Hant" aria-label="測驗文章，請照著輸入"></div>

  <div class="field">
    <label for="tt-input" id="tt-input-label">在這裡輸入（打下第一個字就開始計時）</label>
    <textarea
      id="tt-input"
      rows="3"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="照著上方文章輸入，可使用注音、倉頡、拼音或嘸蝦米輸入法"></textarea>
    <span class="hint" id="tt-hint">選字中的注音或字根不會被計算，送出（選定）的字才算數；按 Esc 可重新開始。</span>
  </div>

  <div class="row">
    <button class="btn" type="button" id="tt-restart">重新開始</button>
    <button class="btn ghost" type="button" id="tt-new">換一篇文章</button>
  </div>

  <section class="tt-result" id="tt-result" aria-live="polite" hidden>
    <div class="tt-result-head">
      <div>
        <span class="result-label" id="tt-r-title">測驗結果</span>
        <div class="tt-result-speed"><span id="tt-r-speed">0</span><small id="tt-r-unit">字/分</small></div>
      </div>
      <div class="tt-badges">
        <span class="tt-rank" id="tt-r-rank"></span>
        <span class="tt-record" id="tt-r-record" hidden>新紀錄</span>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><span class="stat-value" id="tt-r-acc">—</span><span class="stat-label">正確率</span></div>
      <div class="stat"><span class="stat-value" id="tt-r-correct">0</span><span class="stat-label" id="tt-r-correct-label">正確字數</span></div>
      <div class="stat"><span class="stat-value" id="tt-r-errors">0</span><span class="stat-label">錯誤次數（含已修正）</span></div>
      <div class="stat" id="tt-r-extra-wrap"><span class="stat-value" id="tt-r-extra">0</span><span class="stat-label" id="tt-r-extra-label">未修正錯字</span></div>
    </div>
    <p class="hint" id="tt-r-best"></p>
    <div class="row">
      <button class="btn primary" type="button" id="tt-again">再測一次</button>
      <button class="btn" type="button" data-copy="#tt-r-summary">複製成績</button>
      <span class="visually-hidden" id="tt-r-summary"></span>
    </div>
  </section>

  <div class="tt-bests">
    <span class="label">你的最佳紀錄（只存在這台裝置）</span>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>模式</th><th class="num">30 秒</th><th class="num">60 秒</th><th class="num">120 秒</th></tr></thead>
        <tbody id="tt-bests"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber } from '../../lib/format';
  import {
    bestKey,
    buildPassage,
    compareTyped,
    DURATIONS,
    formatClock,
    mergeBest,
    rankOf,
    targetLength,
    TypingSession,
    type BestMap,
    type CharState,
    type Lang,
    type TypingResult,
  } from './logic';

  interface Prefs {
    lang: Lang;
    duration: number;
    punctuation: boolean;
  }

  const defaults: Prefs = { lang: 'zh', duration: 60, punctuation: true };
  const UNIT: Record<Lang, string> = { zh: '字/分', en: 'WPM' };
  const LANG_NAME: Record<Lang, string> = { zh: '中文', en: '英文' };

  const root = $('[data-tool="typing-test"]');
  const passageEl = $('#tt-passage', root);
  const input = $<HTMLTextAreaElement>('#tt-input', root);
  const inputLabel = $('#tt-input-label', root);
  const hint = $('#tt-hint', root);
  const clock = $('#tt-clock', root);
  const bar = $('#tt-bar', root);
  const liveSpeed = $('#tt-speed', root);
  const liveSpeedLabel = $('#tt-speed-label', root);
  const liveAcc = $('#tt-acc', root);
  const liveErr = $('#tt-err', root);
  const punct = $<HTMLInputElement>('#tt-punct', root);
  const punctWrap = $('#tt-punct-wrap', root);
  const resultBox = $('#tt-result', root);
  const bestsBody = $('#tt-bests', root);

  let prefs: Prefs = { ...defaults, ...loadPref<Partial<Prefs>>('typing-test', {}) };
  if (!DURATIONS.includes(prefs.duration as (typeof DURATIONS)[number])) prefs.duration = 60;
  let bests = loadPref<BestMap>('typing-test:best', {});

  let session: TypingSession;
  let spans: HTMLSpanElement[] = [];
  let states: CharState[] = [];
  let composing = false;
  let timer: number | undefined;
  let lastCurrent = -1;

  // ---------- Prefs ----------
  function readPrefs(): Prefs {
    const lang = $<HTMLInputElement>('input[name="tt-lang"]:checked', root).value as Lang;
    const duration = Number($<HTMLInputElement>('input[name="tt-dur"]:checked', root).value);
    return { lang, duration, punctuation: punct.checked };
  }

  function applyPrefs(p: Prefs) {
    const set = (name: string, value: string) => {
      const el = root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (el) el.checked = true;
    };
    set('tt-lang', p.lang);
    set('tt-dur', String(p.duration));
    punct.checked = p.punctuation;
  }

  // ---------- Passage rendering ----------
  function appendSpans(text: string) {
    const frag = document.createDocumentFragment();
    for (const ch of text) {
      const span = document.createElement('span');
      span.textContent = ch;
      if (ch === ' ') span.className = 'sp';
      frag.append(span);
      spans.push(span);
      states.push('pending');
    }
    passageEl.append(frag);
  }

  function paint(typed: string) {
    const next = compareTyped(typed, session.passage, session.lang);
    for (let i = 0; i < next.length; i++) {
      if (next[i] !== states[i]) {
        spans[i].classList.toggle('ok', next[i] === 'correct');
        spans[i].classList.toggle('bad', next[i] === 'wrong');
        states[i] = next[i];
      }
    }
    const current = Math.min(typed.length, spans.length - 1);
    if (current !== lastCurrent) {
      spans[lastCurrent]?.classList.remove('cur');
      spans[current]?.classList.add('cur');
      lastCurrent = current;
      keepInView(spans[current]);
    }
  }

  /** Scrolls the passage box so the current line stays on the second visible line. */
  function keepInView(span: HTMLSpanElement | undefined) {
    if (!span) return;
    const style = getComputedStyle(passageEl);
    const line = parseFloat(style.lineHeight) || 36;
    const pad = parseFloat(style.paddingTop) || 0;
    // The passage box is position: relative, so offsetTop is already measured from it.
    const row = Math.floor((span.offsetTop - pad + 1) / line);
    // Keep four whole lines visible with the current one on the second row. Stopping a little
    // short (inside the previous line's empty leading) keeps a visual gap at the top edge.
    const leading = Math.max(0, (line - (parseFloat(style.fontSize) || 20) * 1.3) / 2);
    const target = row <= 1 ? 0 : (row - 1) * line + pad - Math.min(pad, leading);
    if (Math.abs(passageEl.scrollTop - target) > 2) passageEl.scrollTop = target;
  }

  /** Adds more passage text when the typist gets close to the end. */
  function ensureRunway(typedLength: number) {
    const runway = session.lang === 'zh' ? 40 : 120;
    if (session.passage.length - typedLength > runway) return;
    const more = buildPassage({ lang: session.lang, punctuation: prefs.punctuation }, runway * 2, undefined, session.passage);
    session.extend(more);
    appendSpans(more);
  }

  // ---------- Session lifecycle ----------
  function reset(newPassage: boolean) {
    window.clearInterval(timer);
    prefs = readPrefs();
    savePref('typing-test', prefs);
    const keep = !newPassage && session && session.lang === prefs.lang ? session.passage : null;
    const passage =
      keep && keep.length >= targetLength(prefs.lang, prefs.duration) && hasPunctuationSetting(keep)
        ? keep
        : buildPassage({ lang: prefs.lang, punctuation: prefs.punctuation }, targetLength(prefs.lang, prefs.duration));
    session = new TypingSession(passage, prefs.lang, prefs.duration * 1000);

    passageEl.replaceChildren();
    passageEl.lang = prefs.lang === 'zh' ? 'zh-Hant' : 'en';
    passageEl.classList.toggle('is-en', prefs.lang === 'en');
    passageEl.scrollTop = 0;
    spans = [];
    states = [];
    lastCurrent = -1;
    appendSpans(passage);
    paint('');

    composing = false;
    input.value = '';
    input.readOnly = false;
    input.lang = passageEl.lang;
    input.placeholder =
      prefs.lang === 'zh' ? '照著上方文章輸入，可使用注音、倉頡、拼音或嘸蝦米輸入法' : 'Type the text above. Timer starts on your first key.';
    inputLabel.textContent = '在這裡輸入（打下第一個字就開始計時）';
    hint.textContent =
      prefs.lang === 'zh'
        ? '選字中的注音或字根不會被計算，送出（選定）的字才算數；按 Esc 可重新開始。'
        : '大小寫與標點都要正確；按 Esc 可重新開始。';
    punctWrap.hidden = prefs.lang !== 'zh';
    resultBox.hidden = true;
    root.classList.remove('is-running', 'is-finished');
    liveSpeedLabel.textContent = UNIT[prefs.lang];
    updateLive();
  }

  /** Reuse the current text only if it matches the punctuation setting. */
  function hasPunctuationSetting(text: string): boolean {
    if (prefs.lang !== 'zh') return true;
    return /[，。]/.test(text) === prefs.punctuation;
  }

  function begin() {
    if (session.phase !== 'idle') return;
    session.start(performance.now());
    root.classList.add('is-running');
    timer = window.setInterval(onTick, 100);
  }

  function onTick() {
    const now = performance.now();
    if (session.isOver(now)) end();
    else updateLive();
  }

  function commit() {
    if (session.phase === 'finished') return;
    const now = performance.now();
    if (session.phase === 'idle') begin();
    ensureRunway(input.value.length);
    session.commit(input.value, now);
    paint(session.committed);
    if (session.isOver(now)) end();
    else updateLive();
  }

  function updateLive() {
    const now = performance.now();
    const remaining = session.remaining(now);
    clock.textContent = formatClock(remaining);
    bar.style.transform = `scaleX(${1 - remaining / session.durationMs})`;
    const r = session.result(now);
    // The first two seconds are too short for a stable rate.
    liveSpeed.textContent = session.elapsed(now) >= 2000 ? formatInteger(r.speed) : '0';
    liveAcc.textContent = session.entries > 0 ? `${formatNumber(r.accuracy, 1)}%` : '—';
    liveErr.textContent = formatInteger(session.errors);
  }

  function end() {
    window.clearInterval(timer);
    const now = performance.now();
    // Whatever is still being composed by the IME at the bell is not counted.
    const result = session.finish(now);
    input.readOnly = true;
    root.classList.remove('is-running');
    root.classList.add('is-finished');
    updateLive();
    showResult(result);
  }

  function showResult(r: TypingResult) {
    const lang = session.lang;
    const seconds = session.durationMs / 1000;
    const key = bestKey(lang, seconds);
    const merged = mergeBest(bests, key, r, new Date().toISOString().slice(0, 10));
    if (merged.isNew) {
      bests = merged.best;
      savePref('typing-test:best', bests);
    }
    const rank = rankOf(lang, r.speed);

    $('#tt-r-title', root).textContent = `${LANG_NAME[lang]} ${seconds} 秒測驗結果`;
    $('#tt-r-speed', root).textContent = formatInteger(r.speed);
    $('#tt-r-unit', root).textContent = UNIT[lang];
    $('#tt-r-rank', root).textContent = rank.label;
    $('#tt-r-rank', root).dataset.level = String(rank.level);
    $('#tt-r-record', root).hidden = !merged.isNew;
    $('#tt-r-acc', root).textContent = `${formatNumber(r.accuracy, 1)}%`;
    $('#tt-r-correct', root).textContent = formatInteger(r.correctChars);
    $('#tt-r-correct-label', root).textContent = lang === 'zh' ? '正確字數' : '正確字元';
    $('#tt-r-errors', root).textContent = formatInteger(r.errors);
    if (lang === 'en') {
      $('#tt-r-extra', root).textContent = formatInteger(r.rawWpm);
      $('#tt-r-extra-label', root).textContent = `原始速度 WPM（CPM ${formatInteger(r.cpm)}）`;
    } else {
      $('#tt-r-extra', root).textContent = formatInteger(r.uncorrected);
      $('#tt-r-extra-label', root).textContent = '未修正錯字';
    }
    const best = bests[key];
    $('#tt-r-best', root).textContent = best
      ? `${LANG_NAME[lang]} ${seconds} 秒最佳紀錄：${best.speed} ${UNIT[lang]}，正確率 ${best.accuracy}%（${best.date}）`
      : '';
    $('#tt-r-summary', root).textContent =
      `我的${LANG_NAME[lang]}打字速度：${formatInteger(r.speed)} ${UNIT[lang]}，正確率 ${formatNumber(r.accuracy, 1)}%（${seconds} 秒測驗）`;

    resultBox.hidden = false;
    renderBests();
    resultBox.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    $<HTMLButtonElement>('#tt-again', root).focus({ preventScroll: true });
  }

  function renderBests() {
    bestsBody.replaceChildren(
      ...(['zh', 'en'] as Lang[]).map((lang) => {
        const tr = document.createElement('tr');
        const th = document.createElement('td');
        th.textContent = `${LANG_NAME[lang]}（${UNIT[lang]}）`;
        tr.append(th);
        for (const d of DURATIONS) {
          const td = document.createElement('td');
          td.className = 'num';
          const b = bests[bestKey(lang, d)];
          td.textContent = b ? String(b.speed) : '—';
          if (b) td.title = `正確率 ${b.accuracy}%，${b.date}`;
          tr.append(td);
        }
        return tr;
      }),
    );
  }

  // ---------- Input events ----------
  input.addEventListener('compositionstart', () => {
    composing = true;
    if (session.phase === 'idle') begin();
  });
  input.addEventListener('compositionend', () => {
    composing = false;
    commit();
  });
  input.addEventListener('input', (event) => {
    if (composing || (event as InputEvent).isComposing) {
      if (session.phase === 'idle') begin();
      // Latin keyboards on Android also compose; their text is final, so show it (not counted yet).
      if (session.lang === 'en') paint(input.value.slice(0, session.passage.length));
      return;
    }
    commit();
  });
  input.addEventListener('paste', (e) => e.preventDefault());
  input.addEventListener('drop', (e) => e.preventDefault());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !composing && !e.isComposing) e.preventDefault(); // passages have no line breaks
  });

  root.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !composing) {
      e.preventDefault();
      reset(false);
      input.focus();
    }
  });
  passageEl.addEventListener('click', () => input.focus());

  root.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('input[name="tt-lang"], input[name="tt-dur"], #tt-punct')) reset(true);
  });

  $('#tt-restart', root).addEventListener('click', () => {
    reset(false);
    input.focus();
  });
  $('#tt-new', root).addEventListener('click', () => {
    reset(true);
    input.focus();
  });
  $('#tt-again', root).addEventListener('click', () => {
    reset(true);
    input.focus({ preventScroll: true });
    input.scrollIntoView({ block: 'center', behavior: 'auto' });
  });

  // Leaving the page mid-test simply stops the clock display; nothing is sent anywhere.
  window.addEventListener('pagehide', () => window.clearInterval(timer));

  applyPrefs(prefs);
  reset(true);
  renderBests();
</script>

<style>
  .tt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .tt-live {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 10px;
  }
  @media (max-width: 520px) {
    .tt-live {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .tt-clock {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }
  .tt-clock-value {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .tt-progress {
    height: 4px;
    margin-top: -8px;
    border-radius: 2px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .tt-progress-bar {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .tt-passage {
    --line: 2.1em;
    position: relative;
    height: calc(var(--line) * 4 + 14px);
    overflow: hidden;
    padding: 14px 16px 0;
    font-size: 22px;
    line-height: var(--line);
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--muted);
    cursor: text;
    user-select: none;
    -webkit-user-select: none;
    overflow-wrap: anywhere;
    scroll-behavior: auto;
  }
  .tt-passage.is-en {
    font-family: var(--mono);
    font-size: 19px;
    letter-spacing: 0;
    overflow-wrap: normal;
    word-break: normal;
  }
  @media (max-width: 520px) {
    .tt-passage {
      font-size: 19px;
    }
    .tt-passage.is-en {
      font-size: 16px;
    }
  }
  .tt-passage :global(span) {
    border-radius: 3px;
  }
  .tt-passage :global(.ok) {
    color: var(--text);
  }
  .tt-passage :global(.bad) {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 16%, transparent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .tt-passage :global(.sp.bad) {
    text-decoration: none;
  }
  .tt-passage :global(.cur) {
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-tool='typing-test']:not(.is-running)) .tt-passage :global(.cur) {
      animation: tt-blink 1.1s steps(2, start) infinite;
    }
  }
  @keyframes tt-blink {
    50% {
      box-shadow: inset 0 -3px 0 transparent;
    }
  }

  .tt-result {
    display: grid;
    gap: 14px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .tt-result .stat {
    background: var(--surface);
  }
  .tt-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }
  .tt-result-speed {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: clamp(44px, 12vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .tt-result-speed small {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tt-badges {
    display: flex;
    gap: 8px;
  }
  .tt-rank,
  .tt-record {
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
  }
  .tt-rank[data-level='3'],
  .tt-rank[data-level='4'],
  .tt-rank[data-level='5'] {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }
  .tt-record {
    color: var(--success);
    border-color: var(--success);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tt-result:not([hidden]) {
      animation: tt-in 0.35s ease-out;
    }
  }
  @keyframes tt-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .tt-bests {
    display: grid;
    gap: 6px;
  }
  .tt-bests .label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  #tt-input {
    min-height: 96px;
    font-size: 18px;
  }
  [data-tool='typing-test'].is-finished textarea {
    opacity: 0.6;
  }
</style>
