---
// Japanese romaji mode prompt: sentence, reading and romaji guide. Rendered only on the ja page, so its
// markup and styles never reach the zh-TW / en pages (an is:inline style is emitted only where the component
// renders; a scoped <style> would be bundled into every page that imports Tool.astro). Tool.astro's script fills it in.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="tt-ja" id="tt-ja" lang="ja" role="group" aria-label={label} hidden>
  <p class="tt-ja-text" id="tt-ja-text"></p>
  <p class="tt-ja-kana" id="tt-ja-kana"><span class="ok"></span><span></span></p>
  <p class="tt-ja-roma" id="tt-ja-roma" lang="en"><span class="ok"></span><span class="cur"></span><span></span></p>
</div>

<style is:inline>
  .tt-ja {
    display: grid;
    gap: 6px;
    align-content: center;
    min-height: calc(2.1em * 4 + 14px);
    padding: 16px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    cursor: text;
    user-select: none;
    -webkit-user-select: none;
  }
  .tt-ja[hidden] {
    display: none;
  }
  .tt-ja p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .tt-ja-text {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
  }
  .tt-ja-kana {
    font-size: 15px;
    color: var(--text-2);
  }
  .tt-ja-kana .ok {
    color: var(--muted);
  }
  .tt-ja-roma {
    font-family: var(--mono);
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--muted);
    word-break: break-all;
  }
  .tt-ja-roma .ok {
    color: var(--text);
  }
  .tt-ja-roma .cur {
    color: var(--text);
    border-radius: 3px;
    box-shadow: inset 0 -3px 0 var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .tt-ja.is-miss .tt-ja-roma .cur {
    color: var(--danger);
    box-shadow: inset 0 -3px 0 var(--danger);
    background: color-mix(in oklab, var(--danger) 18%, transparent);
  }
  @media (max-width: 520px) {
    .tt-ja-text {
      font-size: 20px;
    }
    .tt-ja-roma {
      font-size: 17px;
    }
  }
</style>
