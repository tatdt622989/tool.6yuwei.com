---
// ja-only tool: strings are written in Japanese here (see docs/i18n.md §3).
import type { ToolProps } from '../../i18n/tool';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;
---

<div class="tool" data-tool="daily-proration" data-locale={locale}>
  <div class="seg" role="radiogroup" aria-label="計算の種類">
    <label><input type="radio" name="dp-kind" value="rent" checked /><span>家賃・月額料金</span></label>
    <label><input type="radio" name="dp-kind" value="salary" /><span>給与</span></label>
  </div>

  <!-- 家賃・月額料金 -->
  <div class="dp-pane" id="dp-rent">
    <div class="grid-2">
      <div class="field">
        <label for="dp-rent-amount">家賃（月額・円）</label>
        <input id="dp-rent-amount" type="text" inputmode="numeric" autocomplete="off" value="80,000" />
      </div>
      <div class="field">
        <label for="dp-fee-amount">管理費・共益費（月額・円）</label>
        <input id="dp-fee-amount" type="text" inputmode="numeric" autocomplete="off" placeholder="0" />
      </div>
    </div>

    <div class="field">
      <span class="label">日割りする期間</span>
      <div class="seg" role="radiogroup" aria-label="日割りする期間">
        <label><input type="radio" name="dp-period" value="in" checked /><span>入居日から月末</span></label>
        <label><input type="radio" name="dp-period" value="out" /><span>月初から退去日</span></label>
        <label><input type="radio" name="dp-period" value="range" /><span>期間を指定</span></label>
      </div>
    </div>

    <div class="grid-2">
      <div class="field" id="dp-start-field">
        <label for="dp-start" id="dp-start-label">入居日</label>
        <input id="dp-start" type="date" />
      </div>
      <div class="field" id="dp-end-field" hidden>
        <label for="dp-end" id="dp-end-label">終了日</label>
        <input id="dp-end" type="date" />
      </div>
    </div>

    <div class="field">
      <span class="label">1日あたりの計算方法</span>
      <div class="seg" role="radiogroup" aria-label="1日あたりの計算方法">
        <label><input type="radio" name="dp-basis" value="calendar" checked /><span>その月の日数</span></label>
        <label><input type="radio" name="dp-basis" value="30" /><span>30日で割る</span></label>
        <label><input type="radio" name="dp-basis" value="365" /><span>年額÷365日</span></label>
      </div>
    </div>

    <div class="field">
      <span class="label">1円未満の端数</span>
      <div class="seg" role="radiogroup" aria-label="1円未満の端数">
        <label><input type="radio" name="dp-round" value="floor" checked /><span>切り捨て</span></label>
        <label><input type="radio" name="dp-round" value="round" /><span>四捨五入</span></label>
        <label><input type="radio" name="dp-round" value="ceil" /><span>切り上げ</span></label>
      </div>
      <label class="check"><input type="checkbox" id="dp-daily-first" /> 日額を先に端数処理してから日数を掛ける</label>
    </div>

    <p class="notice error" id="dp-rent-error" hidden></p>

    <div class="result" aria-live="polite">
      <div class="result-value" id="dp-total">—</div>
      <div class="result-label" id="dp-total-label"></div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="dp-days">—</span><span class="stat-label">日割りの日数</span></div>
      <div class="stat"><span class="stat-value" id="dp-daily">—</span><span class="stat-label" id="dp-daily-label">家賃の日額</span></div>
      <div class="stat"><span class="stat-value" id="dp-rent-part">—</span><span class="stat-label">家賃の日割り</span></div>
      <div class="stat"><span class="stat-value" id="dp-fee-part">—</span><span class="stat-label">管理費・共益費の日割り</span></div>
    </div>

    <div class="output" id="dp-formula" aria-label="計算式"></div>

    <div class="field" id="dp-months-field" hidden>
      <span class="label">月ごとの内訳</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>月</th><th class="num">日数</th><th class="num">家賃</th><th class="num">管理費等</th><th class="num">小計</th></tr>
          </thead>
          <tbody id="dp-months"></tbody>
        </table>
      </div>
      <span class="hint">1か月まるごと含まれる月は、日割りせず月額をそのまま計上しています。</span>
    </div>

    <div class="field">
      <span class="label">計算方法による違い（家賃＋管理費等）</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>計算方法</th><th class="num">日割り額</th><th class="num">差額</th></tr>
          </thead>
          <tbody id="dp-compare"></tbody>
        </table>
      </div>
      <span class="hint">どの方法を使うかは賃貸借契約書で決まります。「日割り計算」の欄や特約を確認してください。</span>
    </div>
  </div>

  <!-- 給与 -->
  <div class="dp-pane" id="dp-salary" hidden>
    <div class="field">
      <label for="dp-salary-amount">月給（日割りの対象になる額・円）</label>
      <input id="dp-salary-amount" type="text" inputmode="numeric" autocomplete="off" value="300,000" />
      <span class="hint">基本給と、日割りの対象になる手当の合計を入れてください。通勤手当などは会社の規程により扱いが異なります。</span>
    </div>

    <div class="field">
      <span class="label">基準日数（何日で割るか）</span>
      <div class="seg" role="radiogroup" aria-label="基準日数の決め方">
        <label><input type="radio" name="dp-sbasis" value="calendar" checked /><span>暦日数</span></label>
        <label><input type="radio" name="dp-sbasis" value="scheduled" /><span>その月の所定労働日数</span></label>
        <label><input type="radio" name="dp-sbasis" value="average" /><span>月平均所定労働日数</span></label>
      </div>
    </div>

    <div class="grid-2">
      <div class="field" id="dp-month-field">
        <label for="dp-month">対象の月</label>
        <input id="dp-month" type="month" />
      </div>
      <div class="field">
        <label for="dp-sbase" id="dp-sbase-label">基準日数</label>
        <input id="dp-sbase" type="text" inputmode="decimal" autocomplete="off" value="31" />
      </div>
      <div class="field">
        <label for="dp-sdays" id="dp-sdays-label">在籍日数</label>
        <input id="dp-sdays" type="text" inputmode="decimal" autocomplete="off" value="20" />
      </div>
      <div class="field">
        <span class="label">1円未満の端数</span>
        <div class="seg" role="radiogroup" aria-label="給与の端数処理">
          <label><input type="radio" name="dp-sround" value="floor" checked /><span>切り捨て</span></label>
          <label><input type="radio" name="dp-sround" value="round" /><span>四捨五入</span></label>
          <label><input type="radio" name="dp-sround" value="ceil" /><span>切り上げ</span></label>
        </div>
      </div>
    </div>

    <p class="notice error" id="dp-salary-error" hidden></p>

    <div class="result" aria-live="polite">
      <div class="result-value" id="dp-salary-total">—</div>
      <div class="result-label" id="dp-salary-label"></div>
    </div>
    <div class="output" id="dp-salary-formula" aria-label="計算式"></div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { isLocale } from '../../i18n/locales';
  import { daysInMonth, parseISODate, toISODate, type YMD } from '../date-diff/logic';
  import { moveInPeriod, moveOutPeriod, proratePeriod, prorateSalary, type Basis, type Rounding } from './logic';

  interface Prefs {
    kind: string;
    rent: string;
    fee: string;
    period: string;
    start: string;
    end: string;
    basis: string;
    round: string;
    dailyFirst: boolean;
    salary: string;
    sbasis: string;
    sbase: string;
    sdays: string;
    sround: string;
  }

  const root = $('[data-tool="daily-proration"]');
  const locale = isLocale(root.dataset.locale) ? root.dataset.locale : 'ja';
  const yen = (n: number) => `${formatInteger(n, locale)}円`;
  const num = (n: number, d = 2) => formatNumber(n, d, locale);
  const radio = (name: string) => $$<HTMLInputElement>(`input[name="${name}"]`, root);
  const val = (name: string) => radio(name).find((r) => r.checked)?.value ?? '';
  const setRadio = (name: string, v: string) => {
    const list = radio(name);
    for (const r of list) r.checked = r.value === v;
    if (!list.some((r) => r.checked)) list[0].checked = true;
  };
  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const input = (id: string) => $<HTMLInputElement>(id, root);
  const md = (d: YMD) => `${d.y}年${d.m}月${d.d}日`;

  const BASIS_LABEL: Record<Basis, string> = { calendar: 'その月の日数で割る', '30': '30日で割る', '365': '年額を365日で割る' };
  const ROUND_LABEL: Record<Rounding, string> = { floor: '切り捨て', round: '四捨五入', ceil: '切り上げ' };

  const now = new Date();
  const today: YMD = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };

  function readAmount(id: string, allowEmpty = false): number {
    const raw = input(id).value.trim();
    if (raw === '' && allowEmpty) return 0;
    const n = parseNumber(raw.replace(/円$/, ''));
    return Number.isFinite(n) && n >= 0 && Number.isInteger(n) ? n : Number.NaN;
  }

  /* ---------- 家賃 ---------- */
  function period(): { start: YMD; end: YMD } | null {
    const p = val('dp-period');
    const start = parseISODate(input('#dp-start').value);
    if (!start) return null;
    if (p === 'in') return moveInPeriod(start);
    if (p === 'out') return moveOutPeriod(start);
    const end = parseISODate(input('#dp-end').value);
    return end ? { start, end } : null;
  }

  function renderRentLabels() {
    const p = val('dp-period');
    $('#dp-end-field', root).hidden = p !== 'range';
    set('#dp-start-label', p === 'in' ? '入居日（家賃の発生日）' : p === 'out' ? '退去日（解約日）' : '開始日');
  }

  function clearRent(message: string) {
    const err = $('#dp-rent-error', root);
    err.textContent = message;
    err.hidden = message === '';
    ['#dp-total', '#dp-days', '#dp-daily', '#dp-rent-part', '#dp-fee-part'].forEach((id) => set(id, '—'));
    set('#dp-total-label', '');
    set('#dp-formula', '');
    $('#dp-compare', root).replaceChildren();
    $('#dp-months-field', root).hidden = true;
  }

  function renderRent() {
    renderRentLabels();
    const rent = readAmount('#dp-rent-amount');
    const fee = readAmount('#dp-fee-amount', true);
    if (!Number.isFinite(rent) || !Number.isFinite(fee)) return clearRent('金額は0以上の整数（円）で入力してください。');
    const per = period();
    if (!per) return clearRent(val('dp-period') === 'range' ? '開始日と終了日を入力してください。' : '日付を入力してください。');
    const basis = val('dp-basis') as Basis;
    const rounding = val('dp-round') as Rounding;
    const opts = { basis, rounding, roundDailyFirst: input('#dp-daily-first').checked };
    const r = proratePeriod(rent, per.start, per.end, opts);
    const f = proratePeriod(fee, per.start, per.end, opts);
    if (!r || !f) return clearRent('終了日は開始日以降の日付にしてください。');
    clearRent('');

    const total = r.total + f.total;
    set('#dp-total', yen(total));
    set('#dp-total-label', `${md(per.start)}〜${md(per.end)}（${r.totalDays}日間）の日割り額。${BASIS_LABEL[basis]}・${ROUND_LABEL[rounding]}`);
    set('#dp-days', `${r.totalDays}日`);
    set('#dp-rent-part', yen(r.total));
    set('#dp-fee-part', fee > 0 ? yen(f.total) : '—');

    const partial = r.parts.filter((p) => !p.full);
    const first = partial[0] ?? r.parts[0];
    set('#dp-daily', `${num(first.daily, opts.roundDailyFirst ? 0 : 2)}円`);
    set('#dp-daily-label', partial.length > 1 ? `家賃の日額（${first.m}月）` : '家賃の日額');

    // Formula for each prorated month.
    const lines = r.parts.map((p, i) => {
      const fp = f.parts[i];
      const head = `${p.y}年${p.m}月（${p.days}日）`;
      if (p.full) return `${head}：1か月分 ${yen(p.amount)}${fee > 0 ? ` ＋ ${yen(fp.amount)}` : ''}`;
      const yearly = basis === '365' ? '×12' : '';
      const expr = (amount: number, part: typeof p) =>
        opts.roundDailyFirst
          ? `${formatInteger(amount, locale)}${yearly}÷${part.base} → 日額${yen(part.daily)} × ${part.days}日 = ${yen(part.amount)}`
          : `${formatInteger(amount, locale)}${yearly} × ${part.days} ÷ ${part.base} = ${num((amount * (basis === '365' ? 12 : 1) * part.days) / part.base)} → ${yen(part.amount)}`;
      return `${head}：${expr(rent, p)}${fee > 0 ? `\n　管理費等：${expr(fee, fp)}` : ''}`;
    });
    set('#dp-formula', lines.join('\n'));

    // Monthly breakdown when the period spans several months.
    const monthsField = $('#dp-months-field', root);
    monthsField.hidden = r.parts.length < 2;
    $('#dp-months', root).replaceChildren(
      ...r.parts.map((p, i) => {
        const tr = document.createElement('tr');
        const cells = [`${p.y}年${p.m}月`, `${p.days}日`, yen(p.amount), yen(f.parts[i].amount), yen(p.amount + f.parts[i].amount)];
        cells.forEach((text, k) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (k > 0) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );

    // Compare the three bases.
    $('#dp-compare', root).replaceChildren(
      ...(['calendar', '30', '365'] as Basis[]).map((b) => {
        const o = { ...opts, basis: b };
        const t = (proratePeriod(rent, per.start, per.end, o)?.total ?? 0) + (proratePeriod(fee, per.start, per.end, o)?.total ?? 0);
        const tr = document.createElement('tr');
        if (b === basis) tr.className = 'is-current';
        const diff = t - total;
        [BASIS_LABEL[b], yen(t), b === basis ? '選択中' : `${diff > 0 ? '+' : diff < 0 ? '−' : '±'}${yen(Math.abs(diff))}`].forEach((text, k) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (k > 0) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );
  }

  /* ---------- 給与 ---------- */
  function renderSalaryLabels() {
    const b = val('dp-sbasis');
    $('#dp-month-field', root).hidden = b !== 'calendar';
    set('#dp-sbase-label', b === 'calendar' ? '基準日数（その月の日数）' : b === 'scheduled' ? 'その月の所定労働日数' : '月平均所定労働日数');
    set('#dp-sdays-label', b === 'calendar' ? '在籍日数（暦日）' : '出勤日数（所定労働日のうち）');
    input('#dp-sbase').readOnly = b === 'calendar';
    if (b === 'calendar') {
      const [y, m] = input('#dp-month').value.split('-').map(Number);
      if (y && m) input('#dp-sbase').value = String(daysInMonth(y, m));
    }
  }

  function renderSalary() {
    renderSalaryLabels();
    const err = $('#dp-salary-error', root);
    const salary = readAmount('#dp-salary-amount');
    const base = parseNumber(input('#dp-sbase').value);
    const days = parseNumber(input('#dp-sdays').value);
    const rounding = val('dp-sround') as Rounding;
    const fail = (m: string) => {
      err.textContent = m;
      err.hidden = false;
      set('#dp-salary-total', '—');
      set('#dp-salary-label', '');
      set('#dp-salary-formula', '');
    };
    if (!Number.isFinite(salary)) return fail('月給は0以上の整数（円）で入力してください。');
    if (!(base > 0)) return fail('基準日数を入力してください。');
    if (!(days >= 0)) return fail('日数を入力してください。');
    const amount = prorateSalary(salary, days, base, rounding);
    if (amount === null) return fail('日数は基準日数以下で入力してください。');
    err.hidden = true;
    set('#dp-salary-total', yen(amount));
    set('#dp-salary-label', `月給 ${yen(salary)} の ${num(days)}日 ÷ ${num(base)}日 分（${ROUND_LABEL[rounding]}）`);
    set(
      '#dp-salary-formula',
      `${formatInteger(salary, locale)} × ${num(days)} ÷ ${num(base)} = ${num((salary * days) / base)} → ${yen(amount)}\n日額（参考）：${num(salary / base)}円`,
    );
  }

  /* ---------- wiring ---------- */
  function render() {
    const kind = val('dp-kind');
    $('#dp-rent', root).hidden = kind !== 'rent';
    $('#dp-salary', root).hidden = kind !== 'salary';
    if (kind === 'rent') renderRent();
    else renderSalary();
    savePref('daily-proration', {
      kind,
      rent: input('#dp-rent-amount').value,
      fee: input('#dp-fee-amount').value,
      period: val('dp-period'),
      start: input('#dp-start').value,
      end: input('#dp-end').value,
      basis: val('dp-basis'),
      round: val('dp-round'),
      dailyFirst: input('#dp-daily-first').checked,
      salary: input('#dp-salary-amount').value,
      sbasis: val('dp-sbasis'),
      sbase: input('#dp-sbase').value,
      sdays: input('#dp-sdays').value,
      sround: val('dp-sround'),
    } satisfies Prefs);
  }

  const todayIso = toISODate(today);
  const endOfMonthIso = toISODate({ ...today, d: daysInMonth(today.y, today.m) });
  const saved = loadPref<Partial<Prefs>>('daily-proration', {});
  setRadio('dp-kind', saved.kind ?? 'rent');
  setRadio('dp-period', saved.period ?? 'in');
  setRadio('dp-basis', saved.basis ?? 'calendar');
  setRadio('dp-round', saved.round ?? 'floor');
  setRadio('dp-sbasis', saved.sbasis ?? 'calendar');
  setRadio('dp-sround', saved.sround ?? 'floor');
  if (saved.rent) input('#dp-rent-amount').value = saved.rent;
  if (saved.fee) input('#dp-fee-amount').value = saved.fee;
  input('#dp-start').value = saved.start || todayIso;
  input('#dp-end').value = saved.end || endOfMonthIso;
  input('#dp-daily-first').checked = saved.dailyFirst === true;
  if (saved.salary) input('#dp-salary-amount').value = saved.salary;
  input('#dp-month').value = `${today.y}-${String(today.m).padStart(2, '0')}`;
  if (saved.sbase) input('#dp-sbase').value = saved.sbase;
  if (saved.sdays) input('#dp-sdays').value = saved.sdays;

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  .dp-pane {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .dp-pane[hidden] {
    display: none;
  }
  .dp-pane :global(tr.is-current) td {
    background: var(--accent-soft);
    font-weight: 700;
  }
</style>
