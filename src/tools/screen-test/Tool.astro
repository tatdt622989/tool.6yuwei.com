---
import { PATTERNS, SET_NAMES, type PatternSet } from './logic';

const sets: { id: PatternSet; desc: string }[] = [
  { id: 'pixels', desc: '黑、白、紅、綠、藍、灰六種純色，找出亮點與暗點。' },
  { id: 'gradient', desc: '灰階與 RGB 漸層，檢查色彩斷層與暗部細節。' },
  { id: 'uniformity', desc: '全黑與多階灰，在暗室檢查漏光、雲紋與亮度不均。' },
];
---

<div class="tool" data-tool="screen-test">
  <div class="stats" aria-live="polite">
    <div class="stat"><span class="stat-value" id="sc-res">—</span><span class="stat-label">螢幕解析度（CSS 像素）</span></div>
    <div class="stat"><span class="stat-value" id="sc-phys">—</span><span class="stat-label">實際像素（估算）</span></div>
    <div class="stat"><span class="stat-value" id="sc-dpr">—</span><span class="stat-label">縮放比 devicePixelRatio</span></div>
    <div class="stat"><span class="stat-value" id="sc-depth">—</span><span class="stat-label">色彩深度</span></div>
  </div>

  <div class="sc-sets">
    {
      sets.map((s) => (
        <section class="sc-set" data-set={s.id}>
          <div class="sc-set-head">
            <h3 class="sc-set-title">{SET_NAMES[s.id]}</h3>
            <p class="hint">{s.desc}</p>
          </div>
          <div class="sc-swatches">
            {PATTERNS[s.id].map((p, i) => (
              <button
                type="button"
                class="sc-swatch"
                data-set={s.id}
                data-index={i}
                style={`background:${p.background}`}
                title={p.name}
                aria-label={`從「${p.name}」開始全螢幕測試`}
              />
            ))}
          </div>
          <button type="button" class="btn sc-start" data-set={s.id} data-index="0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
            全螢幕開始
          </button>
        </section>
      ))
    }
  </div>

  <div class="row between">
    <label class="check"><input type="checkbox" id="sc-tips" checked /> 切換畫面時短暫顯示說明</label>
    <span class="hint">操作：點擊或按 → 下一個，← 上一個，Esc 離開</span>
  </div>

  <p class="notice" id="sc-note" hidden></p>

  <p class="hint">測試前請先擦乾淨螢幕，灰塵很容易被誤認為壞點。所有畫面都在你的瀏覽器中產生，不會上傳任何資料。</p>

  <div class="sc-stage" id="sc-stage" hidden tabindex="-1" role="dialog" aria-modal="true" aria-label="全螢幕螢幕測試">
    <div class="sc-hud" id="sc-hud">
      <div class="sc-hud-text">
        <strong id="sc-name"></strong>
        <span class="sc-pos" id="sc-pos"></span>
        <span class="sc-tip" id="sc-tip"></span>
      </div>
      <div class="sc-hud-actions">
        <button type="button" class="sc-icon" id="sc-prev" aria-label="上一個">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <button type="button" class="sc-icon" id="sc-next" aria-label="下一個">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
        <button type="button" class="sc-icon" id="sc-exit" aria-label="離開全螢幕測試">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { isPatternSet, keyAction, nextIndex, PATTERNS, physicalResolution, prevIndex, tapAction, type PatternSet } from './logic';

  interface Prefs {
    tips: boolean;
  }

  type FsElement = HTMLElement & { webkitRequestFullscreen?: () => Promise<void> | void };
  type FsDocument = Document & { webkitFullscreenElement?: Element | null; webkitExitFullscreen?: () => Promise<void> | void };

  const root = $('[data-tool="screen-test"]');
  const stage = $<FsElement>('#sc-stage', root);
  const hud = $('#sc-hud', root);
  const nameOut = $('#sc-name', root);
  const posOut = $('#sc-pos', root);
  const tipOut = $('#sc-tip', root);
  const tips = $<HTMLInputElement>('#sc-tips', root);
  const note = $('#sc-note', root);
  const doc = document as FsDocument;

  // Escape any transformed / clipped ancestor so the fallback overlay truly covers the viewport.
  document.body.append(stage);

  let set: PatternSet = 'pixels';
  let index = 0;
  let running = false;
  let wasFullscreen = false;
  let idleTimer: number | undefined;
  let returnFocus: HTMLElement | null = null;
  let wakeLock: WakeLockSentinel | null = null;

  const fullscreenElement = () => doc.fullscreenElement ?? doc.webkitFullscreenElement ?? null;

  function showScreenInfo() {
    const { width, height } = window.screen;
    const dpr = window.devicePixelRatio || 1;
    const phys = physicalResolution({ cssWidth: width, cssHeight: height, dpr });
    $('#sc-res', root).textContent = `${formatInteger(width)} × ${formatInteger(height)}`;
    $('#sc-phys', root).textContent = `${formatInteger(phys.width)} × ${formatInteger(phys.height)}`;
    $('#sc-dpr', root).textContent = `${Number(dpr.toFixed(2))}x`;
    $('#sc-depth', root).textContent = `${window.screen.colorDepth} bit`;
  }

  function paint() {
    const list = PATTERNS[set];
    const p = list[index];
    stage.style.background = p.background;
    nameOut.textContent = p.name;
    posOut.textContent = `${index + 1} / ${list.length}`;
    tipOut.textContent = p.tip;
    wake();
  }

  /** Show HUD + cursor briefly, then hide both so the pattern is unobstructed. */
  function wake(force = false) {
    if (!running) return;
    const showHud = tips.checked || force;
    stage.classList.remove('is-idle');
    hud.classList.toggle('is-hidden', !showHud);
    window.clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => stage.classList.add('is-idle'), 2500);
  }

  function go(action: 'next' | 'prev') {
    const len = PATTERNS[set].length;
    index = action === 'next' ? nextIndex(index, len) : prevIndex(index, len);
    paint();
  }

  async function open(nextSet: PatternSet, startIndex: number, trigger: HTMLElement) {
    set = nextSet;
    index = Math.min(Math.max(0, startIndex), PATTERNS[set].length - 1);
    returnFocus = trigger;
    running = true;
    wasFullscreen = false;
    note.textContent = '';
    note.hidden = true;
    stage.hidden = false;
    document.documentElement.classList.add('sc-lock');
    paint();
    stage.focus({ preventScroll: true });

    try {
      if (stage.requestFullscreen) await stage.requestFullscreen({ navigationUI: 'hide' });
      else if (stage.webkitRequestFullscreen) await stage.webkitRequestFullscreen();
    } catch {
      /* Fullscreen refused or unsupported (e.g. iPhone Safari): keep the fixed overlay. */
    }
    wasFullscreen = fullscreenElement() !== null;
    if (!wasFullscreen) {
      note.textContent = '這個瀏覽器不支援網頁全螢幕，已改用覆蓋整個視窗的模式。iPhone 可先把網頁「加入主畫面」再開啟，或橫放手機以減少瀏覽器工具列。';
    }
    try {
      wakeLock = (await navigator.wakeLock?.request('screen')) ?? null;
    } catch {
      wakeLock = null;
    }
  }

  function close() {
    if (!running) return;
    running = false;
    window.clearTimeout(idleTimer);
    if (fullscreenElement()) {
      if (doc.exitFullscreen) void doc.exitFullscreen().catch(() => undefined);
      else void doc.webkitExitFullscreen?.();
    }
    stage.hidden = true;
    stage.classList.remove('is-idle');
    document.documentElement.classList.remove('sc-lock');
    void wakeLock?.release().catch(() => undefined);
    wakeLock = null;
    note.hidden = !note.textContent;
    returnFocus?.focus({ preventScroll: true });
  }

  function onFullscreenChange() {
    if (running && wasFullscreen && !fullscreenElement()) close();
  }
  document.addEventListener('fullscreenchange', onFullscreenChange);
  document.addEventListener('webkitfullscreenchange', onFullscreenChange);

  document.addEventListener('keydown', (e) => {
    if (!running || e.ctrlKey || e.metaKey || e.altKey) return;
    const action = keyAction(e.key);
    if (!action) return;
    e.preventDefault();
    if (action === 'exit') close();
    else go(action);
  });

  stage.addEventListener('click', (e) => {
    if ((e.target as Element).closest('.sc-hud')) return;
    go(tapAction(e.clientX, stage.clientWidth));
  });
  stage.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'mouse') wake();
  });
  $('#sc-prev', stage).addEventListener('click', () => go('prev'));
  $('#sc-next', stage).addEventListener('click', () => go('next'));
  $('#sc-exit', stage).addEventListener('click', close);

  for (const btn of $$<HTMLButtonElement>('.sc-swatch, .sc-start', root)) {
    btn.addEventListener('click', () => {
      const s = btn.dataset.set;
      if (isPatternSet(s)) void open(s, Number(btn.dataset.index) || 0, btn);
    });
  }

  tips.addEventListener('change', () => savePref('screen-test', { tips: tips.checked } satisfies Prefs));
  tips.checked = loadPref<Prefs>('screen-test', { tips: true }).tips;

  window.addEventListener('resize', showScreenInfo);
  window.addEventListener('pagehide', close);
  showScreenInfo();
</script>

<style>
  .sc-sets {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 760px) {
    .sc-sets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sc-set {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .sc-set-head {
    display: grid;
    gap: 2px;
  }
  .sc-set-title {
    font-size: 17px;
  }
  .sc-set .hint {
    margin: 0;
  }
  .sc-swatches {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }
  .sc-swatch {
    aspect-ratio: 1;
    min-height: 36px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .sc-swatch:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 0 2px var(--accent);
  }
  .sc-start {
    justify-self: start;
  }
  .sc-stage {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: block;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    cursor: pointer;
    outline: none;
  }
  .sc-stage.is-idle {
    cursor: none;
  }
  .sc-hud {
    position: absolute;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 14px;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 10px 10px 10px 18px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.25);
    font-size: 14px;
    cursor: default;
    transition: opacity 0.25s;
  }
  .sc-hud.is-hidden .sc-hud-text {
    display: none;
  }
  .sc-hud.is-hidden {
    padding-left: 10px;
  }
  .sc-stage.is-idle .sc-hud {
    opacity: 0;
    pointer-events: none;
  }
  .sc-hud-text {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 10px;
    min-width: 0;
  }
  .sc-pos {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sc-tip {
    grid-column: 1 / -1;
    color: var(--text-2);
  }
  .sc-hud-actions {
    display: flex;
    gap: 4px;
  }
  .sc-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
  }
  .sc-icon:hover {
    border-color: var(--accent);
  }
  :global(html.sc-lock),
  :global(html.sc-lock body) {
    overflow: hidden;
  }
  @media (max-width: 520px) {
    .sc-hud {
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
    }
    .sc-hud-actions {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-hud,
    .sc-swatch {
      transition: none;
    }
    .sc-swatch:hover {
      transform: none;
    }
  }
</style>
