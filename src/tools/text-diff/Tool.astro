<div class="tool" data-tool="text-diff">
  <div class="grid-2">
    <div class="field">
      <label for="td-old">原始文字</label>
      <textarea id="td-old" class="mono" rows="10" spellcheck="false" placeholder="貼上修改前的版本"></textarea>
    </div>
    <div class="field">
      <label for="td-new">修改後文字</label>
      <textarea id="td-new" class="mono" rows="10" spellcheck="false" placeholder="貼上修改後的版本"></textarea>
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="td-ws" /> 忽略空白差異</label>
    <label class="check"><input type="checkbox" id="td-case" /> 忽略大小寫</label>
    <label class="check"><input type="checkbox" id="td-collapse" checked /> 隱藏相同的行</label>
  </div>

  <div class="row between">
    <div class="field">
      <span class="label">行內差異</span>
      <div class="seg" role="radiogroup" aria-label="行內差異">
        <label><input type="radio" name="td-inline" value="word" checked /><span>字詞</span></label>
        <label><input type="radio" name="td-inline" value="char" /><span>字元</span></label>
        <label><input type="radio" name="td-inline" value="none" /><span>關閉</span></label>
      </div>
    </div>
    <div class="field">
      <span class="label">檢視方式</span>
      <div class="seg" role="radiogroup" aria-label="檢視方式">
        <label><input type="radio" name="td-view" value="split" checked /><span>左右並排</span></label>
        <label><input type="radio" name="td-view" value="unified" /><span>單欄</span></label>
      </div>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value td-stat-add" id="td-added">0</span><span class="stat-label">新增行</span></div>
    <div class="stat"><span class="stat-value td-stat-del" id="td-removed">0</span><span class="stat-label">刪除行</span></div>
    <div class="stat"><span class="stat-value" id="td-unchanged">0</span><span class="stat-label">相同行</span></div>
  </div>

  <p class="notice" id="td-msg" aria-live="polite">在上方兩個欄位貼上文字，差異會自動標示在這裡。</p>
  <div class="table-wrap td-wrap" id="td-result" hidden></div>

  <div class="row">
    <button class="btn" type="button" id="td-swap">左右交換</button>
    <button class="btn ghost" type="button" id="td-clear">清除</button>
  </div>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { collapseRows, diffText, renderSplit, renderUnified, type InlineLevel } from './logic';

  const root = $('[data-tool="text-diff"]');
  const oldInput = $<HTMLTextAreaElement>('#td-old', root);
  const newInput = $<HTMLTextAreaElement>('#td-new', root);
  const ws = $<HTMLInputElement>('#td-ws', root);
  const ignoreCase = $<HTMLInputElement>('#td-case', root);
  const collapse = $<HTMLInputElement>('#td-collapse', root);
  const inlineRadios = $$<HTMLInputElement>('input[name="td-inline"]', root);
  const viewRadios = $$<HTMLInputElement>('input[name="td-view"]', root);
  const msg = $('#td-msg', root);
  const result = $('#td-result', root);

  interface Prefs {
    ignoreWhitespace: boolean;
    ignoreCase: boolean;
    collapse: boolean;
    inline: InlineLevel;
  }

  const prefs = loadPref<Prefs>('text-diff', { ignoreWhitespace: false, ignoreCase: false, collapse: true, inline: 'word' });
  ws.checked = Boolean(prefs.ignoreWhitespace);
  ignoreCase.checked = Boolean(prefs.ignoreCase);
  collapse.checked = prefs.collapse !== false;
  for (const r of inlineRadios) r.checked = r.value === prefs.inline;
  if (!inlineRadios.some((r) => r.checked)) inlineRadios[0].checked = true;
  // Side by side needs room; default to a single column on phones.
  const narrow = window.matchMedia('(max-width: 759px)').matches;
  for (const r of viewRadios) r.checked = r.value === (narrow ? 'unified' : 'split');

  const checked = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value;

  function render() {
    const inline = (checked(inlineRadios) ?? 'word') as InlineLevel;
    savePref('text-diff', {
      ignoreWhitespace: ws.checked,
      ignoreCase: ignoreCase.checked,
      collapse: collapse.checked,
      inline,
    } satisfies Prefs);

    const r = diffText(oldInput.value, newInput.value, {
      ignoreWhitespace: ws.checked,
      ignoreCase: ignoreCase.checked,
      inline,
    });
    $('#td-added', root).textContent = formatInteger(r.added);
    $('#td-removed', root).textContent = formatInteger(r.removed);
    $('#td-unchanged', root).textContent = formatInteger(r.unchanged);

    if (oldInput.value === '' && newInput.value === '') {
      msg.className = 'notice';
      msg.textContent = '在上方兩個欄位貼上文字，差異會自動標示在這裡。';
      msg.hidden = false;
      result.hidden = true;
      result.innerHTML = '';
      return;
    }

    const same = r.added === 0 && r.removed === 0;
    msg.hidden = !same;
    if (same) {
      msg.className = 'notice ok';
      msg.textContent = ws.checked || ignoreCase.checked ? '在目前的忽略條件下，兩段文字沒有差異。' : '兩段文字完全相同。';
    }
    const rows = collapse.checked ? collapseRows(r.rows, 3) : r.rows;
    // Both renderers escape every piece of user text before it reaches innerHTML.
    result.innerHTML = checked(viewRadios) === 'unified' ? renderUnified(rows) : renderSplit(rows);
    result.hidden = rows.length === 0;
  }

  const renderSoon = debounce(render, 200);
  oldInput.addEventListener('input', renderSoon);
  newInput.addEventListener('input', renderSoon);
  for (const el of [ws, ignoreCase, collapse, ...inlineRadios, ...viewRadios]) el.addEventListener('change', render);

  $('#td-swap', root).addEventListener('click', () => {
    [oldInput.value, newInput.value] = [newInput.value, oldInput.value];
    render();
  });
  $('#td-clear', root).addEventListener('click', () => {
    oldInput.value = '';
    newInput.value = '';
    render();
    oldInput.focus();
  });
  render();
</script>

<style>
  .td-stat-add {
    color: var(--success);
  }
  .td-stat-del {
    color: var(--danger);
  }
  .td-wrap {
    max-height: 70vh;
    overflow: auto;
  }
  .td-wrap :global(.td-table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.55;
  }
  .td-wrap :global(.td-split) {
    table-layout: fixed;
    min-width: 640px;
  }
  .td-wrap :global(.td-split td.td-no) {
    width: 3.5em;
  }
  .td-wrap :global(.td-unified td.td-no) {
    width: 3em;
  }
  .td-wrap :global(td) {
    padding: 1px 8px;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  }
  .td-wrap :global(.td-no) {
    color: var(--muted);
    text-align: right;
    user-select: none;
    background: var(--surface-2);
    white-space: nowrap;
  }
  .td-wrap :global(.td-sign) {
    width: 1.5em;
    text-align: center;
    user-select: none;
    color: var(--muted);
  }
  .td-wrap :global(.td-code) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .td-wrap :global(.td-code:empty)::after {
    content: ' ';
    white-space: pre;
  }
  .td-wrap :global(.td-old) {
    background: color-mix(in oklab, var(--danger) 9%, transparent);
  }
  .td-wrap :global(.td-new) {
    background: color-mix(in oklab, var(--success) 9%, transparent);
  }
  .td-wrap :global(.td-blank) {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      color-mix(in oklab, var(--border) 60%, transparent) 6px 7px
    );
  }
  .td-wrap :global(mark) {
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  .td-wrap :global(mark.td-del) {
    background: color-mix(in oklab, var(--danger) 28%, transparent);
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklab, var(--danger) 60%, transparent);
  }
  .td-wrap :global(mark.td-ins) {
    background: color-mix(in oklab, var(--success) 28%, transparent);
  }
  .td-wrap :global(.td-skip td) {
    padding: 6px 12px;
    text-align: center;
    font-family: var(--font);
    font-size: 13px;
    color: var(--muted);
    background: var(--surface-2);
  }
</style>
