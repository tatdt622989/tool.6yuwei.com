---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="text-diff" {...i18nAttrs(locale, s.client)}>
  <div class="grid-2">
    <div class="field">
      <label for="td-old">{s.oldLabel}</label>
      <textarea id="td-old" class="mono" rows="10" spellcheck="false" placeholder={s.oldPlaceholder}></textarea>
    </div>
    <div class="field">
      <label for="td-new">{s.newLabel}</label>
      <textarea id="td-new" class="mono" rows="10" spellcheck="false" placeholder={s.newPlaceholder}></textarea>
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="td-ws" /> {s.ignoreWhitespace}</label>
    <label class="check"><input type="checkbox" id="td-case" /> {s.ignoreCase}</label>
    <label class="check"><input type="checkbox" id="td-collapse" checked /> {s.collapse}</label>
  </div>

  <div class="row between">
    <div class="field">
      <span class="label">{s.inlineLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.inlineLabel}>
        <label><input type="radio" name="td-inline" value="word" checked /><span>{s.inlineWord}</span></label>
        <label><input type="radio" name="td-inline" value="char" /><span>{s.inlineChar}</span></label>
        <label><input type="radio" name="td-inline" value="none" /><span>{s.inlineNone}</span></label>
      </div>
    </div>
    <div class="field">
      <span class="label">{s.viewLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.viewLabel}>
        <label><input type="radio" name="td-view" value="split" checked /><span>{s.viewSplit}</span></label>
        <label><input type="radio" name="td-view" value="unified" /><span>{s.viewUnified}</span></label>
      </div>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value td-stat-add" id="td-added">0</span><span class="stat-label">{s.statAdded}</span></div>
    <div class="stat"><span class="stat-value td-stat-del" id="td-removed">0</span><span class="stat-label">{s.statRemoved}</span></div>
    <div class="stat"><span class="stat-value" id="td-unchanged">0</span><span class="stat-label">{s.statUnchanged}</span></div>
  </div>

  <p class="notice" id="td-msg" aria-live="polite">{s.client.empty}</p>
  <div class="table-wrap td-wrap" id="td-result" hidden></div>

  <div class="row">
    <button class="btn" type="button" id="td-swap">{s.swap}</button>
    <button class="btn ghost" type="button" id="td-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatInteger, plural } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { collapseRows, diffText, renderSplit, renderUnified, type InlineLevel } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="text-diff"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const skipLabel = (n: number) => plural(locale, n, s.skip);
  const oldInput = $<HTMLTextAreaElement>('#td-old', root);
  const newInput = $<HTMLTextAreaElement>('#td-new', root);
  const ws = $<HTMLInputElement>('#td-ws', root);
  const ignoreCase = $<HTMLInputElement>('#td-case', root);
  const collapse = $<HTMLInputElement>('#td-collapse', root);
  const inlineRadios = $$<HTMLInputElement>('input[name="td-inline"]', root);
  const viewRadios = $$<HTMLInputElement>('input[name="td-view"]', root);
  const msg = $('#td-msg', root);
  const result = $('#td-result', root);

  interface Prefs {
    ignoreWhitespace: boolean;
    ignoreCase: boolean;
    collapse: boolean;
    inline: InlineLevel;
  }

  const prefs = loadPref<Prefs>('text-diff', { ignoreWhitespace: false, ignoreCase: false, collapse: true, inline: 'word' });
  ws.checked = Boolean(prefs.ignoreWhitespace);
  ignoreCase.checked = Boolean(prefs.ignoreCase);
  collapse.checked = prefs.collapse !== false;
  for (const r of inlineRadios) r.checked = r.value === prefs.inline;
  if (!inlineRadios.some((r) => r.checked)) inlineRadios[0].checked = true;
  // Side by side needs room; default to a single column on phones.
  const narrow = window.matchMedia('(max-width: 759px)').matches;
  for (const r of viewRadios) r.checked = r.value === (narrow ? 'unified' : 'split');

  const checked = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value;

  function render() {
    const inline = (checked(inlineRadios) ?? 'word') as InlineLevel;
    savePref('text-diff', {
      ignoreWhitespace: ws.checked,
      ignoreCase: ignoreCase.checked,
      collapse: collapse.checked,
      inline,
    } satisfies Prefs);

    const r = diffText(oldInput.value, newInput.value, {
      ignoreWhitespace: ws.checked,
      ignoreCase: ignoreCase.checked,
      inline,
    });
    $('#td-added', root).textContent = formatInteger(r.added, locale);
    $('#td-removed', root).textContent = formatInteger(r.removed, locale);
    $('#td-unchanged', root).textContent = formatInteger(r.unchanged, locale);

    if (oldInput.value === '' && newInput.value === '') {
      msg.className = 'notice';
      msg.textContent = s.empty;
      msg.hidden = false;
      result.hidden = true;
      result.innerHTML = '';
      return;
    }

    const same = r.added === 0 && r.removed === 0;
    msg.hidden = !same;
    if (same) {
      msg.className = 'notice ok';
      msg.textContent = ws.checked || ignoreCase.checked ? s.sameIgnoring : s.same;
    }
    const rows = collapse.checked ? collapseRows(r.rows, 3) : r.rows;
    // Both renderers escape every piece of user text before it reaches innerHTML.
    result.innerHTML = checked(viewRadios) === 'unified' ? renderUnified(rows, skipLabel) : renderSplit(rows, skipLabel);
    result.hidden = rows.length === 0;
  }

  const renderSoon = debounce(render, 200);
  oldInput.addEventListener('input', renderSoon);
  newInput.addEventListener('input', renderSoon);
  for (const el of [ws, ignoreCase, collapse, ...inlineRadios, ...viewRadios]) el.addEventListener('change', render);

  $('#td-swap', root).addEventListener('click', () => {
    [oldInput.value, newInput.value] = [newInput.value, oldInput.value];
    render();
  });
  $('#td-clear', root).addEventListener('click', () => {
    oldInput.value = '';
    newInput.value = '';
    render();
    oldInput.focus();
  });
  render();
</script>

<style>
  .td-stat-add {
    color: var(--success);
  }
  .td-stat-del {
    color: var(--danger);
  }
  .td-wrap {
    max-height: 70vh;
    overflow: auto;
  }
  .td-wrap :global(.td-table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.55;
  }
  .td-wrap :global(.td-split) {
    table-layout: fixed;
    min-width: 640px;
  }
  .td-wrap :global(.td-split td.td-no) {
    width: 3.5em;
  }
  .td-wrap :global(.td-unified td.td-no) {
    width: 3em;
  }
  .td-wrap :global(td) {
    padding: 1px 8px;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  }
  .td-wrap :global(.td-no) {
    color: var(--muted);
    text-align: right;
    user-select: none;
    background: var(--surface-2);
    white-space: nowrap;
  }
  .td-wrap :global(.td-sign) {
    width: 1.5em;
    text-align: center;
    user-select: none;
    color: var(--muted);
  }
  .td-wrap :global(.td-code) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .td-wrap :global(.td-code:empty)::after {
    content: ' ';
    white-space: pre;
  }
  .td-wrap :global(.td-old) {
    background: color-mix(in oklab, var(--danger) 9%, transparent);
  }
  .td-wrap :global(.td-new) {
    background: color-mix(in oklab, var(--success) 9%, transparent);
  }
  .td-wrap :global(.td-blank) {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      color-mix(in oklab, var(--border) 60%, transparent) 6px 7px
    );
  }
  .td-wrap :global(mark) {
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  .td-wrap :global(mark.td-del) {
    background: color-mix(in oklab, var(--danger) 28%, transparent);
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklab, var(--danger) 60%, transparent);
  }
  .td-wrap :global(mark.td-ins) {
    background: color-mix(in oklab, var(--success) 28%, transparent);
  }
  .td-wrap :global(.td-skip td) {
    padding: 6px 12px;
    text-align: center;
    font-family: var(--font);
    font-size: 13px;
    color: var(--muted);
    background: var(--surface-2);
  }
</style>
