---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="base64" {...i18nAttrs(locale, s.client)}>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="b64-mode" value="encode" checked /><span>{s.encode}</span></label>
      <label><input type="radio" name="b64-mode" value="decode" /><span>{s.decode}</span></label>
    </div>
    <label class="check b64-enc-opt"><input type="checkbox" id="b64-urlsafe" /> {s.urlSafe}</label>
    <label class="check b64-enc-opt"><input type="checkbox" id="b64-nopad" /> {s.noPadding}</label>
  </div>

  <div class="field">
    <label for="b64-input" id="b64-input-label">{s.client.inputEncode}</label>
    <textarea id="b64-input" rows="8" spellcheck="false" autocomplete="off"></textarea>
  </div>

  <div id="b64-error" class="notice error" role="alert" hidden></div>
  <div id="b64-hex" class="output" hidden></div>

  <div class="field">
    <label for="b64-output" id="b64-output-label">{s.client.outputEncode}</label>
    <textarea id="b64-output" class="mono" rows="8" readonly spellcheck="false"></textarea>
    <span class="hint" id="b64-meta"></span>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#b64-output">{s.copy}</button>
    <button class="btn" type="button" id="b64-swap">{s.swap}</button>
    <button class="btn ghost" type="button" id="b64-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { decodeText, encodeText, toHex } from './logic';
  import type { Strings } from './i18n';

  type Mode = 'encode' | 'decode';
  interface Prefs {
    mode: Mode;
    urlSafe: boolean;
    noPadding: boolean;
  }

  const root = $('[data-tool="base64"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#b64-input', root);
  const output = $<HTMLTextAreaElement>('#b64-output', root);
  const inputLabel = $('#b64-input-label', root);
  const outputLabel = $('#b64-output-label', root);
  const error = $('#b64-error', root);
  const hex = $('#b64-hex', root);
  const meta = $('#b64-meta', root);
  const urlSafe = $<HTMLInputElement>('#b64-urlsafe', root);
  const noPadding = $<HTMLInputElement>('#b64-nopad', root);
  const modeRadios = $$<HTMLInputElement>('input[name="b64-mode"]', root);
  const encOpts = $$<HTMLElement>('.b64-enc-opt', root);
  const encoder = new TextEncoder();

  const mode = (): Mode => (modeRadios.find((r) => r.checked)?.value ?? 'encode') as Mode;

  function setMode(m: Mode) {
    modeRadios.forEach((r) => (r.checked = r.value === m));
  }

  function render() {
    const m = mode();
    savePref('base64', { mode: m, urlSafe: urlSafe.checked, noPadding: noPadding.checked } satisfies Prefs);
    encOpts.forEach((el) => (el.style.display = m === 'encode' ? '' : 'none'));
    inputLabel.textContent = m === 'encode' ? s.inputEncode : s.inputDecode;
    outputLabel.textContent = m === 'encode' ? s.outputEncode : s.outputDecode;
    input.placeholder = m === 'encode' ? s.placeholderEncode : s.placeholderDecode;
    input.classList.toggle('mono', m === 'decode');
    error.hidden = true;
    hex.hidden = true;

    if (input.value === '') {
      output.value = '';
      meta.textContent = '';
      return;
    }

    if (m === 'encode') {
      output.value = encodeText(input.value, { urlSafe: urlSafe.checked, noPadding: noPadding.checked });
      meta.textContent = t(s.metaEncode, {
        bytes: plural(locale, encoder.encode(input.value).length, s.bytes),
        chars: plural(locale, output.value.length, s.chars),
      });
      return;
    }

    const result = decodeText(input.value);
    if (result.ok) {
      output.value = result.text;
      meta.textContent = t(s.metaDecode, { bytes: plural(locale, result.bytes.length, s.bytes) });
    } else {
      output.value = '';
      meta.textContent = '';
      error.textContent = t(s.errors[result.reason], { n: result.bytes?.length ?? 0 });
      error.hidden = false;
      if (result.bytes) {
        hex.textContent = `${s.hexHead}\n${toHex(result.bytes)}`;
        hex.hidden = false;
      }
    }
  }

  const prefs = loadPref<Prefs>('base64', { mode: 'encode', urlSafe: false, noPadding: false });
  setMode(prefs.mode);
  urlSafe.checked = prefs.urlSafe;
  noPadding.checked = prefs.noPadding;

  input.addEventListener('input', render);
  [...modeRadios, urlSafe, noPadding].forEach((el) => el.addEventListener('change', render));
  $('#b64-swap', root).addEventListener('click', () => {
    if (!output.value) return;
    input.value = output.value;
    setMode(mode() === 'encode' ? 'decode' : 'encode');
    render();
  });
  $('#b64-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>
