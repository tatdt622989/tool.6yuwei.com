---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const methods = s.client.compare?.methods;
---

<div class="tool" data-tool="mortgage-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="grid-2">
    {
      s.amount ? (
        <div class="field">
          <label for="mg-amount">{s.amount.label}</label>
          <input id="mg-amount" type="text" inputmode="decimal" autocomplete="off" value={s.amount.value} />
        </div>
      ) : (
        s.us && (
          <Fragment>
            <div class="field">
              <label for="mg-price">{s.us.price}</label>
              <input id="mg-price" type="text" inputmode="decimal" autocomplete="off" value={s.us.priceValue} />
            </div>
            <div class="field">
              <label for="mg-down">{s.us.down}</label>
              <input id="mg-down" type="text" inputmode="decimal" autocomplete="off" value={s.us.downValue} />
            </div>
          </Fragment>
        )
      )
    }
    <div class="field">
      <label for="mg-rate">{s.rate}</label>
      <input id="mg-rate" type="text" inputmode="decimal" autocomplete="off" value={s.rateValue} />
    </div>
    <div class="field">
      <label for="mg-years">{s.years}</label>
      <input id="mg-years" type="text" inputmode="numeric" autocomplete="off" value={s.yearsValue} />
    </div>
    {
      s.grace && (
        <div class="field">
          <label for="mg-grace">{s.grace.label}</label>
          <input id="mg-grace" type="text" inputmode="numeric" autocomplete="off" value="0" />
        </div>
      )
    }
  </div>

  {
    s.us ? (
      <div class="field">
        <span class="label">{s.us.costsLabel}</span>
        <div class="grid-3">
          <div class="field">
            <label for="mg-tax">{s.us.tax}</label>
            <input id="mg-tax" type="text" inputmode="decimal" autocomplete="off" value={s.us.taxValue} />
          </div>
          <div class="field">
            <label for="mg-ins">{s.us.insurance}</label>
            <input id="mg-ins" type="text" inputmode="decimal" autocomplete="off" value={s.us.insuranceValue} />
          </div>
          <div class="field">
            <label for="mg-hoa">{s.us.hoa}</label>
            <input id="mg-hoa" type="text" inputmode="decimal" autocomplete="off" value={s.us.hoaValue} />
          </div>
        </div>
        <span class="hint">{s.us.costsHint}</span>
      </div>
    ) : (
      s.method &&
      methods && (
        <div class="field">
          <span class="label">{s.method.label}</span>
          <div class="seg" role="radiogroup" aria-label={s.method.label}>
            <label><input type="radio" name="mg-method" value="annuity" checked /><span>{methods.annuity}</span></label>
            <label><input type="radio" name="mg-method" value="principal" /><span>{methods.principal}</span></label>
          </div>
        </div>
      )
    )
  }

  <div class="notice error" id="mg-error" hidden></div>

  <div id="mg-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="mg-main">—</div>
      <div class="result-label" id="mg-main-label">{s.mainLabel}</div>
    </div>

    <div class="stats mg-stats">
      {
        s.us ? (
          <Fragment>
            <div class="stat"><span class="stat-value" id="mg-pi">—</span><span class="stat-label">{s.us.piLabel}</span></div>
            <div class="stat"><span class="stat-value" id="mg-loan">—</span><span class="stat-label">{s.us.loanLabel}</span></div>
          </Fragment>
        ) : (
          s.grace && (
            <div class="stat" id="mg-grace-stat"><span class="stat-value" id="mg-grace-pay">—</span><span class="stat-label">{s.grace.stat}</span></div>
          )
        )
      }
      {
        s.lastLabel && (
          <div class="stat" id="mg-last-stat"><span class="stat-value" id="mg-last">—</span><span class="stat-label">{s.lastLabel}</span></div>
        )
      }
      <div class="stat"><span class="stat-value" id="mg-interest">—</span><span class="stat-label">{s.interest}</span></div>
      <div class="stat"><span class="stat-value" id="mg-total">—</span><span class="stat-label">{s.total}</span></div>
    </div>

    <p class="hint" id="mg-compare"></p>

    <div class="field">
      <span class="label">{s.schedule}</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>{s.thPeriod}</th>
              <th class="num">{s.thPayment}</th>
              <th class="num">{s.thPrincipal}</th>
              <th class="num">{s.thInterest}</th>
              <th class="num">{s.thBalance}</th>
            </tr>
          </thead>
          <tbody id="mg-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">{s.notice}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { formatList, t } from '../../i18n/format';
  import {
    buildSchedule,
    loanFromPrice,
    MAX_YEARS,
    monthlyHousingPayment,
    mortgageProblem,
    summarizeByYear,
    wanToYuan,
    type LoanInput,
    type MonthRow,
    type RepaymentMethod,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="mortgage-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  // Amounts are in the locale's currency, so each locale remembers its own inputs.
  const KEY = locale === 'zh-TW' ? 'mortgage-calculator' : `mortgage-calculator:${locale}`;
  const field = (id: string) => root.querySelector<HTMLInputElement>(`#mg-${id}`);
  const amount = field('amount');
  const price = field('price');
  const down = field('down');
  const rate = $<HTMLInputElement>('#mg-rate', root);
  const years = $<HTMLInputElement>('#mg-years', root);
  const grace = field('grace');
  const tax = field('tax');
  const ins = field('ins');
  const hoa = field('hoa');
  const methods = $$<HTMLInputElement>('input[name="mg-method"]', root);
  const error = $('#mg-error', root);
  const output = $('#mg-output', root);
  const table = $('#mg-table', root);
  const text = (selector: string, value: string) => {
    const el = root.querySelector<HTMLElement>(selector);
    if (el) el.textContent = value;
  };
  const show = (selector: string, visible: boolean) => {
    const el = root.querySelector<HTMLElement>(selector);
    if (el) el.hidden = !visible;
  };

  /** Whole currency units (totals and the schedule). */
  const money = (v: number) => t(s.money, { n: formatInteger(v, locale) });
  /** Monthly amounts: cents where the currency uses them. */
  const monthly = (v: number) => t(s.money, { n: s.decimals ? formatFixed(v, s.decimals, locale) : formatInteger(v, locale) });

  type Prefs = Partial<Record<'amount' | 'price' | 'down' | 'rate' | 'years' | 'grace' | 'tax' | 'ins' | 'hoa' | 'method', string>>;
  const inputs = { amount, price, down, rate, years, grace, tax, ins, hoa };
  const saved = loadPref<Prefs>(KEY, {});
  for (const [key, el] of Object.entries(inputs)) {
    const value = saved[key as keyof Prefs];
    if (el && value !== undefined) el.value = value;
  }
  if (saved.method) for (const m of methods) m.checked = m.value === saved.method;

  let months: MonthRow[] = [];
  const open = new Set<number>();
  const optional = (el: HTMLInputElement | null) => (!el || el.value.trim() === '' ? 0 : parseNumber(el.value));

  function readInput(): LoanInput {
    return {
      principal: amount ? wanToYuan(parseNumber(amount.value)) : loanFromPrice(parseNumber(price?.value ?? ''), optional(down)),
      annualRate: parseNumber(rate.value),
      years: parseNumber(years.value),
      graceYears: optional(grace),
      method: (methods.find((m) => m.checked)?.value ?? 'annuity') as RepaymentMethod,
    };
  }

  function cells(first: string, row: { payment: number; principal: number; interest: number; balance: number }) {
    const nums = [row.payment, row.principal, row.interest, row.balance];
    return first + nums.map((n) => `<td class="num">${formatInteger(n, locale)}</td>`).join('');
  }

  function renderTable() {
    const rows: string[] = [];
    for (const y of summarizeByYear(months)) {
      const expanded = open.has(y.year);
      rows.push(
        `<tr class="mg-year">${cells(
          `<td><button type="button" class="mg-toggle" data-year="${y.year}" aria-expanded="${expanded}">${t(s.year, { n: y.year })}</button></td>`,
          y,
        )}</tr>`,
      );
      if (expanded) {
        for (const m of months.slice((y.year - 1) * 12, y.year * 12)) {
          rows.push(`<tr class="mg-month">${cells(`<td>${t(s.month, { n: m.month })}</td>`, m)}</tr>`);
        }
      }
    }
    table.innerHTML = rows.join('');
  }

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const input = readInput();
    const prefs: Prefs = { rate: rate.value, years: years.value, method: input.method };
    for (const [key, el] of Object.entries(inputs)) if (el) prefs[key as keyof Prefs] = el.value;
    savePref(KEY, prefs);

    const problem = mortgageProblem(input);
    const result = problem ? null : buildSchedule(input);
    if (!result) return fail(problem ? t(s.errors[problem], { max: MAX_YEARS }) : s.fallback);
    const costs = { propertyTaxYear: optional(tax), insuranceYear: optional(ins), hoaMonth: optional(hoa) };
    if (s.us && Object.values(costs).some((v) => !Number.isFinite(v) || v < 0)) return fail(s.us.costsError);
    error.hidden = true;
    output.hidden = false;

    const hasGrace = input.graceYears > 0;
    const isAnnuity = input.method === 'annuity';
    const pi = result.firstAmortizingPayment;
    $('#mg-main', root).textContent = monthly(s.us ? monthlyHousingPayment(pi, costs) : pi);
    $('#mg-main-label', root).textContent = `${hasGrace && s.afterGrace ? s.afterGrace : ''}${s.main[input.method]}`;
    show('#mg-grace-stat', hasGrace);
    text('#mg-grace-pay', monthly(result.firstPayment));
    show('#mg-last-stat', !isAnnuity);
    text('#mg-last', monthly(result.lastPayment));
    text('#mg-pi', monthly(pi));
    text('#mg-loan', money(input.principal));
    $('#mg-interest', root).textContent = money(result.totalInterest);
    $('#mg-total', root).textContent = money(result.totalPaid);

    const notes: string[] = [];
    if (s.compare) {
      const other: RepaymentMethod = isAnnuity ? 'principal' : 'annuity';
      const alt = buildSchedule({ ...input, method: other });
      if (alt && input.annualRate > 0) {
        const diff = alt.totalInterest - result.totalInterest;
        const method = s.compare.methods[other];
        notes.push(
          diff > 0
            ? t(s.compare.more, { method, money: money(diff) })
            : t(s.compare.less, { method, money: money(-diff), first: money(alt.firstAmortizingPayment) }),
        );
      }
    }
    if (s.us) {
      const { propertyTaxYear, insuranceYear, hoaMonth } = costs;
      if (propertyTaxYear || insuranceYear || hoaMonth) {
        const parts = s.us.parts;
        const list = [
          t(parts.pi, { n: monthly(pi) }),
          propertyTaxYear ? t(parts.tax, { n: monthly(propertyTaxYear / 12) }) : '',
          insuranceYear ? t(parts.ins, { n: monthly(insuranceYear / 12) }) : '',
          hoaMonth ? t(parts.hoa, { n: monthly(hoaMonth) }) : '',
        ].filter(Boolean);
        notes.push(t(s.us.breakdown, { list: formatList(list, locale) }));
      }
      if (optional(down) < 20) notes.push(s.us.pmi);
      if (input.years > 15) {
        const short = buildSchedule({ ...input, years: 15 });
        if (short && input.annualRate > 0) {
          notes.push(t(s.us.fifteen, { money: monthly(short.firstPayment), saved: money(result.totalInterest - short.totalInterest) }));
        }
      }
    }
    $('#mg-compare', root).textContent = notes.join(' ');

    months = result.months;
    renderTable();
  }

  table.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.mg-toggle');
    if (!button) return;
    const year = Number(button.dataset.year);
    if (open.has(year)) open.delete(year);
    else open.add(year);
    renderTable();
    $<HTMLButtonElement>(`.mg-toggle[data-year="${year}"]`, table).focus();
  });

  [amount, price, down, rate, years, grace, tax, ins, hoa].forEach((el) =>
    el?.addEventListener('input', () => {
      open.clear();
      render();
    }),
  );
  methods.forEach((m) => m.addEventListener('change', render));
  render();
</script>

<style>
  #mg-output {
    display: grid;
    gap: 16px;
  }
  #mg-output[hidden] {
    display: none;
  }
  .mg-stats .stat[hidden] {
    display: none;
  }
  #mg-table :global(.mg-toggle) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }
  #mg-table :global(.mg-toggle)::before {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }
  #mg-table :global(.mg-toggle[aria-expanded='true'])::before {
    transform: rotate(45deg);
  }
  #mg-table :global(.mg-month td) {
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 13px;
  }
  #mg-table :global(.mg-month td:first-child) {
    padding-left: 26px;
  }
</style>
