---
import { WEEKDAY_LABEL, weekdayOf } from '../date-diff/logic';
import { animalOf, festivalsOf, solarTermsOf, yearGanzhi } from './logic';

// Rendered at build time so the current year's tables are in the HTML; the script refreshes them per input.
const year = new Date().getFullYear();
const fmt = (d: { y: number; m: number; d: number }) => `${d.m} 月 ${d.d} 日（${WEEKDAY_LABEL[weekdayOf(d)]}）`;
const festivals = festivalsOf(year).map((f) => ({ name: f.name, date: fmt(f.date), y: f.date.y }));
const terms = solarTermsOf(year).map((t) => ({ name: t.name, date: fmt(t.date) }));
const yearTitle = `${year} 年（農曆${yearGanzhi(year)}${animalOf(year)}年）`;
---

<div class="tool" data-tool="lunar-converter">
  <div class="field">
    <span class="label">轉換方向</span>
    <div class="seg" role="radiogroup" aria-label="轉換方向">
      <label><input type="radio" name="lc-mode" value="solar" checked /><span>國曆轉農曆</span></label>
      <label><input type="radio" name="lc-mode" value="lunar" /><span>農曆轉國曆</span></label>
    </div>
  </div>

  <div class="row lc-solar" id="lc-solar-panel">
    <div class="field lc-date">
      <label for="lc-date">國曆日期（西元）</label>
      <input id="lc-date" type="date" min="1900-01-31" max="2100-12-31" />
    </div>
    <button type="button" class="btn small" id="lc-today">今天</button>
  </div>

  <div class="grid-3" id="lc-lunar-panel" hidden>
    <div class="field">
      <label for="lc-ly">農曆年</label>
      <select id="lc-ly"></select>
    </div>
    <div class="field">
      <label for="lc-lm">農曆月</label>
      <select id="lc-lm"></select>
    </div>
    <div class="field">
      <label for="lc-ld">農曆日</label>
      <select id="lc-ld"></select>
    </div>
  </div>

  <div class="notice error" id="lc-error" hidden></div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="lc-main">—</div>
    <div class="result-label" id="lc-sub"></div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="lc-gz">—</span><span class="stat-label">干支（年・月・日）</span></div>
    <div class="stat"><span class="stat-value" id="lc-animal">—</span><span class="stat-label" id="lc-animal-label">生肖</span></div>
    <div class="stat"><span class="stat-value" id="lc-term">—</span><span class="stat-label" id="lc-term-label">節氣</span></div>
    <div class="stat"><span class="stat-value" id="lc-roc">—</span><span class="stat-label">民國年</span></div>
  </div>
  <p class="hint" id="lc-note"></p>

  <div class="lc-tables">
    <div class="field">
      <span class="label" id="lc-fest-title">{yearTitle}農曆節日對照</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>節日</th><th>國曆日期</th></tr></thead>
          <tbody id="lc-fest">
            {festivals.map((f) => <tr><td>{f.name}</td><td>{f.y !== year ? `${f.y} 年 ` : ''}{f.date}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    <div class="field">
      <span class="label" id="lc-terms-title">{year} 年二十四節氣日期</span>
      <div class="table-wrap">
        <table class="table lc-terms">
          <thead><tr><th>節氣</th><th>國曆日期</th><th>節氣</th><th>國曆日期</th></tr></thead>
          <tbody id="lc-terms">
            {Array.from({ length: 12 }, (_, i) => (
              <tr><td>{terms[i * 2].name}</td><td>{terms[i * 2].date}</td><td>{terms[i * 2 + 1].name}</td><td>{terms[i * 2 + 1].date}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseISODate, toISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import {
    animalOf,
    describe,
    festivalsOf,
    lunarMonthLength,
    lunarToSolar,
    MAX_YEAR,
    MIN_YEAR,
    monthName,
    monthsOf,
    dayName,
    solarTermsOf,
    yearGanzhi,
    type LunarDate,
  } from './logic';

  type Mode = 'solar' | 'lunar';
  interface Prefs {
    mode: Mode;
  }

  const root = $('[data-tool="lunar-converter"]');
  const modes = $$<HTMLInputElement>('input[name="lc-mode"]', root);
  const dateInput = $<HTMLInputElement>('#lc-date', root);
  const ly = $<HTMLSelectElement>('#lc-ly', root);
  const lm = $<HTMLSelectElement>('#lc-lm', root);
  const ld = $<HTMLSelectElement>('#lc-ld', root);
  const error = $('#lc-error', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  const fmtDay = (d: YMD) => `${d.m} 月 ${d.d} 日（${WEEKDAY_LABEL[weekdayOf(d)]}）`;
  const fmtFull = (d: YMD) => `${d.y} 年 ${d.m} 月 ${d.d} 日`;
  const rocText = (y: number) => (y > 1911 ? `民國 ${y - 1911} 年` : `民前 ${1912 - y} 年`);

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }

  function mode(): Mode {
    return modes.find((m) => m.checked)?.value === 'lunar' ? 'lunar' : 'solar';
  }

  // ----- lunar selects -----
  ly.replaceChildren(
    ...Array.from({ length: MAX_YEAR - MIN_YEAR + 1 }, (_, i) => {
      const y = MIN_YEAR + i;
      return new Option(`${y}（${yearGanzhi(y)}${animalOf(y)}年）`, String(y));
    }),
  );

  function fillMonths(keep: string) {
    const y = Number(ly.value);
    lm.replaceChildren(
      ...monthsOf(y).map((m) => {
        const value = `${m.isLeap ? 'L' : ''}${m.month}`;
        return new Option(`${monthName(m.month, m.isLeap)}（${m.days === 30 ? '大' : '小'}）`, value, false, value === keep);
      }),
    );
    // A 閏月 that does not exist in the newly chosen year falls back to the regular month.
    if (lm.value !== keep) lm.value = keep.replace('L', '');
  }

  function fillDays(keep: number) {
    const { month, isLeap } = selectedMonth();
    const max = lunarMonthLength(Number(ly.value), month, isLeap) || 30;
    const day = Math.min(keep, max);
    ld.replaceChildren(...Array.from({ length: max }, (_, i) => new Option(dayName(i + 1), String(i + 1), false, i + 1 === day)));
  }

  function selectedMonth(): { month: number; isLeap: boolean } {
    return { month: Number(lm.value.replace('L', '')), isLeap: lm.value.startsWith('L') };
  }

  function setLunarSelects(l: LunarDate) {
    ly.value = String(l.year);
    fillMonths(`${l.isLeap ? 'L' : ''}${l.month}`);
    fillDays(l.day);
  }

  // ----- tables -----
  let tableYear = Number.NaN;
  function renderTables(year: number) {
    if (year === tableYear || year < MIN_YEAR || year > MAX_YEAR) return;
    tableYear = year;
    set('#lc-fest-title', `${year} 年（農曆${yearGanzhi(year)}${animalOf(year)}年）農曆節日對照`);
    const fest = $('#lc-fest', root);
    fest.replaceChildren(
      ...festivalsOf(year).map((f) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td></td><td></td>`;
        tr.cells[0].textContent = f.name;
        tr.cells[1].textContent = `${f.date.y !== year ? `${f.date.y} 年 ` : ''}${fmtDay(f.date)}`;
        return tr;
      }),
    );
    set('#lc-terms-title', `${year} 年二十四節氣日期`);
    const terms = solarTermsOf(year);
    const body = $('#lc-terms', root);
    body.replaceChildren(
      ...Array.from({ length: 12 }, (_, i) => {
        const tr = document.createElement('tr');
        for (const t of [terms[i * 2], terms[i * 2 + 1]]) {
          const name = document.createElement('td');
          name.textContent = t.name;
          const date = document.createElement('td');
          date.textContent = fmtDay(t.date);
          tr.append(name, date);
        }
        return tr;
      }),
    );
  }

  // ----- render -----
  function show(solar: YMD | null, message: string) {
    const info = solar ? describe(solar) : null;
    error.hidden = Boolean(info);
    if (!info || !solar) {
      error.textContent = message;
      ['#lc-main', '#lc-gz', '#lc-animal', '#lc-term', '#lc-roc'].forEach((id) => set(id, '—'));
      set('#lc-sub', '');
      set('#lc-note', '');
      return;
    }
    const { lunar } = info;
    const lunarText = `${monthName(lunar.month, lunar.isLeap)}${dayName(lunar.day)}`;
    if (mode() === 'solar') {
      set('#lc-main', `農曆 ${lunarText}`);
      set('#lc-sub', `${info.yearGanzhi}年（${info.animal}年）${lunarText}・國曆 ${fmtFull(solar)} 星期${WEEKDAY_LABEL[weekdayOf(solar)]}`);
    } else {
      set('#lc-main', `${fmtFull(solar)}（${WEEKDAY_LABEL[weekdayOf(solar)]}）`);
      set('#lc-sub', `農曆 ${info.yearGanzhi}年 ${lunarText} 是國曆 ${fmtFull(solar)} 星期${WEEKDAY_LABEL[weekdayOf(solar)]}`);
    }
    set('#lc-gz', `${info.yearGanzhi}年 ${info.monthGanzhi}月 ${info.dayGanzhi}日`);
    set('#lc-animal', `${info.animal}年`);
    set('#lc-animal-label', `生肖（農曆 ${lunar.year} 年，五行屬${info.element}）`);
    if (info.term) {
      set('#lc-term', info.term);
      set('#lc-term-label', '當天節氣');
    } else if (info.nextTerm) {
      set('#lc-term', `${info.nextTerm.name} ${info.nextTerm.date.m}/${info.nextTerm.date.d}`);
      set('#lc-term-label', `下一個節氣（上一個：${info.prevTerm?.name ?? '—'}）`);
    } else {
      set('#lc-term', '—');
      set('#lc-term-label', '節氣');
    }
    set('#lc-roc', rocText(solar.y));
    const notes: string[] = [];
    if (lunar.isLeap) notes.push(`這天在${monthName(lunar.month, true)}，農曆生日在沒有閏月的年份通常按正常的${monthName(lunar.month)}過。`);
    if (info.astroYearGanzhi !== info.yearGanzhi) notes.push(`八字命理以立春換年，這天的年柱為「${info.astroYearGanzhi}」，與以春節換年的「${info.yearGanzhi}」不同。`);
    set('#lc-note', notes.join(''));
    renderTables(lunar.year);
  }

  function render() {
    const m = mode();
    $('#lc-solar-panel', root).hidden = m !== 'solar';
    $('#lc-lunar-panel', root).hidden = m !== 'lunar';
    savePref('lunar-converter', { mode: m } satisfies Prefs);
    if (m === 'solar') {
      const date = parseISODate(dateInput.value);
      show(date, '請輸入 1900-01-31 到 2100-12-31 之間的國曆日期。');
    } else {
      const { month, isLeap } = selectedMonth();
      const solar = lunarToSolar({ year: Number(ly.value), month, day: Number(ld.value), isLeap });
      show(solar, '這個農曆日期不存在，請重新選擇。');
    }
  }

  // ----- events -----
  modes.forEach((m) =>
    m.addEventListener('change', () => {
      // Carry the current date over to the other direction.
      if (mode() === 'lunar') {
        const info = describe(parseISODate(dateInput.value) ?? today());
        if (info) setLunarSelects(info.lunar);
      } else {
        const { month, isLeap } = selectedMonth();
        const solar = lunarToSolar({ year: Number(ly.value), month, day: Number(ld.value), isLeap });
        if (solar) dateInput.value = toISODate(solar);
      }
      render();
    }),
  );
  dateInput.addEventListener('input', render);
  $('#lc-today', root).addEventListener('click', () => {
    dateInput.value = toISODate(today());
    render();
  });
  ly.addEventListener('change', () => {
    fillMonths(lm.value);
    fillDays(Number(ld.value));
    render();
  });
  lm.addEventListener('change', () => {
    fillDays(Number(ld.value));
    render();
  });
  ld.addEventListener('change', render);

  // ----- init -----
  const prefs = loadPref<Prefs>('lunar-converter', { mode: 'solar' });
  const start = today();
  dateInput.value = toISODate(start);
  const startInfo = describe(start);
  if (startInfo) setLunarSelects(startInfo.lunar);
  for (const m of modes) m.checked = m.value === prefs.mode;
  if (!modes.some((m) => m.checked)) modes[0].checked = true;
  render();
</script>

<style>
  .lc-solar {
    align-items: flex-end;
  }
  .lc-date {
    flex: 1 1 220px;
    max-width: 320px;
  }
  .lc-tables {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .lc-tables {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: start;
    }
  }
</style>
