    opacity: 0.6;
  }
  [data-tool='lucky-red-envelope'] .lre-mode :global(.lre-mode-icon) {
    color: var(--accent);
  }
  [data-tool='lucky-red-envelope'] .lre-mode-title {
    font-weight: 700;
    line-height: 1.4;
  }
  [data-tool='lucky-red-envelope'] .lre-mode-desc {
    grid-column: 1 / -1;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
