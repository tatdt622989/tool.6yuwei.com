---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';
import { buildLayout, Q } from './logic';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const layout = buildLayout(true, s.client.layout);
---

<div class="tool" data-tool="keyboard-tester" {...i18nAttrs(locale, s.client)}>
  <div class="row between">
    <label class="check"><input type="checkbox" id="kb-numpad" checked /> {s.numpad}</label>
    <button class="btn small" type="button" id="kb-reset">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path></svg>{`\n${s.reset}\n`}</button>
  </div>

  <div class="kb-area" id="kb-area" tabindex="0" role="application" aria-label={s.areaAria} aria-describedby="kb-prompt-text">
    <div class="kb-wrap">
      <div class="kb-board" id="kb-board" style={`--cols:${layout.columns};--keys:${layout.columns / Q}`}>
        {
          layout.keys.map((k) => (
            <span
              class="kb-key"
              data-code={k.code}
              data-block={k.block}
              data-label={k.label}
              data-mac={k.macLabel}
              data-mac-code={k.macCode}
              data-wide={k.w > Q * 1.5 ? '' : undefined}
              style={`grid-column:${k.x + 1} / span ${k.w};grid-row:${k.y + 1} / span ${k.h}`}
            >
              <span class="kb-cap">
                {k.top && <span class="kb-top">{k.top}</span>}
                <span class="kb-label">{k.label}</span>
              </span>
            </span>
          ))
        }
      </div>
    </div>
    <div class="kb-prompt" id="kb-prompt">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"></path></svg>
      <span id="kb-prompt-text">{s.prompt}</span>
    </div>
  </div>

  <div class="stats" aria-live="polite">
    <div class="stat"><span class="stat-value" id="kb-down">0</span><span class="stat-label">{s.statDown}</span></div>
    <div class="stat"><span class="stat-value" id="kb-max">0</span><span class="stat-label">{s.statMax}</span></div>
    <div class="stat"><span class="stat-value" id="kb-tested">0 / 0</span><span class="stat-label">{s.statTested}</span></div>
    <div class="stat"><span class="stat-value" id="kb-presses">0</span><span class="stat-label">{s.statPresses}</span></div>
  </div>

  <div class="kb-last" aria-live="polite">
    <div class="kb-last-item"><span class="stat-label">event.key</span><span class="kb-last-value mono" id="kb-key">—</span></div>
    <div class="kb-last-item"><span class="stat-label">event.code</span><span class="kb-last-value mono" id="kb-code">—</span></div>
    <div class="kb-last-item"><span class="stat-label">keyCode</span><span class="kb-last-value mono" id="kb-keycode">—</span></div>
    <div class="kb-last-item"><span class="stat-label">{s.location}</span><span class="kb-last-value" id="kb-location">—</span></div>
  </div>

  <p class="notice" id="kb-hint"></p>

  <div class="field" id="kb-held-field">
    <span class="label">{s.heldLabel}</span>
    <div class="kb-chips" id="kb-held"><span class="muted">{s.client.none}</span></div>
  </div>

  <div class="field" id="kb-extra-field" hidden>
    <span class="label">{s.extraLabel}</span>
    <div class="kb-chips" id="kb-extra"></div>
  </div>

  <p class="hint">{`\n${s.footnote}\n`}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { buildLayout, displayKey, keyCode, KeyTracker, locationLabel, normalizeCode, Q, rolloverHint, shouldPreventDefault } from './logic';
  import type { Strings } from './i18n';

  interface Prefs {
    numpad: boolean;
  }

  const root = $('[data-tool="keyboard-tester"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const layoutId = s.layout ?? 'ansi';
  const area = $('#kb-area', root);
  const board = $('#kb-board', root);
  const numpadBox = $<HTMLInputElement>('#kb-numpad', root);
  const downOut = $('#kb-down', root);
  const maxOut = $('#kb-max', root);
  const testedOut = $('#kb-tested', root);
  const pressesOut = $('#kb-presses', root);
  const keyOut = $('#kb-key', root);
  const codeOut = $('#kb-code', root);
  const keyCodeOut = $('#kb-keycode', root);
  const locationOut = $('#kb-location', root);
  const hint = $('#kb-hint', root);
  const held = $('#kb-held', root);
  const extraField = $('#kb-extra-field', root);
  const extra = $('#kb-extra', root);

  const isMac = /Mac|iPhone|iPad/i.test(
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform ?? '',
  );

  const keyEls = new Map<string, HTMLElement>();
  for (const el of $$('.kb-key', board)) {
    if (isMac && el.dataset.macCode) el.dataset.code = el.dataset.macCode;
    keyEls.set(el.dataset.code ?? '', el);
    if (isMac && el.dataset.mac) $('.kb-label', el).textContent = el.dataset.mac;
  }

  const tracker = new KeyTracker();
  const extraCodes = new Set<string>();
  let visibleCodes: string[] = [];

  function applyLayout(numpad: boolean) {
    const layout = buildLayout(numpad, layoutId);
    board.style.setProperty('--cols', String(layout.columns));
    board.style.setProperty('--keys', String(layout.columns / Q));
    board.classList.toggle('no-numpad', !numpad);
    visibleCodes = layout.keys.map((k) => keyCode(k, isMac));
  }

  function chip(text: string): HTMLElement {
    const el = document.createElement('span');
    el.className = 'kb-chip mono';
    el.textContent = text;
    return el;
  }

  function render() {
    for (const [code, el] of keyEls) {
      el.classList.toggle('is-down', tracker.down.has(code));
      el.classList.toggle('is-tested', tracker.tested.has(code));
    }
    downOut.textContent = formatInteger(tracker.down.size, locale);
    maxOut.textContent = formatInteger(tracker.maxSimultaneous, locale);
    testedOut.textContent = `${tracker.testedIn(visibleCodes)} / ${visibleCodes.length}`;
    pressesOut.textContent = formatInteger(tracker.presses, locale);
    hint.textContent = rolloverHint(tracker.maxSimultaneous, s.rollover);

    if (tracker.down.size === 0) {
      const none = document.createElement('span');
      none.className = 'muted';
      none.textContent = s.none;
      held.replaceChildren(none);
    } else {
      held.replaceChildren(...[...tracker.down].map(chip));
    }
    extraField.hidden = extraCodes.size === 0;
    extra.replaceChildren(...[...extraCodes].map(chip));
  }

  function showEvent(e: KeyboardEvent, code: string) {
    keyOut.textContent = displayKey(e.key, s.keys);
    codeOut.textContent = code;
    keyCodeOut.textContent = String(e.keyCode);
    locationOut.textContent = locationLabel(e.location, s.locations);
  }

  area.addEventListener('keydown', (e) => {
    if (shouldPreventDefault(e.code, e.ctrlKey, e.metaKey)) e.preventDefault();
    const code = normalizeCode(e.code, e.key);
    showEvent(e, code);
    if (!keyEls.has(code)) extraCodes.add(code);
    tracker.press(code);
    render();
  });

  area.addEventListener('keyup', (e) => {
    if (shouldPreventDefault(e.code, e.ctrlKey, e.metaKey)) e.preventDefault();
    const code = normalizeCode(e.code, e.key);
    // PrintScreen often only fires keyup on Windows; count it as tested.
    if (!tracker.tested.has(code)) {
      showEvent(e, code);
      if (!keyEls.has(code)) extraCodes.add(code);
      tracker.press(code);
    }
    tracker.release(code, isMac);
    render();
  });

  const releaseAll = () => {
    tracker.releaseAll();
    render();
  };
  area.addEventListener('blur', releaseAll);
  window.addEventListener('blur', releaseAll);
  area.addEventListener('pointerdown', () => area.focus());

  numpadBox.addEventListener('change', () => {
    applyLayout(numpadBox.checked);
    savePref('keyboard-tester', { numpad: numpadBox.checked } satisfies Prefs);
    render();
  });

  $('#kb-reset', root).addEventListener('click', () => {
    tracker.reset();
    extraCodes.clear();
    for (const el of [keyOut, codeOut, keyCodeOut, locationOut]) el.textContent = '—';
    render();
    area.focus();
  });

  const prefs = loadPref<Prefs>('keyboard-tester', {
    numpad: window.matchMedia('(min-width: 900px)').matches,
  });
  numpadBox.checked = prefs.numpad;
  applyLayout(prefs.numpad);
  render();
</script>

<style>
  .kb-area {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 12px;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .kb-area:focus {
    outline: none;
    cursor: default;
    border-color: var(--accent);
    box-shadow: var(--focus);
  }
  .kb-wrap {
    container-type: inline-size;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .kb-board {
    --u: clamp(28px, calc(100cqw / var(--keys)), 46px);
    display: grid;
    grid-template-columns: repeat(var(--cols), calc(var(--u) / 4));
    grid-template-rows: var(--u) calc(var(--u) * 0.3) repeat(5, var(--u));
    width: max-content;
    margin: 0 auto;
    user-select: none;
  }
  .kb-board.no-numpad .kb-key[data-block='numpad'] {
    display: none;
  }
  .kb-key {
    padding: 2px;
    min-width: 0;
  }
  .kb-cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    border-bottom-width: 3px;
    background: var(--surface);
    color: var(--text-2);
    font-size: calc(var(--u) * 0.3);
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s, border-color 0.12s, transform 0.08s;
  }
  .kb-key[data-wide] .kb-cap {
    font-size: calc(var(--u) * 0.26);
  }
  .kb-top {
    font-size: 0.8em;
    color: var(--muted);
  }
  .kb-key.is-tested .kb-cap {
    background: color-mix(in oklab, var(--success) 16%, var(--surface));
    border-color: color-mix(in oklab, var(--success) 55%, var(--border-strong));
    color: var(--text);
  }
  .kb-key.is-down .kb-cap {
    background: var(--accent);
    border-color: var(--accent-hover);
    color: var(--on-accent);
    transform: translateY(1px);
    border-bottom-width: 2px;
  }
  .kb-key.is-down .kb-top {
    color: inherit;
  }
  .kb-prompt {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    backdrop-filter: blur(1.5px);
    color: var(--text);
    font-weight: 600;
    font-size: 17px;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .kb-area:focus .kb-prompt {
    opacity: 0;
  }
  .kb-last {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
  }
  .kb-last-item {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    min-width: 0;
  }
  .kb-last-value {
    font-size: 20px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .kb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 30px;
    align-items: center;
  }
  :global(.kb-chip) {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 13px;
  }
  @media (prefers-reduced-motion: reduce) {
    .kb-cap,
    .kb-prompt,
    .kb-area {
      transition: none;
    }
    .kb-key.is-down .kb-cap {
      transform: none;
    }
  }
</style>
