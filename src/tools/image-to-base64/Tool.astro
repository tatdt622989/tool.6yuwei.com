<div class="tool" data-tool="image-to-base64">
  <label class="dropzone" id="ib-drop" tabindex="0">
    <input type="file" id="ib-file" accept="image/*" hidden />
    <strong>點擊選擇圖片，或拖曳到這裡</strong>
    <span class="hint">支援 PNG、JPG、WebP、GIF、SVG、ICO 等，也可以按 Ctrl/Cmd + V 貼上</span>
  </label>

  <div class="ib-preview" id="ib-preview" hidden>
    <div class="ib-frame"><img id="ib-img" alt="預覽" /></div>
    <div class="stats">
      <div class="stat"><span class="stat-value ib-small" id="ib-type">—</span><span class="stat-label">格式</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-dims">—</span><span class="stat-label">尺寸（px）</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-size">—</span><span class="stat-label">原始大小</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-len">—</span><span class="stat-label">Base64 大小</span></div>
    </div>
  </div>

  <p class="notice" id="ib-note" hidden></p>

  <div class="field">
    <span class="label">輸出格式</span>
    <div class="seg" role="radiogroup" aria-label="輸出格式">
      <label><input type="radio" name="ib-kind" value="datauri" checked /><span>Data URI</span></label>
      <label><input type="radio" name="ib-kind" value="base64" /><span>純 Base64</span></label>
      <label><input type="radio" name="ib-kind" value="css" /><span>CSS 背景</span></label>
      <label><input type="radio" name="ib-kind" value="html" /><span>HTML img</span></label>
    </div>
  </div>

  <div class="field">
    <label for="ib-out">轉換結果</label>
    <textarea id="ib-out" class="mono" rows="8" readonly placeholder="選擇圖片後，Base64 編碼會顯示在這裡"></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#ib-out" id="ib-copy" disabled>複製結果</button>
    <button class="btn" type="button" id="ib-save" disabled>下載為 .txt</button>
    <button class="btn ghost" type="button" id="ib-clear">清除</button>
  </div>

  <p class="hint">圖片只在你的瀏覽器中轉換，不會上傳到任何伺服器。</p>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger } from '../../lib/format';
  import { altFromFilename, base64Length, buildOutput, parseDataUri, SIZE_ADVICE, sizeLevel, type OutputKind } from './logic';

  const root = $('[data-tool="image-to-base64"]');
  const drop = $('#ib-drop', root);
  const fileInput = $<HTMLInputElement>('#ib-file', root);
  const preview = $('#ib-preview', root);
  const img = $<HTMLImageElement>('#ib-img', root);
  const note = $('#ib-note', root);
  const out = $<HTMLTextAreaElement>('#ib-out', root);
  const copyBtn = $<HTMLButtonElement>('#ib-copy', root);
  const saveBtn = $<HTMLButtonElement>('#ib-save', root);
  const kinds = $$<HTMLInputElement>('input[name="ib-kind"]', root);

  interface Current {
    name: string;
    dataUri: string;
    width?: number;
    height?: number;
  }
  let current: Current | null = null;
  let token = 0;

  const selectedKind = (): OutputKind => (kinds.find((k) => k.checked)?.value ?? 'datauri') as OutputKind;

  function readAsDataUri(file: Blob): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
  }

  function renderOutput() {
    const kind = selectedKind();
    savePref('image-to-base64', kind);
    out.value = current
      ? buildOutput(current.dataUri, kind, { alt: altFromFilename(current.name), width: current.width, height: current.height })
      : '';
    copyBtn.disabled = !out.value;
    saveBtn.disabled = !out.value;
  }

  async function load(file: File) {
    if (!file.type.startsWith('image/')) {
      note.hidden = false;
      note.className = 'notice error';
      note.textContent = '這不是圖片檔，請選擇 PNG、JPG、WebP、GIF 或 SVG 等圖片。';
      return;
    }
    const mine = ++token;
    try {
      const dataUri = await readAsDataUri(file);
      if (mine !== token) return;
      current = { name: file.name || 'image', dataUri };
      img.src = dataUri;
      preview.hidden = false;
      const parsed = parseDataUri(dataUri);
      $('#ib-type', root).textContent = (parsed?.mime ?? file.type).replace('image/', '').toUpperCase();
      $('#ib-size', root).textContent = formatBytes(file.size);
      $('#ib-len', root).textContent = formatBytes(base64Length(file.size));
      $('#ib-len', root).title = `${formatInteger(dataUri.length)} 個字元`;
      $('#ib-dims', root).textContent = '—';
      const level = sizeLevel(file.size);
      note.hidden = false;
      note.className = level === 'small' ? 'notice ok' : level === 'medium' ? 'notice' : 'notice error';
      note.textContent = `${SIZE_ADVICE[level]} 轉換後約 ${formatBytes(base64Length(file.size))}，比原檔大約三分之一。`;
      renderOutput();
      try {
        await img.decode();
        if (mine !== token || !current) return;
        current.width = img.naturalWidth || undefined;
        current.height = img.naturalHeight || undefined;
        $('#ib-dims', root).textContent = current.width ? `${current.width} × ${current.height}` : '—';
        renderOutput();
      } catch {
        /* Some formats (e.g. ICO in older browsers) cannot be previewed; the Base64 output is still valid. */
      }
    } catch {
      note.hidden = false;
      note.className = 'notice error';
      note.textContent = '讀取檔案失敗，請再試一次。';
    }
  }

  function clear() {
    token++;
    current = null;
    img.removeAttribute('src');
    preview.hidden = true;
    note.hidden = true;
    fileInput.value = '';
    renderOutput();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) void load(file);
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    const file = e.dataTransfer?.files[0];
    if (file) void load(file);
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const file = Array.from(e.clipboardData?.files ?? []).find((f) => f.type.startsWith('image/'));
    if (!file) return;
    e.preventDefault();
    void load(file.name && file.name !== 'image.png' ? file : new File([file], 'pasted-image.png', { type: file.type }));
  });

  kinds.forEach((k) => k.addEventListener('change', renderOutput));
  out.addEventListener('focus', () => out.select());
  saveBtn.addEventListener('click', () => {
    if (!current) return;
    downloadBlob(new Blob([out.value], { type: 'text/plain;charset=utf-8' }), `${altFromFilename(current.name) || 'image'}-base64.txt`);
  });
  $('#ib-clear', root).addEventListener('click', clear);

  const savedKind = loadPref<OutputKind>('image-to-base64', 'datauri');
  for (const k of kinds) k.checked = k.value === savedKind;
  renderOutput();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ib-preview {
    display: grid;
    gap: 14px;
    align-items: center;
  }
  @media (min-width: 640px) {
    .ib-preview {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }
  .ib-frame {
    display: grid;
    place-items: center;
    height: 200px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    /* Checkerboard so transparent areas are visible in both themes. */
    background: repeating-conic-gradient(var(--surface-2) 0% 25%, var(--surface) 0% 50%) 50% / 16px 16px;
  }
  .ib-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .ib-small {
    font-size: 18px;
  }
</style>
