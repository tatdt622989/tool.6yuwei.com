---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="image-to-base64" {...i18nAttrs(locale, s.client)}>
  <label class="dropzone" id="ib-drop" tabindex="0">
    <input type="file" id="ib-file" accept="image/*" hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="ib-preview" id="ib-preview" hidden>
    <div class="ib-frame"><img id="ib-img" alt={s.previewAlt} /></div>
    <div class="stats">
      <div class="stat"><span class="stat-value ib-small" id="ib-type">—</span><span class="stat-label">{s.statType}</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-dims">—</span><span class="stat-label">{s.statDims}</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-size">—</span><span class="stat-label">{s.statSize}</span></div>
      <div class="stat"><span class="stat-value ib-small" id="ib-len">—</span><span class="stat-label">{s.statLen}</span></div>
    </div>
  </div>

  <p class="notice" id="ib-note" hidden></p>

  <div class="field">
    <span class="label">{s.kindLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.kindLabel}>
      <label><input type="radio" name="ib-kind" value="datauri" checked /><span>{s.kinds.datauri}</span></label>
      <label><input type="radio" name="ib-kind" value="base64" /><span>{s.kinds.base64}</span></label>
      <label><input type="radio" name="ib-kind" value="css" /><span>{s.kinds.css}</span></label>
      <label><input type="radio" name="ib-kind" value="html" /><span>{s.kinds.html}</span></label>
    </div>
  </div>

  <div class="field">
    <label for="ib-out">{s.outLabel}</label>
    <textarea id="ib-out" class="mono" rows="8" readonly placeholder={s.outPlaceholder}></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#ib-out" id="ib-copy" disabled>{s.copy}</button>
    <button class="btn" type="button" id="ib-save" disabled>{s.save}</button>
    <button class="btn ghost" type="button" id="ib-clear">{s.clear}</button>
  </div>

  <p class="hint">{s.privacy}</p>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatInteger, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import { altFromFilename, base64Length, buildOutput, parseDataUri, sizeLevel, type OutputKind } from './logic';

  const root = $('[data-tool="image-to-base64"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const drop = $('#ib-drop', root);
  const fileInput = $<HTMLInputElement>('#ib-file', root);
  const preview = $('#ib-preview', root);
  const img = $<HTMLImageElement>('#ib-img', root);
  const note = $('#ib-note', root);
  const out = $<HTMLTextAreaElement>('#ib-out', root);
  const copyBtn = $<HTMLButtonElement>('#ib-copy', root);
  const saveBtn = $<HTMLButtonElement>('#ib-save', root);
  const kinds = $$<HTMLInputElement>('input[name="ib-kind"]', root);

  interface Current {
    name: string;
    dataUri: string;
    width?: number;
    height?: number;
  }
  let current: Current | null = null;
  let token = 0;

  const selectedKind = (): OutputKind => (kinds.find((k) => k.checked)?.value ?? 'datauri') as OutputKind;

  function readAsDataUri(file: Blob): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
  }

  function renderOutput() {
    const kind = selectedKind();
    savePref('image-to-base64', kind);
    out.value = current
      ? buildOutput(current.dataUri, kind, { alt: altFromFilename(current.name), width: current.width, height: current.height })
      : '';
    copyBtn.disabled = !out.value;
    saveBtn.disabled = !out.value;
  }

  async function load(file: File) {
    if (!file.type.startsWith('image/')) {
      note.hidden = false;
      note.className = 'notice error';
      note.textContent = s.notImage;
      return;
    }
    const mine = ++token;
    try {
      const dataUri = await readAsDataUri(file);
      if (mine !== token) return;
      current = { name: file.name || 'image', dataUri };
      img.src = dataUri;
      preview.hidden = false;
      const parsed = parseDataUri(dataUri);
      $('#ib-type', root).textContent = (parsed?.mime ?? file.type).replace('image/', '').toUpperCase();
      $('#ib-size', root).textContent = formatBytes(file.size, locale);
      $('#ib-len', root).textContent = formatBytes(base64Length(file.size), locale);
      $('#ib-len', root).title = t(s.chars, { n: formatInteger(dataUri.length, locale) });
      $('#ib-dims', root).textContent = '—';
      const level = sizeLevel(file.size);
      note.hidden = false;
      note.className = level === 'small' ? 'notice ok' : level === 'medium' ? 'notice' : 'notice error';
      note.textContent = t(s.note, { advice: s.sizeAdvice[level], size: formatBytes(base64Length(file.size), locale) });
      renderOutput();
      try {
        await img.decode();
        if (mine !== token || !current) return;
        current.width = img.naturalWidth || undefined;
        current.height = img.naturalHeight || undefined;
        $('#ib-dims', root).textContent = current.width ? `${current.width} × ${current.height}` : '—';
        renderOutput();
      } catch {
        /* Some formats (e.g. ICO in older browsers) cannot be previewed; the Base64 output is still valid. */
      }
    } catch {
      note.hidden = false;
      note.className = 'notice error';
      note.textContent = s.readError;
    }
  }

  function clear() {
    token++;
    current = null;
    img.removeAttribute('src');
    preview.hidden = true;
    note.hidden = true;
    fileInput.value = '';
    renderOutput();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) void load(file);
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    const file = e.dataTransfer?.files[0];
    if (file) void load(file);
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const file = Array.from(e.clipboardData?.files ?? []).find((f) => f.type.startsWith('image/'));
    if (!file) return;
    e.preventDefault();
    void load(file.name && file.name !== 'image.png' ? file : new File([file], 'pasted-image.png', { type: file.type }));
  });

  kinds.forEach((k) => k.addEventListener('change', renderOutput));
  out.addEventListener('focus', () => out.select());
  saveBtn.addEventListener('click', () => {
    if (!current) return;
    downloadBlob(new Blob([out.value], { type: 'text/plain;charset=utf-8' }), `${altFromFilename(current.name) || 'image'}-base64.txt`);
  });
  $('#ib-clear', root).addEventListener('click', clear);

  const savedKind = loadPref<OutputKind>('image-to-base64', 'datauri');
  for (const k of kinds) k.checked = k.value === savedKind;
  renderOutput();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ib-preview {
    display: grid;
    gap: 14px;
    align-items: center;
  }
  @media (min-width: 640px) {
    .ib-preview {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }
  .ib-frame {
    display: grid;
    place-items: center;
    height: 200px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    /* Checkerboard so transparent areas are visible in both themes. */
    background: repeating-conic-gradient(var(--surface-2) 0% 25%, var(--surface) 0% 50%) 50% / 16px 16px;
  }
  .ib-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .ib-small {
    font-size: 18px;
  }
</style>
