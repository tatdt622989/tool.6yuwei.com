---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const c = s.client;
---

<div class="tool" data-tool="cps-test" {...i18nAttrs(locale, c)}>
  <div class="row between">
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="cps-mode" value="1" /><span>{t(c.sec, { n: 1 })}</span></label>
      <label><input type="radio" name="cps-mode" value="5" checked /><span>{t(c.sec, { n: 5 })}</span></label>
      <label><input type="radio" name="cps-mode" value="10" /><span>{t(c.sec, { n: 10 })}</span></label>
      <label><input type="radio" name="cps-mode" value="30" /><span>{t(c.sec, { n: 30 })}</span></label>
      <label><input type="radio" name="cps-mode" value="60" /><span>{t(c.sec, { n: 60 })}</span></label>
    </div>
    <button class="btn small ghost" type="button" id="cps-reset">{s.reset}</button>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="cps-time">5.0</span><span class="stat-label">{s.statTime}</span></div>
    <div class="stat"><span class="stat-value" id="cps-count">0</span><span class="stat-label">{s.statClicks}</span></div>
    <div class="stat"><span class="stat-value" id="cps-live">0.0</span><span class="stat-label">{s.statLive}</span></div>
    <div class="stat"><span class="stat-value" id="cps-best">—</span><span class="stat-label" id="cps-best-label">{t(c.bestLabel, { s: t(c.sec, { n: 5 }) })}</span></div>
  </div>

  <div class="cps-pad" id="cps-pad" role="button" tabindex="0" data-phase="idle" aria-label={s.padAria}>
    <span class="cps-progress" aria-hidden="true"><span id="cps-progress-bar"></span></span>
    <svg class="cps-icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 3.5v3M4.5 8H7.5M5.6 4.6l2 2M12.4 4.6l-2 2" />
      <path d="M10 10l9.5 3.6-4.1 1.6-1.6 4.3z" />
    </svg>
    <span class="cps-main" id="cps-main">{c.idleMain}</span>
    <span class="cps-sub" id="cps-sub">{c.idleSub}</span>
  </div>

  <section class="result cps-result" id="cps-result" hidden aria-live="polite">
    <div class="cps-result-head">
      <div>
        <span class="result-label">{s.resultLabel}</span>
        <div class="result-value"><span id="cps-final">0</span> <small>CPS</small></div>
      </div>
      <div class="cps-rank">
        <span class="cps-badge" id="cps-rank">{c.ranks.rabbit.label}</span>
        <span class="cps-rank-note" id="cps-rank-note"></span>
      </div>
    </div>
    <p class="cps-summary" id="cps-summary"></p>
    <ol class="cps-ladder" id="cps-ladder" aria-label={s.ladderAria}></ol>
    <div class="cps-chart" id="cps-chart-wrap">
      <span class="label">{s.chartLabel}</span>
      <div class="cps-bars" id="cps-bars" role="img"></div>
    </div>
  </section>

  <div class="field">
    <div class="row between">
      <span class="label">{s.bestsLabel}</span>
      <button class="btn small ghost" type="button" id="cps-clear">{s.clear}</button>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>{s.thMode}</th><th class="num">{s.thBest}</th><th>{s.thRank}</th></tr></thead>
        <tbody id="cps-table"></tbody>
      </table>
    </div>
    <span class="hint">{s.hint}</span>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber } from '../../lib/format';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import {
    COOLDOWN_MS,
    MODES,
    RANKS,
    clicksPerSecond,
    createSession,
    finalCps,
    isMode,
    liveCps,
    mergeBest,
    rankFor,
    registerClick,
    remainingMs,
    sanitizeBest,
    tick,
    type BestScores,
    type CpsMode,
    type CpsSession,
  } from './logic';

  interface Prefs {
    mode: CpsMode;
    best: BestScores;
  }

  const root = $('[data-tool="cps-test"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const rankText = (id: string) => s.ranks[id as keyof typeof s.ranks];
  const fmt2 = (n: number) => formatNumber(n, 2, locale);
  const pad = $('#cps-pad', root);
  const main = $('#cps-main', root);
  const sub = $('#cps-sub', root);
  const timeEl = $('#cps-time', root);
  const countEl = $('#cps-count', root);
  const liveEl = $('#cps-live', root);
  const bestEl = $('#cps-best', root);
  const bestLabel = $('#cps-best-label', root);
  const bar = $('#cps-progress-bar', root);
  const result = $('#cps-result', root);
  const finalEl = $('#cps-final', root);
  const rankEl = $('#cps-rank', root);
  const rankNote = $('#cps-rank-note', root);
  const summary = $('#cps-summary', root);
  const ladder = $('#cps-ladder', root);
  const chartWrap = $('#cps-chart-wrap', root);
  const bars = $('#cps-bars', root);
  const table = $('#cps-table', root);
  const radios = $$<HTMLInputElement>('input[name="cps-mode"]', root);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const stored = loadPref<Partial<Prefs>>('cps-test', {});
  const prefs: Prefs = {
    mode: isMode(stored.mode) ? stored.mode : 5,
    best: sanitizeBest(stored.best),
  };

  let session: CpsSession = createSession(prefs.mode);
  let frame = 0;
  let cooldownTimer = 0;

  const fmt1 = (n: number) => n.toFixed(1);

  function persist() {
    savePref('cps-test', prefs);
  }

  function renderBest() {
    const best = prefs.best[`${session.duration}`];
    bestEl.textContent = best === undefined ? '—' : fmt2(best);
    bestLabel.textContent = t(s.bestLabel, { s: t(s.sec, { n: session.duration }) });
    table.replaceChildren(
      ...MODES.map((mode) => {
        const tr = document.createElement('tr');
        const value = prefs.best[`${mode}`];
        const cells = [t(s.sec, { n: mode }), value === undefined ? '—' : fmt2(value), value === undefined ? '—' : rankText(rankFor(value).id).label];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i === 1) td.className = 'num';
          tr.append(td);
        });
        if (mode === session.duration) tr.className = 'is-current';
        return tr;
      }),
    );
  }

  function renderLive(now: number) {
    const remaining = remainingMs(session, now);
    timeEl.textContent = fmt1(Math.max(0, remaining) / 1000);
    countEl.textContent = String(session.clicks.length);
    liveEl.textContent = fmt1(session.phase === 'done' ? finalCps(session) : liveCps(session, now));
    bar.style.transform = `scaleX(${remaining / (session.duration * 1000)})`;
    if (session.phase === 'running') main.textContent = String(session.clicks.length);
  }

  function renderIdle() {
    pad.dataset.phase = 'idle';
    main.textContent = s.idleMain;
    sub.textContent = s.idleSub;
    result.hidden = true;
    renderLive(0);
    renderBest();
  }

  function loop() {
    const now = performance.now();
    const next = tick(session, now);
    if (next !== session) {
      session = next;
      finish();
      return;
    }
    renderLive(now);
    frame = requestAnimationFrame(loop);
  }

  function stopLoop() {
    cancelAnimationFrame(frame);
    frame = 0;
  }

  function finish() {
    stopLoop();
    const cps = finalCps(session);
    const rank = rankFor(cps);
    const label = rankText(rank.id).label;
    const merged = mergeBest(prefs.best, session.duration, cps);
    prefs.best = merged.best;
    persist();
    renderLive(performance.now());
    renderBest();

    pad.dataset.phase = 'done';
    main.textContent = `${fmt2(cps)} CPS`;
    sub.textContent = t(s.doneSubWait, { rank: label });
    window.clearTimeout(cooldownTimer);
    cooldownTimer = window.setTimeout(() => {
      if (session.phase === 'done') sub.textContent = t(s.doneSubReady, { rank: label });
    }, COOLDOWN_MS);

    finalEl.textContent = fmt2(cps);
    rankEl.textContent = label;
    rankEl.dataset.rank = rank.id;
    rankNote.textContent = rankText(rank.id).note;
    const n = session.clicks.length;
    const best = prefs.best[`${session.duration}`];
    const secs = plural(locale, session.duration, s.secs);
    const vars = { s: session.duration, n, cps: fmt2(cps), clicks: plural(locale, n, s.clicks), secs };
    summary.textContent =
      t(s.summary, vars) +
      (merged.isNew ? t(s.summaryNew, vars) : best !== undefined ? t(s.summaryBest, { ...vars, best: fmt2(best) }) : '');

    ladder.replaceChildren(
      ...RANKS.map((r) => {
        const li = document.createElement('li');
        li.textContent = rankText(r.id).label;
        li.title = t(s.ladderTitle, { min: r.min });
        if (r.id === rank.id) {
          li.className = 'is-current';
          li.setAttribute('aria-current', 'true');
        }
        return li;
      }),
    );

    const perSecond = clicksPerSecond(session);
    chartWrap.hidden = session.duration < 5;
    if (!chartWrap.hidden) {
      const max = Math.max(1, ...perSecond);
      bars.replaceChildren(
        ...perSecond.map((v, i) => {
          const b = document.createElement('span');
          b.style.height = `${Math.max(2, (v / max) * 100)}%`;
          b.title = t(s.barTitle, { i: i + 1, v });
          return b;
        }),
      );
      const fastest = Math.max(...perSecond);
      const slowest = Math.min(...perSecond);
      bars.setAttribute('aria-label', t(s.barsAria, { fast: fastest, slow: slowest }));
    }
    result.hidden = false;
  }

  function ripple(event: PointerEvent) {
    if (reducedMotion.matches) return;
    const rect = pad.getBoundingClientRect();
    const dot = document.createElement('span');
    dot.className = 'cps-ripple';
    dot.style.left = `${event.clientX - rect.left}px`;
    dot.style.top = `${event.clientY - rect.top}px`;
    dot.addEventListener('animationend', () => dot.remove(), { once: true });
    const old = pad.querySelectorAll('.cps-ripple');
    if (old.length > 14) old[0].remove();
    pad.append(dot);
  }

  function hit(now: number) {
    const before = session;
    session = registerClick(session, now);
    if (session === before) return;
    if (session.phase === 'done') {
      finish();
      return;
    }
    if (before.phase !== 'running') {
      // A new run just started.
      window.clearTimeout(cooldownTimer);
      result.hidden = true;
      pad.dataset.phase = 'running';
      sub.textContent = s.runningSub;
      stopLoop();
      frame = requestAnimationFrame(loop);
    }
    renderLive(now);
  }

  pad.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    pad.focus({ preventScroll: true });
    ripple(event);
    hit(performance.now());
  });
  pad.addEventListener('keydown', (event) => {
    if (event.code !== 'Space' && event.key !== ' ' && event.key !== 'Enter') return;
    event.preventDefault();
    if (event.repeat) return;
    hit(performance.now());
  });
  pad.addEventListener('contextmenu', (event) => event.preventDefault());

  function setMode(mode: CpsMode) {
    stopLoop();
    window.clearTimeout(cooldownTimer);
    prefs.mode = mode;
    persist();
    session = createSession(mode);
    renderIdle();
  }

  radios.forEach((radio) => {
    radio.checked = Number(radio.value) === prefs.mode;
    radio.addEventListener('change', () => {
      const value = Number(radio.value);
      if (radio.checked && isMode(value)) setMode(value);
    });
  });
  $('#cps-reset', root).addEventListener('click', () => setMode(session.duration));
  $('#cps-clear', root).addEventListener('click', () => {
    prefs.best = {};
    persist();
    renderBest();
  });

  renderIdle();
</script>

<style>
  .cps-pad {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    min-height: clamp(220px, 42vh, 340px);
    padding: 28px 16px;
    overflow: hidden;
    text-align: center;
    border: 2px solid color-mix(in oklab, var(--accent) 35%, var(--border));
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--text);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: background 0.15s, border-color 0.15s;
  }
  .cps-pad:hover {
    border-color: var(--accent);
  }
  .cps-pad[data-phase='running'] {
    background: color-mix(in oklab, var(--accent) 20%, var(--surface));
    border-color: var(--accent);
  }
  .cps-pad[data-phase='done'] {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  .cps-icon {
    color: var(--accent);
  }
  .cps-pad[data-phase='running'] .cps-icon {
    display: none;
  }
  .cps-main {
    font-size: clamp(28px, 7vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .cps-pad[data-phase='running'] .cps-main {
    font-family: var(--mono);
    font-size: clamp(56px, 16vw, 96px);
  }
  .cps-sub {
    font-size: 14px;
    color: var(--text-2);
  }
  .cps-progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .cps-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
  }
  .cps-pad[data-phase='idle'] .cps-progress,
  .cps-pad[data-phase='done'] .cps-progress {
    visibility: hidden;
  }
  .cps-pad :global(.cps-ripple) {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 40%, transparent);
    pointer-events: none;
    animation: cps-ripple-grow 0.45s ease-out forwards;
  }
  @keyframes cps-ripple-grow {
    to {
      transform: scale(8);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cps-pad {
      transition: none;
    }
    .cps-pad :global(.cps-ripple) {
      display: none;
    }
  }

  .cps-result {
    display: grid;
    gap: 12px;
  }
  .cps-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .cps-result small {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-2);
  }
  .cps-rank {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }
  .cps-badge {
    padding: 4px 12px;
    font-size: 18px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 999px;
  }
  .cps-rank-note {
    font-size: 13px;
    color: var(--text-2);
  }
  @media (max-width: 480px) {
    .cps-rank {
      justify-items: start;
      text-align: left;
    }
  }
  .cps-summary {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .cps-ladder {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cps-ladder :global(li) {
    padding: 2px 10px;
    font-size: 13px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .cps-ladder :global(li.is-current) {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
  }
  .cps-chart {
    display: grid;
    gap: 6px;
  }
  .cps-chart .label {
    font-size: 13px;
    color: var(--text-2);
  }
  .cps-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 72px;
  }
  .cps-bars :global(span) {
    flex: 1;
    min-width: 2px;
    border-radius: 3px 3px 0 0;
    background: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .table :global(tr.is-current td) {
    font-weight: 700;
    color: var(--text);
  }
</style>
