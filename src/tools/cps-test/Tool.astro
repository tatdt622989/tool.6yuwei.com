<div class="tool" data-tool="cps-test">
  <div class="row between">
    <div class="seg" role="radiogroup" aria-label="測試時間">
      <label><input type="radio" name="cps-mode" value="1" /><span>1 秒</span></label>
      <label><input type="radio" name="cps-mode" value="5" checked /><span>5 秒</span></label>
      <label><input type="radio" name="cps-mode" value="10" /><span>10 秒</span></label>
      <label><input type="radio" name="cps-mode" value="30" /><span>30 秒</span></label>
      <label><input type="radio" name="cps-mode" value="60" /><span>60 秒</span></label>
    </div>
    <button class="btn small ghost" type="button" id="cps-reset">重新開始</button>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="cps-time">5.0</span><span class="stat-label">剩餘秒數</span></div>
    <div class="stat"><span class="stat-value" id="cps-count">0</span><span class="stat-label">點擊次數</span></div>
    <div class="stat"><span class="stat-value" id="cps-live">0.0</span><span class="stat-label">即時 CPS</span></div>
    <div class="stat"><span class="stat-value" id="cps-best">—</span><span class="stat-label" id="cps-best-label">5 秒最佳紀錄</span></div>
  </div>

  <div class="cps-pad" id="cps-pad" role="button" tabindex="0" data-phase="idle" aria-label="點擊區，點擊或按空白鍵計分">
    <span class="cps-progress" aria-hidden="true"><span id="cps-progress-bar"></span></span>
    <svg class="cps-icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 3.5v3M4.5 8H7.5M5.6 4.6l2 2M12.4 4.6l-2 2" />
      <path d="M10 10l9.5 3.6-4.1 1.6-1.6 4.3z" />
    </svg>
    <span class="cps-main" id="cps-main">點這裡開始</span>
    <span class="cps-sub" id="cps-sub">第一下點擊就開始計時，也可以按空白鍵</span>
  </div>

  <section class="result cps-result" id="cps-result" hidden aria-live="polite">
    <div class="cps-result-head">
      <div>
        <span class="result-label">你的點擊速度</span>
        <div class="result-value"><span id="cps-final">0</span> <small>CPS</small></div>
      </div>
      <div class="cps-rank">
        <span class="cps-badge" id="cps-rank">兔子</span>
        <span class="cps-rank-note" id="cps-rank-note"></span>
      </div>
    </div>
    <p class="cps-summary" id="cps-summary"></p>
    <ol class="cps-ladder" id="cps-ladder" aria-label="等級"></ol>
    <div class="cps-chart" id="cps-chart-wrap">
      <span class="label">每秒點擊次數</span>
      <div class="cps-bars" id="cps-bars" role="img"></div>
    </div>
  </section>

  <div class="field">
    <div class="row between">
      <span class="label">各模式最佳紀錄</span>
      <button class="btn small ghost" type="button" id="cps-clear">清除紀錄</button>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>測試時間</th><th class="num">最佳 CPS</th><th>等級</th></tr></thead>
        <tbody id="cps-table"></tbody>
      </table>
    </div>
    <span class="hint">紀錄只保存在這台裝置的瀏覽器中，不會上傳。</span>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber } from '../../lib/format';
  import {
    COOLDOWN_MS,
    MODES,
    RANKS,
    clicksPerSecond,
    createSession,
    finalCps,
    isMode,
    liveCps,
    mergeBest,
    rankFor,
    registerClick,
    remainingMs,
    sanitizeBest,
    tick,
    type BestScores,
    type CpsMode,
    type CpsSession,
  } from './logic';

  interface Prefs {
    mode: CpsMode;
    best: BestScores;
  }

  const root = $('[data-tool="cps-test"]');
  const pad = $('#cps-pad', root);
  const main = $('#cps-main', root);
  const sub = $('#cps-sub', root);
  const timeEl = $('#cps-time', root);
  const countEl = $('#cps-count', root);
  const liveEl = $('#cps-live', root);
  const bestEl = $('#cps-best', root);
  const bestLabel = $('#cps-best-label', root);
  const bar = $('#cps-progress-bar', root);
  const result = $('#cps-result', root);
  const finalEl = $('#cps-final', root);
  const rankEl = $('#cps-rank', root);
  const rankNote = $('#cps-rank-note', root);
  const summary = $('#cps-summary', root);
  const ladder = $('#cps-ladder', root);
  const chartWrap = $('#cps-chart-wrap', root);
  const bars = $('#cps-bars', root);
  const table = $('#cps-table', root);
  const radios = $$<HTMLInputElement>('input[name="cps-mode"]', root);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const stored = loadPref<Partial<Prefs>>('cps-test', {});
  const prefs: Prefs = {
    mode: isMode(stored.mode) ? stored.mode : 5,
    best: sanitizeBest(stored.best),
  };

  let session: CpsSession = createSession(prefs.mode);
  let frame = 0;
  let cooldownTimer = 0;

  const fmt1 = (n: number) => n.toFixed(1);

  function persist() {
    savePref('cps-test', prefs);
  }

  function renderBest() {
    const best = prefs.best[`${session.duration}`];
    bestEl.textContent = best === undefined ? '—' : formatNumber(best, 2);
    bestLabel.textContent = `${session.duration} 秒最佳紀錄`;
    table.replaceChildren(
      ...MODES.map((mode) => {
        const tr = document.createElement('tr');
        const value = prefs.best[`${mode}`];
        const cells = [`${mode} 秒`, value === undefined ? '—' : formatNumber(value, 2), value === undefined ? '—' : rankFor(value).label];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i === 1) td.className = 'num';
          tr.append(td);
        });
        if (mode === session.duration) tr.className = 'is-current';
        return tr;
      }),
    );
  }

  function renderLive(now: number) {
    const remaining = remainingMs(session, now);
    timeEl.textContent = fmt1(Math.max(0, remaining) / 1000);
    countEl.textContent = String(session.clicks.length);
    liveEl.textContent = fmt1(session.phase === 'done' ? finalCps(session) : liveCps(session, now));
    bar.style.transform = `scaleX(${remaining / (session.duration * 1000)})`;
    if (session.phase === 'running') main.textContent = String(session.clicks.length);
  }

  function renderIdle() {
    pad.dataset.phase = 'idle';
    main.textContent = '點這裡開始';
    sub.textContent = '第一下點擊就開始計時，也可以按空白鍵';
    result.hidden = true;
    renderLive(0);
    renderBest();
  }

  function loop() {
    const now = performance.now();
    const next = tick(session, now);
    if (next !== session) {
      session = next;
      finish();
      return;
    }
    renderLive(now);
    frame = requestAnimationFrame(loop);
  }

  function stopLoop() {
    cancelAnimationFrame(frame);
    frame = 0;
  }

  function finish() {
    stopLoop();
    const cps = finalCps(session);
    const rank = rankFor(cps);
    const merged = mergeBest(prefs.best, session.duration, cps);
    prefs.best = merged.best;
    persist();
    renderLive(performance.now());
    renderBest();

    pad.dataset.phase = 'done';
    main.textContent = `${formatNumber(cps, 2)} CPS`;
    sub.textContent = `${rank.label}｜稍等一下即可再測一次`;
    window.clearTimeout(cooldownTimer);
    cooldownTimer = window.setTimeout(() => {
      if (session.phase === 'done') sub.textContent = `${rank.label}｜點擊或按空白鍵再測一次`;
    }, COOLDOWN_MS);

    finalEl.textContent = formatNumber(cps, 2);
    rankEl.textContent = rank.label;
    rankEl.dataset.rank = rank.id;
    rankNote.textContent = rank.note;
    const n = session.clicks.length;
    const best = prefs.best[`${session.duration}`];
    summary.textContent =
      `${session.duration} 秒內點擊 ${n} 下，平均每秒 ${formatNumber(cps, 2)} 下。` +
      (merged.isNew ? `這是你目前的 ${session.duration} 秒最佳紀錄。` : best !== undefined ? `你的 ${session.duration} 秒最佳紀錄是 ${formatNumber(best, 2)} CPS。` : '');

    ladder.replaceChildren(
      ...RANKS.map((r) => {
        const li = document.createElement('li');
        li.textContent = r.label;
        li.title = `${r.min} CPS 以上`;
        if (r.id === rank.id) {
          li.className = 'is-current';
          li.setAttribute('aria-current', 'true');
        }
        return li;
      }),
    );

    const perSecond = clicksPerSecond(session);
    chartWrap.hidden = session.duration < 5;
    if (!chartWrap.hidden) {
      const max = Math.max(1, ...perSecond);
      bars.replaceChildren(
        ...perSecond.map((v, i) => {
          const b = document.createElement('span');
          b.style.height = `${Math.max(2, (v / max) * 100)}%`;
          b.title = `第 ${i + 1} 秒：${v} 下`;
          return b;
        }),
      );
      const fastest = Math.max(...perSecond);
      const slowest = Math.min(...perSecond);
      bars.setAttribute('aria-label', `每秒點擊次數，最快的一秒 ${fastest} 下，最慢的一秒 ${slowest} 下`);
    }
    result.hidden = false;
  }

  function ripple(event: PointerEvent) {
    if (reducedMotion.matches) return;
    const rect = pad.getBoundingClientRect();
    const dot = document.createElement('span');
    dot.className = 'cps-ripple';
    dot.style.left = `${event.clientX - rect.left}px`;
    dot.style.top = `${event.clientY - rect.top}px`;
    dot.addEventListener('animationend', () => dot.remove(), { once: true });
    const old = pad.querySelectorAll('.cps-ripple');
    if (old.length > 14) old[0].remove();
    pad.append(dot);
  }

  function hit(now: number) {
    const before = session;
    session = registerClick(session, now);
    if (session === before) return;
    if (session.phase === 'done') {
      finish();
      return;
    }
    if (before.phase !== 'running') {
      // A new run just started.
      window.clearTimeout(cooldownTimer);
      result.hidden = true;
      pad.dataset.phase = 'running';
      sub.textContent = '繼續點，越快越好';
      stopLoop();
      frame = requestAnimationFrame(loop);
    }
    renderLive(now);
  }

  pad.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    pad.focus({ preventScroll: true });
    ripple(event);
    hit(performance.now());
  });
  pad.addEventListener('keydown', (event) => {
    if (event.code !== 'Space' && event.key !== ' ' && event.key !== 'Enter') return;
    event.preventDefault();
    if (event.repeat) return;
    hit(performance.now());
  });
  pad.addEventListener('contextmenu', (event) => event.preventDefault());

  function setMode(mode: CpsMode) {
    stopLoop();
    window.clearTimeout(cooldownTimer);
    prefs.mode = mode;
    persist();
    session = createSession(mode);
    renderIdle();
  }

  radios.forEach((radio) => {
    radio.checked = Number(radio.value) === prefs.mode;
    radio.addEventListener('change', () => {
      const value = Number(radio.value);
      if (radio.checked && isMode(value)) setMode(value);
    });
  });
  $('#cps-reset', root).addEventListener('click', () => setMode(session.duration));
  $('#cps-clear', root).addEventListener('click', () => {
    prefs.best = {};
    persist();
    renderBest();
  });

  renderIdle();
</script>

<style>
  .cps-pad {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    min-height: clamp(220px, 42vh, 340px);
    padding: 28px 16px;
    overflow: hidden;
    text-align: center;
    border: 2px solid color-mix(in oklab, var(--accent) 35%, var(--border));
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--text);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: background 0.15s, border-color 0.15s;
  }
  .cps-pad:hover {
    border-color: var(--accent);
  }
  .cps-pad[data-phase='running'] {
    background: color-mix(in oklab, var(--accent) 20%, var(--surface));
    border-color: var(--accent);
  }
  .cps-pad[data-phase='done'] {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  .cps-icon {
    color: var(--accent);
  }
  .cps-pad[data-phase='running'] .cps-icon {
    display: none;
  }
  .cps-main {
    font-size: clamp(28px, 7vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .cps-pad[data-phase='running'] .cps-main {
    font-family: var(--mono);
    font-size: clamp(56px, 16vw, 96px);
  }
  .cps-sub {
    font-size: 14px;
    color: var(--text-2);
  }
  .cps-progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .cps-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
  }
  .cps-pad[data-phase='idle'] .cps-progress,
  .cps-pad[data-phase='done'] .cps-progress {
    visibility: hidden;
  }
  .cps-pad :global(.cps-ripple) {
    position: absolute;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 40%, transparent);
    pointer-events: none;
    animation: cps-ripple-grow 0.45s ease-out forwards;
  }
  @keyframes cps-ripple-grow {
    to {
      transform: scale(8);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cps-pad {
      transition: none;
    }
    .cps-pad :global(.cps-ripple) {
      display: none;
    }
  }

  .cps-result {
    display: grid;
    gap: 12px;
  }
  .cps-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .cps-result small {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-2);
  }
  .cps-rank {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }
  .cps-badge {
    padding: 4px 12px;
    font-size: 18px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 999px;
  }
  .cps-rank-note {
    font-size: 13px;
    color: var(--text-2);
  }
  @media (max-width: 480px) {
    .cps-rank {
      justify-items: start;
      text-align: left;
    }
  }
  .cps-summary {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .cps-ladder {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cps-ladder :global(li) {
    padding: 2px 10px;
    font-size: 13px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .cps-ladder :global(li.is-current) {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
  }
  .cps-chart {
    display: grid;
    gap: 6px;
  }
  .cps-chart .label {
    font-size: 13px;
    color: var(--text-2);
  }
  .cps-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 72px;
  }
  .cps-bars :global(span) {
    flex: 1;
    min-width: 2px;
    border-radius: 3px 3px 0 0;
    background: color-mix(in oklab, var(--accent) 70%, transparent);
  }
  .table :global(tr.is-current td) {
    font-weight: 700;
    color: var(--text);
  }
</style>
