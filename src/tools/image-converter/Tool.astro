<div class="tool" data-tool="image-converter">
  <label class="dropzone" id="cv-drop" tabindex="0">
    <input type="file" id="cv-file" accept="image/*,.heic,.heif" multiple hidden />
    <strong>點擊選擇圖片，或拖曳到這裡</strong>
    <span class="hint">支援 JPG、PNG、WebP、GIF、BMP、SVG 等，可一次選多張，也可以按 Ctrl/Cmd + V 貼上</span>
  </label>

  <div class="grid-3">
    <div class="field">
      <span class="label">轉換為</span>
      <div class="seg" role="radiogroup" aria-label="輸出格式">
        <label><input type="radio" name="cv-format" value="jpeg" checked /><span>JPG</span></label>
        <label><input type="radio" name="cv-format" value="png" /><span>PNG</span></label>
        <label><input type="radio" name="cv-format" value="webp" /><span>WebP</span></label>
        <label id="cv-avif-opt" hidden><input type="radio" name="cv-format" value="avif" /><span>AVIF</span></label>
      </div>
    </div>
    <div class="field">
      <label for="cv-quality">品質：<output id="cv-quality-out">90</output></label>
      <input id="cv-quality" type="range" min="10" max="100" step="1" value="90" />
      <span class="hint" id="cv-quality-hint">數字越大畫質越好、檔案越大</span>
    </div>
    <div class="field" id="cv-bg-field">
      <label for="cv-bg">透明區域背景色</label>
      <div class="row">
        <input id="cv-bg" type="color" value="#ffffff" />
        <span class="hint">JPG 不支援透明，透明處會填上此顏色</span>
      </div>
    </div>
  </div>

  <p class="notice" id="cv-note" hidden></p>

  <ul class="cv-list" id="cv-list" aria-live="polite"></ul>

  <div class="row" id="cv-actions" hidden>
    <button class="btn primary" type="button" id="cv-all">全部下載</button>
    <button class="btn ghost" type="button" id="cv-clear">清除</button>
  </div>

  <p class="hint">圖片只在你的瀏覽器中轉換，不會上傳到任何伺服器。</p>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatBytes, formatNumber } from '../../lib/format';
  import {
    FORMATS,
    formatLabel,
    hasTransparency,
    looksLikeImage,
    normalizeHex,
    outputFilename,
    sizeChangePercent,
    type TargetFormat,
  } from './logic';

  type AnyCanvas = HTMLCanvasElement | OffscreenCanvas;
  type Ctx = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;

  interface Result {
    blob: Blob;
    url: string;
    width: number;
    height: number;
    flattened: boolean;
    filename: string;
  }
  interface Item {
    file: File;
    row: HTMLLIElement;
    result?: Result;
    error?: string;
  }
  interface Prefs {
    format: TargetFormat;
    quality: number;
    background: string;
  }

  const root = $('[data-tool="image-converter"]');
  const drop = $('#cv-drop', root);
  const fileInput = $<HTMLInputElement>('#cv-file', root);
  const formatRadios = $$<HTMLInputElement>('input[name="cv-format"]', root);
  const quality = $<HTMLInputElement>('#cv-quality', root);
  const qualityOut = $('#cv-quality-out', root);
  const qualityHint = $('#cv-quality-hint', root);
  const bg = $<HTMLInputElement>('#cv-bg', root);
  const bgField = $('#cv-bg-field', root);
  const note = $('#cv-note', root);
  const list = $('#cv-list', root);
  const actions = $('#cv-actions', root);

  let items: Item[] = [];
  let generation = 0;

  // ---------- Canvas helpers ----------
  const useOffscreen = typeof OffscreenCanvas !== 'undefined' && 'convertToBlob' in OffscreenCanvas.prototype;

  function makeCanvas(width: number, height: number): AnyCanvas {
    if (useOffscreen) return new OffscreenCanvas(width, height);
    const c = document.createElement('canvas');
    c.width = width;
    c.height = height;
    return c;
  }

  function context(canvas: AnyCanvas): Ctx {
    const ctx = canvas.getContext('2d', { willReadFrequently: false }) as Ctx | null;
    if (!ctx) throw new Error('canvas');
    ctx.imageSmoothingQuality = 'high';
    return ctx;
  }

  function toBlob(canvas: AnyCanvas, type: string, q?: number): Promise<Blob> {
    if ('convertToBlob' in canvas) return canvas.convertToBlob({ type, quality: q });
    return new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q),
    );
  }

  /** Browsers silently fall back to PNG for unsupported types, so compare the result type. */
  async function canEncode(type: string): Promise<boolean> {
    try {
      const c = makeCanvas(2, 2);
      context(c).fillRect(0, 0, 2, 2);
      return (await toBlob(c, type, 0.8)).type === type;
    } catch {
      return false;
    }
  }

  async function decode(file: Blob): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { source: bmp, width: bmp.width, height: bmp.height, close: () => bmp.close() };
      } catch {
        /* SVG and some formats only decode through <img> */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      return { source: img, width: img.naturalWidth, height: img.naturalHeight, close: () => {} };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  /** Cheap transparency probe on a thumbnail instead of reading every pixel of a large image. */
  function probeTransparency(source: CanvasImageSource): boolean {
    const c = document.createElement('canvas');
    c.width = 96;
    c.height = 96;
    const ctx = c.getContext('2d', { willReadFrequently: true });
    if (!ctx) return false;
    ctx.drawImage(source, 0, 0, 96, 96);
    return hasTransparency(ctx.getImageData(0, 0, 96, 96).data);
  }

  // ---------- Settings ----------
  function readPrefs(): Prefs {
    const format = (formatRadios.find((r) => r.checked)?.value ?? 'jpeg') as TargetFormat;
    return { format, quality: Number(quality.value), background: normalizeHex(bg.value) ?? '#ffffff' };
  }

  function applyPrefs(p: Prefs) {
    for (const r of formatRadios) r.checked = r.value === p.format;
    quality.value = String(p.quality);
    bg.value = normalizeHex(p.background) ?? '#ffffff';
  }

  function syncControls() {
    const { format } = readPrefs();
    const lossy = FORMATS[format].lossy;
    quality.disabled = !lossy;
    qualityOut.textContent = lossy ? quality.value : '無損';
    qualityHint.textContent = lossy ? '數字越大畫質越好、檔案越大' : 'PNG 為無損格式，不需要設定品質';
    bgField.hidden = format !== 'jpeg';
  }

  // ---------- Conversion ----------
  async function convert(item: Item, prefs: Prefs): Promise<Result> {
    const spec = FORMATS[prefs.format];
    const image = await decode(item.file);
    try {
      if (!image.width || !image.height) throw new Error('size');
      const flattened = !spec.alpha && probeTransparency(image.source);
      const canvas = makeCanvas(image.width, image.height);
      const ctx = context(canvas);
      if (!spec.alpha) {
        ctx.fillStyle = prefs.background;
        ctx.fillRect(0, 0, image.width, image.height);
      }
      ctx.drawImage(image.source, 0, 0, image.width, image.height);
      const blob = await toBlob(canvas, spec.mime, spec.lossy ? prefs.quality / 100 : undefined);
      return {
        blob,
        url: URL.createObjectURL(blob),
        width: image.width,
        height: image.height,
        flattened,
        filename: outputFilename(item.file.name, prefs.format),
      };
    } finally {
      image.close();
    }
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    const thumb = el('div', 'cv-thumb');
    if (item.result) {
      const img = el('img');
      img.src = item.result.url;
      img.alt = '';
      img.loading = 'lazy';
      thumb.append(img);
    }
    const info = el('div', 'cv-info');
    const meta = el('div', 'cv-meta');
    info.append(el('div', 'cv-name', item.file.name), meta);
    const from = formatLabel(item.file.type, item.file.name);
    if (item.error) {
      meta.append(el('span', 'cv-error', item.error));
    } else if (!item.result) {
      meta.textContent = `${from}・${formatBytes(item.file.size)}，轉換中…`;
    } else {
      const r = item.result;
      const to = formatLabel(r.blob.type, r.filename);
      const change = sizeChangePercent(item.file.size, r.blob.size);
      const sign = change > 0 ? '+' : '';
      meta.textContent = `${from} → ${to}・${formatBytes(item.file.size)} → ${formatBytes(r.blob.size)}（${sign}${formatNumber(change, 0)}%）・${r.width} × ${r.height}`;
      if (r.flattened) info.append(el('div', 'hint', '原圖含透明區域，已填上背景色。'));
    }
    const btn = el('button', 'btn small', '下載');
    btn.type = 'button';
    btn.disabled = !item.result;
    btn.addEventListener('click', () => item.result && downloadBlob(item.result.blob, item.result.filename));
    row.append(thumb, info, btn);
  }

  function updateActions() {
    actions.hidden = items.length === 0;
    $<HTMLButtonElement>('#cv-all', root).disabled = !items.some((i) => i.result);
  }

  function releaseResult(item: Item) {
    if (item.result) URL.revokeObjectURL(item.result.url);
    item.result = undefined;
    item.error = undefined;
  }

  async function processAll(targets: Item[]) {
    const gen = generation;
    const prefs = readPrefs();
    for (const item of targets) {
      if (gen !== generation) return;
      try {
        const result = await convert(item, prefs);
        if (gen !== generation || !items.includes(item)) {
          URL.revokeObjectURL(result.url);
          return;
        }
        item.result = result;
      } catch {
        item.error = '無法讀取這張圖片，可能是瀏覽器不支援此格式（例如 HEIC 在非 Safari 瀏覽器）或檔案已損毀。';
      }
      drawRow(item);
      updateActions();
    }
  }

  function reprocess() {
    savePref('image-converter', readPrefs());
    syncControls();
    if (items.length === 0) return;
    generation++;
    for (const item of items) {
      releaseResult(item);
      drawRow(item);
    }
    updateActions();
    void processAll(items);
  }

  function addFiles(files: Iterable<File>) {
    const accepted: Item[] = [];
    let skipped = 0;
    for (const file of files) {
      if (!looksLikeImage(file.type, file.name)) {
        skipped++;
        continue;
      }
      const item: Item = { file, row: el('li', 'cv-item') };
      drawRow(item);
      list.append(item.row);
      accepted.push(item);
    }
    items.push(...accepted);
    note.hidden = skipped === 0;
    note.textContent = skipped ? `已略過 ${skipped} 個非圖片檔案。` : '';
    updateActions();
    void processAll(accepted);
  }

  function clearAll() {
    generation++;
    for (const item of items) releaseResult(item);
    items = [];
    list.replaceChildren();
    note.hidden = true;
    updateActions();
  }

  // ---------- Input wiring ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) addFiles(Array.from(e.dataTransfer.files));
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const files = Array.from(e.clipboardData?.files ?? []).filter((f) => f.type.startsWith('image/'));
    if (files.length === 0) return;
    e.preventDefault();
    const stamp = Date.now();
    addFiles(files.map((f, i) => new File([f], f.name && f.name !== 'image.png' ? f.name : `paste-${stamp}-${i + 1}.png`, { type: f.type })));
  });

  const reprocessSoon = debounce(reprocess, 350);
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    reprocessSoon();
  });
  bg.addEventListener('input', reprocessSoon);
  formatRadios.forEach((r) => r.addEventListener('change', reprocess));

  $('#cv-all', root).addEventListener('click', async () => {
    for (const item of items) {
      if (!item.result) continue;
      downloadBlob(item.result.blob, item.result.filename);
      await new Promise((r) => setTimeout(r, 350));
    }
  });
  $('#cv-clear', root).addEventListener('click', clearAll);

  const saved = loadPref<Prefs>('image-converter', { format: 'jpeg', quality: 90, background: '#ffffff' });
  applyPrefs({ ...saved, format: saved.format === 'avif' ? 'jpeg' : saved.format });
  syncControls();

  void Promise.all([canEncode('image/webp'), canEncode('image/avif')]).then(([webp, avif]) => {
    const webpRadio = formatRadios.find((r) => r.value === 'webp')!;
    webpRadio.disabled = !webp;
    if (!webp && webpRadio.checked) formatRadios[0].checked = true;
    if (avif) {
      $('#cv-avif-opt', root).hidden = false;
      if (saved.format === 'avif') {
        formatRadios.find((r) => r.value === 'avif')!.checked = true;
        if (items.length) reprocess();
        else syncControls();
      }
    }
    if (!webp) {
      note.hidden = false;
      note.textContent = '你的瀏覽器不支援輸出 WebP，已停用此選項。';
    }
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .cv-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-list:empty {
    display: none;
  }
  .cv-list :global(.cv-item) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .cv-list :global(.cv-thumb) {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .cv-list :global(.cv-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cv-list :global(.cv-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .cv-list :global(.cv-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cv-list :global(.cv-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .cv-list :global(.cv-error) {
    color: var(--danger);
  }
  @media (max-width: 420px) {
    .cv-list :global(.cv-item) {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .cv-list :global(.cv-thumb) {
      width: 48px;
      height: 48px;
    }
    .cv-list :global(.cv-item .btn) {
      grid-column: 1 / -1;
    }
  }
</style>
