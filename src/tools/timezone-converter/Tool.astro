---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="timezone-converter" {...i18nAttrs(locale, s.client)}>
  <div class="grid-2">
    <div class="field">
      <label for="tz-source">{s.sourceLabel}</label>
      <select id="tz-source"></select>
    </div>
    <div class="field">
      <label for="tz-when">{s.whenLabel}</label>
      <div class="tz-when">
        <input id="tz-when" type="datetime-local" step="60" />
        <button class="btn" type="button" id="tz-now">{s.now}</button>
      </div>
    </div>
  </div>

  <p class="hint" id="tz-utc" aria-live="polite"></p>
  <div class="notice" id="tz-status" hidden></div>

  <ul class="tz-list" id="tz-list" aria-label={s.listAria}></ul>

  <div class="field">
    <label for="tz-add">{s.addLabel}</label>
    <div class="tz-add">
      <select id="tz-add"></select>
      <button class="btn primary" type="button" id="tz-add-btn">{s.add}</button>
      <button class="btn ghost" type="button" id="tz-reset">{s.reset}</button>
    </div>
    <span class="hint">{s.hint}</span>
  </div>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import {
    buildDefaultZones,
    dayShift,
    DEFAULT_ZONES,
    formatOffset,
    hourDifference,
    instantToZoned,
    isDST,
    isValidTimeZone,
    listTimeZones,
    normalizeZones,
    parseWallTime,
    toWallTimeValue,
    ZONE_LABELS,
    zonedToInstant,
    zoneLabel,
    type ZonedTime,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="timezone-converter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const sourceSel = $<HTMLSelectElement>('#tz-source', root);
  const whenInput = $<HTMLInputElement>('#tz-when', root);
  const list = $('#tz-list', root);
  const addSel = $<HTMLSelectElement>('#tz-add', root);
  const status = $('#tz-status', root);
  const utcLine = $('#tz-utc', root);

  interface Prefs {
    source: string;
    zones: string[];
  }

  const pad = (n: number) => String(n).padStart(2, '0');
  const allZones = listTimeZones();
  const intl = LOCALE_INFO[locale].intl;
  const labels = s.preset?.labels ?? ZONE_LABELS;
  const label = (zone: string) => zoneLabel(zone, labels);

  let userZone: string | undefined;
  try {
    userZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  } catch {
    userZone = undefined;
  }
  const preset = s.preset;
  const defaultZones = preset ? buildDefaultZones(preset.zones, userZone, preset.userZone) : [...DEFAULT_ZONES];
  const defaultSource =
    preset?.source === 'user' ? (userZone && isValidTimeZone(userZone) ? userZone : defaultZones[0]) : (preset?.source ?? 'Asia/Taipei');
  // zh keeps its original storage key; other locales keep their own list.
  const prefKey = locale === 'zh-TW' ? 'timezone-converter' : `timezone-converter:${locale}`;

  const prefs = loadPref<Prefs>(prefKey, { source: defaultSource, zones: defaultZones });
  let source = isValidTimeZone(prefs.source) ? prefs.source : defaultSource;
  let zones = normalizeZones(prefs.zones, 24, defaultZones);

  function fillZoneSelect(select: HTMLSelectElement, selected?: string) {
    const common = document.createElement('optgroup');
    common.label = s.commonGroup;
    const seen = new Set<string>();
    for (const zone of Object.keys(labels)) {
      const name = labels[zone];
      if (seen.has(name) || !allZones.includes(zone)) continue;
      seen.add(name);
      common.append(new Option(t(s.commonOption, { label: name, zone }), zone));
    }
    const rest = document.createElement('optgroup');
    rest.label = s.allGroup;
    for (const zone of allZones) rest.append(new Option(zone.replace(/_/g, ' '), zone));
    select.replaceChildren(common, rest);
    if (selected) select.value = selected;
  }

  /** Wall clock text: 24-hour "14:30", or the locale's 12-hour form ("2:30 PM") where that is the habit. */
  function clockText(instant: number, zone: string, z: ZonedTime): string {
    if (!s.hour12) return `${pad(z.hour)}:${pad(z.minute)}`;
    return new Intl.DateTimeFormat(intl, { timeZone: zone, hour: 'numeric', minute: '2-digit', hour12: true }).format(instant);
  }

  function dateText(instant: number, zone: string, z: ZonedTime): string {
    if (s.weekdays && s.dateTpl) return t(s.dateTpl, { m: z.month, d: z.day, w: s.weekdays[z.weekday] });
    return new Intl.DateTimeFormat(intl, { timeZone: zone, weekday: 'short', month: 'short', day: 'numeric' }).format(instant);
  }

  function setNow() {
    const now = instantToZoned(Date.now(), source);
    whenInput.value = toWallTimeValue(now);
  }

  function persist() {
    savePref(prefKey, { source, zones } satisfies Prefs);
  }

  function formatDiff(hours: number): string {
    if (hours === 0) return s.same;
    return plural(locale, Math.abs(hours), hours > 0 ? s.ahead : s.behind);
  }

  function card(zone: string, instant: number, base: ZonedTime): HTMLLIElement {
    const z = instantToZoned(instant, zone);
    const shift = dayShift(base, z);
    const li = document.createElement('li');
    li.className = 'tz-card';
    if (zone === source) li.dataset.source = '';
    if (z.hour < 7 || z.hour >= 22) li.dataset.night = '';

    const info = document.createElement('div');
    info.className = 'tz-info';
    const name = document.createElement('div');
    name.className = 'tz-name';
    name.textContent = label(zone);
    const meta = document.createElement('div');
    meta.className = 'tz-meta';
    meta.textContent = [zone, formatOffset(z.offset), isDST(instant, zone) ? s.dst : ''].filter(Boolean).join(' · ');
    info.append(name, meta);

    const time = document.createElement('div');
    time.className = 'tz-time';
    const clock = document.createElement('div');
    clock.className = 'tz-clock';
    clock.textContent = clockText(instant, zone, z);
    const date = document.createElement('div');
    date.className = 'tz-date';
    const tags = [
      dateText(instant, zone, z),
      shift < 0 ? s.prevDay : shift > 0 ? s.nextDay : '',
      li.dataset.night === undefined ? '' : s.night,
      zone === source ? s.sourceTag : formatDiff(hourDifference(instant, source, zone)),
    ];
    date.textContent = tags.filter(Boolean).join(' · ');
    time.append(clock, date);

    const actions = document.createElement('div');
    actions.className = 'tz-actions';
    if (zone !== source) {
      const use = document.createElement('button');
      use.type = 'button';
      use.className = 'btn small ghost';
      use.textContent = s.useAsSource;
      use.dataset.use = zone;
      actions.append(use);
    }
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'btn small ghost';
    remove.textContent = s.remove;
    remove.dataset.remove = zone;
    remove.setAttribute('aria-label', t(s.removeAria, { label: label(zone) }));
    actions.append(remove);

    li.append(info, time, actions);
    return li;
  }

  function render() {
    persist();
    const wall = parseWallTime(whenInput.value);
    if (!wall) {
      utcLine.textContent = s.pickDate;
      status.hidden = true;
      list.replaceChildren();
      return;
    }
    const { instant, status: kind } = zonedToInstant(wall, source);
    const base = instantToZoned(instant, source);
    const u = new Date(instant);
    utcLine.textContent = t(s.utcLine, {
      label: label(source),
      offset: formatOffset(base.offset),
      utc: `${u.getUTCFullYear()}-${pad(u.getUTCMonth() + 1)}-${pad(u.getUTCDate())} ${pad(u.getUTCHours())}:${pad(u.getUTCMinutes())}`,
    });
    status.hidden = kind === 'ok';
    status.textContent = kind === 'gap' ? t(s.gap, { time: clockText(instant, source, base) }) : s.ambiguous;
    list.replaceChildren(...zones.map((zone) => card(zone, instant, base)));
    if (zones.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'notice';
      empty.textContent = s.empty;
      list.append(empty);
    }
  }

  fillZoneSelect(sourceSel, source);
  fillZoneSelect(addSel, 'Europe/Paris');
  setNow();

  sourceSel.addEventListener('change', () => {
    source = sourceSel.value;
    render();
  });
  whenInput.addEventListener('input', render);
  $('#tz-now', root).addEventListener('click', () => {
    setNow();
    render();
  });
  $('#tz-add-btn', root).addEventListener('click', () => {
    const zone = addSel.value;
    if (zone && !zones.includes(zone)) zones.push(zone);
    render();
  });
  $('#tz-reset', root).addEventListener('click', () => {
    zones = [...defaultZones];
    render();
  });
  list.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button');
    if (!button) return;
    const { remove, use } = button.dataset;
    if (remove) {
      zones = zones.filter((z) => z !== remove);
    } else if (use) {
      // Keep the same moment: show it as wall time in the new source zone.
      const wall = parseWallTime(whenInput.value);
      const instant = wall ? zonedToInstant(wall, source).instant : Date.now();
      source = use;
      sourceSel.value = source;
      whenInput.value = toWallTimeValue(instantToZoned(instant, source));
    }
    render();
  });
  render();
</script>

<style>
  .tz-when,
  .tz-add {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }
  .tz-add {
    grid-template-columns: 1fr auto auto;
  }
  @media (max-width: 420px) {
    .tz-add {
      grid-template-columns: 1fr 1fr;
    }
    .tz-add select {
      grid-column: 1 / -1;
    }
  }
  .tz-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tz-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'info time'
      'actions actions';
    align-items: center;
    gap: 4px 12px;
    padding: 12px 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .tz-card[data-source] {
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .tz-info {
    grid-area: info;
    min-width: 0;
  }
  .tz-name {
    font-weight: 700;
  }
  .tz-meta,
  .tz-date {
    font-size: 13px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .tz-time {
    grid-area: time;
    text-align: right;
  }
  .tz-clock {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .tz-card[data-night] .tz-clock {
    color: var(--text-2);
  }
  .tz-actions {
    grid-area: actions;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    margin: 0 -6px -6px 0;
  }
  @media (min-width: 640px) {
    .tz-card {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'info time actions';
    }
    .tz-actions {
      margin: 0;
      flex-direction: column;
      align-items: flex-end;
    }
  }
</style>
