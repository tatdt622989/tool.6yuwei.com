---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="image-compressor" {...i18nAttrs(locale, s.client)}>
  <label class="dropzone" id="ic-drop" tabindex="0">
    <input type="file" id="ic-file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" multiple hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="grid-3">
    <div class="field">
      <label for="ic-quality">{s.qualityBefore}<output id="ic-quality-out">80</output></label>
      <input id="ic-quality" type="range" min="10" max="100" step="1" value="80" />
      <span class="hint">{s.qualityHint}</span>
    </div>
    <div class="field">
      <span class="label">{s.formatLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.formatLabel}>
        <label><input type="radio" name="ic-format" value="keep" checked /><span>{s.keep}</span></label>
        <label><input type="radio" name="ic-format" value="jpeg" /><span>JPG</span></label>
        <label><input type="radio" name="ic-format" value="webp" /><span>WebP</span></label>
      </div>
    </div>
    <div class="field">
      <label for="ic-maxw">{s.maxWidthLabel}</label>
      <input id="ic-maxw" type="number" inputmode="numeric" min="1" step="1" placeholder={s.maxWidthPlaceholder} />
    </div>
  </div>

  <p class="notice" id="ic-note" hidden></p>

  <div class="stats" id="ic-summary" hidden>
    <div class="stat"><span class="stat-value" id="ic-count">0</span><span class="stat-label">{s.statCount}</span></div>
    <div class="stat"><span class="stat-value" id="ic-before">0 B</span><span class="stat-label">{s.statBefore}</span></div>
    <div class="stat"><span class="stat-value" id="ic-after">0 B</span><span class="stat-label">{s.statAfter}</span></div>
    <div class="stat"><span class="stat-value" id="ic-saved">0%</span><span class="stat-label">{s.statSaved}</span></div>
  </div>

  <ul class="ic-list" id="ic-list" aria-live="polite"></ul>

  <div class="row" id="ic-actions" hidden>
    <button class="btn primary" type="button" id="ic-all">{s.downloadAll}</button>
    <button class="btn ghost" type="button" id="ic-clear">{s.clear}</button>
  </div>

  <p class="hint">{s.privacy}</p>
</div>

<script>
  import { $, $$, debounce, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { isHeic, prepareImage } from '../../lib/heic';
  import { formatBytes, formatInteger, formatNumber, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import {
    fitToMaxWidth,
    isSupportedInput,
    needsOpaqueBackground,
    outputFilename,
    qualityApplies,
    resolveOutputType,
    savedPercent,
    shouldKeepOriginal,
    stepDownSizes,
    type OutputChoice,
  } from './logic';

  type AnyCanvas = HTMLCanvasElement | OffscreenCanvas;
  type Ctx = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;

  interface Result {
    blob: Blob;
    url: string;
    width: number;
    height: number;
    keptOriginal: boolean;
    filename: string;
  }
  interface Item {
    id: number;
    file: File;
    row: HTMLLIElement;
    result?: Result;
    error?: string;
  }
  interface Prefs {
    quality: number;
    format: OutputChoice;
    maxWidth: string;
  }

  const root = $('[data-tool="image-compressor"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const drop = $('#ic-drop', root);
  const fileInput = $<HTMLInputElement>('#ic-file', root);
  const quality = $<HTMLInputElement>('#ic-quality', root);
  const qualityOut = $('#ic-quality-out', root);
  const formatRadios = $$<HTMLInputElement>('input[name="ic-format"]', root);
  const maxWidth = $<HTMLInputElement>('#ic-maxw', root);
  const note = $('#ic-note', root);
  const list = $('#ic-list', root);
  const summary = $('#ic-summary', root);
  const actions = $('#ic-actions', root);

  let items: Item[] = [];
  let nextId = 1;
  let generation = 0;
  let webpSupported = true;

  // ---------- Canvas helpers ----------
  const useOffscreen = typeof OffscreenCanvas !== 'undefined' && 'convertToBlob' in OffscreenCanvas.prototype;

  function makeCanvas(width: number, height: number): AnyCanvas {
    if (useOffscreen) return new OffscreenCanvas(width, height);
    const c = document.createElement('canvas');
    c.width = width;
    c.height = height;
    return c;
  }

  function context(canvas: AnyCanvas): Ctx {
    const ctx = canvas.getContext('2d') as Ctx | null;
    if (!ctx) throw new Error('canvas');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    return ctx;
  }

  function toBlob(canvas: AnyCanvas, type: string, q?: number): Promise<Blob> {
    if ('convertToBlob' in canvas) return canvas.convertToBlob({ type, quality: q });
    return new Promise((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q),
    );
  }

  async function canEncode(type: string): Promise<boolean> {
    try {
      const c = makeCanvas(2, 2);
      context(c).fillRect(0, 0, 2, 2);
      return (await toBlob(c, type, 0.8)).type === type;
    } catch {
      return false;
    }
  }

  async function decode(file: Blob): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { source: bmp, width: bmp.width, height: bmp.height, close: () => bmp.close() };
      } catch {
        /* fall back to <img> */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      return { source: img, width: img.naturalWidth, height: img.naturalHeight, close: () => {} };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  /** Draws the source at the target size, halving in steps for large reductions. */
  function render(source: CanvasImageSource, sw: number, sh: number, tw: number, th: number, opaque: boolean): AnyCanvas {
    let current: CanvasImageSource = source;
    let cw = sw;
    let ch = sh;
    for (const step of stepDownSizes(sw, sh, tw, th)) {
      const c = makeCanvas(step.width, step.height);
      context(c).drawImage(current, 0, 0, cw, ch, 0, 0, step.width, step.height);
      current = c;
      cw = step.width;
      ch = step.height;
    }
    const out = makeCanvas(tw, th);
    const ctx = context(out);
    if (opaque) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, tw, th);
    }
    ctx.drawImage(current, 0, 0, cw, ch, 0, 0, tw, th);
    return out;
  }

  // ---------- Settings ----------
  function readPrefs(): Prefs {
    const format = (formatRadios.find((r) => r.checked)?.value ?? 'keep') as OutputChoice;
    return { quality: Number(quality.value), format, maxWidth: maxWidth.value };
  }

  function applyPrefs(p: Prefs) {
    quality.value = String(p.quality);
    for (const r of formatRadios) r.checked = r.value === p.format;
    maxWidth.value = p.maxWidth;
  }

  function updateNote() {
    const { format } = readPrefs();
    const messages: string[] = [];
    if (!webpSupported) messages.push(s.noWebp);
    const hasPng = items.some((i) => i.file.type === 'image/png');
    if (format === 'keep' && hasPng)
      messages.push(s.pngNote);
    note.textContent = messages.join(' ');
    note.hidden = messages.length === 0;
  }

  // ---------- Compression ----------
  async function compress(item: Item, prefs: Prefs): Promise<Result> {
    const src = await prepareImage(item.file);
    const type = resolveOutputType(src.type, prefs.format);
    const image = await decode(src);
    try {
      const limit = prefs.maxWidth.trim() === '' ? null : Number(prefs.maxWidth);
      const size = fitToMaxWidth(image.width, image.height, limit);
      const resized = size.width !== image.width;
      const canvas = render(image.source, image.width, image.height, size.width, size.height, needsOpaqueBackground(type));
      const blob = await toBlob(canvas, type, qualityApplies(type) ? prefs.quality / 100 : undefined);
      // A HEIC original is not what people want back, even when the JPEG is larger.
      if (src === item.file && shouldKeepOriginal(item.file.size, blob.size, resized)) {
        return {
          blob: item.file,
          url: URL.createObjectURL(item.file),
          width: image.width,
          height: image.height,
          keptOriginal: true,
          filename: item.file.name,
        };
      }
      return {
        blob,
        url: URL.createObjectURL(blob),
        width: size.width,
        height: size.height,
        keptOriginal: false,
        filename: outputFilename(item.file.name, blob.type || type),
      };
    } finally {
      image.close();
    }
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    const thumb = el('div', 'ic-thumb');
    if (item.result) {
      const img = el('img');
      img.src = item.result.url;
      img.alt = '';
      img.loading = 'lazy';
      thumb.append(img);
    }
    const info = el('div', 'ic-info');
    const meta = el('div', 'ic-meta');
    info.append(el('div', 'ic-name', item.file.name), meta);
    if (item.error) {
      meta.append(el('span', 'ic-error', item.error));
    } else if (!item.result) {
      meta.textContent = t(s.processing, { size: formatBytes(item.file.size, locale) });
    } else {
      const r = item.result;
      const pct = savedPercent(item.file.size, r.blob.size);
      meta.textContent = t(s.done, {
        before: formatBytes(item.file.size, locale),
        after: formatBytes(r.blob.size, locale),
        width: r.width,
        height: r.height,
      });
      const badge = el('span', r.keptOriginal ? 'ic-badge' : 'ic-badge ok', r.keptOriginal ? s.kept : `-${formatNumber(pct, 0, locale)}%`);
      meta.append(' ', badge);
      if (r.keptOriginal) info.append(el('div', 'hint', s.keptHint));
    }
    const btn = el('button', 'btn small', s.download);
    btn.type = 'button';
    btn.disabled = !item.result;
    btn.addEventListener('click', () => item.result && downloadBlob(item.result.blob, item.result.filename));
    row.append(thumb, info, btn);
  }

  function updateSummary() {
    const done = items.filter((i) => i.result);
    summary.hidden = items.length === 0;
    actions.hidden = items.length === 0;
    const before = done.reduce((s, i) => s + i.file.size, 0);
    const after = done.reduce((s, i) => s + i.result!.blob.size, 0);
    $('#ic-count', root).textContent = formatInteger(items.length, locale);
    $('#ic-before', root).textContent = formatBytes(before, locale);
    $('#ic-after', root).textContent = formatBytes(after, locale);
    $('#ic-saved', root).textContent = done.length ? `${formatNumber(Math.max(0, savedPercent(before, after)), 1, locale)}%` : '—';
    $<HTMLButtonElement>('#ic-all', root).disabled = done.length === 0;
  }

  function releaseResult(item: Item) {
    if (item.result) URL.revokeObjectURL(item.result.url);
    item.result = undefined;
    item.error = undefined;
  }

  async function processAll(targets: Item[]) {
    const gen = generation;
    const prefs = readPrefs();
    for (const item of targets) {
      if (gen !== generation) return;
      try {
        const result = await compress(item, prefs);
        if (gen !== generation || !items.includes(item)) {
          URL.revokeObjectURL(result.url);
          return;
        }
        item.result = result;
      } catch {
        item.error = s.error;
      }
      drawRow(item);
      updateSummary();
    }
  }

  function reprocess() {
    savePref('image-compressor', readPrefs());
    qualityOut.textContent = quality.value;
    updateNote();
    if (items.length === 0) return;
    generation++;
    for (const item of items) {
      releaseResult(item);
      drawRow(item);
    }
    updateSummary();
    void processAll(items);
  }

  function addFiles(files: Iterable<File>) {
    const accepted: Item[] = [];
    let skipped = 0;
    for (const file of files) {
      if (!isSupportedInput(file.type) && !isHeic(file.type, file.name)) {
        skipped++;
        continue;
      }
      const item: Item = { id: nextId++, file, row: el('li', 'ic-item') };
      drawRow(item);
      list.append(item.row);
      accepted.push(item);
    }
    items.push(...accepted);
    updateNote();
    if (skipped) {
      note.hidden = false;
      note.textContent = skipped === 1 && s.skippedOne ? s.skippedOne : t(s.skipped, { n: skipped });
    }
    updateSummary();
    // Continue an in-flight run if there is one; otherwise start on the new items.
    void processAll(accepted);
  }

  function clearAll() {
    generation++;
    for (const item of items) releaseResult(item);
    items = [];
    list.replaceChildren();
    fileInput.value = '';
    updateNote();
    updateSummary();
  }

  // ---------- Input wiring ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) addFiles(Array.from(e.dataTransfer.files));
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const files = Array.from(e.clipboardData?.files ?? []).filter((f) => f.type.startsWith('image/'));
    if (files.length === 0) return;
    e.preventDefault();
    // Pasted screenshots are often named "image.png"; give them a unique name.
    const stamp = Date.now();
    addFiles(files.map((f, i) => new File([f], f.name && f.name !== 'image.png' ? f.name : `paste-${stamp}-${i + 1}.png`, { type: f.type })));
  });

  const reprocessSoon = debounce(reprocess, 350);
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    reprocessSoon();
  });
  maxWidth.addEventListener('input', reprocessSoon);
  formatRadios.forEach((r) => r.addEventListener('change', reprocess));

  $('#ic-all', root).addEventListener('click', async () => {
    for (const item of items) {
      if (!item.result) continue;
      downloadBlob(item.result.blob, item.result.filename);
      await new Promise((r) => setTimeout(r, 350));
    }
  });
  $('#ic-clear', root).addEventListener('click', clearAll);

  applyPrefs(loadPref<Prefs>('image-compressor', { quality: 80, format: 'keep', maxWidth: '' }));
  qualityOut.textContent = quality.value;
  void canEncode('image/webp').then((ok) => {
    webpSupported = ok;
    const webp = formatRadios.find((r) => r.value === 'webp')!;
    webp.disabled = !ok;
    if (!ok && webp.checked) {
      formatRadios.find((r) => r.value === 'keep')!.checked = true;
    }
    updateNote();
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ic-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ic-list:empty {
    display: none;
  }
  .ic-list :global(.ic-item) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .ic-list :global(.ic-thumb) {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .ic-list :global(.ic-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ic-list :global(.ic-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .ic-list :global(.ic-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ic-list :global(.ic-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .ic-list :global(.ic-badge) {
    display: inline-block;
    padding: 0 6px;
    border-radius: 4px;
    font-weight: 600;
    color: var(--warning);
    background: color-mix(in oklab, var(--warning) 12%, transparent);
  }
  .ic-list :global(.ic-badge.ok) {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 12%, transparent);
  }
  .ic-list :global(.ic-error) {
    color: var(--danger);
  }
  @media (max-width: 420px) {
    .ic-list :global(.ic-item) {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .ic-list :global(.ic-thumb) {
      width: 48px;
      height: 48px;
    }
    .ic-list :global(.ic-item .btn) {
      grid-column: 1 / -1;
    }
  }
</style>
