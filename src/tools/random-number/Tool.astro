---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const dec = s.decimalOptions;
/** Label text before an inline <select>, with the same surrounding whitespace the markup had before i18n. */
const inline = (text: string) => `\n${text}\n`;
---

<div class="tool" data-tool="random-number" {...i18nAttrs(locale, s.client)}>
  <div class="seg" role="radiogroup" aria-label={s.modeAria}>
    <label><input type="radio" name="rn-mode" value="number" checked /><span>{s.modes.number}</span></label>
    <label><input type="radio" name="rn-mode" value="dice" /><span>{s.modes.dice}</span></label>
    <label><input type="radio" name="rn-mode" value="coin" /><span>{s.modes.coin}</span></label>
  </div>

  <form class="rn-panel" data-panel="number" id="rn-number-form">
    <div class="grid-4">
      <div class="field">
        <label for="rn-min">{s.min}</label>
        <input id="rn-min" type="text" inputmode="decimal" value="1" autocomplete="off" />
      </div>
      <div class="field">
        <label for="rn-max">{s.max}</label>
        <input id="rn-max" type="text" inputmode="decimal" value="100" autocomplete="off" />
      </div>
      <div class="field">
        <label for="rn-count">{s.count}</label>
        <input id="rn-count" type="number" min="1" max="10000" step="1" value="1" inputmode="numeric" />
      </div>
      <div class="field">
        <label for="rn-decimals">{s.decimals}</label>
        <select id="rn-decimals">
          <option value="0">{dec[0]}</option>
          <option value="1">{dec[1]}</option>
          <option value="2">{dec[2]}</option>
          <option value="3">{dec[3]}</option>
          <option value="4">{dec[4]}</option>
          <option value="5">{dec[5]}</option>
          <option value="6">{dec[6]}</option>
        </select>
      </div>
    </div>
    <div class="row rn-options">
      <label class="check"><input id="rn-unique" type="checkbox" /> {s.unique}</label>
      <label class="rn-inline" for="rn-sort">{inline(s.sort)}<select id="rn-sort">
          <option value="none">{s.sortNone}</option>
          <option value="asc">{s.sortAsc}</option>
          <option value="desc">{s.sortDesc}</option>
        </select>
      </label>
      <label class="rn-inline" for="rn-sep">{inline(s.separator)}<select id="rn-sep">
          <option value="newline">{s.sepNewline}</option>
          <option value="comma">{s.sepComma}</option>
          <option value="space">{s.sepSpace}</option>
        </select>
      </label>
    </div>
    <div class="row">
      <span class="hint">{s.presetsLabel}</span>
      {s.presets.map((p, i) => <Fragment>{i > 0 && ' '}<button class="btn small" type="button" data-preset={p.preset} data-bonus={p.bonus} data-bonus-label={p.bonusLabel}>{p.label}</button></Fragment>)}
    </div>
    <div class="row">
      <button class="btn primary" type="submit">{s.generate}</button>
    </div>
  </form>

  <form class="rn-panel" data-panel="dice" id="rn-dice-form" hidden>
    <div class="row">
      <div class="field rn-num">
        <label for="rn-dice-count">{s.diceCount}</label>
        <input id="rn-dice-count" type="number" min="1" max="10" step="1" value="2" inputmode="numeric" />
      </div>
    </div>
    <div class="row">
      <button class="btn primary" type="submit">{s.rollDice}</button>
    </div>
  </form>

  <form class="rn-panel" data-panel="coin" id="rn-coin-form" hidden>
    <div class="row">
      <div class="field rn-num">
        <label for="rn-coin-count">{s.coinCount}</label>
        <input id="rn-coin-count" type="number" min="1" max="1000" step="1" value="1" inputmode="numeric" />
      </div>
    </div>
    <div class="row">
      <button class="btn primary" type="submit">{s.flipCoin}</button>
    </div>
  </form>

  <div class="notice error" id="rn-error" hidden></div>

  <div class="rn-result" id="rn-result" aria-live="polite"></div>

  <div class="row">
    <button class="btn" type="button" id="rn-copy" disabled>{s.copy}</button>
  </div>
</div>

<script>
  import { $, $$, copyText, flashButton, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import { dicePips, flipCoins, formatValue, generateNumbers, parsePreset, rollDice, type Preset, type SortOrder } from './logic';
  import type { Strings } from './i18n';

  type Mode = 'number' | 'dice' | 'coin';
  type Separator = 'newline' | 'comma' | 'space';

  interface Prefs {
    mode: Mode;
    min: string;
    max: string;
    count: number;
    decimals: number;
    unique: boolean;
    sort: SortOrder;
    sep: Separator;
    dice: number;
    coins: number;
  }

  const defaults: Prefs = {
    mode: 'number',
    min: '1',
    max: '100',
    count: 1,
    decimals: 0,
    unique: false,
    sort: 'none',
    sep: 'newline',
    dice: 2,
    coins: 1,
  };
  const SEPARATOR: Record<Separator, string> = { newline: '\n', comma: ', ', space: ' ' };

  const root = $('[data-tool="random-number"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const minInput = $<HTMLInputElement>('#rn-min', root);
  const maxInput = $<HTMLInputElement>('#rn-max', root);
  const countInput = $<HTMLInputElement>('#rn-count', root);
  const decimals = $<HTMLSelectElement>('#rn-decimals', root);
  const unique = $<HTMLInputElement>('#rn-unique', root);
  const sort = $<HTMLSelectElement>('#rn-sort', root);
  const sep = $<HTMLSelectElement>('#rn-sep', root);
  const diceCount = $<HTMLInputElement>('#rn-dice-count', root);
  const coinCount = $<HTMLInputElement>('#rn-coin-count', root);
  const copyBtn = $<HTMLButtonElement>('#rn-copy', root);
  const error = $('#rn-error', root);
  const result = $('#rn-result', root);
  const panels = $$<HTMLElement>('[data-panel]', root);

  let lastValues: string[] = [];
  /** Lottery second-zone line shown under the list ('' when none); copied after the main numbers. */
  let bonusText = '';
  /** Second zone of the active lottery preset (e.g. the Powerball); cleared when the user edits the range. */
  let bonus: { spec: Preset; label: string } | null = null;

  const mode = () => $<HTMLInputElement>('input[name="rn-mode"]:checked', root).value as Mode;
  const intValue = (input: HTMLInputElement, fallback: number) => {
    const n = Math.floor(parseNumber(input.value));
    return Number.isFinite(n) ? n : fallback;
  };
  const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));

  function readPrefs(): Prefs {
    return {
      mode: mode(),
      min: minInput.value,
      max: maxInput.value,
      count: intValue(countInput, 1),
      decimals: Number(decimals.value),
      unique: unique.checked,
      sort: sort.value as SortOrder,
      sep: sep.value as Separator,
      dice: clamp(intValue(diceCount, 2), 1, 10),
      coins: clamp(intValue(coinCount, 1), 1, 1000),
    };
  }

  function applyPrefs(p: Prefs) {
    const radio = root.querySelector<HTMLInputElement>(`input[name="rn-mode"][value="${p.mode}"]`);
    if (radio) radio.checked = true;
    minInput.value = p.min;
    maxInput.value = p.max;
    countInput.value = String(p.count);
    decimals.value = String(p.decimals);
    unique.checked = p.unique;
    sort.value = p.sort;
    sep.value = p.sep;
    diceCount.value = String(p.dice);
    coinCount.value = String(p.coins);
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = message === '';
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function finish(values: string[], extra = '') {
    lastValues = values;
    bonusText = extra;
    copyBtn.disabled = values.length === 0;
    // Restart the reveal animation (disabled by CSS under prefers-reduced-motion).
    result.classList.remove('is-new');
    void result.offsetWidth;
    result.classList.add('is-new');
  }

  function runNumbers() {
    const p = readPrefs();
    savePref('random-number', p);
    const outcome = generateNumbers({
      min: parseNumber(p.min),
      max: parseNumber(p.max),
      count: p.count,
      decimals: p.decimals,
      unique: p.unique,
      sort: p.sort,
    });
    if (!outcome.ok) {
      const vars = outcome.vars;
      showError(
        t(s.errors[outcome.code], {
          max: formatInteger(vars.max ?? 0, locale),
          size: formatInteger(vars.size ?? 0, locale),
          count: formatInteger(vars.count ?? 0, locale),
        }),
      );
      result.replaceChildren();
      finish([]);
      return;
    }
    showError('');
    const values = outcome.values.map((v) => formatValue(v, p.decimals));
    if (values.length === 1) {
      result.replaceChildren(el('div', 'big-display rn-big', values[0]));
    } else {
      const out = el('div', 'output rn-list', values.join(SEPARATOR[p.sep]));
      const nums = outcome.values;
      const sum = nums.reduce((a, b) => a + b, 0);
      const stats = el('div', 'stats');
      for (const [label, value] of [
        [s.statCount, formatInteger(nums.length, locale)],
        [s.statMin, formatNumber(Math.min(...nums), p.decimals, locale)],
        [s.statMax, formatNumber(Math.max(...nums), p.decimals, locale)],
        [s.statMean, formatNumber(sum / nums.length, Math.max(2, p.decimals), locale)],
      ]) {
        const stat = el('div', 'stat');
        stat.append(el('span', 'stat-value', value), el('span', 'stat-label', label));
        stats.append(stat);
      }
      result.replaceChildren(out, stats);
    }
    let extraText = '';
    if (bonus && s.bonus) {
      const extra = generateNumbers({ ...bonus.spec, sort: 'asc' });
      if (extra.ok) {
        extraText = t(s.bonus, { label: bonus.label, n: extra.values.join(', ') });
        result.querySelector('.rn-list, .rn-big')?.after(el('p', 'rn-bonus', extraText));
      }
    }
    finish(values, extraText);
  }

  function runDice() {
    const p = readPrefs();
    savePref('random-number', p);
    showError('');
    const roll = rollDice(p.dice);
    const row = el('div', 'rn-dice');
    for (const face of roll.values) {
      const die = el('div', 'rn-die');
      die.setAttribute('role', 'img');
      die.setAttribute('aria-label', t(s.dieFace, { n: face }));
      const pips = new Set(dicePips(face));
      for (let i = 0; i < 9; i++) die.append(el('span', pips.has(i) ? 'rn-pip' : ''));
      row.append(die);
    }
    const summary = el(
      'p',
      'rn-summary',
      roll.values.length > 1 ? `${roll.values.join(' + ')} = ${roll.sum}` : t(s.singleDie, { n: roll.sum }),
    );
    result.replaceChildren(row, summary);
    finish(roll.values.map(String));
  }

  function runCoins() {
    const p = readPrefs();
    savePref('random-number', p);
    showError('');
    const flips = flipCoins(p.coins);
    const labels = flips.values.map((v) => s.coin[v]);
    if (labels.length === 1) {
      const coin = el('div', `rn-coin is-${flips.values[0]}`, labels[0]);
      result.replaceChildren(coin);
    } else {
      const stats = el('div', 'stats');
      for (const [label, n] of [
        [s.coin.heads, flips.heads],
        [s.coin.tails, flips.tails],
      ] as const) {
        const stat = el('div', 'stat');
        stat.append(
          el('span', 'stat-value', t(s.times, { n: formatInteger(n, locale) })),
          el('span', 'stat-label', t(s.share, { label, pct: formatNumber((n / labels.length) * 100, 1, locale) })),
        );
        stats.append(stat);
      }
      result.replaceChildren(stats, el('div', 'output rn-list', labels.join(s.listSep)));
    }
    finish(labels);
  }

  const runners: Record<Mode, () => void> = { number: runNumbers, dice: runDice, coin: runCoins };

  function switchMode() {
    const m = mode();
    for (const panel of panels) panel.hidden = panel.dataset.panel !== m;
    copyBtn.disabled = true;
    runners[m]();
  }

  applyPrefs(loadPref('random-number', defaults));

  for (const form of $$<HTMLFormElement>('form', root)) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runners[mode()]();
    });
  }
  for (const radio of $$<HTMLInputElement>('input[name="rn-mode"]', root)) radio.addEventListener('change', switchMode);
  for (const input of [minInput, maxInput, countInput, decimals, unique]) input.addEventListener('input', () => (bonus = null));
  sep.addEventListener('change', () => {
    const list = result.querySelector('.rn-list');
    if (list && mode() === 'number') list.textContent = lastValues.join(SEPARATOR[sep.value as Separator]);
    savePref('random-number', readPrefs());
  });
  for (const button of $$<HTMLButtonElement>('[data-preset]', root)) {
    button.addEventListener('click', () => {
      const preset = parsePreset(button.dataset.preset ?? '');
      if (!preset) return;
      minInput.value = String(preset.min);
      maxInput.value = String(preset.max);
      countInput.value = String(preset.count);
      unique.checked = preset.unique;
      decimals.value = String(preset.decimals);
      if (preset.unique) sort.value = 'asc';
      const extra = parsePreset(button.dataset.bonus ?? '');
      bonus = extra ? { spec: extra, label: button.dataset.bonusLabel ?? '' } : null;
      runNumbers();
    });
  }
  copyBtn.addEventListener('click', async () => {
    if (lastValues.length === 0) return;
    const separator = mode() === 'number' ? SEPARATOR[sep.value as Separator] : mode() === 'coin' ? s.listSep : ' ';
    const text = lastValues.join(separator) + (bonusText ? `${separator}${bonusText}` : '');
    if (await copyText(text)) flashButton(copyBtn);
  });

  switchMode();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .rn-panel {
    display: grid;
    gap: 14px;
  }
  .rn-options {
    gap: 12px 22px;
  }
  .rn-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
  }
  .rn-inline select {
    width: auto;
  }
  .rn-num {
    width: 160px;
  }
  .rn-result {
    display: grid;
    gap: 12px;
  }
  .rn-result:empty {
    display: none;
  }
  .rn-result :global(.rn-big) {
    padding: 18px 12px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    overflow-wrap: anywhere;
  }
  .rn-result :global(.rn-list) {
    max-height: 320px;
    overflow-y: auto;
    font-size: 16px;
  }
  .rn-result :global(.rn-dice) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    padding: 18px 12px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  .rn-result :global(.rn-die) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    width: 72px;
    height: 72px;
    padding: 10px;
    gap: 4px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
  }
  .rn-result :global(.rn-pip) {
    place-self: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text);
  }
  .rn-result :global(.rn-bonus) {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .rn-result :global(.rn-summary) {
    margin: 0;
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .rn-result :global(.rn-coin) {
    display: grid;
    place-items: center;
    width: 140px;
    height: 140px;
    margin: 8px auto;
    border-radius: 50%;
    font-size: 36px;
    font-weight: 700;
    color: var(--text);
    background: var(--surface-2);
    border: 6px double var(--border-strong);
  }
  .rn-result :global(.rn-coin.is-heads) {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .rn-result.is-new :global(.rn-big),
  .rn-result.is-new :global(.rn-die),
  .rn-result.is-new :global(.rn-coin) {
    animation: rn-pop 0.28s ease-out;
  }
  @keyframes rn-pop {
    from {
      transform: scale(0.9) rotate(-4deg);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rn-result.is-new :global(.rn-big),
    .rn-result.is-new :global(.rn-die),
    .rn-result.is-new :global(.rn-coin) {
      animation: none;
    }
  }
</style>
