<div class="tool" data-tool="mic-test">
  <div class="row between">
    <div class="row">
      <button class="btn primary" type="button" id="mt-start">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0014 0M12 18v3"></path></svg>
        <span id="mt-start-label">開始測試麥克風</span>
      </button>
      <button class="btn" type="button" id="mt-stop" hidden>停止</button>
    </div>
    <span class="mt-state" id="mt-state" data-state="idle"><span class="mt-dot" aria-hidden="true"></span><span id="mt-state-text">未啟動</span></span>
  </div>

  <div class="field" id="mt-device-field" hidden>
    <label for="mt-device">輸入裝置</label>
    <select id="mt-device"></select>
  </div>

  <div class="notice error mt-error" id="mt-error" role="alert" hidden>
    <strong id="mt-err-title"></strong>
    <span id="mt-err-detail"></span>
    <ol id="mt-err-help" hidden></ol>
  </div>

  <div class="mt-verdict" id="mt-verdict" data-level="idle" aria-live="polite">
    <strong id="mt-verdict-title">按「開始測試麥克風」並允許瀏覽器使用麥克風</strong>
    <span id="mt-verdict-detail">開始後對著麥克風說話，下方的音量條與波形會即時跳動。</span>
  </div>

  <div class="mt-meter" aria-hidden="true">
    <div class="mt-track">
      <div class="mt-cover" id="mt-cover"></div>
      <div class="mt-peak" id="mt-peak"></div>
    </div>
    <div class="mt-scale"><span>-60</span><span>-40</span><span>-20</span><span>0 dB</span></div>
  </div>

  <canvas class="mt-wave" id="mt-wave" height="120" aria-label="即時聲音波形"></canvas>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="mt-now">—</span><span class="stat-label">目前音量（dBFS）</span></div>
    <div class="stat"><span class="stat-value" id="mt-max">—</span><span class="stat-label">本次最高峰值</span></div>
    <div class="stat"><span class="stat-value" id="mt-rate">—</span><span class="stat-label">取樣率</span></div>
    <div class="stat"><span class="stat-value" id="mt-ch">—</span><span class="stat-label">聲道</span></div>
  </div>

  <div class="mt-rec">
    <div class="row between">
      <div class="row">
        <button class="btn" type="button" id="mt-rec">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
          錄音 5 秒並回放
        </button>
        <span class="hint" id="mt-rec-status">錄一段自己的聲音，聽聽看別人聽到的效果</span>
      </div>
    </div>
    <div class="mt-progress" id="mt-progress" hidden><div class="mt-progress-bar" id="mt-progress-bar"></div></div>
    <div class="mt-playback" id="mt-playback" hidden>
      <audio id="mt-audio" controls preload="auto"></audio>
      <button class="btn small ghost" type="button" id="mt-download">下載錄音</button>
    </div>
  </div>

  <label class="check"><input type="checkbox" id="mt-raw" /> 關閉降噪、回音消除與自動增益（聽原始收音）</label>

  <p class="hint">聲音只在你的瀏覽器中分析與錄製，不會上傳到任何伺服器；關閉或離開頁面時會自動停止麥克風。</p>
</div>

<script>
  import { $, downloadBlob, loadPref, savePref } from '../../lib/client';
  import {
    VERDICT_TEXT,
    dbToPercent,
    describeMediaError,
    detectEnv,
    deviceLabel,
    isClipping,
    levelVerdict,
    peakHold,
    peakOf,
    permissionHelp,
    pickRecorderType,
    recordingFilename,
    rmsOf,
    toDbfs,
    type LevelVerdict,
  } from './logic';

  interface Prefs {
    deviceId: string;
    raw: boolean;
  }

  const RECORD_MS = 5000;

  const root = $('[data-tool="mic-test"]');
  const startBtn = $<HTMLButtonElement>('#mt-start', root);
  const startLabel = $('#mt-start-label', root);
  const stopBtn = $<HTMLButtonElement>('#mt-stop', root);
  const state = $('#mt-state', root);
  const stateText = $('#mt-state-text', root);
  const deviceField = $('#mt-device-field', root);
  const deviceSelect = $<HTMLSelectElement>('#mt-device', root);
  const errorBox = $('#mt-error', root);
  const errTitle = $('#mt-err-title', root);
  const errDetail = $('#mt-err-detail', root);
  const errHelp = $('#mt-err-help', root);
  const verdict = $('#mt-verdict', root);
  const verdictTitle = $('#mt-verdict-title', root);
  const verdictDetail = $('#mt-verdict-detail', root);
  const cover = $('#mt-cover', root);
  const peakMark = $('#mt-peak', root);
  const canvas = $<HTMLCanvasElement>('#mt-wave', root);
  const nowOut = $('#mt-now', root);
  const maxOut = $('#mt-max', root);
  const rateOut = $('#mt-rate', root);
  const chOut = $('#mt-ch', root);
  const recBtn = $<HTMLButtonElement>('#mt-rec', root);
  const recStatus = $('#mt-rec-status', root);
  const progress = $('#mt-progress', root);
  const progressBar = $('#mt-progress-bar', root);
  const playback = $('#mt-playback', root);
  const audio = $<HTMLAudioElement>('#mt-audio', root);
  const downloadBtn = $<HTMLButtonElement>('#mt-download', root);
  const rawBox = $<HTMLInputElement>('#mt-raw', root);

  const prefs: Prefs = { deviceId: '', raw: false, ...loadPref<Partial<Prefs>>('mic-test', {}) };
  rawBox.checked = prefs.raw;
  const env = detectEnv(navigator.userAgent, navigator.maxTouchPoints || 0);

  let stream: MediaStream | null = null;
  let ctx: AudioContext | null = null;
  let source: MediaStreamAudioSourceNode | null = null;
  let analyser: AnalyserNode | null = null;
  let buffer = new Float32Array(2048);
  let raf = 0;
  let lastFrame = 0;
  let heldPeakDb = -100;
  let heldRmsDb = -100;
  let sessionMaxDb = -100;
  let lastClipAt = -Infinity;
  let currentVerdict: LevelVerdict | 'idle' = 'idle';
  let starting = false;

  let recorder: MediaRecorder | null = null;
  let recordStart = 0;
  let recordUrl = '';
  let recordBlob: Blob | null = null;

  // ---------- UI helpers ----------
  function setState(name: 'idle' | 'live' | 'rec', text: string) {
    state.dataset.state = name;
    stateText.textContent = text;
  }

  function showError(name: string) {
    const problem = describeMediaError(name, 'mic');
    errTitle.textContent = problem.title;
    errDetail.textContent = problem.detail;
    errHelp.replaceChildren(
      ...(problem.showPermissionHelp ? permissionHelp(env, 'mic') : []).map((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        return li;
      }),
    );
    errHelp.hidden = !problem.showPermissionHelp;
    errorBox.hidden = false;
  }

  function setVerdict(level: LevelVerdict | 'idle') {
    if (level === currentVerdict) return;
    currentVerdict = level;
    verdict.dataset.level = level;
    if (level === 'idle') {
      verdictTitle.textContent = '麥克風已停止';
      verdictDetail.textContent = '按「開始測試麥克風」可以再測一次。';
      return;
    }
    verdictTitle.textContent = VERDICT_TEXT[level].title;
    verdictDetail.textContent = VERDICT_TEXT[level].detail;
  }

  const fmtDb = (db: number) => (db <= -99 ? '—' : `${Math.round(db)} dB`);

  // ---------- Waveform ----------
  let strokeColor = '#2456e3';
  let gridColor = '#e2e5ea';
  function readColors() {
    const cs = getComputedStyle(root);
    strokeColor = cs.getPropertyValue('--accent').trim() || strokeColor;
    gridColor = cs.getPropertyValue('--border-strong').trim() || gridColor;
  }

  function sizeCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
    const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
    if (canvas.width !== w || canvas.height !== h) {
      canvas.width = w;
      canvas.height = h;
    }
  }

  function drawWave(samples: Float32Array | null) {
    const g = canvas.getContext('2d');
    if (!g) return;
    sizeCanvas();
    const { width: w, height: h } = canvas;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    g.clearRect(0, 0, w, h);
    g.lineWidth = 1 * dpr;
    g.strokeStyle = gridColor;
    g.beginPath();
    g.moveTo(0, h / 2);
    g.lineTo(w, h / 2);
    g.stroke();
    if (!samples) return;
    g.lineWidth = 2 * dpr;
    g.lineJoin = 'round';
    g.strokeStyle = strokeColor;
    g.beginPath();
    const step = samples.length / w;
    for (let x = 0; x < w; x++) {
      const v = samples[Math.floor(x * step)] ?? 0;
      const y = h / 2 - v * (h / 2) * 0.95;
      if (x === 0) g.moveTo(x, y);
      else g.lineTo(x, y);
    }
    g.stroke();
  }

  // ---------- Meter loop ----------
  function frame(t: number) {
    raf = requestAnimationFrame(frame);
    if (!analyser) return;
    const dt = lastFrame ? t - lastFrame : 16;
    lastFrame = t;
    analyser.getFloatTimeDomainData(buffer);
    const peak = peakOf(buffer);
    const peakDb = toDbfs(peak);
    const rmsDb = toDbfs(rmsOf(buffer));
    if (isClipping(peak)) lastClipAt = t;
    heldPeakDb = peakHold(heldPeakDb, peakDb, dt, 15);
    heldRmsDb = peakHold(heldRmsDb, rmsDb, dt, 10);
    if (peakDb > sessionMaxDb) {
      sessionMaxDb = peakDb;
      maxOut.textContent = fmtDb(sessionMaxDb);
    }
    cover.style.transform = `scaleX(${1 - dbToPercent(peakDb) / 100})`;
    peakMark.style.left = `${dbToPercent(heldPeakDb)}%`;
    peakMark.style.opacity = heldPeakDb > -60 ? '1' : '0';
    nowOut.textContent = fmtDb(rmsDb);
    setVerdict(levelVerdict(heldRmsDb, t - lastClipAt < 1500));
    drawWave(buffer);
    if (recorder && recorder.state === 'recording') {
      const elapsed = performance.now() - recordStart;
      progressBar.style.transform = `scaleX(${Math.min(1, elapsed / RECORD_MS)})`;
      recStatus.textContent = `錄音中，剩 ${Math.max(0, (RECORD_MS - elapsed) / 1000).toFixed(1)} 秒`;
    }
  }

  // ---------- Devices ----------
  async function refreshDevices() {
    if (!navigator.mediaDevices?.enumerateDevices) return;
    const devices = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === 'audioinput');
    const activeId = stream?.getAudioTracks()[0]?.getSettings().deviceId ?? prefs.deviceId;
    deviceSelect.replaceChildren(
      ...devices.map((d, i) => {
        const opt = document.createElement('option');
        opt.value = d.deviceId;
        opt.textContent = deviceLabel(d.label, i, 'mic');
        return opt;
      }),
    );
    if (devices.some((d) => d.deviceId === activeId)) deviceSelect.value = activeId;
    deviceField.hidden = devices.length === 0 || !devices.some((d) => d.label);
  }

  // ---------- Start / stop ----------
  function releaseStream() {
    stream?.getTracks().forEach((track) => track.stop());
    stream = null;
    source?.disconnect();
    source = null;
  }

  function stop() {
    if (recorder && recorder.state !== 'inactive') recorder.stop();
    releaseStream();
    cancelAnimationFrame(raf);
    raf = 0;
    analyser = null;
    if (ctx && ctx.state === 'running') void ctx.suspend();
    cover.style.transform = 'scaleX(1)';
    peakMark.style.opacity = '0';
    nowOut.textContent = '—';
    drawWave(null);
    setVerdict('idle');
    setState('idle', '已停止');
    stopBtn.hidden = true;
    startLabel.textContent = '重新開始測試';
  }

  async function start(deviceId?: string, exact = false): Promise<boolean> {
    if (starting) return false;
    errorBox.hidden = true;
    if (!window.isSecureContext) {
      showError('insecure');
      return false;
    }
    const AC = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!navigator.mediaDevices?.getUserMedia || !AC) {
      showError('unsupported');
      return false;
    }
    // Create/resume the AudioContext inside the click so Safari allows it.
    ctx ??= new AC();
    void ctx.resume();
    starting = true;
    startBtn.disabled = true;
    const id = deviceId ?? prefs.deviceId;
    const raw = rawBox.checked;
    try {
      const next = await navigator.mediaDevices.getUserMedia({
        audio: {
          ...(id ? { deviceId: exact ? { exact: id } : { ideal: id } } : {}),
          echoCancellation: !raw,
          noiseSuppression: !raw,
          autoGainControl: !raw,
        },
      });
      if (recorder && recorder.state !== 'inactive') recorder.stop();
      releaseStream();
      stream = next;
      const track = next.getAudioTracks()[0];
      track?.addEventListener('ended', () => {
        if (stream === next) {
          stop();
          showError('NotReadableError');
        }
      });
      const settings = track?.getSettings() ?? {};
      if (settings.deviceId) {
        prefs.deviceId = settings.deviceId;
        savePref('mic-test', prefs);
      }
      source = ctx.createMediaStreamSource(next);
      analyser = ctx.createAnalyser();
      analyser.fftSize = 2048;
      buffer = new Float32Array(analyser.fftSize);
      source.connect(analyser);
      await ctx.resume();
      rateOut.textContent = `${(ctx.sampleRate / 1000).toFixed(1)} kHz`;
      chOut.textContent = settings.channelCount === 2 ? '立體聲' : settings.channelCount ? '單聲道' : '—';
      heldPeakDb = heldRmsDb = sessionMaxDb = -100;
      maxOut.textContent = '—';
      currentVerdict = 'idle';
      setVerdict('silent');
      setState('live', '收音中');
      stopBtn.hidden = false;
      startLabel.textContent = '重新開始測試';
      lastFrame = 0;
      if (!raf) raf = requestAnimationFrame(frame);
      await refreshDevices();
      return true;
    } catch (err) {
      showError(err instanceof Error || err instanceof DOMException ? err.name : '');
      return false;
    } finally {
      starting = false;
      startBtn.disabled = false;
    }
  }

  // ---------- Recording ----------
  function record() {
    if (!stream) return;
    if (typeof MediaRecorder === 'undefined') {
      recStatus.textContent = '這個瀏覽器不支援錄音功能，請改用最新版 Chrome、Edge、Safari 或 Firefox。';
      return;
    }
    const type = pickRecorderType((t) => MediaRecorder.isTypeSupported(t));
    let rec: MediaRecorder;
    try {
      rec = new MediaRecorder(stream, type ? { mimeType: type } : undefined);
    } catch {
      recStatus.textContent = '無法啟動錄音，請重新開始測試後再試一次。';
      return;
    }
    const chunks: Blob[] = [];
    rec.addEventListener('dataavailable', (e) => {
      if (e.data.size) chunks.push(e.data);
    });
    rec.addEventListener('stop', () => {
      recorder = null;
      recBtn.disabled = false;
      progress.hidden = true;
      if (stream) setState('live', '收音中');
      if (!chunks.length) {
        recStatus.textContent = '沒有錄到內容，請再試一次。';
        return;
      }
      recordBlob = new Blob(chunks, { type: rec.mimeType || type || 'audio/webm' });
      if (recordUrl) URL.revokeObjectURL(recordUrl);
      recordUrl = URL.createObjectURL(recordBlob);
      audio.src = recordUrl;
      playback.hidden = false;
      recStatus.textContent = '錄好了，按播放鍵聽聽看';
      void audio.play().catch(() => undefined);
    });
    recorder = rec;
    rec.start();
    recordStart = performance.now();
    recBtn.disabled = true;
    progress.hidden = false;
    progressBar.style.transform = 'scaleX(0)';
    setState('rec', '錄音中');
    window.setTimeout(() => {
      if (rec.state === 'recording') rec.stop();
    }, RECORD_MS);
  }

  // ---------- Events ----------
  startBtn.addEventListener('click', () => void start());
  stopBtn.addEventListener('click', stop);
  recBtn.addEventListener('click', async () => {
    if (!stream && !(await start())) return;
    record();
  });
  downloadBtn.addEventListener('click', () => {
    if (recordBlob) downloadBlob(recordBlob, recordingFilename(new Date(), recordBlob.type));
  });
  deviceSelect.addEventListener('change', () => {
    prefs.deviceId = deviceSelect.value;
    savePref('mic-test', prefs);
    if (stream) void start(deviceSelect.value, true);
  });
  rawBox.addEventListener('change', () => {
    prefs.raw = rawBox.checked;
    savePref('mic-test', prefs);
    if (stream) void start();
  });
  navigator.mediaDevices?.addEventListener?.('devicechange', () => {
    if (stream) void refreshDevices();
  });
  window.addEventListener('pagehide', () => {
    if (stream) stop();
  });
  const scheme = window.matchMedia('(prefers-color-scheme: dark)');
  scheme.addEventListener('change', () => {
    readColors();
    if (!stream) drawWave(null);
  });
  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(() => {
      if (!stream) drawWave(null);
    }).observe(canvas);
  }
  readColors();
  drawWave(null);
</script>

<style>
  .mt-state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .mt-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .mt-state[data-state='live'] {
    color: var(--success);
  }
  .mt-state[data-state='live'] .mt-dot {
    background: var(--success);
  }
  .mt-state[data-state='rec'] {
    color: var(--danger);
  }
  .mt-state[data-state='rec'] .mt-dot {
    background: var(--danger);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mt-state[data-state='live'] .mt-dot,
    .mt-state[data-state='rec'] .mt-dot {
      animation: mt-pulse 1.4s ease-in-out infinite;
    }
  }
  @keyframes mt-pulse {
    50% {
      opacity: 0.35;
    }
  }

  .mt-error {
    display: grid;
    gap: 4px;
  }
  .mt-error ol {
    margin: 4px 0 0;
    padding-left: 20px;
    color: var(--text-2);
  }

  .mt-verdict {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-left: 4px solid var(--border-strong);
  }
  .mt-verdict strong {
    font-size: 18px;
  }
  .mt-verdict span {
    font-size: 14px;
    color: var(--text-2);
  }
  .mt-verdict[data-level='good'] {
    border-left-color: var(--success);
  }
  .mt-verdict[data-level='good'] strong {
    color: var(--success);
  }
  .mt-verdict[data-level='quiet'],
  .mt-verdict[data-level='silent'] {
    border-left-color: var(--warning);
  }
  .mt-verdict[data-level='loud'] {
    border-left-color: var(--danger);
  }
  .mt-verdict[data-level='loud'] strong {
    color: var(--danger);
  }

  .mt-meter {
    display: grid;
    gap: 4px;
  }
  .mt-track {
    position: relative;
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
    background: linear-gradient(90deg, var(--success) 0%, var(--success) 62%, var(--warning) 80%, var(--danger) 94%);
  }
  .mt-cover {
    position: absolute;
    inset: 0;
    background: var(--surface-2);
    transform-origin: right center;
    transform: scaleX(1);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .mt-peak {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    margin-left: -1.5px;
    background: var(--text);
    opacity: 0;
  }
  .mt-scale {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .mt-wave {
    display: block;
    width: 100%;
    height: 120px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .mt-rec {
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .mt-progress {
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .mt-progress-bar {
    height: 100%;
    background: var(--danger);
    transform-origin: left center;
    transform: scaleX(0);
  }
  .mt-playback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .mt-playback audio {
    flex: 1 1 240px;
    min-width: 0;
    height: 40px;
  }
</style>
