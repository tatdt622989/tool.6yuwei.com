---
import type { ToolProps } from '../../i18n/tool';
import { ROMAJI_STYLES } from './logic';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;
---

<div class="tool" data-tool="romaji-converter" data-locale={locale}>
  <div class="field">
    <label for="rc-input">ひらがな・カタカナで入力</label>
    <input id="rc-input" type="text" autocomplete="off" value="さとう しょうた" placeholder="例：やまだ たろう／ヤマダ タロウ" />
    <span class="hint">漢字は読みが判定できないため、ひらがなかカタカナで入力してください。姓と名の間はスペースで区切ります。</span>
  </div>

  <label class="check"><input type="checkbox" id="rc-cap" checked /> 語頭を大文字にする（人名・地名向け）</label>

  <p class="notice error" id="rc-kanji" hidden>漢字が含まれています。漢字はそのまま残るので、読みをひらがなかカタカナで入力してください。</p>

  <div class="result" aria-live="polite">
    <div class="result-value" id="rc-main">—</div>
    <div class="result-label">パスポート（外務省ヘボン式）での表記</div>
  </div>

  <div class="rc-list">
    {
      ROMAJI_STYLES.map((s) => (
        <div class="rc-item">
          <div class="rc-head">
            <span class="rc-name">{s.label}</span>
            <button class="btn small" type="button" data-copy={`#rc-out-${s.id}`}>
              コピー
            </button>
          </div>
          <output class="rc-out" id={`rc-out-${s.id}`} data-style={s.id}>
            —
          </output>
          <span class="hint">{s.note}</span>
        </div>
      ))
    }
  </div>

  <p class="hint">パスポートは「まつうら → MATSUURA」のように語の切れ目にある母音を長音として扱わない例外があります。申請前に必ず各都道府県の旅券窓口の案内で確認してください。入力した文字は送信されず、ブラウザ内だけで変換します。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { hasKanji, toAllStyles, type RomajiStyle } from './logic';

  const root = $('[data-tool="romaji-converter"]');
  const input = $<HTMLInputElement>('#rc-input', root);
  const cap = $<HTMLInputElement>('#rc-cap', root);
  const kanji = $('#rc-kanji', root);
  const main = $('#rc-main', root);
  const outs = $$<HTMLOutputElement>('output[data-style]', root);

  const prefs = loadPref<{ text?: string; cap?: boolean }>('romaji-converter', {});
  if (prefs.text !== undefined) input.value = prefs.text;
  if (prefs.cap !== undefined) cap.checked = prefs.cap;

  function render() {
    const text = input.value;
    const all = toAllStyles(text, { capitalize: cap.checked });
    const empty = text.trim() === '';
    main.textContent = empty ? '—' : all.passport;
    for (const out of outs) out.textContent = empty ? '—' : all[out.dataset.style as RomajiStyle];
    kanji.hidden = !hasKanji(text);
    savePref('romaji-converter', { text, cap: cap.checked });
  }

  input.addEventListener('input', render);
  cap.addEventListener('change', render);
  render();
</script>

<style>
  .rc-list {
    display: grid;
    gap: 10px;
  }
  .rc-item {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    min-width: 0;
  }
  .rc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .rc-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .rc-out {
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
