---
import { PRESET_MINUTES } from './logic';
---

<div class="tool" data-tool="countdown-timer" data-state="idle">
  <div class="cd-face">
    <div class="big-display" id="cd-display" role="timer" aria-label="剩餘時間">05:00</div>
    <div class="cd-track" aria-hidden="true"><div class="cd-fill" id="cd-fill"></div></div>
    <p class="cd-status" id="cd-status" aria-live="polite"></p>
  </div>

  <div class="cd-controls">
    <button class="btn primary" type="button" id="cd-toggle">開始</button>
    <button class="btn" type="button" id="cd-reset">重設</button>
    <button class="btn" type="button" id="cd-fullscreen">全螢幕</button>
  </div>

  <div class="cd-setup">
    <div class="cd-inputs">
      <div class="field">
        <label for="cd-h">時</label>
        <input id="cd-h" type="number" inputmode="numeric" min="0" max="99" value="0" />
      </div>
      <div class="field">
        <label for="cd-m">分</label>
        <input id="cd-m" type="number" inputmode="numeric" min="0" max="59" value="5" />
      </div>
      <div class="field">
        <label for="cd-s">秒</label>
        <input id="cd-s" type="number" inputmode="numeric" min="0" max="59" value="0" />
      </div>
    </div>

    <div class="field">
      <span class="label">快速設定（點選後立即開始）</span>
      <div class="row" id="cd-presets">
        {
          PRESET_MINUTES.map((min) => (
            <button class="btn small" type="button" data-min={min}>
              {min} 分鐘
            </button>
          ))
        }
      </div>
    </div>

    <div class="row">
      <label class="check"><input type="checkbox" id="cd-sound" checked /> 提示音</label>
      <label class="check"><input type="checkbox" id="cd-notify" /> 桌面通知</label>
    </div>
    <p class="notice" id="cd-notice" hidden></p>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import {
    createCountdown,
    describeDuration,
    formatCountdown,
    pauseCountdown,
    remainingFraction,
    remainingOf,
    resetCountdown,
    setDuration,
    splitDuration,
    startCountdown,
    tickCountdown,
    toMs,
    type CountdownState,
  } from './logic';

  interface Prefs {
    durationMs: number;
    sound: boolean;
  }

  const root = $('[data-tool="countdown-timer"]');
  const display = $('#cd-display', root);
  const fill = $('#cd-fill', root);
  const status = $('#cd-status', root);
  const toggleBtn = $<HTMLButtonElement>('#cd-toggle', root);
  const resetBtn = $<HTMLButtonElement>('#cd-reset', root);
  const fsBtn = $<HTMLButtonElement>('#cd-fullscreen', root);
  const hInput = $<HTMLInputElement>('#cd-h', root);
  const mInput = $<HTMLInputElement>('#cd-m', root);
  const sInput = $<HTMLInputElement>('#cd-s', root);
  const soundBox = $<HTMLInputElement>('#cd-sound', root);
  const notifyBox = $<HTMLInputElement>('#cd-notify', root);
  const notice = $('#cd-notice', root);
  const presetButtons = $$<HTMLButtonElement>('#cd-presets button', root);
  const inputs = [hInput, mInput, sInput];
  const baseTitle = document.title;

  const prefs = loadPref<Prefs>('countdown-timer', { durationMs: 5 * 60_000, sound: true });
  let state: CountdownState = createCountdown(prefs.durationMs > 0 ? prefs.durationMs : 5 * 60_000);
  soundBox.checked = prefs.sound !== false;

  let ticker: number | undefined;
  let alarm: number | undefined;
  let lastTitle = '';

  /* ---------- Sound (WebAudio, unlocked by the user's click) ---------- */
  let audio: AudioContext | null = null;

  function unlockAudio(): AudioContext | null {
    const Ctor =
      window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return null;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
    return audio;
  }

  function beep(times = 3, frequency = 880) {
    const ctx = unlockAudio();
    if (!ctx) return;
    const t0 = ctx.currentTime + 0.05;
    for (let i = 0; i < times; i++) {
      const at = t0 + i * 0.32;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = frequency;
      gain.gain.setValueAtTime(0.0001, at);
      gain.gain.exponentialRampToValueAtTime(0.3, at + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, at + 0.2);
      osc.connect(gain).connect(ctx.destination);
      osc.start(at);
      osc.stop(at + 0.22);
    }
  }

  /* ---------- Rendering ---------- */
  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  function showNotice(text: string, kind: '' | 'error' | 'ok' = '') {
    notice.textContent = text;
    notice.className = kind ? `notice ${kind}` : 'notice';
    notice.hidden = text === '';
  }

  function render() {
    const now = Date.now();
    const remaining = remainingOf(state, now);
    const text = formatCountdown(remaining);
    display.textContent = text;
    fill.style.width = `${remainingFraction(state, now) * 100}%`;
    root.dataset.state = state.status;

    const labels: Record<CountdownState['status'], string> = {
      idle: '開始',
      running: '暫停',
      paused: '繼續',
      done: '再倒數一次',
    };
    toggleBtn.textContent = labels[state.status];
    toggleBtn.disabled = state.durationMs <= 0;
    for (const input of inputs) input.disabled = state.status === 'running';

    if (state.status === 'running') {
      status.textContent = `倒數 ${describeDuration(state.durationMs)}`;
      setTitle(`${text} 倒數中`);
    } else if (state.status === 'paused') {
      status.textContent = '已暫停';
      setTitle(baseTitle);
    } else if (state.status === 'done') {
      status.textContent = '時間到！';
      setTitle('時間到！');
    } else {
      status.textContent = state.durationMs > 0 ? '' : '請先設定時間';
      setTitle(baseTitle);
    }
  }

  function syncInputs() {
    const { h, m, s } = splitDuration(state.durationMs);
    hInput.value = String(h);
    mInput.value = String(m);
    sInput.value = String(s);
  }

  /* ---------- Timing ---------- */
  function finish() {
    if (soundBox.checked) beep();
    if (notifyBox.checked && 'Notification' in window && Notification.permission === 'granted') {
      try {
        new Notification('時間到！', { body: `${describeDuration(state.durationMs)}的倒數已結束`, tag: 'countdown-timer' });
      } catch {
        /* Some mobile browsers only allow notifications from a service worker. */
      }
    }
  }

  function tick() {
    const next = tickCountdown(state, Date.now());
    if (next !== state) {
      state = next;
      schedule();
      finish();
    }
    render();
  }

  function schedule() {
    window.clearInterval(ticker);
    window.clearTimeout(alarm);
    ticker = alarm = undefined;
    if (state.status !== 'running' || state.endsAt === null) return;
    // Display refresh (throttled in background tabs, which is fine for the title).
    ticker = window.setInterval(tick, 250);
    // A single, unchained timeout for the alarm is not subject to intensive throttling.
    alarm = window.setTimeout(tick, Math.max(0, state.endsAt - Date.now()) + 5);
  }

  function update(next: CountdownState) {
    state = next;
    schedule();
    render();
  }

  function start() {
    if (state.durationMs <= 0) {
      showNotice('請先輸入倒數時間。', 'error');
      return;
    }
    if (soundBox.checked) unlockAudio();
    showNotice('');
    update(startCountdown(state, Date.now()));
  }

  function applyInputs() {
    const ms = toMs(Number(hInput.value), Number(mInput.value), Number(sInput.value));
    update(setDuration(state, ms));
    savePref('countdown-timer', { durationMs: ms, sound: soundBox.checked });
  }

  /* ---------- Events ---------- */
  toggleBtn.addEventListener('click', () => {
    if (state.status === 'running') update(pauseCountdown(state, Date.now()));
    else start();
  });

  resetBtn.addEventListener('click', () => {
    showNotice('');
    update(resetCountdown(state));
  });

  for (const input of inputs) {
    input.addEventListener('input', applyInputs);
    input.addEventListener('change', syncInputs); // normalizes e.g. 90 秒 → 1 分 30 秒
  }

  for (const button of presetButtons) {
    button.addEventListener('click', () => {
      update(setDuration(state, Number(button.dataset.min) * 60_000));
      syncInputs();
      savePref('countdown-timer', { durationMs: state.durationMs, sound: soundBox.checked });
      start();
    });
  }

  soundBox.addEventListener('change', () => {
    savePref('countdown-timer', { durationMs: state.durationMs, sound: soundBox.checked });
    if (soundBox.checked) unlockAudio();
  });

  notifyBox.addEventListener('change', async () => {
    if (!notifyBox.checked) return;
    if (!('Notification' in window)) {
      notifyBox.checked = false;
      showNotice('這個瀏覽器不支援桌面通知。', 'error');
      return;
    }
    // Only ask when the user explicitly opts in.
    const permission =
      Notification.permission === 'default' ? await Notification.requestPermission() : Notification.permission;
    if (permission === 'granted') {
      showNotice('已開啟桌面通知，時間到時會跳出提醒。', 'ok');
    } else {
      notifyBox.checked = false;
      showNotice('通知權限未開啟。可在網址列左側的網站設定中允許通知後再勾選。', 'error');
    }
  });

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else root.requestFullscreen().catch(() => showNotice('無法進入全螢幕模式。', 'error'));
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? '離開全螢幕' : '全螢幕';
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) tick();
  });

  syncInputs();
  render();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .cd-face {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 12px 0 4px;
  }
  .cd-track {
    width: 100%;
    max-width: 520px;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .cd-fill {
    height: 100%;
    width: 100%;
    background: var(--accent);
    transition: width 0.25s linear;
  }
  .cd-status {
    min-height: 1.65em;
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }
  [data-state='done'] .big-display,
  [data-state='done'] .cd-status {
    color: var(--danger);
    font-weight: 700;
  }
  [data-state='paused'] .big-display {
    color: var(--text-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-state='done'] .big-display {
      animation: cd-blink 1s steps(2, jump-none) 4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cd-fill {
      transition: none;
    }
  }
  @keyframes cd-blink {
    50% {
      opacity: 0.35;
    }
  }
  .cd-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  .cd-controls .btn {
    min-height: 48px;
    padding-inline: 8px;
    font-size: 16px;
  }
  .cd-controls:has(.btn[hidden]) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cd-setup {
    display: grid;
    gap: 16px;
  }
  .cd-inputs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cd-inputs input {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Fullscreen: just the clock and controls, sized to the screen. */
  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
  }
  .tool:fullscreen .cd-setup {
    display: none;
  }
  .tool:fullscreen .big-display {
    font-size: min(22vw, 40vh);
  }
  .tool:fullscreen .cd-track {
    max-width: 80vw;
  }
</style>
