<div class="tool" data-tool="salary-calculator">
  <div class="field">
    <span class="label">適用年度（勞健保級距與費率）</span>
    <div class="seg" role="radiogroup" aria-label="適用年度">
      <label><input type="radio" name="sc-year" value="2026" checked /><span>2026 年（115 年）</span></label>
      <label><input type="radio" name="sc-year" value="2027" /><span>2027 年（116 年）</span></label>
    </div>
    <span class="hint" id="sc-year-hint">2027 年 1 月 1 日起自動切換為 2027 年。</span>
  </div>
  <p class="notice" id="sc-estimate" hidden></p>

  <div class="grid-2">
    <div class="field">
      <label for="sc-salary">月薪（元）</label>
      <input id="sc-salary" type="text" inputmode="numeric" autocomplete="off" value="36000" />
      <span class="hint">填每月固定薪資，含伙食津貼、全勤獎金等經常性給與。</span>
    </div>
    <div class="field">
      <label for="sc-pension">勞退自提比例</label>
      <select id="sc-pension">
        <option value="0" selected>不自提（0%）</option>
        <option value="1">1%</option>
        <option value="2">2%</option>
        <option value="3">3%</option>
        <option value="4">4%</option>
        <option value="5">5%</option>
        <option value="6">6%</option>
      </select>
    </div>
  </div>

  <div class="field">
    <span class="label">健保眷屬人數（依附在你名下）</span>
    <div class="seg" role="radiogroup" aria-label="健保眷屬人數">
      <label><input type="radio" name="sc-dep" value="0" checked /><span>0 人</span></label>
      <label><input type="radio" name="sc-dep" value="1" /><span>1 人</span></label>
      <label><input type="radio" name="sc-dep" value="2" /><span>2 人</span></label>
      <label><input type="radio" name="sc-dep" value="3" /><span>3 人以上</span></label>
    </div>
  </div>

  <details class="sc-more">
    <summary>進階設定：自訂投保級距、所得稅預扣、職災費率</summary>
    <div class="grid-2">
      <div class="field">
        <label for="sc-other">其他扣款（元／月）</label>
        <input id="sc-other" type="text" inputmode="numeric" autocomplete="off" value="0" />
        <span class="hint" id="sc-other-hint">所得稅預扣、福利金等。2026 年月薪 90,501 元起才需查表扣繳，未填免稅額申報表者每月 40,000 元起扣 5%。</span>
      </div>
      <div class="field">
        <label for="sc-occ">職災保險費率（%，雇主負擔）</label>
        <input id="sc-occ" type="text" inputmode="decimal" autocomplete="off" value="0.11" />
        <span class="hint">行業別費率 + 上下班 0.07%，依公司繳款單為準。</span>
      </div>
      <div class="field">
        <label for="sc-li">自訂勞保投保薪資（留空 = 依月薪）</label>
        <input id="sc-li" type="text" inputmode="numeric" autocomplete="off" placeholder="自動" />
      </div>
      <div class="field">
        <label for="sc-hi">自訂健保投保金額（留空 = 依月薪）</label>
        <input id="sc-hi" type="text" inputmode="numeric" autocomplete="off" placeholder="自動" />
      </div>
      <div class="field">
        <label for="sc-pw">自訂勞退月提繳工資（留空 = 依月薪）</label>
        <input id="sc-pw" type="text" inputmode="numeric" autocomplete="off" placeholder="自動" />
      </div>
    </div>
    <div class="row">
      <label class="check"><input type="checkbox" id="sc-emp" checked /> 適用就業保險（本國籍、未滿 65 歲）</label>
      <label class="check"><input type="checkbox" id="sc-pt" /> 部分工時（薪資低於最低工資）</label>
    </div>
  </details>

  <div class="notice error" id="sc-error" hidden></div>

  <div id="sc-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="sc-take">—</div>
      <div class="result-label" id="sc-take-label">每月實領薪水</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sc-labor">—</span><span class="stat-label">勞保自付（含就保）</span></div>
      <div class="stat"><span class="stat-value" id="sc-health">—</span><span class="stat-label">健保自付</span></div>
      <div class="stat"><span class="stat-value" id="sc-self">—</span><span class="stat-label">勞退自提</span></div>
      <div class="stat"><span class="stat-value" id="sc-year">—</span><span class="stat-label">一年實領（12 個月）</span></div>
    </div>

    <p class="notice" id="sc-warn" hidden></p>

    <div class="field">
      <span class="label">扣款明細（員工自付與雇主負擔）</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>項目</th><th class="num">投保級距</th><th class="num">員工自付</th><th class="num">雇主負擔</th></tr>
          </thead>
          <tbody id="sc-table"></tbody>
        </table>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sc-er">—</span><span class="stat-label">雇主每月另需負擔</span></div>
      <div class="stat"><span class="stat-value" id="sc-cost">—</span><span class="stat-label">公司每月人事成本</span></div>
    </div>
  </div>

  <p class="hint" id="sc-foot">依 2026 年（民國 115 年）勞保、健保、勞退投保級距與費率計算：勞保 11.5% + 就保 1%（自付 20%）、健保 5.17%（自付 30%）、雇主勞退提繳 6%。結果僅供參考，實際扣款以公司薪資單與勞保局、健保署公告為準。所有計算在你的瀏覽器內完成，薪資資料不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, parseNumber } from '../../lib/format';
  import {
    bpToPct,
    calculateSalary,
    defaultInsuranceYear,
    insuranceTable,
    validateSalary,
    type InsuranceYear,
    type SalaryInput,
  } from './logic';

  interface Prefs {
    salary: string;
    pension: string;
    dep: string;
    other: string;
    occ: string;
    li: string;
    hi: string;
    pw: string;
    emp: boolean;
    pt: boolean;
  }

  const root = $('[data-tool="salary-calculator"]');
  const salary = $<HTMLInputElement>('#sc-salary', root);
  const pension = $<HTMLSelectElement>('#sc-pension', root);
  const deps = $$<HTMLInputElement>('input[name="sc-dep"]', root);
  const years = $$<HTMLInputElement>('input[name="sc-year"]', root);
  const estimate = $('#sc-estimate', root);
  const other = $<HTMLInputElement>('#sc-other', root);
  const occ = $<HTMLInputElement>('#sc-occ', root);
  const li = $<HTMLInputElement>('#sc-li', root);
  const hi = $<HTMLInputElement>('#sc-hi', root);
  const pw = $<HTMLInputElement>('#sc-pw', root);
  const emp = $<HTMLInputElement>('#sc-emp', root);
  const pt = $<HTMLInputElement>('#sc-pt', root);
  const error = $('#sc-error', root);
  const output = $('#sc-output', root);
  const warn = $('#sc-warn', root);
  const table = $('#sc-table', root);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const optional = (el: HTMLInputElement) => (el.value.trim() === '' ? undefined : parseNumber(el.value));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  const prefs = loadPref<Partial<Prefs>>('salary-calculator', {});
  if (prefs.salary !== undefined) salary.value = prefs.salary;
  if (prefs.pension && pension.querySelector(`option[value="${prefs.pension}"]`)) pension.value = prefs.pension;
  if (prefs.dep !== undefined) for (const d of deps) d.checked = d.value === prefs.dep;
  if (prefs.other !== undefined) other.value = prefs.other;
  if (prefs.occ !== undefined) occ.value = prefs.occ;
  if (prefs.li !== undefined) li.value = prefs.li;
  if (prefs.hi !== undefined) hi.value = prefs.hi;
  if (prefs.pw !== undefined) pw.value = prefs.pw;
  if (prefs.emp !== undefined) emp.checked = prefs.emp;
  if (prefs.pt !== undefined) pt.checked = prefs.pt;
  // 年度不記憶：每次開啟都依今天日期決定（2027-01-01 起預設 2027 年）。
  const initialYear = String(defaultInsuranceYear());
  for (const y of years) y.checked = y.value === initialYear;

  const selectedYear = (): InsuranceYear => (years.find((y) => y.checked)?.value === '2027' ? 2027 : 2026);

  function readInput(): SalaryInput {
    const year = selectedYear();
    return {
      year,
      salary: parseNumber(salary.value),
      dependents: Number(deps.find((d) => d.checked)?.value ?? 0),
      selfPensionPct: Number(pension.value),
      employmentInsurance: emp.checked,
      partTime: pt.checked,
      occupationalRatePct: occ.value.trim() === '' ? insuranceTable(year).defaultOccupationalRatePct : parseNumber(occ.value),
      otherDeduction: other.value.trim() === '' ? 0 : parseNumber(other.value),
      laborInsuredOverride: optional(li),
      healthInsuredOverride: optional(hi),
      pensionWageOverride: optional(pw),
    };
  }

  function row(label: string, grade: string, employee: number | null, employer: number | null): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const cells = [label, grade, employee === null ? '—' : money(employee), employer === null ? '—' : money(employer)];
    cells.forEach((text, i) => {
      const td = document.createElement('td');
      td.textContent = text;
      if (i > 0) td.className = 'num';
      tr.append(td);
    });
    return tr;
  }

  function render() {
    savePref('salary-calculator', {
      salary: salary.value,
      pension: pension.value,
      dep: deps.find((d) => d.checked)?.value ?? '0',
      other: other.value,
      occ: occ.value,
      li: li.value,
      hi: hi.value,
      pw: pw.value,
      emp: emp.checked,
      pt: pt.checked,
    } satisfies Prefs);

    const input = readInput();
    const t = insuranceTable(input.year);
    const laborPct = bpToPct(t.laborOrdinaryRateBp);
    const healthPct = bpToPct(t.healthRateBp);
    const yearName = `${t.year} 年`;
    estimate.hidden = !t.estimated;
    estimate.textContent = t.estimated
      ? `2027 年最低工資 ${formatInteger(t.minWage)} 元與勞保費率 ${laborPct}%（另就保 1%）已確定，健保費率 ${healthPct}% 衛福部表示不調整；勞保、健保、勞退投保級距依最低工資調整預估，正式分級表公告後更新。`
      : '';
    $('#sc-other-hint', root).textContent =
      t.year === 2026
        ? '所得稅預扣、福利金等。2026 年月薪 90,501 元起才需查表扣繳，未填免稅額申報表者每月 40,000 元起扣 5%。'
        : '所得稅預扣、福利金等。2027 年薪資扣繳稅額表由財政部於年底公告，可先填薪資單上的金額。';
    $('#sc-foot', root).textContent =
      `依 ${t.label}勞保、健保、勞退投保級距與費率計算：勞保 ${laborPct}% + 就保 1%（自付 20%）、健保 ${healthPct}%（自付 30%）、雇主勞退提繳 6%。` +
      (t.estimated ? '2027 年投保級距為依最低工資調整預估，正式分級表公告後更新。' : '') +
      '結果僅供參考，實際扣款以公司薪資單與勞保局、健保署公告為準。所有計算在你的瀏覽器內完成，薪資資料不會上傳。';

    const problem = validateSalary(input);
    const r = problem ? null : calculateSalary(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    set('#sc-take', money(r.takeHome));
    set('#sc-take-label', `${yearName}月薪 ${formatInteger(input.salary)} 元的每月實領薪水`);
    set('#sc-labor', money(r.employee.labor));
    set('#sc-health', money(r.employee.health));
    set('#sc-self', money(r.employee.pension));
    set('#sc-year', money(r.takeHome * 12));
    set('#sc-er', money(r.employer.total));
    set('#sc-cost', money(r.employerCost));

    if (r.belowMinWage && !input.partTime) {
      warn.textContent = `月薪低於 ${yearName}最低工資 ${formatInteger(t.minWage)} 元。全時工作者的月薪不得低於最低工資；若為部分工時，請在進階設定勾選「部分工時」。`;
      warn.hidden = false;
    } else if (input.laborInsuredOverride !== undefined && input.laborInsuredOverride < input.salary && input.salary <= 45_800) {
      warn.textContent = '自訂的勞保投保薪資低於實際月薪，屬於「高薪低報」，會影響未來的勞保給付與退休金，勞工可向勞保局檢舉。';
      warn.hidden = false;
    } else {
      warn.hidden = true;
    }

    const e = r.employee;
    const er = r.employer;
    const depCount = Math.min(input.dependents, t.maxDependents);
    table.replaceChildren(
      row(`勞保（普通事故 ${laborPct}%）`, formatInteger(r.laborInsured), e.laborOrdinary, er.laborOrdinary),
      row('就業保險（1%）', input.employmentInsurance ? formatInteger(r.laborInsured) : '不適用', e.employment, er.employment),
      row(`職災保險（${input.occupationalRatePct}%）`, formatInteger(r.occupationalInsured), null, er.occupational),
      row(`健保（${healthPct}%，本人＋${depCount} 眷屬）`, formatInteger(r.healthInsured), e.health, er.health),
      row(`勞退（雇主 6%，自提 ${input.selfPensionPct}%）`, formatInteger(r.pensionWage), e.pension, er.pension),
      row('工資墊償基金（0.025%）', formatInteger(r.laborInsured), null, er.wageArrears),
      ...(e.other > 0 ? [row('其他扣款', '—', e.other, null)] : []),
      row('合計', '', e.total, er.total),
    );
    table.lastElementChild?.classList.add('sc-total');
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #sc-output {
    display: grid;
    gap: 16px;
  }
  #sc-output[hidden] {
    display: none;
  }
  .sc-more {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .sc-more[open] {
    display: grid;
    gap: 14px;
  }
  .sc-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
  #sc-table :global(.sc-total td) {
    font-weight: 700;
    background: var(--surface-2);
  }
</style>
