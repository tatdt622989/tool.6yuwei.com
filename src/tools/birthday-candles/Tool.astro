---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import Icon from '../../components/Icon.astro';
import { CAKE, DEFAULT_THEME, LIMITS, THEME_IDS } from './logic';
import { PALETTES } from './themes';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const m = s.maker;
const viewBox = `0 ${CAKE.viewTop} ${CAKE.width} ${CAKE.viewBottom - CAKE.viewTop}`;
---

<div class="tool bc" data-tool="birthday-candles" data-mode="maker" {...i18nAttrs(locale, s.client)}>
  <p class="notice error" id="bc-invalid" role="alert" hidden>{s.invalidLink}</p>

  <div class="bc-layout">
    <section class="bc-stage" id="bc-stage" data-phase="lit" aria-labelledby="bc-title">
      <canvas class="bc-confetti" id="bc-confetti" aria-hidden="true"></canvas>
      <p class="bc-from" id="bc-from">{s.client.fromNone}</p>
      <h2 class="bc-title" id="bc-title">{s.client.headline.plain}</h2>
      <svg class="bc-cake" id="bc-cake" viewBox={viewBox} role="img" aria-label={s.cakeAria}></svg>

      <div class="bc-controls" id="bc-controls">
        <p class="bc-prompt" id="bc-prompt" aria-live="polite">{s.client.wish}</p>
        <div class="bc-meter" id="bc-meter" hidden>
          <span class="bc-meter-label">{s.meterLabel}</span>
          <span class="bc-meter-track"><span class="bc-meter-fill" id="bc-meter-fill"></span></span>
        </div>
        <div class="bc-actions">
          <button class="btn primary bc-mic" type="button" id="bc-mic">
            <Icon name="Mic" size={18} />
            <span id="bc-mic-label">{s.client.micStart}</span>
          </button>
          <button class="btn bc-quick" type="button" id="bc-quick">
            <Icon name="Pointer" size={18} />
            <span>{s.quickBlow}</span>
          </button>
        </div>
        <p class="bc-note" id="bc-note">{s.tapHint}</p>
        <p class="bc-error" id="bc-mic-error" role="alert" hidden></p>
      </div>

      <div class="bc-card" id="bc-card" hidden>
        <p class="bc-message" id="bc-message"></p>
        <p class="bc-sign" id="bc-sign"></p>
      </div>

      <div class="bc-after" id="bc-after" hidden>
        <button class="btn" type="button" id="bc-replay">
          <Icon name="Music" size={18} />
          <span>{s.replay}</span>
        </button>
        <button class="btn" type="button" id="bc-mute">
          <span class="bc-mute-icon" id="bc-mute-on"><Icon name="Volume2" size={18} /></span>
          <span class="bc-mute-icon" id="bc-mute-off" hidden><Icon name="VolumeX" size={18} /></span>
          <span id="bc-mute-label">{s.client.mute}</span>
        </button>
        <button class="btn" type="button" id="bc-relight">
          <Icon name="Flame" size={18} />
          <span>{s.relight}</span>
        </button>
      </div>

      <div class="bc-foot" id="bc-foot">
        <p class="bc-privacy">{s.micPrivacy}</p>
        <button class="btn small bc-make" type="button" id="bc-make">
          <Icon name="Pencil" size={16} />
          <span>{s.makeOwn}</span>
        </button>
      </div>
    </section>

    <section class="bc-maker" id="bc-maker" aria-labelledby="bc-maker-title">
      <h2 class="bc-maker-title" id="bc-maker-title">{m.title}</h2>
      <div class="field">
        <label for="bc-name">{m.name}</label>
        <input id="bc-name" type="text" maxlength={LIMITS.name} placeholder={m.namePlaceholder} autocomplete="off" />
      </div>
      <div class="field">
        <label for="bc-age">{m.age}</label>
        <input id="bc-age" type="number" inputmode="numeric" min={LIMITS.minAge} max={LIMITS.maxAge} step="1" />
        <span class="hint">{m.ageHint}</span>
      </div>
      <div class="field">
        <label for="bc-msg">{m.message}</label>
        <textarea id="bc-msg" rows="4" maxlength={LIMITS.message} placeholder={m.messagePlaceholder}></textarea>
        <div class="bc-msg-meta">
          <span class="hint">{m.messageHint}</span>
          <span class="hint bc-count" id="bc-count"></span>
        </div>
      </div>
      <div class="field">
        <label for="bc-sender">{m.from}</label>
        <input id="bc-sender" type="text" maxlength={LIMITS.from} placeholder={m.fromPlaceholder} autocomplete="off" />
      </div>
      <div class="field">
        <span class="label" id="bc-theme-label">{m.theme}</span>
        <div class="bc-themes" role="radiogroup" aria-labelledby="bc-theme-label">
          {
            THEME_IDS.map((id) => (
              <label class="bc-theme">
                <input type="radio" name="bc-theme" value={id} checked={id === DEFAULT_THEME} />
                <span class="bc-theme-chip">
                  <span class="bc-swatch" style={`--top:${PALETTES[id].frosting};--side:${PALETTES[id].drip}`} aria-hidden="true" />
                  {s.themes[id]}
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="bc-share">
        <h3 class="bc-share-title">{m.linkTitle}</h3>
        <input id="bc-link" type="url" readonly aria-label={m.linkLabel} />
        <div class="bc-share-actions">
          <button class="btn primary" type="button" id="bc-copy">
            <Icon name="Copy" size={18} />
            <span id="bc-copy-label">{m.copy}</span>
          </button>
          <button class="btn" type="button" id="bc-share-btn" hidden>
            <Icon name="Share2" size={18} />
            <span>{m.share}</span>
          </button>
          <button class="btn ghost" type="button" id="bc-preview">
            <Icon name="Eye" size={18} />
            <span>{m.preview}</span>
          </button>
        </div>
        <p class="hint bc-copy-error" id="bc-copy-error" role="alert" hidden>{s.client.copyFailed}</p>
        <p class="hint">{m.linkPrivacy}</p>
        <p class="hint">{m.draftHint}</p>
      </div>
    </section>
  </div>
</div>

<script>
  import { $, $$, copyText, debounce, flashButton, loadPref, savePref } from '../../lib/client';
  import { track as trackEvent } from '../../lib/analytics';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import type { Strings } from './i18n';
  import {
    DEFAULT_TUNING,
    IDLE_BLOW,
    LIMITS,
    blowOrder,
    candlePlan,
    decodeHash,
    encodeCard,
    headline,
    hitCandle,
    median,
    normalizeCard,
    ordinal,
    rmsDb,
    shareUrl,
    spectrumFeatures,
    stepBlow,
    sweepCandles,
    tuningFor,
    type Card,
    type Point,
  } from './logic';
  import { PALETTES } from './themes';
  import { drawCake, leanFlames, putOut, relightAll, toCakePoint, type CakeView } from './cake';
  import { playSong, type SongHandle } from './sound';
  import { confetti } from './confetti';

  type Mode = 'maker' | 'recipient';
  type Phase = 'lit' | 'listening' | 'out';
  type MicProblem = keyof Strings['client']['micErrors'];

  const root = $('[data-tool="birthday-candles"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const intl = LOCALE_INFO[locale].intl;
  const DRAFT_KEY = `birthday-candles:draft:${locale}`;
  const MUTE_KEY = 'birthday-candles:muted';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const invalidEl = $('#bc-invalid', root);
  const stage = $('#bc-stage', root);
  const confettiCanvas = $<HTMLCanvasElement>('#bc-confetti', root);
  const fromEl = $('#bc-from', root);
  const titleEl = $('#bc-title', root);
  const cakeSvg = $<SVGSVGElement>('#bc-cake', root);
  const promptEl = $('#bc-prompt', root);
  const meter = $('#bc-meter', root);
  const meterFill = $('#bc-meter-fill', root);
  const micBtn = $<HTMLButtonElement>('#bc-mic', root);
  const micLabel = $('#bc-mic-label', root);
  const quickBtn = $<HTMLButtonElement>('#bc-quick', root);
  const noteEl = $('#bc-note', root);
  const micErrorEl = $('#bc-mic-error', root);
  const cardEl = $('#bc-card', root);
  const messageEl = $('#bc-message', root);
  const signEl = $('#bc-sign', root);
  const afterEl = $('#bc-after', root);
  const replayBtn = $<HTMLButtonElement>('#bc-replay', root);
  const muteBtn = $<HTMLButtonElement>('#bc-mute', root);
  const muteOn = $('#bc-mute-on', root);
  const muteOff = $('#bc-mute-off', root);
  const muteLabel = $('#bc-mute-label', root);
  const relightBtn = $<HTMLButtonElement>('#bc-relight', root);
  const makeBtn = $<HTMLButtonElement>('#bc-make', root);
  const nameIn = $<HTMLInputElement>('#bc-name', root);
  const ageIn = $<HTMLInputElement>('#bc-age', root);
  const msgIn = $<HTMLTextAreaElement>('#bc-msg', root);
  const senderIn = $<HTMLInputElement>('#bc-sender', root);
  const themeRadios = $$<HTMLInputElement>('input[name="bc-theme"]', root);
  const countEl = $('#bc-count', root);
  const linkIn = $<HTMLInputElement>('#bc-link', root);
  const copyBtn = $<HTMLButtonElement>('#bc-copy', root);
  const copyLabel = $('#bc-copy-label', root);
  const copyError = $('#bc-copy-error', root);
  const shareBtn = $<HTMLButtonElement>('#bc-share-btn', root);
  const previewBtn = $<HTMLButtonElement>('#bc-preview', root);
  const tapHint = noteEl.textContent ?? '';

  let mode: Mode = 'maker';
  let phase: Phase = 'lit';
  let shown: Card = normalizeCard(null);
  let cakeKey = '';
  let view: CakeView | null = null;
  let order: number[] = [];
  let formReady = false;
  let muted = loadPref<boolean>(MUTE_KEY, false) === true;
  let routedHash: string | null = null;
  /** The message has been revealed after the candles went out. */
  let revealed = false;

  /* ---------- The cake and its text ---------- */
  const ordinalText = (n: number) => ordinal(n, s.ordinal, intl);

  function renderCard(card: Card) {
    shown = card;
    const pal = PALETTES[card.theme];
    stage.style.setProperty('--bc-night1', pal.night[0]);
    stage.style.setProperty('--bc-night2', pal.night[1]);
    stage.style.setProperty('--bc-day1', pal.day[0]);
    stage.style.setProperty('--bc-day2', pal.day[1]);
    stage.style.setProperty('--bc-accent', pal.accent);
    fromEl.textContent = card.from ? t(s.fromLine, { from: card.from }) : s.fromNone;
    titleEl.textContent = headline(card, s.headline, ordinalText);
    messageEl.textContent = card.message;
    messageEl.hidden = !card.message;
    signEl.textContent = card.from ? t(s.sign, { from: card.from }) : '';
    signEl.hidden = !card.from;
    const key = `${card.theme}|${card.age ?? ''}`;
    if (key !== cakeKey) {
      cakeKey = key;
      view = drawCake(cakeSvg, candlePlan(card.age), card.theme);
      order = blowOrder(view.spots);
      updateLit();
    }
    updateCard();
  }

  const litCount = () => (view ? view.flames.filter((f) => f.lit).length : 0);
  const nextLit = () => order.find((i) => view?.flames[i].lit) ?? -1;

  function updateLit() {
    const total = view?.flames.length ?? 0;
    stage.style.setProperty('--lit', total ? (litCount() / total).toFixed(3) : '0');
  }

  /** The maker always sees the message; the recipient only once the candles are out. */
  function updateCard() {
    const hasContent = Boolean(shown.message || shown.from);
    cardEl.hidden = !hasContent || (mode === 'recipient' && !(phase === 'out' && revealed));
  }

  /* ---------- Phases (recipient) ---------- */
  function setPhase(next: Phase) {
    phase = next;
    stage.dataset.phase = next;
    const out = next === 'out';
    promptEl.textContent = next === 'lit' ? s.wish : next === 'listening' ? s.listening : s.allOut;
    meter.hidden = next !== 'listening';
    micBtn.hidden = out;
    quickBtn.hidden = out;
    noteEl.hidden = out;
    micLabel.textContent = next === 'listening' ? s.micStop : s.micStart;
    micBtn.classList.toggle('is-on', next === 'listening');
    if (next === 'lit') noteEl.textContent = tapHint;
    if (next === 'listening') noteEl.textContent = s.micTip;
    afterEl.hidden = !out;
    if (out) micErrorEl.hidden = true;
    updateCard();
  }

  /* ---------- Blowing out ---------- */
  let revealTimer = 0;
  let quickTimers: number[] = [];
  let stopConfetti: (() => void) | null = null;
  let song: SongHandle | null = null;

  function extinguish(index: number) {
    if (!view || mode !== 'recipient' || phase === 'out') return;
    const flame = view.flames[index];
    if (!flame?.lit) return;
    putOut(view, index);
    updateLit();
    if (litCount() === 0) celebrate();
  }

  function celebrate() {
    stopMic();
    if (view) leanFlames(view, 0, 0, -1, 0);
    setPhase('out');
    revealTimer = window.setTimeout(() => {
      revealed = true;
      updateCard();
      if (!cardEl.hidden) cardEl.scrollIntoView({ block: 'nearest', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      if (!reducedMotion.matches) stopConfetti = confetti(confettiCanvas, PALETTES[shown.theme].confetti);
      if (!muted) startSong();
    }, 900);
  }

  function resetCelebration() {
    window.clearTimeout(revealTimer);
    for (const id of quickTimers) window.clearTimeout(id);
    quickTimers = [];
    revealed = false;
    stopConfetti?.();
    stopConfetti = null;
    song?.stop();
    song = null;
  }

  function relight() {
    resetCelebration();
    stopMic();
    if (view) relightAll(view);
    updateLit();
    setPhase('lit');
  }

  /* ---------- Sound ---------- */
  let audio: AudioContext | null = null;

  /** Create or wake the AudioContext. Call it inside a click or tap so browsers allow sound later. */
  function audioContext(): AudioContext | null {
    const AC = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!AC) return null;
    try {
      audio ??= new AC();
    } catch {
      return null;
    }
    if (audio.state !== 'running') void audio.resume().catch(() => {});
    return audio;
  }

  function startSong() {
    song?.stop();
    const ctx = audioContext();
    song = ctx ? playSong(ctx) : null;
  }

  function renderMute() {
    muteOn.hidden = muted;
    muteOff.hidden = !muted;
    muteLabel.textContent = muted ? s.unmute : s.mute;
  }

  /* ---------- Microphone ---------- */
  let stream: MediaStream | null = null;
  let source: MediaStreamAudioSourceNode | null = null;
  let analyser: AnalyserNode | null = null;
  let freq = new Float32Array(2048);
  let wave = new Float32Array(4096);
  let raf = 0;
  let lastFrame = 0;
  let calibrateFrom = 0;
  let floorLevels: number[] = [];
  let tuning = DEFAULT_TUNING;
  let blow = IDLE_BLOW;
  let micOuts = 0;
  let talkShown = false;
  let starting = false;

  function micFail(problem: MicProblem) {
    micErrorEl.textContent = s.micErrors[problem];
    micErrorEl.hidden = false;
  }

  function stopMic() {
    cancelAnimationFrame(raf);
    raf = 0;
    stream?.getTracks().forEach((track) => track.stop());
    stream = null;
    source?.disconnect();
    source = null;
    analyser = null;
    if (view) leanFlames(view, 0, 0, -1, 0);
    meterFill.style.transform = 'scaleX(0)';
  }

  async function startMic() {
    if (starting) return;
    micErrorEl.hidden = true;
    const ctx = audioContext();
    if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia || !ctx) return micFail('unsupported');
    starting = true;
    micBtn.disabled = true;
    try {
      // Voice processing would filter out exactly the breath noise we listen for.
      const next = await navigator.mediaDevices.getUserMedia({
        audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
      });
      if (mode !== 'recipient' || phase === 'out') {
        next.getTracks().forEach((track) => track.stop());
        return;
      }
      stream = next;
      source = ctx.createMediaStreamSource(next);
      analyser = ctx.createAnalyser();
      analyser.fftSize = 4096;
      analyser.smoothingTimeConstant = 0.4;
      source.connect(analyser);
      freq = new Float32Array(analyser.frequencyBinCount);
      wave = new Float32Array(analyser.fftSize);
      next.getAudioTracks()[0]?.addEventListener('ended', () => {
        if (stream !== next) return;
        stopMic();
        if (phase === 'listening') setPhase('lit');
        micFail('failed');
      });
      blow = IDLE_BLOW;
      micOuts = 0;
      tuning = DEFAULT_TUNING;
      floorLevels = [];
      calibrateFrom = performance.now();
      talkShown = false;
      lastFrame = 0;
      setPhase('listening');
      raf = requestAnimationFrame(listen);
    } catch (err) {
      const name = err instanceof DOMException || err instanceof Error ? err.name : '';
      if (name === 'NotAllowedError' || name === 'SecurityError') micFail('denied');
      else if (name === 'NotFoundError' || name === 'OverconstrainedError') micFail('notFound');
      else micFail('failed');
    } finally {
      starting = false;
      micBtn.disabled = false;
    }
  }

  function listen(now: number) {
    if (!analyser || !audio || !view) return;
    raf = requestAnimationFrame(listen);
    const dt = lastFrame ? now - lastFrame : 16;
    lastFrame = now;
    analyser.getFloatTimeDomainData(wave);
    analyser.getFloatFrequencyData(freq);
    const levelDb = rmsDb(wave);
    // The first half second sets the thresholds from the room's background level.
    if (calibrateFrom) {
      floorLevels.push(levelDb);
      if (now - calibrateFrom > 500) {
        tuning = tuningFor(median(floorLevels));
        calibrateFrom = 0;
      }
    }
    blow = stepBlow(blow, { levelDb, ...spectrumFeatures(freq, audio.sampleRate / analyser.fftSize) }, dt, view.flames.length, tuning);
    while (micOuts < Math.floor(blow.progress)) {
      const i = nextLit();
      if (i < 0) break;
      micOuts++;
      extinguish(i);
      if (phase === 'out') return;
    }
    leanFlames(view, blow.lean, now, nextLit(), blow.progress - Math.floor(blow.progress));
    meterFill.style.transform = `scaleX(${Math.min(1, blow.lean).toFixed(3)})`;
    meter.classList.toggle('is-blowing', blow.strength > 0);
    if (!talkShown && blow.talkMs > 1500) {
      talkShown = true;
      noteEl.textContent = s.talking;
    }
  }

  /* ---------- Tap and swipe fallback ---------- */
  let pointerId: number | null = null;
  let lastPoint: Point | null = null;

  cakeSvg.addEventListener('pointerdown', (event) => {
    if (mode !== 'recipient' || phase === 'out' || !view) return;
    audioContext();
    pointerId = event.pointerId;
    lastPoint = toCakePoint(cakeSvg, event.clientX, event.clientY);
    if (lastPoint) {
      const hit = hitCandle(view.spots, lastPoint);
      if (hit >= 0) extinguish(hit);
    }
  });
  cakeSvg.addEventListener('pointermove', (event) => {
    if (event.pointerId !== pointerId || !lastPoint || !view) return;
    const point = toCakePoint(cakeSvg, event.clientX, event.clientY);
    if (!point) return;
    for (const hit of sweepCandles(view.spots, lastPoint, point)) extinguish(hit);
    lastPoint = point;
  });
  for (const type of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
    cakeSvg.addEventListener(type, (event) => {
      if (event.pointerId !== pointerId) return;
      pointerId = null;
      lastPoint = null;
    });
  }

  /* ---------- Maker ---------- */
  function readForm(): Card {
    return normalizeCard({
      name: nameIn.value,
      age: ageIn.value,
      message: msgIn.value,
      from: senderIn.value,
      theme: themeRadios.find((r) => r.checked)?.value,
    });
  }

  function writeForm(card: Card) {
    nameIn.value = card.name;
    ageIn.value = card.age === null ? '' : String(card.age);
    msgIn.value = card.message;
    senderIn.value = card.from;
    for (const radio of themeRadios) radio.checked = radio.value === card.theme;
  }

  function loadDraft(): Card {
    const stored = loadPref<unknown>(DRAFT_KEY, null);
    if (stored && typeof stored === 'object') return normalizeCard(stored as Partial<Record<keyof Card, unknown>>);
    return normalizeCard({ message: s.defaultMessage });
  }

  const saveDraft = debounce((card: Card) => savePref(DRAFT_KEY, card), 300);
  const pageUrl = () => location.origin + location.pathname;

  function onFormInput() {
    const card = readForm();
    renderCard(card);
    linkIn.value = shareUrl(pageUrl(), card);
    countEl.textContent = t(s.counter, { n: Array.from(msgIn.value).length, max: LIMITS.message });
    copyError.hidden = true;
    saveDraft(card);
  }

  for (const input of [nameIn, ageIn, msgIn, senderIn]) input.addEventListener('input', onFormInput);
  for (const radio of themeRadios) radio.addEventListener('change', onFormInput);

  copyBtn.addEventListener('click', async () => {
    const ok = await copyText(linkIn.value);
    copyError.hidden = ok;
    if (ok) {
      flashButton(copyLabel);
      copyBtn.classList.add('is-done');
      window.setTimeout(() => copyBtn.classList.remove('is-done'), 1400);
    } else {
      linkIn.focus();
      linkIn.select();
    }
  });

  if (typeof navigator.share === 'function') {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      try {
        await navigator.share({ title: s.shareTitle, text: s.shareText, url: linkIn.value });
        trackEvent('share', { method: 'native', content_type: 'tool_result' });
      } catch {
        /* the visitor closed the share sheet */
      }
    });
  }

  previewBtn.addEventListener('click', () => {
    const card = readForm();
    savePref(DRAFT_KEY, card);
    location.hash = encodeCard(card);
    root.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  /* ---------- Modes ---------- */
  function enterRecipient(card: Card) {
    resetCelebration();
    stopMic();
    mode = 'recipient';
    root.dataset.mode = mode;
    invalidEl.hidden = true;
    micErrorEl.hidden = true;
    renderCard(card);
    relight();
  }

  function enterMaker(invalid: boolean) {
    resetCelebration();
    stopMic();
    mode = 'maker';
    root.dataset.mode = mode;
    invalidEl.hidden = !invalid;
    if (!formReady) {
      writeForm(loadDraft());
      formReady = true;
    }
    if (view) relightAll(view);
    setPhase('lit');
    onFormInput();
    updateLit();
  }

  function route() {
    if (location.hash === routedHash) return;
    routedHash = location.hash;
    const result = decodeHash(location.hash);
    if (result.status === 'ok') enterRecipient(result.card);
    else enterMaker(result.status === 'invalid');
  }

  makeBtn.addEventListener('click', () => {
    history.pushState(null, '', location.pathname + location.search);
    route();
    root.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  micBtn.addEventListener('click', () => {
    if (phase === 'listening') {
      stopMic();
      setPhase('lit');
    } else void startMic();
  });

  quickBtn.addEventListener('click', () => {
    audioContext();
    if (phase === 'listening') {
      stopMic();
      setPhase('lit');
    }
    const remaining = order.filter((i) => view?.flames[i].lit);
    quickTimers = remaining.map((i, k) => window.setTimeout(() => extinguish(i), k * 170));
  });

  relightBtn.addEventListener('click', relight);
  replayBtn.addEventListener('click', () => {
    muted = false;
    savePref(MUTE_KEY, muted);
    renderMute();
    startSong();
  });
  muteBtn.addEventListener('click', () => {
    muted = !muted;
    savePref(MUTE_KEY, muted);
    renderMute();
    if (muted) {
      song?.stop();
      song = null;
    } else if (phase === 'out') startSong();
  });

  window.addEventListener('hashchange', route);
  window.addEventListener('popstate', route);
  // Leaving the tab turns the microphone off; it is never left running in the background.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden' && phase === 'listening') {
      stopMic();
      setPhase('lit');
    }
  });
  window.addEventListener('pagehide', () => {
    stopMic();
    song?.stop();
  });

  renderMute();
  route();
</script>

