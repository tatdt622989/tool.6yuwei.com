---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="password-generator" {...i18nAttrs(locale, s.client)}>
  <div class="pw-out">
    <input id="pw-value" class="mono" type="text" readonly aria-label={s.outputAria} />
    <button class="btn primary" type="button" data-copy="#pw-value">{s.copy}</button>
    <button class="btn" type="button" id="pw-regen">{s.regenerate}</button>
  </div>

  <div class="meter" aria-live="polite">
    <div class="meter-track"><div class="meter-bar" id="pw-bar"></div></div>
    <span id="pw-strength" class="meter-text"></span>
  </div>

  <div class="field">
    <label for="pw-length">{s.lengthBefore}<output id="pw-length-out">16</output>{s.lengthAfter}</label>
    <input id="pw-length" type="range" min="4" max="64" value="16" />
  </div>

  <fieldset class="opts">
    <legend class="visually-hidden">{s.setsLegend}</legend>
    <label class="check"><input type="checkbox" name="upper" checked /> {s.upper}</label>
    <label class="check"><input type="checkbox" name="lower" checked /> {s.lower}</label>
    <label class="check"><input type="checkbox" name="digits" checked /> {s.digits}</label>
    <label class="check"><input type="checkbox" name="symbols" checked /> {s.symbols}</label>
    <label class="check"><input type="checkbox" name="excludeAmbiguous" /> {s.excludeAmbiguous}</label>
  </fieldset>

  <div class="field">
    <span class="label">{s.batchLabel}</span>
    <div class="row">
      <button class="btn small" type="button" id="pw-batch">{s.batch}</button>
      <button class="btn small ghost" type="button" data-copy="#pw-list">{s.copyAll}</button>
    </div>
    <div class="output" id="pw-list" hidden></div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { entropyBits, generatePassword, strengthOf, type PasswordOptions } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="password-generator"]');
  const { s } = readI18n<Strings['client']>(root);
  const out = $<HTMLInputElement>('#pw-value', root);
  const length = $<HTMLInputElement>('#pw-length', root);
  const lengthOut = $('#pw-length-out', root);
  const bar = $('#pw-bar', root);
  const strengthText = $('#pw-strength', root);
  const list = $('#pw-list', root);
  const boxes = $$<HTMLInputElement>('.opts input', root);

  const defaults: PasswordOptions = {
    length: 16,
    upper: true,
    lower: true,
    digits: true,
    symbols: true,
    excludeAmbiguous: false,
  };

  function readOptions(): PasswordOptions {
    const opts = { ...defaults, length: Number(length.value) };
    for (const box of boxes) (opts as unknown as Record<string, boolean>)[box.name] = box.checked;
    return opts;
  }

  function applyOptions(opts: PasswordOptions) {
    length.value = String(opts.length);
    for (const box of boxes) box.checked = Boolean((opts as unknown as Record<string, boolean>)[box.name]);
  }

  const levels = { weak: 25, fair: 50, strong: 75, 'very-strong': 100 } as const;

  function render() {
    const opts = readOptions();
    savePref('password-generator', opts);
    lengthOut.textContent = String(opts.length);
    out.value = generatePassword(opts);
    const bits = entropyBits(opts);
    const level = strengthOf(bits);
    bar.style.width = `${opts.length && out.value ? levels[level] : 0}%`;
    bar.dataset.level = level;
    strengthText.textContent = out.value
      ? t(s.strength, { label: s.strengthLabels[level], bits: Math.round(bits) })
      : s.noSets;
  }

  applyOptions(loadPref('password-generator', defaults));
  length.addEventListener('input', render);
  boxes.forEach((box) => box.addEventListener('change', render));
  $('#pw-regen', root).addEventListener('click', render);
  $('#pw-batch', root).addEventListener('click', () => {
    const opts = readOptions();
    list.textContent = Array.from({ length: 10 }, () => generatePassword(opts)).join('\n');
    list.hidden = false;
  });
  render();
</script>

<style>
  .pw-out {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px;
  }
  .pw-out input {
    font-size: 18px;
    letter-spacing: 0.02em;
  }
  @media (max-width: 520px) {
    .pw-out {
      grid-template-columns: 1fr 1fr;
    }
    .pw-out input {
      grid-column: 1 / -1;
    }
  }
  .meter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .meter-track {
    flex: 1 1 120px;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .meter-bar {
    height: 100%;
    width: 0;
    background: var(--danger);
    transition: width 0.2s, background 0.2s;
  }
  .meter-bar[data-level='fair'] {
    background: var(--warning);
  }
  .meter-bar[data-level='strong'],
  .meter-bar[data-level='very-strong'] {
    background: var(--success);
  }
  .meter-text {
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
  }
  .opts {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  @media (min-width: 640px) {
    .opts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
