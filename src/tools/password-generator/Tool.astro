<div class="tool" data-tool="password-generator">
  <div class="pw-out">
    <input id="pw-value" class="mono" type="text" readonly aria-label="產生的密碼" />
    <button class="btn primary" type="button" data-copy="#pw-value">複製</button>
    <button class="btn" type="button" id="pw-regen">重新產生</button>
  </div>

  <div class="meter" aria-live="polite">
    <div class="meter-track"><div class="meter-bar" id="pw-bar"></div></div>
    <span id="pw-strength" class="meter-text"></span>
  </div>

  <div class="field">
    <label for="pw-length">長度：<output id="pw-length-out">16</output> 個字元</label>
    <input id="pw-length" type="range" min="4" max="64" value="16" />
  </div>

  <fieldset class="opts">
    <legend class="visually-hidden">字元類型</legend>
    <label class="check"><input type="checkbox" name="upper" checked /> 大寫字母 A–Z</label>
    <label class="check"><input type="checkbox" name="lower" checked /> 小寫字母 a–z</label>
    <label class="check"><input type="checkbox" name="digits" checked /> 數字 0–9</label>
    <label class="check"><input type="checkbox" name="symbols" checked /> 符號 !@#$%</label>
    <label class="check"><input type="checkbox" name="excludeAmbiguous" /> 排除易混淆字元（0 O l 1 I）</label>
  </fieldset>

  <div class="field">
    <span class="label">一次產生多組</span>
    <div class="row">
      <button class="btn small" type="button" id="pw-batch">產生 10 組</button>
      <button class="btn small ghost" type="button" data-copy="#pw-list">複製全部</button>
    </div>
    <div class="output" id="pw-list" hidden></div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { entropyBits, generatePassword, strengthOf, STRENGTH_LABEL, type PasswordOptions } from './logic';

  const root = $('[data-tool="password-generator"]');
  const out = $<HTMLInputElement>('#pw-value', root);
  const length = $<HTMLInputElement>('#pw-length', root);
  const lengthOut = $('#pw-length-out', root);
  const bar = $('#pw-bar', root);
  const strengthText = $('#pw-strength', root);
  const list = $('#pw-list', root);
  const boxes = $$<HTMLInputElement>('.opts input', root);

  const defaults: PasswordOptions = {
    length: 16,
    upper: true,
    lower: true,
    digits: true,
    symbols: true,
    excludeAmbiguous: false,
  };

  function readOptions(): PasswordOptions {
    const opts = { ...defaults, length: Number(length.value) };
    for (const box of boxes) (opts as unknown as Record<string, boolean>)[box.name] = box.checked;
    return opts;
  }

  function applyOptions(opts: PasswordOptions) {
    length.value = String(opts.length);
    for (const box of boxes) box.checked = Boolean((opts as unknown as Record<string, boolean>)[box.name]);
  }

  const levels = { weak: 25, fair: 50, strong: 75, 'very-strong': 100 } as const;

  function render() {
    const opts = readOptions();
    savePref('password-generator', opts);
    lengthOut.textContent = String(opts.length);
    out.value = generatePassword(opts);
    const bits = entropyBits(opts);
    const level = strengthOf(bits);
    bar.style.width = `${opts.length && out.value ? levels[level] : 0}%`;
    bar.dataset.level = level;
    strengthText.textContent = out.value ? `強度：${STRENGTH_LABEL[level]}（約 ${Math.round(bits)} 位元熵）` : '請至少勾選一種字元類型';
  }

  applyOptions(loadPref('password-generator', defaults));
  length.addEventListener('input', render);
  boxes.forEach((box) => box.addEventListener('change', render));
  $('#pw-regen', root).addEventListener('click', render);
  $('#pw-batch', root).addEventListener('click', () => {
    const opts = readOptions();
    list.textContent = Array.from({ length: 10 }, () => generatePassword(opts)).join('\n');
    list.hidden = false;
  });
  render();
</script>

<style>
  .pw-out {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px;
  }
  .pw-out input {
    font-size: 18px;
    letter-spacing: 0.02em;
  }
  @media (max-width: 520px) {
    .pw-out {
      grid-template-columns: 1fr 1fr;
    }
    .pw-out input {
      grid-column: 1 / -1;
    }
  }
  .meter {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .meter-track {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .meter-bar {
    height: 100%;
    width: 0;
    background: var(--danger);
    transition: width 0.2s, background 0.2s;
  }
  .meter-bar[data-level='fair'] {
    background: var(--warning);
  }
  .meter-bar[data-level='strong'],
  .meter-bar[data-level='very-strong'] {
    background: var(--success);
  }
  .meter-text {
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
  }
  .opts {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  @media (min-width: 640px) {
    .opts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
