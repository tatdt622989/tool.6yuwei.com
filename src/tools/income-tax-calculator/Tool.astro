<div class="tool" data-tool="income-tax-calculator">
  <div class="grid-2">
    <div class="field">
      <span class="label">申報年度</span>
      <div class="seg" role="radiogroup" aria-label="申報年度">
        <label><input type="radio" name="tx-year" value="114" checked /><span>114 年度（2026 報稅）</span></label>
        <label><input type="radio" name="tx-year" value="115" /><span>115 年度（2027 報稅）</span></label>
      </div>
    </div>
    <div class="field">
      <span class="label">申報身分</span>
      <div class="seg" role="radiogroup" aria-label="申報身分">
        <label><input type="radio" name="tx-status" value="single" checked /><span>單身</span></label>
        <label><input type="radio" name="tx-status" value="married" /><span>有配偶（合併申報）</span></label>
      </div>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="tx-salary">本人全年薪資收入（元）</label>
      <input id="tx-salary" type="text" inputmode="numeric" autocomplete="off" value="720000" />
      <span class="hint">含年終與獎金，不含勞退自提金額。</span>
    </div>
    <div class="field tx-spouse">
      <label for="tx-salary2">配偶全年薪資收入（元）</label>
      <input id="tx-salary2" type="text" inputmode="numeric" autocomplete="off" value="0" />
    </div>
    <div class="field">
      <label for="tx-interest">利息所得（元）</label>
      <input id="tx-interest" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">存款利息，27 萬元內可全額扣除。</span>
    </div>
    <div class="field">
      <label for="tx-other">其他所得（元）</label>
      <input id="tx-other" type="text" inputmode="numeric" autocomplete="off" value="0" />
      <span class="hint">股利（選合併計稅）、租賃、執行業務等所得。</span>
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="tx-senior" /> 本人年滿 70 歲</label>
    <label class="check tx-spouse"><input type="checkbox" id="tx-senior2" /> 配偶年滿 70 歲</label>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="tx-dep">受扶養親屬（未滿 70 歲）人數</label>
      <input id="tx-dep" type="text" inputmode="numeric" autocomplete="off" value="0" />
    </div>
    <div class="field">
      <label for="tx-dep70">受扶養 70 歲以上直系尊親屬人數</label>
      <input id="tx-dep70" type="text" inputmode="numeric" autocomplete="off" value="0" />
    </div>
  </div>

  <details class="tx-more">
    <summary>扣除額：列舉、身障、幼兒學前、長照、房屋租金</summary>
    <div class="grid-2">
      <div class="field">
        <label for="tx-itemized">列舉扣除額合計（元，沒有填 0）</label>
        <input id="tx-itemized" type="text" inputmode="numeric" autocomplete="off" value="0" />
        <span class="hint">保險費、醫藥費、捐贈、房貸利息等；低於標準扣除額會自動改用標準扣除額。</span>
      </div>
      <div class="field">
        <label for="tx-rent">全年房屋租金支出（元）</label>
        <input id="tx-rent" type="text" inputmode="numeric" autocomplete="off" value="0" />
        <span class="hint">無自有房屋租屋自住，上限 18 萬元。</span>
      </div>
      <div class="field">
        <label for="tx-disabled">身心障礙者人數</label>
        <input id="tx-disabled" type="text" inputmode="numeric" autocomplete="off" value="0" />
      </div>
      <div class="field">
        <label for="tx-preschool">6 歲以下子女人數</label>
        <input id="tx-preschool" type="text" inputmode="numeric" autocomplete="off" value="0" />
      </div>
      <div class="field">
        <label for="tx-tuition">就讀大專以上子女人數</label>
        <input id="tx-tuition" type="text" inputmode="numeric" autocomplete="off" value="0" />
        <span class="hint">每人以 25,000 元上限估算。</span>
      </div>
      <div class="field">
        <label for="tx-ltc">符合長照需要人數</label>
        <input id="tx-ltc" type="text" inputmode="numeric" autocomplete="off" value="0" />
      </div>
      <div class="field">
        <label for="tx-basic">每人基本生活費（元）</label>
        <input id="tx-basic" type="text" inputmode="numeric" autocomplete="off" placeholder="213000" />
        <span class="hint" id="tx-basic-hint"></span>
      </div>
    </div>
  </details>

  <div class="notice error" id="tx-error" hidden></div>

  <div id="tx-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="tx-tax">—</div>
      <div class="result-label" id="tx-tax-label">應納稅額</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="tx-rate">—</span><span class="stat-label">適用稅率（邊際）</span></div>
      <div class="stat"><span class="stat-value" id="tx-eff">—</span><span class="stat-label">有效稅率</span></div>
      <div class="stat"><span class="stat-value" id="tx-net">—</span><span class="stat-label">綜合所得淨額</span></div>
      <div class="stat"><span class="stat-value" id="tx-method">—</span><span class="stat-label">最省稅的計稅方式</span></div>
    </div>

    <p class="notice" id="tx-note" hidden></p>

    <div id="tx-parts"></div>
  </div>

  <p class="hint">依財政部公告之 114 年度與 115 年度免稅額、扣除額與課稅級距計算，未含股利可抵減稅額、基本稅額（最低稅負制）與扣繳稅款抵繳。結果僅供參考，實際應納稅額以財政部電子申報繳稅服務網試算為準。所有資料只在你的瀏覽器內計算，不會上傳。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { calculateTax, METHOD_LABEL, TAX_YEARS, validateTax, type TaxInput, type TaxPart } from './logic';

  const KEY = 'income-tax-calculator';
  const root = $('[data-tool="income-tax-calculator"]');
  const years = $$<HTMLInputElement>('input[name="tx-year"]', root);
  const statuses = $$<HTMLInputElement>('input[name="tx-status"]', root);
  const textIds = ['salary', 'salary2', 'interest', 'other', 'dep', 'dep70', 'itemized', 'rent', 'disabled', 'preschool', 'tuition', 'ltc', 'basic'] as const;
  type TextId = (typeof textIds)[number];
  const fields = Object.fromEntries(textIds.map((id) => [id, $<HTMLInputElement>(`#tx-${id}`, root)])) as Record<TextId, HTMLInputElement>;
  const senior = $<HTMLInputElement>('#tx-senior', root);
  const senior2 = $<HTMLInputElement>('#tx-senior2', root);
  const error = $('#tx-error', root);
  const output = $('#tx-output', root);
  const note = $('#tx-note', root);
  const partsEl = $('#tx-parts', root);

  const money = (n: number) => `${formatInteger(n)} 元`;
  const pct = (n: number) => `${formatNumber(n * 100, 2)}%`;
  const num = (id: TextId) => (fields[id].value.trim() === '' ? 0 : parseNumber(fields[id].value));

  interface Prefs {
    year: string;
    status: string;
    senior: boolean;
    senior2: boolean;
    text: Partial<Record<TextId, string>>;
  }
  const prefs = loadPref<Partial<Prefs>>(KEY, {});
  if (prefs.year) for (const y of years) y.checked = y.value === prefs.year;
  if (prefs.status) for (const s of statuses) s.checked = s.value === prefs.status;
  if (prefs.senior !== undefined) senior.checked = prefs.senior;
  if (prefs.senior2 !== undefined) senior2.checked = prefs.senior2;
  for (const id of textIds) {
    const v = prefs.text?.[id];
    if (v !== undefined) fields[id].value = v;
  }

  function readInput(): TaxInput {
    const year = (years.find((y) => y.checked)?.value ?? '114') as TaxInput['year'];
    return {
      year,
      married: statuses.find((s) => s.checked)?.value === 'married',
      salarySelf: num('salary'),
      salarySpouse: num('salary2'),
      seniorSelf: senior.checked,
      seniorSpouse: senior2.checked,
      dependents: num('dep'),
      seniorDependents: num('dep70'),
      interest: num('interest'),
      otherIncome: num('other'),
      itemized: num('itemized'),
      disabled: num('disabled'),
      preschool: num('preschool'),
      tuition: num('tuition'),
      longTermCare: num('ltc'),
      rent: num('rent'),
      basicLiving: fields.basic.value.trim() === '' ? undefined : parseNumber(fields.basic.value),
    };
  }

  function partTable(part: TaxPart, showTitle: boolean): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'field';
    if (showTitle) {
      const title = document.createElement('span');
      title.className = 'label';
      title.textContent = part.title;
      wrap.append(title);
    }
    const tw = document.createElement('div');
    tw.className = 'table-wrap';
    const table = document.createElement('table');
    table.className = 'table';
    const body = document.createElement('tbody');
    const add = (label: string, value: string, strong = false) => {
      const tr = document.createElement('tr');
      if (strong) tr.className = 'tx-sum';
      const a = document.createElement('td');
      a.textContent = label;
      const b = document.createElement('td');
      b.className = 'num';
      b.textContent = value;
      tr.append(a, b);
      body.append(tr);
    };
    for (const s of part.steps) add(s.op === '=' ? s.label : `${s.op === '+' ? '加' : '減'}：${s.label}`, money(s.amount), s.op === '=');
    add(`稅率 ${pct(part.rate)}，累進差額`, money(part.diff));
    add(`應納稅額 = ${formatInteger(part.net)} × ${pct(part.rate)} − ${formatInteger(part.diff)}`, money(part.tax), true);
    table.append(body);
    tw.append(table);
    wrap.append(tw);
    return wrap;
  }

  function render() {
    const input = readInput();
    const y = TAX_YEARS[input.year];
    savePref(KEY, {
      year: input.year,
      status: input.married ? 'married' : 'single',
      senior: senior.checked,
      senior2: senior2.checked,
      text: Object.fromEntries(textIds.map((id) => [id, fields[id].value])),
    } satisfies Prefs);

    for (const el of $$('.tx-spouse', root)) el.hidden = !input.married;
    fields.basic.placeholder = String(y.basicLiving);
    $('#tx-basic-hint', root).textContent = y.basicLivingOfficial
      ? `${y.label}公告為 ${formatInteger(y.basicLiving)} 元，留空即使用。`
      : `${y.label}尚未公告，暫以 ${formatInteger(y.basicLiving)} 元估算，可自行修改。`;

    const problem = validateTax(input);
    const r = problem ? null : calculateTax(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    $('#tx-tax', root).textContent = money(r.tax);
    $('#tx-tax-label', root).textContent = `${y.label}綜合所得稅應納稅額（${y.filed}）`;
    $('#tx-rate', root).textContent = pct(r.marginalRate);
    $('#tx-eff', root).textContent = pct(r.effectiveRate);
    $('#tx-net', root).textContent = money(r.parts.reduce((s, p) => s + p.net, 0));
    $('#tx-method', root).textContent = METHOD_LABEL[r.method];

    const notes: string[] = [];
    if (r.alternatives.length > 1) {
      notes.push(
        '各計稅方式比較：' + r.alternatives.map((a) => `${METHOD_LABEL[a.method]} ${money(a.tax)}`).join('、') + '，已自動採用最低者。',
      );
    }
    if (r.wealthExcluded) notes.push('適用稅率達 20% 以上，依排富規定不得列報長期照顧與房屋租金支出特別扣除額。');
    if (r.basicLivingDiff > 0) notes.push(`每人基本生活費總額高於免稅額與扣除額合計，可再減除基本生活費差額 ${money(r.basicLivingDiff)}。`);
    note.textContent = notes.join(' ');
    note.hidden = notes.length === 0;

    partsEl.replaceChildren(...r.parts.map((p) => partTable(p, r.parts.length > 1)));
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #tx-output,
  #tx-parts {
    display: grid;
    gap: 16px;
  }
  #tx-output[hidden],
  .tx-spouse[hidden] {
    display: none;
  }
  .tx-more {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .tx-more[open] {
    display: grid;
    gap: 14px;
  }
  .tx-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
  #tx-parts :global(.tx-sum td) {
    font-weight: 700;
    background: var(--surface-2);
  }
  #tx-parts :global(td:first-child) {
    white-space: normal;
  }
</style>
