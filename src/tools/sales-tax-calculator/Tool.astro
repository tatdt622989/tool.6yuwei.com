---
import type { ToolProps } from '../../i18n/tool';
import { formatRate, STATE_RATES } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
---

<div class="tool" data-tool="sales-tax-calculator" data-locale={locale}>
  <div class="seg" role="radiogroup" aria-label="Calculation">
    <label><input type="radio" name="st-mode" value="add" checked /><span>Add tax</span></label>
    <label><input type="radio" name="st-mode" value="remove" /><span>Remove tax</span></label>
  </div>

  <div class="grid-3">
    <div class="field">
      <label for="st-amount" id="st-amount-label">Price before tax ($)</label>
      <input id="st-amount" type="text" inputmode="decimal" autocomplete="off" value="100.00" />
    </div>
    <div class="field">
      <label for="st-state">State</label>
      <select id="st-state">
        <option value="">Custom rate</option>
        {
          STATE_RATES.map((s) => (
            <option value={s.code} selected={s.code === 'CA'}>
              {s.name} ({formatRate(s.rate)})
            </option>
          ))
        }
      </select>
    </div>
    <div class="field">
      <label for="st-rate">Sales tax rate (%)</label>
      <input id="st-rate" type="text" inputmode="decimal" autocomplete="off" value="7.25" />
    </div>
  </div>
  <p class="hint" id="st-state-note">&nbsp;</p>

  <div class="result" aria-live="polite">
    <div class="result-value" id="st-main">—</div>
    <div class="result-label" id="st-main-label">Total with tax</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="st-tax">—</span><span class="stat-label">Sales tax</span></div>
    <div class="stat" id="st-price-stat"><span class="stat-value" id="st-price">—</span><span class="stat-label">Price before tax</span></div>
    <div class="stat" id="st-total-stat"><span class="stat-value" id="st-total">—</span><span class="stat-label">Total with tax</span></div>
  </div>

  <p class="output" id="st-formula" aria-label="Formula"></p>
  <div class="notice" id="st-notice" hidden></div>

  <section class="st-card" aria-labelledby="st-find-title">
    <h2 class="st-card-title" id="st-find-title">Find the tax rate from a receipt</h2>
    <div class="grid-2">
      <div class="field">
        <label for="st-f-price">Subtotal before tax ($)</label>
        <input id="st-f-price" type="text" inputmode="decimal" autocomplete="off" value="42.00" />
      </div>
      <div class="field">
        <label for="st-f-total">Total paid ($)</label>
        <input id="st-f-total" type="text" inputmode="decimal" autocomplete="off" value="45.47" />
      </div>
    </div>
    <p class="st-find-out"><strong id="st-f-rate">—</strong> <span class="hint" id="st-f-detail"></span></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import {
    addTax,
    findState,
    formatRate,
    formatUsd,
    isValidRate,
    MAX_RATE,
    rateFrom,
    removeTax,
    toCents,
    isValidAmount,
  } from './logic';

  type Mode = 'add' | 'remove';
  const root = $('[data-tool="sales-tax-calculator"]');
  const modes = $$<HTMLInputElement>('input[name="st-mode"]', root);
  const amount = $<HTMLInputElement>('#st-amount', root);
  const amountLabel = $('#st-amount-label', root);
  const state = $<HTMLSelectElement>('#st-state', root);
  const rate = $<HTMLInputElement>('#st-rate', root);
  const stateNote = $('#st-state-note', root);
  const main = $('#st-main', root);
  const mainLabel = $('#st-main-label', root);
  const taxEl = $('#st-tax', root);
  const priceEl = $('#st-price', root);
  const totalEl = $('#st-total', root);
  const formula = $('#st-formula', root);
  const priceStat = $('#st-price-stat', root);
  const totalStat = $('#st-total-stat', root);
  const notice = $('#st-notice', root);
  const fPrice = $<HTMLInputElement>('#st-f-price', root);
  const fTotal = $<HTMLInputElement>('#st-f-total', root);
  const fRate = $('#st-f-rate', root);
  const fDetail = $('#st-f-detail', root);

  interface Prefs {
    mode: Mode;
    amount: string;
    state: string;
    rate: string;
  }
  const saved = loadPref<Partial<Prefs>>('sales-tax-calculator', {});
  if (saved.amount) amount.value = saved.amount;
  if (typeof saved.state === 'string' && (saved.state === '' || findState(saved.state))) state.value = saved.state;
  if (saved.rate) rate.value = saved.rate;
  modes.forEach((m) => (m.checked = m.value === (saved.mode ?? 'add')));

  const mode = (): Mode => (modes.find((m) => m.checked)?.value === 'remove' ? 'remove' : 'add');

  function showNotice(text: string, kind: '' | 'error' = '') {
    notice.textContent = text;
    notice.className = kind ? `notice ${kind}` : 'notice';
    notice.hidden = text === '';
  }

  function describeState() {
    const s = findState(state.value);
    const typed = parseNumber(rate.value);
    if (!s) {
      stateNote.textContent = 'Enter the combined state and local rate shown on your receipt or your city’s tax website.';
      return;
    }
    if (s.rate === 0) {
      stateNote.textContent =
        s.avgCombined > 0
          ? `${s.name} has no statewide sales tax, but some local governments charge one (average ${formatRate(s.avgCombined)}). Enter your local rate if it applies.`
          : `${s.name} has no general sales tax.`;
      return;
    }
    const local = s.avgCombined > s.rate + 0.005;
    stateNote.textContent =
      (local
        ? `${formatRate(s.rate)} is the ${s.name} state rate. With local taxes the average combined rate is about ${formatRate(s.avgCombined)}; type your exact combined rate if you know it.`
        : `${formatRate(s.rate)} is the ${s.name} statewide rate.`) +
      (typed !== s.rate && Number.isFinite(typed) ? ' You are using a custom rate.' : '');
  }

  function clear(message: string) {
    for (const el of [main, taxEl, priceEl, totalEl]) el.textContent = '—';
    formula.textContent = '';
    showNotice(message, 'error');
  }

  function render() {
    const m = mode();
    savePref('sales-tax-calculator', { mode: m, amount: amount.value, state: state.value, rate: rate.value } satisfies Prefs);
    amountLabel.textContent = m === 'add' ? 'Price before tax ($)' : 'Total including tax ($)';
    mainLabel.textContent = m === 'add' ? 'Total with tax' : 'Price before tax';
    // The big number already shows one of these; the stats show the other two figures.
    priceStat.hidden = m === 'remove';
    totalStat.hidden = m === 'add';
    describeState();

    const cents = toCents(parseNumber(amount.value));
    const r = parseNumber(rate.value);
    if (!isValidAmount(cents)) return clear('Enter an amount in dollars, for example 59.99.');
    if (!isValidRate(r)) return clear(`Enter a tax rate between 0 and ${MAX_RATE}%.`);

    if (m === 'add') {
      const res = addTax(cents, r)!;
      main.textContent = formatUsd(res.totalCents);
      taxEl.textContent = formatUsd(res.taxCents);
      priceEl.textContent = formatUsd(res.priceCents);
      totalEl.textContent = formatUsd(res.totalCents);
      formula.textContent = `Tax = ${formatUsd(res.priceCents)} × ${formatRate(r)} = ${formatUsd(res.taxCents)}\nTotal = ${formatUsd(res.priceCents)} + ${formatUsd(res.taxCents)} = ${formatUsd(res.totalCents)}`;
      showNotice('');
    } else {
      const res = removeTax(cents, r)!;
      main.textContent = formatUsd(res.priceCents);
      taxEl.textContent = formatUsd(res.taxCents);
      priceEl.textContent = formatUsd(res.priceCents);
      totalEl.textContent = formatUsd(res.totalCents);
      formula.textContent = `Price = ${formatUsd(res.totalCents)} ÷ (1 + ${formatRate(r)}) ≈ ${formatUsd(res.priceCents)}\nTax = ${formatUsd(res.totalCents)} − ${formatUsd(res.priceCents)} = ${formatUsd(res.taxCents)}`;
      showNotice(
        res.exact
          ? ''
          : `No whole-cent price gives exactly ${formatUsd(res.totalCents)} at ${formatRate(r)} after rounding the tax, so this is the nearest price. The receipt probably used a different rate or taxed items separately.`,
      );
    }
  }

  function renderFind() {
    const p = toCents(parseNumber(fPrice.value));
    const t = toCents(parseNumber(fTotal.value));
    const found = rateFrom(p, t);
    if (!Number.isFinite(found)) {
      fRate.textContent = '—';
      fDetail.textContent = 'Enter a subtotal and a total that is the same or larger.';
      return;
    }
    fRate.textContent = formatRate(Math.round(found * 1000) / 1000);
    fDetail.textContent = `(${formatUsd(t)} − ${formatUsd(p)}) ÷ ${formatUsd(p)} × 100. Tax is rounded to the cent, so small receipts give an approximate rate.`;
  }

  state.addEventListener('change', () => {
    const s = findState(state.value);
    if (s) rate.value = String(s.rate);
    else {
      rate.focus();
      rate.select();
    }
    render();
  });
  // Typing a rate keeps the state selected (its note stays useful); describeState() flags the custom rate.
  rate.addEventListener('input', render);
  amount.addEventListener('input', render);
  modes.forEach((m) => m.addEventListener('change', render));
  fPrice.addEventListener('input', renderFind);
  fTotal.addEventListener('input', renderFind);
  render();
  renderFind();
</script>

<style>
  .tool > .hint {
    margin: -8px 0 0;
  }
  .st-card {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .st-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
  .st-find-out {
    margin: 0;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .st-find-out strong {
    font-size: 22px;
    font-variant-numeric: tabular-nums;
    margin-right: 6px;
  }
</style>
