---
import type { ToolProps } from '../../i18n/tool';
import { GRADES } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
---

<div class="tool" data-tool="gpa-calculator" data-locale={locale}>
  <div class="row between gpa-top">
    <div class="seg" role="radiogroup" aria-label="GPA type">
      <label><input type="radio" name="gpa-scale" value="unweighted" checked /><span>Unweighted (4.0)</span></label>
      <label><input type="radio" name="gpa-scale" value="weighted" /><span>Weighted (5.0)</span></label>
    </div>
    <label class="check"><input type="checkbox" id="gpa-aplus" /> Count A+ as 4.3</label>
  </div>

  <div class="gpa-head" aria-hidden="true">
    <span>Course</span><span>Grade</span><span>Credits</span><span>Type</span><span></span>
  </div>
  <div class="gpa-rows" id="gpa-rows"></div>
  <template id="gpa-row">
    <div class="gpa-row">
      <input class="gpa-name" type="text" autocomplete="off" placeholder="Course name (optional)" aria-label="Course name" />
      <select class="gpa-grade" aria-label="Letter grade">
        <option value="">Grade</option>
        {GRADES.map((g) => <option value={g}>{g}</option>)}
      </select>
      <input class="gpa-credits" type="text" inputmode="decimal" autocomplete="off" value="3" aria-label="Credits" />
      <select class="gpa-level" aria-label="Course type">
        <option value="regular">Regular</option>
        <option value="honors">Honors</option>
        <option value="ap">AP / IB</option>
      </select>
      <button class="btn ghost gpa-remove" type="button" aria-label="Remove course">×</button>
    </div>
  </template>
  <div class="row">
    <button class="btn" type="button" id="gpa-add">Add course</button>
    <button class="btn ghost" type="button" id="gpa-reset">Reset</button>
  </div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="gpa-main">—</div>
    <div class="result-label" id="gpa-main-label">Unweighted GPA for these courses</div>
  </div>
  <div class="stats">
    <div class="stat"><span class="stat-value" id="gpa-other">—</span><span class="stat-label" id="gpa-other-label">Weighted GPA</span></div>
    <div class="stat"><span class="stat-value" id="gpa-credits">—</span><span class="stat-label">Credits</span></div>
    <div class="stat"><span class="stat-value" id="gpa-qp">—</span><span class="stat-label">Grade points</span></div>
  </div>

  <section class="gpa-card" aria-labelledby="gpa-cum-title">
    <h2 class="gpa-card-title" id="gpa-cum-title">Cumulative GPA</h2>
    <p class="hint">Add your GPA and credits from previous terms to see your new overall GPA.</p>
    <div class="grid-2">
      <div class="field">
        <label for="gpa-prev">Current cumulative GPA</label>
        <input id="gpa-prev" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 3.25" />
      </div>
      <div class="field">
        <label for="gpa-prev-cr">Credits completed</label>
        <input id="gpa-prev-cr" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 45" />
      </div>
    </div>
    <p class="gpa-out"><strong id="gpa-cum">—</strong> <span class="hint" id="gpa-cum-detail"></span></p>
  </section>

  <section class="gpa-card" aria-labelledby="gpa-target-title">
    <h2 class="gpa-card-title" id="gpa-target-title">What GPA do I need?</h2>
    <p class="hint">Find the average you need in your remaining credits to reach a target cumulative GPA.</p>
    <div class="grid-2">
      <div class="field">
        <label for="gpa-t-cur">Current GPA</label>
        <input id="gpa-t-cur" type="text" inputmode="decimal" autocomplete="off" value="2.8" />
      </div>
      <div class="field">
        <label for="gpa-t-cr">Credits completed</label>
        <input id="gpa-t-cr" type="text" inputmode="decimal" autocomplete="off" value="60" />
      </div>
      <div class="field">
        <label for="gpa-t-goal">Target GPA</label>
        <input id="gpa-t-goal" type="text" inputmode="decimal" autocomplete="off" value="3.0" />
      </div>
      <div class="field">
        <label for="gpa-t-rem">Credits remaining</label>
        <input id="gpa-t-rem" type="text" inputmode="decimal" autocomplete="off" value="30" />
      </div>
    </div>
    <p class="gpa-out"><strong id="gpa-need">—</strong> <span class="hint" id="gpa-need-detail"></span></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatNumber, parseNumber } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import {
    computeGpa,
    cumulativeGpa,
    isGrade,
    requiredGpa,
    roundGpa,
    type Course,
    type CourseLevel,
  } from './logic';

  const root = $('[data-tool="gpa-calculator"]');
  const locale = (root.dataset.locale ?? 'en') as Locale;
  const rowsEl = $('#gpa-rows', root);
  const template = $<HTMLTemplateElement>('#gpa-row', root);
  const scales = $$<HTMLInputElement>('input[name="gpa-scale"]', root);
  const aPlus = $<HTMLInputElement>('#gpa-aplus', root);
  const main = $('#gpa-main', root);
  const mainLabel = $('#gpa-main-label', root);
  const other = $('#gpa-other', root);
  const otherLabel = $('#gpa-other-label', root);
  const creditsEl = $('#gpa-credits', root);
  const qpEl = $('#gpa-qp', root);
  const prev = $<HTMLInputElement>('#gpa-prev', root);
  const prevCr = $<HTMLInputElement>('#gpa-prev-cr', root);
  const cum = $('#gpa-cum', root);
  const cumDetail = $('#gpa-cum-detail', root);
  const tCur = $<HTMLInputElement>('#gpa-t-cur', root);
  const tCr = $<HTMLInputElement>('#gpa-t-cr', root);
  const tGoal = $<HTMLInputElement>('#gpa-t-goal', root);
  const tRem = $<HTMLInputElement>('#gpa-t-rem', root);
  const need = $('#gpa-need', root);
  const needDetail = $('#gpa-need-detail', root);

  interface SavedRow {
    name: string;
    grade: string;
    credits: string;
    level: CourseLevel;
  }
  interface Prefs {
    rows: SavedRow[];
    scale: 'unweighted' | 'weighted';
    aPlus: boolean;
    prev: string;
    prevCr: string;
    target: [string, string, string, string];
  }

  const DEFAULT_ROWS: SavedRow[] = [
    { name: 'English', grade: 'A', credits: '3', level: 'regular' },
    { name: 'Biology', grade: 'B+', credits: '4', level: 'honors' },
    { name: 'US History', grade: 'A-', credits: '3', level: 'ap' },
    { name: 'Algebra II', grade: 'B', credits: '3', level: 'regular' },
  ];

  const gpaText = (v: number) => (Number.isFinite(v) ? formatFixed(roundGpa(v), 2, locale) : '—');

  function addRow(data: Partial<SavedRow> = {}) {
    const frag = template.content.cloneNode(true) as DocumentFragment;
    const row = frag.querySelector<HTMLElement>('.gpa-row')!;
    $<HTMLInputElement>('.gpa-name', row).value = data.name ?? '';
    $<HTMLSelectElement>('.gpa-grade', row).value = data.grade && isGrade(data.grade) ? data.grade : '';
    $<HTMLInputElement>('.gpa-credits', row).value = data.credits ?? '3';
    $<HTMLSelectElement>('.gpa-level', row).value = data.level ?? 'regular';
    rowsEl.append(row);
    return row;
  }

  function readRows(): SavedRow[] {
    return $$<HTMLElement>('.gpa-row', rowsEl).map((row) => ({
      name: $<HTMLInputElement>('.gpa-name', row).value,
      grade: $<HTMLSelectElement>('.gpa-grade', row).value,
      credits: $<HTMLInputElement>('.gpa-credits', row).value,
      level: $<HTMLSelectElement>('.gpa-level', row).value as CourseLevel,
    }));
  }

  const saved = loadPref<Partial<Prefs>>('gpa-calculator', {});
  for (const r of saved.rows?.length ? saved.rows : DEFAULT_ROWS) addRow(r);
  scales.forEach((s) => (s.checked = s.value === (saved.scale ?? 'unweighted')));
  aPlus.checked = saved.aPlus === true;
  prev.value = saved.prev ?? '';
  prevCr.value = saved.prevCr ?? '';
  if (saved.target?.length === 4) [tCur.value, tCr.value, tGoal.value, tRem.value] = saved.target;

  function render() {
    const rows = readRows();
    const weighted = scales.find((s) => s.checked)?.value === 'weighted';
    const options = { aPlus43: aPlus.checked };
    savePref('gpa-calculator', {
      rows,
      scale: weighted ? 'weighted' : 'unweighted',
      aPlus: aPlus.checked,
      prev: prev.value,
      prevCr: prevCr.value,
      target: [tCur.value, tCr.value, tGoal.value, tRem.value],
    } satisfies Prefs);

    $$<HTMLElement>('.gpa-row', rowsEl).forEach((row, i) => {
      const credits = parseNumber(rows[i].credits);
      $<HTMLInputElement>('.gpa-credits', row).classList.toggle('is-invalid', rows[i].credits !== '' && !(credits > 0 && credits <= 100));
      $<HTMLSelectElement>('.gpa-level', row).classList.toggle('is-muted', !weighted);
    });

    const courses: Course[] = rows.map((r) => ({
      grade: isGrade(r.grade) ? r.grade : '',
      credits: parseNumber(r.credits),
      level: r.level,
    }));
    const res = computeGpa(courses, options);
    const termGpa = weighted ? res.weighted : res.unweighted;
    const termPoints = weighted ? res.weightedQualityPoints : res.qualityPoints;
    main.textContent = gpaText(termGpa);
    mainLabel.textContent = `${weighted ? 'Weighted' : 'Unweighted'} GPA for these courses${res.counted ? '' : ' (choose a grade for at least one course)'}`;
    other.textContent = gpaText(weighted ? res.unweighted : res.weighted);
    otherLabel.textContent = weighted ? 'Unweighted GPA' : 'Weighted GPA';
    creditsEl.textContent = res.credits ? formatNumber(res.credits, 2, locale) : '—';
    qpEl.textContent = res.credits ? formatNumber(termPoints, 2, locale) : '—';

    // Cumulative
    const pg = parseNumber(prev.value);
    const pc = parseNumber(prevCr.value);
    const max = (aPlus.checked ? 4.3 : 4) + (weighted ? 1 : 0);
    if (prev.value.trim() === '' && prevCr.value.trim() === '') {
      cum.textContent = '—';
      cumDetail.textContent = 'Enter your current GPA and credits.';
    } else if (!(pg >= 0 && pg <= max) || !(pc >= 0)) {
      cum.textContent = '—';
      cumDetail.textContent = `Enter a GPA from 0 to ${max} and the number of credits you have completed.`;
    } else {
      const c = cumulativeGpa(pg, pc, termPoints, res.credits);
      cum.textContent = gpaText(c);
      cumDetail.textContent = Number.isFinite(c)
        ? `New cumulative GPA over ${formatNumber(pc + res.credits, 2, locale)} credits: (${formatNumber(pg, 2, locale)} × ${formatNumber(pc, 2, locale)} + ${formatNumber(termPoints, 2, locale)}) ÷ ${formatNumber(pc + res.credits, 2, locale)}`
        : '';
    }

    // Target
    const t = requiredGpa(parseNumber(tCur.value), parseNumber(tCr.value), parseNumber(tGoal.value), parseNumber(tRem.value), max);
    if (!t) {
      need.textContent = '—';
      needDetail.textContent = `Enter GPAs from 0 to ${max} and more than 0 remaining credits.`;
    } else if (t.status === 'reached') {
      need.textContent = 'Already there';
      needDetail.textContent = 'You will stay at or above your target even with zero grade points in the remaining credits.';
    } else if (t.status === 'impossible') {
      need.textContent = gpaText(t.required);
      needDetail.textContent = `Not reachable on a ${max} scale in ${formatNumber(parseNumber(tRem.value), 2, locale)} credits. The best you can reach with straight A's is ${gpaText(t.bestPossible)}.`;
    } else {
      need.textContent = gpaText(t.required);
      needDetail.textContent = `Average GPA you need across the remaining ${formatNumber(parseNumber(tRem.value), 2, locale)} credits.`;
    }
  }

  rowsEl.addEventListener('input', render);
  rowsEl.addEventListener('change', render);
  rowsEl.addEventListener('click', (event) => {
    const button = (event.target as Element).closest('.gpa-remove');
    if (!button) return;
    const row = button.closest('.gpa-row');
    if ($$('.gpa-row', rowsEl).length > 1) row?.remove();
    else {
      row?.remove();
      addRow();
    }
    render();
  });
  $('#gpa-add', root).addEventListener('click', () => {
    const row = addRow();
    $<HTMLInputElement>('.gpa-name', row).focus();
    render();
  });
  $('#gpa-reset', root).addEventListener('click', () => {
    rowsEl.replaceChildren();
    for (let i = 0; i < 4; i++) addRow();
    render();
  });
  for (const el of [...scales, aPlus]) el.addEventListener('change', render);
  for (const el of [prev, prevCr, tCur, tCr, tGoal, tRem]) el.addEventListener('input', render);
  render();
</script>

<style>
  .gpa-top {
    gap: 10px 16px;
  }
  .gpa-rows {
    display: grid;
    gap: 10px;
  }
  .gpa-head,
  .gpa-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1fr) 40px;
    grid-template-areas:
      'name name name remove'
      'grade credits level level';
    gap: 8px;
    align-items: center;
  }
  .gpa-row {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .gpa-head {
    display: none;
  }
  .gpa-name {
    grid-area: name;
  }
  .gpa-grade {
    grid-area: grade;
  }
  .gpa-credits {
    grid-area: credits;
  }
  .gpa-level {
    grid-area: level;
  }
  .gpa-remove {
    grid-area: remove;
    min-height: 40px;
    padding: 0;
    font-size: 22px;
    line-height: 1;
  }
  @media (min-width: 640px) {
    .gpa-head,
    .gpa-row {
      grid-template-columns: minmax(0, 1fr) 96px 84px 120px 40px;
      grid-template-areas: 'name grade credits level remove';
    }
    .gpa-row {
      padding: 0;
      border: 0;
    }
    .gpa-head {
      display: grid;
      grid-template-areas: none;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: -8px;
    }
  }
  .is-invalid {
    border-color: var(--danger);
  }
  .is-muted {
    color: var(--muted);
  }
  .gpa-card {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .gpa-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
  .gpa-card .hint {
    margin: -6px 0 0;
  }
  .gpa-out {
    margin: 0;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .gpa-out strong {
    font-size: 22px;
    font-variant-numeric: tabular-nums;
    margin-right: 6px;
  }
</style>
