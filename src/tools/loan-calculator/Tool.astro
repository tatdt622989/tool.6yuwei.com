---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="loan-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="grid-2">
    <div class="field">
      <label for="ln-amount">{s.amount}</label>
      <input id="ln-amount" type="text" inputmode="decimal" autocomplete="off" value={s.defaults.amount} />
    </div>
    <div class="field">
      <label for="ln-months">{s.months}</label>
      <input id="ln-months" type="text" inputmode="numeric" autocomplete="off" value={s.defaults.months} />
      <span class="hint">{s.monthsHint}</span>
    </div>
  </div>

  {
    s.staged && (
      <div class="field">
        <span class="label">{s.staged.kind}</span>
        <div class="seg" role="radiogroup" aria-label={s.staged.kind}>
          <label><input type="radio" name="ln-kind" value="single" checked /><span>{s.staged.single}</span></label>
          <label><input type="radio" name="ln-kind" value="staged" /><span>{s.staged.staged}</span></label>
        </div>
      </div>
    )
  }

  <div class={s.staged ? 'grid-3' : 'grid-2'}>
    <div class="field">
      <label for="ln-rate1" id="ln-rate1-label">{s.rate1}</label>
      <input id="ln-rate1" type="text" inputmode="decimal" autocomplete="off" value={s.defaults.rate1} />
    </div>
    {
      s.staged && (
        <div class="field ln-staged">
          <label for="ln-stage1">{s.staged.stage1}</label>
          <input id="ln-stage1" type="text" inputmode="numeric" autocomplete="off" value="3" />
        </div>
      )
    }
    {
      s.staged ? (
        <div class="field ln-staged">
          <label for="ln-rate2">{s.staged.rate2}</label>
          <input id="ln-rate2" type="text" inputmode="decimal" autocomplete="off" value="4.68" />
        </div>
      ) : (
        <div class="field">
          <label for="ln-fees">{s.fees}</label>
          <input id="ln-fees" type="text" inputmode="numeric" autocomplete="off" value={s.defaults.fees} />
          <span class="hint">{s.feesHint}</span>
        </div>
      )
    }
  </div>

  {
    s.staged && (
      <div class="field">
        <label for="ln-fees">{s.fees}</label>
        <input id="ln-fees" type="text" inputmode="numeric" autocomplete="off" value={s.defaults.fees} />
        <span class="hint">{s.feesHint}</span>
      </div>
    )
  }

  <div class="notice error" id="ln-error" hidden></div>

  <div id="ln-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="ln-payment">—</div>
      <div class="result-label" id="ln-payment-label">{s.payment}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ln-apr">—</span><span class="stat-label">{s.apr}</span></div>
      <div class="stat"><span class="stat-value" id="ln-interest">—</span><span class="stat-label">{s.interest}</span></div>
      <div class="stat"><span class="stat-value" id="ln-cost">—</span><span class="stat-label">{s.cost}</span></div>
      <div class="stat"><span class="stat-value" id="ln-total">—</span><span class="stat-label">{s.total}</span></div>
    </div>

    <p class="hint" id="ln-stage-note"></p>

    <div class="field">
      <span class="label">{s.schedule}</span>
      <div class="table-wrap ln-table">
        <table class="table">
          <thead>
            <tr><th>{s.thMonth}</th><th class="num">{s.thRate}</th><th class="num">{s.thPayment}</th><th class="num">{s.thPrincipal}</th><th class="num">{s.thInterest}</th><th class="num">{s.thBalance}</th></tr>
          </thead>
          <tbody id="ln-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { calculateLoan, loanProblem, type LoanInput } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="loan-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  // Amounts are in the locale's currency, so each locale remembers its own inputs.
  const KEY = locale === 'zh-TW' ? 'loan-calculator' : `loan-calculator:${locale}`;
  const amountScale = s.amountScale || 1;
  const ids = ['amount', 'months', 'rate1', 'stage1', 'rate2', 'fees'] as const;
  type Id = (typeof ids)[number];
  const inputs = Object.fromEntries(
    ids.map((id) => [id, root.querySelector<HTMLInputElement>(`#ln-${id}`)]).filter(([, el]) => el),
  ) as Record<'amount' | 'months' | 'rate1' | 'fees', HTMLInputElement> & Partial<Record<'stage1' | 'rate2', HTMLInputElement>>;
  const present = ids.filter((id) => inputs[id]);
  const kinds = $$<HTMLInputElement>('input[name="ln-kind"]', root);
  const error = $('#ln-error', root);
  const output = $('#ln-output', root);
  const table = $('#ln-table', root);

  const prefs = loadPref<Partial<Record<Id | 'kind', string>>>(KEY, {});
  for (const id of present) if (prefs[id] !== undefined) inputs[id]!.value = prefs[id]!;
  if (prefs.kind && kinds.length) for (const k of kinds) k.checked = k.value === prefs.kind;

  const amount = (n: number) => (s.decimals ? formatFixed(n, s.decimals, locale) : formatInteger(n, locale));
  const money = (n: number) => t(s.money, { n: amount(n) });
  const num = (el: HTMLInputElement | undefined) => (!el || el.value.trim() === '' ? 0 : parseNumber(el.value));
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const kind = kinds.find((k) => k.checked)?.value ?? 'single';
    savePref(KEY, { ...Object.fromEntries(present.map((id) => [id, inputs[id]!.value])), ...(kinds.length ? { kind } : {}) });
    const staged = kind === 'staged' && s.staged !== undefined;
    for (const el of $$('.ln-staged', root)) el.hidden = !staged;
    set('#ln-rate1-label', staged ? s.staged!.rate1 : s.rate1);

    const input: LoanInput = {
      principal: parseNumber(inputs.amount.value) * amountScale,
      months: parseNumber(inputs.months.value),
      stages: staged
        ? [
            { ratePct: parseNumber(inputs.rate1.value), months: num(inputs.stage1) },
            { ratePct: parseNumber(inputs.rate2?.value ?? ''), months: 0 },
          ]
        : [{ ratePct: parseNumber(inputs.rate1.value), months: 0 }],
      fees: num(inputs.fees),
    };
    if (staged && (input.stages[0].months <= 0 || input.stages[0].months >= input.months)) return fail(s.staged!.stageError);
    const problem = loanProblem(input);
    const r = problem ? null : calculateLoan(input);
    if (!r) return fail(problem ? s.errors[problem] : s.fallback);
    error.hidden = true;
    output.hidden = false;

    const sp = r.stagePayments;
    set('#ln-payment', money(sp[0].payment));
    set(
      '#ln-payment-label',
      sp.length > 1 && s.staged ? t(s.staged.paymentLabel, { to: sp[0].toMonth }) : plural(locale, input.months, s.paymentLabel),
    );
    set(
      '#ln-stage-note',
      sp.length > 1 && s.staged
        ? t(s.staged.note, { from: sp[1].fromMonth, to: sp[1].toMonth, rate: sp[1].ratePct, money: money(sp[1].payment) })
        : '',
    );
    set('#ln-apr', `${formatNumber(r.aprPct, 2, locale)}%`);
    set('#ln-interest', money(r.totalInterest));
    set('#ln-cost', money(r.totalCost));
    set('#ln-total', money(r.totalPaid));

    table.replaceChildren(
      ...r.rows.map((row) => {
        const tr = document.createElement('tr');
        [t(s.period, { n: row.month }), `${row.ratePct}%`, amount(row.payment), amount(row.principal), amount(row.interest), amount(row.balance)].forEach(
          (text, i) => {
            const td = document.createElement('td');
            td.textContent = text;
            if (i > 0) td.className = 'num';
            tr.append(td);
          },
        );
        return tr;
      }),
    );
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #ln-output {
    display: grid;
    gap: 16px;
  }
  #ln-output[hidden],
  .ln-staged[hidden] {
    display: none;
  }
  .ln-table {
    max-height: 420px;
    overflow-y: auto;
  }
</style>
