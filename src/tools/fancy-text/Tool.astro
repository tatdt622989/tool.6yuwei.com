---
import { STYLES } from './logic';
const SAMPLE = 'Hello Instagram 2026';
---

<div class="tool" data-tool="fancy-text">
  <div class="field">
    <label for="ft-input">輸入英文或數字</label>
    <textarea id="ft-input" rows="3" spellcheck="false" placeholder="例如：your name、IG 帳號、Threads 簽名">{SAMPLE}</textarea>
    <span class="hint" id="ft-note">特殊字體只支援英文字母 A–Z、a–z 與數字，中文、日文與表情符號會保持原樣。</span>
  </div>

  <ul class="ft-list" id="ft-list">
    {
      STYLES.map((s) => (
        <li class="ft-item">
          <span class="ft-name">{s.name}</span>
          <div class="ft-out" id={`ft-${s.id}`} data-style={s.id}>
            {s.convert(SAMPLE)}
          </div>
          <button class="btn small" type="button" data-copy={`#ft-${s.id}`}>
            複製
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { STYLES, hasUnconvertible } from './logic';

  const root = $('[data-tool="fancy-text"]');
  const input = $<HTMLTextAreaElement>('#ft-input', root);
  const note = $('#ft-note', root);
  const outputs = $$<HTMLElement>('.ft-out', root);
  const byId = new Map(STYLES.map((s) => [s.id, s]));
  const fallback = 'Hello Instagram 2026';

  const save = debounce((text: string) => savePref('fancy-text', text), 400);

  function render() {
    const text = input.value || fallback;
    for (const out of outputs) {
      const style = byId.get(out.dataset.style ?? '');
      if (style) out.textContent = style.convert(text);
    }
    note.classList.toggle('ft-warn', hasUnconvertible(input.value));
    save(input.value);
  }

  const saved = loadPref('fancy-text', '');
  if (saved) input.value = saved;
  input.addEventListener('input', render);
  render();
</script>

<style>
  .ft-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ft-item {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .ft-item:hover {
    border-color: var(--border-strong);
  }
  .ft-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .ft-out {
    font-size: 20px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: all;
  }
  #ft-note.ft-warn {
    color: var(--warning);
  }
  @media (max-width: 560px) {
    .ft-item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 10px;
    }
    .ft-name {
      grid-column: 1 / -1;
    }
    .ft-out {
      font-size: 18px;
    }
  }
</style>
