---
import { pickStrings, type ToolProps } from '../../i18n/tool';
import type { CaseStyle } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);

const styles: { value: CaseStyle; label: string }[] = [
  { value: 'upper', label: 'UPPER CASE' },
  { value: 'lower', label: 'lower case' },
  { value: 'title', label: 'Title Case' },
  { value: 'sentence', label: 'Sentence case' },
  { value: 'toggle', label: 'tOGGLE cASE' },
  { value: 'camel', label: 'camelCase' },
  { value: 'pascal', label: 'PascalCase' },
  { value: 'snake', label: 'snake_case' },
  { value: 'kebab', label: 'kebab-case' },
  { value: 'constant', label: 'CONSTANT_CASE' },
];
---

<div class="tool" data-tool="case-converter">
  <div class="field">
    <label for="cc-input">{s.inputLabel}</label>
    <textarea id="cc-input" rows="7" placeholder={s.placeholder}></textarea>
  </div>

  <fieldset class="cc-styles">
    <legend class="label">{s.stylesLegend}</legend>
    {
      styles.map((style, i) => (
        <label class="cc-style">
          <input type="radio" name="cc-style" value={style.value} checked={i === 0} />
          <span class="cc-style-box">
            <span class="cc-style-name mono">{style.label}</span>
            <span class="cc-style-hint">{s.hints[style.value]}</span>
          </span>
        </label>
      ))
    }
  </fieldset>

  <div class="field">
    <label for="cc-output">{s.outputLabel}</label>
    <textarea id="cc-output" rows="7" readonly placeholder={s.outputPlaceholder}></textarea>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#cc-output">{s.copy}</button>
    <button class="btn" type="button" id="cc-apply">{s.apply}</button>
    <button class="btn ghost" type="button" id="cc-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { convertCase, isCaseStyle, type CaseStyle } from './logic';

  const root = $('[data-tool="case-converter"]');
  const input = $<HTMLTextAreaElement>('#cc-input', root);
  const output = $<HTMLTextAreaElement>('#cc-output', root);
  const radios = $$<HTMLInputElement>('input[name="cc-style"]', root);

  function current(): CaseStyle {
    const value = radios.find((r) => r.checked)?.value;
    return isCaseStyle(value) ? value : 'upper';
  }

  function render() {
    const style = current();
    savePref('case-converter', style);
    output.value = convertCase(input.value, style);
  }

  const saved = loadPref<string>('case-converter', 'upper');
  if (isCaseStyle(saved)) for (const r of radios) r.checked = r.value === saved;

  input.addEventListener('input', render);
  for (const r of radios) r.addEventListener('change', render);
  $('#cc-apply', root).addEventListener('click', () => {
    input.value = output.value;
    render();
  });
  $('#cc-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  .cc-styles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .cc-styles legend {
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  @media (min-width: 640px) {
    .cc-styles {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .cc-style {
    cursor: pointer;
    min-width: 0;
  }
  .cc-style input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .cc-style-box {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: border-color 0.15s, background 0.15s;
  }
  .cc-style:hover .cc-style-box {
    background: var(--surface-2);
  }
  .cc-style input:checked + .cc-style-box {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .cc-style input:focus-visible + .cc-style-box {
    box-shadow: var(--focus);
  }
  .cc-style-name {
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cc-style-hint {
    font-size: 13px;
    color: var(--muted);
  }
</style>
