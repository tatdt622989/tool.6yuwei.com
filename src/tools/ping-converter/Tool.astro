---
import { formatNumber } from '../../lib/format';
import { AREA_UNITS, convertArea } from './logic';

const quick = [5, 10, 15, 20, 25, 30, 35, 40, 50, 60].map((ping) => ({
  ping,
  sqm: formatNumber(convertArea(ping, 'ping', 'sqm'), 2),
  sqft: formatNumber(convertArea(ping, 'ping', 'sqft'), 1),
}));
---

<div class="tool" data-tool="ping-converter">
  <div class="grid-3">
    {
      AREA_UNITS.map((u) => (
        <div class="field">
          <label for={`pg-${u.id}`}>{u.label}</label>
          <input id={`pg-${u.id}`} data-unit={u.id} type="text" inputmode="decimal" autocomplete="off" />
        </div>
      ))
    }
  </div>
  <p class="hint">在任一欄輸入數字，其他單位會同步換算。1 坪 ≈ 3.3058 m²；1 甲 = 10 分 = 2,934 坪。</p>
  <div class="notice error" id="pg-error" hidden></div>

  <section class="pg-sub" aria-labelledby="pg-pub-title">
    <h2 class="pg-title" id="pg-pub-title">公設比計算：權狀坪數換算室內實坪</h2>
    <div class="grid-3">
      <div class="field">
        <label for="pg-title-ping">權狀坪數</label>
        <input id="pg-title-ping" type="text" inputmode="decimal" autocomplete="off" value="35" />
      </div>
      <div class="field">
        <label for="pg-ratio">公設比（%）</label>
        <input id="pg-ratio" type="text" inputmode="decimal" autocomplete="off" value="33" />
      </div>
      <div class="field">
        <label for="pg-price">總價（萬元，選填）</label>
        <input id="pg-price" type="text" inputmode="decimal" autocomplete="off" value="" placeholder="例如 1800" />
      </div>
    </div>
    <div class="stats">
      <div class="stat"><span class="stat-value" id="pg-private">—</span><span class="stat-label">扣除公設後坪數</span></div>
      <div class="stat"><span class="stat-value" id="pg-private-sqm">—</span><span class="stat-label">約合平方公尺</span></div>
      <div class="stat"><span class="stat-value" id="pg-public">—</span><span class="stat-label">公設坪數</span></div>
      <div class="stat" id="pg-unit-stat" hidden><span class="stat-value" id="pg-unit">—</span><span class="stat-label">權狀每坪單價</span></div>
      <div class="stat" id="pg-unit2-stat" hidden><span class="stat-value" id="pg-unit2">—</span><span class="stat-label">實際使用每坪單價</span></div>
    </div>
    <div class="notice error" id="pg-pub-error" hidden></div>
  </section>

  <details class="pg-quick">
    <summary>常見坪數對照表</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th class="num">坪</th><th class="num">平方公尺</th><th class="num">平方英尺</th></tr></thead>
        <tbody>
          {quick.map((r) => <tr><td class="num">{r.ping}</td><td class="num">{r.sqm}</td><td class="num">{r.sqft}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import { convertArea, convertAreaAll, displayDigits, splitPublicArea, type AreaUnit } from './logic';

  const root = $('[data-tool="ping-converter"]');
  const unitInputs = $$<HTMLInputElement>('input[data-unit]', root);
  const error = $('#pg-error', root);
  const titlePing = $<HTMLInputElement>('#pg-title-ping', root);
  const ratio = $<HTMLInputElement>('#pg-ratio', root);
  const price = $<HTMLInputElement>('#pg-price', root);
  const pubError = $('#pg-pub-error', root);

  const show = (v: number) => formatNumber(v, displayDigits(v));

  const prefs = loadPref('ping-converter', { unit: 'ping' as AreaUnit, value: '30', title: '35', ratio: '33', price: '' });
  titlePing.value = prefs.title;
  ratio.value = prefs.ratio;
  price.value = prefs.price;

  function saveAll(unit: AreaUnit, value: string) {
    prefs.unit = unit;
    prefs.value = value;
    prefs.title = titlePing.value;
    prefs.ratio = ratio.value;
    prefs.price = price.value;
    savePref('ping-converter', prefs);
  }

  function convertFrom(source: HTMLInputElement) {
    const unit = source.dataset.unit as AreaUnit;
    saveAll(unit, source.value);
    const value = parseNumber(source.value);
    if (source.value.trim() === '') {
      error.hidden = true;
      for (const input of unitInputs) if (input !== source) input.value = '';
      return;
    }
    if (Number.isNaN(value) || value < 0) {
      error.textContent = '請輸入 0 以上的數字。';
      error.hidden = false;
      return;
    }
    error.hidden = true;
    const all = convertAreaAll(value, unit);
    for (const input of unitInputs) {
      if (input !== source) input.value = show(all[input.dataset.unit as AreaUnit]);
    }
  }

  function renderPublic() {
    saveAll(prefs.unit, prefs.value);
    const priceValue = price.value.trim() === '' ? Number.NaN : parseNumber(price.value);
    const r = splitPublicArea(parseNumber(titlePing.value), parseNumber(ratio.value), priceValue);
    const ids = ['#pg-private', '#pg-private-sqm', '#pg-public', '#pg-unit', '#pg-unit2'];
    if (!r) {
      for (const id of ids) $(id, root).textContent = '—';
      pubError.textContent = '請輸入大於 0 的權狀坪數，公設比需介於 0 到 99%。';
      pubError.hidden = false;
      return;
    }
    pubError.hidden = true;
    $('#pg-private', root).textContent = `${formatNumber(r.privatePing, 2)} 坪`;
    $('#pg-private-sqm', root).textContent = `${formatNumber(convertArea(r.privatePing, 'ping', 'sqm'), 2)} m²`;
    $('#pg-public', root).textContent = `${formatNumber(r.publicPing, 2)} 坪`;
    const hasPrice = Number.isFinite(r.unitPrice);
    $('#pg-unit-stat', root).hidden = !hasPrice;
    $('#pg-unit2-stat', root).hidden = !hasPrice;
    $('#pg-unit', root).textContent = `${formatNumber(r.unitPrice, 2)} 萬`;
    $('#pg-unit2', root).textContent = `${formatNumber(r.privateUnitPrice, 2)} 萬`;
  }

  for (const input of unitInputs) input.addEventListener('input', () => convertFrom(input));
  [titlePing, ratio, price].forEach((el) => el.addEventListener('input', renderPublic));

  const start = unitInputs.find((i) => i.dataset.unit === prefs.unit) ?? unitInputs[0];
  start.value = prefs.value;
  convertFrom(start);
  renderPublic();
</script>

<style>
  .pg-sub {
    display: grid;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .pg-title {
    font-size: 16px;
    font-weight: 600;
  }
  .pg-sub .stat[hidden] {
    display: none;
  }
  .pg-quick summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .pg-quick .table-wrap {
    margin-top: 10px;
  }
</style>
