---
import type { ToolProps } from '../../i18n/tool';
import { TIP_PRESETS } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
---

<div class="tool" data-tool="tip-calculator" data-locale={locale}>
  <div class="grid-2">
    <div class="field">
      <label for="tip-bill">Bill amount ($)</label>
      <input id="tip-bill" type="text" inputmode="decimal" autocomplete="off" value="80.00" />
    </div>
    <div class="field">
      <label for="tip-people">Split between</label>
      <div class="tip-stepper">
        <button class="btn" type="button" data-step="-1" aria-label="One person fewer">−</button>
        <input id="tip-people" type="text" inputmode="numeric" autocomplete="off" value="1" aria-describedby="tip-people-unit" />
        <button class="btn" type="button" data-step="1" aria-label="One person more">+</button>
        <span class="muted" id="tip-people-unit">person</span>
      </div>
    </div>
  </div>

  <div class="field">
    <span class="label" id="tip-pct-label">Tip</span>
    <div class="tip-pct-row">
      <div class="seg" role="radiogroup" aria-labelledby="tip-pct-label">
        {
          TIP_PRESETS.map((p) => (
            <label>
              <input type="radio" name="tip-pct" value={String(p)} checked={p === 20} />
              <span>{p}%</span>
            </label>
          ))
        }
        <label>
          <input type="radio" name="tip-pct" value="custom" />
          <span>Custom</span>
        </label>
      </div>
      <div class="tip-custom" id="tip-custom-wrap" hidden>
        <input id="tip-custom" type="text" inputmode="decimal" autocomplete="off" value="10" aria-label="Custom tip percentage" />
        <span>%</span>
      </div>
    </div>
  </div>

  <div class="field">
    <span class="label" id="tip-round-label">Round up to whole dollars</span>
    <div class="seg" role="radiogroup" aria-labelledby="tip-round-label">
      <label><input type="radio" name="tip-round" value="none" checked /><span>No</span></label>
      <label><input type="radio" name="tip-round" value="perPerson" /><span>Each person</span></label>
      <label><input type="radio" name="tip-round" value="total" /><span>Total</span></label>
    </div>
  </div>

  <div class="tip-tax">
    <label class="check"><input type="checkbox" id="tip-pretax" /> Tip on the pre-tax amount</label>
    <div class="field" id="tip-tax-wrap" hidden>
      <label for="tip-tax">Sales tax on the bill ($)</label>
      <input id="tip-tax" type="text" inputmode="decimal" autocomplete="off" value="6.40" />
    </div>
  </div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="tip-main">—</div>
    <div class="result-label" id="tip-main-label">Total to pay</div>
    <p class="tip-uneven" id="tip-uneven" hidden></p>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="tip-tip">—</span><span class="stat-label">Tip</span></div>
    <div class="stat"><span class="stat-value" id="tip-total">—</span><span class="stat-label">Total with tip</span></div>
    <div class="stat" id="tip-pp-stat"><span class="stat-value" id="tip-tip-pp">—</span><span class="stat-label">Tip per person</span></div>
    <div class="stat"><span class="stat-value" id="tip-eff">—</span><span class="stat-label" id="tip-eff-label">Tip rate</span></div>
  </div>

  <div class="notice error" id="tip-error" role="alert" hidden></div>

  <div class="table-wrap">
    <table class="table" aria-describedby="tip-table-caption">
      <thead>
        <tr>
          <th scope="col">Tip</th>
          <th scope="col" class="num">Tip amount</th>
          <th scope="col" class="num">Total</th>
          <th scope="col" class="num" id="tip-col-pp">Per person</th>
        </tr>
      </thead>
      <tbody id="tip-rows"></tbody>
    </table>
  </div>
  <p class="hint" id="tip-table-caption">Quick comparison of common tip rates for this bill, before any rounding.</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatNumber, parseNumber } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import { calculateTip, formatUsd, MAX_PEOPLE, tipTable, toCents, validateTip, type RoundMode } from './logic';

  const root = $('[data-tool="tip-calculator"]');
  const locale = (root.dataset.locale ?? 'en') as Locale;
  const bill = $<HTMLInputElement>('#tip-bill', root);
  const people = $<HTMLInputElement>('#tip-people', root);
  const peopleUnit = $('#tip-people-unit', root);
  const custom = $<HTMLInputElement>('#tip-custom', root);
  const customWrap = $('#tip-custom-wrap', root);
  const pretax = $<HTMLInputElement>('#tip-pretax', root);
  const tax = $<HTMLInputElement>('#tip-tax', root);
  const taxWrap = $('#tip-tax-wrap', root);
  const pctRadios = $$<HTMLInputElement>('input[name="tip-pct"]', root);
  const roundRadios = $$<HTMLInputElement>('input[name="tip-round"]', root);
  const main = $('#tip-main', root);
  const mainLabel = $('#tip-main-label', root);
  const uneven = $('#tip-uneven', root);
  const tipEl = $('#tip-tip', root);
  const totalEl = $('#tip-total', root);
  const tipPpEl = $('#tip-tip-pp', root);
  const ppStat = $('#tip-pp-stat', root);
  const effEl = $('#tip-eff', root);
  const effLabel = $('#tip-eff-label', root);
  const errorEl = $('#tip-error', root);
  const rows = $('#tip-rows', root);
  const ppCol = $('#tip-col-pp', root);

  interface Prefs {
    bill: string;
    people: string;
    pct: string;
    custom: string;
    round: RoundMode;
    pretax: boolean;
    tax: string;
  }
  const saved = loadPref<Partial<Prefs>>('tip-calculator', {});
  if (saved.bill) bill.value = saved.bill;
  if (saved.people) people.value = saved.people;
  if (saved.custom) custom.value = saved.custom;
  if (saved.tax) tax.value = saved.tax;
  pretax.checked = saved.pretax === true;
  pctRadios.forEach((r) => (r.checked = r.value === (saved.pct ?? '20')));
  if (!pctRadios.some((r) => r.checked)) pctRadios[2].checked = true;
  roundRadios.forEach((r) => (r.checked = r.value === (saved.round ?? 'none')));
  if (!roundRadios.some((r) => r.checked)) roundRadios[0].checked = true;

  const checked = (list: HTMLInputElement[]) => list.find((r) => r.checked)?.value ?? '';
  const pct = (v: number) => `${formatNumber(v, 2, locale)}%`;

  const ERRORS = {
    bill: 'Enter the bill amount, for example 64.50.',
    tip: 'Enter a tip percentage between 0 and 100.',
    people: `Enter a whole number of people from 1 to ${MAX_PEOPLE}.`,
    tax: 'The tax must be zero or more and less than the bill.',
  } as const;

  function clear(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
    for (const el of [main, tipEl, totalEl, tipPpEl, effEl]) el.textContent = '—';
    uneven.hidden = true;
    rows.replaceChildren();
  }

  function render() {
    const pctValue = checked(pctRadios);
    const round = checked(roundRadios) as RoundMode;
    customWrap.hidden = pctValue !== 'custom';
    taxWrap.hidden = !pretax.checked;
    savePref('tip-calculator', {
      bill: bill.value,
      people: people.value,
      pct: pctValue,
      custom: custom.value,
      round,
      pretax: pretax.checked,
      tax: tax.value,
    } satisfies Prefs);

    const n = parseNumber(people.value);
    const input = {
      billCents: toCents(parseNumber(bill.value)),
      tipPercent: pctValue === 'custom' ? parseNumber(custom.value) : Number(pctValue),
      people: n,
      round,
      taxCents: pretax.checked ? toCents(parseNumber(tax.value) || 0) : 0,
      tipOnPreTax: pretax.checked,
    };
    peopleUnit.textContent = n === 1 ? 'person' : 'people';
    const split = Number.isInteger(n) && n > 1;
    ppStat.hidden = !split;
    ppCol.hidden = !split;

    const err = validateTip(input);
    const r = err ? null : calculateTip(input);
    if (err || !r) return clear(ERRORS[err ?? 'bill']);
    errorEl.hidden = true;

    main.textContent = formatUsd(split ? r.perPersonCents : r.totalCents);
    mainLabel.textContent = split ? `Each person pays (${n} people)` : 'Total to pay';
    if (split && r.unevenCount > 0) {
      const others = n - r.unevenCount;
      uneven.textContent = `The total doesn't split evenly to the cent: ${r.unevenCount} ${r.unevenCount === 1 ? 'person pays' : 'people pay'} ${formatUsd(r.perPersonCents)} and ${others} ${others === 1 ? 'pays' : 'pay'} ${formatUsd(r.perPersonCents - 1)}.`;
      uneven.hidden = false;
    } else uneven.hidden = true;

    tipEl.textContent = formatUsd(r.tipCents);
    totalEl.textContent = formatUsd(r.totalCents);
    tipPpEl.textContent = formatUsd(r.tipPerPersonCents);
    effEl.textContent = pct(r.effectivePercent);
    effLabel.textContent =
      r.roundingCents > 0
        ? `Actual tip rate (rounding added ${formatUsd(r.roundingCents)})`
        : input.tipOnPreTax
          ? `Tip rate on ${formatUsd(r.baseCents)} before tax`
          : 'Tip rate';

    rows.replaceChildren(
      ...tipTable(input).map((row) => {
        const tr = document.createElement('tr');
        const cells = [`${row.percent}%`, formatUsd(row.tipCents), formatUsd(row.totalCents), formatUsd(row.perPersonCents)];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i > 0) td.className = 'num';
          if (i === 3) td.hidden = !split;
          tr.append(td);
        });
        if (pctValue === String(row.percent)) tr.className = 'is-current';
        return tr;
      }),
    );
  }

  for (const button of $$<HTMLButtonElement>('[data-step]', root)) {
    button.addEventListener('click', () => {
      const current = parseNumber(people.value);
      const next = (Number.isInteger(current) ? current : 1) + Number(button.dataset.step);
      people.value = String(Math.min(MAX_PEOPLE, Math.max(1, next)));
      render();
    });
  }
  for (const input of [bill, people, custom, tax]) input.addEventListener('input', render);
  for (const input of [...pctRadios, ...roundRadios, pretax]) input.addEventListener('change', render);
  pctRadios.forEach((r) =>
    r.addEventListener('change', () => {
      if (r.value === 'custom' && r.checked) {
        customWrap.hidden = false;
        custom.focus();
        custom.select();
      }
    }),
  );
  render();
</script>

<style>
  .tip-stepper {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tip-stepper input {
    width: 4.5em;
    flex: none;
    text-align: center;
  }
  .tip-stepper .btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 20px;
  }
  .tip-pct-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .tip-pct-row .seg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    text-align: center;
  }
  @media (min-width: 520px) {
    .tip-pct-row .seg {
      display: inline-flex;
    }
  }
  .tip-custom {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tip-custom input {
    width: 6em;
  }
  .tip-tax {
    display: grid;
    gap: 12px;
  }
  .tip-tax .field {
    max-width: 320px;
  }
  .tip-uneven {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--text-2);
  }
  #tip-rows :global(.is-current td) {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
