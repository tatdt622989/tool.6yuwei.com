---
// Shared UI of the yearly 行事曆 tools. Everything is rendered at build time so the whole calendar is in
// the HTML; the script only adds today's position (past rows, today's cell, countdown).
import { toDayNumber, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
import { HolidayCalendar, iso, type CalendarData } from './calendar';

interface Props {
  slug: string;
  data: CalendarData;
  /** Year-specific line under the headline, e.g. 「3 天以上連假共 9 個，春節連休 9 天，全年沒有補班。」 */
  summary: string;
  /** Year-specific source / scope note at the bottom. */
  notice: string;
}

const { slug, data, summary, notice } = Astro.props;
const cal = new HolidayCalendar(data);
const year = data.year;
const md = (d: YMD) => (d.y === year ? `${d.m}/${d.d}` : `${d.y}/${d.m}/${d.d}`);
const wd = (d: YMD) => WEEKDAY_LABEL[weekdayOf(d)];
const pad = (n: number) => String(n).padStart(2, '0');
const breaks = cal.longWeekends();
const plans = cal.bridgePlans();
const months = Array.from({ length: 12 }, (_, i) => {
  const cells = cal.monthGrid(i + 1);
  return {
    month: i + 1,
    cells,
    stats: cal.monthStats(i + 1),
    holidays: cells.flatMap((c) => (c?.holiday ? [{ d: c.d, name: c.holiday.name, kind: c.holiday.kind }] : [])),
  };
});
const leaveText = (leave: YMD[]) => {
  // Group consecutive leave days: 「2/1–2/3、2/11–2/12」.
  const runs: YMD[][] = [];
  for (const d of leave) {
    const last = runs.at(-1);
    if (last && toDayNumber(d) === toDayNumber(last[last.length - 1]) + 1) last.push(d);
    else runs.push([d]);
  }
  return runs.map((r) => (r.length === 1 ? md(r[0]) : `${md(r[0])}–${md(r[r.length - 1])}`)).join('、');
};
---

<div class="tool" data-tool={slug} data-holiday-calendar={JSON.stringify(data)}>
  <div class="result" aria-live="polite">
    <div class="result-value" id="hd-main">{year} 年放假 {data.totalDaysOff} 天</div>
    <div class="result-label">{summary}</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="hd-next">—</span><span class="stat-label" id="hd-next-label">下一個國定假日</span></div>
    <div class="stat"><span class="stat-value" id="hd-break">—</span><span class="stat-label" id="hd-break-label">下一個連假</span></div>
    <div class="stat"><span class="stat-value" id="hd-left">—</span><span class="stat-label">{year} 年剩下的放假日（含週末）</span></div>
    <div class="stat"><span class="stat-value">{data.totalDaysOff} 天</span><span class="stat-label">全年放假日（含週末，依人事行政總處）</span></div>
  </div>

  <div class="field">
    <span class="label">{year} 連假一覽（3 天以上）</span>
    <div class="table-wrap">
      <table class="table hd-table">
        <thead>
          <tr><th>連假</th><th>日期</th><th class="num">天數</th></tr>
        </thead>
        <tbody>
          {
            breaks.map((b) => (
              <tr data-end={iso(b.end)}>
                <td>{b.label}</td>
                <td>
                  {md(b.start)}（{wd(b.start)}）至 {md(b.end)}（{wd(b.end)}）
                </td>
                <td class="num">{b.days} 天</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="field">
    <span class="label">{year} 行事曆（民國 {year - 1911} 年）</span>
    <div class="hd-legend" aria-hidden="true">
      <span><i class="hd-key hd-key-holiday"></i>國定假日</span>
      <span><i class="hd-key hd-key-comp"></i>補假</span>
      <span><i class="hd-key hd-key-weekend"></i>週末</span>
      {data.makeupWorkdays.length > 0 && <span><i class="hd-key hd-key-work"></i>補班</span>}
      <span><i class="hd-key hd-key-today"></i>今天</span>
    </div>
    <div class="hd-months">
      {
        months.map((m) => (
          <section class="hd-month" aria-label={`${year} 年 ${m.month} 月`}>
            <h3 class="hd-month-title">
              {m.month} 月<span class="muted">放假 {m.stats.off} 天・上班 {m.stats.work} 天</span>
            </h3>
            <table class="hd-cal">
              <thead>
                <tr>
                  {WEEKDAY_LABEL.map((w) => (
                    <th scope="col">{w}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {Array.from({ length: Math.ceil(m.cells.length / 7) }, (_, row) => (
                  <tr>
                    {Array.from({ length: 7 }, (_, col) => {
                      const c = m.cells[row * 7 + col];
                      if (!c) return <td />;
                      const date = `${year}-${pad(m.month)}-${pad(c.d)}`;
                      const work = data.makeupWorkdays.includes(date);
                      const cls = c.holiday
                        ? c.holiday.kind === 'holiday'
                          ? 'is-holiday'
                          : 'is-comp'
                        : work
                          ? 'is-work'
                          : c.off
                            ? 'is-weekend'
                            : '';
                      return (
                        <td class={cls} data-date={date} title={c.holiday?.name ?? (work ? '補行上班' : undefined)}>
                          {c.d}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
            {m.holidays.length > 0 && (
              <ul class="hd-month-list">
                {m.holidays.map((h) => (
                  <li class={h.kind === 'compensatory' ? 'is-comp' : 'is-holiday'}>
                    <span class="hd-date">
                      {m.month}/{h.d}
                    </span>
                    {h.name}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </div>

  <div class="field">
    <span class="label">{year} 請假攻略（請 1–5 天換長假）</span>
    <div class="table-wrap">
      <table class="table hd-table">
        <thead>
          <tr><th>搭配假期</th><th>請假日</th><th>連休期間</th><th class="num">連休</th></tr>
        </thead>
        <tbody>
          {
            plans.map((p) => (
              <tr data-end={iso(p.leave[0])}>
                <td>
                  {p.label}
                  {p.bothSides && <span class="muted">（前後都請）</span>}
                </td>
                <td>
                  {leaveText(p.leave)}（{p.leave.length} 天）
                </td>
                <td>
                  {md(p.start)}–{md(p.end)}
                </td>
                <td class="num">{p.days} 天</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">已經過去的連假與請假攻略會以淡色顯示。請假日以政府行政機關辦公日曆為準，民間公司請依公司行事曆確認。</span>
  </div>

  <p class="notice">{notice}</p>
</div>

<script>
  import { $, $$ } from '../../lib/client';
  import { toDayNumber, toISODate, type YMD } from '../date-diff/logic';
  import { HolidayCalendar, parseIso, type CalendarData } from './calendar';

  const now = new Date();
  const today: YMD = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  const t = toDayNumber(today);
  const md = (d: YMD) => `${d.y !== today.y ? `${d.y}/` : ''}${d.m}/${d.d}`;

  for (const root of $$<HTMLElement>('[data-holiday-calendar]')) {
    const cal = new HolidayCalendar(JSON.parse(root.dataset.holidayCalendar ?? '{}') as CalendarData);
    const set = (id: string, text: string) => ($(id, root).textContent = text);

    for (const tr of $$<HTMLElement>('tr[data-end]', root)) {
      tr.classList.toggle('is-past', toDayNumber(parseIso(tr.dataset.end ?? '')) < t);
    }
    root.querySelector(`[data-date="${toISODate(today)}"]`)?.classList.add('is-today');

    const next = cal.nextHoliday(today);
    if (next) {
      set('#hd-next', next.daysUntil === 0 ? '就是今天' : `${next.daysUntil} 天後`);
      set('#hd-next-label', `下一個國定假日：${next.holiday.name}（${md(parseIso(next.holiday.date))}）`);
      set('#hd-main', next.daysUntil === 0 ? `今天是${next.holiday.name}` : `距離${next.holiday.name}還有 ${next.daysUntil} 天`);
    } else {
      set('#hd-next', '—');
      set('#hd-next-label', `${cal.year} 年的國定假日已全部結束`);
    }

    const brk = cal.nextLongWeekend(today);
    if (brk) {
      set('#hd-break', brk.ongoing ? '連假中' : `${brk.daysUntil} 天後`);
      set('#hd-break-label', `下一個連假：${brk.block.label} ${md(brk.block.start)}–${md(brk.block.end)}（${brk.block.days} 天）`);
    } else {
      set('#hd-break', '—');
      set('#hd-break-label', `${cal.year} 年的連假已全部結束`);
    }

    set('#hd-left', `${cal.daysOffLeft(today)} 天`);
  }
</script>

<style>
  .hd-table :global(tr.is-past) td {
    color: var(--muted);
  }
  .hd-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--text-2);
  }
  .hd-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hd-key {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .hd-key-holiday {
    background: color-mix(in oklab, var(--danger) 16%, var(--surface));
    border-color: color-mix(in oklab, var(--danger) 40%, transparent);
  }
  .hd-key-comp {
    background: color-mix(in oklab, var(--warning) 18%, var(--surface));
    border-color: color-mix(in oklab, var(--warning) 45%, transparent);
  }
  .hd-key-weekend {
    background: var(--surface-2);
  }
  .hd-key-work {
    background: var(--surface);
    border: 1px dashed var(--text-2);
  }
  .hd-key-today {
    background: var(--surface);
    border: 2px solid var(--accent);
  }
  .hd-months {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .hd-month {
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    min-width: 0;
  }
  .hd-month-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 16px;
  }
  .hd-month-title .muted {
    font-size: 12px;
    font-weight: 400;
  }
  .hd-cal {
    width: 100%;
    border-collapse: separate;
    border-spacing: 2px;
    table-layout: fixed;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .hd-cal th {
    font-weight: 600;
    font-size: 12px;
    color: var(--muted);
    padding: 2px 0;
  }
  .hd-cal td {
    text-align: center;
    padding: 5px 0;
    border-radius: 6px;
  }
  .hd-cal .is-weekend {
    background: var(--surface-2);
    color: var(--text-2);
  }
  .hd-cal .is-holiday {
    background: color-mix(in oklab, var(--danger) 16%, var(--surface));
    color: var(--danger);
    font-weight: 700;
  }
  .hd-cal .is-comp {
    background: color-mix(in oklab, var(--warning) 18%, var(--surface));
    color: var(--warning);
    font-weight: 700;
  }
  .hd-cal .is-work {
    box-shadow: inset 0 0 0 1px var(--text-2);
    font-weight: 700;
  }
  .hd-cal :global(.is-today) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .hd-month-list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
    font-size: 13px;
    color: var(--text-2);
  }
  .hd-month-list .hd-date {
    display: inline-block;
    min-width: 3.2em;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .hd-month-list .is-holiday .hd-date {
    color: var(--danger);
  }
  .hd-month-list .is-comp .hd-date {
    color: var(--warning);
  }
</style>
