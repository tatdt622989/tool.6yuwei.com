---
import { plural } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { presetsFor } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const presets = presetsFor(locale);
---

<div class="tool" data-tool="spin-wheel" {...i18nAttrs(locale, s.client)}>
  <div class="sw-layout">
    <div class="sw-stage" id="sw-stage">
      <p class="sw-title" id="sw-title-view">{presets[0].name}</p>
      <div class="sw-wheel" id="sw-wheel">
        <canvas id="sw-canvas" aria-hidden="true"></canvas>
        <svg class="sw-pointer" id="sw-pointer" viewBox="0 0 40 48" aria-hidden="true">
          <path d="M20 46 4 10a16 16 0 1 1 32 0z" />
          <circle cx="20" cy="15" r="5" />
        </svg>
        <button class="sw-hub" type="button" id="sw-spin" aria-describedby="sw-count">
          <span id="sw-spin-label">{s.client.spin}</span>
        </button>
      </div>
      <div class="sw-result" id="sw-result" aria-live="polite" hidden>
        <span class="sw-result-label" id="sw-result-n">{s.resultLabel}</span>
        <span class="sw-result-value" id="sw-result-value"></span>
        <div class="row sw-result-actions">
          <button class="btn small" type="button" id="sw-again">{s.again}</button>
          <button class="btn small ghost" type="button" id="sw-remove-now">{s.removeNow}</button>
        </div>
      </div>
      <button class="btn small ghost sw-fs" type="button" id="sw-fs" title={s.fsIconOnly ? s.client.fullscreen : undefined} hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        <span id="sw-fs-label" class={s.fsIconOnly ? 'visually-hidden' : undefined}>{s.client.fullscreen}</span>
      </button>
    </div>

    <div class="sw-panel">
      <div class="field">
        <span class="label">{s.presetsLabel}</span>
        <div class="sw-presets" id="sw-presets">
          {presets.map((p) => <button class="btn small" type="button" data-preset={p.id}>{p.name}</button>)}
        </div>
      </div>

      <div class="field">
        <label for="sw-title">{s.titleLabel}</label>
        <input id="sw-title" type="text" maxlength="30" placeholder={s.titlePlaceholder} />
      </div>

      <div class="field">
        <label for="sw-input">{s.optionsLabel}</label>
        <textarea id="sw-input" rows="8" spellcheck="false"></textarea>
        <div class="row between">
          <span class="hint" id="sw-count">{plural(locale, 0, s.client.count)}</span>
          <div class="row">
            <button class="btn small ghost" type="button" id="sw-shuffle">{s.shuffle}</button>
            <button class="btn small ghost" type="button" id="sw-clear">{s.clear}</button>
          </div>
        </div>
      </div>

      <div class="field">
        <span class="label">{s.speedLabel}</span>
        <div class="seg" role="radiogroup" aria-label={s.speedLabel}>
          <label><input type="radio" name="sw-speed" value="fast" /><span>{s.speedFast}</span></label>
          <label><input type="radio" name="sw-speed" value="normal" checked /><span>{s.speedNormal}</span></label>
          <label><input type="radio" name="sw-speed" value="slow" /><span>{s.speedSlow}</span></label>
        </div>
      </div>

      <div class="sw-checks">
        <label class="check"><input id="sw-autoremove" type="checkbox" /> {s.autoRemove}</label>
        <label class="check"><input id="sw-sound" type="checkbox" /> {s.sound}</label>
      </div>

      <details class="sw-odds">
        <summary>{s.oddsSummary}</summary>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>{s.thOption}</th><th class="num">{s.thWeight}</th><th class="num">{s.thChance}</th></tr></thead>
            <tbody id="sw-odds"></tbody>
          </table>
        </div>
      </details>
    </div>
  </div>

  <div class="notice error" id="sw-error" hidden></div>

  <section class="sw-history" aria-label={s.history}>
    <div class="row between">
      <h3 class="sw-h">{s.history}</h3>
      <div class="row">
        <button class="btn small ghost" type="button" data-copy="#sw-history">{s.copyHistory}</button>
        <button class="btn small ghost" type="button" id="sw-history-clear">{s.clearHistory}</button>
      </div>
    </div>
    <ol class="sw-history-list" id="sw-history" reversed></ol>
    <p class="hint" id="sw-history-empty">{s.historyEmpty}</p>
  </section>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import { formatNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import type { Strings } from './i18n';
  import {
    fitLabel,
    hasCustomWeights,
    parseOptions,
    pickWeighted,
    presetsFor,
    probabilities,
    randomFloat,
    removeOptionLine,
    rotatesInVertical,
    rotationAt,
    segmentAtPointer,
    segmentsOf,
    shuffleLines,
    sliceColor,
    targetRotation,
    type ColorSpace,
    type Segment,
    type WheelOption,
  } from './logic';

  type Speed = 'fast' | 'normal' | 'slow';
  interface Prefs {
    title: string;
    text: string;
    speed: Speed;
    autoRemove: boolean;
    sound: boolean;
  }
  interface HistoryItem {
    label: string;
    time: string;
  }

  const SPEEDS: Record<Speed, { ms: number; turns: number }> = {
    fast: { ms: 3000, turns: 4 },
    normal: { ms: 5200, turns: 6 },
    slow: { ms: 8000, turns: 9 },
  };
  const HISTORY_MAX = 50;

  const root = $('[data-tool="spin-wheel"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const PRESETS = presetsFor(locale);
  // zh-TW keeps its original storage keys; other locales get their own so their wheels don't mix.
  const PREF_KEY = locale === 'zh-TW' ? 'spin-wheel' : `spin-wheel:${locale}`;
  const lunch = PRESETS[0];
  const defaults: Prefs = { title: lunch.name, text: lunch.options.join('\n'), speed: 'normal', autoRemove: false, sound: false };
  const stage = $('#sw-stage', root);
  const wheel = $('#sw-wheel', root);
  const canvas = $<HTMLCanvasElement>('#sw-canvas', root);
  const pointer = $('#sw-pointer', root);
  const spinBtn = $<HTMLButtonElement>('#sw-spin', root);
  const spinLabel = $('#sw-spin-label', root);
  const titleInput = $<HTMLInputElement>('#sw-title', root);
  const titleView = $('#sw-title-view', root);
  const input = $<HTMLTextAreaElement>('#sw-input', root);
  const countHint = $('#sw-count', root);
  const autoRemove = $<HTMLInputElement>('#sw-autoremove', root);
  const sound = $<HTMLInputElement>('#sw-sound', root);
  const oddsBody = $('#sw-odds', root);
  const error = $('#sw-error', root);
  const resultBox = $('#sw-result', root);
  const resultN = $('#sw-result-n', root);
  const resultValue = $('#sw-result-value', root);
  const historyList = $('#sw-history', root);
  const historyEmpty = $('#sw-history-empty', root);
  const fsBtn = $<HTMLButtonElement>('#sw-fs', root);
  const fsLabel = $('#sw-fs-label', root);
  const presetButtons = $$<HTMLButtonElement>('[data-preset]', root);
  const lockable = [input, titleInput, ...presetButtons, $<HTMLButtonElement>('#sw-shuffle', root), $<HTMLButtonElement>('#sw-clear', root)];

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const colorSpace: ColorSpace = window.CSS?.supports?.('color', 'oklch(0.5 0.1 100)') ? 'oklch' : 'hsl';
  const ctx = canvas.getContext('2d');

  let options: WheelOption[] = [];
  let segments: Segment[] = [];
  let rotation = 0;
  let spinning = false;
  let highlight = -1;
  let lastWinner: { option: WheelOption; raw: string } | null = null;
  let history: HistoryItem[] = loadPref<HistoryItem[]>(`${PREF_KEY}:history`, []);
  let audio: AudioContext | null = null;

  // ---------- Prefs ----------
  const speedOf = () => ($<HTMLInputElement>('input[name="sw-speed"]:checked', root).value as Speed) ?? 'normal';

  function save() {
    savePref(PREF_KEY, {
      title: titleInput.value,
      text: input.value,
      speed: speedOf(),
      autoRemove: autoRemove.checked,
      sound: sound.checked,
    } satisfies Prefs);
  }

  function applyPrefs(p: Prefs) {
    titleInput.value = p.title ?? '';
    input.value = p.text ?? '';
    autoRemove.checked = Boolean(p.autoRemove);
    sound.checked = Boolean(p.sound);
    const radio = root.querySelector<HTMLInputElement>(`input[name="sw-speed"][value="${p.speed}"]`);
    if (radio) radio.checked = true;
  }

  // ---------- Drawing ----------
  function cssVar(name: string): string {
    return getComputedStyle(root).getPropertyValue(name).trim();
  }

  function draw() {
    if (!ctx) return;
    const size = Math.round(wheel.clientWidth);
    if (size === 0) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, size, size);

    const c = size / 2;
    const rim = Math.max(8, size * 0.03);
    const radius = c - rim;
    const surface = cssVar('--surface');
    const theme = 'light'; // the site is light-only
    const font = getComputedStyle(root).fontFamily;

    // Rim
    ctx.beginPath();
    ctx.arc(c, c, c - 1, 0, Math.PI * 2);
    ctx.fillStyle = cssVar('--text');
    ctx.fill();

    if (segments.length === 0) {
      ctx.beginPath();
      ctx.arc(c, c, radius, 0, Math.PI * 2);
      ctx.fillStyle = cssVar('--surface-2');
      ctx.fill();
      return;
    }

    const n = segments.length;
    const labelOuter = radius - Math.max(10, size * 0.035);
    const labelInner = size * 0.13;
    segments.forEach((seg, i) => {
      const a0 = (seg.start * Math.PI) / 180 - Math.PI / 2;
      const a1 = (seg.end * Math.PI) / 180 - Math.PI / 2;
      const color = sliceColor(i, n, theme, colorSpace);
      ctx.beginPath();
      ctx.moveTo(c, c);
      ctx.arc(c, c, radius, a0, a1);
      ctx.closePath();
      ctx.fillStyle = color.fill;
      ctx.fill();
      if (highlight >= 0 && i !== highlight) {
        ctx.globalAlpha = 0.6;
        ctx.fillStyle = surface;
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      if (n > 1) {
        ctx.lineWidth = Math.max(1.5, size * 0.004);
        ctx.strokeStyle = surface;
        ctx.stroke();
      }

      const sweep = a1 - a0;
      const textColor = highlight >= 0 && i !== highlight ? cssVar('--muted') : color.text;
      drawLabel(options[i].label, a0 + sweep / 2, sweep, labelInner, labelOuter, size, font, textColor);
    });

    // Rim studs, a small touch that makes the wheel read as a physical object.
    const studs = Math.min(36, Math.max(12, n * 2));
    ctx.fillStyle = surface;
    for (let k = 0; k < studs; k++) {
      const a = (k / studs) * Math.PI * 2;
      ctx.beginPath();
      ctx.arc(c + Math.cos(a) * (c - rim / 2 - 0.5), c + Math.sin(a) * (c - rim / 2 - 0.5), Math.max(1.5, rim * 0.2), 0, Math.PI * 2);
      ctx.fill();
    }
  }

  const CJK = /[\u2E80-\u9FFF\uF900-\uFAFF\uFF00-\uFFEF]/;

  /**
   * Chinese labels are stacked one character per step along the radius with each glyph upright
   * toward the rim, so the winning slice reads normally under the pointer. Short non-CJK labels
   * (numbers, 是/否 style answers) are drawn upright as a block; longer Latin text runs along the radius.
   */
  function drawLabel(label: string, mid: number, sweep: number, inner: number, outer: number, size: number, font: string, color: string) {
    if (!ctx) return;
    ctx.save();
    ctx.translate(size / 2, size / 2);
    ctx.fillStyle = color;
    ctx.textBaseline = 'middle';
    const chars = Array.from(label);
    const stacked = CJK.test(label);
    if (stacked || chars.length <= 3) {
      ctx.rotate(mid + Math.PI / 2); // "up" now points outward along the slice's centre line
      ctx.textAlign = 'center';
      const midRadius = inner + (outer - inner) * 0.55;
      let fontSize = Math.min(size * 0.06, sweep * midRadius * 0.78, 26);
      if (!stacked) {
        // Upright block such as "10": limited by slice width near the rim.
        fontSize = Math.min(size * 0.07, (sweep * (outer - fontSize)) / Math.max(1, chars.length * 0.62), 30);
        if (fontSize < 8) return ctx.restore();
        ctx.font = `700 ${fontSize}px ${font}`;
        ctx.fillText(label, 0, -(outer - fontSize * 0.75));
        return ctx.restore();
      }
      if (fontSize < 8) return ctx.restore();
      ctx.font = `600 ${fontSize}px ${font}`;
      const step = fontSize * 1.06;
      const fits: number[] = [];
      for (let r = outer - fontSize / 2; r - fontSize / 2 >= inner && sweep * r >= fontSize * 0.92; r -= step) fits.push(r);
      if (fits.length === 0) return ctx.restore();
      const shown = chars.length <= fits.length ? chars : [...chars.slice(0, Math.max(1, fits.length - 1)), '\uFE19'];
      shown.forEach((ch, k) => {
        if (!rotatesInVertical(ch)) return ctx.fillText(ch, 0, -fits[k]);
        ctx.save();
        ctx.translate(0, -fits[k]);
        ctx.rotate(Math.PI / 2);
        ctx.fillText(ch, 0, 0);
        ctx.restore();
      });
      return ctx.restore();
    }
    ctx.rotate(mid);
    ctx.textAlign = 'right';
    const arcAtLabel = sweep * (outer * 0.72);
    const fontSize = Math.min(size * 0.055, arcAtLabel * 0.62, 24);
    if (fontSize < 8) return ctx.restore();
    ctx.font = `600 ${fontSize}px ${font}`;
    const columns = Math.max(2, Math.floor((outer - inner) / (fontSize * 0.56)));
    ctx.fillText(fitLabel(label, columns), outer, 0);
    ctx.restore();
  }

  function setRotation(deg: number) {
    canvas.style.transform = `rotate(${deg}deg)`;
  }

  // ---------- Options & UI ----------
  function refresh() {
    if (spinning) return;
    options = parseOptions(input.value);
    segments = options.length ? segmentsOf(options) : [];
    highlight = -1;
    titleView.textContent = titleInput.value.trim();
    titleView.hidden = titleView.textContent === '';
    const weighted = hasCustomWeights(options);
    countHint.textContent = plural(locale, options.length, s.count) + (weighted ? s.weighted : '');
    spinBtn.disabled = options.length < 2;
    spinLabel.textContent = options.length < 2 ? s.minTwo : s.spin;

    const probs = probabilities(options);
    oddsBody.replaceChildren(
      ...options.map((o, i) => {
        const tr = document.createElement('tr');
        const name = document.createElement('td');
        const w = document.createElement('td');
        const p = document.createElement('td');
        name.textContent = o.label;
        w.className = 'num';
        w.textContent = formatNumber(o.weight, 2, locale);
        p.className = 'num';
        p.textContent = `${formatNumber(probs[i] * 100, 2, locale)}%`;
        tr.append(name, w, p);
        return tr;
      }),
    );
    draw();
  }

  function showError(message: string) {
    error.textContent = message;
    error.hidden = message === '';
  }

  function lock(on: boolean) {
    spinning = on;
    for (const el of lockable) el.disabled = on;
    spinBtn.setAttribute('aria-busy', String(on));
    wheel.classList.toggle('is-spinning', on);
    spinLabel.textContent = on ? s.spinning : s.spin;
  }

  // ---------- History ----------
  function renderHistory() {
    historyList.replaceChildren(
      ...history
        .slice()
        .reverse()
        .map((h) => {
          const li = document.createElement('li');
          const label = document.createElement('span');
          const time = document.createElement('span');
          label.textContent = h.label;
          time.className = 'sw-time';
          time.textContent = h.time;
          li.append(label, time);
          return li;
        }),
    );
    historyList.hidden = history.length === 0;
    historyEmpty.hidden = history.length > 0;
  }

  function pushHistory(label: string) {
    const now = new Date();
    const time = now.toLocaleTimeString(LOCALE_INFO[locale].intl, { hour12: s.hour12 });
    history = [...history, { label, time }].slice(-HISTORY_MAX);
    savePref(`${PREF_KEY}:history`, history);
    renderHistory();
  }

  // ---------- Sound ----------
  function tick() {
    if (!sound.checked) return;
    try {
      audio ??= new AudioContext();
      const t = audio.currentTime;
      const osc = audio.createOscillator();
      const gain = audio.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(1400, t);
      osc.frequency.exponentialRampToValueAtTime(600, t + 0.04);
      gain.gain.setValueAtTime(0.08, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      osc.connect(gain).connect(audio.destination);
      osc.start(t);
      osc.stop(t + 0.06);
    } catch {
      /* audio unavailable */
    }
  }

  function flickPointer() {
    if (reducedMotion.matches || typeof pointer.animate !== 'function') return;
    pointer.animate([{ transform: 'rotate(-20deg)' }, { transform: 'rotate(0deg)' }], { duration: 140, easing: 'ease-out' });
  }

  // ---------- Spin ----------
  /** Applies the deferred auto-remove (「抽中後自動移除」) only if the winner's line is still unchanged. */
  function applyPendingRemoval() {
    if (!lastWinner) return;
    const lines = input.value.split(/\r\n|\r|\n/);
    if (lines[lastWinner.option.line] === lastWinner.raw) {
      input.value = removeOptionLine(input.value, lastWinner.option);
      save();
    }
    lastWinner = null;
    refresh();
  }

  function finish(winner: number) {
    rotation = ((rotation % 360) + 360) % 360;
    setRotation(rotation);
    highlight = winner;
    draw();
    const option = options[winner];
    const raw = input.value.split(/\r\n|\r|\n/)[option.line] ?? '';
    lastWinner = { option, raw };
    pushHistory(option.label);
    resultN.textContent = t(s.nth, { n: formatNumber(history.length, 0, locale) });
    resultValue.textContent = option.label;
    resultBox.hidden = false;
    resultBox.classList.remove('is-new');
    void resultBox.offsetWidth;
    resultBox.classList.add('is-new');
    lock(false);
    spinBtn.focus({ preventScroll: true });
  }

  function spin() {
    if (spinning) return;
    showError('');
    if (autoRemove.checked) applyPendingRemoval();
    else lastWinner = null;
    refresh();
    if (options.length < 2) {
      showError(s.errorMin);
      return;
    }

    // The winner is decided first, with crypto randomness; the animation only shows it.
    const winner = pickWeighted(options);
    const { ms, turns } = SPEEDS[speedOf()];
    const from = rotation;
    const to = targetRotation(segments, winner, from, turns, randomFloat());
    lock(true);
    resultBox.hidden = true;

    if (reducedMotion.matches) {
      rotation = to;
      setRotation(rotation);
      finish(winner);
      return;
    }

    const start = performance.now();
    let lastSeg = segmentAtPointer(segments, from);
    const frame = (now: number) => {
      const t = Math.min(1, (now - start) / ms);
      rotation = rotationAt(from, to, t);
      setRotation(rotation);
      const seg = segmentAtPointer(segments, rotation);
      if (seg !== lastSeg) {
        lastSeg = seg;
        flickPointer();
        tick();
      }
      if (t < 1) requestAnimationFrame(frame);
      else finish(winner);
    };
    requestAnimationFrame(frame);
  }

  // ---------- Fullscreen ----------
  if (document.fullscreenEnabled && typeof stage.requestFullscreen === 'function') {
    fsBtn.hidden = false;
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void stage.requestFullscreen().catch(() => undefined);
    });
    document.addEventListener('fullscreenchange', () => {
      fsLabel.textContent = document.fullscreenElement === stage ? s.exitFullscreen : s.fullscreen;
      if (fsBtn.title) fsBtn.title = fsLabel.textContent;
      requestAnimationFrame(draw);
    });
  }

  // ---------- Events ----------
  const refreshSoon = debounce(() => {
    lastWinner = null;
    resultBox.hidden = true;
    refresh();
    save();
  }, 150);

  input.addEventListener('input', refreshSoon);
  titleInput.addEventListener('input', () => {
    titleView.textContent = titleInput.value.trim();
    titleView.hidden = titleView.textContent === '';
    save();
  });
  root.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches('input[type="radio"], input[type="checkbox"]')) save();
  });

  spinBtn.addEventListener('click', spin);
  $('#sw-again', root).addEventListener('click', spin);
  canvas.addEventListener('click', spin);

  $('#sw-remove-now', root).addEventListener('click', () => {
    if (spinning || !lastWinner) return;
    const before = input.value;
    applyPendingRemoval();
    if (input.value === before) showError(s.errorChanged);
    resultBox.hidden = true;
  });

  for (const btn of presetButtons) {
    btn.addEventListener('click', () => {
      const preset = PRESETS.find((p) => p.id === btn.dataset.preset);
      if (!preset || spinning) return;
      input.value = preset.options.join('\n');
      titleInput.value = preset.name;
      lastWinner = null;
      resultBox.hidden = true;
      showError('');
      refresh();
      save();
    });
  }

  $('#sw-shuffle', root).addEventListener('click', () => {
    input.value = shuffleLines(input.value);
    lastWinner = null;
    refresh();
    save();
  });

  $('#sw-clear', root).addEventListener('click', () => {
    input.value = '';
    titleInput.value = '';
    lastWinner = null;
    resultBox.hidden = true;
    refresh();
    save();
    input.focus();
  });

  $('#sw-history-clear', root).addEventListener('click', () => {
    history = [];
    savePref(`${PREF_KEY}:history`, history);
    renderHistory();
  });

  if (typeof ResizeObserver === 'function') new ResizeObserver(() => draw()).observe(wheel);
  else window.addEventListener('resize', debounce(draw, 100));

  applyPrefs({ ...defaults, ...loadPref<Partial<Prefs>>('spin-wheel', {}) });
  renderHistory();
  refresh();
  setRotation(rotation);
</script>

<style>
  .sw-layout {
    display: grid;
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 760px) {
    .sw-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  /* ---------- Stage ---------- */
  .sw-stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    min-width: 0;
  }
  .sw-stage:fullscreen {
    background: var(--bg);
    align-content: center;
    padding: 24px;
  }
  .sw-title {
    margin: 0;
    max-width: 100%;
    padding-inline: 92px; /* keeps long titles clear of the 全螢幕 button */
    font-size: clamp(18px, 4.5vw, 24px);
    font-weight: 700;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .sw-stage:fullscreen .sw-title {
    font-size: clamp(24px, 4vw, 40px);
  }
  .sw-wheel {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    padding-top: 0;
  }
  .sw-stage:fullscreen .sw-wheel {
    width: min(78vh, 92vw);
  }
  .sw-wheel canvas {
    display: block;
    width: 100%;
