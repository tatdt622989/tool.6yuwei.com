---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
/** Metric fields carry data-units only when a unit toggle exists; zh markup stays unchanged. */
const metric = s.units ? 'metric' : undefined;
const hideMetric = s.units ? true : undefined;
---

<div class="tool" data-tool="water-intake" {...i18nAttrs(locale, s.client)}>{
  s.units && (
    <div class="seg" role="radiogroup" aria-label={s.units.legend}>
      <label>
        <input type="radio" name="wi-unit" value="imperial" checked />
        <span>{s.units.imperial}</span>
      </label>
      <label>
        <input type="radio" name="wi-unit" value="metric" />
        <span>{s.units.metric}</span>
      </label>
    </div>
  )
}
  <div class="grid-2">
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="wi-weight">{s.weightKg}</label>
      <input id="wi-weight" type="text" inputmode="decimal" autocomplete="off" value="60" />
    </div>{
      s.units && (
        <div class="field" data-units="imperial">
          <label for="wi-lb">{s.units.weightLb}</label>
          <input id="wi-lb" type="text" inputmode="decimal" autocomplete="off" value="150" />
        </div>
      )
    }
    <div class="field">
      <span class="label">{s.sexLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.sexLabel}>
        <label><input type="radio" name="wi-sex" value="female" checked /><span>{s.female}</span></label>
        <label><input type="radio" name="wi-sex" value="male" /><span>{s.male}</span></label>
      </div>
    </div>
  </div>

  <div class="field">
    <span class="label">{s.activityLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.activityLabel}>
      <label><input type="radio" name="wi-activity" value="low" checked /><span>{s.activities.low}</span></label>
      <label><input type="radio" name="wi-activity" value="normal" /><span>{s.activities.normal}</span></label>
      <label><input type="radio" name="wi-activity" value="high" /><span>{s.activities.high}</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="wi-exercise">{s.exercise}</label>
      <input id="wi-exercise" type="text" inputmode="numeric" autocomplete="off" value="0" />
    </div>
    <div class="field" data-units={metric} hidden={hideMetric}>
      <label for="wi-cup">{s.cupMl}</label>
      <input id="wi-cup" type="text" inputmode="numeric" autocomplete="off" value="250" />
    </div>{
      s.units && (
        <div class="field" data-units="imperial">
          <label for="wi-cup-oz">{s.units.cupOz}</label>
          <input id="wi-cup-oz" type="text" inputmode="decimal" autocomplete="off" value="8" />
        </div>
      )
    }
  </div>

  <label class="check"><input type="checkbox" id="wi-hot" />{s.hot}</label>

  <div class="notice error" id="wi-error" hidden></div>

  <div id="wi-output">
    <div class="result" aria-live="polite">
      <div class="result-value"><span id="wi-total">—</span> <span class="wi-unit">{s.unitPerDay}</span></div>
      <div class="result-label" id="wi-cups">—</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="wi-range">—</span><span class="stat-label">{s.rangeLabel}</span></div>
      <div class="stat"><span class="stat-value" id="wi-base">—</span><span class="stat-label" id="wi-base-label">{s.baseLabel}</span></div>
      <div class="stat"><span class="stat-value" id="wi-extra">—</span><span class="stat-label">{s.extraLabel}</span></div>
      <div class="stat"><span class="stat-value" id="wi-hpa">—</span><span class="stat-label" id="wi-hpa-label">{s.refLabel}</span></div>
    </div>

    <div class="field">
      <span class="label">{s.scheduleLabel}</span>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>{s.thTime}</th><th class="num">{s.thAmount}</th></tr></thead>
          <tbody id="wi-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">{s.disclaimer}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import {
    calcWater,
    checkWater,
    drinkingSchedule,
    flOzToMl,
    lbToKg,
    mlPerKgToOzPerLb,
    mlToFlOz,
    REFERENCE_FLUID,
    slotsInFlOz,
    WATER_RULES,
    type ActivityLevel,
    type Sex,
    type WaterInput,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="water-intake"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const weight = $<HTMLInputElement>('#wi-weight', root);
  const sexes = $$<HTMLInputElement>('input[name="wi-sex"]', root);
  const activities = $$<HTMLInputElement>('input[name="wi-activity"]', root);
  const exercise = $<HTMLInputElement>('#wi-exercise', root);
  const cup = $<HTMLInputElement>('#wi-cup', root);
  const hot = $<HTMLInputElement>('#wi-hot', root);
  const unitRadios = $$<HTMLInputElement>('input[name="wi-unit"]', root);
  const lb = root.querySelector<HTMLInputElement>('#wi-lb');
  const cupOz = root.querySelector<HTMLInputElement>('#wi-cup-oz');
  const unitLabel = $('.wi-unit', root);
  const error = $('#wi-error', root);
  const output = $('#wi-output', root);
  const table = $('#wi-table', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  interface Prefs {
    weight: string;
    sex: Sex;
    activity: ActivityLevel;
    exercise: string;
    cup: string;
    hot: boolean;
    unit?: 'metric' | 'imperial';
    lb?: string;
    cupOz?: string;
  }
  const saved = loadPref<Prefs>('water-intake', { weight: '60', sex: 'female', activity: 'low', exercise: '0', cup: '250', hot: false });
  weight.value = saved.weight;
  for (const s of sexes) s.checked = s.value === saved.sex;
  for (const a of activities) a.checked = a.value === saved.activity;
  if (!activities.some((a) => a.checked)) activities[0].checked = true;
  if (!sexes.some((s) => s.checked)) sexes[0].checked = true;
  exercise.value = saved.exercise;
  cup.value = saved.cup;
  hot.checked = saved.hot;
  if (lb && cupOz) {
    lb.value = saved.lb ?? lb.value;
    cupOz.value = saved.cupOz ?? cupOz.value;
  }
  const savedUnit = unitRadios.find((r) => r.value === saved.unit);
  if (savedUnit) savedUnit.checked = true;

  const imperial = () => Boolean(lb && cupOz) && unitRadios.find((r) => r.checked)?.value === 'imperial';
  const vol = (ml: number) => (imperial() ? `${formatInteger(mlToFlOz(ml), locale)} fl oz` : `${formatInteger(ml, locale)} ml`);
  const clock = (hhmm: string) => {
    if (!s.clock12) return hhmm;
    const [h, m] = hhmm.split(':').map(Number);
    return new Date(2000, 0, 1, h, m).toLocaleTimeString(LOCALE_INFO[locale].intl, { hour: 'numeric', minute: '2-digit' });
  };

  function showUnits() {
    if (!unitRadios.length) return;
    const us = imperial();
    $$<HTMLElement>('[data-units]', root).forEach((el) => (el.hidden = el.dataset.units !== (us ? 'imperial' : 'metric')));
    const label = us ? s.unitPerDayUs : s.unitPerDayMetric;
    if (label) unitLabel.textContent = label;
  }

  function render() {
    const sex = (sexes.find((s) => s.checked)?.value ?? 'female') as Sex;
    const activity = (activities.find((a) => a.checked)?.value ?? 'low') as ActivityLevel;
    const us = imperial();
    savePref('water-intake', {
      weight: weight.value,
      sex,
      activity,
      exercise: exercise.value,
      cup: cup.value,
      hot: hot.checked,
      ...(lb && cupOz ? { unit: us ? 'imperial' : 'metric', lb: lb.value, cupOz: cupOz.value } : {}),
    } satisfies Prefs);

    const input: WaterInput = {
      weightKg: us ? lbToKg(parseNumber(lb!.value)) : parseNumber(weight.value),
      activity,
      exerciseMin: exercise.value.trim() === '' ? 0 : parseNumber(exercise.value),
      hot: hot.checked,
      cupMl: us ? flOzToMl(parseNumber(cupOz!.value)) : parseNumber(cup.value),
    };
    const problem = checkWater(input);
    const r = problem ? null : calcWater(input);
    if (!r) {
      error.textContent = problem ? ((us ? s.problemsUs?.[problem] : undefined) ?? s.problems[problem]) : s.fallback;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    const liters = (ml: number) => formatNumber(ml / 1000, 1, locale);
    set('#wi-total', us ? formatInteger(mlToFlOz(r.total), locale) : formatInteger(r.total, locale));
    set(
      '#wi-cups',
      plural(locale, r.cups, s.cupsLine, {
        liters: liters(r.total),
        cup: us
          ? `${formatNumber(parseNumber(cupOz!.value), 1, locale)} fl oz`
          : t(s.cupMetric ?? '{n}', { n: formatInteger(input.cupMl, locale) }),
      }),
    );
    set(
      '#wi-range',
      us
        ? `${formatInteger(mlToFlOz(r.low), locale)}–${formatInteger(mlToFlOz(r.high), locale)} fl oz`
        : `${liters(r.low)}–${liters(r.high)} L`,
    );
    set('#wi-base', vol(r.base));
    const perKg = WATER_RULES.mlPerKg[activity];
    set(
      '#wi-base-label',
      us && s.baseLabelUs ? t(s.baseLabelUs, { n: formatNumber(mlPerKgToOzPerLb(perKg), 2, locale) }) : t(s.baseLabel, { n: perKg }),
    );
    set('#wi-extra', r.exercise + r.climate > 0 ? `+${vol(r.exercise + r.climate)}` : us ? '0 fl oz' : '0 ml');
    set('#wi-hpa', vol(REFERENCE_FLUID[s.reference][sex]));
    set('#wi-hpa-label', t(s.refLabel, { sex: s.refSex[sex] }));

    const slots = drinkingSchedule(r.total, r.cups);
    const amounts = us ? slotsInFlOz(r.total, slots.length).map((oz) => `${formatInteger(oz, locale)} fl oz`) : slots.map((x) => `${formatInteger(x.ml, locale)} ml`);
    table.innerHTML = slots.map((x, i) => `<tr><td>${clock(x.time)}</td><td class="num">${amounts[i]}</td></tr>`).join('');
  }

  [weight, exercise, cup, lb, cupOz].forEach((el) => el?.addEventListener('input', render));
  [...sexes, ...activities, hot].forEach((el) => el.addEventListener('change', render));
  unitRadios.forEach((r) =>
    r.addEventListener('change', () => {
      showUnits();
      render();
    }),
  );
  showUnits();
  render();
</script>
<style>
  #wi-output {
    display: grid;
    gap: 16px;
  }
  .wi-unit {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-2);
  }
</style>
