---
import { APPLIANCES } from './logic';
---

<div class="tool" data-tool="electricity-bill">
  <div class="field">
    <span class="label">用電種類</span>
    <div class="seg" role="radiogroup" aria-label="用電種類">
      <label><input type="radio" name="eb-type" value="residential" checked /><span>住宅（含非營業）</span></label>
      <label><input type="radio" name="eb-type" value="business" /><span>營業用（小商店）</span></label>
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="eb-kwh">本期用電度數（度）</label>
      <input id="eb-kwh" type="text" inputmode="decimal" autocomplete="off" value="700" />
      <span class="hint">電費單上的「計費度數」，1 度 = 1 千瓦小時（kWh）。</span>
    </div>
    <div class="field">
      <span class="label">抄表週期</span>
      <div class="seg" role="radiogroup" aria-label="抄表週期">
        <label><input type="radio" name="eb-months" value="2" checked /><span>2 個月一期</span></label>
        <label><input type="radio" name="eb-months" value="1" /><span>每月一期</span></label>
      </div>
      <span class="hint">一般家庭多為 2 個月抄表一次，各級距度數加倍計算。</span>
    </div>
  </div>

  <div class="field">
    <span class="label">計費季節</span>
    <div class="seg" role="radiogroup" aria-label="計費季節">
      <label><input type="radio" name="eb-season" value="nonSummer" checked /><span>非夏月</span></label>
      <label><input type="radio" name="eb-season" value="summer" /><span>夏月（6/1–9/30）</span></label>
      <label><input type="radio" name="eb-season" value="span" /><span>跨季（輸入計費期間）</span></label>
    </div>
  </div>

  <div class="grid-2" id="eb-range" hidden>
    <div class="field">
      <label for="eb-start">計費期間起日</label>
      <input id="eb-start" type="date" />
    </div>
    <div class="field">
      <label for="eb-end">計費期間迄日</label>
      <input id="eb-end" type="date" />
    </div>
    <span class="hint eb-range-hint" id="eb-range-hint"></span>
  </div>

  <div class="notice error" id="eb-error" hidden></div>

  <div id="eb-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="eb-total">—</div>
      <div class="result-label" id="eb-total-label">本期應繳電費</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="eb-avg">—</span><span class="stat-label">平均每度電價</span></div>
      <div class="stat"><span class="stat-value" id="eb-marginal">—</span><span class="stat-label">最後一度的單價</span></div>
      <div class="stat"><span class="stat-value" id="eb-monthly">—</span><span class="stat-label">平均每月電費</span></div>
    </div>

    <div class="field">
      <span class="label">累進級距明細</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>級距（度）</th><th class="num">度數</th><th class="num">單價</th><th class="num">金額（元）</th></tr>
          </thead>
          <tbody id="eb-table"></tbody>
        </table>
      </div>
      <span class="hint" id="eb-formula"></span>
    </div>
  </div>

  <section class="eb-appliances" aria-labelledby="eb-app-title">
    <h2 class="eb-h" id="eb-app-title">電器耗電與電費估算</h2>
    <p class="hint">選擇電器或輸入瓦數，算出一小時幾度電、整段期間要多付多少電費。功率為常見約略值，實際以銘牌或能源標章為準。</p>
    <div id="eb-app-list" class="eb-app-list"></div>
    <div class="row">
      <button type="button" class="btn small" id="eb-app-add">新增電器</button>
      <button type="button" class="btn small ghost" id="eb-app-apply">把這些度數加到本期用電</button>
    </div>
    <div class="stats">
      <div class="stat"><span class="stat-value" id="eb-app-hour">—</span><span class="stat-label">每小時耗電</span></div>
      <div class="stat"><span class="stat-value" id="eb-app-kwh">—</span><span class="stat-label">期間總耗電</span></div>
      <div class="stat"><span class="stat-value" id="eb-app-cost">—</span><span class="stat-label">本期電費約增加</span></div>
    </div>
    <p class="hint" id="eb-app-note"></p>
  </section>

  <template id="eb-app-row">
    <div class="eb-app-row">
      <div class="field eb-app-name">
        <label>電器</label>
        <select data-k="preset">
          {APPLIANCES.map((a) => <option value={a.id}>{a.name}（{a.watts.toLocaleString('en-US')} W）</option>)}
          <option value="custom">自訂瓦數</option>
        </select>
      </div>
      <div class="field">
        <label>瓦數（W）</label>
        <input data-k="watts" type="text" inputmode="decimal" autocomplete="off" />
      </div>
      <div class="field">
        <label>每天幾小時</label>
        <input data-k="hours" type="text" inputmode="decimal" autocomplete="off" />
      </div>
      <div class="field">
        <label>使用天數</label>
        <input data-k="days" type="text" inputmode="numeric" autocomplete="off" />
      </div>
      <button type="button" class="btn small ghost eb-app-remove" data-k="remove" aria-label="移除這項電器">移除</button>
      <span class="hint eb-app-result" data-k="result"></span>
    </div>
  </template>

  <p class="hint">依台電 2025 年 10 月 1 日起實施的表燈（住商）非時間電價計算，2026 年 4 月與 10 月電價審議皆凍漲，現行費率仍適用；若 2026 年 12 月審議會決議調整，將自 2027 年 1 月 1 日起適用新價。跨季帳單依台電公告方式按日數比例分攤。結果僅供參考，實際金額以台電電費單為準；所有計算在你的瀏覽器內完成。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    addDays,
    APPLIANCES,
    applianceKwh,
    calculateBill,
    incrementalCost,
    isSummer,
    parseISODate,
    seasonDays,
    toISODate,
    validateBill,
    type BillInput,
    type CustomerType,
    type SeasonBill,
  } from './logic';

  const KEY = 'electricity-bill';
  const root = $('[data-tool="electricity-bill"]');
  const types = $$<HTMLInputElement>('input[name="eb-type"]', root);
  const monthsIn = $$<HTMLInputElement>('input[name="eb-months"]', root);
  const seasons = $$<HTMLInputElement>('input[name="eb-season"]', root);
  const kwhIn = $<HTMLInputElement>('#eb-kwh', root);
  const range = $('#eb-range', root);
  const startIn = $<HTMLInputElement>('#eb-start', root);
  const endIn = $<HTMLInputElement>('#eb-end', root);
  const error = $('#eb-error', root);
  const output = $('#eb-output', root);
  const table = $('#eb-table', root);
  const appList = $('#eb-app-list', root);
  const template = $<HTMLTemplateElement>('#eb-app-row', root);

  interface AppPref {
    preset: string;
    watts: string;
    hours: string;
    days: string;
  }
  interface Prefs {
    type: string;
    months: string;
    season: string;
    kwh: string;
    start: string;
    end: string;
    apps: AppPref[];
  }

  const checked = (list: HTMLInputElement[], fallback: string) => list.find((i) => i.checked)?.value ?? fallback;
  const setChecked = (list: HTMLInputElement[], value: string | undefined) => {
    if (value && list.some((i) => i.value === value)) for (const i of list) i.checked = i.value === value;
  };
  const money = (n: number) => `${formatInteger(n)} 元`;
  const price = (n: number) => `${n.toFixed(2)} 元`;
  const kwhText = (n: number) => `${formatNumber(n, 2)} 度`;
  const num = (el: HTMLInputElement, fallback = Number.NaN) => (el.value.trim() === '' ? fallback : parseNumber(el.value));

  // ---- 預設值：今天所在季節、計費期間為最近 2 個月 ----
  const now = new Date();
  const today = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  setChecked(seasons, isSummer(today) ? 'summer' : 'nonSummer');
  endIn.value = toISODate(today);
  startIn.value = toISODate(addDays(today, -60));

  const prefs = loadPref<Partial<Prefs>>(KEY, {});
  setChecked(types, prefs.type);
  setChecked(monthsIn, prefs.months);
  setChecked(seasons, prefs.season);
  if (prefs.kwh !== undefined) kwhIn.value = prefs.kwh;
  if (prefs.start && parseISODate(prefs.start)) startIn.value = prefs.start;
  if (prefs.end && parseISODate(prefs.end)) endIn.value = prefs.end;

  // ---- 電器列 ----
  function field<T extends HTMLElement>(row: HTMLElement, k: string): T {
    return $<T>(`[data-k="${k}"]`, row);
  }

  function applyPreset(row: HTMLElement) {
    const preset = APPLIANCES.find((a) => a.id === field<HTMLSelectElement>(row, 'preset').value);
    if (!preset) return;
    field<HTMLInputElement>(row, 'watts').value = String(preset.watts);
    field<HTMLInputElement>(row, 'hours').value = String(preset.hours);
  }

  let rowSeq = 0;
  function addRow(pref?: Partial<AppPref>) {
    const row = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const id = `eb-app-${rowSeq++}`;
    for (const label of $$<HTMLLabelElement>('label', row)) {
      const control = label.parentElement?.querySelector<HTMLElement>('[data-k]');
      if (control) {
        control.id = `${id}-${control.dataset.k}`;
        label.htmlFor = control.id;
      }
    }
    const select = field<HTMLSelectElement>(row, 'preset');
    select.value = pref?.preset && select.querySelector(`option[value="${pref.preset}"]`) ? pref.preset : APPLIANCES[0].id;
    applyPreset(row);
    if (pref?.watts !== undefined) field<HTMLInputElement>(row, 'watts').value = pref.watts;
    if (pref?.hours !== undefined) field<HTMLInputElement>(row, 'hours').value = pref.hours;
    field<HTMLInputElement>(row, 'days').value = pref?.days ?? '30';
    appList.append(row);
  }

  const rows = () => $$<HTMLElement>('.eb-app-row', appList);
  if (Array.isArray(prefs.apps) && prefs.apps.length > 0) prefs.apps.slice(0, 12).forEach(addRow);
  else addRow();

  appList.addEventListener('change', (event) => {
    const target = event.target as HTMLElement;
    const row = target.closest<HTMLElement>('.eb-app-row');
    if (!row) return;
    if (target.dataset.k === 'preset') applyPreset(row);
    if (target.dataset.k === 'watts' && field<HTMLSelectElement>(row, 'preset').value !== 'custom') {
      const preset = APPLIANCES.find((a) => a.id === field<HTMLSelectElement>(row, 'preset').value);
      if (preset && String(preset.watts) !== field<HTMLInputElement>(row, 'watts').value.trim())
        field<HTMLSelectElement>(row, 'preset').value = 'custom';
    }
  });
  appList.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-k="remove"]');
    if (!button) return;
    button.closest('.eb-app-row')?.remove();
    if (rows().length === 0) addRow();
    render();
  });
  $('#eb-app-add', root).addEventListener('click', () => {
    if (rows().length < 12) addRow({ preset: 'dehumidifier' });
    render();
  });

  // ---- 計算 ----
  function readBill(): { input: BillInput; problem: string | null } {
    const season = checked(seasons, 'nonSummer');
    const months = checked(monthsIn, '2') === '1' ? 1 : 2;
    let summerDays = 0;
    let nonSummerDays = 0;
    let problem: string | null = null;
    if (season === 'span') {
      const a = parseISODate(startIn.value);
      const b = parseISODate(endIn.value);
      const days = a && b ? seasonDays(a, b) : null;
      if (!days) problem = '請選擇正確的計費期間（迄日不可早於起日，期間最長約 2 年）。';
      else ({ summerDays, nonSummerDays } = days);
    } else if (season === 'summer') summerDays = 1;
    else nonSummerDays = 1;
    const input: BillInput = {
      kwh: num(kwhIn),
      customer: checked(types, 'residential') as CustomerType,
      months,
      summerDays,
      nonSummerDays,
    };
    return { input, problem: problem ?? validateBill(input) };
  }

  function tr(cells: string[], className?: string): HTMLTableRowElement {
    const row = document.createElement('tr');
    if (className) row.className = className;
    cells.forEach((text, i) => {
      const td = document.createElement('td');
      td.textContent = text;
      if (i > 0) td.className = 'num';
      row.append(td);
    });
    return row;
  }

  function tierLabel(from: number, to: number): string {
    return to === Infinity ? `${formatInteger(from + 1)} 度以上` : `${formatInteger(from + 1)}–${formatInteger(to)}`;
  }

  function seasonRows(b: SeasonBill, title: string | null): HTMLTableRowElement[] {
    const out: HTMLTableRowElement[] = [];
    if (title) {
      const head = document.createElement('tr');
      head.className = 'eb-group';
      const td = document.createElement('td');
      td.colSpan = 4;
      td.textContent = title;
      head.append(td);
      out.push(head);
    }
    for (const r of b.rows) out.push(tr([tierLabel(r.from, r.to), formatNumber(r.kwh, 2), r.price.toFixed(2), formatNumber(r.amount, 2)]));
    return out;
  }

  function render() {
    const season = checked(seasons, 'nonSummer');
    range.hidden = season !== 'span';
    savePref(KEY, {
      type: checked(types, 'residential'),
      months: checked(monthsIn, '2'),
      season,
      kwh: kwhIn.value,
      start: startIn.value,
      end: endIn.value,
      apps: rows().map((row) => ({
        preset: field<HTMLSelectElement>(row, 'preset').value,
        watts: field<HTMLInputElement>(row, 'watts').value,
        hours: field<HTMLInputElement>(row, 'hours').value,
        days: field<HTMLInputElement>(row, 'days').value,
      })),
    } satisfies Prefs);

    const { input, problem } = readBill();
    const r = problem ? null : calculateBill(input);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
    } else {
      error.hidden = true;
      output.hidden = false;
      const totalDays = input.summerDays + input.nonSummerDays;
      if (season === 'span') {
        $('#eb-range-hint', root).textContent = `共 ${totalDays} 天：夏月 ${input.summerDays} 天、非夏月 ${input.nonSummerDays} 天。`;
      }
      $('#eb-total', root).textContent = money(r.total);
      const seasonName = season === 'span' ? '跨季' : season === 'summer' ? '夏月' : '非夏月';
      $('#eb-total-label', root).textContent =
        `${seasonName}、${input.months === 2 ? '2 個月' : '1 個月'}用電 ${formatNumber(input.kwh, 2)} 度的應繳電費`;
      $('#eb-avg', root).textContent = input.kwh > 0 ? price(r.average) : '—';
      $('#eb-marginal', root).textContent = price(r.marginalPrice);
      $('#eb-monthly', root).textContent = money(r.exact / input.months);

      const mixed = r.summer && r.nonSummer;
      const rowsOut: HTMLTableRowElement[] = [];
      if (r.summer) rowsOut.push(...seasonRows(r.summer, mixed ? `夏月單價（占 ${input.summerDays}/${totalDays}）` : null));
      if (r.nonSummer)
        rowsOut.push(...seasonRows(r.nonSummer, mixed ? `非夏月單價（占 ${input.nonSummerDays}/${totalDays}）` : null));
      rowsOut.push(tr(['合計', formatNumber(input.kwh, 2), '', money(r.total)], 'eb-total'));
      table.replaceChildren(...rowsOut);
      $('#eb-formula', root).textContent =
        mixed && r.summer && r.nonSummer
          ? `跨季電費 = ${formatNumber(r.summer.amount, 2)} × ${input.summerDays}/${totalDays} + ${formatNumber(r.nonSummer.amount, 2)} × ${input.nonSummerDays}/${totalDays} ＝ ${formatNumber(r.exact, 2)}，四捨五入為 ${money(r.total)}。`
          : input.months === 2
            ? '2 個月一期：各級距度數為每月的 2 倍，例如第一段 120 度變成 240 度。'
            : '每月一期：依每月級距計算。';
    }

    // 電器估算
    let hourKwh = 0;
    let totalKwh = 0;
    let valid = true;
    for (const row of rows()) {
      const watts = num(field<HTMLInputElement>(row, 'watts'));
      const hours = num(field<HTMLInputElement>(row, 'hours'), 0);
      const days = num(field<HTMLInputElement>(row, 'days'), 0);
      const k = applianceKwh(watts, hours, days);
      const out = field<HTMLElement>(row, 'result');
      if (!Number.isFinite(k)) {
        valid = false;
        out.textContent = '請輸入瓦數、時數與天數。';
        continue;
      }
      hourKwh += watts / 1000;
      totalKwh += k;
      out.textContent = `每小時 ${kwhText(watts / 1000)}，每天 ${kwhText((watts * hours) / 1000)}，${formatNumber(days, 0)} 天共 ${kwhText(k)}`;
    }
    $('#eb-app-hour', root).textContent = valid ? kwhText(hourKwh) : '—';
    $('#eb-app-kwh', root).textContent = valid ? kwhText(totalKwh) : '—';
    const extra = r && valid ? incrementalCost(input, totalKwh) : Number.NaN;
    $('#eb-app-cost', root).textContent = Number.isFinite(extra) ? money(extra) : '—';
    $('#eb-app-note', root).textContent =
      r && Number.isFinite(extra) && totalKwh > 0
        ? `以上方帳單 ${formatNumber(input.kwh, 2)} 度為基準，再多用 ${kwhText(totalKwh)}，這部分依累進級距平均每度約 ${price(extra / totalKwh)}。用電越多，每多 1 度越貴。`
        : '';
  }

  $('#eb-app-apply', root).addEventListener('click', () => {
    const add = rows().reduce((sum, row) => {
      const k = applianceKwh(
        num(field<HTMLInputElement>(row, 'watts')),
        num(field<HTMLInputElement>(row, 'hours'), 0),
        num(field<HTMLInputElement>(row, 'days'), 0),
      );
      return Number.isFinite(k) ? sum + k : sum;
    }, 0);
    const base = num(kwhIn, 0);
    if (!Number.isFinite(base) || add <= 0) return;
    kwhIn.value = String(Math.round((base + add) * 100) / 100);
    render();
  });

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #eb-output {
    display: grid;
    gap: 16px;
  }
  #eb-output[hidden],
  #eb-range[hidden] {
    display: none;
  }
  .eb-range-hint {
    grid-column: 1 / -1;
  }
  .eb-appliances {
    display: grid;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .eb-h {
    margin: 0;
    font-size: 17px;
  }
  .eb-app-list {
    display: grid;
    gap: 10px;
  }
  .eb-app-list :global(.eb-app-row) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .eb-app-list :global(.eb-app-name) {
    grid-column: 1 / -1;
  }
  .eb-app-list :global(.eb-app-result) {
    grid-column: 1 / -1;
  }
  .eb-app-list :global(.eb-app-remove) {
    grid-column: 1 / -1;
    justify-self: start;
  }
  @media (min-width: 720px) {
    .eb-app-list :global(.eb-app-row) {
      grid-template-columns: minmax(0, 2.2fr) repeat(3, minmax(0, 1fr)) auto;
    }
    .eb-app-list :global(.eb-app-name) {
      grid-column: auto;
    }
    .eb-app-list :global(.eb-app-remove) {
      grid-column: auto;
    }
  }
  #eb-table :global(.eb-group td) {
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface-2);
  }
  #eb-table :global(.eb-total td) {
    font-weight: 700;
    background: var(--surface-2);
  }
</style>
