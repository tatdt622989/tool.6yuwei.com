---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="pdf-merge" {...i18nAttrs(locale, s.client)}>
  <p class="pm-privacy">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    <span><strong>{s.privacyStrong}</strong>{s.privacyText}</span>
  </p>

  <label class="dropzone" id="pm-drop" tabindex="0">
    <input type="file" id="pm-file" accept="application/pdf,.pdf" multiple hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="row" id="pm-try">
    <span class="hint">{s.tryHint}</span>
    <button class="btn small ghost" type="button" id="pm-sample">{s.sample}</button>
  </div>

  <p class="notice error" id="pm-note" hidden></p>

  <ol class="pm-list" id="pm-list" aria-label={s.listAria}></ol>
  <p class="hint" id="pm-order-hint" hidden>{s.orderHint}</p>

  <div class="stats" id="pm-summary" hidden>
    <div class="stat"><span class="stat-value" id="pm-files">0</span><span class="stat-label">{s.statFiles}</span></div>
    <div class="stat"><span class="stat-value" id="pm-pages">0</span><span class="stat-label">{s.statPages}</span></div>
    <div class="stat"><span class="stat-value" id="pm-bytes">0 B</span><span class="stat-label">{s.statBytes}</span></div>
  </div>

  <div class="field" id="pm-name-field" hidden>
    <label for="pm-name">{s.nameLabel}</label>
    <input id="pm-name" type="text" value={s.nameDefault} autocomplete="off" spellcheck="false" />
  </div>

  <div class="row" id="pm-actions" hidden>
    <button class="btn primary" type="button" id="pm-merge" disabled>{s.merge}</button>
    <button class="btn ghost" type="button" id="pm-clear">{s.clear}</button>
  </div>

  <p class="notice ok" id="pm-done" hidden aria-live="polite"></p>
</div>

<script>
  import { $, downloadBlob } from '../../lib/client';
  import { formatBytes, formatInteger, plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { isPdfFile, mergeSummary, moveItem, safeFilename } from './logic';
  import type { Strings } from './i18n';
  import { ICONS, makeSortable } from './sortable';

  type Ops = typeof import('./pdf-ops');

  interface Item {
    id: number;
    name: string;
    size: number;
    bytes: Uint8Array;
    pages?: number;
    error?: string;
    row: HTMLLIElement;
  }

  const root = $('[data-tool="pdf-merge"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const drop = $('#pm-drop', root);
  const fileInput = $<HTMLInputElement>('#pm-file', root);
  const note = $('#pm-note', root);
  const list = $('#pm-list', root);
  const orderHint = $('#pm-order-hint', root);
  const summary = $('#pm-summary', root);
  const nameField = $('#pm-name-field', root);
  const nameInput = $<HTMLInputElement>('#pm-name', root);
  const actions = $('#pm-actions', root);
  const mergeBtn = $<HTMLButtonElement>('#pm-merge', root);
  const done = $('#pm-done', root);
  const tryRow = $('#pm-try', root);

  let items: Item[] = [];
  let nextId = 1;
  let busy = false;
  let opsPromise: Promise<Ops> | null = null;
  const ops = () => (opsPromise ??= import('./pdf-ops'));

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function iconButton(icon: string, label: string, action: string): HTMLButtonElement {
    const b = el('button', 'pm-icon');
    b.type = 'button';
    b.innerHTML = icon;
    b.setAttribute('aria-label', label);
    b.title = label;
    b.dataset.action = action;
    return b;
  }

  function drawRow(item: Item) {
    const row = item.row;
    row.replaceChildren();
    row.dataset.id = String(item.id);
    row.classList.toggle('has-error', Boolean(item.error));
    const grip = el('span', 'pm-grip');
    grip.innerHTML = ICONS.grip;
    grip.title = s.grip;
    const info = el('div', 'pm-info');
    const meta = el('div', 'pm-meta');
    if (item.error) meta.append(el('span', 'pm-error', item.error));
    else if (item.pages === undefined) meta.textContent = t(s.reading, { size: formatBytes(item.size, locale) });
    else meta.textContent = t(s.meta, { pages: plural(locale, item.pages, s.pageCount), size: formatBytes(item.size, locale) });
    info.append(el('div', 'pm-name', item.name), meta);
    const controls = el('div', 'pm-controls');
    controls.append(
      iconButton(ICONS.up, t(s.moveUp, { name: item.name }), 'up'),
      iconButton(ICONS.down, t(s.moveDown, { name: item.name }), 'down'),
      iconButton(ICONS.remove, t(s.remove, { name: item.name }), 'remove'),
    );
    row.append(grip, el('span', 'pm-index'), info, controls);
  }

  function refresh() {
    list.replaceChildren(...items.map((i) => i.row));
    items.forEach((item, index) => {
      const idx = item.row.querySelector('.pm-index');
      if (idx) idx.textContent = String(index + 1);
      const up = item.row.querySelector<HTMLButtonElement>('[data-action="up"]');
      const down = item.row.querySelector<HTMLButtonElement>('[data-action="down"]');
      if (up) up.disabled = index === 0;
      if (down) down.disabled = index === items.length - 1;
    });
    const sum = mergeSummary(items);
    const any = items.length > 0;
    summary.hidden = !any;
    nameField.hidden = !any;
    actions.hidden = !any;
    orderHint.hidden = items.length < 2;
    tryRow.hidden = any;
    $('#pm-files', root).textContent = formatInteger(sum.files, locale);
    $('#pm-pages', root).textContent = formatInteger(sum.pages, locale);
    $('#pm-bytes', root).textContent = formatBytes(sum.bytes, locale);
    mergeBtn.disabled = busy || !sum.ready;
    if (!busy) mergeBtn.textContent = items.length === 1 ? s.needMore : s.merge;
  }

  function showNote(text: string) {
    note.textContent = text;
    note.hidden = !text;
  }

  async function addFiles(files: File[]) {
    const pdfs = files.filter((f) => isPdfFile(f.type, f.name));
    const skipped = files.length - pdfs.length;
    showNote(skipped ? plural(locale, skipped, s.skipped) : '');
    done.hidden = true;
    const added: Item[] = [];
    for (const file of pdfs) {
      const item: Item = {
        id: nextId++,
        name: file.name,
        size: file.size,
        bytes: new Uint8Array(await file.arrayBuffer()),
        row: el('li', 'pm-item'),
      };
      drawRow(item);
      added.push(item);
    }
    items.push(...added);
    refresh();
    if (!added.length) return;
    const { countPages, errorCode } = await ops();
    for (const item of added) {
      try {
        item.pages = await countPages(item.bytes);
      } catch (err) {
        item.error = s.errors[errorCode(err)];
      }
      if (!items.includes(item)) continue;
      drawRow(item);
      refresh();
    }
  }

  function move(from: number, to: number, focusAction?: string) {
    if (to < 0 || to >= items.length || from === to) return;
    items = moveItem(items, from, to);
    done.hidden = true;
    refresh();
    if (focusAction) {
      const target = items[to].row.querySelector<HTMLButtonElement>(`[data-action="${focusAction}"]`);
      (target && !target.disabled ? target : items[to].row.querySelector<HTMLButtonElement>('[data-action="remove"]'))?.focus();
    }
  }

  list.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('button[data-action]');
    if (!button) return;
    const row = button.closest('li');
    const index = items.findIndex((i) => i.row === row);
    if (index < 0) return;
    const action = button.dataset.action;
    if (action === 'up') move(index, index - 1, 'up');
    else if (action === 'down') move(index, index + 1, 'down');
    else if (action === 'remove') {
      items.splice(index, 1);
      done.hidden = true;
      refresh();
      const next = items[Math.min(index, items.length - 1)];
      next?.row.querySelector<HTMLButtonElement>('[data-action="remove"]')?.focus();
    }
  });

  makeSortable({ list, handle: '.pm-grip', onMove: (from, to) => move(from, to) });

  mergeBtn.addEventListener('click', async () => {
    const usable = items.filter((i) => !i.error);
    if (usable.length < 2 || busy) return;
    busy = true;
    mergeBtn.disabled = true;
    done.hidden = true;
    mergeBtn.textContent = s.merging;
    try {
      const { mergePdfs } = await ops();
      const bytes = await mergePdfs(
        usable.map((i) => i.bytes),
        (n, total) => (mergeBtn.textContent = t(s.mergingProgress, { n, total })),
      );
      const blob = new Blob([bytes as Uint8Array<ArrayBuffer>], { type: 'application/pdf' });
      const filename = safeFilename(nameInput.value, s.nameFallback);
      downloadBlob(blob, filename);
      const pages = usable.reduce((s, i) => s + (i.pages ?? 0), 0);
      done.textContent = t(s.done, {
        files: usable.length,
        pages: formatInteger(pages, locale),
        size: formatBytes(blob.size, locale),
        name: filename,
      });
      done.hidden = false;
    } catch (err) {
      const { errorCode } = await ops();
      showNote(t(s.failed, { error: s.errors[errorCode(err)] }));
    } finally {
      busy = false;
      refresh();
    }
  });

  $('#pm-clear', root).addEventListener('click', () => {
    items = [];
    showNote('');
    done.hidden = true;
    refresh();
  });

  $('#pm-sample', root).addEventListener('click', async () => {
    const { makeSamplePdf } = await ops();
    const a = await makeSamplePdf('A', 2, 0.14);
    const b = await makeSamplePdf('B', 3, 0.85);
    await addFiles([
      new File([a as Uint8Array<ArrayBuffer>], 'sample-a.pdf', { type: 'application/pdf' }),
      new File([b as Uint8Array<ArrayBuffer>], 'sample-b.pdf', { type: 'application/pdf' }),
    ]);
  });

  // ---------- File input wiring (same UX as the image tools) ----------
  fileInput.addEventListener('change', () => {
    if (fileInput.files) void addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    if (e.dataTransfer?.files.length) void addFiles(Array.from(e.dataTransfer.files));
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const files = Array.from(e.clipboardData?.files ?? []).filter((f) => isPdfFile(f.type, f.name));
    if (!files.length) return;
    e.preventDefault();
    void addFiles(files);
  });

  refresh();
</script>

<style>
  .pm-privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--success) 30%, transparent);
    border-radius: var(--radius-sm);
  }
  .pm-privacy svg {
    flex: none;
    margin-top: 1px;
    color: var(--success);
  }
  .pm-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pm-list:empty {
    display: none;
  }
  .pm-list :global(.pm-item) {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 8px 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pm-list.is-sorting :global(.pm-item) {
    transition: transform 0.15s ease;
  }
  .pm-list :global(.pm-item.is-dragging) {
    z-index: 2;
    transition: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .pm-list :global(.pm-item.has-error) {
    border-color: color-mix(in oklab, var(--danger) 40%, transparent);
  }
  .pm-list :global(.pm-grip) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 40px;
    color: var(--muted);
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .pm-list :global(.is-dragging .pm-grip) {
    cursor: grabbing;
  }
  .pm-list :global(.pm-index) {
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .pm-list :global(.pm-info) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .pm-list :global(.pm-name) {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pm-list :global(.pm-meta) {
    font-size: 13px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .pm-list :global(.pm-error) {
    color: var(--danger);
  }
  .pm-list :global(.pm-controls) {
    display: flex;
    gap: 2px;
  }
  .pm-list :global(.pm-icon) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: var(--text-2);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
  }
  .pm-list :global(.pm-icon:hover:not(:disabled)) {
    color: var(--text);
    background: var(--surface);
    border-color: var(--border);
  }
  .pm-list :global(.pm-icon:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  @media (max-width: 420px) {
    .pm-list :global(.pm-item) {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .pm-list :global(.pm-index) {
      display: none;
    }
    .pm-list :global(.pm-icon) {
      width: 30px;
    }
  }
</style>
