---
import type { ToolProps } from '../../i18n/tool';
import { WORLD_ZONES } from './logic';

// English-only tool: strings live here (see docs/i18n.md §3).
type Props = ToolProps;
const { locale = 'en' } = Astro.props;
---

<div class="tool" data-tool="exact-time" data-locale={locale} data-sync="pending" data-mode="clock">
  <div class="et-face">
    <p class="et-zone" id="et-zone">Your local time</p>
    <div class="big-display et-clock" id="et-clock" role="timer" aria-label="Current local time">--:--:--</div>
    <p class="et-date" id="et-date">&nbsp;</p>

    <div class="et-cd" id="et-cd" hidden>
      <span class="et-cd-label" id="et-cd-label">Time left</span>
      <span class="et-cd-value" id="et-cd-value" role="timer">00:00:00.0</span>
    </div>
  </div>

  <div class="et-status" id="et-status" aria-live="polite">
    <span class="et-dot" aria-hidden="true"></span>
    <span id="et-status-text">Checking your clock against the server…</span>
  </div>

  <div class="et-controls">
    <button class="btn" type="button" id="et-resync">Sync again</button>
    <label class="check"><input type="checkbox" id="et-ms" /> Milliseconds</label>
    <label class="check"><input type="checkbox" id="et-24" /> 24-hour</label>
    <button class="btn" type="button" id="et-fullscreen">Full screen</button>
  </div>

  <div class="stats et-stats">
    <div class="stat"><span class="stat-value" id="et-offset">—</span><span class="stat-label">Device clock error</span></div>
    <div class="stat"><span class="stat-value" id="et-acc">—</span><span class="stat-label">Sync accuracy (±)</span></div>
    <div class="stat"><span class="stat-value" id="et-unix">—</span><span class="stat-label">Unix time (seconds)</span></div>
    <div class="stat"><span class="stat-value" id="et-day">—</span><span class="stat-label">Day of year · ISO week</span></div>
  </div>

  <section class="et-world" aria-labelledby="et-world-title">
    <h2 class="et-title" id="et-world-title">Time around the world</h2>
    <ul class="et-zones" id="et-zones">
      {
        WORLD_ZONES.map((z) => (
          <li data-zone={z.id}>
            <span class="et-city">{z.city}</span>
            <span class="et-z-time">—</span>
            <span class="et-z-meta">&nbsp;</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="et-count" aria-labelledby="et-count-title">
    <h2 class="et-title" id="et-count-title">Countdown to a time</h2>
    <p class="hint">Pick a date and time in your time zone. The countdown runs on the synced clock, to a tenth of a second.</p>
    <div class="et-count-row">
      <div class="field">
        <label for="et-target">Target</label>
        <input id="et-target" type="datetime-local" step="1" />
      </div>
      <button class="btn primary" type="button" id="et-cd-toggle">Start countdown</button>
    </div>
    <div class="row">
      <button class="btn small" type="button" data-preset="hour">Next hour</button>
      <button class="btn small" type="button" data-preset="midnight">Midnight</button>
      <button class="btn small" type="button" data-preset="newyear">New Year</button>
    </div>
    <label class="check"><input type="checkbox" id="et-sound" checked /> Beep for the last 5 seconds</label>
    <p class="notice" id="et-notice" hidden></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import { syncClock } from '../taiwan-time/sync';
  import {
    dayOfYear,
    describeOffset,
    formatAccuracy,
    formatClock,
    formatCountdown,
    formatLongDate,
    formatShortClock,
    formatUtcOffset,
    isoWeek,
    parseLocalDateTime,
    presetTarget,
    toDateTimeLocal,
    utcOffsetMinutes,
    zonedTimeToEpoch,
    zoneParts,
    type OffsetEstimate,
  } from './logic';

  interface Prefs {
    showMs: boolean;
    h24: boolean;
    target: string;
    sound: boolean;
  }

  const AFTER_TARGET_MS = 60_000;
  const root = $('[data-tool="exact-time"]');
  const locale = (root.dataset.locale ?? 'en') as Locale;
  const zoneEl = $('#et-zone', root);
  const clockEl = $('#et-clock', root);
  const dateEl = $('#et-date', root);
  const statusText = $('#et-status-text', root);
  const resyncBtn = $<HTMLButtonElement>('#et-resync', root);
  const msBox = $<HTMLInputElement>('#et-ms', root);
  const h24Box = $<HTMLInputElement>('#et-24', root);
  const fsBtn = $<HTMLButtonElement>('#et-fullscreen', root);
  const offsetEl = $('#et-offset', root);
  const accEl = $('#et-acc', root);
  const unixEl = $('#et-unix', root);
  const dayEl = $('#et-day', root);
  const zoneItems = $$<HTMLLIElement>('#et-zones li', root);
  const cdBox = $('#et-cd', root);
  const cdLabel = $('#et-cd-label', root);
  const cdValue = $('#et-cd-value', root);
  const targetInput = $<HTMLInputElement>('#et-target', root);
  const cdToggle = $<HTMLButtonElement>('#et-cd-toggle', root);
  const soundBox = $<HTMLInputElement>('#et-sound', root);
  const notice = $('#et-notice', root);
  const baseTitle = document.title;

  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  const prefs = loadPref<Partial<Prefs>>('exact-time', {});
  msBox.checked = prefs.showMs === true;
  h24Box.checked = prefs.h24 === true;
  soundBox.checked = prefs.sound !== false;
  targetInput.value =
    prefs.target && parseLocalDateTime(prefs.target) ? prefs.target : toDateTimeLocal(presetTarget('newyear', Date.now(), tz));

  /** server − device, ms. */
  let offset = 0;
  let syncRun = 0;
  let countdownAt: number | null = null;
  let countdownLabel = '';
  let lastSecond = -1;
  let lastClock = '';
  let lastCd = '';
  let lastTitle = '';
  let lastBeep = Number.NaN;

  const now = () => Date.now() + offset;

  function persist() {
    savePref('exact-time', {
      showMs: msBox.checked,
      h24: h24Box.checked,
      target: targetInput.value,
      sound: soundBox.checked,
    } satisfies Prefs);
  }

  function showNotice(text: string, kind: '' | 'error' = '') {
    notice.textContent = text;
    notice.className = kind ? `notice ${kind}` : 'notice';
    notice.hidden = text === '';
  }

  function setTitle(title: string) {
    if (title !== lastTitle) document.title = lastTitle = title;
  }

  /* ---------- Sound ---------- */
  let audio: AudioContext | null = null;
  function unlockAudio() {
    const Ctor = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return;
    audio ??= new Ctor();
    if (audio.state === 'suspended') void audio.resume();
  }
  function beep(frequency: number, duration: number) {
    const ctx = audio;
    if (!ctx || ctx.state !== 'running') return;
    const at = ctx.currentTime + 0.01;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.frequency.value = frequency;
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(0.3, at + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + duration);
    osc.connect(gain).connect(ctx.destination);
    osc.start(at);
    osc.stop(at + duration + 0.02);
  }

  /* ---------- Rendering ---------- */
  function renderSecond(t: number) {
    const hour12 = !h24Box.checked;
    const p = zoneParts(t, tz);
    dateEl.textContent = formatLongDate(p);
    const off = utcOffsetMinutes(t, tz);
    zoneEl.textContent = `Your time · ${tz.replace(/_/g, ' ')} · ${formatUtcOffset(off)}`;
    unixEl.textContent = String(Math.floor(t / 1000));
    const w = isoWeek(p.year, p.month, p.day);
    dayEl.textContent = `${formatInteger(dayOfYear(p.year, p.month, p.day), locale)} · W${w.week}`;
    for (const li of zoneItems) {
      const id = li.dataset.zone!;
      const zp = zoneParts(t, id);
      const dayDiff = Date.UTC(zp.year, zp.month - 1, zp.day) - Date.UTC(p.year, p.month - 1, p.day);
      li.children[1].textContent = formatShortClock(zp.hour, zp.minute, hour12);
      const when = dayDiff > 0 ? 'Tomorrow' : dayDiff < 0 ? 'Yesterday' : 'Today';
      li.children[2].textContent = `${when} · ${formatUtcOffset(utcOffsetMinutes(t, id))}`;
    }
  }

  function renderCountdown(t: number) {
    if (countdownAt === null) return;
    const remaining = countdownAt - t;
    let text: string;
    if (remaining > 0) {
      text = formatCountdown(remaining);
      cdLabel.textContent = `Time left until ${countdownLabel}`;
      root.dataset.mode = remaining <= 10_000 ? 'final' : 'countdown';
      const whole = Math.ceil(remaining / 1000);
      if (soundBox.checked && whole <= 5 && whole !== lastBeep) {
        lastBeep = whole;
        beep(880, 0.12);
      }
      setTitle(`${formatCountdown(remaining, false)} left`);
    } else if (-remaining < AFTER_TARGET_MS) {
      text = `+${formatCountdown(-remaining)}`;
      cdLabel.textContent = `${countdownLabel} — time’s up`;
      root.dataset.mode = 'go';
      if (soundBox.checked && lastBeep !== 0) {
        lastBeep = 0;
        beep(1320, 0.5);
      }
      setTitle('Time’s up');
    } else {
      stopCountdown();
      return;
    }
    if (text !== lastCd) cdValue.textContent = lastCd = text;
  }

  function frame() {
    const t = now();
    const second = Math.floor(t / 1000);
    const p = zoneParts(t, tz);
    const clock = formatClock(p.hour, p.minute, p.second, ((t % 1000) + 1000) % 1000, !h24Box.checked, msBox.checked);
    if (clock !== lastClock) {
      clockEl.textContent = lastClock = clock;
      if (countdownAt === null) setTitle(`${formatClock(p.hour, p.minute, p.second, 0, !h24Box.checked)} · ${baseTitle}`);
    }
    if (second !== lastSecond) {
      lastSecond = second;
      renderSecond(t);
    }
    renderCountdown(t);
    requestAnimationFrame(frame);
  }

  function renderSync(est: OffsetEstimate | null, state: 'pending' | 'ok' | 'fail', progress = '') {
    root.dataset.sync = state;
    resyncBtn.disabled = state === 'pending';
    if (state === 'pending') {
      statusText.textContent = `Checking your clock against the server…${progress}`;
      return;
    }
    if (state === 'fail' || !est) {
      statusText.textContent =
        'Couldn’t reach the time server, so this is your device’s own clock. Check your connection and press Sync again.';
      offsetEl.textContent = 'Not synced';
      accEl.textContent = '—';
      return;
    }
    const d = describeOffset(est.offset, est.accuracy);
    statusText.textContent = `Synced. ${d.text} The time shown is corrected, accurate to about ±${formatAccuracy(est.accuracy)}.`;
    if (est.accuracy > 250) statusText.textContent += ' Your connection is slow; sync again on a steadier network for a tighter result.';
    offsetEl.textContent = d.short;
    accEl.textContent = formatAccuracy(est.accuracy);
  }

  async function sync() {
    const run = ++syncRun;
    renderSync(null, 'pending');
    const est = await syncClock({
      cancelled: () => run !== syncRun,
      onProgress: (e, round, rounds) => {
        offset = e.offset;
        renderSync(e, 'pending', round > 0 ? ` (${round}/${rounds})` : '');
      },
    });
    if (run !== syncRun) return;
    offset = est ? est.offset : 0;
    renderSync(est, est ? 'ok' : 'fail');
  }

  /* ---------- Countdown ---------- */
  function startCountdown() {
    const p = parseLocalDateTime(targetInput.value);
    if (!p) return showNotice('Pick a valid date and time.', 'error');
    const at = zonedTimeToEpoch(p, tz);
    if (at <= now()) return showNotice('That time has already passed. Pick a time in the future.', 'error');
    showNotice('');
    if (soundBox.checked) unlockAudio();
    countdownAt = at;
    const zp = zoneParts(at, tz);
    countdownLabel = `${formatLongDate(zp)}, ${formatShortClock(zp.hour, zp.minute, !h24Box.checked)}${zp.second ? ` +${zp.second}s` : ''}`;
    lastBeep = Number.NaN;
    lastCd = '';
    cdBox.hidden = false;
    cdToggle.textContent = 'Stop countdown';
    persist();
  }

  function stopCountdown() {
    countdownAt = null;
    cdBox.hidden = true;
    root.dataset.mode = 'clock';
    cdToggle.textContent = 'Start countdown';
    lastClock = '';
  }

  cdToggle.addEventListener('click', () => (countdownAt === null ? startCountdown() : stopCountdown()));
  targetInput.addEventListener('change', () => {
    persist();
    if (countdownAt !== null) startCountdown();
  });
  for (const b of $$<HTMLButtonElement>('[data-preset]', root)) {
    b.addEventListener('click', () => {
      targetInput.value = toDateTimeLocal(presetTarget(b.dataset.preset as 'hour' | 'midnight' | 'newyear', now(), tz));
      startCountdown();
    });
  }
  soundBox.addEventListener('change', () => {
    persist();
    if (soundBox.checked) unlockAudio();
  });

  /* ---------- Controls ---------- */
  resyncBtn.addEventListener('click', () => void sync());
  msBox.addEventListener('change', () => {
    root.classList.toggle('with-ms', msBox.checked);
    lastClock = '';
    persist();
  });
  h24Box.addEventListener('change', () => {
    lastClock = '';
    lastSecond = -1;
    persist();
  });
  root.classList.toggle('with-ms', msBox.checked);

  if (!document.fullscreenEnabled) fsBtn.hidden = true;
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else root.requestFullscreen().catch(() => showNotice('Full screen isn’t available here.', 'error'));
  });
  document.addEventListener('fullscreenchange', () => {
    fsBtn.textContent = document.fullscreenElement === root ? 'Exit full screen' : 'Full screen';
  });

  let hiddenAt = 0;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) hiddenAt = Date.now();
    else if (hiddenAt && Date.now() - hiddenAt > 10 * 60_000) void sync();
  });

  requestAnimationFrame(frame);
  void sync();
</script>

<style>
  .et-face {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px 0 4px;
    text-align: center;
  }
  .et-zone {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .et-clock {
    font-size: clamp(34px, 12vw, 112px);
    white-space: nowrap;
  }
  .with-ms .et-clock {
    font-size: clamp(24px, 8.4vw, 96px);
  }
  .et-date {
    margin: 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .et-cd {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin-top: 12px;
    padding: 12px 16px;
    width: 100%;
    max-width: 560px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .et-cd-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .et-cd-value {
    font-family: var(--mono);
    font-size: clamp(24px, 8vw, 56px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  [data-mode='final'] .et-cd,
  [data-mode='go'] .et-cd {
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  [data-mode='final'] .et-cd-value,
  [data-mode='go'] .et-cd-value,
  [data-mode='go'] .et-cd-label {
    color: var(--accent);
  }

  .et-status {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    font-size: 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-2);
  }
  .et-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--muted);
  }
  [data-sync='ok'] .et-dot {
    background: var(--success);
  }
  [data-sync='fail'] .et-status {
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 10%, transparent);
  }
  [data-sync='fail'] .et-dot {
    background: var(--danger);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-sync='pending'] .et-dot {
      animation: et-pulse 1s ease-in-out infinite;
    }
  }
  @keyframes et-pulse {
    50% {
      opacity: 0.25;
    }
  }
  .et-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
  }
  .et-stats {
    grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
  }
  .et-stats .stat-value {
    font-size: 16px;
  }

  .et-world,
  .et-count {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .et-title {
    font-size: 18px;
  }
  .et-count .hint {
    margin: -6px 0 0;
  }
  .et-zones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .et-zones li {
    display: grid;
    gap: 1px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .et-city {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .et-z-time {
    font-size: 19px;
    white-space: nowrap;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .et-z-meta {
    font-size: 12px;
    color: var(--muted);
  }
  .et-count-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    align-items: end;
    gap: 10px;
  }
  .et-count-row .btn {
    min-height: 44px;
  }

  .tool:fullscreen {
    align-content: center;
    padding: 24px;
    background: var(--bg);
    color: var(--text);
  }
  .tool:fullscreen .et-stats,
  .tool:fullscreen .et-world,
  .tool:fullscreen .et-count,
  .tool:fullscreen .et-status {
    display: none;
  }
  .tool:fullscreen .et-clock {
    font-size: min(15vw, 30vh);
  }
  .tool.with-ms:fullscreen .et-clock {
    font-size: min(10vw, 26vh);
  }
  .tool:fullscreen .et-date {
    font-size: min(3.2vw, 28px);
  }
</style>
