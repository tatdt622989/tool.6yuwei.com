    border-radius: var(--radius);
  }
  /* Read from across a room: everything scales with the screen height. */
  .ge-stage.is-fullscreen {
    grid-template-rows: auto 1fr auto;
    gap: 2vh;
    padding: 3vh 5vw;
    overflow: auto;
    border-radius: 0;
