---
import Icon from '../../components/Icon.astro';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import CardStage from '../scratch-card/CardStage.astro';
import GiftBox from './GiftBox.astro';
import { LIMITS, MODES, type Mode } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const modeIcons: Record<Mode, string> = { link: 'Link', pass: 'Smartphone', stage: 'Presentation' };
---

<div class="tool" data-tool="gift-exchange" {...i18nAttrs(locale, s.client)}>
  <script is:inline>
    // Runs before first paint and before ads ask for the page URL: the invite moves out of the address
    // bar so it cannot travel any further, and the form does not flash up while the tool loads.
    (function (root) {
      var key = 'gift-exchange:invite';
      var hash = location.hash;
      var nav = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
      var returned = nav && (nav.type === 'reload' || nav.type === 'back_forward');
      if (hash.indexOf('#gift=') === 0) {
        history.replaceState(null, '', location.pathname + location.search);
      } else {
        hash = '';
      }
      try {
        if (hash) sessionStorage.setItem(key, hash);
        else if (returned) hash = sessionStorage.getItem(key) || '';
        else sessionStorage.removeItem(key);
      } catch (e) {}
      if (hash) {
        root.dataset.invite = hash;
        root.dataset.view = 'opening';
      }
    })(document.currentScript.parentElement);
  </script>

  <section class="ge-setup" id="ge-setup">
    <div class="notice error" id="ge-link-error" role="alert" hidden></div>

    <div class="field">
      <div class="ge-label-row">
        <label for="ge-names">{s.namesLabel}</label>
        <span class="hint ge-count" id="ge-count"></span>
        <button class="btn small ghost" type="button" id="ge-sample">{s.sample}</button>
      </div>
      <textarea id="ge-names" rows="6" placeholder={s.namesPlaceholder} autocomplete="off" spellcheck="false"></textarea>
    </div>

    <div class="field">
      <span class="label" id="ge-mode-label">{s.modeLabel}</span>
      <div class="ge-modes" role="radiogroup" aria-labelledby="ge-mode-label">
        {
          MODES.map((mode) => (
            <label class="ge-mode">
              <input type="radio" name="ge-mode" value={mode} />
              <Icon name={modeIcons[mode]} size={22} class="ge-mode-icon" />
              <span class="ge-mode-title">{s.modes[mode].title}</span>
              <span class="ge-mode-desc">{s.modes[mode].desc}</span>
            </label>
          ))
        }
      </div>
    </div>

    <details class="ge-more" id="ge-exclude">
      <summary>{s.excludeSummary}</summary>
      <div class="ge-more-body">
        <p class="hint">{s.excludeHint}</p>
        <div class="ge-exclude-row">
          <select id="ge-pair-a" aria-label={s.excludeFirst}></select>
          <select id="ge-pair-b" aria-label={s.excludeSecond}></select>
          <button class="btn" type="button" id="ge-pair-add">{s.excludeAdd}</button>
        </div>
        <p class="hint ge-pair-error" id="ge-pair-error" role="alert" hidden></p>
        <ul class="ge-pairs" id="ge-pairs"></ul>
      </div>
    </details>

    <details class="ge-more" id="ge-details">
      <summary>{s.detailsSummary}</summary>
      <div class="ge-more-body">
        <p class="hint">{s.detailsHint}</p>
        <div class="field">
          <label for="ge-title">{s.titleLabel}</label>
          <input id="ge-title" type="text" maxlength={LIMITS.title} placeholder={s.titlePlaceholder} autocomplete="off" />
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="ge-budget">{s.budgetLabel}</label>
            <input id="ge-budget" type="text" maxlength={LIMITS.budget} placeholder={s.budgetPlaceholder} autocomplete="off" />
          </div>
          <div class="field">
            <label for="ge-date">{s.dateLabel}</label>
            <input id="ge-date" type="date" />
          </div>
        </div>
        <div class="field">
          <label for="ge-note">{s.noteLabel}</label>
          <input id="ge-note" type="text" maxlength={LIMITS.note} placeholder={s.notePlaceholder} autocomplete="off" />
        </div>
      </div>
    </details>

    <div class="notice error" id="ge-error" role="alert" hidden></div>
    <button class="btn primary ge-start" type="button" id="ge-start"><Icon name="Gift" size={20} />{s.start}</button>
    <p class="ge-note"><Icon name="ShieldCheck" size={18} class="ge-note-icon" /><span>{s.privacyNote}</span></p>
  </section>

  <section class="ge-links" id="ge-links" hidden>
    <div class="ge-links-head">
      <p class="ge-heading" id="ge-links-heading" role="heading" aria-level="2" tabindex="-1">{s.linksHeading}</p>
      <p class="ge-links-note">{s.linksNote}</p>
    </div>
    <div class="ge-links-bar">
      <span class="ge-links-progress" id="ge-links-progress" aria-live="polite"></span>
      <button class="btn small" type="button" id="ge-copy-all"><Icon name="Copy" size={16} /><span id="ge-copy-all-label">{s.copyAll}</span></button>
    </div>
    <ul class="ge-link-list" id="ge-link-list"></ul>
    <p class="hint">{s.copyAllHint}</p>

    <details class="ge-more" data-results>
      <summary>{s.organizerSummary}</summary>
      <div class="ge-more-body">
        <p class="hint">{s.organizerHint}</p>
        <ol class="ge-results" data-results-list></ol>
        <div><button class="btn small" type="button" data-results-copy><Icon name="Copy" size={16} /><span>{s.copyResults}</span></button></div>
      </div>
    </details>
    <div><button class="btn small ghost" type="button" data-redraw><Icon name="RotateCcw" size={16} /><span>{s.client.redraw}</span></button></div>
  </section>

  <section class="ge-stage" id="ge-stage" hidden>
    <canvas class="ge-confetti" id="ge-confetti" aria-hidden="true"></canvas>

    <div class="ge-bar" id="ge-bar">
      <p class="ge-bar-title" id="ge-bar-title"></p>
      <span class="ge-bar-progress" id="ge-bar-progress"></span>
      <button class="btn small ghost" type="button" id="ge-sound">
        <span class="ge-sound-icon" id="ge-sound-on"><Icon name="Volume2" size={16} /></span>
        <span class="ge-sound-icon" id="ge-sound-off" hidden><Icon name="VolumeX" size={16} /></span>
      </button>
      <button class="btn small ghost" type="button" id="ge-fs" hidden><Icon name="Maximize" size={16} /><span class="ge-fs-label" id="ge-fs-label">{s.client.fullscreen}</span></button>
      <div class="ge-track" id="ge-track" aria-hidden="true"><span id="ge-track-fill"></span></div>
    </div>

    <div class="ge-step ge-handoff" id="ge-handoff" hidden>
      <p class="ge-lead">{s.handoffLead}</p>
      <p class="ge-big-name" id="ge-handoff-name" role="heading" aria-level="2" tabindex="-1"></p>
      <p class="hint">{s.handoffNote}</p>
      <button class="btn primary ge-cta" type="button" id="ge-handoff-go"></button>
      <button class="btn small ghost" type="button" data-skip></button>
    </div>

    <div class="ge-step ge-pick" id="ge-pick" hidden>
      <p class="ge-heading" id="ge-pick-lead" role="heading" aria-level="2" tabindex="-1"></p>
      <div class="ge-board" id="ge-board" role="group" aria-label={s.boardAria}></div>
      <button class="btn small ghost" type="button" data-skip id="ge-pick-skip"></button>
      <div class="ge-revealed" id="ge-revealed" hidden>
        <p class="ge-revealed-h" role="heading" aria-level="3">{s.revealedHeading}</p>
        <ol class="ge-results" id="ge-revealed-list"></ol>
      </div>
    </div>

    <div class="ge-step ge-open" id="ge-open" hidden>
      <div class="ge-open-head" id="ge-open-head">
        <p class="ge-heading" id="ge-open-heading" role="heading" aria-level="2" tabindex="-1"></p>
        <p class="ge-warn" id="ge-open-warn" hidden></p>
      </div>
      <button class="ge-big" type="button" id="ge-big">
        <GiftBox />
        <span class="ge-big-hint"><Icon name="Hand" size={16} />{s.tapToOpen}</span>
      </button>
      <div class="ge-card-wrap" id="ge-card-wrap" hidden>
        <CardStage id="x" canvasAria={s.canvasAria} plainTitle />
        <p class="ge-scratch-hint" id="ge-scratch-hint"><Icon name="Hand" size={16} /> {s.scratchHint}</p>
        <dl class="ge-facts" id="ge-facts" hidden></dl>
        <div class="ge-actions">
          <button class="btn" type="button" id="ge-reveal-all"><Icon name="Eye" size={18} />{s.revealAll}</button>
          <button class="btn primary ge-cta" type="button" id="ge-next" hidden></button>
          <button class="btn primary" type="button" id="ge-make" hidden><Icon name="Gift" size={18} />{s.makeOwn}</button>
        </div>
      </div>
      <p class="visually-hidden" id="ge-live" aria-live="polite"></p>
    </div>

    <div class="ge-step ge-done" id="ge-done" hidden>
      <p class="ge-heading" id="ge-done-heading" role="heading" aria-level="2" tabindex="-1">{s.doneHeading}</p>
      <p class="ge-done-text" id="ge-done-text"></p>
      <details class="ge-more" id="ge-done-results" data-results>
        <summary id="ge-done-summary"></summary>
        <div class="ge-more-body">
          <ol class="ge-results" data-results-list></ol>
          <div><button class="btn small" type="button" data-results-copy><Icon name="Copy" size={16} /><span>{s.copyResults}</span></button></div>
        </div>
      </details>
    </div>

    <div class="ge-foot" id="ge-foot">
      <button class="btn small ghost" type="button" data-redraw><Icon name="RotateCcw" size={16} /><span>{s.client.redraw}</span></button>
    </div>
  </section>

  <template id="ge-box-tpl">
    <button class="ge-box" type="button"><GiftBox /></button>
  </template>
  <template id="ge-pair-tpl">
    <li class="ge-pair"><span class="ge-pair-text"></span><button class="ge-pair-del" type="button">×</button></li>
  </template>
  <template id="ge-link-tpl">
    <li class="ge-link">
      <Icon name="CircleCheck" size={18} class="ge-link-check" />
      <span class="ge-link-name"></span>
      <div class="ge-link-actions">
        <button class="btn small" type="button" data-link-copy><Icon name="Copy" size={16} /><span data-link-copy-label>{s.copyOne}</span></button>
        {s.client.line && <a class="btn small" data-link-line target="_blank" rel="noopener nofollow">LINE</a>}
        {!s.client.line && <button class="btn small" type="button" data-link-share hidden><Icon name="Share2" size={16} />{s.share}</button>}
      </div>
    </li>
  </template>
</div>

<script>
  import { $, $$, copyText, debounce, flashButton, loadPref, savePref } from '../../lib/client';
  import { track as trackEvent } from '../../lib/analytics';
  import { readI18n } from '../../i18n/client';
  import { formatDate, formatList, plural, t } from '../../i18n/format';
  import { confetti } from '../birthday-candles/confetti';
  import { fitFontSize } from '../scratch-card/logic';
  import { ScratchLayer } from '../scratch-card/scratch';
  import type { Strings } from './i18n';
  import { GiftSounds } from './sound';
  import {
    activePairs,
    checkNames,
    decodeInvite,
    duplicateNames,
    finishTurn,
    fitBoard,
    inviteUrl,
    isFinished,
    LIMITS,
    markSent,
    normalizeDetails,
    normalizeDraft,
    normalizeSession,
    parseNames,
    resultRows,
    sessionInvite,
    skipTurn,
    startSession,
    type Details,
    type Draft,
    type Invite,
    type Mode,
    type Pair,
    type Session,
  } from './logic';

  const root = $('[data-tool="gift-exchange"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const DRAFT_KEY = `gift-exchange:${locale}`;
  const SESSION_KEY = `gift-exchange:${locale}:session`;
  const INVITE_KEY = 'gift-exchange:invite';
  const SOUND_KEY = 'gift-exchange:sound';
  /** Gap between scratch sounds, so a fast stroke does not pile them up. */
  const SCRATCH_SOUND_MS = 70;
  /** A box never takes more than this share of the screen height, even with three people. */
  const MAX_BOX_SHARE = 0.4;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const GIFTS: [string, string][] = [
    ['#f0522e', '#f7c948'],
    ['#12936a', '#f4d35e'],
    ['#2f7de1', '#ffd6e0'],
    ['#e84f86', '#fff0c2'],
    ['#7a5cf0', '#ffd166'],
    ['#c8321a', '#fff4dc'],
    ['#1f6f8b', '#ffb4a2'],
    ['#262b57', '#f7d27a'],
  ];
  const CONFETTI = ['#f0522e', '#f5c24b', '#12936a', '#2f7de1', '#e84f86', '#7a5cf0', '#ffffff'];

  function paintGift(el: HTMLElement, index: number) {
    const [gift, ribbon] = GIFTS[index % GIFTS.length];
    el.style.setProperty('--gift', gift);
    el.style.setProperty('--ribbon', ribbon);
  }

  function clone(templateId: string): HTMLElement {
    return $<HTMLTemplateElement>(templateId, root).content.firstElementChild!.cloneNode(true) as HTMLElement;
  }

  /* ---------- Views ---------- */
  const setupEl = $('#ge-setup', root);
  const linksEl = $('#ge-links', root);
  const stage = $('#ge-stage', root);
  type View = 'setup' | 'links' | 'stage';
  type Step = 'handoff' | 'pick' | 'open' | 'done';
  const steps: Record<Step, HTMLElement> = {
    handoff: $('#ge-handoff', root),
    pick: $('#ge-pick', root),
    open: $('#ge-open', root),
    done: $('#ge-done', root),
  };

  let session: Session | null = null;
  const sounds = new GiftSounds(loadPref(SOUND_KEY, true));

  function setView(view: View) {
    root.dataset.view = view;
    setupEl.hidden = view !== 'setup';
    linksEl.hidden = view !== 'links';
    stage.hidden = view !== 'stage';
    if (view !== 'stage' && document.fullscreenElement === stage) void document.exitFullscreen();
  }

  function setStep(step: Step) {
    stopConfetti();
    for (const [name, el] of Object.entries(steps)) el.hidden = name !== step;
    stage.dataset.step = step;
  }

  /**
   * Moves keyboard and screen reader users to the new content and brings it into view. The jump is
   * instant: the view that was on screen has just been replaced, so there is nothing to scroll past.
   */
  function bringIntoView(heading: HTMLElement | null) {
    heading?.focus({ preventScroll: true });
    if (document.fullscreenElement) return;
    const target = root.dataset.view === 'stage' ? stage : linksEl;
    const top = target.getBoundingClientRect().top;
    if (top < 100 || top > window.innerHeight * 0.3) target.scrollIntoView({ block: 'start', behavior: 'instant' });
  }

  function saveSession() {
    savePref(SESSION_KEY, session);
  }

  /* ---------- Setup form ---------- */
  const namesInput = $<HTMLTextAreaElement>('#ge-names', root);
  const countEl = $('#ge-count', root);
  const errorEl = $('#ge-error', root);
  const linkError = $('#ge-link-error', root);
  const modeRadios = $$<HTMLInputElement>('input[name="ge-mode"]', root);
  const pairA = $<HTMLSelectElement>('#ge-pair-a', root);
  const pairB = $<HTMLSelectElement>('#ge-pair-b', root);
  const pairError = $('#ge-pair-error', root);
  const pairsEl = $('#ge-pairs', root);
  const excludeEl = $<HTMLDetailsElement>('#ge-exclude', root);
  const detailsEl = $<HTMLDetailsElement>('#ge-details', root);
  const titleInput = $<HTMLInputElement>('#ge-title', root);
  const budgetInput = $<HTMLInputElement>('#ge-budget', root);
  const dateInput = $<HTMLInputElement>('#ge-date', root);
  const noteInput = $<HTMLInputElement>('#ge-note', root);

  let draft: Draft = normalizeDraft(loadPref<unknown>(DRAFT_KEY, null));
  const saveDraft = debounce(() => savePref(DRAFT_KEY, draft), 300);

  function readDetails(): Details {
    return normalizeDetails({ title: titleInput.value, budget: budgetInput.value, date: dateInput.value, note: noteInput.value });
  }

  function writeForm() {
    namesInput.value = draft.namesText;
    for (const radio of modeRadios) radio.checked = radio.value === draft.mode;
    titleInput.value = draft.details.title;
    budgetInput.value = draft.details.budget;
    dateInput.value = draft.details.date;
    noteInput.value = draft.details.note;
    excludeEl.open = draft.pairs.length > 0;
    detailsEl.open = Boolean(draft.details.title || draft.details.budget || draft.details.date || draft.details.note);
  }

  function fillSelect(select: HTMLSelectElement, names: string[]) {
    const kept = select.value;
    select.replaceChildren(...names.map((name) => new Option(name, name)));
    if (names.includes(kept)) select.value = kept;
  }

  function renderPairs(names: string[]) {
    const known = new Set(activePairs(names, draft.pairs).map(([a, b]) => `${names[a]}\n${names[b]}`));
    const rows = draft.pairs.map(([a, b], index) => {
      const row = clone('#ge-pair-tpl');
      const label = t(s.pairLabel, { a, b });
      $('.ge-pair-text', row).textContent = label;
      row.classList.toggle('is-off', !known.has(`${a}\n${b}`));
      const del = $<HTMLButtonElement>('.ge-pair-del', row);
      del.setAttribute('aria-label', t(s.removePair, { pair: label }));
      del.addEventListener('click', () => {
        draft.pairs.splice(index, 1);
        renderSetup();
        saveDraft();
      });
      return row;
    });
    pairsEl.replaceChildren(...rows);
  }

  function renderSetup() {
    const names = parseNames(namesInput.value);
    countEl.textContent = names.length ? plural(locale, names.length, s.count) : '';
    fillSelect(pairA, names);
    fillSelect(pairB, names);
    if (pairA.value === pairB.value && names.length > 1) pairB.value = names.find((name) => name !== pairA.value) ?? '';
    renderPairs(names);
  }

  function onFormChange() {
    draft = {
      namesText: namesInput.value,
      mode: (modeRadios.find((radio) => radio.checked)?.value as Mode) ?? draft.mode,
      pairs: draft.pairs,
      details: readDetails(),
    };
    errorEl.hidden = true;
    renderSetup();
    saveDraft();
  }

  setupEl.addEventListener('input', onFormChange);
  setupEl.addEventListener('change', onFormChange);

  $('#ge-sample', root).addEventListener('click', () => {
    namesInput.value = s.sampleNames.join('\n');
    onFormChange();
  });

  $('#ge-pair-add', root).addEventListener('click', () => {
    const pair: Pair = [pairA.value, pairB.value];
    pairError.hidden = Boolean(pair[0] && pair[1] && pair[0] !== pair[1]);
    if (!pairError.hidden) {
      pairError.textContent = s.excludeNeedTwo;
      return;
    }
    const same = draft.pairs.some(([a, b]) => (a === pair[0] && b === pair[1]) || (a === pair[1] && b === pair[0]));
    if (!same) draft.pairs.push(pair);
    renderSetup();
    saveDraft();
  });

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  $('#ge-start', root).addEventListener('click', () => {
    onFormChange();
    const names = parseNames(namesInput.value);
    const problem = checkNames(names);
    if (problem === 'few') return showError(t(s.errorFew, { min: LIMITS.minNames }));
    if (problem === 'many') return showError(t(s.errorMany, { max: LIMITS.maxNames, n: names.length }));
    if (problem === 'duplicate') return showError(t(s.errorDuplicate, { names: formatList(duplicateNames(names), locale) }));
    const next = startSession(draft.mode, names, draft.pairs, draft.details);
    if (!next) return showError(s.errorImpossible);
    session = next;
    takenBoxes.clear();
    saveSession();
    savePref(DRAFT_KEY, draft);
    resume();
  });

  /* ---------- Link mode ---------- */
  const linkList = $('#ge-link-list', root);
  const linksProgress = $('#ge-links-progress', root);
  const pageUrl = () => location.origin + location.pathname + location.search;

  function inviteOf(person: number): { url: string; message: string } {
    const url = inviteUrl(pageUrl(), sessionInvite(session!, person));
    return { url, message: t(s.inviteMessage, { name: session!.names[person], url }) };
  }

  function markLinkSent(person: number, row: HTMLElement) {
    session = markSent(session!, person);
    saveSession();
    row.classList.add('is-sent');
    syncLinksProgress();
  }

  function syncLinksProgress() {
    linksProgress.textContent = t(s.linksProgress, { done: session!.sent.length, total: session!.names.length });
  }

  function renderLinks() {
    const rows = session!.names.map((name, person) => {
      const row = clone('#ge-link-tpl');
      const invite = inviteOf(person);
      $('.ge-link-name', row).textContent = name;
      row.classList.toggle('is-sent', session!.sent.includes(person));
      const copyBtn = $<HTMLButtonElement>('[data-link-copy]', row);
      copyBtn.addEventListener('click', async () => {
        if (await copyText(invite.message)) {
          flashButton($('[data-link-copy-label]', row));
          markLinkSent(person, row);
        }
      });
      const lineLink = row.querySelector<HTMLAnchorElement>('[data-link-line]');
      if (lineLink) {
        lineLink.href = `https://line.me/R/share?text=${encodeURIComponent(invite.message)}`;
        lineLink.addEventListener('click', () => markLinkSent(person, row));
      }
      const shareBtn = row.querySelector<HTMLButtonElement>('[data-link-share]');
      if (shareBtn && typeof navigator.share === 'function') {
        shareBtn.hidden = false;
        shareBtn.addEventListener('click', () => {
          navigator.share({ title: s.shareTitle, text: invite.message }).then(() => {
            markLinkSent(person, row);
            trackEvent('share', { method: 'native', content_type: 'tool_result' });
          }, () => {});
        });
      }
      return row;
    });
    linkList.replaceChildren(...rows);
    syncLinksProgress();
  }

  $('#ge-copy-all', root).addEventListener('click', async () => {
    const text = session!.names.map((name, person) => t(s.copyAllLine, { name, url: inviteOf(person).url })).join('\n');
    if (await copyText(text)) {
      flashButton($('#ge-copy-all-label', root));
      session!.names.forEach((_, person) => (session = markSent(session!, person)));
      saveSession();
      for (const row of linkList.children) row.classList.add('is-sent');
      syncLinksProgress();
    }
  });

  /* ---------- Live draw ---------- */
  const barEl = $('#ge-bar', root);
  const barTitle = $('#ge-bar-title', root);
  const barProgress = $('#ge-bar-progress', root);
  const track = $('#ge-track', root);
  const trackFill = $('#ge-track-fill', root);
  const footEl = $('#ge-foot', root);
  const handoffName = $('#ge-handoff-name', root);
  const handoffGo = $<HTMLButtonElement>('#ge-handoff-go', root);
  const pickLead = $('#ge-pick-lead', root);
  const pickSkip = $<HTMLButtonElement>('#ge-pick-skip', root);
  const board = $('#ge-board', root);
  const revealedBox = $('#ge-revealed', root);
  const revealedList = $('#ge-revealed-list', root);
  const skipButtons = $$<HTMLButtonElement>('[data-skip]', root);
  /** Boxes already opened on the board. Decoration only: the box does not decide the result. */
  const takenBoxes = new Set<number>();

  const currentPerson = () => session!.queue[0];

  function renderBar() {
    const total = session!.names.length;
    const done = session!.drawn.length;
    barEl.hidden = false;
    barTitle.textContent = session!.details.title || s.defaultTitle;
    barProgress.textContent = isFinished(session!) ? '' : t(s.progress, { current: done + 1, total });
    track.hidden = false;
    trackFill.style.width = `${(done / total) * 100}%`;
    fsBtn.hidden = !(session!.mode === 'stage' && document.fullscreenEnabled && typeof stage.requestFullscreen === 'function');
    footEl.hidden = false;
    const name = isFinished(session!) ? '' : session!.names[currentPerson()];
    const canSkip = session!.queue.length > 1;
    for (const button of skipButtons) {
      button.hidden = !canSkip;
      button.textContent = t(s.skip, { name });
    }
  }

  function showHandoff() {
    renderBar();
    const name = session!.names[currentPerson()];
    handoffName.textContent = name;
    handoffGo.textContent = t(s.handoffGo, { name });
    setStep('handoff');
    bringIntoView(handoffName);
  }

  function renderBoard() {
    const count = session!.names.length;
    for (let i = 0; takenBoxes.size < session!.drawn.length && i < count; i++) takenBoxes.add(i);
    const boxes = Array.from({ length: count }, (_, index) => {
      const box = clone('#ge-box-tpl') as HTMLButtonElement;
      paintGift(box, index);
      box.dataset.box = String(index);
      box.setAttribute('aria-label', t(s.boxAria, { n: index + 1 }));
      if (takenBoxes.has(index)) {
        box.classList.add('is-taken');
        box.disabled = true;
      }
      return box;
    });
    board.replaceChildren(...boxes);
  }

  function renderRevealed() {
    const open = session!.mode === 'stage' && session!.drawn.length > 0;
    revealedBox.hidden = !open;
    if (!open) return;
    const rows = resultRows(session!).slice(0, session!.drawn.length);
    revealedList.replaceChildren(...rows.reverse().map((row) => rowItem(row)));
  }

  function showPick() {
    renderBar();
    pickLead.textContent = t(s.pickLead, { name: session!.names[currentPerson()] });
    pickSkip.hidden = session!.mode !== 'stage' || session!.queue.length < 2;
    renderBoard();
    renderRevealed();
    setStep('pick');
    layoutBoard();
    bringIntoView(pickLead);
  }

  board.addEventListener('click', (event) => {
    const box = (event.target as Element).closest<HTMLButtonElement>('[data-box]');
    if (!box || box.disabled || !session) return;
    const index = Number(box.dataset.box);
    sounds.play('pick');
    takenBoxes.add(index);
    const person = currentPerson();
    const name = session.names[person];
    const target = session.names[session.targets[person]];
    const pass = session.mode === 'pass';
    const last = session.queue.length === 1;
    startOpening({
      heading: '',
      warn: '',
      title: pass ? t(s.giveTitle, { name }) : t(s.getTitle, { name }),
      message: pass ? target : t(s.getMessage, { target }),
      scratch: pass,
      facts: pass ? session.details : null,
      nextLabel: pass ? (last ? s.lastPass : s.nextPass) : last ? s.lastStage : s.nextStage,
      gift: index,
      auto: true,
    });
  });

  handoffGo.addEventListener('click', showPick);

  for (const button of skipButtons) {
    button.addEventListener('click', () => {
      if (!session) return;
      session = skipTurn(session);
      saveSession();
      resume();
    });
  }

  /* ---------- Opening a gift (live draw and personal link) ---------- */
  const openHead = $('#ge-open-head', root);
  const openHeading = $('#ge-open-heading', root);
  const openWarn = $('#ge-open-warn', root);
  const big = $<HTMLButtonElement>('#ge-big', root);
  const cardWrap = $('#ge-card-wrap', root);
  const scratchHint = $('#ge-scratch-hint', root);
  const factsEl = $('#ge-facts', root);
  const revealAllBtn = $<HTMLButtonElement>('#ge-reveal-all', root);
  const nextBtn = $<HTMLButtonElement>('#ge-next', root);
  const makeBtn = $<HTMLButtonElement>('#ge-make', root);
  const liveEl = $('#ge-live', root);
  const cardEl = $('#sc-x-card', root);
  const faceEl = $('#sc-x-face', root);
  const msgEl = $('#sc-x-msg', root);
  const titleEl = $('#sc-x-title', root);
  const confettiCanvas = $<HTMLCanvasElement>('#ge-confetti', root);

  interface Opening {
    heading: string;
    warn: string;
    title: string;
    message: string;
    scratch: boolean;
    facts: Details | null;
    /** Label of the button that moves on; empty on a personal link. */
    nextLabel: string;
    gift: number;
    /** Live draw: the visitor already chose a box, so it opens by itself. */
    auto: boolean;
  }

  let opening: Opening | null = null;
  let openTimer = 0;
  let stopConfetti = () => {};

  const layer = new ScratchLayer({
    canvas: $<HTMLCanvasElement>('#sc-x-canvas', root),
    label: s.scratchHere,
    onReveal: () => {
      if (!opening) return;
      cardEl.classList.add('is-revealed');
      faceEl.setAttribute('aria-hidden', 'false');
      scratchHint.hidden = true;
      revealAllBtn.hidden = true;
      renderFacts(opening.facts);
      nextBtn.hidden = !opening.nextLabel;
      nextBtn.textContent = opening.nextLabel;
      makeBtn.hidden = Boolean(opening.nextLabel);
      liveEl.textContent = t(s.revealed, { text: `${opening.title} ${opening.message}`.replace(/\n/g, ' ') });
      sounds.play('reveal');
      celebrate();
      (opening.nextLabel ? nextBtn : makeBtn).focus({ preventScroll: true });
    },
  });

  // The layer's own listeners do the erasing; this one only adds the sound of it.
  const scratchCanvas = $<HTMLCanvasElement>('#sc-x-canvas', root);
  let lastScratch = 0;
  scratchCanvas.addEventListener('pointermove', (event) => {
    if (!event.buttons || layer.isRevealed || event.timeStamp - lastScratch < SCRATCH_SOUND_MS) return;
    lastScratch = event.timeStamp;
    sounds.play('scratch');
  });

  function celebrate() {
    if (reducedMotion.matches) return;
    stopConfetti();
    stopConfetti = confetti(confettiCanvas, CONFETTI, 3200);
  }

  /** Largest size that fits: estimate from the text, then shrink if the browser wraps it taller. */
  function fitMessage() {
    const text = msgEl.textContent ?? '';
    let size = fitFontSize(text, { width: 84, height: 58 });
    msgEl.style.fontSize = `${size}cqw`;
    const box = faceEl.clientHeight;
    if (box === 0) return;
    const pad = parseFloat(getComputedStyle(faceEl).paddingTop) * 2;
    for (let i = 0; i < 8 && msgEl.scrollHeight > box - pad && size > 3; i++) {
      size *= 0.9;
      msgEl.style.fontSize = `${size}cqw`;
    }
  }
  new ResizeObserver(fitMessage).observe(cardEl);

  function renderFacts(details: Details | null) {
    const facts: [string, string][] = [];
    if (details?.budget) facts.push([s.budgetFact, details.budget]);
    if (details?.date) facts.push([s.dateFact, formatDate(`${details.date}T00:00:00`, locale)]);
    if (details?.note) facts.push([s.noteFact, details.note]);
    factsEl.hidden = facts.length === 0;
    factsEl.replaceChildren(
      ...facts.flatMap(([label, value]) => {
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = value;
        return [dt, dd];
      }),
    );
  }

  function startOpening(next: Opening) {
    opening = next;
    window.clearTimeout(openTimer);
    stopConfetti();
    liveEl.textContent = '';
    big.classList.remove('is-shaking', 'is-open');
    big.disabled = next.auto;
    big.hidden = false;
    paintGift(big, next.gift);
    cardWrap.hidden = true;
    openHead.hidden = !next.heading;
    openHeading.textContent = next.heading;
    openWarn.textContent = next.warn;
    openWarn.hidden = !next.warn;
    setStep('open');
    bringIntoView(next.heading ? openHeading : null);
    if (next.auto) playOpen();
  }

  function playOpen() {
    big.disabled = true;
    if (reducedMotion.matches) return showCard();
    sounds.play('shake');
    big.classList.add('is-shaking');
    openTimer = window.setTimeout(() => {
      sounds.play('open');
      big.classList.replace('is-shaking', 'is-open');
      openTimer = window.setTimeout(showCard, 480);
    }, 650);
  }

  function showCard() {
    if (!opening) return;
    openHead.hidden = true;
    big.hidden = true;
    cardWrap.hidden = false;
    cardEl.dataset.theme = 'cream';
    cardEl.classList.remove('is-revealed');
    faceEl.setAttribute('aria-hidden', 'true');
    scratchHint.hidden = !opening.scratch;
    revealAllBtn.hidden = !opening.scratch;
    nextBtn.hidden = true;
    makeBtn.hidden = true;
    factsEl.hidden = true;
    // Cover first, then write the text, so the result is never painted uncovered.
    layer.reset('gold', 45);
    titleEl.textContent = opening.title;
    msgEl.textContent = opening.message;
    fitMessage();
    bringIntoView(null);
    if (!opening.scratch) layer.revealAll();
  }

  big.addEventListener('click', playOpen);
  revealAllBtn.addEventListener('click', () => layer.revealAll());

  nextBtn.addEventListener('click', () => {
    if (!session) return;
    session = finishTurn(session);
    saveSession();
    liveEl.textContent = '';
    // Played here, not in showDone: reloading a finished draw has no tap to unlock audio with.
    if (isFinished(session)) sounds.play('finish');
    resume();
  });

  /* ---------- Finished ---------- */
  const doneText = $('#ge-done-text', root);
  const doneResults = $<HTMLDetailsElement>('#ge-done-results', root);
  const doneSummary = $('#ge-done-summary', root);
  const doneHeading = $('#ge-done-heading', root);

  function rowText(row: { from: string; to: string }): string {
    return t(session?.mode === 'stage' ? s.rowGet : s.rowGive, row);
  }

  function rowItem(row: { from: string; to: string }): HTMLLIElement {
    const li = document.createElement('li');
    li.textContent = rowText(row);
    return li;
  }

  function showDone() {
    renderBar();
    const onStage = session!.mode === 'stage';
    doneText.textContent = onStage ? s.doneStage : s.donePass;
    doneSummary.textContent = onStage ? s.resultsAll : s.resultsReveal;
    doneResults.open = onStage;
    fillResults(doneResults);
    setStep('done');
    bringIntoView(doneHeading);
    if (onStage) celebrate();
  }

  /** Results stay out of the page until someone opens the panel, so nobody sees them by accident. */
  function fillResults(panel: HTMLDetailsElement) {
    const list = $('[data-results-list]', panel);
    list.replaceChildren(...(panel.open && session ? resultRows(session).map(rowItem) : []));
  }

  const resultPanels = $$<HTMLDetailsElement>('[data-results]', root);
  for (const panel of resultPanels) {
    panel.addEventListener('toggle', () => fillResults(panel));
    const copyBtn = $<HTMLButtonElement>('[data-results-copy]', panel);
    copyBtn.addEventListener('click', async () => {
      if (!session) return;
      const head = session.details.title || s.defaultTitle;
      const text = [head, ...resultRows(session).map(rowText)].join('\n');
      if (await copyText(text)) flashButton($('span', copyBtn));
    });
  }

  /* ---------- Starting over ---------- */
  function clearSession() {
    session = null;
    takenBoxes.clear();
    saveSession();
    for (const panel of resultPanels) {
      panel.open = false;
      fillResults(panel);
    }
  }

  for (const button of $$<HTMLButtonElement>('[data-redraw]', root)) {
    const label = $('span', button);
    let timer = 0;
    const disarm = () => {
      window.clearTimeout(timer);
      button.classList.remove('is-armed');
      label.textContent = s.redraw;
    };
    button.addEventListener('click', () => {
      if (!button.classList.contains('is-armed')) {
        button.classList.add('is-armed');
        label.textContent = s.redrawArm;
        timer = window.setTimeout(disarm, 4000);
        return;
      }
      disarm();
      clearSession();
      showSetup();
    });
  }

  /* ---------- Full screen (big-screen mode) ---------- */
  const fsBtn = $<HTMLButtonElement>('#ge-fs', root);
  const fsLabel = $('#ge-fs-label', root);
  fsBtn.addEventListener('click', () => {
    if (document.fullscreenElement === stage) void document.exitFullscreen();
    else void stage.requestFullscreen().catch(() => {});
  });
  document.addEventListener('fullscreenchange', () => {
    const on = document.fullscreenElement === stage;
    fsLabel.textContent = on ? s.exitFullscreen : s.fullscreen;
    stage.classList.toggle('is-fullscreen', on);
    layoutBoard();
  });

  /** On a big screen the boxes grow to fill the space; everywhere else CSS sizes them. */
  function layoutBoard() {
    if (!session || !stage.classList.contains('is-fullscreen') || stage.dataset.step !== 'pick') {
      board.style.removeProperty('--ge-box-size');
      board.style.maxWidth = '';
      return;
    }
    const gap = parseFloat(getComputedStyle(board).rowGap) || 0;
    const { columns, size } = fitBoard(session.names.length, steps.pick.clientWidth, board.clientHeight, gap, window.innerHeight * MAX_BOX_SHARE);
    board.style.setProperty('--ge-box-size', `${size}px`);
    // One spare pixel so rounding cannot push the last box of a row onto the next one.
    board.style.maxWidth = `${columns * size + (columns - 1) * gap + 1}px`;
  }
  new ResizeObserver(layoutBoard).observe(steps.pick);

  /* ---------- Sound on and off ---------- */
  const soundBtn = $<HTMLButtonElement>('#ge-sound', root);
  const soundOnIcon = $('#ge-sound-on', root);
  const soundOffIcon = $('#ge-sound-off', root);

  function renderSound() {
    const label = sounds.enabled ? s.soundOff : s.soundOn;
    soundBtn.setAttribute('aria-label', label);
    soundBtn.title = label;
    soundOnIcon.hidden = !sounds.enabled;
    soundOffIcon.hidden = sounds.enabled;
  }
  soundBtn.addEventListener('click', () => {
    sounds.setEnabled(!sounds.enabled);
    savePref(SOUND_KEY, sounds.enabled);
    renderSound();
  });
  renderSound();

  /* ---------- Routing ---------- */
  function showSetup(invalidLink = false) {
    setView('setup');
    linkError.hidden = !invalidLink;
    linkError.textContent = invalidLink ? s.invalidLink : '';
    writeForm();
    renderSetup();
  }

  /** Shows whatever the saved draw is up to; called after every turn. */
  function resume() {
    if (!session) return showSetup();
    if (session.mode === 'link') {
      setView('links');
      renderLinks();
      bringIntoView($('#ge-links-heading', root));
      return;
    }
    setView('stage');
    if (isFinished(session)) showDone();
    else if (session.mode === 'pass') showHandoff();
    else showPick();
  }

  function showInvite(invite: Invite) {
    setView('stage');
    // Stays visible even without a title, because it holds the sound button.
    barEl.hidden = false;
    barTitle.textContent = invite.details.title;
    barProgress.textContent = '';
    track.hidden = true;
    fsBtn.hidden = true;
    footEl.hidden = true;
    startOpening({
      heading: t(s.inviteHello, { name: invite.name }),
      warn: t(s.inviteWarn, { name: invite.name }),
      title: t(s.giveTitle, { name: invite.name }),
      message: invite.target,
      scratch: true,
      facts: invite.details,
      nextLabel: '',
      gift: 0,
      auto: false,
    });
  }

  makeBtn.addEventListener('click', () => {
    try {
      sessionStorage.removeItem(INVITE_KEY);
    } catch {
      /* storage unavailable */
    }
    delete root.dataset.invite;
    opening = null;
    stopConfetti();
    resume();
    root.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  });

  /** Keeps a link out of the address bar when it arrives after the page has loaded. */
  function takeInviteFromUrl(): string {
    const hash = location.hash;
    if (!hash.startsWith('#gift=')) return '';
    history.replaceState(null, '', location.pathname + location.search);
    try {
      sessionStorage.setItem(INVITE_KEY, hash);
    } catch {
      /* storage unavailable */
    }
    return hash;
  }

  function route(hash: string) {
    const result = decodeInvite(hash);
    if (result.status === 'ok') return showInvite(result.invite);
    if (result.status === 'invalid') return showSetup(true);
    resume();
  }

  window.addEventListener('hashchange', () => {
    const hash = takeInviteFromUrl();
    if (hash) route(hash);
  });

  session = normalizeSession(loadPref<unknown>(SESSION_KEY, null));
  writeForm();
  renderSetup();
  route(root.dataset.invite ?? '');
</script>

