---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';
import { DECK_SIZE, DEFAULT_TARGET, FINISHES, FINISH_POINTS, NAME_MAX, TARGETS } from './logic';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const sides = [0, 1] as const;
const slots = Array.from({ length: DECK_SIZE }, (_, i) => i);
---

<div class="tool" data-tool="beyblade-x-scorer" {...i18nAttrs(locale, s.client)}>
  <div class="row bx-settings">
    <div class="seg" role="radiogroup" aria-label={s.targetAria}>
      {
        TARGETS.map((n) => (
          <label>
            <input type="radio" name="bx-target" value={n} checked={n === DEFAULT_TARGET} />
            <span>{t(s.targetOption, { n })}</span>
          </label>
        ))
      }
    </div>
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="bx-mode" value="1" checked /><span>{s.mode1}</span></label>
      <label><input type="radio" name="bx-mode" value="3" /><span>{s.mode3}</span></label>
    </div>
    <button class="btn small bx-full-btn" type="button" id="bx-full">{s.fullscreen}</button>
  </div>

  <div class="bx-stage" id="bx-stage">
  <div class="bx-board">
    {
      sides.map((side) => (
        <section class="bx-player" data-side={side}>
          <input class="bx-name" type="text" maxlength={NAME_MAX} aria-label={s.nameAria} placeholder={s.client.defaultNames[side]} />
          <div class="bx-score" aria-live="polite">0</div>
          <div class="bx-need">{t(s.client.toWin.other, { n: DEFAULT_TARGET })}</div>
          <div class="bx-current-bey"></div>

          <div class="field bx-mode-box" data-for="1">
            <label for={`bx-bey-${side}`}>{s.beyLabel}</label>
            <input id={`bx-bey-${side}`} class="bx-bey" type="text" maxlength={NAME_MAX} placeholder={s.beyPlaceholder} />
          </div>

          <fieldset class="bx-mode-box bx-deck" data-for="3" hidden>
            <legend>{s.deckLabel}</legend>
            {slots.map((i) => (
              <div class="bx-slot">
                <input type="radio" name={`bx-cur-${side}`} value={i} checked={i === 0} aria-label={`${s.currentAria} ${i + 1}`} />
                <input
                  class="bx-deck-name"
                  data-slot={i}
                  type="text"
                  maxlength={NAME_MAX}
                  placeholder={t(s.deckPlaceholder, { n: i + 1 })}
                />
              </div>
            ))}
          </fieldset>

          <div class="bx-finishes">
            {FINISHES.map((f) => (
              <button class={`btn bx-finish bx-${f}`} type="button" data-finish={f}>
                <span>{s.client.finish[f]}</span>
                <span class="bx-pts">{t(s.client.pointsShort, { n: FINISH_POINTS[f] })}</span>
              </button>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <div class="row bx-actions">
    <button class="btn" type="button" id="bx-draw">{s.draw}</button>
    <button class="btn ghost" type="button" id="bx-undo" disabled>{s.undo}</button>
    <button class="btn ghost" type="button" id="bx-reset">{s.reset}</button>
    <button class="btn bx-exit" type="button" id="bx-exit">{s.exitFullscreen}</button>
  </div>

  <div class="result bx-winner" id="bx-winner" aria-live="polite" hidden>
    <div class="result-value" id="bx-winner-text"></div>
    <button class="btn primary" type="button" id="bx-next">{s.nextMatch}</button>
  </div>
  </div>

  <div class="bx-log-box">
    <h3>{s.logTitle}</h3>
    <ol class="bx-log" id="bx-log"></ol>
    <p class="hint" id="bx-log-empty">{s.client.logEmpty}</p>
  </div>

  <div class="bx-stats-box">
    <div class="row between">
      <h3>{s.statsTitle}</h3>
      <div class="row">
        <button class="btn small ghost" type="button" id="bx-export" disabled>{s.exportCsv}</button>
        <button class="btn small ghost" type="button" id="bx-clear" disabled>{s.clearHistory}</button>
      </div>
    </div>
    <p class="hint">{s.statsHint}</p>
    <div class="stats" id="bx-summary" hidden></div>
    <div class="table-wrap" id="bx-table-wrap" hidden>
      <table class="table">
        <thead>
          <tr>
            <th>{s.colBey}</th>
            <th class="num">{s.colBattles}</th>
            <th class="num">{s.colRecord}</th>
            <th class="num">{s.colWinRate}</th>
            <th class="num">{s.colInterval}</th>
            <th class="num">{s.colPoints}</th>
            <th>{s.colFinishes}</th>
          </tr>
        </thead>
        <tbody id="bx-table"></tbody>
      </table>
    </div>
    <p class="hint" id="bx-stats-empty">{s.client.statsEmpty}</p>
  </div>

  <p class="hint bx-disclaimer">{s.disclaimer}</p>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { plural, t } from '../../i18n/format';
  import type { Strings } from './i18n';
  import {
    DEFAULT_TARGET,
    FINISHES,
    TARGETS,
    addRound,
    beyStats,
    cleanName,
    historyCsv,
    matchWinner,
    nextDeckIndex,
    roundPoints,
    sanitizeHistory,
    scores,
    summary,
    undoRound,
    type Finish,
    type Match,
    type SavedMatch,
    type Side,
  } from './logic';

  interface State {
    match: Match;
    mode: '1' | '3';
    beys: [string, string];
    decks: [string[], string[]];
    current: [number, number];
    /** Set while the finished match is stored in history, so undo can take it back out. */
    savedAt: number | null;
  }

  const KEY = 'beyblade-x-scorer';
  const HISTORY_KEY = 'beyblade-x-scorer:history';

  const root = $('[data-tool="beyblade-x-scorer"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const n = (v: number) => formatInteger(v, locale);
  const pct = (v: number) => `${formatFixed(v * 100, 0, locale)}%`;
  const players = $$<HTMLElement>('.bx-player', root);

  const blank = (): State => ({
    // Empty names fall back to the page language's "Player A/B", so switching languages never shows stale defaults.
    match: { target: DEFAULT_TARGET, names: ['', ''], rounds: [] },
    mode: '1',
    beys: ['', ''],
    decks: [['', '', ''], ['', '', '']],
    current: [0, 0],
    savedAt: null,
  });

  function loadState(): State {
    const d = blank();
    const raw = loadPref<Partial<State>>(KEY, {});
    const match = sanitizeHistory([{ ...raw.match, at: 0 }])[0];
    const deck = (v: unknown) => (Array.isArray(v) ? [0, 1, 2].map((i) => cleanName(String(v[i] ?? ''))) : ['', '', '']);
    return {
      match: match && TARGETS.includes(match.target) ? { target: match.target, names: match.names, rounds: match.rounds } : d.match,
      mode: raw.mode === '3' ? '3' : '1',
      beys: Array.isArray(raw.beys) ? [cleanName(String(raw.beys[0] ?? '')), cleanName(String(raw.beys[1] ?? ''))] : d.beys,
      decks: Array.isArray(raw.decks) ? [deck(raw.decks[0]), deck(raw.decks[1])] : d.decks,
      current: Array.isArray(raw.current) ? [Number(raw.current[0]) % 3 || 0, Number(raw.current[1]) % 3 || 0] : d.current,
      savedAt: typeof raw.savedAt === 'number' ? raw.savedAt : null,
    };
  }

  let state = loadState();
  let history: SavedMatch[] = sanitizeHistory(loadPref<unknown>(HISTORY_KEY, []));

  const nameOf = (side: Side) => state.match.names[side] || s.defaultNames[side];

  function beyInPlay(side: Side): string {
    return state.mode === '3' ? state.decks[side][state.current[side]] ?? '' : state.beys[side];
  }

  /** Next filled deck slot; empty slots are skipped so a 2-Bey deck still rotates. */
  function rotate(side: Side) {
    const deck = state.decks[side];
    let i = state.current[side];
    for (let step = 0; step < deck.length; step++) {
      i = nextDeckIndex(i, deck.length);
      if (deck[i]) break;
    }
    state.current[side] = i;
  }

  function save() {
    savePref(KEY, state);
    savePref(HISTORY_KEY, history);
  }

  /** Keeps history in step with the current match: stored once finished, removed if undone. */
  function syncHistory() {
    const done = matchWinner(state.match) !== null;
    if (done && state.savedAt === null) {
      const at = Date.now();
      history = [...history, { ...state.match, at }].slice(-500);
      state.savedAt = at;
    } else if (!done && state.savedAt !== null) {
      const at = state.savedAt;
      history = history.filter((m) => m.at !== at);
      state.savedAt = null;
    } else if (done && state.savedAt !== null) {
      const at = state.savedAt;
      history = history.map((m) => (m.at === at ? { ...state.match, at } : m));
    }
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderBoard() {
    const [a, b] = scores(state.match.rounds);
    const winner = matchWinner(state.match);
    const totals = [a, b];
    players.forEach((p, i) => {
      const side = i as Side;
      $('.bx-score', p).textContent = n(totals[side]);
      const need = Math.max(0, state.match.target - totals[side]);
      $('.bx-need', p).textContent = winner === null ? plural(locale, need, s.toWin) : '';
      p.classList.toggle('is-winner', winner === side);
      $('.bx-current-bey', p).textContent = beyInPlay(side);
      for (const btn of $$<HTMLButtonElement>('.bx-finish', p)) btn.disabled = winner !== null;
      for (const box of $$<HTMLElement>('.bx-mode-box', p)) box.hidden = box.dataset.for !== state.mode;
      $$<HTMLInputElement>(`input[name="bx-cur-${side}"]`, p).forEach((r, k) => (r.checked = k === state.current[side]));
      $$<HTMLElement>('.bx-slot', p).forEach((slot, k) => slot.classList.toggle('is-current', k === state.current[side]));
    });
    $<HTMLButtonElement>('#bx-draw', root).disabled = winner !== null;
    $<HTMLButtonElement>('#bx-undo', root).disabled = state.match.rounds.length === 0;
    const banner = $('#bx-winner', root);
    banner.hidden = winner === null;
    if (winner !== null) $('#bx-winner-text', root).textContent = t(s.winner, { name: nameOf(winner), a: n(Math.max(a, b)), b: n(Math.min(a, b)) });

    const log = $('#bx-log', root);
    log.replaceChildren(
      ...state.match.rounds.map((r, i) => {
        if (r.winner === null || r.finish === null) return el('li', 'bx-draw-line', t(s.drawLine, { n: n(i + 1) }));
        const bey = r.bey[r.winner];
        return el(
          'li',
          '',
          t(s.roundLine, {
            n: n(i + 1),
            name: nameOf(r.winner),
            bey: bey ? t(s.withBey, { bey }) : '',
            finish: s.finish[r.finish],
            pts: n(roundPoints(r)),
          }),
        );
      }),
    );
    $('#bx-log-empty', root).hidden = state.match.rounds.length > 0;
  }

  function renderStats() {
    const has = history.length > 0;
    $<HTMLButtonElement>('#bx-export', root).disabled = !has;
    $<HTMLButtonElement>('#bx-clear', root).disabled = !has;
    $('#bx-stats-empty', root).hidden = has;
    const box = $('#bx-summary', root);
    box.hidden = !has;
    const wrap = $('#bx-table-wrap', root);
    if (!has) {
      wrap.hidden = true;
      return;
    }

    const sum = summary(history);
    const decisive = sum.battles - sum.draws;
    const stat = (value: string, label: string) => {
      const d = el('div', 'stat');
      d.append(el('span', 'stat-value', value), el('span', 'stat-label', label));
      return d;
    };
    box.replaceChildren(
      stat(n(sum.matches), s.statMatches),
      stat(n(sum.battles), s.statBattles),
      stat(formatFixed(sum.battlesPerMatch, 1, locale), s.statPerMatch),
      ...FINISHES.map((f) => stat(decisive ? pct(sum.finishes[f] / decisive) : '–', t(s.statShare, { name: s.finish[f] }))),
    );

    const rows = beyStats(history).slice(0, 50);
    wrap.hidden = rows.length === 0;
    $('#bx-table', root).replaceChildren(
      ...rows.map((b) => {
        const tr = el('tr');
        const name = el('td', '', b.name);
        if (b.battles < 10) name.append(' ', el('span', 'bx-tag', s.smallSample));
        const finishes = FINISHES.filter((f) => b.winsBy[f] > 0)
          .map((f) => t(s.finishCount, { name: s.finish[f], n: n(b.winsBy[f]) }))
          .join(s.listSeparator);
        tr.append(
          name,
          el('td', 'num', n(b.battles)),
          el('td', 'num', t(s.record, { w: n(b.wins), l: n(b.losses), d: n(b.draws) })),
          el('td', 'num', pct(b.winRate)),
          el('td', 'num', `${pct(b.interval.low)}–${pct(b.interval.high)}`),
          el('td', 'num', formatFixed(b.pointsPerBattle, 2, locale)),
          el('td', '', finishes || '–'),
        );
        return tr;
      }),
    );
  }

  function render() {
    renderBoard();
    renderStats();
  }

  function commit() {
    syncHistory();
    save();
    render();
  }

  function score(winner: Side | null, finish: Finish | null) {
    if (matchWinner(state.match) !== null) return;
    state.match = addRound(state.match, { winner, finish, bey: [beyInPlay(0), beyInPlay(1)] });
    if (state.mode === '3') {
      rotate(0);
      rotate(1);
    }
    commit();
  }

  function startOver() {
    state.match = { ...state.match, rounds: [] };
    state.current = [0, 0];
    state.savedAt = null;
    save();
    render();
  }

  // Restore inputs from saved state.
  $<HTMLInputElement>(`input[name="bx-target"][value="${state.match.target}"]`, root).checked = true;
  $<HTMLInputElement>(`input[name="bx-mode"][value="${state.mode}"]`, root).checked = true;
  players.forEach((p, i) => {
    const side = i as Side;
    $<HTMLInputElement>('.bx-name', p).value = state.match.names[side];
    $<HTMLInputElement>('.bx-bey', p).value = state.beys[side];
    $$<HTMLInputElement>('.bx-deck-name', p).forEach((input, k) => (input.value = state.decks[side][k] ?? ''));

    p.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-finish]');
      if (btn) score(side, btn.dataset.finish as Finish);
    });
    p.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.classList.contains('bx-name')) state.match.names[side] = cleanName(target.value);
      else if (target.classList.contains('bx-bey')) state.beys[side] = cleanName(target.value);
      else if (target.classList.contains('bx-deck-name')) state.decks[side][Number(target.dataset.slot)] = cleanName(target.value);
      save();
      renderBoard();
    });
    p.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === `bx-cur-${side}`) {
        state.current[side] = Number(target.value);
        save();
        renderBoard();
      }
    });
  });

  root.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'bx-target') {
      state.match = { ...state.match, target: Number(target.value) };
      commit();
    } else if (target.name === 'bx-mode') {
      state.mode = target.value === '3' ? '3' : '1';
      save();
      renderBoard();
    }
  });

  $('#bx-draw', root).addEventListener('click', () => score(null, null));
  $('#bx-undo', root).addEventListener('click', () => {
    const last = state.match.rounds.at(-1);
    if (!last) return;
    state.match = undoRound(state.match);
    if (state.mode === '3') {
      // Put each side back on the Beyblade that fought the undone battle.
      ([0, 1] as const).forEach((side) => {
        const k = state.decks[side].indexOf(last.bey[side]);
        if (k >= 0) state.current[side] = k;
      });
    }
    commit();
  });
  $('#bx-reset', root).addEventListener('click', startOver);
  $('#bx-next', root).addEventListener('click', startOver);

  $('#bx-export', root).addEventListener('click', () => {
    const named = history.map((m) => ({ ...m, names: [m.names[0] || s.defaultNames[0], m.names[1] || s.defaultNames[1]] as [string, string] }));
    const csv = historyCsv(named, s.csvHeaders, (f) => (f ? s.finish[f] : s.drawName));
    // BOM so Excel opens Chinese and Japanese text correctly.
    downloadBlob(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }), s.csvFile);
  });

  const clearBtn = $<HTMLButtonElement>('#bx-clear', root);
  const clearLabel = clearBtn.textContent ?? '';
  let armed: number | undefined;
  clearBtn.addEventListener('click', () => {
    if (armed === undefined) {
      clearBtn.textContent = s.confirmClear;
      armed = window.setTimeout(() => {
        clearBtn.textContent = clearLabel;
        armed = undefined;
      }, 3000);
      return;
    }
    window.clearTimeout(armed);
    armed = undefined;
    clearBtn.textContent = clearLabel;
    history = [];
    state.savedAt = null;
    save();
    render();
  });

  // Full screen: the real Fullscreen API where available (Android, desktop, iPad); iPhone Safari only
  // supports it for video, so there the scoreboard grows to fill the screen in place instead.
  const stage = $('#bx-stage', root);
  type WebkitDoc = Document & { webkitFullscreenElement?: Element; webkitFullscreenEnabled?: boolean; webkitExitFullscreen?: () => void };
  type WebkitEl = HTMLElement & { webkitRequestFullscreen?: () => void };
  const doc = document as WebkitDoc;
  const native = () => (doc.fullscreenElement ?? doc.webkitFullscreenElement) === stage;
  let wakeLock: WakeLockSentinel | null = null;

  async function keepAwake(on: boolean) {
    try {
      if (on && !wakeLock && 'wakeLock' in navigator) {
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => (wakeLock = null));
      } else if (!on && wakeLock) {
        await wakeLock.release();
        wakeLock = null;
      }
    } catch {
      /* not allowed (battery saver, unsupported); the scoreboard still works */
    }
  }

  async function enterFull() {
    const el = stage as WebkitEl;
    stage.classList.add('is-full');
    try {
      // Request first, while the click still counts as a user gesture.
      if (doc.fullscreenEnabled && el.requestFullscreen) {
        await el.requestFullscreen();
        keepAwake(true);
        return;
      }
      if (doc.webkitFullscreenEnabled && el.webkitRequestFullscreen) {
        el.webkitRequestFullscreen();
        keepAwake(true);
        return;
      }
    } catch {
      /* fall through to the in-page layout */
    }
    keepAwake(true);
    const header = document.querySelector<HTMLElement>('header')?.offsetHeight ?? 0;
    stage.style.setProperty('--bx-top', `${header}px`);
    window.scrollTo({ top: stage.getBoundingClientRect().top + window.scrollY - header });
  }

  function leaveFull() {
    stage.classList.remove('is-full');
    keepAwake(false);
  }

  $('#bx-full', root).addEventListener('click', enterFull);
  $('#bx-exit', root).addEventListener('click', () => {
    if (native()) (document.exitFullscreen ? document.exitFullscreen() : doc.webkitExitFullscreen?.());
    else leaveFull();
  });
  for (const type of ['fullscreenchange', 'webkitfullscreenchange']) {
    document.addEventListener(type, () => {
      if (!native()) leaveFull();
    });
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && stage.classList.contains('is-full')) keepAwake(true);
  });

  render();
</script>

<style>
  .bx-settings {
    gap: 10px 16px;
  }
  .bx-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .bx-player {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .bx-player.is-winner {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .bx-name {
    font-weight: 600;
    text-align: center;
  }
  .bx-score {
    font-family: var(--display);
    font-size: clamp(56px, 16vw, 88px);
    font-weight: 700;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .bx-need {
    min-height: 1.4em;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .bx-finishes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .bx-finish {
    display: grid;
    justify-items: center;
    gap: 0;
    min-height: 56px;
    padding: 6px 4px;
    line-height: 1.25;
    font-size: 14px;
    white-space: normal;
  }
  .bx-pts {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .bx-xtreme {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }
  .bx-xtreme .bx-pts {
    color: var(--accent);
  }
  .bx-deck {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .bx-deck legend {
    margin-bottom: 4px;
    font-size: 13px;
    color: var(--text-2);
  }
  .bx-slot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .bx-slot.is-current {
    background: var(--surface-2);
  }
  .bx-slot input[type='radio'] {
    flex: none;
    accent-color: var(--accent);
  }
  .bx-slot input[type='text'] {
    min-width: 0;
  }
  .bx-mode-box[hidden],
  .bx-winner[hidden],
  .bx-stats-box [hidden],
  .bx-log-box [hidden] {
    display: none !important;
  }
  .bx-winner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .bx-winner .result-value {
    font-size: 26px;
  }
  .bx-log-box h3,
  .bx-stats-box h3 {
    margin: 0;
    font-size: 16px;
  }
  .bx-log-box,
  .bx-stats-box {
    display: grid;
    gap: 8px;
  }
  .bx-log {
