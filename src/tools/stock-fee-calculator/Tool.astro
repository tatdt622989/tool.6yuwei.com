<div class="tool" data-tool="stock-fee-calculator">
  <div class="sf-options">
    <div class="field">
      <span class="label">商品類型</span>
      <div class="seg" role="radiogroup" aria-label="商品類型">
        <label><input type="radio" name="sf-type" value="stock" checked /><span>股票</span></label>
        <label><input type="radio" name="sf-type" value="etf" /><span>ETF</span></label>
        <label><input type="radio" name="sf-type" value="bond-etf" /><span>債券 ETF</span></label>
      </div>
    </div>
    <label class="check" id="sf-daytrade-wrap"><input type="checkbox" id="sf-daytrade" /><span>現股當沖（證交稅 0.15%）</span></label>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="sf-buy">買進價格（元／股）</label>
      <input id="sf-buy" type="text" inputmode="decimal" autocomplete="off" value="100" />
    </div>
    <div class="field">
      <label for="sf-sell">賣出價格（元／股）</label>
      <input id="sf-sell" type="text" inputmode="decimal" autocomplete="off" value="110" />
    </div>
  </div>

  <div class="field">
    <div class="row between">
      <label for="sf-qty">數量</label>
      <div class="seg" role="radiogroup" aria-label="數量單位">
        <label><input type="radio" name="sf-unit" value="lot" checked /><span>張</span></label>
        <label><input type="radio" name="sf-unit" value="share" /><span>股（零股）</span></label>
      </div>
    </div>
    <input id="sf-qty" type="text" inputmode="decimal" autocomplete="off" value="1" />
    <span class="hint" id="sf-qty-hint">1 張 = 1,000 股。</span>
  </div>

  <div class="grid-2">
    <div class="field">
      <label for="sf-discount">手續費折數</label>
      <input id="sf-discount" type="text" inputmode="decimal" autocomplete="off" value="6" />
      <span class="hint">2.8 折填 2.8，6 折填 6，不打折填 10。</span>
    </div>
    <div class="field">
      <label for="sf-min">最低手續費（元）</label>
      <input id="sf-min" type="text" inputmode="numeric" autocomplete="off" value="20" />
      <span class="hint">整股多為 20 元；零股電子下單多數券商 1 元。</span>
    </div>
  </div>

  <div class="notice error" id="sf-error" hidden></div>

  <div id="sf-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="sf-net">—</div>
      <div class="result-label" id="sf-net-label">淨損益（已扣手續費與證交稅）</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sf-buyfee">—</span><span class="stat-label">買進手續費</span></div>
      <div class="stat"><span class="stat-value" id="sf-sellfee">—</span><span class="stat-label">賣出手續費</span></div>
      <div class="stat"><span class="stat-value" id="sf-tax">—</span><span class="stat-label" id="sf-tax-label">證交稅</span></div>
      <div class="stat"><span class="stat-value" id="sf-cost">—</span><span class="stat-label">交易成本合計</span></div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="sf-payable">—</span><span class="stat-label">買進應付交割金額</span></div>
      <div class="stat"><span class="stat-value" id="sf-receivable">—</span><span class="stat-label">賣出應收交割金額</span></div>
      <div class="stat"><span class="stat-value" id="sf-be">—</span><span class="stat-label" id="sf-be-label">損益兩平賣出價</span></div>
    </div>

    <div class="field">
      <span class="label">漲幾檔才賺？（從買進價往上每一檔的淨損益）</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>上漲檔數</th><th class="num">賣出價</th><th class="num">淨損益</th></tr>
          </thead>
          <tbody id="sf-ladder"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice" id="sf-rule-note"></p>
  <p class="hint">手續費＝價金 × 0.1425% × 折數，無條件捨去並套用最低手續費；證交稅只在賣出時課徵、未滿 1 元捨去。交割日為成交後第 2 個營業日（T+2）。結果為依公開費率的估算，實際金額以券商對帳單為準，不構成投資建議；資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    FEE_RULES,
    calculateTrade,
    parseDiscount,
    tickLadder,
    validateTrade,
    type SecurityType,
    type TradeInput,
  } from './logic';

  const KEY = 'stock-fee-calculator';
  const root = $('[data-tool="stock-fee-calculator"]');
  const ids = ['buy', 'sell', 'qty', 'discount', 'min'] as const;
  type Id = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((id) => [id, $<HTMLInputElement>(`#sf-${id}`, root)])) as Record<Id, HTMLInputElement>;
  const types = $$<HTMLInputElement>('input[name="sf-type"]', root);
  const units = $$<HTMLInputElement>('input[name="sf-unit"]', root);
  const dayTrade = $<HTMLInputElement>('#sf-daytrade', root);
  const error = $('#sf-error', root);
  const output = $('#sf-output', root);
  const ladder = $('#sf-ladder', root);

  interface Prefs extends Partial<Record<Id, string>> {
    type?: string;
    unit?: string;
    dayTrade?: boolean;
    minTouched?: boolean;
  }
  const prefs = loadPref<Prefs>(KEY, {});
  for (const id of ids) if (prefs[id] !== undefined) inputs[id].value = prefs[id]!;
  if (prefs.type) for (const t of types) t.checked = t.value === prefs.type;
  if (prefs.unit) for (const u of units) u.checked = u.value === prefs.unit;
  dayTrade.checked = prefs.dayTrade ?? false;
  let minTouched = prefs.minTouched ?? false;

  const money = (n: number) => `${formatInteger(n)} 元`;
  const signed = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${formatInteger(Math.abs(n))} 元`;
  const set = (sel: string, text: string) => {
    $(sel, root).textContent = text;
  };
  const checked = (list: HTMLInputElement[], fallback: string) => list.find((x) => x.checked)?.value ?? fallback;

  function ruleNote(type: SecurityType, isDayTrade: boolean): string {
    if (type === 'bond-etf')
      return `債券 ETF 依證券交易稅條例停徵證交稅至 ${FEE_RULES.bondEtfExemptUntil}；延長 10 年的修正草案已由行政院通過，待立法院三讀。若未延長，2027 年起請改選「ETF」以 0.1% 試算。`;
    if (type === 'etf') return 'ETF 證交稅 0.1%，現股當沖也不再減半。';
    if (isDayTrade) return `現股當沖證交稅減半為 0.15%，施行至 ${FEE_RULES.dayTradeTaxUntil}；當沖須先簽署當沖契約，且同一帳戶同日買賣同一檔股票、數量相抵的部分才適用。`;
    return '一般股票賣出時課徵證交稅 0.3%。';
  }

  function render() {
    const type = checked(types, 'stock') as SecurityType;
    const unit = checked(units, 'lot');
    const isLot = unit === 'lot';
    dayTrade.disabled = type !== 'stock';
    const isDayTrade = type === 'stock' && dayTrade.checked;
    savePref(KEY, { ...Object.fromEntries(ids.map((id) => [id, inputs[id].value])), type, unit, dayTrade: dayTrade.checked, minTouched });

    set('#sf-rule-note', ruleNote(type, isDayTrade));
    set('#sf-qty-hint', isLot ? '1 張 = 1,000 股，可輸入小數，例如 1.5 張。' : '零股以股為單位，1–999 股。');

    const qty = parseNumber(inputs.qty.value);
    const shares = isLot ? Math.round(qty * FEE_RULES.sharesPerLot * 1000) / 1000 : qty;
    const input: TradeInput = {
      buyPrice: parseNumber(inputs.buy.value),
      sellPrice: parseNumber(inputs.sell.value),
      shares,
      type,
      dayTrade: isDayTrade,
      discount: parseDiscount(inputs.discount.value.trim() === '' ? 10 : parseNumber(inputs.discount.value)),
      minFee: inputs.min.value.trim() === '' ? 0 : parseNumber(inputs.min.value),
    };
    const problem = validateTrade(input);
    if (problem) {
      error.textContent = isLot && problem.includes('整數') ? '張數換算後的股數必須是整數。' : problem;
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    const r = calculateTrade(input);
    set('#sf-net', signed(r.netProfit));
    set('#sf-net-label', `淨損益（報酬率 ${r.returnPct > 0 ? '+' : ''}${formatNumber(r.returnPct, 2)}%，已扣手續費與證交稅）`);
    $('#sf-net', root).dataset.sign = r.netProfit > 0 ? 'up' : r.netProfit < 0 ? 'down' : '';
    set('#sf-buyfee', money(r.buyFee));
    set('#sf-sellfee', money(r.sellFee));
    set('#sf-tax', money(r.tax));
    set('#sf-tax-label', `證交稅（${formatNumber(r.taxRate * 100, 2)}%）`);
    set('#sf-cost', money(r.totalCost));
    set('#sf-payable', money(r.buyPayable));
    set('#sf-receivable', money(r.sellReceivable));
    set('#sf-be', `${formatNumber(r.breakEvenPrice, 2)} 元`);
    set('#sf-be-label', r.breakEvenTicks > 0 ? `損益兩平賣出價（漲 ${r.breakEvenTicks} 檔）` : '損益兩平賣出價');

    ladder.replaceChildren(
      ...tickLadder(input, 8).map((row) => {
        const tr = document.createElement('tr');
        if (row.net >= 0 && row.price === r.breakEvenPrice) tr.className = 'sf-be-row';
        const cells = [row.ticks === 0 ? '買進價' : `+${row.ticks} 檔`, formatNumber(row.price, 2), signed(row.net)];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i > 0) td.className = 'num';
          if (i === 2) td.dataset.sign = row.net > 0 ? 'up' : row.net < 0 ? 'down' : '';
          tr.append(td);
        });
        return tr;
      }),
    );
  }

  inputs.min.addEventListener('input', () => {
    minTouched = true;
  });
  for (const u of units)
    u.addEventListener('change', () => {
      if (minTouched) return;
      inputs.min.value = String(u.value === 'lot' ? FEE_RULES.defaultMinFee : FEE_RULES.oddLotMinFee);
    });

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  .sf-options {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 20px;
  }
  .sf-options .check {
    min-height: 40px;
  }
  .sf-options .check:has(input:disabled) {
    color: var(--muted);
    cursor: not-allowed;
  }
  .row > label[for] {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  #sf-output {
    display: grid;
    gap: 16px;
  }
  #sf-output[hidden] {
    display: none;
  }
  [data-sign='up'] {
    color: var(--danger);
  }
  [data-sign='down'] {
    color: var(--success);
  }
  .sf-be-row td {
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
