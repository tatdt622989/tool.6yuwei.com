---
import { formatDate, t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { animalYearTable, branchYearTable, SIGNS, warekiOf } from './logic';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const tw = s.mode === 'tw' ? s.tw : undefined;
const zh = s.mode === 'chinese' ? s.chinese : undefined;
const eto = s.mode === 'eto' ? s.eto : undefined;

// Both reference tables are rendered at build time so they are part of the HTML.
const range = (s: [number, number], e: [number, number]) => `${s[0]}/${s[1]} – ${e[0]}/${e[1]}`;
const animals = animalYearTable(1924, 2031);
const branches = eto ? branchYearTable(1924, 2031) : [];
const etoYears = eto ? Array.from({ length: 2040 - 1900 + 1 }, (_, i) => 1900 + i) : [];
const shortDate = (m: number, d: number) => formatDate(new Date(Date.UTC(2000, m - 1, d)), locale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<div class="tool" data-tool="zodiac-finder" {...i18nAttrs(locale, s.client)} data-mode={s.mode === 'tw' ? undefined : s.mode}>
  {
    tw && (
      <><div class="row zf-inputs">
    <div class="field zf-date">
      <label for="zf-date">{tw.dateLabel}</label>
      <input id="zf-date" type="date" min="1900-01-31" max="2100-12-31" value="1995-08-15" />
    </div>
  </div>

  <div class="notice error" id="zf-error" hidden></div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="zf-main">—</div>
    <div class="result-label" id="zf-sub"></div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="zf-sign">—</span><span class="stat-label" id="zf-sign-label">{tw.statSign}</span></div>
    <div class="stat"><span class="stat-value" id="zf-element">—</span><span class="stat-label">{tw.statElement}</span></div>
    <div class="stat"><span class="stat-value" id="zf-ruler">—</span><span class="stat-label">{tw.statRuler}</span></div>
    <div class="stat"><span class="stat-value" id="zf-animal">—</span><span class="stat-label" id="zf-animal-label">{tw.statAnimal}</span></div>
    <div class="stat"><span class="stat-value" id="zf-ny">—</span><span class="stat-label" id="zf-ny-label">{tw.statNewYear}</span></div>
  </div>
  <p class="notice" id="zf-note" hidden></p>

  <div class="field">
    <span class="label">{tw.signTableTitle}</span>
    <div class="table-wrap">
      <table class="table zf-table">
        <thead>
          <tr>{tw.signHeads.map((h) => <th>{h}</th>)}</tr>
        </thead>
        <tbody id="zf-signs">
          {
            SIGNS.map((s) => (
              <tr data-sign={s.name}>
                <td>
                  {s.name} <span class="muted">{s.english}</span>
                </td>
                <td>{range(s.start, s.end)}</td>
                <td>{s.element}{tw.elementSuffix}</td>
                <td>{s.modality}</td>
                <td>{s.ruler}</td>
                <td>{s.term}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="field">
    <span class="label">{tw.animalTableTitle}</span>
    <div class="table-wrap">
      <table class="table zf-table">
        <thead>
          <tr>{tw.animalHeads.map((h) => <th>{h}</th>)}</tr>
        </thead>
        <tbody id="zf-animals">
          {
            animals.map((row) => (
              <tr data-animal={row.animal}>
                <td>{row.animal}</td>
                <td class="zf-years-cell">
                  <div class="zf-years">
                    {row.years.map((y) => (
                      <span>
                        {y.year}
                        <span class="muted">{t(tw.yearNewYear, { m: y.newYear.m, d: y.newYear.d })}</span>
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">{tw.hint}</span>
  </div></>
    )}{zh && (
      <><div class="row zf-inputs">
          <div class="field zf-date">
            <label for="zf-date">{zh.dateLabel}</label>
            <input id="zf-date" type="date" min="1900-01-31" max="2100-12-31" value="1995-08-15" />
          </div>
        </div>

        <div class="notice error" id="zf-error" hidden />

        <div class="result" aria-live="polite">
          <div class="result-value" id="zf-main">—</div>
          <div class="result-label" id="zf-sub" />
        </div>

        <div class="stats">
          <div class="stat"><span class="stat-value" id="zf-animal">—</span><span class="stat-label">{zh.statAnimal}</span></div>
          <div class="stat"><span class="stat-value" id="zf-element">—</span><span class="stat-label">{zh.statElement}</span></div>
          <div class="stat"><span class="stat-value" id="zf-ganzhi">—</span><span class="stat-label">{zh.statGanzhi}</span></div>
          <div class="stat"><span class="stat-value" id="zf-ny">—</span><span class="stat-label" id="zf-ny-label">—</span></div>
        </div>
        <p class="notice" id="zf-note" hidden />

        <div class="field">
          <span class="label">{zh.tableTitle}</span>
          <div class="table-wrap">
            <table class="table zf-table">
              <thead>
                <tr>{zh.tableHeads.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody id="zf-animals">
                {animals.map((row, i) => (
                  <tr data-animal={row.animal}>
                    <td>{s.client.chinese!.animals[i]}</td>
                    <td class="zf-years-cell">
                      <div class="zf-years">
                        {row.years.map((y) => (
                          <span>
                            {y.year} <span class="muted">({shortDate(y.newYear.m, y.newYear.d)})</span>
                          </span>
                        ))}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <span class="hint">{zh.hint}</span>
        </div></>
    )}{eto && (
      <><div class="row zf-inputs">
          <div class="field zf-date">
            <label for="zf-year">{eto.yearLabel}</label>
            <select id="zf-year">
              {etoYears.map((y) => (
                <option value={String(y)} selected={y === 1990}>
                  {t(s.client.eto!.option, { year: y, wareki: warekiOf(y).join('・') })}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="notice error" id="zf-error" hidden />

        <div class="result" aria-live="polite">
          <div class="result-value" id="zf-main">—</div>
          <div class="result-label" id="zf-sub" />
        </div>

        <div class="stats">
          <div class="stat"><span class="stat-value" id="zf-branch">—</span><span class="stat-label" id="zf-branch-label">{eto.statBranch}</span></div>
          <div class="stat"><span class="stat-value" id="zf-stem">—</span><span class="stat-label" id="zf-stem-label">{eto.statStem}</span></div>
          <div class="stat"><span class="stat-value" id="zf-toshi">—</span><span class="stat-label" id="zf-toshi-label">{eto.statToshi}</span></div>
          <div class="stat"><span class="stat-value" id="zf-kanreki">—</span><span class="stat-label">{s.client.eto!.kanrekiLabel}</span></div>
        </div>
        <p class="notice">{eto.hint}</p>

        <div class="field">
          <span class="label">{eto.tableTitle}</span>
          <div class="table-wrap">
            <table class="table zf-table">
              <thead>
                <tr>{eto.tableHeads.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody id="zf-animals">
                {branches.map((row) => (
                  <tr data-branch={String(row.branchIndex)}>
                    <td>
                      {t(s.client.eto!.branch, { branch: row.years[0].ganzhi.slice(1), kana: s.client.eto!.branchKana[row.branchIndex] })}
                      <span class="muted"> {s.client.eto!.animals[row.branchIndex]}</span>
                    </td>
                    <td class="zf-years-cell">
                      <div class="zf-years">
                        {row.years.map((y) => (
                          <span>
                            {y.year} <span class="muted">{y.ganzhi}</span>
                          </span>
                        ))}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div></>
    )
  }
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { formatDate, t } from '../../i18n/format';
  import { parseISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import { dayName, monthName, solarToLunar } from '../lunar-converter/logic';
  import { chineseZodiacOf, kanrekiYear, lookup, nextAnimalYear, stemBranchOf, warekiOf } from './logic';
  import type { Strings, ZodiacMode } from './i18n';

  const root = $('[data-tool="zodiac-finder"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const mode = (root.dataset.mode ?? 'tw') as ZodiacMode;
  const error = $('#zf-error', root);
  const note = root.querySelector<HTMLElement>('#zf-note');
  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const ymdDate = (d: YMD) => new Date(Date.UTC(d.y, d.m - 1, d.d));
  const longDate = (d: YMD, weekday = false) =>
    formatDate(ymdDate(d), locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC', ...(weekday ? { weekday: 'long' } : {}) });

  function clear(message: string, ids: string[]) {
    error.textContent = message;
    error.hidden = false;
    if (note) note.hidden = true;
    ids.forEach((id) => set(id, '—'));
    set('#zf-sub', '');
  }

  function highlight(attr: 'sign' | 'animal' | 'branch', value: string | null) {
    for (const tr of $$<HTMLElement>(`tr[data-${attr}]`, root)) tr.classList.toggle('is-current', tr.dataset[attr] === value);
  }

  /* ---------- zh-TW: 星座 + 生肖 ---------- */
  function renderTw(input: HTMLInputElement) {
    const tw = s.tw!;
    const date = parseISODate(input.value);
    if (!date) {
      clear(s.errorEmpty, ['#zf-main', '#zf-sign', '#zf-element', '#zf-ruler', '#zf-animal', '#zf-ny']);
      return;
    }
    savePref('zodiac-finder', input.value);
    error.hidden = true;
    const r = lookup(date);
    const sign = r.sign;
    const a = r.animal;
    set('#zf-main', a ? t(tw.main, { sign: sign.name, animal: a.animal }) : sign.name);
    const lunar = solarToLunar(date);
    set(
      '#zf-sub',
      t(tw.born, { y: date.y, m: date.m, d: date.d, w: WEEKDAY_LABEL[weekdayOf(date)] }) +
        (lunar && a ? t(tw.lunar, { ganzhi: a.ganzhi, month: monthName(lunar.month, lunar.isLeap), day: dayName(lunar.day) }) : ''),
    );
    set('#zf-sign', sign.name);
    set(
      '#zf-sign-label',
      t(tw.signLabel, { start: `${sign.start[0]}/${sign.start[1]}`, end: `${sign.end[0]}/${sign.end[1]}`, english: sign.english }),
    );
    set('#zf-element', t(tw.element, { element: sign.element, modality: sign.modality }));
    set('#zf-ruler', sign.ruler);
    if (a) {
      set('#zf-animal', t(tw.animal, { animal: a.animal, ganzhi: a.ganzhi }));
      set('#zf-animal-label', t(tw.animalLabel, { year: a.lunarYear, element: a.element }));
      set('#zf-ny', `${a.newYear.m}/${a.newYear.d}`);
      set('#zf-ny-label', t(tw.newYearLabel, { y: date.y }));
    } else {
      set('#zf-animal', '—');
      set('#zf-animal-label', tw.animalOutOfRange);
      set('#zf-ny', '—');
    }

    const notes: string[] = [];
    if (a?.beforeNewYear) {
      notes.push(t(tw.beforeNewYear, { y: date.y, m: a.newYear.m, d: a.newYear.d, animal: a.animal, naive: a.naiveAnimal }));
    }
    if (r.termSign) {
      notes.push(t(tw.termSign, { y: date.y, sign: r.termSign.name, term: r.termSign.term }));
    } else if (r.nearCusp) {
      notes.push(tw.nearCusp);
    }
    note!.textContent = notes.join('');
    note!.hidden = notes.length === 0;
    highlight('sign', sign.name);
    highlight('animal', a?.animal ?? null);
  }

  /* ---------- en: Chinese zodiac (switches at Lunar New Year) ---------- */
  function renderChinese(input: HTMLInputElement) {
    const c = s.chinese!;
    const ids = ['#zf-main', '#zf-animal', '#zf-element', '#zf-ganzhi', '#zf-ny'];
    const date = parseISODate(input.value);
    if (!date) return clear(s.errorEmpty, ids);
    savePref('zodiac-finder', input.value);
    const z = chineseZodiacOf(date);
    if (!z) {
      highlight('animal', null);
      return clear(c.outOfRange, ids);
    }
    error.hidden = true;
    const animal = c.animals[z.branchIndex];
    const element = c.elements[z.element] ?? z.element;
    set('#zf-main', t(c.main, { animal }));
    set('#zf-sub', t(c.sub, { date: longDate(date, true), element, animal }));
    set('#zf-animal', animal);
    set('#zf-element', t(c.element, { element, yinyang: z.yang ? c.yang : c.yin }));
    set('#zf-ganzhi', t(c.ganzhi, { ganzhi: z.ganzhi, pinyin: `${c.stemPinyin[z.stemIndex]} ${c.branchPinyin[z.branchIndex]}` }));
    set('#zf-ny', formatDate(ymdDate(z.newYear), locale, { month: 'short', day: 'numeric', timeZone: 'UTC' }));
    set('#zf-ny-label', t(c.newYearLabel, { year: date.y }));
    const naive = c.animals[stemBranchOf(date.y).branchIndex];
    const sameDay = z.newYear.m === date.m && z.newYear.d === date.d;
    const text = z.beforeNewYear
      ? t(c.beforeNewYear, { year: date.y, date: longDate(z.newYear), animal, naive })
      : sameDay
        ? t(c.onNewYear, { date: longDate(z.newYear) })
        : '';
    note!.textContent = text;
    note!.hidden = !text;
    highlight('animal', z.animal);
  }

  /* ---------- ja: 干支 (switches on 1 January) ---------- */
  function renderEto(select: HTMLSelectElement) {
    const e = s.eto!;
    const year = Number(select.value);
    if (!Number.isInteger(year)) return clear(s.errorEmpty, ['#zf-main', '#zf-branch', '#zf-stem', '#zf-toshi', '#zf-kanreki']);
    savePref('zodiac-finder:ja', year);
    error.hidden = true;
    const sb = stemBranchOf(year);
    const stem = sb.ganzhi[0];
    const branch = sb.ganzhi[1];
    const kana = e.stemKana[sb.stemIndex] + e.branchKana[sb.branchIndex];
    set('#zf-main', t(e.main, { ganzhi: sb.ganzhi, kana }));
    set('#zf-sub', t(e.sub, { year, wareki: warekiOf(year).join('・'), branch, branchKana: e.branchKana[sb.branchIndex] }));
    set('#zf-branch', t(e.branch, { branch, kana: e.branchKana[sb.branchIndex] }));
    set('#zf-branch-label', t(e.branchLabel, { animal: e.animals[sb.branchIndex] }));
    set('#zf-stem', t(e.stem, { stem, kana: e.stemKana[sb.stemIndex] }));
    set('#zf-stem-label', t(e.stemLabel, { element: sb.element, yinyang: sb.yang ? e.yang : e.yin }));
    const thisYear = new Date().getFullYear();
    const next = nextAnimalYear(year, thisYear);
    set('#zf-toshi', t(e.toshi, { year: next.year }));
    set('#zf-toshi-label', t(next.year === thisYear ? e.toshiThisYear : e.toshiLabel, { age: next.age }));
    set('#zf-kanreki', t(e.kanreki, { year: kanrekiYear(year) }));
    highlight('branch', String(sb.branchIndex));
  }

  if (mode === 'eto') {
    const select = $<HTMLSelectElement>('#zf-year', root);
    const saved = loadPref<number>('zodiac-finder:ja', 0);
    if (select.querySelector(`option[value="${saved}"]`)) select.value = String(saved);
    select.addEventListener('change', () => renderEto(select));
    renderEto(select);
  } else {
    const input = $<HTMLInputElement>('#zf-date', root);
    const render = () => (mode === 'chinese' ? renderChinese(input) : renderTw(input));
    const saved = loadPref<string>('zodiac-finder', '');
    if (parseISODate(saved)) input.value = saved;
    input.addEventListener('input', render);
    render();
  }
</script>



<style>
  .zf-date {
    flex: 1 1 220px;
    max-width: 320px;
  }
  .zf-table :global(tr.is-current) td {
    background: var(--accent-soft);
    font-weight: 700;
  }
  .zf-years-cell {
    white-space: normal !important;
  }
  .zf-years {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    min-width: 260px;
  }
  .zf-years .muted {
    font-size: 12px;
  }
</style>
