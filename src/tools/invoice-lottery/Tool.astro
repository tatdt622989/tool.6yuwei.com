---
// Every period's numbers and the prize table are rendered at build time (crawlable); the script only handles
// checking, the period switch, countdowns and the session history.
import { drawAfter, formatDate, formatPrize, LATEST, PERIODS, PRIZES, prizeTax, shortLabel } from './logic';

const next = drawAfter(LATEST);
const head = (n: string) => n.slice(0, 5);
const tail = (n: string) => n.slice(5);
---

<div class="tool" data-tool="invoice-lottery">
  <p class="notice" id="il-stale" hidden></p>

  <div class="stats">
    <div class="stat">
      <span class="stat-value" id="il-next">{formatDate(next.date, false)}</span>
      <span class="stat-label" id="il-next-label">下次開獎：{shortLabel(next.period)}・{formatDate(next.date)}</span>
    </div>
    <div class="stat">
      <span class="stat-value" id="il-claim">{formatDate(LATEST.claimEnd, false)}</span>
      <span class="stat-label" id="il-claim-label">{shortLabel(LATEST.period)}領獎期限</span>
    </div>
  </div>

  <section class="il-section" aria-labelledby="il-check-title">
    <div class="row between">
      <h2 class="il-title" id="il-check-title">對獎</h2>
      <div class="seg" role="radiogroup" aria-label="輸入方式">
        <label><input type="radio" name="il-mode" value="quick" checked /><span>末三碼</span></label>
        <label><input type="radio" name="il-mode" value="full" /><span>完整 8 碼</span></label>
      </div>
    </div>

    <div class="field">
      <label for="il-period">對獎期別</label>
      <select id="il-period">
        {PERIODS.map((p) => <option value={p.period}>{p.label}（{formatDate(p.drawDate, false)} 開獎）</option>)}
      </select>
    </div>

    <div class="field" id="il-quick-wrap">
      <label for="il-quick">發票號碼末三碼</label>
      <input
        id="il-quick"
        class="il-input"
        type="text"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="3"
        autocomplete="off"
        enterkeyhint="next"
        placeholder="000"
      />
    </div>

    <div class="field" id="il-prefix-wrap" hidden>
      <label for="il-prefix">補上前 5 碼</label>
      <div class="il-split">
        <input
          id="il-prefix"
          class="il-input"
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="5"
          autocomplete="off"
          enterkeyhint="done"
          placeholder="00000"
        />
        <span class="il-suffix" id="il-suffix" aria-label="末三碼">000</span>
      </div>
      <span class="hint">輸入 5 碼後自動核對；按 Esc 或「略過」回到末三碼。<button class="btn small ghost il-skip" type="button" id="il-skip">略過</button></span>
    </div>

    <div class="field" id="il-full-wrap" hidden>
      <label for="il-full">完整 8 碼發票號碼</label>
      <input
        id="il-full"
        class="il-input"
        type="text"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="8"
        autocomplete="off"
        enterkeyhint="next"
        placeholder="00000000"
      />
    </div>

    <div class="il-result is-idle" id="il-result" aria-live="polite">
      <div class="il-result-value" id="il-result-value">輸入末三碼開始對獎</div>
      <div class="il-result-label" id="il-result-label">沒中會自動清空，可以直接輸入下一張。</div>
    </div>
  </section>

  <section class="il-section" aria-labelledby="il-numbers-title">
    {
      PERIODS.map((p, i) => (
        <div class="il-period" data-period={p.period} hidden={i !== 0}>
          <div class="row between">
            <h2 class="il-title" id={i === 0 ? 'il-numbers-title' : undefined}>
              {p.label}中獎號碼
            </h2>
            <span class="hint">{formatDate(p.drawDate)} 開獎</span>
          </div>
          <dl class="il-numbers">
            <div class="il-num-row">
              <dt>
                特別獎<span>1,000 萬元</span>
              </dt>
              <dd>
                <span class="il-num">{head(p.special)}<b>{tail(p.special)}</b></span>
              </dd>
            </div>
            <div class="il-num-row">
              <dt>
                特獎<span>200 萬元</span>
              </dt>
              <dd>
                <span class="il-num">{head(p.grand)}<b>{tail(p.grand)}</b></span>
              </dd>
            </div>
            <div class="il-num-row">
              <dt>
                頭獎<span>20 萬元</span>
              </dt>
              <dd>
                {p.first.map((n) => (
                  <span class="il-num">{head(n)}<b>{tail(n)}</b></span>
                ))}
              </dd>
            </div>
          </dl>
          <p class="hint">
            領獎期間 {formatDate(p.claimStart)} 至 {formatDate(p.claimEnd)}。二獎到六獎依頭獎末 7 到末 3 碼比對；增開六獎已停辦。
          </p>
        </div>
      ))
    }
  </section>

  <section class="il-section" aria-labelledby="il-history-title">
    <div class="row between">
      <h2 class="il-title" id="il-history-title">對獎紀錄</h2>
      <button class="btn small ghost" type="button" id="il-clear" hidden>清除紀錄</button>
    </div>
    <p class="hint" id="il-summary">對過的號碼會列在這裡，只保存在這個分頁，關閉後自動清除。</p>
    <ol class="il-history" id="il-history"></ol>
  </section>

  <div class="field">
    <span class="label">統一發票獎金與實領金額</span>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>獎別</th><th>對中條件</th><th class="num">獎金</th><th class="num">臨櫃實領</th></tr>
        </thead>
        <tbody>
          {
            PRIZES.map((p) => (
              <tr>
                <td>{p.name}</td>
                <td class="il-rule">{p.rule}</td>
                <td class="num">{formatPrize(p.amount)}</td>
                <td class="num">{prizeTax(p.amount).net.toLocaleString('zh-TW')} 元</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">超過 5,000 元預扣 20% 所得稅；500 元以上臨櫃領取另繳 0.4% 印花稅，設定帳戶自動匯款可免印花稅。</span>
  </div>

  <div class="field">
    <span class="label">近 {PERIODS.length} 期統一發票中獎號碼</span>
    <div class="table-wrap">
      <table class="table il-archive">
        <thead>
          <tr><th>期別</th><th>特別獎</th><th>特獎</th><th>頭獎</th><th>領獎期限</th></tr>
        </thead>
        <tbody>
          {
            PERIODS.map((p) => (
              <tr data-claim-end={p.claimEnd}>
                <td>{shortLabel(p.period)}</td>
                <td class="mono">{p.special}</td>
                <td class="mono">{p.grand}</td>
                <td class="mono">{p.first.join('、')}</td>
                <td>{formatDate(p.claimEnd, false)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">已過領獎期限的期別以淡色顯示。</span>
  </div>

  <p class="notice">
    中獎號碼資料來源：<a href="https://invoice.etax.nat.gov.tw/" target="_blank" rel="noopener">財政部稅務入口網「統一發票中獎號碼單」</a>（依政府網站資料開放宣告使用），每期開獎後自動更新；本工具只對一般號碼獎，雲端發票專屬獎請至財政部電子發票整合服務平台查詢。實際中獎與領獎以財政部公告為準。
  </p>
</div>

<script>
  import { $, $$ } from '../../lib/client';
  import {
    checkNumber,
    claimStatus,
    daysBetween,
    formatDate,
    formatPrize,
    isStale,
    lastDraw,
    nextDraw,
    normalizeInput,
    PERIODS,
    prizeTax,
    shortLabel,
    todayInTaipei,
    type InvoicePeriod,
  } from './logic';

  interface Entry {
    digits: string;
    period: string;
    prize: string | null;
    amount: number;
    /** Only the last 3 digits were checked (prefix skipped). */
    partial?: boolean;
  }

  const root = $('[data-tool="invoice-lottery"]');
  const select = $<HTMLSelectElement>('#il-period', root);
  const quick = $<HTMLInputElement>('#il-quick', root);
  const prefix = $<HTMLInputElement>('#il-prefix', root);
  const full = $<HTMLInputElement>('#il-full', root);
  const wraps = { quick: $('#il-quick-wrap', root), prefix: $('#il-prefix-wrap', root), full: $('#il-full-wrap', root) };
  const result = $('#il-result', root);
  const historyList = $('#il-history', root);
  const today = todayInTaipei();
  const HISTORY_KEY = 'tool:invoice-lottery:history';

  let period: InvoicePeriod = PERIODS[0];
  let mode: 'quick' | 'full' = 'quick';
  let pendingSuffix: string | null = null;
  let history: Entry[] = [];
  try {
    history = JSON.parse(sessionStorage.getItem(HISTORY_KEY) ?? '[]') as Entry[];
  } catch {
    history = [];
  }

  const set = (id: string, text: string) => ($(id, root).textContent = text);
  const money = (n: number) => `${n.toLocaleString('zh-TW')} 元`;

  function renderSchedule() {
    const nd = nextDraw(today);
    const days = daysBetween(today, nd.date);
    set('#il-next', days === 0 ? '今天開獎' : `${days} 天`);
    set('#il-next-label', `距離 ${shortLabel(nd.period)}開獎・${formatDate(nd.date)}`);

    const stale = $('#il-stale', root);
    if (isStale(PERIODS, today)) {
      const ld = lastDraw(today);
      stale.textContent = `${shortLabel(ld.period)}已於 ${formatDate(ld.date)} 開獎，本站號碼更新中，請先以財政部稅務入口網公告為準。`;
      stale.hidden = false;
    }
    for (const tr of $$<HTMLElement>('tr[data-claim-end]', root)) {
      tr.classList.toggle('is-expired', (tr.dataset.claimEnd ?? '') < today);
    }
  }

  function renderPeriod() {
    for (const block of $$<HTMLElement>('[data-period]', root)) block.hidden = block.dataset.period !== period.period;
    const cs = claimStatus(period, today);
    const name = shortLabel(period.period);
    if (cs.state === 'open') {
      set('#il-claim', `剩 ${cs.days} 天`);
      set('#il-claim-label', `${name}領獎期限 ${formatDate(period.claimEnd)}`);
    } else if (cs.state === 'upcoming') {
      set('#il-claim', `${cs.days} 天後開始領獎`);
      set('#il-claim-label', `${name}領獎期間 ${formatDate(period.claimStart, false)}–${formatDate(period.claimEnd, false)}`);
    } else {
      set('#il-claim', '已截止');
      set('#il-claim-label', `${name}領獎期限已於 ${formatDate(period.claimEnd)} 截止`);
    }
  }

  function show(kind: 'idle' | 'lose' | 'win' | 'maybe', value: string, label: string) {
    result.className = `il-result is-${kind}`;
    set('#il-result-value', value);
    set('#il-result-label', label);
  }

  const expiredNote = () => (claimStatus(period, today).state === 'expired' ? '（注意：本期領獎期限已過）' : '');

  function record(entry: Entry) {
    history.unshift(entry);
    history = history.slice(0, 50);
    try {
      sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    } catch {
      /* storage unavailable */
    }
    renderHistory();
  }

  function renderHistory() {
    historyList.replaceChildren(
      ...history.map((e) => {
        const li = document.createElement('li');
        li.className = e.prize ? 'is-win' : '';
        const num = document.createElement('span');
        num.className = 'il-h-num';
        num.textContent = e.digits.length === 3 ? `•••••${e.digits}` : e.digits;
        const res = document.createElement('span');
        res.className = 'il-h-res';
        res.textContent = e.prize ? `${e.partial ? '至少' : ''}${e.prize} ${formatPrize(e.amount)}` : '沒中';
        const per = document.createElement('span');
        per.className = 'il-h-period';
        per.textContent = shortLabel(e.period);
        li.append(num, res, per);
        return li;
      }),
    );
    const wins = history.filter((e) => e.prize);
    const sum = wins.reduce((s, e) => s + e.amount, 0);
    set(
      '#il-summary',
      history.length === 0
        ? '對過的號碼會列在這裡，只保存在這個分頁，關閉後自動清除。'
        : `已對 ${history.length} 張，中獎 ${wins.length} 張，獎金合計 ${money(sum)}。`,
    );
    $('#il-clear', root).hidden = history.length === 0;
  }

  function showWraps() {
    wraps.quick.hidden = mode !== 'quick' || pendingSuffix !== null;
    wraps.prefix.hidden = mode !== 'quick' || pendingSuffix === null;
    wraps.full.hidden = mode !== 'full';
  }

  function focusCurrent() {
    (mode === 'full' ? full : pendingSuffix !== null ? prefix : quick).focus();
  }

  /** Final answer for a complete 8-digit number. */
  function finish(number: string) {
    const r = checkNumber(number, period);
    if (r.prize) {
      const tax = prizeTax(r.prize.amount);
      const deductions = tax.incomeTax + tax.stamp > 0 ? `，臨櫃實領 ${money(tax.net)}` : '';
      show('win', `中${r.prize.name} ${formatPrize(r.prize.amount)}`, `${number}：${r.prize.rule}（${r.matched}）${deductions}${expiredNote()}`);
    } else {
      show('lose', `${number} 沒中`, `${period.label}：與特別獎、特獎、頭獎都不相符。`);
    }
    record({ digits: number, period: period.period, prize: r.prize?.name ?? null, amount: r.prize?.amount ?? 0 });
  }

  function onQuick() {
    const v = normalizeInput(quick.value).slice(0, 3);
    quick.value = v;
    if (v.length < 3) return;
    const r = checkNumber(v, period);
    quick.value = '';
    if (r.possible.length === 0) {
      show('lose', `${v} 沒中`, `末三碼和 ${period.label}的頭獎、特別獎、特獎都不同，直接輸入下一張。`);
      record({ digits: v, period: period.period, prize: null, amount: 0 });
      return;
    }
    pendingSuffix = v;
    set('#il-suffix', v);
    prefix.value = '';
    if (r.prize) {
      show('win', `至少中${r.prize.name} ${formatPrize(r.prize.amount)}`, `末三碼 ${v} 與頭獎 ${r.matched} 相同，補上前 5 碼看是否中更高獎項。${expiredNote()}`);
    } else {
      show('maybe', `末三碼與${r.possible[0].name}相同`, `${r.possible[0].name}要 8 碼全部相同才算中獎，請補上前 5 碼核對。`);
    }
    showWraps();
    prefix.focus();
  }

  function leavePrefix(skip: boolean) {
    if (skip && pendingSuffix) {
      const r = checkNumber(pendingSuffix, period);
      record({ digits: pendingSuffix, period: period.period, prize: r.prize?.name ?? null, amount: r.prize?.amount ?? 0, partial: !!r.prize });
      show('idle', '已略過', r.prize ? `末三碼 ${pendingSuffix} 至少中${r.prize.name}，記得找出發票核對完整號碼。` : '輸入下一張的末三碼。');
    }
    pendingSuffix = null;
    showWraps();
    focusCurrent();
  }

  function onPrefix() {
    const v = normalizeInput(prefix.value).slice(0, 5);
    prefix.value = v;
    if (v.length < 5 || pendingSuffix === null) return;
    finish(v + pendingSuffix);
    prefix.value = '';
    leavePrefix(false);
  }

  function onFull() {
    const v = normalizeInput(full.value).slice(0, 8);
    full.value = v;
    if (v.length < 8) return;
    finish(v);
    full.value = '';
  }

  quick.addEventListener('input', onQuick);
  prefix.addEventListener('input', onPrefix);
  full.addEventListener('input', onFull);
  prefix.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') leavePrefix(true);
    else if (e.key === 'Backspace' && prefix.value === '') leavePrefix(true);
  });
  full.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') full.value = '';
  });
  $('#il-skip', root).addEventListener('click', () => leavePrefix(true));

  for (const radio of $$<HTMLInputElement>('input[name="il-mode"]', root)) {
    radio.addEventListener('change', () => {
      mode = radio.value === 'full' ? 'full' : 'quick';
      pendingSuffix = null;
      quick.value = prefix.value = full.value = '';
      show('idle', mode === 'full' ? '輸入完整 8 碼對獎' : '輸入末三碼開始對獎', mode === 'full' ? '輸入 8 碼後自動對獎，結果會記在下方。' : '沒中會自動清空，可以直接輸入下一張。');
      showWraps();
      focusCurrent();
    });
  }

  select.addEventListener('change', () => {
    period = PERIODS.find((p) => p.period === select.value) ?? PERIODS[0];
    pendingSuffix = null;
    quick.value = prefix.value = full.value = '';
    show('idle', `改對 ${period.label}`, mode === 'full' ? '輸入完整 8 碼對獎。' : '輸入末三碼開始對獎。');
    renderPeriod();
    showWraps();
  });

  $('#il-clear', root).addEventListener('click', () => {
    history = [];
    try {
      sessionStorage.removeItem(HISTORY_KEY);
    } catch {
      /* storage unavailable */
    }
    renderHistory();
  });

  renderSchedule();
  renderPeriod();
  renderHistory();
</script>

<style>
  .il-section {
    display: grid;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    min-width: 0;
  }
  .il-title {
    font-size: 18px;
  }
  input.il-input {
    font-family: var(--mono);
    font-size: clamp(28px, 9vw, 40px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    text-align: center;
    padding: 8px 12px;
    line-height: 1.2;
  }
  input.il-input::placeholder {
    color: var(--border-strong);
  }
  .il-split {
    display: flex;
    align-items: stretch;
    gap: 6px;
    min-width: 0;
  }
  .il-split input.il-input {
    flex: 1 1 auto;
    min-width: 0;
    text-align: right;
  }
  .il-suffix {
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-family: var(--mono);
    font-size: clamp(28px, 9vw, 40px);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
  }
  .il-skip {
    margin-left: 4px;
    vertical-align: baseline;
  }

  .il-result {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  .il-result-value {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .il-result-label {
    font-size: 14px;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .il-result.is-win {
    background: var(--accent-soft);
    border-color: color-mix(in oklab, var(--accent) 22%, transparent);
  }
  .il-result.is-win .il-result-value {
    color: var(--accent-hover);
  }
  .il-result.is-maybe {
    background: var(--surface);
    border-color: color-mix(in oklab, var(--warning) 35%, transparent);
  }
  .il-result.is-maybe .il-result-value {
    color: var(--warning);
  }
  .il-result.is-lose .il-result-value {
    color: var(--text-2);
  }

  .il-period {
    display: grid;
    gap: 12px;
  }
  .il-numbers {
    display: grid;
    gap: 0;
    margin: 0;
  }
  .il-num-row {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .il-num-row:first-child {
    padding-top: 0;
  }
  .il-num-row:last-child {
    border-bottom: 0;
  }
  .il-num-row dt {
    display: grid;
    font-weight: 700;
    line-height: 1.35;
    padding-top: 4px;
  }
  .il-num-row dt span {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }
  .il-num-row dd {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    min-width: 0;
  }
  .il-num {
    font-family: var(--mono);
    font-size: clamp(22px, 6.4vw, 28px);
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .il-num b {
    color: var(--accent);
    font-weight: 700;
  }

  .il-history {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
  }
  .il-history:empty {
    display: none;
  }
  .il-history :global(li) {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 8px 2px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .il-history :global(li:last-child) {
    border-bottom: 0;
  }
