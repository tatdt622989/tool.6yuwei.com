---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="ovulation-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="grid-3">
    <div class="field">
      <label for="ov-last">{s.lastLabel}</label>
      <input id="ov-last" type="date" />
    </div>
    <div class="field">
      <label for="ov-cycle">{s.cycleLabel}</label>
      <input id="ov-cycle" type="text" inputmode="numeric" autocomplete="off" value="28" />
    </div>
    <div class="field">
      <label for="ov-period">{s.periodLabel}</label>
      <input id="ov-period" type="text" inputmode="numeric" autocomplete="off" value="5" />
    </div>
  </div>

  <div class="field">
    <span class="label">{s.countLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.countLabel}>
      <label><input type="radio" name="ov-count" value="3" checked /><span>{s.count3}</span></label>
      <label><input type="radio" name="ov-count" value="6" /><span>{s.count6}</span></label>
    </div>
  </div>

  <div class="notice error" id="ov-error" hidden></div>

  <div id="ov-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="ov-main">—</div>
      <div class="result-label" id="ov-main-label">{s.mainLabel}</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ov-fertile">—</span><span class="stat-label">{s.fertileLabel}</span></div>
      <div class="stat"><span class="stat-value" id="ov-next">—</span><span class="stat-label">{s.nextLabel}</span></div>
      <div class="stat"><span class="stat-value" id="ov-today">—</span><span class="stat-label" id="ov-today-label">{s.todayLabel}</span></div>
    </div>

    <div class="field">
      <span class="label">{s.calendarLabel}</span>
      <ul class="ov-legend">
        <li><span class="ov-swatch ov-period"></span>{s.legend.period}</li>
        <li><span class="ov-swatch ov-fertile"></span>{s.legend.fertile}</li>
        <li><span class="ov-swatch ov-ovulation"></span>{s.legend.ovulation}</li>
        <li><span class="ov-swatch ov-other"></span>{s.legend.other}</li>
        <li><span class="ov-swatch ov-today-swatch"></span>{s.legend.today}</li>
      </ul>
      <div class="ov-months" id="ov-months"></div>
    </div>

    <div class="field">
      <span class="label">{s.tableLabel}</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>{s.thStart}</th><th>{s.thFertile}</th><th>{s.thOvulation}</th><th>{s.thNext}</th></tr>
          </thead>
          <tbody id="ov-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">{`\n${s.notice}\n`}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { formatDate, plural } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { addDays, parseISODate, toDayNumber, toISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import {
    cycleInputError,
    dayKind,
    monthGrid,
    monthsCovered,
    predictCycles,
    todayStatus,
    type Cycle,
    type CycleInput,
  } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="ovulation-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const lastInput = $<HTMLInputElement>('#ov-last', root);
  const cycleInput = $<HTMLInputElement>('#ov-cycle', root);
  const periodInput = $<HTMLInputElement>('#ov-period', root);
  const counts = $$<HTMLInputElement>('input[name="ov-count"]', root);
  const error = $('#ov-error', root);
  const output = $('#ov-output', root);
  const monthsEl = $('#ov-months', root);
  const table = $('#ov-table', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }
  const intl = s.intl;
  const toDate = (d: YMD) => new Date(d.y, d.m - 1, d.d);
  const fmt = (d: YMD, o: Intl.DateTimeFormatOptions) => formatDate(toDate(d), locale, o);
  // en / ja format through Intl; zh-TW keeps its original hand-built formats.
  const md = (d: YMD) => (intl ? fmt(d, intl.md) : `${d.m}/${d.d}`);
  const mdw = (d: YMD) => (intl ? fmt(d, intl.mdw) : `${d.m}/${d.d}（${WEEKDAY_LABEL[weekdayOf(d)]}）`);
  const mdRange = (a: YMD, b: YMD) =>
    intl && !intl.rangeSep
      ? new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, intl.md).formatRange(toDate(a), toDate(b))
      : `${md(a)}${intl?.rangeSep ?? '–'}${md(b)}`;
  const mainDate = (d: YMD) => (intl ? fmt(d, intl.main) : `${d.y} 年 ${mdw(d)}`);
  const caption = (y: number, m: number) => (intl ? fmt({ y, m, d: 1 }, intl.caption) : `${y} 年 ${m} 月`);
  const dayName = (d: YMD) => (intl ? fmt(d, intl.day) : `${d.m} 月 ${d.d} 日`);
  // Sunday-first weekday headers (2026-11-01 is a Sunday).
  const weekdays = intl
    ? Array.from({ length: 7 }, (_, i) => fmt({ y: 2026, m: 11, d: 1 + i }, { weekday: intl.weekday }))
    : [...WEEKDAY_LABEL];

  const saved = loadPref('ovulation-calculator', {
    last: toISODate(addDays(today(), -9)),
    cycle: '28',
    period: '5',
    count: '3',
  });
  lastInput.value = saved.last;
  cycleInput.value = saved.cycle;
  periodInput.value = saved.period;
  for (const c of counts) c.checked = c.value === saved.count;
  if (!counts.some((c) => c.checked)) counts[0].checked = true;
  lastInput.max = toISODate(today());

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function renderCalendar(cycles: Cycle[], now: YMD) {
    const todayN = toDayNumber(now);
    const head = weekdays.map((w) => `<span class="ov-wd" aria-hidden="true">${w}</span>`).join('');
    monthsEl.innerHTML = monthsCovered(cycles)
      .map(({ y, m }) => {
        const days = monthGrid(y, m)
          .flat()
          .map((d) => {
            if (!d) return '<span class="ov-day ov-empty"></span>';
            const kind = dayKind(d, cycles);
            const isToday = toDayNumber(d) === todayN;
            const cls = ['ov-day', kind ? `ov-${kind}` : '', isToday ? 'ov-is-today' : ''].filter(Boolean).join(' ');
            const label = `${dayName(d)}${kind ? `${s.sep}${s.kinds[kind]}` : ''}${isToday ? `${s.sep}${s.today}` : ''}`;
            return `<span class="${cls}" title="${label}" aria-label="${label}">${d.d}</span>`;
          })
          .join('');
        return `<div class="ov-month"><div class="ov-caption">${caption(y, m)}</div><div class="ov-grid">${head}${days}</div></div>`;
      })
      .join('');
  }

  function render() {
    const count = counts.find((c) => c.checked)?.value ?? '3';
    savePref('ovulation-calculator', { last: lastInput.value, cycle: cycleInput.value, period: periodInput.value, count });
    const lastStart = parseISODate(lastInput.value);
    if (!lastStart) return fail(s.errorDate);
    const input: CycleInput = {
      lastStart,
      cycle: parseNumber(cycleInput.value),
      period: parseNumber(periodInput.value),
      count: Number(count),
    };
    const now = today();
    const problem = cycleInputError(input, now);
    if (problem) return fail(s.errors[problem]);
    const cycles = predictCycles(input, now);
    const status = todayStatus(cycles, now);
    if (!cycles.length || !status) return fail(s.errorGeneric);
    error.hidden = true;
    output.hidden = false;

    // Show the upcoming ovulation: this cycle's if it has not passed, otherwise the next cycle's.
    const target = status.daysToOvulation >= 0 || cycles.length < 2 ? cycles[0] : cycles[1];
    const daysTo = toDayNumber(target.ovulation) - toDayNumber(now);
    set('#ov-main', mainDate(target.ovulation));
    set('#ov-main-label', daysTo === 0 ? s.mainToday : daysTo > 0 ? plural(locale, daysTo, s.mainFuture) : s.mainPast);
    set('#ov-fertile', mdRange(target.fertileStart, target.fertileEnd));
    set('#ov-next', mdw(cycles[0].nextStart));
    set('#ov-today', status.kind ? s.kinds[status.kind] : '—');
    set('#ov-today-label', s.todayCycle.replace('{n}', String(status.cycleDay)));

    renderCalendar(cycles, now);
    table.innerHTML = cycles
      .map((c) => `<tr><td>${mdw(c.periodStart)}</td><td>${mdRange(c.fertileStart, c.fertileEnd)}</td><td>${mdw(c.ovulation)}</td><td>${mdw(c.nextStart)}</td></tr>`)
      .join('');
  }

  [lastInput, cycleInput, periodInput].forEach((el) => el.addEventListener('input', render));
  counts.forEach((c) => c.addEventListener('change', render));
  render();
</script>

<style>
  #ov-output {
    display: grid;
    gap: 16px;
  }
  .ov-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--text-2);
  }
  .ov-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ov-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .ov-months {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .ov-months :global(.ov-month) {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .ov-months :global(.ov-caption) {
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
  }
  .ov-months :global(.ov-grid) {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px;
  }
  .ov-months :global(.ov-wd) {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
  }
  .ov-months :global(.ov-day) {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    border-radius: 6px;
    color: var(--muted);
  }
  .ov-months :global(.ov-other) {
    color: var(--text);
  }
  .ov-months :global(.ov-period),
  .ov-swatch.ov-period {
    background: color-mix(in oklab, var(--danger) 22%, transparent);
    color: var(--text);
  }
  .ov-months :global(.ov-fertile),
  .ov-swatch.ov-fertile {
    background: color-mix(in oklab, var(--success) 22%, transparent);
    color: var(--text);
  }
  .ov-months :global(.ov-ovulation),
  .ov-swatch.ov-ovulation {
    background: var(--success);
    color: var(--surface);
    font-weight: 700;
  }
  .ov-swatch.ov-other {
    background: var(--surface);
  }
  .ov-months :global(.ov-is-today),
  .ov-swatch.ov-today-swatch {
    box-shadow: inset 0 0 0 2px var(--accent);
    font-weight: 700;
  }
</style>
