<div class="tool" data-tool="ovulation-calculator">
  <div class="grid-3">
    <div class="field">
      <label for="ov-last">最後一次月經第一天</label>
      <input id="ov-last" type="date" />
    </div>
    <div class="field">
      <label for="ov-cycle">月經週期（天）</label>
      <input id="ov-cycle" type="text" inputmode="numeric" autocomplete="off" value="28" />
    </div>
    <div class="field">
      <label for="ov-period">經期天數（天）</label>
      <input id="ov-period" type="text" inputmode="numeric" autocomplete="off" value="5" />
    </div>
  </div>

  <div class="field">
    <span class="label">預測週期數</span>
    <div class="seg" role="radiogroup" aria-label="預測週期數">
      <label><input type="radio" name="ov-count" value="3" checked /><span>3 個週期</span></label>
      <label><input type="radio" name="ov-count" value="6" /><span>6 個週期</span></label>
    </div>
  </div>

  <div class="notice error" id="ov-error" hidden></div>

  <div id="ov-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="ov-main">—</div>
      <div class="result-label" id="ov-main-label">本週期排卵日</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ov-fertile">—</span><span class="stat-label">易孕期（排卵期）</span></div>
      <div class="stat"><span class="stat-value" id="ov-next">—</span><span class="stat-label">下次月經預計</span></div>
      <div class="stat"><span class="stat-value" id="ov-today">—</span><span class="stat-label" id="ov-today-label">今天</span></div>
    </div>

    <div class="field">
      <span class="label">排卵期日曆</span>
      <ul class="ov-legend">
        <li><span class="ov-swatch ov-period"></span>月經期（預測）</li>
        <li><span class="ov-swatch ov-fertile"></span>易孕期</li>
        <li><span class="ov-swatch ov-ovulation"></span>排卵日</li>
        <li><span class="ov-swatch ov-other"></span>相對安全期（不可靠）</li>
        <li><span class="ov-swatch ov-today-swatch"></span>今天</li>
      </ul>
      <div class="ov-months" id="ov-months"></div>
    </div>

    <div class="field">
      <span class="label">各週期日期一覽</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>月經開始</th><th>易孕期</th><th>排卵日</th><th>下次月經</th></tr>
          </thead>
          <tbody id="ov-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="notice">
    結果僅供參考，請諮詢醫師。「安全期」不是可靠的避孕方法：排卵日會受壓力、作息、疾病影響而提前或延後，以日曆推算避孕的一般使用失敗率約 2 成以上。需要避孕請使用保險套或經醫師評估的避孕方式。資料只在你的瀏覽器中計算，不會上傳。
  </p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, parseNumber } from '../../lib/format';
  import { addDays, parseISODate, toDayNumber, toISODate, WEEKDAY_LABEL, weekdayOf, type YMD } from '../date-diff/logic';
  import {
    dayKind,
    monthGrid,
    monthsCovered,
    predictCycles,
    todayStatus,
    validateCycleInput,
    type Cycle,
    type CycleInput,
    type DayKind,
  } from './logic';

  const root = $('[data-tool="ovulation-calculator"]');
  const lastInput = $<HTMLInputElement>('#ov-last', root);
  const cycleInput = $<HTMLInputElement>('#ov-cycle', root);
  const periodInput = $<HTMLInputElement>('#ov-period', root);
  const counts = $$<HTMLInputElement>('input[name="ov-count"]', root);
  const error = $('#ov-error', root);
  const output = $('#ov-output', root);
  const monthsEl = $('#ov-months', root);
  const table = $('#ov-table', root);
  const set = (id: string, text: string) => ($(id, root).textContent = text);

  const KIND_LABEL: Record<DayKind, string> = { period: '月經期', ovulation: '排卵日', fertile: '易孕期', other: '相對安全期' };

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }
  const md = (d: YMD) => `${d.m}/${d.d}`;
  const mdw = (d: YMD) => `${d.m}/${d.d}（${WEEKDAY_LABEL[weekdayOf(d)]}）`;

  const saved = loadPref('ovulation-calculator', {
    last: toISODate(addDays(today(), -9)),
    cycle: '28',
    period: '5',
    count: '3',
  });
  lastInput.value = saved.last;
  cycleInput.value = saved.cycle;
  periodInput.value = saved.period;
  for (const c of counts) c.checked = c.value === saved.count;
  if (!counts.some((c) => c.checked)) counts[0].checked = true;
  lastInput.max = toISODate(today());

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function renderCalendar(cycles: Cycle[], now: YMD) {
    const todayN = toDayNumber(now);
    const head = WEEKDAY_LABEL.map((w) => `<span class="ov-wd" aria-hidden="true">${w}</span>`).join('');
    monthsEl.innerHTML = monthsCovered(cycles)
      .map(({ y, m }) => {
        const days = monthGrid(y, m)
          .flat()
          .map((d) => {
            if (!d) return '<span class="ov-day ov-empty"></span>';
            const kind = dayKind(d, cycles);
            const isToday = toDayNumber(d) === todayN;
            const cls = ['ov-day', kind ? `ov-${kind}` : '', isToday ? 'ov-is-today' : ''].filter(Boolean).join(' ');
            const label = `${m} 月 ${d.d} 日${kind ? `，${KIND_LABEL[kind]}` : ''}${isToday ? '，今天' : ''}`;
            return `<span class="${cls}" title="${label}" aria-label="${label}">${d.d}</span>`;
          })
          .join('');
        return `<div class="ov-month"><div class="ov-caption">${y} 年 ${m} 月</div><div class="ov-grid">${head}${days}</div></div>`;
      })
      .join('');
  }

  function render() {
    const count = counts.find((c) => c.checked)?.value ?? '3';
    savePref('ovulation-calculator', { last: lastInput.value, cycle: cycleInput.value, period: periodInput.value, count });
    const lastStart = parseISODate(lastInput.value);
    if (!lastStart) return fail('請選擇最後一次月經第一天。');
    const input: CycleInput = {
      lastStart,
      cycle: parseNumber(cycleInput.value),
      period: parseNumber(periodInput.value),
      count: Number(count),
    };
    const now = today();
    const problem = validateCycleInput(input, now);
    if (problem) return fail(problem);
    const cycles = predictCycles(input, now);
    const status = todayStatus(cycles, now);
    if (!cycles.length || !status) return fail('無法計算，請檢查輸入。');
    error.hidden = true;
    output.hidden = false;

    // Show the upcoming ovulation: this cycle's if it has not passed, otherwise the next cycle's.
    const target = status.daysToOvulation >= 0 || cycles.length < 2 ? cycles[0] : cycles[1];
    const daysTo = toDayNumber(target.ovulation) - toDayNumber(now);
    set('#ov-main', `${target.ovulation.y} 年 ${mdw(target.ovulation)}`);
    set('#ov-main-label', daysTo === 0 ? '今天是預估排卵日' : daysTo > 0 ? `預估排卵日（${formatInteger(daysTo)} 天後）` : '本週期預估排卵日（已過）');
    set('#ov-fertile', `${md(target.fertileStart)}–${md(target.fertileEnd)}`);
    set('#ov-next', mdw(cycles[0].nextStart));
    set('#ov-today', status.kind ? KIND_LABEL[status.kind] : '—');
    set('#ov-today-label', `今天（週期第 ${status.cycleDay} 天）`);

    renderCalendar(cycles, now);
    table.innerHTML = cycles
      .map((c) => `<tr><td>${mdw(c.periodStart)}</td><td>${md(c.fertileStart)}–${md(c.fertileEnd)}</td><td>${mdw(c.ovulation)}</td><td>${mdw(c.nextStart)}</td></tr>`)
      .join('');
  }

  [lastInput, cycleInput, periodInput].forEach((el) => el.addEventListener('input', render));
  counts.forEach((c) => c.addEventListener('change', render));
  render();
</script>

<style>
  #ov-output {
    display: grid;
    gap: 16px;
  }
  .ov-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--text-2);
  }
  .ov-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ov-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .ov-months {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .ov-months :global(.ov-month) {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .ov-months :global(.ov-caption) {
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
  }
  .ov-months :global(.ov-grid) {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px;
  }
  .ov-months :global(.ov-wd) {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
  }
  .ov-months :global(.ov-day) {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    border-radius: 6px;
    color: var(--muted);
  }
  .ov-months :global(.ov-other) {
    color: var(--text);
  }
  .ov-months :global(.ov-period),
  .ov-swatch.ov-period {
    background: color-mix(in oklab, var(--danger) 22%, transparent);
    color: var(--text);
  }
  .ov-months :global(.ov-fertile),
  .ov-swatch.ov-fertile {
    background: color-mix(in oklab, var(--success) 22%, transparent);
    color: var(--text);
  }
  .ov-months :global(.ov-ovulation),
  .ov-swatch.ov-ovulation {
    background: var(--success);
    color: var(--surface);
    font-weight: 700;
  }
  .ov-swatch.ov-other {
    background: var(--surface);
  }
  .ov-months :global(.ov-is-today),
  .ov-swatch.ov-today-swatch {
    box-shadow: inset 0 0 0 2px var(--accent);
    font-weight: 700;
  }
</style>
