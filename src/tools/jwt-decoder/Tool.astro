---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="jwt-decoder" {...i18nAttrs(locale, s.client)}>
  <div class="field">
    <label for="jw-input">{s.inputLabel}</label>
    <textarea
      id="jw-input"
      class="mono"
      rows="5"
      spellcheck="false"
      autocomplete="off"
      placeholder={s.placeholder}></textarea>
  </div>
  <div class="row">
    <button class="btn" type="button" id="jw-sample">{s.sample}</button>
    <button class="btn ghost" type="button" id="jw-clear">{s.clear}</button>
  </div>

  <p class="notice jw-note">{s.noteBefore}<strong>{s.noteStrong}</strong>{s.noteAfter}</p>

  <div id="jw-error" class="notice error" role="alert" hidden></div>

  <div class="jw-result" id="jw-result" hidden>
    <div id="jw-status" class="notice" aria-live="polite"></div>

    <div class="grid-2">
      <div class="field">
        <div class="jw-head">
          <span class="jw-label">{s.header}</span>
          <button class="btn small" type="button" data-copy="#jw-header">{s.copy}</button>
        </div>
        <pre class="output jw-json" id="jw-header"></pre>
      </div>
      <div class="field">
        <div class="jw-head">
          <span class="jw-label">{s.payload}</span>
          <button class="btn small" type="button" data-copy="#jw-payload">{s.copy}</button>
        </div>
        <pre class="output jw-json" id="jw-payload"></pre>
      </div>
    </div>

    <div class="field" id="jw-claims-wrap">
      <span class="label">{s.claimsLabel}</span>
      <div class="table-wrap">
        <table class="table jw-claims">
          <thead><tr><th>{s.claimCol}</th><th>{s.meaningCol}</th><th>{s.valueCol}</th></tr></thead>
          <tbody id="jw-claims"></tbody>
        </table>
      </div>
    </div>

    <div class="field">
      <span class="label">{s.signature}</span>
      <div class="output" id="jw-sig"></div>
      <span class="hint" id="jw-alg"></span>
    </div>
  </div>
</div>

<script>
  import { $ } from '../../lib/client';
  import { plural, t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { CLAIM_LABELS, TIME_CLAIMS, decodeJwt, durationParts, encodeSegment, timeClaimValue, tokenStatus } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="jwt-decoder"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#jw-input', root);
  const error = $('#jw-error', root);
  const result = $('#jw-result', root);
  const status = $('#jw-status', root);
  const claimsWrap = $('#jw-claims-wrap', root);
  const claimsBody = $('#jw-claims', root);
  const dateFmt = new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, { dateStyle: 'medium', timeStyle: 'medium' });

  let payload: unknown = null;

  const formatSeconds = (sec: number) => dateFmt.format(new Date(sec * 1000));
  /** Raw numbers (no separators) keep zh output identical: "1000 天". */
  const duration = (sec: number) =>
    durationParts(sec)
      .map(({ n, unit }) => plural(locale, n, s.units[unit], { n }))
      .join(' ');

  function renderStatus() {
    if (result.hidden) return;
    const st = tokenStatus(payload, Date.now());
    const exp = timeClaimValue(payload, 'exp');
    const nbf = timeClaimValue(payload, 'nbf');
    const d = duration(st.delta ?? 0);
    const map = {
      valid: ['ok', t(s.valid, { d, time: exp ? formatSeconds(exp) : '' })],
      expired: ['error', t(s.expired, { d, time: exp ? formatSeconds(exp) : '' })],
      'not-yet-valid': ['error', t(s.notYetValid, { d, time: nbf ? formatSeconds(nbf) : '' })],
      'no-expiry': ['', s.noExpiry],
    } as const;
    const [kind, text] = map[st.state];
    status.className = kind ? `notice ${kind}` : 'notice';
    status.textContent = text;
  }

  function claimRow(key: string, value: unknown): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const seconds = (TIME_CLAIMS as readonly string[]).includes(key) ? timeClaimValue(payload, key) : undefined;
    const display =
      seconds !== undefined
        ? t(s.timeValue, { s: seconds, date: formatSeconds(seconds) })
        : Array.isArray(value)
          ? value.join(', ')
          : typeof value === 'string'
            ? value
            : JSON.stringify(value);
    for (const text of [key, s.claims[key], display]) {
      const td = document.createElement('td');
      td.textContent = text;
      tr.append(td);
    }
    return tr;
  }

  function render() {
    error.hidden = true;
    result.hidden = true;
    if (input.value.trim() === '') return;
    const decoded = decodeJwt(input.value);
    if (!decoded.ok) {
      error.textContent = t(s.errors[decoded.code], { n: decoded.segments ?? 0 });
      error.hidden = false;
      return;
    }
    const jwt = decoded.jwt;
    payload = jwt.payload;
    $('#jw-header', root).textContent = jwt.headerJson;
    $('#jw-payload', root).textContent = jwt.payloadJson;
    $('#jw-sig', root).textContent = jwt.signature || s.emptySignature;

    const alg = typeof jwt.header.alg === 'string' ? jwt.header.alg : '';
    $('#jw-alg', root).textContent =
      alg.toLowerCase() === 'none' ? s.algNone : alg ? t(s.alg, { alg }) : s.noAlg;

    const rows =
      jwt.payloadIsJson && payload && typeof payload === 'object'
        ? Object.keys(CLAIM_LABELS)
            .filter((k) => k in (payload as object))
            .map((k) => claimRow(k, (payload as Record<string, unknown>)[k]))
        : [];
    claimsBody.replaceChildren(...rows);
    claimsWrap.hidden = rows.length === 0;
    result.hidden = false;
    renderStatus();
  }

  function sampleToken(): string {
    const now = Math.floor(Date.now() / 1000);
    const header = encodeSegment({ alg: 'HS256', typ: 'JWT' });
    const body = encodeSegment({ sub: '1234567890', name: s.sampleName, role: 'editor', iss: 'https://auth.example.com', iat: now, exp: now + 3600 });
    return `${header}.${body}.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk`;
  }

  input.addEventListener('input', render);
  $('#jw-sample', root).addEventListener('click', () => {
    input.value = sampleToken();
    render();
  });
  $('#jw-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  window.setInterval(() => {
    if (!document.hidden) renderStatus();
  }, 1000);
  render();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .jw-note {
    margin: 0;
  }
  .jw-result {
    display: grid;
    gap: 16px;
  }
  .jw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .jw-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .jw-json {
    margin: 0;
    max-height: 360px;
    overflow: auto;
  }
  .jw-claims :global(td:last-child) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
