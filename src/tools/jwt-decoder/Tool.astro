<div class="tool" data-tool="jwt-decoder">
  <div class="field">
    <label for="jw-input">貼上 JWT</label>
    <textarea
      id="jw-input"
      class="mono"
      rows="5"
      spellcheck="false"
      autocomplete="off"
      placeholder="eyJhbGciOiJIUzI1NiIs…（可含 Bearer 前綴）"></textarea>
  </div>
  <div class="row">
    <button class="btn" type="button" id="jw-sample">載入範例</button>
    <button class="btn ghost" type="button" id="jw-clear">清除</button>
  </div>

  <p class="notice jw-note">本工具只解碼內容，<strong>不驗證簽章</strong>。任何人都能解碼 JWT，請勿在其中放入密碼等機密資料；簽章是否有效必須由持有金鑰的伺服器驗證。</p>

  <div id="jw-error" class="notice error" role="alert" hidden></div>

  <div class="jw-result" id="jw-result" hidden>
    <div id="jw-status" class="notice" aria-live="polite"></div>

    <div class="grid-2">
      <div class="field">
        <div class="jw-head">
          <span class="jw-label">標頭（Header）</span>
          <button class="btn small" type="button" data-copy="#jw-header">複製</button>
        </div>
        <pre class="output jw-json" id="jw-header"></pre>
      </div>
      <div class="field">
        <div class="jw-head">
          <span class="jw-label">酬載（Payload）</span>
          <button class="btn small" type="button" data-copy="#jw-payload">複製</button>
        </div>
        <pre class="output jw-json" id="jw-payload"></pre>
      </div>
    </div>

    <div class="field" id="jw-claims-wrap">
      <span class="label">標準欄位</span>
      <div class="table-wrap">
        <table class="table jw-claims">
          <thead><tr><th>欄位</th><th>說明</th><th>值</th></tr></thead>
          <tbody id="jw-claims"></tbody>
        </table>
      </div>
    </div>

    <div class="field">
      <span class="label">簽章（Signature）</span>
      <div class="output" id="jw-sig"></div>
      <span class="hint" id="jw-alg"></span>
    </div>
  </div>
</div>

<script>
  import { $ } from '../../lib/client';
  import {
    CLAIM_LABELS,
    TIME_CLAIMS,
    decodeJwt,
    encodeSegment,
    formatDuration,
    timeClaimValue,
    tokenStatus,
  } from './logic';

  const root = $('[data-tool="jwt-decoder"]');
  const input = $<HTMLTextAreaElement>('#jw-input', root);
  const error = $('#jw-error', root);
  const result = $('#jw-result', root);
  const status = $('#jw-status', root);
  const claimsWrap = $('#jw-claims-wrap', root);
  const claimsBody = $('#jw-claims', root);
  const dateFmt = new Intl.DateTimeFormat('zh-TW', { dateStyle: 'medium', timeStyle: 'medium' });
  const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;

  let payload: unknown = null;

  const formatSeconds = (s: number) => dateFmt.format(new Date(s * 1000));

  function renderStatus() {
    if (result.hidden) return;
    const st = tokenStatus(payload, Date.now());
    const exp = timeClaimValue(payload, 'exp');
    const nbf = timeClaimValue(payload, 'nbf');
    const map = {
      valid: ['ok', `尚未過期：將在 ${formatDuration(st.delta ?? 0)}後到期（${exp ? formatSeconds(exp) : ''}）`],
      expired: ['error', `已過期：在 ${formatDuration(st.delta ?? 0)}前到期（${exp ? formatSeconds(exp) : ''}）`],
      'not-yet-valid': ['error', `尚未生效：${formatDuration(st.delta ?? 0)}後才開始生效（${nbf ? formatSeconds(nbf) : ''}）`],
      'no-expiry': ['', '這個 JWT 沒有設定 exp 到期時間。'],
    } as const;
    const [kind, text] = map[st.state];
    status.className = kind ? `notice ${kind}` : 'notice';
    status.textContent = text;
  }

  function claimRow(key: string, value: unknown): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const seconds = (TIME_CLAIMS as readonly string[]).includes(key) ? timeClaimValue(payload, key) : undefined;
    const display =
      seconds !== undefined
        ? `${seconds}（${formatSeconds(seconds)}）`
        : Array.isArray(value)
          ? value.join(', ')
          : typeof value === 'string'
            ? value
            : JSON.stringify(value);
    for (const text of [key, CLAIM_LABELS[key], display]) {
      const td = document.createElement('td');
      td.textContent = text;
      tr.append(td);
    }
    return tr;
  }

  function render() {
    error.hidden = true;
    result.hidden = true;
    if (input.value.trim() === '') return;
    const decoded = decodeJwt(input.value);
    if (!decoded.ok) {
      error.textContent = decoded.error;
      error.hidden = false;
      return;
    }
    const jwt = decoded.jwt;
    payload = jwt.payload;
    $('#jw-header', root).textContent = jwt.headerJson;
    $('#jw-payload', root).textContent = jwt.payloadJson;
    $('#jw-sig', root).textContent = jwt.signature || '（空白，未簽章）';

    const alg = typeof jwt.header.alg === 'string' ? jwt.header.alg : '';
    $('#jw-alg', root).textContent =
      alg.toLowerCase() === 'none'
        ? '演算法為 none：這個 JWT 沒有簽章，伺服器不應接受。'
        : alg
          ? `演算法：${alg}。簽章以 Base64URL 表示，需要對應的金鑰才能驗證。`
          : '標頭沒有 alg 欄位。';

    const rows =
      jwt.payloadIsJson && payload && typeof payload === 'object'
        ? Object.keys(CLAIM_LABELS)
            .filter((k) => k in (payload as object))
            .map((k) => claimRow(k, (payload as Record<string, unknown>)[k]))
        : [];
    claimsBody.replaceChildren(...rows);
    claimsWrap.hidden = rows.length === 0;
    result.hidden = false;
    renderStatus();
  }

  function sampleToken(): string {
    const now = Math.floor(Date.now() / 1000);
    const header = encodeSegment({ alg: 'HS256', typ: 'JWT' });
    const body = encodeSegment({ sub: '1234567890', name: '王小明', role: 'editor', iss: 'https://auth.example.com', iat: now, exp: now + 3600 });
    return `${header}.${body}.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk`;
  }

  input.addEventListener('input', render);
  $('#jw-sample', root).addEventListener('click', () => {
    input.value = sampleToken();
    render();
  });
  $('#jw-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  window.setInterval(() => {
    if (!document.hidden) renderStatus();
  }, 1000);
  render();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .jw-note {
    margin: 0;
  }
  .jw-result {
    display: grid;
    gap: 16px;
  }
  .jw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .jw-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .jw-json {
    margin: 0;
    max-height: 360px;
    overflow: auto;
  }
  .jw-claims :global(td:last-child) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
