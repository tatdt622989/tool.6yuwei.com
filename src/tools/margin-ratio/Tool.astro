<div class="tool" data-tool="margin-ratio">
  <div class="grid-2">
    <div class="field">
      <label for="mr-buy">融資買進價（元／股）</label>
      <input id="mr-buy" type="text" inputmode="decimal" autocomplete="off" value="100" />
    </div>
    <div class="field">
      <label for="mr-now">目前股價（元）</label>
      <input id="mr-now" type="text" inputmode="decimal" autocomplete="off" value="90" />
    </div>
  </div>

  <div class="grid-2">
    <div class="field">
      <div class="row between">
        <label for="mr-qty">融資數量</label>
        <div class="seg" role="radiogroup" aria-label="數量單位">
          <label><input type="radio" name="mr-unit" value="lot" checked /><span>張</span></label>
          <label><input type="radio" name="mr-unit" value="share" /><span>股</span></label>
        </div>
      </div>
      <input id="mr-qty" type="text" inputmode="decimal" autocomplete="off" value="1" />
    </div>
    <div class="field">
      <label for="mr-ratio">融資成數（%）</label>
      <input id="mr-ratio" type="text" inputmode="decimal" autocomplete="off" value="60" />
      <span class="hint">上市、上櫃皆為 60%；處置股可能調降。</span>
    </div>
  </div>

  <div class="grid-3">
    <div class="field">
      <label for="mr-rate">融資年利率（%）</label>
      <input id="mr-rate" type="text" inputmode="decimal" autocomplete="off" value="6.45" />
    </div>
    <div class="field">
      <label for="mr-days">已持有天數</label>
      <input id="mr-days" type="text" inputmode="numeric" autocomplete="off" value="30" />
    </div>
    <div class="field">
      <label for="mr-discount">手續費折數</label>
      <input id="mr-discount" type="text" inputmode="decimal" autocomplete="off" value="6" />
    </div>
  </div>

  <label class="check"><input type="checkbox" id="mr-short-on" /><span>加入融券部位（計算融券與整戶維持率）</span></label>

  <div id="mr-short-fields" class="mr-short" hidden>
    <div class="grid-2">
      <div class="field">
        <label for="mr-s-sell">融券賣出價（元／股）</label>
        <input id="mr-s-sell" type="text" inputmode="decimal" autocomplete="off" value="100" />
      </div>
      <div class="field">
        <label for="mr-s-now">融券標的目前股價（元）</label>
        <input id="mr-s-now" type="text" inputmode="decimal" autocomplete="off" value="105" />
      </div>
    </div>
    <div class="grid-3">
      <div class="field">
        <label for="mr-s-qty">融券張數</label>
        <input id="mr-s-qty" type="text" inputmode="decimal" autocomplete="off" value="1" />
      </div>
      <div class="field">
        <label for="mr-s-margin">保證金成數（%）</label>
        <input id="mr-s-margin" type="text" inputmode="decimal" autocomplete="off" value="90" />
      </div>
      <div class="field">
        <label for="mr-s-borrow">融券手續費（%）</label>
        <input id="mr-s-borrow" type="text" inputmode="decimal" autocomplete="off" value="0.08" />
      </div>
    </div>
  </div>

  <div class="notice error" id="mr-error" hidden></div>

  <div id="mr-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="mr-ratio-out">—</div>
      <div class="result-label" id="mr-ratio-label">融資維持率</div>
    </div>

    <p class="notice" id="mr-status"></p>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="mr-call">—</span><span class="stat-label" id="mr-call-label">追繳價（130%）</span></div>
      <div class="stat"><span class="stat-value" id="mr-loan">—</span><span class="stat-label">融資金額</span></div>
      <div class="stat"><span class="stat-value" id="mr-own">—</span><span class="stat-label">自備款（含手續費）</span></div>
      <div class="stat"><span class="stat-value" id="mr-mv">—</span><span class="stat-label">目前市值</span></div>
      <div class="stat"><span class="stat-value" id="mr-interest">—</span><span class="stat-label">融資利息</span></div>
      <div class="stat"><span class="stat-value" id="mr-pnl">—</span><span class="stat-label" id="mr-pnl-label">現價賣出損益</span></div>
    </div>

    <div class="field">
      <span class="label">融資維持率與股價對照</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>維持率</th><th class="num">對應股價</th><th class="num">較目前股價</th><th>說明</th></tr>
          </thead>
          <tbody id="mr-ladder"></tbody>
        </table>
      </div>
    </div>

    <div id="mr-short-output" class="mr-short" hidden>
      <div class="stats">
        <div class="stat"><span class="stat-value" id="mr-s-ratio">—</span><span class="stat-label">融券維持率</span></div>
        <div class="stat"><span class="stat-value" id="mr-s-call">—</span><span class="stat-label" id="mr-s-call-label">融券追繳價（130%）</span></div>
        <div class="stat"><span class="stat-value" id="mr-s-deposit">—</span><span class="stat-label">融券保證金</span></div>
        <div class="stat"><span class="stat-value" id="mr-s-collateral">—</span><span class="stat-label">融券擔保品</span></div>
        <div class="stat"><span class="stat-value" id="mr-s-pnl">—</span><span class="stat-label">現價回補損益</span></div>
        <div class="stat"><span class="stat-value" id="mr-account">—</span><span class="stat-label">整戶擔保維持率</span></div>
      </div>
      <div class="field">
        <span class="label">融券維持率與股價對照</span>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>維持率</th><th class="num">對應股價</th><th class="num">較目前股價</th><th>說明</th></tr>
            </thead>
            <tbody id="mr-s-ladder"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <p class="hint">融資金額＝價金 × 融資成數（未滿千元不予融資）；維持率＝現值 ÷ 融資金額；融券維持率＝（擔保品＋保證金）÷ 現值；整戶維持率把所有融資融券部位合併計算，是券商追繳的依據。現價賣出損益已扣買賣手續費（最低 20 元）、證交稅 0.3% 與利息。結果為估算，實際以券商系統為準，不構成投資建議；資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { parseDiscount } from '../stock-fee-calculator/logic';
  import {
    accountMaintenance,
    calculateMargin,
    calculateShort,
    marginLadder,
    shortLadder,
    validateMargin,
    validateShort,
    type LadderRow,
    type MarginInput,
    type ShortInput,
  } from './logic';

  const KEY = 'margin-ratio';
  const MIN_FEE = 20;
  const root = $('[data-tool="margin-ratio"]');
  const ids = ['buy', 'now', 'qty', 'ratio', 'rate', 'days', 'discount', 's-sell', 's-now', 's-qty', 's-margin', 's-borrow'] as const;
  type Id = (typeof ids)[number];
  const inputs = Object.fromEntries(ids.map((id) => [id, $<HTMLInputElement>(`#mr-${id}`, root)])) as Record<Id, HTMLInputElement>;
  const units = $$<HTMLInputElement>('input[name="mr-unit"]', root);
  const shortOn = $<HTMLInputElement>('#mr-short-on', root);
  const error = $('#mr-error', root);
  const output = $('#mr-output', root);
  const status = $('#mr-status', root);

  const prefs = loadPref<Partial<Record<Id | 'unit', string>> & { shortOn?: boolean }>(KEY, {});
  for (const id of ids) if (prefs[id] !== undefined) inputs[id].value = prefs[id]!;
  if (prefs.unit) for (const u of units) u.checked = u.value === prefs.unit;
  shortOn.checked = prefs.shortOn ?? false;

  const money = (n: number) => `${formatInteger(n)} 元`;
  const signed = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${formatInteger(Math.abs(n))} 元`;
  const pct = (n: number) => `${formatNumber(n, 1)}%`;
  const price = (n: number) => `${formatNumber(n, 2)} 元`;
  const num = (id: Id, fallback = 0) => (inputs[id].value.trim() === '' ? fallback : parseNumber(inputs[id].value));
  const set = (sel: string, text: string) => {
    $(sel, root).textContent = text;
  };
  const signOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : '');

  function levelNote(level: number): string {
    if (level === 166) return '剛融資買進約此水準；追繳後回升至此取消紀錄';
    if (level === 130) return '跌破即追繳，2 個營業日內補繳';
    if (level < 130) return '低於追繳線';
    return '';
  }

  function fillLadder(tbody: HTMLElement, rows: LadderRow[]) {
    tbody.replaceChildren(
      ...rows.map((row) => {
        const tr = document.createElement('tr');
        if (row.levelPct === 130) tr.className = 'mr-call-row';
        const cells = [`${row.levelPct}%`, formatNumber(row.price, 2), `${row.changePct > 0 ? '+' : ''}${formatNumber(row.changePct, 1)}%`, levelNote(row.levelPct)];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          td.textContent = text;
          if (i === 1 || i === 2) td.className = 'num';
          tr.append(td);
        });
        return tr;
      }),
    );
  }

  function fail(message: string) {
    error.textContent = message;
    error.hidden = false;
    output.hidden = true;
  }

  function render() {
    const unit = units.find((u) => u.checked)?.value ?? 'lot';
    savePref(KEY, { ...Object.fromEntries(ids.map((id) => [id, inputs[id].value])), unit, shortOn: shortOn.checked });
    const wantShort = shortOn.checked;
    for (const el of $$('.mr-short', root)) el.hidden = !wantShort;

    const qty = parseNumber(inputs.qty.value);
    const discount = parseDiscount(inputs.discount.value.trim() === '' ? 10 : parseNumber(inputs.discount.value));
    const m: MarginInput = {
      buyPrice: parseNumber(inputs.buy.value),
      shares: unit === 'lot' ? Math.round(qty * 1000 * 1000) / 1000 : qty,
      loanRatioPct: parseNumber(inputs.ratio.value),
      currentPrice: parseNumber(inputs.now.value),
      interestRatePct: num('rate'),
      days: num('days'),
      discount,
      minFee: MIN_FEE,
    };
    const mProblem = validateMargin(m);
    if (mProblem) return fail(mProblem);

    let s: ShortInput | null = null;
    if (wantShort) {
      s = {
        sellPrice: parseNumber(inputs['s-sell'].value),
        shares: Math.round(parseNumber(inputs['s-qty'].value) * 1000 * 1000) / 1000,
        marginPct: parseNumber(inputs['s-margin'].value),
        currentPrice: parseNumber(inputs['s-now'].value),
        borrowFeePct: num('s-borrow'),
        discount,
        minFee: MIN_FEE,
      };
      const sProblem = validateShort(s);
      if (sProblem) return fail(sProblem);
    }
    error.hidden = true;
    output.hidden = false;

    const r = calculateMargin(m);
    set('#mr-ratio-out', pct(r.maintenancePct));
    $('#mr-ratio-out', root).dataset.status = r.status;
    set('#mr-ratio-label', `融資維持率（目前股價 ${price(m.currentPrice)}）`);
    set('#mr-call', price(r.callPrice));
    set('#mr-call-label', r.dropToCallPct < 0 ? `追繳價（130%），再跌 ${formatNumber(-r.dropToCallPct, 1)}%` : '追繳價（130%），已跌破');
    set('#mr-loan', money(r.loan));
    set('#mr-own', money(r.ownFunds));
    set('#mr-mv', money(r.marketValue));
    set('#mr-interest', money(r.interest));
    set('#mr-pnl', signed(r.netProfit));
    $('#mr-pnl', root).dataset.sign = signOf(r.netProfit);
    set('#mr-pnl-label', `現價賣出損益（自備款報酬 ${r.returnOnOwnPct > 0 ? '+' : ''}${formatNumber(r.returnOnOwnPct, 1)}%）`);
    fillLadder($('#mr-ladder', root), marginLadder(r.loan, m.shares, m.currentPrice));

    let sr = null;
    if (s) {
      sr = calculateShort(s);
      set('#mr-s-ratio', pct(sr.maintenancePct));
      $('#mr-s-ratio', root).dataset.status = sr.status;
      set('#mr-s-call', price(sr.callPrice));
      set('#mr-s-call-label', sr.riseToCallPct > 0 ? `融券追繳價（130%），再漲 ${formatNumber(sr.riseToCallPct, 1)}%` : '融券追繳價（130%），已突破');
      set('#mr-s-deposit', money(sr.deposit));
      set('#mr-s-collateral', money(sr.collateral));
      set('#mr-s-pnl', signed(sr.netProfit));
      $('#mr-s-pnl', root).dataset.sign = signOf(sr.netProfit);
      fillLadder($('#mr-s-ladder', root), shortLadder(sr.collateral + sr.deposit, s.shares, s.currentPrice));
    }

    const account = accountMaintenance(r, sr);
    set('#mr-account', pct(account));
    const basis = sr ? `整戶擔保維持率 ${pct(account)}` : `維持率 ${pct(r.maintenancePct)}`;
    const level = sr ? account : r.maintenancePct;
    status.dataset.status = level < 130 ? 'call' : level < 166 ? 'warning' : 'safe';
    status.textContent =
      level < 130
        ? `${basis}，已低於 130%：券商會發出追繳通知，須在通知送達之日起 2 個營業日內補繳；期滿仍不足，自次一營業日起處分（斷頭）。`
        : level < 140
          ? `${basis}，逼近 130% 追繳線，建議準備補繳資金或評估減碼。`
          : level < 166
            ? `${basis}，高於 130% 追繳線。若曾被追繳，需回升到 166% 以上才會取消追繳紀錄。`
            : `${basis}，高於 166%，目前沒有追繳風險。`;
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #mr-output,
  #mr-short-output,
  #mr-short-fields {
    display: grid;
    gap: 16px;
  }
  #mr-output[hidden],
  .mr-short[hidden] {
    display: none;
  }
  .row > label[for] {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  [data-status='warning'] {
    color: var(--warning);
  }
  [data-status='call'] {
    color: var(--danger);
  }
  .notice[data-status='warning'] {
    background: color-mix(in oklab, var(--warning) 10%, transparent);
  }
  .notice[data-status='call'] {
    background: color-mix(in oklab, var(--danger) 10%, transparent);
  }
  [data-sign='up'] {
    color: var(--danger);
  }
  [data-sign='down'] {
    color: var(--success);
  }
  .mr-call-row td {
    background: var(--accent-soft);
    font-weight: 600;
  }
  #mr-output .table td:last-child {
    white-space: normal;
    min-width: 160px;
    color: var(--text-2);
  }
</style>
