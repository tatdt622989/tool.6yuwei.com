<div class="tool" data-tool="fullwidth-halfwidth">
  <div class="row fw-top">
    <div class="field">
      <span class="label">轉換方向</span>
      <div class="seg" role="radiogroup" aria-label="轉換方向">
        <label><input type="radio" name="fw-dir" value="toHalf" checked /><span>全形 → 半形</span></label>
        <label><input type="radio" name="fw-dir" value="toFull" /><span>半形 → 全形</span></label>
      </div>
    </div>
    <div class="field">
      <label for="fw-punct">標點轉換</label>
      <select id="fw-punct">
        <option value="none">不轉換</option>
        <option value="zhToEn">中文標點 → 英文標點</option>
        <option value="enToZh">英文標點 → 中文標點</option>
      </select>
    </div>
  </div>

  <fieldset class="fw-classes">
    <legend class="label">轉換範圍</legend>
    <label class="check"><input type="checkbox" name="letters" checked /> 英文字母</label>
    <label class="check"><input type="checkbox" name="digits" checked /> 數字</label>
    <label class="check"><input type="checkbox" name="symbols" /> 符號（，！？（）等）</label>
    <label class="check"><input type="checkbox" name="space" /> 空白</label>
  </fieldset>
  <p class="hint fw-hint" id="fw-hint"></p>

  <div class="grid-2">
    <div class="field">
      <label for="fw-input">原始文字</label>
      <textarea id="fw-input" rows="9" placeholder="例如：ＡＢＣ１２３　或　iPhone 15, 128GB"></textarea>
    </div>
    <div class="field">
      <label for="fw-output">轉換結果</label>
      <textarea id="fw-output" rows="9" readonly placeholder="結果會即時顯示在這裡"></textarea>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="fw-s-alnum">0</span><span class="stat-label">原文全形英數</span></div>
    <div class="stat"><span class="stat-value" id="fw-s-symbols">0</span><span class="stat-label">原文全形符號</span></div>
    <div class="stat"><span class="stat-value" id="fw-s-spaces">0</span><span class="stat-label">原文全形空白</span></div>
    <div class="stat"><span class="stat-value" id="fw-s-changed">0</span><span class="stat-label">已轉換字元</span></div>
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#fw-output">複製結果</button>
    <button class="btn" type="button" id="fw-apply">以結果取代原文</button>
    <button class="btn ghost" type="button" id="fw-clear">清除</button>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { convertWidth, widthStats, type ConvertOptions, type Direction, type PunctuationMode, type WidthClasses } from './logic';

  const root = $('[data-tool="fullwidth-halfwidth"]');
  const input = $<HTMLTextAreaElement>('#fw-input', root);
  const output = $<HTMLTextAreaElement>('#fw-output', root);
  const punct = $<HTMLSelectElement>('#fw-punct', root);
  const hint = $('#fw-hint', root);
  const dirRadios = $$<HTMLInputElement>('input[name="fw-dir"]', root);
  const boxes = $$<HTMLInputElement>('.fw-classes input', root);

  const defaults: ConvertOptions = {
    direction: 'toHalf',
    classes: { letters: true, digits: true, symbols: false, space: false },
    punctuation: 'none',
  };

  const HINTS: Record<PunctuationMode, string> = {
    none: '中文內容通常保留全形標點；只想把全形英數字改成半形時，維持預設即可。',
    zhToEn: '會把，。、「」（）等中文標點換成英文標點，並在英文字前補上空格。',
    enToZh: '只轉換緊鄰中文字的英文標點，英文句子、數字（3.14、12:30）與網址不受影響。',
  };

  function readOptions(): ConvertOptions {
    const direction = (dirRadios.find((r) => r.checked)?.value ?? 'toHalf') as Direction;
    const classes = { ...defaults.classes };
    for (const box of boxes) classes[box.name as keyof WidthClasses] = box.checked;
    const value = punct.value as PunctuationMode;
    return { direction, classes, punctuation: value in HINTS ? value : 'none' };
  }

  function applyOptions(opts: ConvertOptions) {
    for (const r of dirRadios) r.checked = r.value === (opts.direction === 'toFull' ? 'toFull' : 'toHalf');
    for (const box of boxes) box.checked = Boolean(opts.classes?.[box.name as keyof WidthClasses]);
    punct.value = opts.punctuation in HINTS ? opts.punctuation : 'none';
  }

  function render() {
    const opts = readOptions();
    savePref('fullwidth-halfwidth', opts);
    hint.textContent = HINTS[opts.punctuation];
    const result = convertWidth(input.value, opts);
    output.value = result.text;
    const stats = widthStats(input.value);
    $('#fw-s-alnum', root).textContent = formatInteger(stats.fullAlnum);
    $('#fw-s-symbols', root).textContent = formatInteger(stats.fullSymbols);
    $('#fw-s-spaces', root).textContent = formatInteger(stats.fullSpaces);
    $('#fw-s-changed', root).textContent = formatInteger(result.changed);
  }

  applyOptions(loadPref('fullwidth-halfwidth', defaults));
  input.addEventListener('input', render);
  for (const el of [...dirRadios, ...boxes, punct]) el.addEventListener('change', render);
  $('#fw-apply', root).addEventListener('click', () => {
    input.value = output.value;
    render();
  });
  $('#fw-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  .fw-top {
    align-items: flex-end;
    gap: 14px 24px;
  }
  .fw-top select {
    width: auto;
    max-width: 100%;
  }
  .fw-classes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .fw-classes legend {
    width: 100%;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .fw-hint {
    margin: -8px 0 0;
  }
</style>
