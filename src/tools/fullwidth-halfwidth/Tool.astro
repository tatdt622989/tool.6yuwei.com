---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="fullwidth-halfwidth" {...i18nAttrs(locale, s.client)}>
  <div class="row fw-top">
    <div class="field">
      <span class="label">{s.dirLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.dirLabel}>
        <label><input type="radio" name="fw-dir" value="toHalf" checked /><span>{s.toHalf}</span></label>
        <label><input type="radio" name="fw-dir" value="toFull" /><span>{s.toFull}</span></label>
      </div>
    </div>
    <div class="field">
      <label for="fw-punct">{s.punctLabel}</label>
      <select id="fw-punct">
        {s.punctOptions.map((o) => (
          <Fragment>{' '}<option value={o.value}>{o.label}</option></Fragment>
        ))}
      </select>
    </div>
  </div>

  <fieldset class="fw-classes">
    <legend class="label">{s.classesLegend}</legend>
    <label class="check"><input type="checkbox" name="letters" checked /> {s.letters}</label>
    <label class="check"><input type="checkbox" name="digits" checked /> {s.digits}</label>
    <label class="check"><input type="checkbox" name="symbols" /> {s.symbols}</label>
    <label class="check"><input type="checkbox" name="space" /> {s.space}</label>{
      s.kana && (
        <Fragment>{' '}<label class="check"><input type="checkbox" name="kana" /> {s.kana}</label></Fragment>
      )
    }
  </fieldset>
  <p class="hint fw-hint" id="fw-hint"></p>

  <div class="grid-2">
    <div class="field">
      <label for="fw-input">{s.inputLabel}</label>
      <textarea id="fw-input" rows="9" placeholder={s.placeholder}></textarea>
    </div>
    <div class="field">
      <label for="fw-output">{s.outputLabel}</label>
      <textarea id="fw-output" rows="9" readonly placeholder={s.outputPlaceholder}></textarea>
    </div>
  </div>

  <div class="stats">
    {
      s.stats.map((st) => (
        <Fragment>{' '}<div class="stat"><span class="stat-value" id={`fw-s-${st.key}`}>0</span><span class="stat-label">{st.label}</span></div></Fragment>
      ))
    }
  </div>

  <div class="row">
    <button class="btn primary" type="button" data-copy="#fw-output">{s.copy}</button>
    <button class="btn" type="button" id="fw-apply">{s.apply}</button>
    <button class="btn ghost" type="button" id="fw-clear">{s.clear}</button>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { convertWidth, kanaStats, widthStats, type ConvertOptions, type Direction, type PunctuationMode, type WidthClasses } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="fullwidth-halfwidth"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#fw-input', root);
  const output = $<HTMLTextAreaElement>('#fw-output', root);
  const punct = $<HTMLSelectElement>('#fw-punct', root);
  const hint = $('#fw-hint', root);
  const dirRadios = $$<HTMLInputElement>('input[name="fw-dir"]', root);
  const boxes = $$<HTMLInputElement>('.fw-classes input', root);

  const defaults: ConvertOptions = {
    direction: 'toHalf',
    classes: { letters: true, digits: true, symbols: false, space: false },
    punctuation: 'none',
  };

  // Only the modes this page offers (Japanese has no "English → Chinese punctuation").
  const HINTS = s.hints;

  function readOptions(): ConvertOptions {
    const direction = (dirRadios.find((r) => r.checked)?.value ?? 'toHalf') as Direction;
    const classes = { ...defaults.classes };
    for (const box of boxes) classes[box.name as keyof WidthClasses] = box.checked;
    const value = punct.value as PunctuationMode;
    return { direction, classes, punctuation: value in HINTS ? value : 'none' };
  }

  function applyOptions(opts: ConvertOptions) {
    for (const r of dirRadios) r.checked = r.value === (opts.direction === 'toFull' ? 'toFull' : 'toHalf');
    for (const box of boxes) box.checked = Boolean(opts.classes?.[box.name as keyof WidthClasses]);
    punct.value = opts.punctuation in HINTS ? opts.punctuation : 'none';
  }

  function render() {
    const opts = readOptions();
    savePref('fullwidth-halfwidth', opts);
    hint.textContent = HINTS[opts.punctuation] ?? '';
    const result = convertWidth(input.value, opts);
    output.value = result.text;
    const stats = widthStats(input.value);
    const values: Record<string, number> = {
      alnum: stats.fullAlnum,
      symbols: stats.fullSymbols,
      spaces: stats.fullSpaces,
      kana: kanaStats(input.value).halfKana,
      changed: result.changed,
    };
    for (const [key, value] of Object.entries(values)) {
      const cell = root.querySelector(`#fw-s-${key}`);
      if (cell) cell.textContent = formatInteger(value, locale);
    }
  }

  applyOptions(loadPref('fullwidth-halfwidth', defaults));
  input.addEventListener('input', render);
  for (const el of [...dirRadios, ...boxes, punct]) el.addEventListener('change', render);
  $('#fw-apply', root).addEventListener('click', () => {
    input.value = output.value;
    render();
  });
  $('#fw-clear', root).addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });
  render();
</script>

<style>
  .fw-top {
    align-items: flex-end;
    gap: 14px 24px;
  }
  .fw-top select {
    width: auto;
    max-width: 100%;
  }
  .fw-classes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .fw-classes legend {
    width: 100%;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .fw-hint {
    margin: -8px 0 0;
  }
</style>
