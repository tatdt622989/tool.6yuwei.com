---
import { t } from '../../i18n/format';
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const fields = [
  { base: 2, id: 'nb-2', label: s.fieldLabels[0], prefix: '0b' },
  { base: 8, id: 'nb-8', label: s.fieldLabels[1], prefix: '0o' },
  { base: 10, id: 'nb-10', label: s.fieldLabels[2], prefix: '' },
  { base: 16, id: 'nb-16', label: s.fieldLabels[3], prefix: '0x' },
];
const customBases = Array.from({ length: 35 }, (_, i) => i + 2);
---

<div class="tool" data-tool="number-base-converter" {...i18nAttrs(locale, s.client)}>
  <p class="hint">{s.hint}</p>

  <div class="nb-fields">
    {
      fields.map((f) => (
        <div class="field">
          <label for={f.id}>{f.label}</label>
          <div class="nb-line">
            <input
              id={f.id}
              class="mono nb-input"
              type="text"
              inputmode={f.base === 10 || f.base === 2 || f.base === 8 ? 'numeric' : 'text'}
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              data-base={f.base}
            />
            <button class="btn small" type="button" data-copy={`#${f.id}`}>{`\n${s.copy}\n`}</button>
          </div>
        </div>
      ))
    }
    <div class="field">
      <div class="nb-custom-head">
        <label for="nb-custom">{s.customLabel}</label>
        <select id="nb-custom-base" class="nb-base-select" aria-label={s.customAria}>
          {customBases.map((b) => <option value={b} selected={b === 36}>{t(s.customOption, { b })}</option>)}
        </select>
      </div>
      <div class="nb-line">
        <input id="nb-custom" class="mono nb-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" />
        <button class="btn small" type="button" data-copy="#nb-custom">{s.copy}</button>
      </div>
    </div>
  </div>

  <div class="notice error" id="nb-error" hidden></div>

  <div class="row">
    <label class="check"><input type="checkbox" id="nb-group" checked /> {s.group}</label>
    <label class="check"><input type="checkbox" id="nb-upper" checked /> {s.upper}</label>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="nb-bits">—</span><span class="stat-label">{s.statBits}</span></div>
    <div class="stat"><span class="stat-value" id="nb-bytes">—</span><span class="stat-label">{s.statBytes}</span></div>
    <div class="stat"><span class="stat-value" id="nb-ones">—</span><span class="stat-label">{s.statOnes}</span></div>
  </div>

  <section class="field nb-twos" aria-labelledby="nb-twos-title">
    <div class="row between">
      <span class="label" id="nb-twos-title" set:html={s.twosTitle} />
      <div class="seg" role="radiogroup" aria-label={s.widthAria}>
        <label><input type="radio" name="nb-bits" value="8" checked /><span>{t(s.widthOption, { n: 8 })}</span></label>
        <label><input type="radio" name="nb-bits" value="16" /><span>{t(s.widthOption, { n: 16 })}</span></label>
        <label><input type="radio" name="nb-bits" value="32" /><span>{t(s.widthOption, { n: 32 })}</span></label>
        <label><input type="radio" name="nb-bits" value="64" /><span>{t(s.widthOption, { n: 64 })}</span></label>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <tbody>
          <tr><th scope="row">{s.rowBinary}</th><td class="mono nb-wrap" id="nb-tc-bin">—</td></tr>
          <tr><th scope="row">{s.rowHex}</th><td class="mono" id="nb-tc-hex">—</td></tr>
          <tr><th scope="row">{s.rowUnsigned}</th><td class="mono" id="nb-tc-u">—</td></tr>
          <tr><th scope="row">{s.rowSigned}</th><td class="mono" id="nb-tc-s">—</td></tr>
        </tbody>
      </table>
    </div>
    <p class="hint" id="nb-tc-note"></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { t as fill } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { bitLength, formatInBase, groupDigits, parseInBase, popCount, twosComplement, type BitWidth } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="number-base-converter"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const inputs = $$<HTMLInputElement>('.nb-input', root);
  const custom = $<HTMLInputElement>('#nb-custom', root);
  const customBase = $<HTMLSelectElement>('#nb-custom-base', root);
  const group = $<HTMLInputElement>('#nb-group', root);
  const upper = $<HTMLInputElement>('#nb-upper', root);
  const error = $('#nb-error', root);
  const bitInputs = $$<HTMLInputElement>('input[name="nb-bits"]', root);

  const prefs = loadPref('number-base-converter', { value: '255', group: true, upper: true, bits: 8, customBase: 36 });
  let value: bigint | null = null;

  const baseOf = (input: HTMLInputElement) => (input === custom ? Number(customBase.value) : Number(input.dataset.base));
  const bits = (): BitWidth => Number(bitInputs.find((i) => i.checked)?.value ?? 8) as BitWidth;
  const opts = () => ({ group: group.checked, upper: upper.checked });

  function persist() {
    savePref('number-base-converter', {
      value: value === null ? '' : value.toString(),
      group: group.checked,
      upper: upper.checked,
      bits: bits(),
      customBase: Number(customBase.value),
    });
  }

  function renderFields(except?: HTMLInputElement) {
    for (const input of inputs) {
      if (input === except) continue;
      input.value = value === null ? '' : formatInBase(value, baseOf(input), opts());
      input.removeAttribute('aria-invalid');
    }
  }

  function renderDetails() {
    const set = (id: string, text: string) => ($(id, root).textContent = text);
    if (value === null) {
      for (const id of ['#nb-bits', '#nb-bytes', '#nb-ones', '#nb-tc-bin', '#nb-tc-hex', '#nb-tc-u', '#nb-tc-s']) set(id, '—');
      set('#nb-tc-note', '');
      return;
    }
    const len = bitLength(value);
    set('#nb-bits', `${formatInteger(len, locale)}${value < 0n ? s.noSign : ''}`);
    set('#nb-bytes', formatInteger(Math.ceil(len / 8), locale));
    set('#nb-ones', formatInteger(popCount(value), locale));

    const t = twosComplement(value, bits());
    set('#nb-tc-bin', group.checked ? groupDigits(t.binary, 4) : t.binary);
    set('#nb-tc-hex', group.checked ? groupDigits(t.hex, 4) : t.hex);
    set('#nb-tc-u', groupDigits(t.unsigned.toString(), 3, ','));
    set('#nb-tc-s', groupDigits(t.signed.toString(), 3, ','));
    const n = t.bits;
    const min = groupDigits((-(1n << BigInt(n - 1))).toString(), 3, ',');
    const max = groupDigits(((1n << BigInt(n)) - 1n).toString(), 3, ',');
    set(
      '#nb-tc-note',
      t.fits
        ? value < 0n
          ? fill(s.negative, { n: groupDigits((-value).toString(), 3, ',') })
          : t.signed !== t.unsigned
            ? fill(s.highBit, { n: groupDigits(t.signed.toString(), 3, ',') })
            : fill(s.range, { bits: n, min, smax: groupDigits(((1n << BigInt(n - 1)) - 1n).toString(), 3, ','), max })
        : fill(s.overflow, { bits: n, min, max }),
    );
  }

  function onInput(input: HTMLInputElement) {
    if (input.value.trim() === '') {
      value = null;
      error.hidden = true;
      renderFields(input);
      renderDetails();
      persist();
      return;
    }
    const r = parseInBase(input.value, baseOf(input), s.messages);
    if (!r.ok) {
      error.textContent = r.error;
      error.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      return;
    }
    error.hidden = true;
    input.removeAttribute('aria-invalid');
    value = r.value;
    renderFields(input);
    renderDetails();
    persist();
  }

  for (const input of inputs) {
    input.addEventListener('input', () => onInput(input));
    // Reformat the edited field once the user leaves it, so the caret never jumps while typing.
    input.addEventListener('blur', () => {
      if (!input.hasAttribute('aria-invalid')) renderFields();
    });
  }
  customBase.addEventListener('change', () => {
    renderFields();
    persist();
  });
  [group, upper].forEach((box) =>
    box.addEventListener('change', () => {
      renderFields();
      renderDetails();
      persist();
    }),
  );
  bitInputs.forEach((i) =>
    i.addEventListener('change', () => {
      renderDetails();
      persist();
    }),
  );

  group.checked = prefs.group;
  upper.checked = prefs.upper;
  customBase.value = String(prefs.customBase);
  for (const i of bitInputs) i.checked = Number(i.value) === prefs.bits;
  const initial = parseInBase(prefs.value || '255', 10);
  value = initial.ok ? initial.value : 255n;
  renderFields();
  renderDetails();
</script>

<style>
  .nb-fields {
    display: grid;
    gap: 14px;
  }
  .nb-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .nb-input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .nb-custom-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .nb-base-select.nb-base-select {
    width: auto;
    padding: 4px 10px;
  }
  .nb-twos .table th {
    width: 1%;
  }
  .nb-wrap {
    white-space: normal !important;
    overflow-wrap: anywhere;
  }
  @media (max-width: 520px) {
    .nb-twos .table th {
      white-space: normal;
    }
  }
</style>
