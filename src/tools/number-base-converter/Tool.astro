---
const fields = [
  { base: 2, id: 'nb-2', label: '二進位（BIN，2 進位）', prefix: '0b' },
  { base: 8, id: 'nb-8', label: '八進位（OCT，8 進位）', prefix: '0o' },
  { base: 10, id: 'nb-10', label: '十進位（DEC，10 進位）', prefix: '' },
  { base: 16, id: 'nb-16', label: '十六進位（HEX，16 進位）', prefix: '0x' },
];
const customBases = Array.from({ length: 35 }, (_, i) => i + 2);
---

<div class="tool" data-tool="number-base-converter">
  <p class="hint">在任一欄輸入整數，其他進位會即時換算。可輸入負號，也可貼上含 0x、0b 前綴或空白分組的數字。</p>

  <div class="nb-fields">
    {
      fields.map((f) => (
        <div class="field">
          <label for={f.id}>{f.label}</label>
          <div class="nb-line">
            <input
              id={f.id}
              class="mono nb-input"
              type="text"
              inputmode={f.base === 10 || f.base === 2 || f.base === 8 ? 'numeric' : 'text'}
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              data-base={f.base}
            />
            <button class="btn small" type="button" data-copy={`#${f.id}`}>
              複製
            </button>
          </div>
        </div>
      ))
    }
    <div class="field">
      <div class="nb-custom-head">
        <label for="nb-custom">自訂進位（2–36 進位）</label>
        <select id="nb-custom-base" class="nb-base-select" aria-label="自訂進位的基數">
          {customBases.map((b) => <option value={b} selected={b === 36}>{b} 進位</option>)}
        </select>
      </div>
      <div class="nb-line">
        <input id="nb-custom" class="mono nb-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" />
        <button class="btn small" type="button" data-copy="#nb-custom">複製</button>
      </div>
    </div>
  </div>

  <div class="notice error" id="nb-error" hidden></div>

  <div class="row">
    <label class="check"><input type="checkbox" id="nb-group" checked /> 分組顯示（二進位、十六進位每 4 位，十進位每 3 位）</label>
    <label class="check"><input type="checkbox" id="nb-upper" checked /> 英文字母大寫（FF／ff）</label>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="nb-bits">—</span><span class="stat-label">需要的位元數</span></div>
    <div class="stat"><span class="stat-value" id="nb-bytes">—</span><span class="stat-label">位元組（byte）</span></div>
    <div class="stat"><span class="stat-value" id="nb-ones">—</span><span class="stat-label">二進位中 1 的個數</span></div>
  </div>

  <section class="field nb-twos" aria-labelledby="nb-twos-title">
    <div class="row between">
      <span class="label" id="nb-twos-title">二補數（Two's complement）表示法</span>
      <div class="seg" role="radiogroup" aria-label="位元寬度">
        <label><input type="radio" name="nb-bits" value="8" checked /><span>8 位元</span></label>
        <label><input type="radio" name="nb-bits" value="16" /><span>16 位元</span></label>
        <label><input type="radio" name="nb-bits" value="32" /><span>32 位元</span></label>
        <label><input type="radio" name="nb-bits" value="64" /><span>64 位元</span></label>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <tbody>
          <tr><th scope="row">二進位位元</th><td class="mono nb-wrap" id="nb-tc-bin">—</td></tr>
          <tr><th scope="row">十六進位</th><td class="mono" id="nb-tc-hex">—</td></tr>
          <tr><th scope="row">視為無號整數（unsigned）</th><td class="mono" id="nb-tc-u">—</td></tr>
          <tr><th scope="row">視為有號整數（signed）</th><td class="mono" id="nb-tc-s">—</td></tr>
        </tbody>
      </table>
    </div>
    <p class="hint" id="nb-tc-note"></p>
  </section>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger } from '../../lib/format';
  import { bitLength, formatInBase, groupDigits, parseInBase, popCount, twosComplement, type BitWidth } from './logic';

  const root = $('[data-tool="number-base-converter"]');
  const inputs = $$<HTMLInputElement>('.nb-input', root);
  const custom = $<HTMLInputElement>('#nb-custom', root);
  const customBase = $<HTMLSelectElement>('#nb-custom-base', root);
  const group = $<HTMLInputElement>('#nb-group', root);
  const upper = $<HTMLInputElement>('#nb-upper', root);
  const error = $('#nb-error', root);
  const bitInputs = $$<HTMLInputElement>('input[name="nb-bits"]', root);

  const prefs = loadPref('number-base-converter', { value: '255', group: true, upper: true, bits: 8, customBase: 36 });
  let value: bigint | null = null;

  const baseOf = (input: HTMLInputElement) => (input === custom ? Number(customBase.value) : Number(input.dataset.base));
  const bits = (): BitWidth => Number(bitInputs.find((i) => i.checked)?.value ?? 8) as BitWidth;
  const opts = () => ({ group: group.checked, upper: upper.checked });

  function persist() {
    savePref('number-base-converter', {
      value: value === null ? '' : value.toString(),
      group: group.checked,
      upper: upper.checked,
      bits: bits(),
      customBase: Number(customBase.value),
    });
  }

  function renderFields(except?: HTMLInputElement) {
    for (const input of inputs) {
      if (input === except) continue;
      input.value = value === null ? '' : formatInBase(value, baseOf(input), opts());
      input.removeAttribute('aria-invalid');
    }
  }

  function renderDetails() {
    const set = (id: string, text: string) => ($(id, root).textContent = text);
    if (value === null) {
      for (const id of ['#nb-bits', '#nb-bytes', '#nb-ones', '#nb-tc-bin', '#nb-tc-hex', '#nb-tc-u', '#nb-tc-s']) set(id, '—');
      set('#nb-tc-note', '');
      return;
    }
    const len = bitLength(value);
    set('#nb-bits', `${formatInteger(len)}${value < 0n ? '（不含符號）' : ''}`);
    set('#nb-bytes', formatInteger(Math.ceil(len / 8)));
    set('#nb-ones', formatInteger(popCount(value)));

    const t = twosComplement(value, bits());
    set('#nb-tc-bin', group.checked ? groupDigits(t.binary, 4) : t.binary);
    set('#nb-tc-hex', group.checked ? groupDigits(t.hex, 4) : t.hex);
    set('#nb-tc-u', groupDigits(t.unsigned.toString(), 3, ','));
    set('#nb-tc-s', groupDigits(t.signed.toString(), 3, ','));
    const n = t.bits;
    const min = groupDigits((-(1n << BigInt(n - 1))).toString(), 3, ',');
    const max = groupDigits(((1n << BigInt(n)) - 1n).toString(), 3, ',');
    set(
      '#nb-tc-note',
      t.fits
        ? value < 0n
          ? `負數以二補數儲存：把 ${groupDigits((-value).toString(), 3, ',')} 的二進位每一位反轉後再加 1。`
          : t.signed !== t.unsigned
            ? `最高位元為 1，當成有號整數讀取時是負數 ${groupDigits(t.signed.toString(), 3, ',')}。`
            : `${n} 位元可表示的範圍：有號 ${min} 到 ${groupDigits(((1n << BigInt(n - 1)) - 1n).toString(), 3, ',')}，無號 0 到 ${max}。`
        : `此數超出 ${n} 位元可表示的範圍（${min} 到 ${max}），上表為只保留低 ${n} 位元後的結果（溢位）。`,
    );
  }

  function onInput(input: HTMLInputElement) {
    if (input.value.trim() === '') {
      value = null;
      error.hidden = true;
      renderFields(input);
      renderDetails();
      persist();
      return;
    }
    const r = parseInBase(input.value, baseOf(input));
    if (!r.ok) {
      error.textContent = r.error;
      error.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      return;
    }
    error.hidden = true;
    input.removeAttribute('aria-invalid');
    value = r.value;
    renderFields(input);
    renderDetails();
    persist();
  }

  for (const input of inputs) {
    input.addEventListener('input', () => onInput(input));
    // Reformat the edited field once the user leaves it, so the caret never jumps while typing.
    input.addEventListener('blur', () => {
      if (!input.hasAttribute('aria-invalid')) renderFields();
    });
  }
  customBase.addEventListener('change', () => {
    renderFields();
    persist();
  });
  [group, upper].forEach((box) =>
    box.addEventListener('change', () => {
      renderFields();
      renderDetails();
      persist();
    }),
  );
  bitInputs.forEach((i) =>
    i.addEventListener('change', () => {
      renderDetails();
      persist();
    }),
  );

  group.checked = prefs.group;
  upper.checked = prefs.upper;
  customBase.value = String(prefs.customBase);
  for (const i of bitInputs) i.checked = Number(i.value) === prefs.bits;
  const initial = parseInBase(prefs.value || '255', 10);
  value = initial.ok ? initial.value : 255n;
  renderFields();
  renderDetails();
</script>

<style>
  .nb-fields {
    display: grid;
    gap: 14px;
  }
  .nb-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .nb-input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .nb-custom-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .nb-base-select.nb-base-select {
    width: auto;
    padding: 4px 10px;
  }
  .nb-twos .table th {
    width: 1%;
  }
  .nb-wrap {
    white-space: normal !important;
    overflow-wrap: anywhere;
  }
  @media (max-width: 520px) {
    .nb-twos .table th {
      white-space: normal;
    }
  }
</style>
