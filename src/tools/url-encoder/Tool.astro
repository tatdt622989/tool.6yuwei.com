---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="url-encoder" {...i18nAttrs(locale, s.client)}>
  <div class="row">
    <div class="seg" role="radiogroup" aria-label={s.modeAria}>
      <label><input type="radio" name="ue-mode" value="encode" checked /><span>{s.encode}</span></label>
      <label><input type="radio" name="ue-mode" value="decode" /><span>{s.decode}</span></label>
    </div>
    <div class="seg" role="radiogroup" aria-label={s.scopeAria} id="ue-scope">
      <label><input type="radio" name="ue-scope" value="component" checked /><span>encodeURIComponent</span></label>
      <label><input type="radio" name="ue-scope" value="uri" /><span>encodeURI</span></label>
    </div>
    <label class="check"><input type="checkbox" id="ue-plus" /> {s.plus}</label>
  </div>
  <p class="hint" id="ue-scope-hint"></p>

  <div class="field">
    <label for="ue-input" id="ue-input-label">{s.client.inputEncode}</label>
    <textarea id="ue-input" class="mono" rows="6" spellcheck="false" autocomplete="off"></textarea>
  </div>
  <div id="ue-error" class="notice error" role="alert" hidden></div>
  <div class="field">
    <label for="ue-output">{s.outputLabel}</label>
    <textarea id="ue-output" class="mono" rows="6" readonly spellcheck="false"></textarea>
  </div>
  <div class="row">
    <button class="btn primary" type="button" data-copy="#ue-output">{s.copy}</button>
    <button class="btn" type="button" id="ue-swap">{s.swap}</button>
    <button class="btn ghost" type="button" id="ue-clear">{s.clear}</button>
  </div>

  <hr class="ue-sep" />

  <h2 class="ue-title">{s.parserTitle}</h2>
  <div class="field">
    <label for="ue-url">{s.urlLabel}</label>
    <input id="ue-url" type="text" class="mono" spellcheck="false" autocomplete="off" placeholder={s.urlPlaceholder} />
  </div>
  <div id="ue-url-status" class="notice" hidden></div>
  <div id="ue-parts" hidden>
    <div class="table-wrap">
      <table class="table ue-table">
        <tbody id="ue-parts-body"></tbody>
      </table>
    </div>
  </div>
  <div class="field" id="ue-params" hidden>
    <span class="label" id="ue-params-label">{s.client.paramsLabel}</span>
    <div class="table-wrap">
      <table class="table ue-table">
        <thead>
          <tr><th class="num">#</th><th>{s.paramName}</th><th>{s.paramValue}</th></tr>
        </thead>
        <tbody id="ue-params-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { t } from '../../i18n/format';
  import { readI18n } from '../../i18n/client';
  import { decodeUrl, encodeUrl, parseUrl, type EncodeMode, type UrlParts } from './logic';
  import type { Strings } from './i18n';

  type Mode = 'encode' | 'decode';
  interface Prefs {
    mode: Mode;
    scope: EncodeMode;
    plus: boolean;
  }

  const root = $('[data-tool="url-encoder"]');
  const { s } = readI18n<Strings['client']>(root);
  const input = $<HTMLTextAreaElement>('#ue-input', root);
  const output = $<HTMLTextAreaElement>('#ue-output', root);
  const inputLabel = $('#ue-input-label', root);
  const error = $('#ue-error', root);
  const scopeSeg = $('#ue-scope', root);
  const scopeHint = $('#ue-scope-hint', root);
  const plus = $<HTMLInputElement>('#ue-plus', root);
  const modeRadios = $$<HTMLInputElement>('input[name="ue-mode"]', root);
  const scopeRadios = $$<HTMLInputElement>('input[name="ue-scope"]', root);

  const checked = (radios: HTMLInputElement[]) => radios.find((r) => r.checked)?.value;
  const readPrefs = (): Prefs => ({
    mode: (checked(modeRadios) ?? 'encode') as Mode,
    scope: (checked(scopeRadios) ?? 'component') as EncodeMode,
    plus: plus.checked,
  });

  function renderConvert() {
    const prefs = readPrefs();
    savePref('url-encoder', prefs);
    const encode = prefs.mode === 'encode';
    scopeSeg.style.display = encode ? '' : 'none';
    scopeHint.textContent = encode ? s.scopeHint[prefs.scope] : s.decodeHint;
    inputLabel.textContent = encode ? s.inputEncode : s.inputDecode;
    input.placeholder = encode ? s.placeholderEncode : s.placeholderDecode;
    error.hidden = true;
    if (input.value === '') {
      output.value = '';
      return;
    }
    const result = encode ? encodeUrl(input.value, prefs.scope, prefs.plus) : decodeUrl(input.value, prefs.plus);
    if (result.ok) {
      output.value = result.value;
    } else {
      output.value = '';
      error.textContent = t(s.errors[result.code], { position: result.position ?? 0, snippet: result.snippet ?? '' });
      error.hidden = false;
    }
  }

  // ---- URL parser ----
  const urlInput = $<HTMLInputElement>('#ue-url', root);
  const urlStatus = $('#ue-url-status', root);
  const partsWrap = $('#ue-parts', root);
  const partsBody = $('#ue-parts-body', root);
  const paramsWrap = $('#ue-params', root);
  const paramsBody = $('#ue-params-body', root);
  const paramsLabel = $('#ue-params-label', root);

  function row(cells: string[], headerFirst = false): HTMLTableRowElement {
    const tr = document.createElement('tr');
    cells.forEach((text, i) => {
      const cell = document.createElement(headerFirst && i === 0 ? 'th' : 'td');
      cell.textContent = text;
      if (!headerFirst && i === 0) cell.className = 'num';
      tr.append(cell);
    });
    return tr;
  }

  function partRows(u: UrlParts): [string, string][] {
    const p = s.parts;
    const rows: [string, string][] = [[p.protocol, u.protocol]];
    if (u.username) rows.push([p.username, u.username]);
    if (u.password) rows.push([p.password, u.password]);
    rows.push([p.host, u.hostname]);
    rows.push([p.port, u.port || (u.defaultPort ? t(p.defaultPort, { port: u.defaultPort }) : '—')]);
    rows.push([p.path, u.pathname || '—']);
    if (u.decodedPathname !== u.pathname) rows.push([p.decodedPath, u.decodedPathname]);
    rows.push([p.query, u.search || '—']);
    rows.push([p.hash, u.hash || '—']);
    if (u.origin !== 'null') rows.push([p.origin, u.origin]);
    return rows;
  }

  function renderUrl() {
    const text = urlInput.value;
    partsWrap.hidden = paramsWrap.hidden = urlStatus.hidden = true;
    if (text.trim() === '') return;
    const result = parseUrl(text);
    if (!result.ok) {
      urlStatus.className = 'notice error';
      urlStatus.textContent = s.urlErrors[result.code];
      urlStatus.hidden = false;
      return;
    }
    const u = result.url;
    if (u.assumedScheme) {
      urlStatus.className = 'notice';
      urlStatus.textContent = s.assumedScheme;
      urlStatus.hidden = false;
    }
    partsBody.replaceChildren(...partRows(u).map((cells) => row(cells, true)));
    partsWrap.hidden = false;
    if (u.params.length > 0) {
      paramsLabel.textContent = t(s.paramsCount, { n: u.params.length });
      paramsBody.replaceChildren(...u.params.map((p, i) => row([String(i + 1), p.key, p.value])));
      paramsWrap.hidden = false;
    }
  }

  const saved = loadPref<Prefs>('url-encoder', { mode: 'encode', scope: 'component', plus: false });
  modeRadios.forEach((r) => (r.checked = r.value === saved.mode));
  scopeRadios.forEach((r) => (r.checked = r.value === saved.scope));
  plus.checked = saved.plus;

  input.addEventListener('input', renderConvert);
  [...modeRadios, ...scopeRadios, plus].forEach((el) => el.addEventListener('change', renderConvert));
  $('#ue-swap', root).addEventListener('click', () => {
    if (!output.value) return;
    input.value = output.value;
    const next = readPrefs().mode === 'encode' ? 'decode' : 'encode';
    modeRadios.forEach((r) => (r.checked = r.value === next));
    renderConvert();
  });
  $('#ue-clear', root).addEventListener('click', () => {
    input.value = '';
    renderConvert();
    input.focus();
  });
  urlInput.addEventListener('input', renderUrl);
  renderConvert();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .ue-sep {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 8px 0 0;
    width: 100%;
  }
  .ue-title {
    font-size: 18px;
  }
  .ue-table :global(td) {
    white-space: normal;
    overflow-wrap: anywhere;
    font-family: var(--mono);
  }
  .ue-table :global(tbody th) {
    width: 1%;
  }
</style>
