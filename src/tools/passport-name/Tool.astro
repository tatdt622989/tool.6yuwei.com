---
import { SYSTEMS, formatPassportName } from './logic';

// Server-rendered example so the page is never empty before the pinyin dictionary loads.
const example = Object.fromEntries(
  SYSTEMS.map((s) => [s.id, formatPassportName([{ key: 'chen' }], [{ key: 'yi' }, { key: 'xuan' }], s.id, { hyphen: true })]),
);
---

<div class="tool" data-tool="passport-name">
  <div class="grid-2">
    <div class="field">
      <label for="pn-surname">中文姓氏</label>
      <input id="pn-surname" type="text" autocomplete="off" maxlength="6" value="陳" placeholder="例如：陳、歐陽" />
    </div>
    <div class="field">
      <label for="pn-given">中文名字</label>
      <input id="pn-given" type="text" autocomplete="off" maxlength="10" value="怡萱" placeholder="例如：怡萱" />
    </div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" id="pn-hyphen" checked /> 名字音節之間加連字號（YI-HSUAN）</label>
  </div>

  <p class="notice" id="pn-status" hidden></p>

  <div class="pn-results" aria-live="polite">
    {
      SYSTEMS.map((s) => (
        <div class="pn-row">
          <div class="pn-sys">
            <strong>{s.name}</strong>
            <span>{s.note}</span>
          </div>
          <output class="pn-out" id={`pn-out-${s.id}`} data-system={s.id}>
            {example[s.id]}
          </output>
          <button class="btn small" type="button" data-copy={`#pn-out-${s.id}`}>
            複製
          </button>
        </div>
      ))
    }
  </div>
  <p class="hint" id="pn-length"></p>

  <div class="field">
    <span class="label">逐字對照（多音字可在「讀音」選擇正確念法）</span>
    <div class="table-wrap">
      <table class="table pn-table">
        <thead>
          <tr>
            <th>字</th>
            <th>讀音</th>
            <th>注音</th>
            <th>漢語拼音</th>
            <th>威妥瑪</th>
            <th>通用拼音</th>
            <th>國音第二式</th>
          </tr>
        </thead>
        <tbody id="pn-chars"></tbody>
      </table>
    </div>
  </div>

  <p class="notice">
    拼音對照依外交部領事事務局「護照外文姓名拼音對照表」。本工具僅供參考，送件前請再以領事事務局「外文姓名中譯英系統」確認；曾領過護照者，外文姓名原則上須與舊護照相同。姓名只在你的瀏覽器中轉換，不會上傳。
  </p>
</div>

<script>
  import { $, $$, debounce, loadPref, savePref } from '../../lib/client';
  import {
    MAX_PASSPORT_LETTERS,
    SYSTEMS,
    TW_SURNAME_READINGS,
    bopomofo,
    contextReadings,
    formatPassportName,
    orderReadings,
    passportLength,
    romanizeSyllable,
    segmentName,
    simplifiedForLookup,
    spellings,
    type NameSyllable,
    type Simplify,
  } from './logic';

  type PinyinModule = typeof import('pinyin-pro');
  interface Libs {
    pinyin: PinyinModule;
    /** Traditional → Simplified; undefined if opencc-js failed to load (readings still work). */
    simplify?: Simplify;
  }

  const root = $('[data-tool="passport-name"]');
  const surnameInput = $<HTMLInputElement>('#pn-surname', root);
  const givenInput = $<HTMLInputElement>('#pn-given', root);
  const hyphen = $<HTMLInputElement>('#pn-hyphen', root);
  const status = $('#pn-status', root);
  const tbody = $('#pn-chars', root);
  const outputs = $$<HTMLOutputElement>('.pn-out', root);

  interface Entry {
    id: string;
    part: 'surname' | 'given';
    label: string;
    readings: string[];
    syllable: NameSyllable;
  }

  let lib: Promise<Libs> | null = null;
  /** User choices survive re-renders as long as the same character stays in the same slot. */
  const readingPicks = new Map<string, string>();
  const wgPicks = new Map<string, number>();
  let entries: Entry[] = [];

  function loadLib(): Promise<Libs> {
    // Both are large: load in parallel on first use. pinyin-pro's word dictionary is Simplified,
    // so names are converted with opencc-js before the context-aware lookup (重陽 → chong yang).
    lib ??= Promise.all([
      import('pinyin-pro'),
      import('opencc-js/t2cn')
        .then(({ Converter }) => Converter({ from: 'tw', to: 'cn' }) as Simplify)
        .catch(() => undefined),
    ]).then(([pinyin, simplify]) => ({ pinyin, simplify }));
    return lib;
  }

  const opts = { toneType: 'none', type: 'array', v: true } as const;

  function build({ pinyin: mod, simplify }: Libs, text: string, part: 'surname' | 'given'): Entry[] {
    const segments = segmentName(text);
    const han = segments.flatMap((s) => (s.kind === 'han' ? [s.char] : [])).join('');
    // Surname mode makes 曾 → zeng etc.; given names use word context (重陽 → chong yang).
    const context = contextReadings(
      han,
      part === 'surname',
      (t, surname) => (surname ? mod.pinyin(t, { ...opts, mode: 'surname' }) : mod.pinyin(t, opts)),
      simplify,
    );
    const simpChars = Array.from(simplifiedForLookup(han, simplify));
    let h = 0;
    return segments.map((seg, i) => {
      const id = `${part}-${i}-${seg.kind === 'han' ? seg.char : seg.text}`;
      if (seg.kind === 'latin') {
        return { id, part, label: seg.text, readings: [], syllable: { key: seg.text, literal: true } };
      }
      const preferred = (part === 'surname' ? TW_SURNAME_READINGS[seg.char] : undefined) ?? context[h];
      // Union of the Traditional and Simplified characters' readings (乾 keeps qian even though 干 lacks it).
      const simpChar = simpChars[h] ?? seg.char;
      const all = [...(mod.polyphonic(seg.char, opts)[0] ?? []), ...(simpChar !== seg.char ? (mod.polyphonic(simpChar, opts)[0] ?? []) : [])];
      h++;
      const readings = orderReadings(preferred, all);
      const picked = readingPicks.get(id);
      const key = picked && readings.includes(picked) ? picked : (readings[0] ?? '');
      return { id, part, label: seg.char, readings, syllable: { key, wgVariant: wgPicks.get(id) ?? 0 } };
    });
  }

  function renderResults() {
    const surname = entries.filter((e) => e.part === 'surname' && e.syllable.key).map((e) => e.syllable);
    const given = entries.filter((e) => e.part === 'given' && e.syllable.key).map((e) => e.syllable);
    let longest = 0;
    for (const out of outputs) {
      const system = SYSTEMS.find((s) => s.id === out.dataset.system)!.id;
      const name = formatPassportName(surname, given, system, { hyphen: hyphen.checked });
      out.textContent = name || '—';
      longest = Math.max(longest, passportLength(name));
    }
    const lengthNote = $('#pn-length', root);
    lengthNote.textContent =
      longest > MAX_PASSPORT_LETTERS
        ? `外文姓名含空格最長 ${longest} 個字元，超過護照條例施行細則規定的 ${MAX_PASSPORT_LETTERS} 個字母上限，請洽領事事務局。`
        : longest
          ? `含逗號與空格共 ${longest} 個字元以內，符合 ${MAX_PASSPORT_LETTERS} 個字母上限。`
          : '';
    lengthNote.classList.toggle('pn-warn', longest > MAX_PASSPORT_LETTERS);
  }

  function select(options: { value: string; label: string }[], current: string, data: Record<string, string>, aria: string) {
    const el = document.createElement('select');
    el.className = 'pn-select';
    el.setAttribute('aria-label', aria);
    for (const [k, v] of Object.entries(data)) el.dataset[k] = v;
    for (const o of options) {
      const opt = document.createElement('option');
      opt.value = o.value;
      opt.textContent = o.label;
      opt.selected = o.value === current;
      el.append(opt);
    }
    return el;
  }

  function td(content: string | Node, cls?: string) {
    const cell = document.createElement('td');
    if (cls) cell.className = cls;
    cell.append(content);
    return cell;
  }

  function renderTable() {
    tbody.innerHTML = '';
    for (const e of entries) {
      const tr = document.createElement('tr');
      const charCell = td(e.label, 'pn-char');
      if (e.syllable.literal) {
        tr.append(charCell, td('英文原樣保留'), td(''), td(e.label.toUpperCase()), td(e.label.toUpperCase()), td(e.label.toUpperCase()), td(e.label.toUpperCase()));
        tbody.append(tr);
        continue;
      }
      const reading =
        e.readings.length > 1
          ? select(
              e.readings.map((r) => ({ value: r, label: `${r.replace(/v/g, 'ü')} ${bopomofo(r)}`.trim() })),
              e.syllable.key,
              { id: e.id, kind: 'reading' },
              `「${e.label}」的讀音`,
            )
          : e.syllable.key.replace(/v/g, 'ü');
      const wgOptions = spellings(e.syllable.key, 'wg');
      const wg =
        wgOptions.length > 1
          ? select(
              wgOptions.map((w, i) => ({ value: String(i), label: w })),
              String(e.syllable.wgVariant ?? 0),
              { id: e.id, kind: 'wg' },
              `「${e.label}」的威妥瑪拼法`,
            )
          : romanizeSyllable(e.syllable, 'wg');
      tr.append(
        charCell,
        td(reading),
        td(bopomofo(e.syllable.key) || '—'),
        td(romanizeSyllable(e.syllable, 'hanyu'), 'mono'),
        td(wg, 'mono'),
        td(romanizeSyllable(e.syllable, 'tongyong'), 'mono'),
        td(romanizeSyllable(e.syllable, 'mps2'), 'mono'),
      );
      tbody.append(tr);
    }
    if (!entries.length) {
      const tr = document.createElement('tr');
      const cell = td('請輸入中文姓名');
      cell.colSpan = 7;
      tr.append(cell);
      tbody.append(tr);
    }
  }

  async function update() {
    savePref('passport-name', { surname: surnameInput.value, given: givenInput.value, hyphen: hyphen.checked });
    let mod: Libs;
    try {
      if (!status.dataset.loaded) {
        status.className = 'notice';
        status.textContent = '正在載入拼音字典…';
        status.hidden = false;
      }
      mod = await loadLib();
    } catch {
      lib = null;
      status.className = 'notice error';
      status.textContent = '拼音字典載入失敗，請檢查網路連線後重新整理頁面。';
      status.hidden = false;
      return;
    }
    status.dataset.loaded = '1';
    status.hidden = true;
    entries = [...build(mod, surnameInput.value, 'surname'), ...build(mod, givenInput.value, 'given')];
    renderTable();
    renderResults();
  }

  tbody.addEventListener('change', (event) => {
    const el = event.target as HTMLSelectElement;
    if (!el.dataset.id) return;
    if (el.dataset.kind === 'reading') {
      readingPicks.set(el.dataset.id, el.value);
      wgPicks.delete(el.dataset.id);
    } else {
      wgPicks.set(el.dataset.id, Number(el.value));
    }
    void update();
  });

  const onInput = debounce(() => void update(), 150);
  surnameInput.addEventListener('input', onInput);
  givenInput.addEventListener('input', onInput);
  hyphen.addEventListener('change', renderResults);
  hyphen.addEventListener('change', () =>
    savePref('passport-name', { surname: surnameInput.value, given: givenInput.value, hyphen: hyphen.checked }),
  );

  const saved = loadPref('passport-name', { surname: '陳', given: '怡萱', hyphen: true });
  surnameInput.value = saved.surname;
  givenInput.value = saved.given;
  hyphen.checked = saved.hyphen;
  void update();
</script>

<style>
  .pn-results {
    display: grid;
    gap: 8px;
  }
  .pn-row {
    display: grid;
    grid-template-columns: 11em minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .pn-row:first-child {
    background: var(--accent-soft);
    border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent);
  }
  .pn-sys {
    display: grid;
    gap: 2px;
    font-size: 14px;
  }
  .pn-sys span {
    font-size: 12px;
    color: var(--muted);
  }
  .pn-out {
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  #pn-length.pn-warn {
    color: var(--danger);
  }
  .pn-table :global(.pn-char) {
    font-size: 20px;
    font-weight: 600;
  }
  .pn-table :global(.pn-select) {
    width: auto;
    min-width: 7em;
    padding: 4px 8px;
    font-size: 15px;
  }
  @media (max-width: 560px) {
    .pn-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 10px;
    }
    .pn-sys {
      grid-column: 1 / -1;
    }
    .pn-out {
      font-size: 18px;
    }
  }
</style>
