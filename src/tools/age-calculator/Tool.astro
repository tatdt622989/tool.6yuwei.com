---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n, { type AgeStat } from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const st = s.stats;
// Fixed display order; each locale shows the tiles it defines in i18n.ts.
const ORDER: AgeStat[] = ['nominal', 'months', 'weeks', 'lived', 'next', 'zodiac', 'kanshi', 'sign', 'born'];
const statKeys = ORDER.filter((k) => st[k]);
/** Tiles whose label the script rewrites. */
const DYNAMIC_LABELS = new Set<AgeStat>(['next', 'kanshi', 'born']);
---

<div class="tool" data-tool="age-calculator" {...i18nAttrs(locale, s.client)}>
  {
    s.era && (
      <div class="field">
        <span class="label">{s.era.legend}</span>
        <div class="seg" role="radiogroup" aria-label={s.era.legend}>
          <label><input type="radio" name="ag-era" value="ad" checked /><span>{s.era.ad}</span></label>
          <label><input type="radio" name="ag-era" value="roc" /><span>{s.era.roc}</span></label>
        </div>
      </div>
    )
  }

  <div class="grid-3">
    <div class={s.monthFirst ? 'field ag-year-last' : 'field'}>
      <label for="ag-year" id="ag-year-label">{s.yearLabel}</label>
      <input id="ag-year" type="text" inputmode="numeric" autocomplete="bday-year" value="1990" />
    </div>
    <div class="field">
      <label for="ag-month">{s.monthLabel}</label>
      <select id="ag-month" autocomplete="bday-month"></select>
    </div>
    <div class="field">
      <label for="ag-day">{s.dayLabel}</label>
      <select id="ag-day" autocomplete="bday-day"></select>
    </div>
  </div>

  <div class="field ag-on">
    <label for="ag-on">{s.onLabel}</label>
    <input id="ag-on" type="date" />
    <span class="hint">{s.onHint}</span>
  </div>

  <div class="result" aria-live="polite">
    <div class="result-value" id="ag-main">—</div>
    <div class="result-label" id="ag-detail"></div>
  </div>

  <div class="stats">
    {
      statKeys.map((k, i) => [
        i ? ' ' : '',
        <div class="stat"><span class="stat-value" id={`ag-${k}`}>—</span><span class="stat-label" id={DYNAMIC_LABELS.has(k) ? `ag-${k}-label` : undefined}>{st[k]}</span></div>,
      ])
    }
  </div>
  <p class="hint">{s.hint}</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { formatDate, plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import {
    daysInMonth,
    formatYMD,
    parseISODate,
    toISODate,
    toUTCDate,
    WEEKDAY_LABEL,
    weekdayOf,
  } from '../date-diff/logic';
  import { adToRoc, calcAge, kanshiOf, rocLabel, rocToAD, warekiLabel, type YMD } from './logic';
  import type { Strings } from './i18n';

  const root = $('[data-tool="age-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const intl = s.dateStyle === 'intl';
  const utcDate = (d: YMD, options: Intl.DateTimeFormatOptions) => formatDate(toUTCDate(d), locale, { ...options, timeZone: 'UTC' });
  const eras = $$<HTMLInputElement>('input[name="ag-era"]', root);
  const yearInput = $<HTMLInputElement>('#ag-year', root);
  const yearLabel = $('#ag-year-label', root);
  const monthSel = $<HTMLSelectElement>('#ag-month', root);
  const daySel = $<HTMLSelectElement>('#ag-day', root);
  const onInput = $<HTMLInputElement>('#ag-on', root);

  interface Prefs {
    era: 'ad' | 'roc';
    y: number;
    m: number;
    d: number;
  }

  const set = (id: string, text: string) => {
    const el = root.querySelector(id);
    if (el) el.textContent = text;
  };

  function era(): 'ad' | 'roc' {
    return eras.find((e) => e.checked)?.value === 'roc' ? 'roc' : 'ad';
  }

  /** Gregorian birth year from the input, or NaN. */
  function birthYear(): number {
    const raw = Math.trunc(parseNumber(yearInput.value));
    if (!Number.isFinite(raw) || raw <= 0) return Number.NaN;
    return era() === 'roc' ? rocToAD(raw) : raw;
  }

  function fillDays() {
    const y = birthYear();
    const max = daysInMonth(Number.isFinite(y) ? y : 2000, Number(monthSel.value));
    const keep = Math.min(Number(daySel.value) || 1, max);
    daySel.replaceChildren(
      ...Array.from({ length: max }, (_, i) => new Option(t(s.dayOption, { n: i + 1 }), String(i + 1), false, i + 1 === keep)),
    );
  }

  function today(): YMD {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }

  function clear(message: string) {
    set('#ag-main', '—');
    set('#ag-detail', message);
    ['#ag-nominal', '#ag-months', '#ag-weeks', '#ag-lived', '#ag-next', '#ag-zodiac', '#ag-kanshi', '#ag-sign', '#ag-born'].forEach(
      (id) => set(id, '—'),
    );
  }

  function render() {
    yearLabel.textContent = era() === 'roc' && s.yearLabelRoc ? s.yearLabelRoc : s.yearLabelAd;
    fillDays();
    const y = birthYear();
    const birth: YMD = { y, m: Number(monthSel.value), d: Number(daySel.value) };
    const on = parseISODate(onInput.value) ?? today();
    if (!Number.isFinite(y) || y < 1000) {
      clear(era() === 'roc' && s.errorYearRoc ? s.errorYearRoc : s.errorYear);
      return;
    }
    savePref('age-calculator', { era: era(), y, m: birth.m, d: birth.d } satisfies Prefs);
    const r = calcAge(birth, on);
    if (!r) {
      clear(s.errorFuture);
      return;
    }
    const n = (forms: typeof s.days, value: number) => plural(locale, value, forms);
    set('#ag-main', n(s.main, r.years));
    set('#ag-detail', t(s.detail, { years: n(s.years, r.years), months: n(s.months, r.months), days: n(s.days, r.days) }));
    set('#ag-nominal', n(s.years, r.nominal));
    set('#ag-months', n(s.months, r.totalMonths));
    if (s.weeks) set('#ag-weeks', n(s.weeks, Math.floor(r.daysLived / 7)));
    set('#ag-lived', n(s.days, r.daysLived));
    if (r.daysToNextBirthday === 0) {
      set('#ag-next', s.nextToday);
      set('#ag-next-label', t(s.nextTodayLabel, { age: r.nextAge }));
    } else {
      const next = r.nextBirthday;
      const date = intl
        ? utcDate(next, { weekday: locale === 'ja' ? 'short' : 'long', month: 'long', day: 'numeric' })
        : `${next.m}/${next.d} 星期${WEEKDAY_LABEL[weekdayOf(next)]}`;
      set('#ag-next', n(s.days, r.daysToNextBirthday));
      set('#ag-next-label', t(s.nextLabel, { age: r.nextAge, date }));
    }
    set('#ag-zodiac', r.zodiac);
    const kanshi = kanshiOf(birth.y);
    set('#ag-kanshi', `${kanshi.shi}（${kanshi.shiKana}）年`);
    set('#ag-kanshi-label', `干支：${kanshi.kanshi}（${kanshi.kanshiKana}）`);
    set('#ag-sign', s.signs?.[r.sign] ?? r.constellation);
    if (intl) {
      set('#ag-born', utcDate(birth, { weekday: 'long' }));
      set('#ag-born-label', s.bornLabel === 'wareki' ? warekiLabel(birth) : utcDate(birth, { dateStyle: 'long' }));
    } else {
      set('#ag-born', `星期${WEEKDAY_LABEL[weekdayOf(birth)]}`);
      set(
        '#ag-born-label',
        era() === 'roc' ? `西元 ${formatYMD(birth).replace(/（.）$/, '')}` : `${rocLabel(birth.y)} ${birth.m} 月 ${birth.d} 日`,
      );
    }
  }

  const monthName = new Intl.DateTimeFormat(LOCALE_INFO[locale].intl, { month: 'long', timeZone: 'UTC' });
  monthSel.replaceChildren(
    ...Array.from(
      { length: 12 },
      (_, i) =>
        new Option(s.monthOption ? t(s.monthOption, { n: i + 1 }) : monthName.format(Date.UTC(2000, i, 1)), String(i + 1)),
    ),
  );
  const prefs = loadPref<Prefs>('age-calculator', { era: 'ad', y: 1990, m: 6, d: 15 });
  for (const e of eras) e.checked = e.value === prefs.era;
  if (eras.length && !eras.some((e) => e.checked)) eras[0].checked = true;
  yearInput.value = String(era() === 'roc' ? adToRoc(prefs.y) : prefs.y);
  monthSel.value = String(prefs.m);
  daySel.replaceChildren(new Option('', String(prefs.d), false, true));
  onInput.value = toISODate(today());

  eras.forEach((e) =>
    e.addEventListener('change', () => {
      // Keep the same birth year when switching between 西元 and 民國.
      const raw = Math.trunc(parseNumber(yearInput.value));
      if (Number.isFinite(raw) && raw > 0) yearInput.value = String(era() === 'roc' ? adToRoc(raw) : rocToAD(raw));
      render();
    }),
  );
  yearInput.addEventListener('input', render);
  [monthSel, daySel].forEach((el) => el.addEventListener('change', render));
  onInput.addEventListener('input', render);
  render();
</script>

<style>
  .ag-year-last {
    order: 3;
  }
  .ag-on {
    max-width: 320px;
  }
</style>
