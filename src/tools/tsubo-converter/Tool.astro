---
import type { ToolProps } from '../../i18n/tool';
import { formatNumber } from '../../lib/format';
import { QUICK_TATAMI, QUICK_TSUBO, TATAMI, convertArea, toSquareMeters } from './logic';

type Props = ToolProps;
const { locale = 'ja' } = Astro.props;

const units = [
  { id: 'm2', label: '平米（㎡）' },
  { id: 'tsubo', label: '坪' },
  { id: 'tatami', label: '畳（帖）' },
  { id: 'a', label: 'アール（a）' },
  { id: 'ha', label: 'ヘクタール（ha）' },
];
const tsuboRows = QUICK_TSUBO.map((t) => ({
  tsubo: formatNumber(t, 0, locale),
  m2: formatNumber(convertArea(t, 'tsubo', 'm2'), 2, locale),
  tatami: formatNumber(convertArea(t, 'tsubo', 'tatami', 'koukoku'), 1, locale),
}));
const tatamiRows = QUICK_TATAMI.map((n) => ({
  tatami: formatNumber(n, 1, locale),
  cells: TATAMI.map((t) => formatNumber(toSquareMeters(n, 'tatami', t.id), 2, locale)),
}));
---

<div class="tool" data-tool="tsubo-converter" data-locale={locale}>
  <div class="grid-2">
    <div class="field">
      <label for="ts-value">面積</label>
      <input id="ts-value" type="text" inputmode="decimal" autocomplete="off" value="30" />
    </div>
    <div class="field">
      <label for="ts-unit">単位</label>
      <select id="ts-unit">
        {units.map((u, i) => <option value={u.id} selected={i === 1}>{u.label}</option>)}
      </select>
    </div>
  </div>
  <div class="field">
    <label for="ts-tatami">畳の大きさ</label>
    <select id="ts-tatami">
      {TATAMI.map((t, i) => <option value={t.id} selected={i === 0}>{t.label}：{t.size}</option>)}
    </select>
    <span class="hint">不動産広告の「◯帖」は 1 帖 = 1.62 ㎡ 以上で表示するルールです。実際の和室の畳は地域や建物で大きさが違います。</span>
  </div>

  <div class="notice error" id="ts-error" hidden></div>

  <div id="ts-output">
    <div class="stats">
      <div class="stat"><span class="stat-value" id="ts-m2">—</span><span class="stat-label">平米（㎡）</span></div>
      <div class="stat"><span class="stat-value" id="ts-tsubo">—</span><span class="stat-label">坪</span></div>
      <div class="stat"><span class="stat-value" id="ts-tatami-out">—</span><span class="stat-label" id="ts-tatami-label">畳</span></div>
      <div class="stat"><span class="stat-value" id="ts-ad">—</span><span class="stat-label">広告で表示できる畳数の上限</span></div>
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>畳の種類（1畳の大きさ）</th><th class="num">畳数</th></tr></thead>
        <tbody id="ts-table"></tbody>
      </table>
    </div>
  </div>

  <section class="ts-sub" aria-labelledby="ts-price-title">
    <h2 class="ts-title" id="ts-price-title">坪単価と㎡単価の換算</h2>
    <div class="grid-2">
      <div class="field">
        <label for="ts-per-tsubo">坪単価（円）</label>
        <input id="ts-per-tsubo" type="text" inputmode="numeric" autocomplete="off" value="1,000,000" />
      </div>
      <div class="field">
        <label for="ts-per-m2">㎡単価（円）</label>
        <input id="ts-per-m2" type="text" inputmode="numeric" autocomplete="off" />
      </div>
    </div>
    <div class="field">
      <label for="ts-total">総額（円・任意）</label>
      <input id="ts-total" type="text" inputmode="numeric" autocomplete="off" placeholder="例：30,000,000" />
      <span class="hint">入力すると、上で入力した面積から坪単価と㎡単価を計算します。</span>
    </div>
    <div class="stats" id="ts-unit-stats" hidden>
      <div class="stat"><span class="stat-value" id="ts-calc-tsubo">—</span><span class="stat-label">坪単価</span></div>
      <div class="stat"><span class="stat-value" id="ts-calc-m2">—</span><span class="stat-label">㎡単価</span></div>
    </div>
    <div class="notice error" id="ts-price-error" hidden></div>
  </section>

  <details class="ts-quick">
    <summary>坪・畳・㎡ の早見表</summary>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th class="num">坪</th><th class="num">㎡</th><th class="num">畳（1.62㎡）</th></tr></thead>
        <tbody>
          {tsuboRows.map((r) => <tr><td class="num">{r.tsubo}</td><td class="num">{r.m2}</td><td class="num">{r.tatami}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th class="num">畳</th>{TATAMI.map((t) => <th class="num">{t.label.replace(/（.*）/, '')}</th>)}</tr>
        </thead>
        <tbody>
          {tatamiRows.map((r) => <tr><td class="num">{r.tatami}</td>{r.cells.map((c) => <td class="num">{c} ㎡</td>)}</tr>)}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { $, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import type { Locale } from '../../i18n/locales';
  import {
    TATAMI,
    fromSquareMeters,
    maxAdvertisedTatami,
    perM2ToPerTsubo,
    perTsuboToPerM2,
    toSquareMeters,
    unitPrices,
    type AreaUnit,
    type TatamiType,
  } from './logic';

  const root = $('[data-tool="tsubo-converter"]');
  const locale = (root.dataset.locale ?? 'ja') as Locale;
  const value = $<HTMLInputElement>('#ts-value', root);
  const unit = $<HTMLSelectElement>('#ts-unit', root);
  const tatami = $<HTMLSelectElement>('#ts-tatami', root);
  const error = $('#ts-error', root);
  const output = $('#ts-output', root);
  const table = $('#ts-table', root);
  const perTsubo = $<HTMLInputElement>('#ts-per-tsubo', root);
  const perM2 = $<HTMLInputElement>('#ts-per-m2', root);
  const total = $<HTMLInputElement>('#ts-total', root);
  const unitStats = $('#ts-unit-stats', root);
  const priceError = $('#ts-price-error', root);
  const set = (id: string, text: string) => {
    $(id, root).textContent = text;
  };
  const yen = (n: number) => `${formatInteger(n, locale)} 円`;

  const prefs = loadPref<{ value?: string; unit?: string; tatami?: string }>('tsubo-converter', {});
  if (prefs.value !== undefined) value.value = prefs.value;
  if (prefs.unit && unit.querySelector(`option[value="${prefs.unit}"]`)) unit.value = prefs.unit;
  if (prefs.tatami && tatami.querySelector(`option[value="${prefs.tatami}"]`)) tatami.value = prefs.tatami;

  let areaM2 = Number.NaN;

  function renderArea() {
    savePref('tsubo-converter', { value: value.value, unit: unit.value, tatami: tatami.value });
    const v = parseNumber(value.value);
    if (!Number.isFinite(v) || v < 0) {
      areaM2 = Number.NaN;
      error.textContent = '0 以上の数値を入力してください。';
      error.hidden = value.value.trim() === '';
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;
    const type = tatami.value as TatamiType;
    areaM2 = toSquareMeters(v, unit.value as AreaUnit, type);
    const tType = TATAMI.find((t) => t.id === type)!;
    set('#ts-m2', `${formatNumber(areaM2, 2, locale)} ㎡`);
    set('#ts-tsubo', `${formatNumber(fromSquareMeters(areaM2, 'tsubo'), 2, locale)} 坪`);
    set('#ts-tatami-out', `${formatNumber(fromSquareMeters(areaM2, 'tatami', type), 2, locale)} 畳`);
    set('#ts-tatami-label', `畳（${tType.label}）`);
    set('#ts-ad', `${formatNumber(maxAdvertisedTatami(areaM2), 1, locale)} 帖`);
    table.replaceChildren(
      ...TATAMI.map((t) => {
        const tr = document.createElement('tr');
        const name = document.createElement('td');
        const size = document.createElement('span');
        size.className = 'ts-size';
        size.textContent = t.size;
        name.append(t.label, size);
        const count = document.createElement('td');
        count.className = 'num';
        count.textContent = `${formatNumber(fromSquareMeters(areaM2, 'tatami', t.id), 2, locale)} 畳`;
        tr.append(name, count);
        return tr;
      }),
    );
  }

  function renderTotal() {
    if (total.value.trim() === '') {
      unitStats.hidden = true;
      priceError.hidden = true;
      return;
    }
    const r = unitPrices(parseNumber(total.value), areaM2);
    if (!r) {
      unitStats.hidden = true;
      priceError.textContent = '総額と面積に 0 より大きい数値を入力してください。';
      priceError.hidden = false;
      return;
    }
    priceError.hidden = true;
    unitStats.hidden = false;
    set('#ts-calc-tsubo', yen(r.perTsubo));
    set('#ts-calc-m2', yen(r.perM2));
  }

  function syncPrice(from: 'tsubo' | 'm2') {
    const src = from === 'tsubo' ? perTsubo : perM2;
    const dst = from === 'tsubo' ? perM2 : perTsubo;
    const v = parseNumber(src.value);
    dst.value = Number.isFinite(v) && v >= 0 ? formatInteger(from === 'tsubo' ? perTsuboToPerM2(v) : perM2ToPerTsubo(v), locale) : '';
  }

  value.addEventListener('input', () => {
    renderArea();
    renderTotal();
  });
  unit.addEventListener('change', () => {
    renderArea();
    renderTotal();
  });
  tatami.addEventListener('change', () => {
    renderArea();
    renderTotal();
  });
  perTsubo.addEventListener('input', () => syncPrice('tsubo'));
  perM2.addEventListener('input', () => syncPrice('m2'));
  total.addEventListener('input', renderTotal);

  renderArea();
  syncPrice('tsubo');
  renderTotal();
</script>

<style>
  #ts-output {
    display: grid;
    gap: 16px;
  }
  #ts-output[hidden] {
    display: none;
  }
  .tool :global(.ts-size) {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }
  #ts-table :global(td:first-child) {
    white-space: normal;
  }
  [data-tool='tsubo-converter'] .stat-value {
    font-size: 19px;
  }
  .ts-sub {
    display: grid;
    gap: 14px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .ts-title {
    margin: 0;
    font-size: 17px;
  }
  .ts-quick {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .ts-quick[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .ts-quick summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-2);
  }
</style>
