---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
---

<div class="tool" data-tool="image-crop" {...i18nAttrs(locale, s.client)}>
  <p class="notice ok cr-privacy">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    <span><strong>{s.privacyStrong}</strong>{s.privacyText}</span>
  </p>

  <label class="dropzone cr-drop" id="cr-drop" tabindex="0">
    <input type="file" id="cr-file" accept="image/*,.heic,.heif" hidden />
    <strong>{s.dropTitle}</strong>
    <span class="hint">{s.dropHint}</span>
  </label>

  <div class="field">
    <span class="label">{s.aspectLabel}</span>
    <div class="seg" role="radiogroup" aria-label={s.aspectLabel}>
      {s.aspects.map((a, i) => <Fragment>{' '}<label><input type="radio" name="cr-aspect" value={a.value} checked={i === 0} /><span>{a.label}</span></label></Fragment>)}
    </div>
  </div>

  <div class="cr-workspace" id="cr-workspace">
    <div class="cr-stage" id="cr-stage">
      <canvas id="cr-canvas" width="1" height="1"></canvas>
      <div class="cr-mask" aria-hidden="true"><div class="cr-hole" id="cr-hole"></div></div>
      <div class="cr-box" id="cr-box" tabindex="0" role="group" aria-label={s.boxAria}>
        <span class="cr-h" data-h="nw"></span>
        <span class="cr-h" data-h="n"></span>
        <span class="cr-h" data-h="ne"></span>
        <span class="cr-h" data-h="e"></span>
        <span class="cr-h" data-h="se"></span>
        <span class="cr-h" data-h="s"></span>
        <span class="cr-h" data-h="sw"></span>
        <span class="cr-h" data-h="w"></span>
      </div>
    </div>
  </div>

  <div class="row">
    <button class="btn small" type="button" id="cr-rot-l">{s.rotateLeft}</button>
    <button class="btn small" type="button" id="cr-rot-r">{s.rotateRight}</button>
    <button class="btn small" type="button" id="cr-flip-h">{s.flipH}</button>
    <button class="btn small" type="button" id="cr-flip-v">{s.flipV}</button>
    <button class="btn small ghost" type="button" id="cr-reset">{s.reset}</button>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="cr-size">—</span><span class="stat-label">{s.statSize}</span></div>
    <div class="stat"><span class="stat-value" id="cr-ratio">—</span><span class="stat-label">{s.statRatio}</span></div>
    <div class="stat"><span class="stat-value" id="cr-orig">—</span><span class="stat-label">{s.statOrig}</span></div>
  </div>

  <div class="grid-2">
    <div class="field">
      <span class="label">{s.formatLabel}</span>
      <div class="seg" role="radiogroup" aria-label={s.formatLabel}>
        <label><input type="radio" name="cr-format" value="keep" checked /><span>{s.keep}</span></label>
        <label><input type="radio" name="cr-format" value="jpeg" /><span>JPG</span></label>
        <label><input type="radio" name="cr-format" value="png" /><span>PNG</span></label>
        <label><input type="radio" name="cr-format" value="webp" /><span>WebP</span></label>
      </div>
    </div>
    <div class="field" id="cr-quality-field">
      <label for="cr-quality">{s.qualityBefore}<output id="cr-quality-out">92</output></label>
      <input id="cr-quality" type="range" min="10" max="100" step="1" value="92" />
    </div>
  </div>

  <p class="notice error" id="cr-error" hidden></p>

  <div class="row">
    <button class="btn primary" type="button" id="cr-download">{s.download}</button>
    <span class="hint" id="cr-name"></span>
  </div>
</div>

<script>
  import { $, $$, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { isHeic, prepareImage } from '../../lib/heic';
  import { readI18n } from '../../i18n/client';
  import type { Strings } from './i18n';
  import {
    aspectValue,
    flipRect,
    initialCrop,
    moveRect,
    orientMatrix,
    orientedSize,
    outputFilename,
    pixelRect,
    ratioLabel,
    resizeRect,
    resolveOutputType,
    rotateRect,
    rotateState,
    type AspectId,
    type Handle,
    type OutputChoice,
    type Rect,
    type Rotation,
  } from './logic';

  interface Source {
    image: CanvasImageSource;
    width: number;
    height: number;
    name: string;
    type: string;
    close: () => void;
  }
  interface Prefs {
    aspect: AspectId;
    format: OutputChoice;
    quality: number;
  }

  const root = $('[data-tool="image-crop"]');
  const { s: str } = readI18n<Strings['client']>(root);
  const drop = $('#cr-drop', root);
  const fileInput = $<HTMLInputElement>('#cr-file', root);
  const workspace = $('#cr-workspace', root);
  const stage = $('#cr-stage', root);
  const canvas = $<HTMLCanvasElement>('#cr-canvas', root);
  const box = $('#cr-box', root);
  const hole = $('#cr-hole', root);
  const aspectRadios = $$<HTMLInputElement>('input[name="cr-aspect"]', root);
  const formatRadios = $$<HTMLInputElement>('input[name="cr-format"]', root);
  const quality = $<HTMLInputElement>('#cr-quality', root);
  const qualityOut = $('#cr-quality-out', root);
  const qualityField = $('#cr-quality-field', root);
  const errorBox = $('#cr-error', root);
  const nameOut = $('#cr-name', root);
  const downloadBtn = $<HTMLButtonElement>('#cr-download', root);

  const DISPLAY_MAX = 1600;
  let src: Source | null = null;
  let view = { rotation: 0 as Rotation, flipH: false, flipV: false };
  let crop: Rect = { x: 0, y: 0, w: 1, h: 1 };
  let ow = 1;
  let oh = 1;

  // ---------- Settings ----------
  function readPrefs(): Prefs {
    return {
      aspect: (aspectRadios.find((r) => r.checked)?.value ?? 'free') as AspectId,
      format: (formatRadios.find((r) => r.checked)?.value ?? 'keep') as OutputChoice,
      quality: Number(quality.value),
    };
  }
  function applyPrefs(p: Prefs) {
    for (const r of aspectRadios) r.checked = r.value === p.aspect;
    // A ratio saved on another language version may not be offered here.
    if (!aspectRadios.some((r) => r.checked)) aspectRadios[0].checked = true;
    for (const r of formatRadios) r.checked = r.value === p.format;
    quality.value = String(p.quality);
  }
  const aspect = () => aspectValue(readPrefs().aspect);
  const outputType = () => resolveOutputType(src?.type ?? 'image/png', readPrefs().format);

  // ---------- Drawing ----------
  function drawImage() {
    if (!src) return;
    const size = orientedSize(src.width, src.height, view.rotation);
    ow = size.width;
    oh = size.height;
    const s = Math.min(1, DISPLAY_MAX / Math.max(ow, oh));
    canvas.width = Math.max(1, Math.round(ow * s));
    canvas.height = Math.max(1, Math.round(oh * s));
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const m = orientMatrix(src.width, src.height, view.rotation, view.flipH, view.flipV);
    ctx.setTransform(m[0] * s, m[1] * s, m[2] * s, m[3] * s, m[4] * s, m[5] * s);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(src.image, 0, 0);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    layout();
  }

  /** Sizes the canvas in CSS pixels so the whole image fits the workspace. */
  function layout() {
    const style = getComputedStyle(workspace);
    const avail = workspace.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    const maxH = Math.min(window.innerHeight * 0.65, 640);
    let w = Math.min(avail, ow);
    let h = (w * oh) / ow;
    if (h > maxH) {
      h = maxH;
      w = (h * ow) / oh;
    }
    canvas.style.width = `${Math.max(1, w)}px`;
    canvas.style.height = `${Math.max(1, h)}px`;
    positionBox();
  }

  function positionBox() {
    for (const node of [box, hole]) {
      node.style.left = `${(crop.x / ow) * 100}%`;
      node.style.top = `${(crop.y / oh) * 100}%`;
      node.style.width = `${(crop.w / ow) * 100}%`;
      node.style.height = `${(crop.h / oh) * 100}%`;
    }
    const px = pixelRect(crop, ow, oh, aspect());
    $('#cr-size', root).textContent = `${px.w} × ${px.h}`;
    $('#cr-ratio', root).textContent = ratioLabel(px.w, px.h);
    nameOut.textContent = src ? outputFilename(src.name, outputType()) : '';
  }

  function resetCrop() {
    crop = initialCrop(ow, oh, aspect());
    positionBox();
  }

  function updateFormatUi() {
    const type = outputType();
    qualityField.hidden = type === 'image/png';
    qualityOut.textContent = quality.value;
    positionBox();
  }

  // ---------- Loading ----------
  async function decode(file: Blob): Promise<{ image: CanvasImageSource; width: number; height: number; close: () => void }> {
    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { image: bmp, width: bmp.width, height: bmp.height, close: () => bmp.close() };
      } catch {
        /* fall back to <img> */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      return { image: img, width: img.naturalWidth, height: img.naturalHeight, close: () => {} };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  function setSource(next: Source) {
    src?.close();
    src = next;
    view = { rotation: 0, flipH: false, flipV: false };
    $('#cr-orig', root).textContent = `${next.width} × ${next.height}`;
    errorBox.hidden = true;
    drawImage();
    resetCrop();
    updateFormatUi();
  }

  async function loadFile(file: File) {
    if (!file.type.startsWith('image/') && !/\.(jpe?g|png|webp|gif|bmp|avif)$/i.test(file.name) && !isHeic(file.type, file.name)) {
      showError(str.notImage);
      return;
    }
    try {
      const ready = await prepareImage(file);
      const decoded = await decode(ready);
      setSource({ ...decoded, name: file.name || 'image.png', type: ready.type });
    } catch {
      showError(str.readError);
    }
  }

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function sampleSource(): Source {
    const c = document.createElement('canvas');
    c.width = 1200;
    c.height = 800;
    const ctx = c.getContext('2d')!;
    const sky = ctx.createLinearGradient(0, 0, 0, 800);
    sky.addColorStop(0, '#2b4c8c');
    sky.addColorStop(0.6, '#e9a46a');
    sky.addColorStop(1, '#f4d6a0');
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, 1200, 800);
    ctx.fillStyle = '#fff3c4';
    ctx.beginPath();
    ctx.arc(820, 430, 90, 0, Math.PI * 2);
    ctx.fill();
    const ridge = (color: string, base: number, points: [number, number][]) => {
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(0, base);
      for (const [x, y] of points) ctx.lineTo(x, y);
      ctx.lineTo(1200, 800);
      ctx.lineTo(0, 800);
      ctx.closePath();
      ctx.fill();
    };
    ridge('#5b4a6b', 560, [[180, 420], [360, 520], [560, 360], [760, 500], [980, 400], [1200, 520]]);
    ridge('#3a3150', 640, [[220, 560], [420, 620], [640, 520], [880, 640], [1060, 560], [1200, 600]]);
    ridge('#211d30', 720, [[300, 690], [600, 730], [900, 680], [1200, 720]]);
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = str.sampleFont;
    ctx.fillText(str.sampleText, 40, 64);
    return { image: c, width: 1200, height: 800, name: 'sample.png', type: 'image/png', close: () => {} };
  }

  // ---------- Pointer interaction ----------
  stage.addEventListener('pointerdown', (e) => {
    if (!src || (e.pointerType === 'mouse' && e.button !== 0)) return;
    const target = e.target as HTMLElement;
    const handle = target.closest<HTMLElement>('.cr-h')?.dataset.h as Handle | undefined;
    if (!handle && !target.closest('#cr-box')) return;
    e.preventDefault();
    box.focus({ preventScroll: true });
    const scale = ow / stage.getBoundingClientRect().width;
    const minSize = Math.max(1, 24 * scale);
    const start = { ...crop };
    const sx = e.clientX;
    const sy = e.clientY;
    const lock = aspect();
    stage.setPointerCapture(e.pointerId);
    stage.classList.add('is-dragging');
    const move = (ev: PointerEvent) => {
      const dx = (ev.clientX - sx) * scale;
      const dy = (ev.clientY - sy) * scale;
      crop = handle ? resizeRect(start, handle, dx, dy, ow, oh, lock, minSize) : moveRect(start, dx, dy, ow, oh);
      positionBox();
    };
    const end = () => {
      stage.removeEventListener('pointermove', move);
      stage.removeEventListener('pointerup', end);
      stage.removeEventListener('pointercancel', end);
      stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointermove', move);
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
  });

  box.addEventListener('keydown', (e) => {
    const dirs: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
    const dir = dirs[e.key];
    if (!dir) return;
    e.preventDefault();
    const step = Math.max(1, Math.round(Math.max(ow, oh) / 200)) * (e.shiftKey ? 5 : 1);
    crop = moveRect(crop, dir[0] * step, dir[1] * step, ow, oh);
    positionBox();
  });

  // ---------- Transform buttons ----------
  function turn(clockwise: boolean) {
    if (!src) return;
    const before = { w: ow, h: oh };
    view = rotateState(view, clockwise);
    const lock = aspect();
    drawImage();
    if (lock && lock !== 1) resetCrop();
    else {
      crop = rotateRect(crop, before.w, before.h, clockwise);
      positionBox();
    }
  }
  function flip(horizontal: boolean) {
    if (!src) return;
    if (horizontal) view.flipH = !view.flipH;
    else view.flipV = !view.flipV;
    drawImage();
    crop = flipRect(crop, ow, oh, horizontal);
    positionBox();
  }

  $('#cr-rot-l', root).addEventListener('click', () => turn(false));
  $('#cr-rot-r', root).addEventListener('click', () => turn(true));
  $('#cr-flip-h', root).addEventListener('click', () => flip(true));
  $('#cr-flip-v', root).addEventListener('click', () => flip(false));
  $('#cr-reset', root).addEventListener('click', () => {
    if (!src) return;
    view = { rotation: 0, flipH: false, flipV: false };
    drawImage();
    resetCrop();
  });

  aspectRadios.forEach((r) =>
    r.addEventListener('change', () => {
      savePref('image-crop', readPrefs());
      resetCrop();
    }),
  );
  formatRadios.forEach((r) =>
    r.addEventListener('change', () => {
      savePref('image-crop', readPrefs());
      updateFormatUi();
    }),
  );
  quality.addEventListener('input', () => {
    qualityOut.textContent = quality.value;
    savePref('image-crop', readPrefs());
  });

  // ---------- Export ----------
  function canvasToBlob(c: HTMLCanvasElement, type: string, q?: number): Promise<Blob> {
    return new Promise((resolve, reject) => c.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), type, q));
  }

  downloadBtn.addEventListener('click', async () => {
    if (!src) return;
    errorBox.hidden = true;
    const type = outputType();
    const px = pixelRect(crop, ow, oh, aspect());
    const out = document.createElement('canvas');
    out.width = px.w;
    out.height = px.h;
    const ctx = out.getContext('2d');
    if (!ctx) return;
    if (type === 'image/jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, px.w, px.h);
    }
    const m = orientMatrix(src.width, src.height, view.rotation, view.flipH, view.flipV);
    ctx.setTransform(m[0], m[1], m[2], m[3], m[4] - px.x, m[5] - px.y);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(src.image, 0, 0);
    downloadBtn.disabled = true;
    try {
      const blob = await canvasToBlob(out, type, type === 'image/png' ? undefined : Number(quality.value) / 100);
      downloadBlob(blob, outputFilename(src.name, blob.type || type));
    } catch {
      showError(str.exportError);
    } finally {
      out.width = out.height = 0;
      downloadBtn.disabled = false;
    }
  });

  // ---------- File input ----------
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) void loadFile(file);
    fileInput.value = '';
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('is-over');
    const file = e.dataTransfer?.files[0];
    if (file) void loadFile(file);
  });
  document.addEventListener('paste', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, [contenteditable]')) return;
    const file = Array.from(e.clipboardData?.files ?? []).find((f) => f.type.startsWith('image/'));
    if (!file) return;
    e.preventDefault();
    void loadFile(new File([file], file.name && file.name !== 'image.png' ? file.name : `paste-${Date.now()}.png`, { type: file.type }));
  });

  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => layout()).observe(workspace);
  else window.addEventListener('resize', layout);

  applyPrefs(loadPref<Prefs>('image-crop', { aspect: 'free', format: 'keep', quality: 92 }));
  setSource(sampleSource());

  // Hide WebP when the browser cannot encode it (older Safari silently returns PNG).
  {
    const probe = document.createElement('canvas');
    probe.width = probe.height = 2;
    probe.toBlob((b) => {
      if (b?.type === 'image/webp') return;
      const webp = formatRadios.find((r) => r.value === 'webp')!;
      webp.disabled = true;
      if (webp.checked) {
        formatRadios.find((r) => r.value === 'keep')!.checked = true;
        updateFormatUi();
      }
    }, 'image/webp');
  }
</script>

<style>
  .cr-privacy {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .cr-privacy svg {
    flex: none;
    margin-top: 2px;
  }
  .cr-drop {
    min-height: 104px;
    padding: 16px;
  }
  .cr-workspace {
    --cr-shade: rgb(0 0 0 / 0.5);
    --cr-line: rgb(255 255 255 / 0.9);
    --cr-grid: rgb(255 255 255 / 0.45);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cr-stage {
    position: relative;
    line-height: 0;
    user-select: none;
    -webkit-user-select: none;
  }
  /* The dimmed surround is clipped to the image; the box and its handles are not, so edge handles stay grabbable. */
  .cr-mask {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .cr-hole {
    position: absolute;
    box-shadow: 0 0 0 9999px var(--cr-shade);
  }
  .cr-stage canvas {
    display: block;
  }
  .cr-box {
    position: absolute;
    box-sizing: border-box;
    border: 1px solid var(--cr-line);
    cursor: move;
    touch-action: none;
    outline: none;
  }
  .cr-box:focus-visible {
    border: 2px solid var(--accent);
  }
  .cr-box::before,
  .cr-box::after {
    content: '';
    position: absolute;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .cr-box::before {
    top: 0;
    bottom: 0;
    left: 33.333%;
    right: 33.333%;
    border-left: 1px solid var(--cr-grid);
    border-right: 1px solid var(--cr-grid);
  }
  .cr-box::after {
    left: 0;
    right: 0;
    top: 33.333%;
    bottom: 33.333%;
    border-top: 1px solid var(--cr-grid);
    border-bottom: 1px solid var(--cr-grid);
  }
  .cr-stage.is-dragging .cr-box::before,
  .cr-stage.is-dragging .cr-box::after,
  .cr-box:hover::before,
  .cr-box:hover::after {
    opacity: 1;
  }
  .cr-h {
    position: absolute;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    background: var(--surface);
    border: 2px solid var(--accent);
    border-radius: 3px;
    box-sizing: border-box;
    z-index: 1;
  }
  /* Bigger invisible hit area for fingers. */
  .cr-h::after {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .cr-h[data-h='nw'] {
    left: 0;
    top: 0;
    cursor: nwse-resize;
  }
  .cr-h[data-h='n'] {
    left: 50%;
    top: 0;
    cursor: ns-resize;
  }
  .cr-h[data-h='ne'] {
    left: 100%;
    top: 0;
    cursor: nesw-resize;
  }
  .cr-h[data-h='e'] {
    left: 100%;
    top: 50%;
    cursor: ew-resize;
  }
  .cr-h[data-h='se'] {
    left: 100%;
    top: 100%;
    cursor: nwse-resize;
  }
  .cr-h[data-h='s'] {
    left: 50%;
    top: 100%;
    cursor: ns-resize;
  }
  .cr-h[data-h='sw'] {
    left: 0;
    top: 100%;
    cursor: nesw-resize;
  }
  .cr-h[data-h='w'] {
    left: 0;
    top: 50%;
    cursor: ew-resize;
  }
</style>
