---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import i18n, { type Mode } from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const first = s.modes[0].value;
const hidden = (mode: Mode) => mode !== first;
const d = s.defaults;
---

<div class="tool" data-tool="discount-calculator" {...i18nAttrs(locale, s.client)}>
  <div class="seg" role="radiogroup" aria-label={s.modeAria}>
    {
      s.modes.map((m) => (
        <label>
          <input type="radio" name="dc-mode" value={m.value} checked={m.value === first} />
          <span>{m.label}</span>
        </label>
      ))
    }
  </div>

  {
    s.zhe && (
      <div class="grid-3 dc-panel" data-panel="zhe" hidden={hidden('zhe')}>
        <div class="field">
          <label for="dc-zhe-price">{s.zhe.price.label}</label>
          <input id="dc-zhe-price" data-k="zhePrice" type="text" inputmode="decimal" autocomplete="off" value={d.zhePrice} />
        </div>
        <div class="field">
          <label for="dc-zhe">{s.zhe.zhe.label}</label>
          <input id="dc-zhe" data-k="zhe" type="text" inputmode="decimal" autocomplete="off" value={d.zhe} />
          <span class="hint">{s.zhe.zhe.hint}</span>
        </div>
        <div class="field">
          <label for="dc-zhe2">{s.zhe.zhe2.label}</label>
          <input id="dc-zhe2" data-k="zhe2" type="text" inputmode="decimal" autocomplete="off" value="" placeholder={s.zhe.zhe2.placeholder} />
          <span class="hint">{s.zhe.zhe2.hint}</span>
        </div>
      </div>
    )
  }

  <div class="grid-2 dc-panel" data-panel="off" hidden={hidden('off')}>
    <div class="field">
      <label for="dc-off-price">{s.off.price.label}</label>
      <input id="dc-off-price" data-k="offPrice" type="text" inputmode="decimal" autocomplete="off" value={d.offPrice} />
    </div>
    <div class="field">
      <label for="dc-off">{s.off.off.label}</label>
      <input id="dc-off" data-k="off" type="text" inputmode="decimal" autocomplete="off" value={d.off} />
      <span class="hint">{s.off.off.hint}</span>
    </div>
    {
      s.off.extra && (
        <div class="field">
          <label for="dc-off2">{s.off.extra.label}</label>
          <input id="dc-off2" data-k="off2" type="text" inputmode="decimal" autocomplete="off" value="" placeholder={s.off.extra.placeholder} />
          <span class="hint">{s.off.extra.hint}</span>
        </div>
      )
    }
  </div>

  {
    s.wari && (
      <div class="grid-2 dc-panel" data-panel="wari" hidden={hidden('wari')}>
        <div class="field">
          <label for="dc-wari-price">{s.wari.price.label}</label>
          <input id="dc-wari-price" data-k="wariPrice" type="text" inputmode="decimal" autocomplete="off" value={d.wariPrice} />
        </div>
        <div class="field">
          <label for="dc-wari">{s.wari.wari.label}</label>
          <input id="dc-wari" data-k="wari" type="text" inputmode="decimal" autocomplete="off" value={d.wari} />
          <span class="hint">{s.wari.wari.hint}</span>
        </div>
      </div>
    )
  }

  <div class="dc-panel dc-stack" data-panel="threshold" hidden={hidden('threshold')}>
    <div class="grid-3">
      <div class="field">
        <label for="dc-th-total">{s.threshold.total.label}</label>
        <input id="dc-th-total" data-k="thTotal" type="text" inputmode="decimal" autocomplete="off" value={d.thTotal} />
      </div>
      <div class="field">
        <label for="dc-th-limit">{s.threshold.limit.label}</label>
        <input id="dc-th-limit" data-k="thLimit" type="text" inputmode="decimal" autocomplete="off" value={d.thLimit} />
      </div>
      <div class="field">
        <label for="dc-th-off">{s.threshold.off.label}</label>
        <input id="dc-th-off" data-k="thOff" type="text" inputmode="decimal" autocomplete="off" value={d.thOff} />
      </div>
    </div>
    <label class="check"><input type="checkbox" id="dc-th-repeat" checked={s.repeatDefault} /> {s.threshold.repeat}</label>
  </div>

  <div class="grid-3 dc-panel" data-panel="bundle" hidden={hidden('bundle')}>
    <div class="field">
      <label for="dc-bd-price">{s.bundle.price.label}</label>
      <input id="dc-bd-price" data-k="bdPrice" type="text" inputmode="decimal" autocomplete="off" value={d.bdPrice} />
    </div>
    <div class="field">
      <label for="dc-bd-buy">{s.bundle.buy.label}</label>
      <input id="dc-bd-buy" data-k="bdBuy" type="text" inputmode="numeric" autocomplete="off" value={d.bdBuy} />
    </div>
    <div class="field">
      <label for="dc-bd-free">{s.bundle.free.label}</label>
      <input id="dc-bd-free" data-k="bdFree" type="text" inputmode="numeric" autocomplete="off" value={d.bdFree} />
    </div>
  </div>

  <div class="grid-2 dc-panel" data-panel="second" hidden={hidden('second')}>
    <div class="field">
      <label for="dc-sc-price">{s.second.price.label}</label>
      <input id="dc-sc-price" data-k="scPrice" type="text" inputmode="decimal" autocomplete="off" value={d.scPrice} />
    </div>
    {
      s.second.unit === 'zhe' ? (
        <div class="field">
          <label for="dc-sc-zhe">{s.second.discount.label}</label>
          <input id="dc-sc-zhe" data-k="scZhe" type="text" inputmode="decimal" autocomplete="off" value={d.scZhe} />
          <span class="hint">{s.second.discount.hint}</span>
        </div>
      ) : (
        <div class="field">
          <label for="dc-sc-off">{s.second.discount.label}</label>
          <input id="dc-sc-off" data-k="scOff" type="text" inputmode="decimal" autocomplete="off" value={d.scOff} />
          <span class="hint">{s.second.discount.hint}</span>
        </div>
      )
    }
  </div>

  {
    s.tax && (
      <div class="field dc-tax">
        <label for="dc-tax">{s.tax.label}</label>
        {s.tax.kind === 'input' ? (
          <input id="dc-tax" type="text" inputmode="decimal" autocomplete="off" value="" placeholder={s.tax.placeholder} />
        ) : (
          <select id="dc-tax">
            {s.tax.options.map((o) => (
              <option value={o.value}>{o.label}</option>
            ))}
          </select>
        )}
        {s.tax.hint && <span class="hint">{s.tax.hint}</span>}
      </div>
    )
  }

  <div class="result" aria-live="polite">
    <div class="result-value" id="dc-main">—</div>
    <div class="result-label" id="dc-main-label">{s.mainLabel}</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="dc-saved">—</span><span class="stat-label">{s.savedLabel}</span></div>
    <div class="stat"><span class="stat-value" id="dc-zhe-out">—</span><span class="stat-label">{s.equivLabel}</span></div>
    <div class="stat"><span class="stat-value" id="dc-extra">—</span><span class="stat-label" id="dc-extra-label">{s.extraLabel}</span></div>
    {
      s.client.taxStat && (
        <div class="stat" id="dc-tax-stat" hidden>
          <span class="stat-value" id="dc-tax-out">—</span>
          <span class="stat-label" id="dc-tax-label"></span>
        </div>
      )
    }
  </div>

  <p class="hint" id="dc-note"></p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatFixed, formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import { readI18n } from '../../i18n/client';
  import { t } from '../../i18n/format';
  import {
    addTax,
    applyPercentOff,
    applyPercentsOff,
    applyThreshold,
    applyWariOff,
    applyZhe,
    buyNGetM,
    factorToPercentOff,
    factorToZhe,
    roundMoney,
    secondItem,
    secondItemPercentOff,
  } from './logic';
  import type { Mode, Strings } from './i18n';

  const root = $('[data-tool="discount-calculator"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const modes = $$<HTMLInputElement>('input[name="dc-mode"]', root);
  const panels = $$<HTMLElement>('[data-panel]', root);
  const inputs = $$<HTMLInputElement>('input[data-k]', root);
  const repeat = $<HTMLInputElement>('#dc-th-repeat', root);
  const main = $('#dc-main', root);
  const mainLabel = $('#dc-main-label', root);
  const saved = $('#dc-saved', root);
  const zheOut = $('#dc-zhe-out', root);
  const extra = $('#dc-extra', root);
  const extraLabel = $('#dc-extra-label', root);
  const note = $('#dc-note', root);
  const tax = root.querySelector<HTMLInputElement | HTMLSelectElement>('#dc-tax');
  const taxStat = root.querySelector<HTMLElement>('#dc-tax-stat');
  const taxOut = root.querySelector<HTMLElement>('#dc-tax-out');
  const taxLabel = root.querySelector<HTMLElement>('#dc-tax-label');
  const percentSecond = root.querySelector('#dc-sc-off') !== null;

  const field = (k: string) => inputs.find((i) => i.dataset.k === k);
  const val = (k: string) => parseNumber(field(k)?.value ?? '');
  const formatMoney = (v: number) =>
    s.moneyFormat === 'integer' ? formatInteger(v, locale) : s.moneyFormat === 'fixed2' ? formatFixed(v, 2, locale) : formatNumber(v, 2, locale);
  const money = (v: number) => (Number.isFinite(v) ? t(s.money, { n: formatMoney(roundMoney(v, s.rounding)) }) : '—');
  const pct = (factor: number) =>
    Number.isFinite(factor) ? t(s.percentOff, { n: formatNumber(factorToPercentOff(factor), 1, locale) }) : '—';

  interface Prefs {
    mode: Mode;
    repeat: boolean;
    values: Record<string, string>;
    tax?: string;
  }
  // Each market has its own currency and default deals, so non-zh locales keep separate prefs.
  const prefKey = locale === 'zh-TW' ? 'discount-calculator' : `discount-calculator:${locale}`;
  const defaultMode = (modes.find((m) => m.checked)?.value ?? 'zhe') as Mode;
  const prefs = loadPref<Prefs>(prefKey, { mode: defaultMode, repeat: repeat.checked, values: {} });
  const savedMode = modes.some((m) => m.value === prefs.mode) ? prefs.mode : defaultMode;
  for (const m of modes) m.checked = m.value === savedMode;
  repeat.checked = prefs.repeat;
  for (const input of inputs) {
    const v = prefs.values?.[input.dataset.k!];
    if (typeof v === 'string') input.value = v;
  }
  if (tax && typeof prefs.tax === 'string') tax.value = prefs.tax;

  function show(
    rawFinal: number,
    label: string,
    original: number,
    factor: number,
    extraValue: string,
    extraText: string,
    hint = '',
  ) {
    const final = roundMoney(rawFinal, s.rounding);
    const ok = Number.isFinite(final);
    main.textContent = ok ? money(final) : '—';
    mainLabel.textContent = label;
    saved.textContent = ok ? money(original - final) : '—';
    zheOut.textContent = ok ? (s.equiv === 'zhe' ? factorToZhe(factor) : pct(factor)) : '—';
    extra.textContent = ok ? extraValue : '—';
    extraLabel.textContent = extraText;
    // en / ja show the percent off in the middle stat already; drop the duplicate.
    (extra.parentElement as HTMLElement).hidden = extraValue === '' && ok;
    note.textContent = ok ? hint : s.invalid;

    if (tax && taxStat && taxOut && taxLabel && s.taxStat) {
      const rate = parseNumber(tax.value);
      const show = ok && Number.isFinite(rate) && rate > 0;
      taxStat.hidden = !show;
      if (show) {
        taxOut.textContent = money(addTax(final, rate, s.rounding));
        taxLabel.textContent = t(s.taxStat, { rate: formatNumber(rate, 3, locale) });
      }
    }
  }

  function render() {
    const mode = (modes.find((m) => m.checked)?.value ?? defaultMode) as Mode;
    for (const panel of panels) panel.hidden = panel.dataset.panel !== mode;
    const values: Record<string, string> = {};
    for (const input of inputs) values[input.dataset.k!] = input.value;
    savePref(prefKey, { mode, repeat: repeat.checked, values, ...(tax ? { tax: tax.value } : {}) });

    if (mode === 'zhe') {
      const second = field('zhe2')!.value.trim();
      const r = second ? applyZhe(val('zhePrice'), val('zhe'), val('zhe2')) : applyZhe(val('zhePrice'), val('zhe'));
      show(r.final, s.labelFinal, val('zhePrice'), r.factor, pct(r.factor), s.extraEquiv, second ? s.noteStack : '');
    } else if (mode === 'off') {
      const second = field('off2')?.value.trim();
      if (second) {
        const r = applyPercentsOff(val('offPrice'), val('off'), val('off2'));
        const stack = t(s.noteStack, {
          a: formatNumber(val('off'), 2, locale),
          b: formatNumber(val('off2'), 2, locale),
          total: formatNumber(factorToPercentOff(r.factor), 2, locale),
          sum: formatNumber(val('off') + val('off2'), 2, locale),
        });
        show(r.final, s.labelFinal, val('offPrice'), r.factor, '', s.extraEquiv, stack);
      } else {
        const r = applyPercentOff(val('offPrice'), val('off'));
        show(r.final, s.labelFinal, val('offPrice'), r.factor, s.equiv === 'zhe' ? pct(r.factor) : '', s.extraEquiv);
      }
    } else if (mode === 'wari') {
      const r = applyWariOff(val('wariPrice'), val('wari'));
      show(r.final, s.labelFinal, val('wariPrice'), r.factor, '', s.extraEquiv);
    } else if (mode === 'threshold') {
      const r = applyThreshold(val('thTotal'), val('thLimit'), val('thOff'), repeat.checked);
      const hint = Number.isFinite(r.toNext)
        ? t(r.times > 0 ? s.noteNextAgain : s.noteNext, { amount: money(r.toNext), off: money(val('thOff')) })
        : '';
      show(r.final, s.labelPaid, val('thTotal'), r.factor, Number.isFinite(r.times) ? t(s.times, { n: r.times }) : '—', s.extraTimes, hint);
    } else if (mode === 'bundle') {
      const r = buyNGetM(val('bdPrice'), val('bdBuy'), val('bdFree'));
      const original = r.items * val('bdPrice');
      show(r.paid, t(s.labelBundle, { n: Number.isFinite(r.items) ? r.items : '—' }), original, r.factor, money(r.perItem), s.extraPerItem);
    } else {
      const r = percentSecond ? secondItemPercentOff(val('scPrice'), val('scOff')) : secondItem(val('scPrice'), val('scZhe'));
      show(r.paid, s.labelTwo, val('scPrice') * 2, r.factor, money(r.perItem), s.extraPerItem, s.noteSecond);
    }
  }

  inputs.forEach((input) => input.addEventListener('input', render));
  modes.forEach((m) => m.addEventListener('change', render));
  repeat.addEventListener('change', render);
  tax?.addEventListener('input', render);
  tax?.addEventListener('change', render);
  render();
</script>

<style>
  .dc-panel[hidden] {
    display: none;
  }
  .dc-stack {
    display: grid;
    gap: 12px;
  }

</style>
