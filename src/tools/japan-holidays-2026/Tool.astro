---
import type { ToolProps } from '../../i18n/tool';
import HolidayCalendarJa from './HolidayCalendarJa.astro';
import { DATA_2026 } from './logic';

type Props = ToolProps;
---

<HolidayCalendarJa
  slug="japan-holidays-2026"
  data={DATA_2026}
  summary="国民の祝日16日に、5月6日の振替休日と9月22日の国民の休日を加えた18日が休みです。ゴールデンウィークとシルバーウィークはどちらも5連休になります。"
  notice="祝日・休日は内閣府「国民の祝日について」に掲載された令和8年（2026年）の一覧に基づいています。春分の日（3月20日）と秋分の日（9月23日）は、国立天文台が前年2月に公表した暦要項で確定した日付です。年末年始（12月29日〜1月3日）は「行政機関の休日に関する法律」による官公庁の休みで、国民の祝日ではありません。"
/>
