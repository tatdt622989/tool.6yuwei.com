---
// Shared UI of the 日本の祝日 yearly tools (japan-holidays-2026 / japan-holidays-2027). ja-only, so strings are
// written here directly. Everything is rendered at build time so the whole calendar is in the HTML; the script
// only adds today's position (past rows, today's cell, countdowns).
import { weekdayOf, type YMD } from '../date-diff/logic';
import { iso, JapanHolidayCalendar, parseIso, WEEKDAYS_JA, type HolidayYearData } from './calendar';

interface Props {
  slug: string;
  data: HolidayYearData;
  /** Year-specific line under the headline. */
  summary: string;
  /** Year-specific source / scope note at the bottom. */
  notice: string;
}

const { slug, data, summary, notice } = Astro.props;
const cal = new JapanHolidayCalendar(data);
const year = data.year;
const wareki = year - 2018;
const stats = cal.stats();
const wd = (d: YMD) => WEEKDAYS_JA[weekdayOf(d)];
const md = (d: YMD) => (d.y === year ? `${d.m}月${d.d}日` : `${d.y}年${d.m}月${d.d}日`);
const mdw = (d: YMD) => `${md(d)}（${wd(d)}）`;
const short = (d: YMD) => `${d.m}/${d.d}`;

const rows = data.holidays.map((h) => {
  const d = parseIso(h.date);
  let note = '';
  if (h.kind === 'substitute') {
    const src = [...data.holidays].reverse().find((x) => x.kind === 'national' && x.date < h.date && wd(parseIso(x.date)) === '日');
    note = src ? `${src.name}（${short(parseIso(src.date))}）が日曜日のため` : '振替休日';
  } else if (h.kind === 'citizens') {
    note = '前後が祝日のため休日（祝日法第3条第3項）';
  }
  return { ...h, d, note };
});
const breaks = cal.longWeekends();
const newYearStart = cal.newYearBreak('start');
const newYearEnd = cal.newYearBreak('end');
const plans = cal.leavePlans();
const months = Array.from({ length: 12 }, (_, i) => {
  const cells = cal.monthGrid(i + 1);
  return { month: i + 1, cells, holidays: cells.flatMap((c) => (c?.holiday ? [{ d: c.d, h: c.holiday }] : [])) };
});
const leaveText = (leave: YMD[]) => leave.map((d) => `${short(d)}（${wd(d)}）`).join('・');
---

<div class="tool" data-tool={slug} data-jp-holidays={JSON.stringify(data)}>
  <div class="result" aria-live="polite">
    <div class="result-value" id="jh-main">{year}年の祝日は{stats.national}日</div>
    <div class="result-label">{summary}</div>
  </div>

  <div class="stats">
    <div class="stat"><span class="stat-value" id="jh-next">—</span><span class="stat-label" id="jh-next-label">次の祝日</span></div>
    <div class="stat"><span class="stat-value" id="jh-break">—</span><span class="stat-label" id="jh-break-label">次の3連休以上</span></div>
    <div class="stat"><span class="stat-value" id="jh-left">—</span><span class="stat-label">{year}年の残りの祝日・休日</span></div>
    <div class="stat">
      <span class="stat-value">{stats.daysOff}日</span><span class="stat-label">土日祝が休みの場合の年間休日</span>
    </div>
  </div>

  <div class="field">
    <span class="label">{year}年（令和{wareki}年）の祝日一覧</span>
    <div class="table-wrap">
      <table class="table jh-table">
        <thead>
          <tr><th>日付</th><th>祝日・休日</th><th>備考</th></tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-end={r.date} class={r.kind !== 'national' ? 'is-extra' : undefined}>
                <td>{mdw(r.d)}</td>
                <td>{r.kind === 'national' ? r.name : r.kind === 'substitute' ? '振替休日' : '国民の休日'}</td>
                <td class="jh-note">{r.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <span class="hint">
      国民の祝日 {stats.national}日＋休日 {stats.extra}日。そのうち平日にあたるのは {stats.weekdayHolidays}日です。
    </span>
  </div>

  <div class="field">
    <span class="label">{year}年の連休（3日以上）</span>
    <div class="table-wrap">
      <table class="table jh-table">
        <thead>
          <tr><th>連休</th><th>期間</th><th class="num">日数</th></tr>
        </thead>
        <tbody>
          <tr data-end={iso(newYearStart.end)}>
            <td>年末年始<span class="muted">（官公庁）</span></td>
            <td>{mdw(newYearStart.start)}〜{mdw(newYearStart.end)}</td>
            <td class="num">{newYearStart.days}連休</td>
          </tr>
          {
            breaks.map((b) => (
              <tr data-end={iso(b.end)}>
                <td>{b.label}</td>
                <td>
                  {mdw(b.start)}〜{mdw(b.end)}
                </td>
                <td class="num">{b.days}連休</td>
              </tr>
            ))
          }
          <tr data-end={iso(newYearEnd.end)}>
            <td>年末年始<span class="muted">（官公庁）</span></td>
            <td>{mdw(newYearEnd.start)}〜{mdw(newYearEnd.end)}</td>
            <td class="num">{newYearEnd.days}連休</td>
          </tr>
        </tbody>
      </table>
    </div>
    <span class="hint">
      土日・祝日・休日が続く期間です。年末年始は国民の祝日ではなく、官公庁の休み（12月29日〜1月3日）に土日を合わせた日数です。民間企業の年末年始休暇は会社によって異なります。
    </span>
  </div>

  {
    plans.length > 0 && (
      <div class="field">
        <span class="label">有給休暇を1〜2日使うと作れる連休</span>
        <div class="table-wrap">
          <table class="table jh-table">
            <thead>
              <tr><th>組み合わせる休み</th><th>休む日</th><th>連休期間</th><th class="num">日数</th></tr>
            </thead>
            <tbody>
              {plans.map((p) => (
                <tr data-end={iso(p.leave[0])}>
                  <td>{p.label}</td>
                  <td>{leaveText(p.leave)}</td>
                  <td>
                    {short(p.start)}〜{short(p.end)}
                  </td>
                  <td class="num">{p.days}連休</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <span class="hint">土日祝休みの場合の目安です。過ぎた連休や休暇プランは薄い色で表示します。</span>
      </div>
    )
  }

  <div class="field">
    <span class="label">{year}年 祝日カレンダー</span>
    <div class="jh-legend" aria-hidden="true">
      <span><i class="jh-key jh-key-holiday"></i>祝日</span>
      <span><i class="jh-key jh-key-extra"></i>振替休日・国民の休日</span>
      <span><i class="jh-key jh-key-weekend"></i>土日</span>
      <span><i class="jh-key jh-key-today"></i>今日</span>
    </div>
    <div class="jh-months">
      {
        months.map((m) => (
          <section class="jh-month" aria-label={`${year}年${m.month}月`}>
            <h3 class="jh-month-title">
              {m.month}月<span class="muted">{year}年</span>
            </h3>
            <table class="jh-cal">
              <thead>
                <tr>
                  {WEEKDAYS_JA.map((w, i) => (
                    <th scope="col" class={i === 0 ? 'is-sun' : i === 6 ? 'is-sat' : undefined}>
                      {w}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {Array.from({ length: Math.ceil(m.cells.length / 7) }, (_, row) => (
                  <tr>
                    {Array.from({ length: 7 }, (_, col) => {
                      const c = m.cells[row * 7 + col];
                      if (!c) return <td />;
                      const cls = c.holiday
                        ? c.holiday.kind === 'national'
                          ? 'is-holiday'
                          : 'is-extra'
                        : c.weekday === 0
                          ? 'is-sun'
                          : c.weekday === 6
                            ? 'is-sat'
                            : undefined;
                      return (
                        <td class={cls} data-date={iso({ y: year, m: m.month, d: c.d })} title={c.holiday?.name}>
                          {c.d}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
            {m.holidays.length > 0 && (
              <ul class="jh-month-list">
                {m.holidays.map(({ d, h }) => (
                  <li class={h.kind === 'national' ? 'is-holiday' : 'is-extra'}>
                    <span class="jh-date">{d}日</span>
                    {h.name}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </div>

  <p class="notice">{notice}</p>
</div>

<script>
  import { $, $$ } from '../../lib/client';
  import { toDayNumber, toISODate, type YMD } from '../date-diff/logic';
  import { JapanHolidayCalendar, parseIso, type HolidayYearData } from './calendar';

  const now = new Date();
  const today: YMD = { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  const t = toDayNumber(today);
  const md = (d: YMD) => `${d.y !== today.y ? `${d.y}年` : ''}${d.m}月${d.d}日`;

  for (const root of $$<HTMLElement>('[data-jp-holidays]')) {
    const data = JSON.parse(root.dataset.jpHolidays ?? '{}') as HolidayYearData;
    const cal = new JapanHolidayCalendar(data);
    const set = (id: string, text: string) => ($(id, root).textContent = text);

    for (const tr of $$<HTMLElement>('tr[data-end]', root)) {
      tr.classList.toggle('is-past', toDayNumber(parseIso(tr.dataset.end ?? '')) < t);
    }
    root.querySelector(`[data-date="${toISODate(today)}"]`)?.classList.add('is-today');

    const next = cal.nextHoliday(today);
    if (next) {
      const name = next.holiday.name;
      set('#jh-next', next.daysUntil === 0 ? '今日' : `あと${next.daysUntil}日`);
      set('#jh-next-label', `次の祝日・休日：${name}（${md(parseIso(next.holiday.date))}）`);
      if (today.y <= cal.year) {
        set('#jh-main', next.daysUntil === 0 ? `今日は${name}です` : `${name}まであと${next.daysUntil}日`);
      }
    } else {
      set('#jh-next-label', `${cal.year}年の祝日はすべて終わりました`);
    }

    const brk = cal.nextLongWeekend(today);
    if (brk) {
      set('#jh-break', brk.ongoing ? '連休中' : `あと${brk.daysUntil}日`);
      set('#jh-break-label', `${brk.block.label}：${md(brk.block.start)}〜${md(brk.block.end)}（${brk.block.days}連休）`);
    } else {
      set('#jh-break-label', `${cal.year}年の3連休以上はすべて終わりました`);
    }

    set('#jh-left', today.y > cal.year ? '0日' : `${cal.holidaysLeft(today)}日`);
  }
</script>

<style>
  .jh-table :global(tr.is-past) td {
    color: var(--muted);
  }
  .jh-table .is-extra td:nth-child(2) {
    color: var(--warning);
    font-weight: 600;
  }
  .jh-note {
    font-size: 13px;
    color: var(--text-2);
  }
  .jh-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--text-2);
  }
  .jh-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .jh-key {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .jh-key-holiday {
    background: color-mix(in oklab, var(--danger) 16%, var(--surface));
    border-color: color-mix(in oklab, var(--danger) 40%, transparent);
  }
  .jh-key-extra {
    background: color-mix(in oklab, var(--warning) 18%, var(--surface));
    border-color: color-mix(in oklab, var(--warning) 45%, transparent);
  }
  .jh-key-weekend {
    background: var(--surface-2);
  }
  .jh-key-today {
    background: var(--surface);
    border: 2px solid var(--accent);
  }
  .jh-months {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .jh-month {
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    min-width: 0;
  }
  .jh-month-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 16px;
  }
  .jh-month-title .muted {
    font-size: 12px;
    font-weight: 400;
  }
  .jh-cal {
    width: 100%;
    border-collapse: separate;
    border-spacing: 2px;
    table-layout: fixed;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .jh-cal th {
    font-weight: 600;
    font-size: 12px;
    color: var(--muted);
    padding: 2px 0;
  }
  .jh-cal th.is-sun {
    color: var(--danger);
  }
  .jh-cal th.is-sat {
    color: var(--accent);
  }
  .jh-cal td {
    text-align: center;
    padding: 5px 0;
    border-radius: 6px;
  }
  .jh-cal .is-sun,
  .jh-cal .is-sat {
    background: var(--surface-2);
  }
  .jh-cal td.is-sun {
    color: var(--danger);
  }
  .jh-cal td.is-sat {
    color: var(--accent);
  }
  .jh-cal .is-holiday {
    background: color-mix(in oklab, var(--danger) 16%, var(--surface));
    color: var(--danger);
    font-weight: 700;
  }
  .jh-cal .is-extra {
    background: color-mix(in oklab, var(--warning) 18%, var(--surface));
    color: var(--warning);
    font-weight: 700;
  }
  .jh-cal :global(.is-today) {
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .jh-month-list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
    font-size: 13px;
    color: var(--text-2);
  }
  .jh-month-list .jh-date {
    display: inline-block;
    min-width: 3.2em;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .jh-month-list .is-holiday .jh-date {
    color: var(--danger);
  }
  .jh-month-list .is-extra .jh-date {
    color: var(--warning);
  }
</style>
