<div class="tool" data-tool="overtime-pay">
  <div class="grid-2">
    <div class="field">
      <span class="label">計薪方式</span>
      <div class="seg" role="radiogroup" aria-label="計薪方式">
        <label><input type="radio" name="ot-mode" value="monthly" checked /><span>月薪制</span></label>
        <label><input type="radio" name="ot-mode" value="hourly" /><span>直接輸入時薪</span></label>
      </div>
    </div>
    <div class="field">
      <label for="ot-wage" id="ot-wage-label">月薪（元）</label>
      <input id="ot-wage" type="text" inputmode="decimal" autocomplete="off" value="36000" />
      <span class="hint" id="ot-wage-hint">含全勤獎金、固定津貼等經常性給與。</span>
    </div>
  </div>

  <div class="table-wrap">
    <table class="table ot-input">
      <thead>
        <tr><th>出勤類型</th><th>單日時數</th><th>天數</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><label for="ot-weekday-h">平日加班<span class="hint">超過 8 小時的部分，最多 4</span></label></td>
          <td><input id="ot-weekday-h" type="text" inputmode="decimal" autocomplete="off" value="2" /></td>
          <td><input id="ot-weekday-d" type="text" inputmode="numeric" autocomplete="off" value="5" aria-label="平日加班天數" /></td>
        </tr>
        <tr>
          <td><label for="ot-restDay-h">休息日出勤<span class="hint">通常是週六，最多 12</span></label></td>
          <td><input id="ot-restDay-h" type="text" inputmode="decimal" autocomplete="off" value="8" /></td>
          <td><input id="ot-restDay-d" type="text" inputmode="numeric" autocomplete="off" value="1" aria-label="休息日出勤天數" /></td>
        </tr>
        <tr>
          <td><label for="ot-holiday-h">國定假日出勤<span class="hint">含特休日出勤，最多 12</span></label></td>
          <td><input id="ot-holiday-h" type="text" inputmode="decimal" autocomplete="off" value="0" /></td>
          <td><input id="ot-holiday-d" type="text" inputmode="numeric" autocomplete="off" value="1" aria-label="國定假日出勤天數" /></td>
        </tr>
        <tr>
          <td><label for="ot-regularOff-h">例假日出勤<span class="hint">僅限天災事變，最多 12</span></label></td>
          <td><input id="ot-regularOff-h" type="text" inputmode="decimal" autocomplete="off" value="0" /></td>
          <td><input id="ot-regularOff-d" type="text" inputmode="numeric" autocomplete="off" value="1" aria-label="例假日出勤天數" /></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="notice error" id="ot-error" hidden></div>

  <div id="ot-output">
    <div class="result" aria-live="polite">
      <div class="result-value" id="ot-total">—</div>
      <div class="result-label">加班費合計（月薪以外另外加給的金額）</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="stat-value" id="ot-hourly">—</span><span class="stat-label">平日每小時工資額</span></div>
      <div class="stat"><span class="stat-value" id="ot-hours">—</span><span class="stat-label">計入每月 46 小時上限</span></div>
    </div>

    <p class="notice" id="ot-warn" hidden></p>

    <div class="field">
      <span class="label">加班費分段明細</span>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>類型與倍數</th><th class="num">時數</th><th class="num">單日</th><th class="num">天數</th><th class="num">小計</th></tr>
          </thead>
          <tbody id="ot-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="hint">依勞動基準法第 24 條、第 39 條、第 40 條計算月薪制勞工的加班費，時數可輸入 0.5 小時。結果僅供參考，實際金額以勞動契約與工作規則為準；資料只在你的瀏覽器內計算。</p>
</div>

<script>
  import { $, $$, loadPref, savePref } from '../../lib/client';
  import { formatInteger, formatNumber, parseNumber } from '../../lib/format';
  import {
    calculateOvertime,
    DAY_LABEL,
    hourlyFromMonthly,
    OVERTIME_RULES,
    validateOvertime,
    type DayType,
    type OvertimeEntry,
  } from './logic';
  import { defaultInsuranceYear, insuranceTable } from '../salary-calculator/logic';

  const KEY = 'overtime-pay';
  // 依今天日期取當年度最低工資（2027-01-01 起為月薪 30,900 元、時薪 205 元）。
  const minWage = insuranceTable(defaultInsuranceYear());
  const TYPES: DayType[] = ['weekday', 'restDay', 'holiday', 'regularOff'];
  const root = $('[data-tool="overtime-pay"]');
  const modes = $$<HTMLInputElement>('input[name="ot-mode"]', root);
  const wage = $<HTMLInputElement>('#ot-wage', root);
  const error = $('#ot-error', root);
  const output = $('#ot-output', root);
  const warn = $('#ot-warn', root);
  const table = $('#ot-table', root);
  const hoursIn = Object.fromEntries(TYPES.map((t) => [t, $<HTMLInputElement>(`#ot-${t}-h`, root)])) as Record<DayType, HTMLInputElement>;
  const daysIn = Object.fromEntries(TYPES.map((t) => [t, $<HTMLInputElement>(`#ot-${t}-d`, root)])) as Record<DayType, HTMLInputElement>;

  const money = (n: number) => `${formatInteger(n)} 元`;
  const val = (el: HTMLInputElement) => (el.value.trim() === '' ? 0 : parseNumber(el.value));

  interface Prefs {
    mode: string;
    wage: string;
    hours: Partial<Record<DayType, string>>;
    days: Partial<Record<DayType, string>>;
  }
  const prefs = loadPref<Partial<Prefs>>(KEY, {});
  if (prefs.mode) for (const m of modes) m.checked = m.value === prefs.mode;
  if (prefs.wage !== undefined) wage.value = prefs.wage;
  for (const t of TYPES) {
    if (prefs.hours?.[t] !== undefined) hoursIn[t].value = prefs.hours[t]!;
    if (prefs.days?.[t] !== undefined) daysIn[t].value = prefs.days[t]!;
  }

  function cell(text: string, num = true): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    if (num) td.className = 'num';
    return td;
  }

  function render() {
    const mode = modes.find((m) => m.checked)?.value ?? 'monthly';
    savePref(KEY, {
      mode,
      wage: wage.value,
      hours: Object.fromEntries(TYPES.map((t) => [t, hoursIn[t].value])),
      days: Object.fromEntries(TYPES.map((t) => [t, daysIn[t].value])),
    } satisfies Prefs);

    $('#ot-wage-label', root).textContent = mode === 'monthly' ? '月薪（元）' : '平日每小時工資額（元）';
    $('#ot-wage-hint', root).textContent =
      mode === 'monthly' ? '含全勤獎金、固定津貼等經常性給與。' : '時薪制勞工於休息日、國定假日出勤，工作時間本身的工資另計。';

    const raw = parseNumber(wage.value);
    const hourly = mode === 'monthly' ? hourlyFromMonthly(raw) : raw;
    const entries: OvertimeEntry[] = TYPES.map((t) => ({ dayType: t, hours: val(hoursIn[t]), days: val(daysIn[t]) }));
    const problem = validateOvertime(hourly, entries);
    const r = problem ? null : calculateOvertime(hourly, entries);
    if (!r) {
      error.textContent = problem ?? '無法計算，請檢查輸入。';
      error.hidden = false;
      output.hidden = true;
      return;
    }
    error.hidden = true;
    output.hidden = false;

    $('#ot-total', root).textContent = money(r.total);
    $('#ot-hourly', root).textContent = `${formatNumber(r.hourly, 2)} 元`;
    $('#ot-hours', root).textContent = `${formatNumber(r.countedHours, 1)} 小時`;

    const notes: string[] = [];
    if (r.overCap) {
      notes.push(`延長工時合計 ${formatNumber(r.countedHours, 1)} 小時，超過勞基法第 32 條每月 ${OVERTIME_RULES.monthlyCap} 小時上限（經工會或勞資會議同意最多 ${OVERTIME_RULES.monthlyCapWithConsent} 小時、每 3 個月 138 小時）。超時加班仍應給付加班費。`);
    }
    if (mode === 'monthly' && raw < minWage.minWage) {
      notes.push(`月薪低於 ${minWage.year} 年最低工資 ${formatInteger(minWage.minWage)} 元，全時勞工的月薪不得低於最低工資。`);
    }
    warn.textContent = notes.join(' ');
    warn.hidden = notes.length === 0;

    const rows = r.lines.map((l) => {
      const tr = document.createElement('tr');
      tr.append(
        cell(`${DAY_LABEL[l.dayType]}：${l.label}`, false),
        cell(formatNumber(l.hours, 1)),
        cell(formatInteger(l.amount)),
        cell(String(l.days)),
        cell(formatInteger(l.total)),
      );
      return tr;
    });
    if (rows.length === 0) {
      const tr = document.createElement('tr');
      const td = cell('請在上方輸入加班時數。', false);
      td.colSpan = 5;
      tr.append(td);
      rows.push(tr);
    }
    table.replaceChildren(...rows);
  }

  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>

<style>
  #ot-output {
    display: grid;
    gap: 16px;
  }
  #ot-output[hidden] {
    display: none;
  }
  .ot-input td {
    vertical-align: middle;
  }
  .ot-input td:first-child {
    white-space: normal;
  }
  .ot-input label {
    display: grid;
    gap: 2px;
    font-weight: 600;
  }
  .ot-input input {
    width: 100%;
    min-width: 64px;
  }
</style>
