---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { absoluteUrl, ads, analytics, getBrand, site } from '../config/site';
import { hreflangLinks, type Alternates } from '../i18n/alternates';
import { DEFAULT_LOCALE, LOCALE_INFO, LOCALES, localePath, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';

interface Props {
  /** Page locale; drives <html lang>, og:locale, brand and all chrome strings. */
  locale?: Locale;
  /**
   * Locale → path of this same page in each locale where it exists (self included).
   * Drives <link rel="alternate" hreflang> and the language switcher. Defaults to this page only.
   */
  alternates?: Alternates;
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description: string;
  /** Path used for canonical + og:url; defaults to the current path. */
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: (Record<string, unknown> | null)[];
  noindex?: boolean;
  activeCategory?: string;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  path = Astro.url.pathname,
  ogImage = site.ogImage,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  activeCategory,
} = Astro.props;
const alternates: Alternates = Astro.props.alternates ?? { [locale]: path };

const brand = getBrand(locale);
const info = LOCALE_INFO[locale];
const s = getUi(locale);
const fullTitle = title ? `${title}${brand.titleSeparator}${brand.name}` : `${brand.name}${brand.titleSeparator}${brand.tagline}`;
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage);
const structured = jsonLd.filter(Boolean);
const hreflangs = noindex ? [] : hreflangLinks(alternates, absoluteUrl);
const ogAlternateLocales = LOCALES.filter((l) => l !== locale && alternates[l]).map((l) => LOCALE_INFO[l].ogLocale);
const manifest = localePath(locale, '/manifest.webmanifest');
---

<!doctype html>
<html lang={info.htmlLang} data-copied={s.copied}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={manifest} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={info.ogLocale} />
    {ogAlternateLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      ads.client && (
        <>
          <meta name="google-adsense-account" content={ads.client} />
          <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
          {/* Only the production host loads ads, so local dev and preview servers don't inflate AdSense page views. */}
          <script is:inline define:vars={{ client: ads.client, host: new URL(site.url).hostname }}>
            if (location.hostname === host) {
              var s = document.createElement('script');
              s.async = true;
              s.crossOrigin = 'anonymous';
              s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
              document.head.appendChild(s);
            }
          </script>
        </>
      )
    }
    {
      analytics.gaId && (
        <>
          {/* Same host guard as ads: local dev and preview servers must not show up in GA4. */}
          <script is:inline define:vars={{ gaId: analytics.gaId, host: new URL(site.url).hostname }}>
            if (location.hostname === host) {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                dataLayer.push(arguments);
              };
              gtag('js', new Date());
              gtag('config', gaId);
            }
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{s.skipToContent}</a>
    <SiteHeader locale={locale} alternates={alternates} activeCategory={activeCategory} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <SearchDialog locale={locale} />

    {
      ads.client && (
        <script is:inline>
          document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(function () {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          });
        </script>
      )
    }
    <script>
      import { installCopyButtons } from '../lib/client';
      import { setupInstallPrompt } from '../lib/pwa';
      installCopyButtons();
      setupInstallPrompt();
      // Language menu is a plain <details>; just close it on outside click / Escape.
      document.addEventListener('click', (event) => {
        document.querySelectorAll<HTMLDetailsElement>('details[data-lang-menu][open]').forEach((menu) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll<HTMLDetailsElement>('details[data-lang-menu][open]').forEach((menu) => {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        });
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--surface);
    border-radius: var(--radius-sm);
  }
</style>
