---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { allLocales, type Alternates } from '../i18n/alternates';
import { DEFAULT_LOCALE, localeHome, localePath, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Locale-independent base path, e.g. '/about/'. The page is served at localePath(locale, path). */
  path: string;
  locale?: Locale;
  /** Defaults to every locale (about / contact / privacy / terms exist in all of them). */
  alternates?: Alternates;
}
const { title, description, path: basePath, locale = DEFAULT_LOCALE } = Astro.props;
const alternates = Astro.props.alternates ?? allLocales(basePath);
const path = localePath(locale, basePath);
const crumbs = [
  { name: getUi(locale).homeCrumb, path: localeHome(locale) },
  { name: title, path },
];
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={title}
  description={description}
  path={path}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} locale={locale} />
    <article class="doc">
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 20px;
  }
  .doc {
    max-width: 72ch;
    color: var(--text-2);
  }
  .doc h1 {
    font-size: clamp(28px, 4vw, 36px);
    color: var(--text);
    margin: 12px 0 20px;
  }
  .doc :global(h2) {
    font-size: 20px;
    color: var(--text);
    margin: 28px 0 10px;
  }
  .doc :global(p),
  .doc :global(li) {
    margin: 0 0 10px;
  }
</style>
