---
// 404 page for one locale. nginx serves /en/404.html and /ja/404.html for misses under those prefixes.
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { localeHome, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { toolsFor } from '../tools/registry';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = getUi(locale).notFound;
const popular = toolsFor(locale).slice(0, 6);
---

<BaseLayout locale={locale} title={s.title} description={s.description} noindex>
  <div class="container page">
    <h1>{s.heading}</h1>
    <p>{s.before}<a href={localeHome(locale)}>{s.link}</a>{s.after}</p>
    <div class="grid">{popular.map((tool) => <ToolCard tool={tool} />)}</div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 48px;
  }
  p {
    color: var(--text-2);
  }
  .grid {
    display: grid;
    gap: 14px;
    margin-top: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
</style>
