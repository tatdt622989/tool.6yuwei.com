---
// Category page for one locale. Routes: pages/category/[id].astro, pages/en/category/[id].astro, pages/ja/category/[id].astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import { getCategory } from '../config/categories';
import { t } from '../i18n/format';
import { localeHome, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { categoryAlternates, categoryPath, populatedCategories, toolsInCategory } from '../tools/registry';
import { breadcrumbJsonLd, itemListJsonLd } from '../lib/seo';

interface Props {
  locale: Locale;
  id: string;
}
const { locale, id } = Astro.props;
const s = getUi(locale);
const category = getCategory(id, locale);
const list = toolsInCategory(category.id, locale);
const path = categoryPath(category.id, locale);
const crumbs = [
  { name: s.homeCrumb, path: localeHome(locale) },
  { name: category.name, path },
];
const others = populatedCategories(locale).filter((c) => c.id !== category.id);
const title = category.title ?? t(s.category.title, { name: category.name, blurb: category.blurb });
---

<BaseLayout
  locale={locale}
  alternates={categoryAlternates(category.id)}
  title={title}
  description={category.description}
  path={path}
  activeCategory={category.id}
  jsonLd={[breadcrumbJsonLd(crumbs), itemListJsonLd(category.name, list)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} locale={locale} />
    <header class="head">
      <Icon name={category.icon} size={40} strokeWidth={1.6} class="head-icon" />
      <div>
        <h1>{category.name}</h1>
        <p>{category.description}</p>
      </div>
    </header>
    <div class="grid">
      {list.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <AdSlot slot="home" />
    <nav class="others" aria-label={s.category.others}>
      <h2>{s.category.others}</h2>
      <ul>
        {
          others.map((c) => (
            <li>
              <a href={categoryPath(c.id, locale)}>{c.name}</a>
              <span class="muted">{c.blurb}</span>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
    padding-top: 20px;
  }
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: start;
    padding: 12px 0 8px;
  }
  .head :global(.head-icon) {
    color: var(--accent);
    margin-top: 4px;
  }
  h1 {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .head p {
    color: var(--text-2);
    max-width: 68ch;
    margin: 10px 0 0;
    line-height: 1.8;
  }
  .grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .others h2 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .others ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .others li {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
  }
  .others a {
    font-weight: 600;
  }
  .others span {
    font-size: 14px;
  }
</style>
