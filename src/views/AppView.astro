---
// "Install as an app" guide for one locale. Content lives in app-content.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import { allLocales } from '../i18n/alternates';
import { localeHome, localePath, type Locale } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
import { appContent } from './app-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = appContent[locale];
const { benefits, platforms, faq } = c;
const path = localePath(locale, '/app/');
const crumbs = [
  { name: getUi(locale).homeCrumb, path: localeHome(locale) },
  { name: c.crumb, path },
];
---

<BaseLayout
  locale={locale}
  alternates={allLocales('/app/')}
  title={c.title}
  description={c.description}
  path={path}
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(faq)]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} locale={locale} />
    <header class="head">
      <h1>{c.heading}</h1>
      <p>{c.lead}</p>
      <div class="cta">
        <InstallButton />
        <p class="already" hidden data-standalone-note>{c.standalone}</p>
      </div>
    </header>

    <section class="benefits" aria-label={c.benefitsAria}>
      {
        benefits.map((b) => (
          <div class="benefit">
            <Icon name={b.icon} size={22} class="b-icon" />
            <h2>{b.title}</h2>
            <p>{b.body}</p>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="how">
      <h2 id="how" class="section-title">{c.howHeading}</h2>
      <div class="platforms">
        {
          platforms.map((p) => (
            <article class="platform">
              <div class="p-head">
                <Icon name={p.icon} size={20} class="p-icon" />
                <h3>{p.title}</h3>
              </div>
              <ol>
                {p.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq" class="section-title">{c.faqHeading}</h2>
      {
        faq.map((item) => (
          <div class="qa">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { isStandalone } from '../lib/pwa';
  if (isStandalone()) document.querySelector<HTMLElement>('[data-standalone-note]')!.hidden = false;
</script>

<style>
  .page {
    display: grid;
    gap: 32px;
    padding-top: 20px;
  }
  .head h1 {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .head > p {
    max-width: 40em;
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-2);
  }
  .cta {
    margin-top: 18px;
  }
  .already {
    margin: 0;
    color: var(--success);
    font-weight: 600;
  }
  .benefits {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .benefit,
  .platform,
  .qa {
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .benefit :global(.b-icon),
  .p-head :global(.p-icon) {
    color: var(--accent);
  }
  .benefit h2 {
    margin: 10px 0 4px;
    font-size: 17px;
  }
  .benefit p,
  .qa p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .section-title {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .platforms {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .p-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .p-head h3 {
    font-size: 16px;
  }
  .platform ol {
    margin: 12px 0 0;
    padding-left: 1.3em;
    display: grid;
    gap: 6px;
    color: var(--text-2);
    line-height: 1.7;
  }
  .qa {
    margin-bottom: 10px;
  }
  .qa h3 {
    font-size: 16px;
    margin-bottom: 4px;
  }
</style>
